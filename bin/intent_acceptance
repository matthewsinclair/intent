#!/bin/bash
# intent_acceptance - AC/AT instrumentation over acceptance.md (ST0044 WP-03).
#
# Serves the `ac` and `at` nouns (re-injected as $1 by bin/intent dispatch).
# acceptance.md is the single source of truth: this module reads and writes
# ONLY that file, editing status in place (linter-stable -- one line changes).
#
# Grammar (model A):
#   - AC-<gg>.<n> [(non-test)] <prose>[ -- evidence: <ref> -- satisfied: yes|no]
#   - AT-<gg>.<n> `<repo-relative-path>` -- covers <ac>[, <ac>...] -- status: <state>[ -- <note>]
#   - AT-<gg>.<n> (non-test) <prose> -- covers <ac>[, <ac>...] -- status: n/a[ -- <note>]
# <state>: to-write | red | green (test rows) | n/a (non-test rows only).
# The AT row is ANCHORED (issue 0017) -- see THE AT ROW GRAMMAR below. `green`
# is reachable only from `red`.
# A non-test AC is satisfied by its inline `satisfied: yes`; a test-backed AC
# is satisfied (computed) iff a covering AT is green. No `set -e`: the parser
# helpers return 0/1 as booleans; every real failure routes through error().

: "${INTENT_HOME:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
source "$INTENT_HOME/bin/intent_helpers"

usage() {
  echo "Usage: intent ac <command> <stid> [args]   |   intent at <command> <stid> <atid>"
  echo ""
  echo "ac commands:"
  echo "  list <stid>[/NN]                           List ACs + covering AT + satisfied state"
  echo "  status <stid>                              Report N/M satisfied + verdict (PASS/BLOCKED)"
  echo "  satisfy <stid> <acid> --evidence \"<ref>\"    Satisfy a non-test AC by named evidence"
  echo "  gate <stid>[/NN]                           Close-gate: exit non-zero + BLOCKED if unsatisfied"
  echo "  descope <stid> <acid> --to <stid> [--by <who>] [--reason \"<text>\"]"
  echo "                                             Record that an AC moved to another thread (non-blocking)"
  echo "  rescope <stid> <acid>                      Undo a descope: back in scope, unsatisfied"
  echo "  withdraw <stid> <acid> --reason \"<text>\" [--by <who>]"
  echo "                                             Withdraw an AC outright, with its reason on the record (non-blocking)"
  echo "  reinstate <stid> <acid>                    Undo a withdrawal: back in scope, unsatisfied"
  echo ""
  echo "at commands:"
  echo "  list <stid>[/NN]                           List ATs (id, reference, status)"
  echo "  lint <stid>[/NN] [--fix]                   Check AT rows against the grammar (--fix migrates what is mechanical)"
  echo "  red|green|na <stid> <atid>                 Set AT status (green reachable only from red)"
  echo "  done|notdone <stid> <atid>                 Aliases for green | red"
  exit 1
}

# ---- field extraction (one AC/AT line in, one token out) ----------------

# THE extraction seam for the whole ac/at family (Highlander, issue 0007).
# Prints capture group 1 of <pattern> on a match; prints NOTHING and returns 1
# when the line does not match.
#
# Every extractor below used to be a bare `sed -E 's/.../\1/'`, and sed prints
# the input UNCHANGED when an s/// does not fire. That made each one total by
# accident: a failed parse returned the whole AC/AT line, which is a plausible
# enough looking value that no caller could tell it from a real one. `status:
# **green` -- a green test whose status field carries markdown emphasis -- fell
# outside at_status's character class, so at_status returned the entire line and
# ac_is_satisfied compared THAT to "green", read false, and gated a green AT as
# unsatisfied with nothing said. Eleven rows on one live thread understated it
# by half. Neither layer could distinguish "not green" from "did not parse",
# because the failure value looked like a value.
#
# The line is matched BEFORE it is substituted, and both uses read the same
# `$pattern`, so the test and the extraction cannot drift apart. Callers get an
# empty string on failure -- which compares false against every real token --
# and the diagnostic comes from warn_bad_fields, so a parse failure is now both
# harmless and audible instead of silent and wrong.
#
# The s/// delimiter is `@`, not `/`: the AT grammar below carries a literal `/`
# (the path separator the reference is required to contain) and `n/a` in its
# status vocabulary, either of which closes an s/.../.../ early and turns the
# seam into a sed syntax error. No pattern in this file contains `@`, and
# tests/unit/at_grammar_lint.bats asserts that, so the delimiter cannot be
# reintroduced as a bug by the next pattern someone adds. That guard also
# asserts this comment names it, so the pointer is checkable from both ends
# rather than being a filename that quietly stops existing.
extract_field() {
  local line="$1" pattern="$2" group="${3:-1}"
  printf '%s\n' "$line" | grep -qE "$pattern" || return 1
  printf '%s\n' "$line" | sed -E "s@$pattern@\\$group@"
}

line_id()       { extract_field "$1" '^- ([A-Z]+-[0-9]+\.[0-9]+).*'; }
id_group()      { extract_field "$1" '^[A-Z]+-([0-9]+)\..*'; }
# `[a-z/]` not `[a-z]`: the off-scope states write `satisfied: n/a`, and the
# narrower class read that as "n" -- a value, not a parse failure, and so
# invisible in exactly the way issue 0007 was. Nothing routes a decision through
# this field for those rows (the markers below are the authority), but a reader
# that quietly mis-reads a value it can see is the trap, not the decision.
ac_flag()       { extract_field "$1" '.* -- satisfied: ([a-z/]+).*'; }
ac_is_nontest() { case "$1" in *"(non-test)"*) return 0 ;; *) return 1 ;; esac; }

# ---- off-scope AC states (issue 0013) ------------------------------------
#
# An AC's state was modelled as a boolean when practice has at least four. A
# requirement that moved to another thread, or was withdrawn outright, is still
# a real decision about the contract -- and the only two representations
# available were both wrong. `satisfy` is a lie: the work was not done. Leaving
# it unsatisfied is honest and permanent: the AC counts against the thread
# forever, the gate reports BLOCKED, and `wp done` refuses to close a thread
# that is genuinely finished. Once a project has such ACs, BLOCKED stops meaning
# "there is work to do" and a reader learns to override it -- which is the
# moment a real blocker gets waved through. A check that is routinely ignored is
# worse than no check.
#
# Detection is by MARKER, never by the `satisfied:` field, and the markers are
# matched as exact literals the way `(non-test)` is: a substring test cannot
# half-parse. Both states carry their audit trail on the line -- who ruled, when,
# and (for a descope) which thread now owns it -- because that trail is the whole
# reason to record a move rather than delete the line.
ac_is_descoped()      { case "$1" in *" -- descoped-to: "*) return 0 ;; *) return 1 ;; esac; }
ac_is_withdrawn()     { case "$1" in *" -- withdrawn: "*) return 0 ;; *) return 1 ;; esac; }
ac_descoped_to()      { extract_field "$1" '.* -- descoped-to: ([^ ]+).*'; }
ac_withdrawn_reason() { extract_field "$1" '.* -- withdrawn: (.*) -- by: .*'; }

# THE off-scope refusal, for every verb that would change an AC's state.
#
# The off-scope verbs need it so a second state cannot stack on the first, and
# `ac satisfy` needs it for a worse reason: on a descoped AC it printed `ok:`,
# exited 0, and wrote ` -- descoped-to: ST0002 ... -- satisfied: yes` -- a row
# that contradicts itself -- while `ac list` and the gate went on (correctly)
# reporting it descoped. Reported success, no effect: the issue-0006 shape that
# the write verifier exists to end, reachable through the verbs added to fix
# issue 0013. Satisfying a requirement nobody is doing any more is exactly the
# dishonest bookkeeping descope was introduced to replace, so it is refused and
# the refusal names the undo.
ac_refuse_if_offscope() {
  local line="$1" acid="$2" verb="$3"
  if ac_is_descoped "$line"; then
    error "$acid is already descoped to $(ac_descoped_to "$line") -- 'intent ac rescope' first if you mean to $verb it"
  fi
  if ac_is_withdrawn "$line"; then
    error "$acid is already withdrawn -- 'intent ac reinstate' first if you mean to $verb it"
  fi
}

# ---- THE AT ROW GRAMMAR (issue 0017) -------------------------------------
#
# One anchored pattern per arm, and every AT field is a capture group of it.
# Before this, the row had no grammar at all: each field was recovered by its
# own single-shot regex over free prose, so no row could ever be MALFORMED --
# only partially recovered, silently, one field at a time. `at_pathname` was
# "whatever sits inside the first pair of backticks", which returned CSS class
# names, DOM attributes and empty strings as test paths, all of them green, with
# no diagnostic anywhere (there was no bad_pathname_lines beside the status and
# marker checks). Measured on the reporting estate: 314 rows, 5 mutually
# incompatible reference forms, and 2 live green ATs citing Tailwind utility
# classes as their test file.
#
# TWO arms, because the status vocabulary already declares two kinds of row and
# a one-armed grammar cannot express the second:
#
#   test arm      - AT-n.n `<repo-relative-path>` -- covers <ACs> -- status: to-write|red|green[ -- note]
#   non-test arm  - AT-n.n (non-test) <prose> -- covers <ACs> -- status: n/a[ -- note]
#
# `n/a` is documented in every contract preamble as "non-test: doc / eyeball /
# gate" -- a row that by definition has no test file. A single arm requiring a
# path on every row would have made every doc-check row a permanent grammar
# failure with no legal form to migrate to (3 such rows in this repo alone), so
# the biconditional is enforced instead: n/a IFF non-test arm. The `(non-test)`
# marker is the same token the AC row already uses for the same meaning.
#
# The path group requires at least one `/` and excludes `:`. The `/` makes a
# bare filename a GRAMMAR error rather than something a later existence check
# has to guess at; excluding `:` makes the retired `path::name` form a clean
# reject with a targeted message, instead of a path that passes the grammar and
# then fails L2 as a dangling file. Both were holes found by running the arms
# against real rows: the tool's own doc comment and shipped template taught
# `path::name`, and the template also taught a bare parenthetical note after the
# status, which is why the note is now delimited by ` -- ` and nothing else.
#
# Group numbers ALIGN across both arms (1 id, 2 reference, 3 covers, 5 status,
# 6 note) so one accessor serves both. Every reader below is one line over that
# accessor: a row that fails the grammar yields NOTHING from every field, which
# is what makes the failure total and visible instead of partial and silent.
BT='`'
AT_G_ID='AT-[0-9]+\.[0-9]+'
AT_G_PATH='[^`:]*/[^`:]+'
AT_G_COVERS='AC-[0-9]+\.[0-9]+(, AC-[0-9]+\.[0-9]+)*'
AT_G_NOTE='( -- .*)?'
AT_GRAMMAR_TEST="^- ($AT_G_ID) ${BT}($AT_G_PATH)${BT} -- covers ($AT_G_COVERS) -- status: (to-write|red|green)$AT_G_NOTE\$"
AT_GRAMMAR_NONTEST="^- ($AT_G_ID) \(non-test\) (.*) -- covers ($AT_G_COVERS) -- status: (n/a)$AT_G_NOTE\$"

# Which arm a row conforms to: "test", "nontest", or non-zero for neither.
at_row_arm() {
  if printf '%s\n' "$1" | grep -qE "$AT_GRAMMAR_TEST"; then
    echo "test"
  elif printf '%s\n' "$1" | grep -qE "$AT_GRAMMAR_NONTEST"; then
    echo "nontest"
  else
    return 1
  fi
}

# Capture group <2> of whichever arm the row matches. Returns 1 (and prints
# nothing) for a row that matches neither -- the grammar is the gate.
at_field() {
  local line="$1" group="$2"
  if printf '%s\n' "$line" | grep -qE "$AT_GRAMMAR_TEST"; then
    extract_field "$line" "$AT_GRAMMAR_TEST" "$group"
  elif printf '%s\n' "$line" | grep -qE "$AT_GRAMMAR_NONTEST"; then
    extract_field "$line" "$AT_GRAMMAR_NONTEST" "$group"
  else
    return 1
  fi
}

at_pathname()       { at_field "$1" 2; }
at_status()         { at_field "$1" 5; }
at_covers()         { at_field "$1" 3 | tr ',' ' '; }
at_is_nontest_row() { [ "$(at_row_arm "$1" 2>/dev/null)" = "nontest" ]; }

# DIAGNOSTIC-ONLY loose readers. These deliberately parse what the grammar
# rejects, so the linter can say WHICH field is wrong and what it currently
# reads. They are never used to decide anything -- only to describe a row that
# has already failed. (Same strict-reader/loose-describer split the AC side
# already uses: ac_is_nontest matches the exact literal, bad_marker_lines finds
# the near-misses.) Keeping them apart is what stops a lenient describer from
# quietly becoming the parser again.
at_status_loose()  { extract_field "$1" '.* -- status: ([^ ]+).*'; }
at_covers_loose()  { extract_field "$1" '.* -- covers (.*) -- status:.*'; }
at_ref_loose()     { extract_field "$1" '^- AT-[0-9]+\.[0-9]+ (.*) -- covers .*'; }

# Every file path a reference span actually cites, one per line.
#
# A legacy span may carry MORE THAN ONE citation, ` + ` separated, each with its
# own retired ::"name" suffix -- and at least one observed row omits the path
# from a citation entirely, naming only the test. The diagnostic that reported
# such a row used to take everything before the FIRST `::`, so it named one file
# and silently discarded the rest: a suggestion that loses data, which anyone
# hand-following it loses too. That was worse than the fixer applying it,
# because it also misinformed every human reader.
#
# Split on ` + ` specifically (not any `+`): the test names themselves contain
# `+`, and splitting on those manufactures citations that were never written.
at_ref_files() {
  local ref="$1" part
  ref="${ref#\`}"; ref="${ref%\`}"
  printf '%s\n' "$ref" \
    | awk '{ n = split($0, a, / \+ /); for (i = 1; i <= n; i++) print a[i] }' \
    | while IFS= read -r part; do
        part="${part%%::*}"
        part="$(printf '%s\n' "$part" | sed -E 's@^[[:space:]]+@@; s@[[:space:]]+$@@')"
        [ -n "$part" ] || continue
        case "$part" in */*) printf '%s\n' "$part" ;; esac
      done
}

# The declared AT status vocabulary. Named once: the gate compares against it,
# the diagnostic quotes it, and acceptance.md's own preamble states it.
AT_STATUS_VOCAB="to-write | red | green | n/a"

at_status_in_vocab() {
  case "$1" in to-write|red|green|n/a) return 0 ;; *) return 1 ;; esac
}

# ---- whole-file selectors ------------------------------------------------

ac_lines() { grep -E '^- AC-[0-9]+\.[0-9]+ ' "$1" 2>/dev/null || true; }
at_lines() { grep -E '^- AT-[0-9]+\.[0-9]+ ' "$1" 2>/dev/null || true; }

# Value of the frontmatter `acceptance:` key (empty if absent). Mirrors the
# house pattern for reading a steel-thread frontmatter scalar (cf the `status:`
# read in bin/intent_st). `exempt` is the explicit, visible opt-out the
# close-gate honours -- the only way an empty/missing contract passes.
acceptance_field() { grep -m1 -E '^acceptance:' "$1" 2>/dev/null | sed -E 's/^acceptance:[[:space:]]*//'; }

# AC/AT-shaped lines (start "- AC-"/"- AT-") that FAIL the strict numeric grammar.
# Without this guard they are silently dropped and the gate goes vacuous -- the
# exact failure that let a half-authored contract read as PASS. No Silent Errors.
malformed_acat() {
  grep -nE '^- A[CT]-' "$1" 2>/dev/null | grep -vE ':- A[CT]-[0-9]+\.[0-9]+ ' || true
}

# AC lines carrying an unclosed `(non-test` marker. ac_is_nontest matches the
# exact literal `(non-test)`, so `(non-test, see note)` is classified test-backed:
# the gate then hunts a covering AT, finds none, and reports the AC unsatisfied
# while ignoring the `satisfied: yes` the row already carries. The row passes
# every other check, so nothing said why (issue 0006).
bad_marker_lines() {
  local line
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    case "$line" in
      *"(non-test)"*) continue ;;
      *"(non-test"*)  printf '%s\n' "$(line_id "$line")" ;;
    esac
  done <<EOF
$(ac_lines "$1")
EOF
}

# Warn (stderr) for AC fields the parser cannot read. ALWAYS returns 0: unlike a
# malformed id -- which vanishes from the count and lets the gate go vacuous --
# these UNDER-report. An unclosed marker leaves its AC uncredited, so the gate
# already fails closed and needs no new block. What it needed was a voice: the
# defect was invisible to every existing guard (warn_malformed checks only the
# id grammar, `st repair` reports the thread clean, and the row reads fine to a
# human), so the only symptom was a gate that would not move and would not say
# why (issue 0006).
#
# The AT-status arm that used to live here has moved into the linter (issue
# 0017), where it is one classification among several rather than a check
# standing on its own. A bad status is now also a grammar failure, and reporting
# it twice from two places was the noise that made the linter's own voice hard
# to read: one defect, one line, one owner.
warn_bad_fields() {
  local acc="$1" bad line
  bad="$(bad_marker_lines "$acc")"
  if [ -n "$bad" ]; then
    warning "unclosed non-test marker in $acc -- the marker must read exactly '(non-test)'; these ACs are being treated as test-backed and need a covering green AT:"
    while IFS= read -r line; do
      [ -n "$line" ] && warning "  $line"
    done <<EOF
$bad
EOF
  fi
  return 0
}

# Warn (stderr) for each malformed AC/AT line; return 1 if any were found.
# The return value is the gate's F1 block and covers the ID GRAMMAR only --
# warn_bad_fields is folded in here so every reader reports both classes from
# one call, but it never contributes to the blocking verdict.
warn_malformed() {
  local acc="$1" bad line
  warn_bad_fields "$acc"
  bad="$(malformed_acat "$acc")"
  [ -z "$bad" ] && return 0
  warning "malformed AC/AT line(s) in $acc -- id must be AC-<n>.<n> / AT-<n>.<n> (digits) then a space; these are NOT counted:"
  while IFS= read -r line; do
    [ -n "$line" ] && warning "  $line"
  done <<EOF
$bad
EOF
  return 1
}

# Single AC/AT line for an exact id (dots escaped), or empty.
find_line() {
  local esc
  esc="$(echo "$1" | sed 's/\./\\./g')"
  grep -E "^- ${esc} " "$2" 2>/dev/null | head -n1
}

# ---- resolution + targets ------------------------------------------------

# THE target resolver for the whole ac/at family (Highlander, issue 0004).
# "<stid>[/NN]" in; ST_ID, WP_NUM (padded) and TARGET_DIR out.
#
# Resolution is a distinct, FAILABLE step that must run BEFORE evaluation.
# Without it an unresolvable target degrades to an empty AC set, and each
# command then reports its own flavour of vacuous success over that emptiness:
# the gate found nothing unsatisfied and exited 0, `status` printed 0/0, `list`
# printed no rows. "This target does not exist" and "this target has nothing
# unsatisfied" were the same internal state, and only the second was ever
# reported. Resolving per-subcommand is how the gate came to lack even the
# steel-thread check its own sibling `status` had, so it resolves here once.
#
# The `/NN` segment is validated too -- nothing validated it anywhere before.
# On failure the reason lands in TARGET_REASON (a global, not stdout: callers
# capturing stdout in a subshell would lose every assignment above) and the
# caller picks the presentation -- error() for the human-facing readers, a
# BLOCKED line for the machine-facing gate.
resolve_target() {
  TARGET_REASON=""
  TARGET_DIR=""
  parse_wp_specifier "$1" "false"
  if ! TARGET_DIR="$(resolve_st_dir "$ST_ID")"; then
    TARGET_REASON="no such steel thread: $ST_ID"
    return 1
  fi
  if [ -n "$WP_NUM" ] && ! resolve_wp_dir "$TARGET_DIR" "$WP_NUM" >/dev/null; then
    TARGET_REASON="no such work package: $ST_ID/$WP_NUM"
    return 1
  fi
  return 0
}

# The contract file of an already-resolved target. resolve_target runs first.
acc_file() {
  local acc="$TARGET_DIR/acceptance.md"
  [ -f "$acc" ] || error "no acceptance.md for $ST_ID (looked in $TARGET_DIR)"
  echo "$acc"
}

# Resolve for the reader commands (list / status / satisfy / at): a bad target
# is a hard error, never an empty result set that reads as "nothing to report".
resolve_or_die() {
  resolve_target "$1" || error "$TARGET_REASON"
}

in_wp_filter() {
  [ -z "$WP_NUM" ] && return 0
  [ "$((10#$(id_group "$1")))" -eq "$((10#$WP_NUM))" ]
}

# ---- coverage + satisfaction --------------------------------------------

# Space-prefixed list of AT ids that cover the given AC id.
ac_covering_ats() {
  local id="$1" acc="$2" line out=""
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    case " $(at_covers "$line") " in
      *" $id "*) out="$out $(line_id "$line")" ;;
    esac
  done <<EOF
$(at_lines "$acc")
EOF
  echo "$out"
}

# THE AC state classifier: descoped | withdrawn | satisfied | unsatisfied.
#
# Every counter and every reader goes through here, so "what state is this AC
# in" has one answer in one place. The off-scope markers are checked BEFORE
# ac_is_satisfied, which is load-bearing rather than stylistic: a descoped
# test-backed AC would otherwise fall into the covering-AT hunt, find nothing
# (its AT went with it to the receiving thread) and report unsatisfied -- the
# exact false BLOCKED this issue exists to remove.
ac_state() {
  local line="$1" acc="$2"
  ac_is_descoped  "$line" && { echo "descoped";  return 0; }
  ac_is_withdrawn "$line" && { echo "withdrawn"; return 0; }
  if ac_is_satisfied "$line" "$acc"; then echo "satisfied"; else echo "unsatisfied"; fi
}

# True if the AC (line) is satisfied: non-test -> inline flag; else a green AT.
ac_is_satisfied() {
  local line="$1" acc="$2" id atline
  if ac_is_nontest "$line"; then
    [ "$(ac_flag "$line")" = "yes" ]
    return
  fi
  id="$(line_id "$line")"
  while IFS= read -r atline; do
    [ -z "$atline" ] && continue
    case " $(at_covers "$atline") " in
      *" $id "*)
        [ "$(at_status "$atline")" = "green" ] && return 0
        ;;
    esac
  done <<EOF
$(at_lines "$acc")
EOF
  return 1
}

# ---- the linter (issue 0017: L1-L5) --------------------------------------

# WHY a row failed the grammar, in the author's own terms. A bare "does not
# match" is useless on a format that drifted five ways in one estate: the whole
# point of the grammar is that the row is now rejectable, and the whole point of
# this function is that the rejection names the edit. Ordered most-specific
# first, so the row is diagnosed by its actual defect rather than by whichever
# check happens to run first.
at_row_defect() {
  local line="$1" ref st covers seen inner files nfiles
  st="$(at_status_loose "$line")"
  covers="$(at_covers_loose "$line")"
  ref="$(at_ref_loose "$line")"

  case "$line" in
    *" -- covers "*) ;;
    *) echo "no ' -- covers <AC-id>' clause -- the row links to no criterion at all"; return 0 ;;
  esac
  case "$line" in
    *" -- status: "*) ;;
    *) echo "no ' -- status:' field -- vocabulary is $AT_STATUS_VOCAB"; return 0 ;;
  esac

  if ! at_status_in_vocab "$st"; then
    echo "unreadable AT status: '${st:-<absent>}' -- vocabulary is $AT_STATUS_VOCAB (markdown emphasis around the value is NOT parsed)"
    return 0
  fi

  # The 0014 case. Name what DID resolve next to what did not: the failure that
  # taught a reader the wrong rule ("an AT covers exactly one AC") did so by
  # showing a coverage number with no account of the text it ignored.
  if ! printf '%s\n' "$covers" | grep -qE "^$AT_G_COVERS\$"; then
    seen="$(printf '%s\n' "$covers" | grep -oE 'AC-[0-9]+\.[0-9]+' | tr '\n' ' ' | sed 's@ *$@@')"
    echo "coverage clause does not parse: '$covers' -- ids seen: ${seen:-none}. Multi-AC coverage is comma-separated and nothing may be fused to an id: 'covers AC-01.1, AC-01.2' (no 'and', no trailing ':' or possessive)"
    return 0
  fi

  if [ "$st" = "n/a" ]; then
    case "$line" in
      *"(non-test)"*) ;;
      *) echo "status n/a is the NON-TEST status (doc / eyeball / gate) -- mark the row '(non-test)' immediately after the id, or give it a real test status ($AT_STATUS_VOCAB)"; return 0 ;;
    esac
  else
    case "$line" in
      *"(non-test)"*) echo "a (non-test) row must carry 'status: n/a', not '$st'"; return 0 ;;
    esac
  fi

  # A note that is not delimited by ' -- '. Checked before the reference,
  # because the tool's OWN template taught this form (`status: to-write
  # (red-first)`) and a row carrying it is otherwise perfectly well written --
  # blaming its reference would send the author to the wrong end of the line.
  if printf '%s\n' "$line" | grep -qE " -- status: (to-write|red|green|n/a) [^-]"; then
    echo "the trailing note must be delimited by ' -- ' -- write 'status: $st -- <note>', not 'status: $st (<note>)'"
    return 0
  fi

  [ -n "$ref" ] || { echo "no reference between the id and ' -- covers'"; return 0; }

  # The retired path::name form, backticked or not. Checked ahead of the
  # backtick rule because it is the single most common real-world shape (86 of
  # the 116 rows in this repo), and "add backticks" is the wrong instruction
  # for it: the name has to come out, not get quoted.
  case "$ref" in
    *::*|*" + "*)
      files="$(at_ref_files "$ref")"
      nfiles="$(printf '%s\n' "$files" | grep -c . || true)"
      if [ "${nfiles:-0}" -gt 1 ]; then
        # NAME THEM ALL. The row genuinely cites several files and the grammar
        # admits one, so this needs a decision -- but the decision is the
        # author's, and they cannot make it from a message that mentions only
        # the first. Nothing here tells them to delete anything.
        echo "this row cites $nfiles files and the grammar admits ONE: $(printf '%s\n' "$files" | tr '\n' ' ' | sed 's@ *$@@'). Cite the file that proves the criterion, keep the others in the trailing note (' -- also: ...'), and name the id '$(line_id "$line")' inside each test. 'intent at lint --fix' will NOT touch this row -- it cannot choose for you"
        return 0
      fi
      inner="$(printf '%s\n' "$files" | head -1)"
      if [ -z "$inner" ]; then
        echo "the 'path::name' form is retired and this row names a test without a file: '$ref' -- cite the test FILE and name the id '$(line_id "$line")' inside the test itself"
        return 0
      fi
      echo "the 'path::name' form is retired -- cite the FILE only (\`$inner\`) and name the id '$(line_id "$line")' inside the test itself, which is checkable from both ends. Both ends are needed: 'intent at lint --fix' will NOT strip the name for you, because until the id is in the test the name is the only thing linking this row to it"
      return 0
      ;;
  esac

  if ! printf '%s\n' "$ref" | grep -qE "^${BT}[^${BT}]*${BT}\$"; then
    echo "the reference must be ONE backticked repo-relative path and nothing else -- a test NAME does not belong here (name the id inside the test instead) -- currently: $ref"
    return 0
  fi
  inner="${ref#\`}"
  inner="${inner%\`}"
  case "$inner" in
    *:*) echo "the reference is not a repo-relative path (it contains ':'): '$inner' -- this field is the test FILE, not a selector, a class name or a label"; return 0 ;;
  esac
  case "$inner" in
    */*) ;;
    *) echo "bare filename '$inner' -- cite a repo-relative path (a bare name cannot be resolved, and every reader has to guess which file is meant)"; return 0 ;;
  esac
  echo "does not match the AT row grammar"
}

# L2/L3/L4 for a row that already passed L1. One finding per line, "<check>
# <id> <text>", empty when the row is clean.
at_row_findings() {
  local line="$1" acc="$2" root="$3" completed="$4" id st ref c acline out=""
  id="$(line_id "$line")"
  st="$(at_status "$line")"
  ref="$(at_pathname "$line")"
  if ! at_is_nontest_row "$line"; then
    case "$st" in
      green|red)
        # L2 -- the citation is the contract's only link to the tree, and until
        # now nothing resolved it: a renamed test left its AT green forever and
        # the gate counted it as coverage (issue 0015). `to-write` is exempt
        # because a missing file is the CORRECT state for a test not yet
        # written -- a naive existence check reds five correct rows.
        if [ ! -f "$root/$ref" ]; then
          out="${out}L2 $id the cited test file does not exist: $ref
"
        elif [ "$completed" != "yes" ] && ! grep -qF "$id" "$root/$ref"; then
          # L3 -- the back-reference. A cited test NAME is unverifiable (every
          # string match drowns in paraphrase); the id is checkable from both
          # ends, and a deck that cannot carry a claim does not carry its id
          # either. Completed threads are exempt: retrofitting id labels into
          # closed threads' tests is archaeology.
          out="${out}L3 $id the cited file does not carry the literal id '$id': $ref
"
        fi
        ;;
    esac
  fi
  for c in $(at_covers "$line"); do
    acline="$(find_line "$c" "$acc")"
    if [ -z "$acline" ]; then
      out="${out}L4 $id covers $c, which is not an AC row in this contract
"
      continue
    fi
    # L5 -- the trap the non-test arm would otherwise bless. Satisfaction for a
    # doc / eyeball criterion is carried by the AC's own `(non-test)` marker and
    # evidence; the non-test AT row RECORDS the check, it does not perform it.
    # A non-test AT is n/a by definition and n/a is never green, so a
    # test-backed AC covered only by one can never be satisfied -- an
    # unclosable contract whose only symptom is a gate that will not move.
    if at_is_nontest_row "$line" && ! ac_is_nontest "$acline"; then
      out="${out}L5 $id is a (non-test) AT covering $c, which is test-backed -- a non-test AT is never green, so it can never satisfy it. Mark $c '(non-test)' and satisfy it by evidence ('intent ac satisfy'), or cover it with a real test.
"
    fi
  done
  printf '%s' "$out"
}

# Lint every AT row in <acc>. <stream> is `out` (the `at lint` command) or `err`
# (readers and the gate, where findings are warnings beside the output).
# Sets AT_LINT_ROWS / AT_LINT_FAILS as globals -- a command substitution here
# would run in a subshell and lose every count, the same trap resolve_target
# documents. Returns 1 if anything failed.
at_lint_report() {
  local acc="$1" completed="$2" stream="$3" line id defect findings f root
  root="$(find_project_root 2>/dev/null)" || root="$(pwd)"
  [ -n "$root" ] || root="$(pwd)"
  AT_LINT_ROWS=0
  AT_LINT_FAILS=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    AT_LINT_ROWS=$((AT_LINT_ROWS + 1))
    id="$(line_id "$line")"
    if ! at_row_arm "$line" >/dev/null 2>&1; then
      defect="$(at_row_defect "$line")"
      at_lint_emit "$stream" "L1 $id -- $defect"
      AT_LINT_FAILS=$((AT_LINT_FAILS + 1))
      continue
    fi
    findings="$(at_row_findings "$line" "$acc" "$root" "$completed")"
    [ -z "$findings" ] && continue
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      at_lint_emit "$stream" "$f"
      AT_LINT_FAILS=$((AT_LINT_FAILS + 1))
    done <<EOF
$findings
EOF
  done <<EOF
$(at_lines "$acc")
EOF
  [ "$AT_LINT_FAILS" -eq 0 ]
}

at_lint_emit() {
  case "$1" in
    out) echo "lint: $2" ;;
    *)   warning "lint: $2" ;;
  esac
}

# Is the resolved target a completed thread? L3 is waived for those.
target_is_completed() {
  case "$TARGET_DIR" in *"/COMPLETED/"*) return 0 ;; *) return 1 ;; esac
}

# Is this string plausibly a FILENAME -- the only thing a basename search could
# ever resolve? A bare name with an extension, no path separator, no whitespace,
# and no glob metacharacter.
#
# This guard is the difference between a migration aid and a liability, for two
# separate reasons found on a 65GB consumer estate:
#
#   Cost -- the search below walks the whole repository. Running it for a
#   reference that CANNOT be a filename buys nothing and costs a full-tree scan
#   PER ROW: on that estate, twelve rows citing the placeholder `[to-write]` had
#   the tool scanning 65GB twelve times, which reads as a hang.
#
#   Correctness -- `find -name` takes a GLOB. `[to-write]` is a character class,
#   so it matches any single-character filename, and a unique hit would have
#   rewritten the row to cite a file that has nothing to do with it. A migrator
#   that guessed would launder exactly the drift the grammar exists to stop.
at_ref_is_filename_shaped() {
  case "$1" in
    *[!A-Za-z0-9._+-]*) return 1 ;;  # path separator, space, or glob metachar
    *.*)                return 0 ;;  # must carry an extension
    *)                  return 1 ;;
  esac
}

# The one basename match under the repo, or non-zero when it is absent or
# ambiguous. Bare filenames were 8 of 179 rows on the reporting estate and every
# one of them resolved to exactly one real file -- which is what makes this
# mechanical rather than a guess. When it is NOT unique the row is reported for
# a hand fix, never resolved by picking one.
#
# The excluded trees are PRUNED, not filtered: `-not -path` still descends into
# node_modules / _build / deps and throws the results away afterwards, so the
# exclusion list looked like it bounded the walk while bounding nothing.
# Results are memoised for the run, because a contract that cites one renamed
# file from a dozen rows would otherwise repeat the identical search a dozen
# times.
AT_EXPAND_CACHE=""
at_expand_basename() {
  local root="$1" base="$2" hits n cached
  at_ref_is_filename_shaped "$base" || return 1

  cached="$(printf '%s\n' "$AT_EXPAND_CACHE" | grep -F "	$base	" | head -1)"
  if [ -n "$cached" ]; then
    cached="${cached##*"$base"$'\t'}"
    [ -n "$cached" ] || return 1
    printf '%s\n' "$cached"
    return 0
  fi

  hits="$(cd "$root" 2>/dev/null && find . \
    \( -name .git -o -name .backup -o -name node_modules -o -name _build -o -name deps \) -prune \
    -o -type f -name "$base" -print 2>/dev/null | sed 's@^\./@@')"
  n="$(printf '%s\n' "$hits" | grep -c . || true)"
  [ "$n" -eq 1 ] || hits=""
  AT_EXPAND_CACHE="$(printf '%s\n\t%s\t%s' "$AT_EXPAND_CACHE" "$base" "$hits")"
  [ -n "$hits" ] || return 1
  printf '%s\n' "$hits"
}

# The mechanical half of the migration. Rewrites ONLY column-0 AT rows that fail
# the grammar, and only the transformations that are unambiguous; everything
# requiring judgement (an id back-reference to add, a prose fragment fused to a
# coverage id, a test path that was never written down) is left alone and
# reported by the linter afterwards. A migrator that guessed would launder
# exactly the drift the grammar exists to stop.
at_fix_line() {
  local line="$1" root="$2" new="$line" ref inner base expanded
  # A (doc) marker is the same intent as (non-test), spelled by hand before the
  # AT row had a non-test arm to spell it in.
  new="$(printf '%s\n' "$new" | sed -E "s@^(- $AT_G_ID) \(doc\) @\1 (non-test) @")"
  # Emphasis around an otherwise valid status token.
  new="$(printf '%s\n' "$new" | sed -E 's@( -- status: )[*_]+(to-write|red|green|n/a)[*_]+@\1\2@')"
  # The template's own parenthetical note becomes the delimited note.
  new="$(printf '%s\n' "$new" | sed -E 's@( -- status: (to-write|red|green|n/a)) \((.*)\)$@\1 -- \3@')"
  # Separator words between two coverage ids.
  new="$(printf '%s\n' "$new" | sed -E 's@(AC-[0-9]+\.[0-9]+) (and|&) (AC-[0-9]+\.[0-9]+)@\1, \3@g')"
  # The reference. Rewriting it REPLACES everything between the id and
  # ' -- covers ', so it is attempted only where that span holds nothing but a
  # path. Two shapes are refused outright, and refusing them is the fix:
  #
  #   `path::"name"` -- the migration is TWO-ENDED (cite the file, put the AT id
  #   inside the test). Stripping the name here does not half-migrate the row,
  #   it BREAKS the link: until the id lands in the test, the name is the only
  #   thing identifying which test covers the criterion. It also converts an
  #   honest L1 ("retired form") into a misleading L3 ("the file does not carry
  #   the id") on a row that now reads complete and points at nothing.
  #
  #   `pathA + pathB` -- the row cites several files and the grammar admits one.
  #   Which one survives is the author's decision, and a fixer that picks the
  #   first silently deletes the others.
  #
  # Measured on a consumer estate: 32 findings became 31, at the cost of four
  # rows losing a second real cited file and ~17 losing the only name that said
  # which test covered the AC. A migrator that cannot do both ends must leave
  # the row alone and let the linter report it, not leave behind a contract that
  # reads complete and proves nothing.
  ref="$(at_ref_loose "$new")"
  inner="$ref"
  case "$inner" in
    "${BT}"*"${BT}") inner="${inner#\`}"; inner="${inner%\`}" ;;
  esac
  # ONE rule, applied to the span as WRITTEN: a lone path token and nothing
  # else. Whitespace covers ` + ` citations, a trailing "test name", a
  # parenthesised name and any prose; `::` and `"` cover the rest. This is
  # checked BEFORE anything is stripped -- an earlier version stripped the
  # quoted name first and then tested for whitespace, so the test never saw the
  # thing it existed to catch, and five rows still lost their test name.
  #
  # The whitespace test is the one that fires on every shape observed in the
  # field; `::` and `"` are stated belt-and-braces so the rule reads as the rule
  # rather than as an accident of what the path pattern happens to reject. Do
  # not delete the whitespace test on the strength of the other two.
  case "$inner" in
    *[[:space:]]*|*::*|*'"'*) inner="" ;;
  esac
  if [ -n "$inner" ]; then
    case "$inner" in
      */*) ;;
      *)
        if expanded="$(at_expand_basename "$root" "$inner")"; then
          inner="$expanded"
        fi
        ;;
    esac
    # Only rewrite when the result is a plausible path: never invent one out of
    # prose, and never touch a non-test row's free text. The comparison is
    # against the CANONICAL form, not the raw reference: comparing to the raw
    # text skipped the single most common migration in the estate -- a correct
    # repo-relative path that simply is not backticked, where nothing is
    # stripped and so nothing looked like it had changed.
    if printf '%s\n' "$inner" | grep -qE "^$AT_G_PATH\$" && [ "${BT}${inner}${BT}" != "$ref" ]; then
      new="$(printf '%s\n' "$new" | sed -E "s@^(- $AT_G_ID) .* -- covers @\1 ${BT}${inner}${BT} -- covers @")"
    fi
  fi
  printf '%s\n' "$new"
}

# Apply at_fix_line across a contract. Linter-stable: line count is preserved
# and only failing AT rows are touched.
at_lint_fix() {
  local acc="$1" root tmp line fixed changed=0
  root="$(find_project_root 2>/dev/null)" || root="$(pwd)"
  [ -n "$root" ] || root="$(pwd)"
  tmp="$(mktemp "${TMPDIR:-/tmp}/intent_atfix.XXXXXX")" || error "cannot create temp file"
  while IFS= read -r line; do
    case "$line" in
      "- AT-"*)
        if at_row_arm "$line" >/dev/null 2>&1; then
          printf '%s\n' "$line" >> "$tmp"
        else
          fixed="$(at_fix_line "$line" "$root")"
          printf '%s\n' "$fixed" >> "$tmp"
          [ "$fixed" != "$line" ] && changed=$((changed + 1))
        fi
        ;;
      *) printf '%s\n' "$line" >> "$tmp" ;;
    esac
  done < "$acc"
  if ! cat "$tmp" > "$acc"; then
    rm -f "$tmp"
    error "cannot write $acc (check permissions) -- the file was NOT updated"
  fi
  rm -f "$tmp"
  echo "fix: $changed AT row(s) rewritten in $acc"
}

# ---- in-place edit (linter-stable: rewrites only the matched line) -------

replace_line() {
  local f="$1" expr="$2" tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/intent_acc.XXXXXX")" || error "cannot create temp file"
  if sed -E "$expr" "$f" > "$tmp"; then
    # The copy-back is checked too. Unchecked, an unwritable contract emitted a
    # raw shell "Permission denied" and carried on to print `ok:` -- the same
    # silent-success shape as issue 0006, one line further down.
    if ! cat "$tmp" > "$f"; then
      rm -f "$tmp"
      error "cannot write $f (check permissions) -- the file was NOT updated"
    fi
    rm -f "$tmp"
  else
    rm -f "$tmp"
    error "in-place edit failed for $f"
  fi
}

# Assert a mutation actually landed: re-read the row and confirm <extractor>
# now reports <want>. Errors naming the row, the file and what it still reads.
#
# This verifies the RESULT, not the mechanism, which is the whole point. `ac
# satisfy` printed its `ok:` unconditionally after a sed anchored on a
# ` -- evidence:` segment the row need not have -- and sed exits 0 having
# substituted nothing, so replace_line's exit-code check could not tell a no-op
# write from a real one. The tool that records verified state was reporting
# success having written nothing (issue 0006). Checking the post-state survives
# any future drift in the substitution pattern, and also catches a substitution
# that fired but wrote the wrong value, which a zero-substitution check inside
# replace_line could not. It reuses the same extractor the readers use, so
# there is no second pattern here to fall out of step with the first.
assert_written() {
  local acc="$1" id="$2" extractor="$3" want="$4" label="$5" line got
  line="$(find_line "$id" "$acc")"
  [ -n "$line" ] || error "write verification failed: $id is no longer in $acc"
  got="$("$extractor" "$line")"
  # Report what was OBSERVED, never what was inferred about the mechanism. The
  # message used to end "the file was NOT updated", which this check cannot know
  # and which was flatly false in the arm-mismatch case above: the write landed
  # and broke the row, so the reader saw nothing and the tool denied writing the
  # damage it had just done. A verifier of results states results.
  [ "$got" = "$want" ] || error "write verification failed: $id in $acc reads ${label}: ${got:-<absent>}, not ${want} -- the recorded state is not what was asked for; inspect the row in $acc before retrying"
}

# ---- commands ------------------------------------------------------------

cmd_ac_list() {
  [ -n "$1" ] || usage
  resolve_or_die "$1"
  local acc line id ats sat completed=no
  acc="$(acc_file)"
  warn_malformed "$acc"
  target_is_completed && completed=yes
  at_lint_report "$acc" "$completed" err || true
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    id="$(line_id "$line")"
    in_wp_filter "$id" || continue
    ats="$(ac_covering_ats "$id" "$acc")"
    [ -z "$ats" ] && ats=" -"
    case "$(ac_state "$line" "$acc")" in
      descoped)  sat="descoped-to: $(ac_descoped_to "$line")" ;;
      withdrawn) sat="withdrawn: $(ac_withdrawn_reason "$line")" ;;
      satisfied) sat="satisfied: yes" ;;
      *)         sat="satisfied: no" ;;
    esac
    printf 'ac: %s  covered-by:%s  %s\n' "$id" "$ats" "$sat"
  done <<EOF
$(ac_lines "$acc")
EOF
}

cmd_ac_status() {
  [ -n "$1" ] || usage
  resolve_or_die "$1"
  local acc line total=0 sat=0 desc=0 wdrawn=0 active verdict="BLOCKED" completed=no
  acc="$(acc_file)"
  warn_malformed "$acc"
  target_is_completed && completed=yes
  at_lint_report "$acc" "$completed" err || true
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    in_wp_filter "$(line_id "$line")" || continue
    total=$((total + 1))
    case "$(ac_state "$line" "$acc")" in
      descoped)  desc=$((desc + 1)) ;;
      withdrawn) wdrawn=$((wdrawn + 1)) ;;
      satisfied) sat=$((sat + 1)) ;;
    esac
  done <<EOF
$(ac_lines "$acc")
EOF
  active=$((total - desc - wdrawn))
  [ "$active" -gt 0 ] && [ "$sat" -eq "$active" ] && verdict="PASS"
  echo "ac: $sat/$active satisfied$(ac_offscope_suffix "$desc" "$wdrawn") -- $verdict"
}

# ", K descoped, W withdrawn" -- empty when there are none, so the ordinary case
# stays terse. Never folded into the satisfied count and never dropped: a thread
# that descoped half its contract has to look like one.
ac_offscope_suffix() {
  local desc="$1" wdrawn="$2" out=""
  [ "$desc" -gt 0 ]   && out="$out, $desc descoped"
  [ "$wdrawn" -gt 0 ] && out="$out, $wdrawn withdrawn"
  printf '%s' "$out"
}

# Close-gate (ST0044 WP-04; hardened ST0048). The single authority `st done` /
# `wp done` consult before closing. It REFUSES (exit 1 + a BLOCKED report) when
# the in-scope contract is not verifiably done:
#   - no `acceptance.md` at all (no contract);
#   - a present `acceptance.md` with zero acceptance criteria (empty contract);
#   - malformed AC/AT lines (F1);
#   - an in-scope AC unsatisfied.
#   - a scope that does not resolve to a real ST or WP (issue 0004).
# The sole escape is an explicit, visible `acceptance: exempt` in the frontmatter
# (the gate prints an EXEMPT line -- No Silent Errors; an exemption is announced,
# never inferred from emptiness). Default = enforced.
#
# EVERY exit path reports what it evaluated -- PASS/EXEMPT/BLOCKED (issue 0004).
# Silence used to be the gate's success signal, which is what hid the vacuous
# passes: an unresolvable scope evaluated nothing and exited 0 indistinguishably
# from a contract verified in full. A gate that cannot say what it checked
# cannot be trusted when it says nothing is wrong.
#
# WP scope (`<st>/NN`) stays WP-lenient -- a WP with no own ACs rolls up to the
# ST boundary as long as the thread carries a contract -- but the rollup is now
# granted only to a WP that EXISTS, and is announced when taken. A typo'd
# `<st>/99` matches no ACs for the same arithmetic reason a real AC-free WP
# does; only a directory probe tells the two apart.
cmd_ac_gate() {
  [ -n "$1" ] || usage
  local scope="$1"
  # Same resolver as every reader command; only the presentation differs -- the
  # gate speaks BLOCKED (it is read by machines via $?), the readers use error().
  local id dir acc
  if ! resolve_target "$scope"; then
    echo "gate: $scope BLOCKED -- $TARGET_REASON (nothing to evaluate)"
    exit 1
  fi
  id="$ST_ID"
  dir="$TARGET_DIR"
  acc="$dir/acceptance.md"
  if [ ! -f "$acc" ]; then
    echo "gate: $scope BLOCKED -- no acceptance.md (no contract). Author ACs in acceptance.md, or add 'acceptance: exempt' to its frontmatter."
    exit 1
  fi
  local exval
  exval="$(acceptance_field "$acc")"
  case "$exval" in
    exempt*)
      echo "gate: $scope EXEMPT -- acceptance.md declares 'acceptance: $exval'"
      exit 0
      ;;
  esac
  if ! warn_malformed "$acc"; then
    echo "gate: $scope BLOCKED -- malformed AC/AT line(s) in acceptance.md (see warnings); fix the contract"
    exit 1
  fi
  # The AT grammar is gated here from the day it ships (issue 0017). An estate
  # that has not been swept will BLOCK until it is, and that is the fix working:
  # every row it names was already providing no coverage, silently. `at lint
  # --fix` does the mechanical half.
  local completed=no
  target_is_completed && completed=yes
  if ! at_lint_report "$acc" "$completed" err; then
    echo "gate: $scope BLOCKED -- $AT_LINT_FAILS AT contract finding(s) over $AT_LINT_ROWS row(s) (see lint warnings); run 'intent at lint $id --fix', then fix what it reports"
    exit 1
  fi
  local line lid total=0 sat=0 desc=0 wdrawn=0 active unsat="" thread_total=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    thread_total=$((thread_total + 1))
    lid="$(line_id "$line")"
    in_wp_filter "$lid" || continue
    total=$((total + 1))
    case "$(ac_state "$line" "$acc")" in
      descoped)  desc=$((desc + 1)) ;;
      withdrawn) wdrawn=$((wdrawn + 1)) ;;
      satisfied) sat=$((sat + 1)) ;;
      *)         unsat="$unsat $lid" ;;
    esac
  done <<EOF
$(ac_lines "$acc")
EOF
  active=$((total - desc - wdrawn))
  if [ "$thread_total" -eq 0 ]; then
    echo "gate: $scope BLOCKED -- acceptance.md has zero acceptance criteria (empty contract). Define ACs, or mark 'acceptance: exempt' in the frontmatter."
    exit 1
  fi
  if [ "$total" -eq 0 ]; then
    # The WP exists (probed above) but carries no ACs of its own: the ST0044
    # WP-lenient rollup. Announced, not inferred -- same contract as EXEMPT.
    echo "gate: $scope PASS -- no ACs in scope; rolls up to the $id contract ($thread_total AC(s))"
    exit 0
  fi
  if [ "$active" -eq 0 ]; then
    # Every in-scope AC moved or was withdrawn, so there is nothing left to
    # verify. Routed to the EXISTING declared escape rather than passing on an
    # empty set: ST0048's rule is that an exemption is announced, never inferred
    # from emptiness, and a contract emptied one descope at a time is still
    # emptiness. Two ways to say "no contract to check" would be one too many.
    echo "gate: $scope BLOCKED -- all $total in-scope AC(s) are descoped or withdrawn; nothing is left to verify. If this unit is deliberately contract-free, declare 'acceptance: exempt' in the frontmatter."
    exit 1
  fi
  if [ "$sat" -eq "$active" ]; then
    echo "gate: $scope PASS -- $sat/$active satisfied$(ac_offscope_suffix "$desc" "$wdrawn")"
    exit 0
  fi
  echo "gate: $scope BLOCKED -- $sat/$active satisfied$(ac_offscope_suffix "$desc" "$wdrawn"); unsatisfied:${unsat}"
  exit 1
}

cmd_ac_satisfy() {
  local stid="$1" acid="$2"
  shift 2 2>/dev/null || usage
  local ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --evidence)   ref="$2"; shift 2 ;;
      --evidence=*) ref="${1#--evidence=}"; shift ;;
      *)            shift ;;
    esac
  done
  [ -n "$stid" ] && [ -n "$acid" ] || usage
  local acc line
  resolve_or_die "$stid"
  acc="$(acc_file)"
  line="$(find_line "$acid" "$acc")"
  [ -n "$line" ] || error "no such AC: $acid in $acc"
  # Before the test-backed question: an AC that has left this thread's scope is
  # not satisfiable by anyone, and its off-scope state is the more fundamental
  # fact about it than how it would have been proven (F2).
  ac_refuse_if_offscope "$line" "$acid" satisfy
  if ! ac_is_nontest "$line"; then
    # Name the cause, not the conclusion. An unclosed `(non-test` marker reaches
    # here classified test-backed, and being told the AC "is test-backed" sends
    # the author looking for a missing AT when the actual mistake is the marker
    # text three words into their own row (issue 0006).
    case "$line" in
      *"(non-test"*) error "$acid has an unclosed non-test marker -- it must read exactly '(non-test)', so this row is being treated as test-backed. Fix the marker in $acc, then re-run." ;;
      *)             error "$acid is test-backed; satisfaction is computed from a green covering AT, cannot be hand-satisfied" ;;
    esac
  fi
  [ -n "$ref" ] || error "ac satisfy requires --evidence \"<ref>\""
  local esc ref_esc
  esc="$(echo "$acid" | sed 's/\./\\./g')"
  ref_esc="$(printf '%s' "$ref" | sed -e 's/[&|\\]/\\&/g')"
  # Strip whatever evidence/satisfied tail the row has (either field, either
  # order of absence), then append a fresh canonical one. Substituting INTO a
  # tail the row need not carry is what made this a silent no-op on a bare row;
  # rewriting the tail is total over every shape a non-test AC actually occurs
  # in, so an author never has to hand-craft ` -- evidence: pending` first to
  # make the tool work (issue 0006).
  replace_line "$acc" "s|^(- ${esc} .*) -- evidence:.*|\1|; s|^(- ${esc} .*) -- satisfied:.*|\1|; s|^(- ${esc} .*[^ ])[[:space:]]*\$|\1 -- evidence: ${ref_esc} -- satisfied: yes|"
  assert_written "$acc" "$acid" ac_flag yes satisfied
  echo "ok: $acid satisfied by evidence"
}

cmd_at_list() {
  [ -n "$1" ] || usage
  resolve_or_die "$1"
  local acc line id completed=no
  acc="$(acc_file)"
  warn_malformed "$acc"
  target_is_completed && completed=yes
  at_lint_report "$acc" "$completed" err || true
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    id="$(line_id "$line")"
    in_wp_filter "$id" || continue
    printf 'at: %s  %s  %s\n' "$id" "$(at_pathname "$line")" "$(at_status "$line")"
  done <<EOF
$(at_lines "$acc")
EOF
}

# ---- off-scope verbs (issue 0013) ----------------------------------------

# Strip whatever state tail an AC row carries, back to bare prose. Each arm
# removes to end-of-line, so applying all four converges on the earliest marker
# present regardless of the order they were written in.
ac_strip_tail_expr() {
  local esc="$1"
  printf '%s' "s|^(- ${esc} .*) -- evidence:.*|\1|; s|^(- ${esc} .*) -- satisfied:.*|\1|; s|^(- ${esc} .*) -- descoped-to:.*|\1|; s|^(- ${esc} .*) -- withdrawn:.*|\1|"
}

# A field value that would break the line's own field structure is refused
# rather than escaped into something unreadable. The delimiter is the record
# format; a value containing it is not a value.
ac_check_field_text() {
  local what="$1" text="$2"
  case "$text" in
    *" -- "*) error "$what may not contain ' -- ' (it is the field delimiter): $text" ;;
  esac
  case "$text" in
    *[!\ ]*) : ;;
    *) error "$what may not be empty" ;;
  esac
}

# Shared by descope and withdraw: resolve, find the row, refuse a row already in
# an off-scope state, rewrite the tail, and VERIFY the write landed. Sets
# ACC/AC_LINE/ESC for the caller.
ac_offscope_prepare() {
  local stid="$1" acid="$2" verb="$3"
  resolve_or_die "$stid"
  ACC="$(acc_file)"
  AC_LINE="$(find_line "$acid" "$ACC")"
  [ -n "$AC_LINE" ] || error "no such AC: $acid in $ACC"
  ac_refuse_if_offscope "$AC_LINE" "$acid" "$verb"
  ESC="$(echo "$acid" | sed 's/\./\\./g')"
}

cmd_ac_descope() {
  local stid="$1" acid="$2"
  shift 2 2>/dev/null || usage
  local to="" by="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to)       to="$2"; shift 2 ;;
      --to=*)     to="${1#--to=}"; shift ;;
      --by)       by="$2"; shift 2 ;;
      --by=*)     by="${1#--by=}"; shift ;;
      --reason)   reason="$2"; shift 2 ;;
      --reason=*) reason="${1#--reason=}"; shift ;;
      *)          shift ;;
    esac
  done
  [ -n "$stid" ] && [ -n "$acid" ] || usage
  [ -n "$to" ] || error "ac descope requires --to <STnnnn>: the value of recording a move over a strike is that the requirement stays owned"
  ac_offscope_prepare "$stid" "$acid" "descope"
  local to_norm
  to_norm="$(normalise_st_id "$to")"
  # A descope to a thread that does not exist is a strike with extra steps, so
  # the destination is resolved before anything is written.
  [ "$to_norm" != "$ST_ID" ] || error "cannot descope $acid to its own thread ($ST_ID) -- name the thread that now owns it"
  resolve_st_dir "$to_norm" >/dev/null 2>&1 || error "no such steel thread: $to (nothing would own $acid)"
  [ -n "$by" ] || by="$(whoami 2>/dev/null || echo unknown)"
  ac_check_field_text "--by" "$by"
  local tail_txt=" -- descoped-to: ${to_norm} -- by: ${by} -- on: $(date +%Y-%m-%d)"
  if [ -n "$reason" ]; then
    ac_check_field_text "--reason" "$reason"
    tail_txt="${tail_txt} -- reason: ${reason}"
  fi
  tail_txt="${tail_txt} -- satisfied: n/a"
  local tail_esc
  tail_esc="$(printf '%s' "$tail_txt" | sed -e 's/[&|\\]/\\&/g')"
  replace_line "$ACC" "$(ac_strip_tail_expr "$ESC"); s|^(- ${ESC} .*[^ ])[[:space:]]*\$|\1${tail_esc}|"
  assert_written "$ACC" "$acid" ac_descoped_to "$to_norm" descoped-to
  echo "ok: $acid descoped to $to_norm"
}

cmd_ac_withdraw() {
  local stid="$1" acid="$2"
  shift 2 2>/dev/null || usage
  local by="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --by)       by="$2"; shift 2 ;;
      --by=*)     by="${1#--by=}"; shift ;;
      --reason)   reason="$2"; shift 2 ;;
      --reason=*) reason="${1#--reason=}"; shift ;;
      *)          shift ;;
    esac
  done
  [ -n "$stid" ] && [ -n "$acid" ] || usage
  # Every state-changing verb carries its own audit payload -- satisfy needs
  # --evidence, descope needs --to, withdraw needs --reason. A withdrawal with
  # no stated reason is a deleted line with extra steps, and deleting the line
  # is precisely the practice this verb exists to replace.
  [ -n "$reason" ] || error "ac withdraw requires --reason \"<text>\": a withdrawal with no recorded reason loses the only thing that distinguishes it from deleting the line"
  ac_check_field_text "--reason" "$reason"
  ac_offscope_prepare "$stid" "$acid" "withdraw"
  [ -n "$by" ] || by="$(whoami 2>/dev/null || echo unknown)"
  ac_check_field_text "--by" "$by"
  local tail_txt=" -- withdrawn: ${reason} -- by: ${by} -- on: $(date +%Y-%m-%d) -- satisfied: n/a"
  local tail_esc
  tail_esc="$(printf '%s' "$tail_txt" | sed -e 's/[&|\\]/\\&/g')"
  replace_line "$ACC" "$(ac_strip_tail_expr "$ESC"); s|^(- ${ESC} .*[^ ])[[:space:]]*\$|\1${tail_esc}|"
  assert_written "$ACC" "$acid" ac_withdrawn_reason "$reason" withdrawn
  echo "ok: $acid withdrawn"
}

# rescope / reinstate: the undo for each state, back to plain unsatisfied.
# They refuse each other's state rather than quietly doing the same thing --
# undoing a withdrawal and undoing a descope are different rulings, and a verb
# that accepts both teaches that they are interchangeable.
cmd_ac_unscope() {
  local verb="$1" stid="$2" acid="$3"
  [ -n "$stid" ] && [ -n "$acid" ] || usage
  resolve_or_die "$stid"
  local acc line esc
  acc="$(acc_file)"
  line="$(find_line "$acid" "$acc")"
  [ -n "$line" ] || error "no such AC: $acid in $acc"
  if [ "$verb" = "rescope" ]; then
    ac_is_descoped "$line" || {
      ac_is_withdrawn "$line" && error "$acid is withdrawn, not descoped -- use 'intent ac reinstate'"
      error "$acid is not descoped; nothing to rescope"
    }
  else
    ac_is_withdrawn "$line" || {
      ac_is_descoped "$line" && error "$acid is descoped to $(ac_descoped_to "$line"), not withdrawn -- use 'intent ac rescope'"
      error "$acid is not withdrawn; nothing to reinstate"
    }
  fi
  esc="$(echo "$acid" | sed 's/\./\\./g')"
  replace_line "$acc" "$(ac_strip_tail_expr "$esc")"
  # The row is back in scope and unsatisfied: a non-test AC loses the evidence
  # it had before the move, which is correct -- re-satisfying is a fresh, stated
  # act, not something inherited across a scope change.
  line="$(find_line "$acid" "$acc")"
  if ac_is_descoped "$line" || ac_is_withdrawn "$line"; then
    error "write verification failed: $acid in $acc still reads as off-scope -- the recorded state is not what was asked for; inspect the row in $acc before retrying"
  fi
  echo "ok: $acid back in scope (unsatisfied)"
}

cmd_at_lint() {
  local stid="" fix=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1; shift ;;
      -*)    error "unknown option for at lint: $1 (try: --fix)" ;;
      *)     [ -z "$stid" ] && stid="$1"; shift ;;
    esac
  done
  [ -n "$stid" ] || usage
  resolve_or_die "$stid"
  local acc completed=no
  acc="$(acc_file)"
  target_is_completed && completed=yes
  [ "$fix" -eq 1 ] && at_lint_fix "$acc"
  if at_lint_report "$acc" "$completed" out; then
    echo "lint: $ST_ID ok -- $AT_LINT_ROWS AT row(s) conform"
    exit 0
  fi
  echo "lint: $ST_ID FAILED -- $AT_LINT_FAILS finding(s) over $AT_LINT_ROWS AT row(s)"
  exit 1
}

cmd_at_set() {
  local target="$1" stid="$2" atid="$3"
  [ "$target" = "na" ] && target="n/a"
  [ -n "$stid" ] && [ -n "$atid" ] || usage
  local acc line cur esc
  resolve_or_die "$stid"
  acc="$(acc_file)"
  line="$(find_line "$atid" "$acc")"
  [ -n "$line" ] || error "no such AT: $atid in $acc"
  cur="$(at_status "$line")"
  # An unreadable status is its own diagnosis, not a transition failure. Falling
  # through to the red->green message would report the row's state as '' and
  # send the author to `at red` when the row needs its status field repaired.
  # Every field now reads empty on a row that fails the grammar, so the status
  # class is separated from the rest before the row is blamed on its status.
  if [ -z "$cur" ]; then
    if ! at_status_in_vocab "$(at_status_loose "$line")"; then
      error "$atid has an unreadable status in $acc -- vocabulary is $AT_STATUS_VOCAB (markdown emphasis around the value is NOT parsed). Fix the row, then re-run."
    fi
    error "$atid does not match the AT row grammar in $acc -- $(at_row_defect "$line"). Run 'intent at lint $stid' (--fix migrates what is mechanical), then re-run."
  fi
  # The target status must belong to the row's OWN arm, and this is checked
  # BEFORE any write. Without it, `at na` on a test row (and `at red` on a
  # (non-test) row) substituted a status that row's arm does not admit: the write
  # LANDED, pushed the row out of the grammar, and the strict reader then read
  # nothing back -- so assert_written reported "the file was NOT updated" about a
  # file it had just updated, leaving behind the invalid row it denied writing.
  # A false statement about disk state is the one thing that verifier exists to
  # prevent, so the mismatch is refused up front rather than diagnosed after the
  # damage. The row's arm is already computed by the grammar; nothing new is
  # parsed here.
  local arm
  arm="$(at_row_arm "$line")"
  if [ "$target" = "n/a" ] && [ "$arm" != "nontest" ]; then
    error "at na: $atid is a test-backed AT, and n/a is the non-test status -- its states are to-write, red and green. If this row records a doc or eyeball check rather than a test, mark it '(non-test)' in $acc first."
  fi
  if [ "$target" != "n/a" ] && [ "$arm" = "nontest" ]; then
    error "at $target: $atid is a (non-test) AT and is n/a by definition -- it records a doc or eyeball check and can never be green, so it never satisfies anything. Satisfy its AC directly: intent ac satisfy $stid <AC-id> --evidence \"...\""
  fi
  if [ "$target" = "green" ] && [ "$cur" != "red" ]; then
    error "at green: $atid is '$cur'; green is reachable only from red (run 'intent at red $stid $atid' first)"
  fi
  # The citation goes load-bearing at exactly this moment, so it is resolved
  # here rather than at the next gate: catching a rename at the point of the
  # lie is the difference between a stale row and a green AT that has been
  # counted as coverage for months (issue 0015).
  if [ "$target" = "green" ] || [ "$target" = "red" ]; then
    if ! at_is_nontest_row "$line"; then
      local ref root
      ref="$(at_pathname "$line")"
      root="$(find_project_root 2>/dev/null)" || root="$(pwd)"
      [ -n "$root" ] || root="$(pwd)"
      [ -f "$root/$ref" ] || error "at $target: $atid cites a test file that does not exist: $ref -- a $target AT must resolve against the tree. Fix the citation (or 'intent at lint $stid --fix' if it just needs migrating), then re-run."
    fi
  fi
  esc="$(echo "$atid" | sed 's/\./\\./g')"
  replace_line "$acc" "s|^(- ${esc} .*) -- status:.*|\1 -- status: ${target}|"
  assert_written "$acc" "$atid" at_status "$target" status
  echo "ok: $atid -> $target"
}

# ---- dispatch ------------------------------------------------------------

NOUN="$1"
shift 2>/dev/null || usage
[ $# -ge 1 ] || usage
VERB="$1"
shift

case "$NOUN" in
  ac)
    case "$VERB" in
      list)      cmd_ac_list "$@" ;;
      status)    cmd_ac_status "$@" ;;
      satisfy)   cmd_ac_satisfy "$@" ;;
      gate)      cmd_ac_gate "$@" ;;
      descope)   cmd_ac_descope "$@" ;;
      withdraw)  cmd_ac_withdraw "$@" ;;
      rescope)   cmd_ac_unscope rescope "$@" ;;
      reinstate) cmd_ac_unscope reinstate "$@" ;;
      *)         error "unknown ac command: $VERB (try: list, status, satisfy, gate, descope, rescope, withdraw, reinstate)" ;;
    esac
    ;;
  at)
    case "$VERB" in
      list)         cmd_at_list "$@" ;;
      lint)         cmd_at_lint "$@" ;;
      red|green|na) cmd_at_set "$VERB" "$@" ;;
      done)         cmd_at_set green "$@" ;;
      notdone)      cmd_at_set red "$@" ;;
      *)            error "unknown at command: $VERB (try: list, lint, red, green, na, done, notdone)" ;;
    esac
    ;;
  *)
    usage
    ;;
esac
