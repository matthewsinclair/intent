#!/usr/bin/env bash
#
# The built-in `macos` (issue 0226): a macOS app's release, the one copy for
# every project that ships a .app. Opt-in, like `release`: a project enables it
# with `commands.macos.enabled: true` and declares the app in a `macos:` block.
# A project's own `macos` handler or `run:` still wins, as for any built-in.
#
#   macos doctor        the platform, the declaration, the tools, the identity
#                       and the notary credentials, each PRESENT or MISSING
#   macos store-creds   the notary credentials into the login keychain
#   macos app-sign      build (when macos.build says how), stage a copy, sign it
#   macos app-notarize  submit the signed copy, wait, staple, check it
#   macos app-verify    the staged copy's signature and ticket, changing nothing
#   macos publish       zip the stapled copy, prove the zip, attach it to the
#                       release at its tag through `release attach --from`
#
# THE APP HALF OF THE COMMANDS PROJECTS CARRIED, hoisted (issue 0226). Each
# project read its credentials from the login keychain under its own prefix,
# staged its own copy of the build product and attached its own asset, so a fix
# to notarisation or stapling had to be made in each copy. What was a project's
# shape is a key here: the app, how it is built, its bundle id, its
# entitlements, the team, the notary profile and the asset's name (lib/config's
# _DEVBIN_MACOS_SCHEMA). What stays a project's is what a key cannot say: its
# icons, its other build products, its own stamps.
#
# CREDENTIALS LIVE IN THE LOGIN KEYCHAIN AND NOWHERE ELSE: no key material in
# the tree, in CI config or in any file this writes, and nothing here prints a
# value. Every notarisation submits under one notarytool keychain profile,
# macos.notary_profile, which store-creds has notarytool store; the identity is
# found in the keychain, picked by macos.team. doctor reports the profile as
# PRESENT or NOT USABLE, and the signing identity by count and team, never
# whole.
#
# THE SUBJECT OF SIGNING IS A STAGED COPY OUTSIDE THE BUILD TREE, never the
# build product, which any build on this machine can replace mid-notarisation.
# The stage is under XDG state, one per checkout, and app-sign refuses a stage
# at or under the project root or the product's own directory.
#
# AN APP MAY VERSION APART FROM ITS PROJECT (issue 0243). The tag and the
# release are the project's whatever the app's version is; macos.version_from
# names the file the app's own version is read from, and an app that versions
# apart must declare macos.commit_stamp, the Info.plist key its build writes
# its commit into, since its version cannot show a copy is the release's build. A
# declared kind stamp must carry macos.kind_value. Each is checked wherever the
# version is: the staged copy at app-sign, and the stapled copy and the zip's
# own at publish.
#
# EVERY COPY A STEP MAKES IS DROPPED FROM LAUNCH SERVICES ON EVERY PATH OUT
# (issue 0243). codesign, stapler and spctl can register a copy, and a record
# left makes the bundle id open a staged or deleted copy rather than the
# installed app. One EXIT trap, drop_on_exit, drops the staged copy, the
# Gatekeeper check's copy and publish's proof copy, ignoring INT, TERM and HUP
# from its first line through every drop and removal, then reads the record
# list back. A record left on the staged copy warns, since each step, publish
# the last, drops it again and Launch Services can register it again on its
# own. One left on the Gatekeeper check's copy or on publish's proof copy,
# which are gone, fails the run. After publish's upload, every record at or
# under macos.build_root is dropped too, and one that stays warns: a build can
# register its product again after any drop. That drop is outside the hold, so
# an interrupt during it exits 1 after publish has printed what it published. A
# root that is /, or holds the home directory or a directory installed apps
# live in, the system's own among them, is refused before anything is built or
# uploaded.
#
# MACOS ONLY. Off macOS every subcommand refuses with exit 2, devbin's code for
# what is not available here, before the config or any tool is read. The
# subcommand word is checked first, which reads nothing, so `macos all` is the
# same usage error on every platform.
#
# EVERY ARGUMENT IS PARSED BEFORE ANYTHING ACTS, and `-h` or `--help` in any
# position prints usage and exits 0 on any platform (issue 0064's rule, as in
# lib/cmd/release).
set -euo pipefail

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
# shellcheck source=lib/config
. "$DEVBIN_LIB/config"

ME="${DEVBIN_INVOKE:-bin/devbin} macos"

usage() {
  cat <<USAGE
usage: $ME <doctor|store-creds|app-sign|app-notarize|app-verify|publish|bin-sign|bin-notarize|bin-verify|bin-publish|leg>

  A macOS app's release, on macOS only, for the app the macos: block of
  bin/.devbin/config.yaml declares. On the maintainer's machine, in a tree
  whose HEAD is the release's commit: the tag's once it is cut, or before then
  the release commit, where a cut's macos leg signs (once main has moved past
  the tag, a worktree: git worktree add --detach <dir> <tag>). publish
  attaches to the release object, so it runs once the tag is cut. In order:

  app-sign      macos.build, when declared, at the project root; a copy of
                macos.app staged under XDG state, outside the build tree; the
                copy refused, with nothing signed, unless its bundle id is
                macos.bundle_id, its version the app's (macos.version_from,
                else the project's) and its declared stamps the release's
                commit's; then signed inside-out with the Developer ID
                identity and the hardened runtime, its identifier, team and
                runtime read back, and the commit it was signed at recorded.
                Refuses, building nothing, unless HEAD, in a clean tree, is
                the release's commit: the tag's, or before the tag is cut the
                release commit of the project's version
  app-notarize  Submit the signed copy to Apple and wait; staple the ticket
                only when Accepted; check a quarantined copy with spctl
  publish       Refuses, uploading nothing, unless the stapled copy was
                signed at the tag's commit, by app-sign's record; then zip it
                as macos.asset, prove the zip as a download meets it, and
                attach it to the release at the tag with release attach
                --from, the core's one way an asset reaches a release, which
                writes SHA256SUMS over every asset

  app-verify    The staged copy's signature and ticket; changes nothing

  Command-line binaries, and a .app beside them, each under macos.binaries
  and read from macos.bin_dir, in the same order:

  bin-sign      macos.build, when declared and no macos.app is; each binary
                staged under XDG state, outside the build tree; each signed
                with the Developer ID identity, the hardened runtime and a
                secure timestamp, and read back against its designated
                requirement and its entitlements; the commit they were signed
                at recorded. Refuses, building nothing, unless HEAD, in a
                clean tree, is the release's commit, as app-sign does
  bin-notarize  Submit every signed binary to Apple in one archive and wait;
                once Accepted, Gatekeeper's verdict on each; nothing stapled
  bin-publish   Refuses, uploading nothing, unless the binaries were signed at
                the tag's commit, by bin-sign's record; then pack them as
                <project>-<version>-<host triple>.tar.gz, a .app at the root,
                every other binary under bin/ and macos.pack.files at the
                root, and attach it with release attach --from. Already,
                packing nothing, where the release carries the archive with
                SHA256SUMS naming it; a cut runs it in its object step,
                before the formula step, under release.object local
  bin-verify    Each staged binary's signature and Gatekeeper's verdict;
                changes nothing
  leg           A cut's macOS stage: app-sign and app-notarize where macos.app
                is declared, bin-sign and bin-notarize where macos.binaries is
                declared under release.object local

  doctor        The platform, the declaration, the tools, the Developer ID
                identity (counted, with its team and a test-sign) and the
                notary profile (PRESENT or NOT USABLE, never a value). Exit 1
                when anything is missing or the identity cannot sign
  store-creds   Store the notary profile macos.notary_profile names in the
                login keychain, through notarytool store-credentials, which
                prompts for each value and checks them with Apple; interactive,
                in a terminal only, and no value passes through this command

  Off macOS every subcommand refuses as not available here. See
  ${DEVBIN_INVOKE:-bin/devbin} help macos.
USAGE
}

SUBCOMMANDS="doctor store-creds app-sign app-notarize app-verify publish bin-sign bin-notarize bin-verify bin-publish leg"

# --help first, over every argument, so no later word can act or refuse first.
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

if [ $# -eq 0 ]; then
  usage >&2
  exit 1
fi

# --- parse ----------------------------------------------------------------
sub="$1"
shift
case "$sub" in
  doctor | store-creds | app-sign | app-notarize | app-notarise | app-verify | publish) ;;
  bin-sign | bin-notarize | bin-notarise | bin-verify | bin-publish | leg) ;;
  *)
    usage >&2
    printf '\n' >&2
    die "macos: unknown subcommand '$sub' (one of: $SUBCOMMANDS)"
    ;;
esac
[ $# -eq 0 ] || die "macos $sub takes no arguments, got: $* (try: $ME --help)"

# --- the platform ---------------------------------------------------------
# Before the config or any tool is read: nothing here runs off macOS. The word
# is platform_word's, the one map from the OS name to a platform word.
platform="$(platform_word)" || platform=""
if [ "$platform" != macos ]; then
  warn "macos: $sub runs on macOS only, and this host is ${platform:-one with no platform word} -- codesign, notarytool, stapler and the login keychain are Apple's"
  # code-2: not available here, the dispatcher's code for a command that is not.
  exit 2
fi

# --- the declaration ------------------------------------------------------
# THE CONFIG CACHE DOES NOT CROSS INTO A HANDLER (lib/cmd/release says why), so
# a config that does not load stops the command.
ROOT="${PROJECT_ROOT:?}"
cd "$ROOT" || die "cannot enter $ROOT"
cfg_load "${DEVBIN_DIR:?}/config.yaml" || die "macos: cannot read $DEVBIN_DIR/config.yaml"
# The release core's readers, for the tag a version is released under and the
# names an asset may take, sourced as lib/cmd/release sources them.
# shellcheck source=lib/runlog
. "$DEVBIN_LIB/runlog"
# shellcheck source=lib/release.notes
. "$DEVBIN_LIB/release.notes"
# shellcheck source=lib/release.steps
. "$DEVBIN_LIB/release.steps"
# The binaries' archive's one naming and its one read of a release (issue
# 0323), shared with the cut's object step.
# shellcheck source=lib/release.macos
. "$DEVBIN_LIB/release.macos"
# Validated whole, as the release core validates it, so a pair rule such as
# macos.kind_value's holds here too and not only in doctor.
cfg_validate || die "macos: $DEVBIN_DIR/config.yaml does not validate (above)"

# macos_key <key> -- a macos: value, or the command stops naming the read.
macos_key() { cfg_macos_get "$1" || die "macos: cannot read macos.$1"; }

# macos_path <key> -- macos.<key> as a path, read by lib/config's
# cfg_macos_path_of, the one reading of a macos path: a leading `~`, `$HOME` or
# XDG base-directory variable expanded, then a relative path read from the
# project root; empty stays empty. A value that opens with a `~` or a `$` that
# cannot be expanded stops the command, naming the key and what it opens with,
# so it is never read as a path in the project.
macos_path() {
  local v
  v="$(macos_key "$1")"
  macos_path_value "macos.$1" "$v"
}

# macos_path_value <key's name> <value> -- <value>, the value of the key named,
# as a path, by macos_path's one reading: the stop for a scalar key and for a
# binary's field (issue 0323) alike.
macos_path_value() {
  local v="$2" p rc=0
  p="$(cfg_macos_path_of "$v" "$ROOT")" || rc=$?
  case "$rc" in
    0) printf '%s' "$p" ;;
    2) die "macos: $1 is $v, and HOME (${HOME:-unset}) is not an absolute path below /, so it cannot be expanded" ;;
    *) die "macos: $1 is $v, which opens with $p, and only ~, \$HOME, \$XDG_STATE_HOME, \$XDG_DATA_HOME, \$XDG_CONFIG_HOME and \$XDG_CACHE_HOME are expanded, each written alone as \$NAME or \${NAME}: an XDG variable that is unset falls back to its XDG default" ;;
  esac
}

APP_SRC="$(macos_path app)"
APP_BUILD="$(macos_key build)"
APP_BUNDLE_ID="$(macos_key bundle_id)"
APP_ENTITLEMENTS="$(macos_path entitlements)"
APP_COMMIT_STAMP="$(macos_key commit_stamp)"
APP_KIND_STAMP="$(macos_key kind_stamp)"
APP_KIND_VALUE="$(macos_key kind_value)"
# Where publish's last Launch Services drop looks: macos.build_root, else the
# directory holding the app, so the build product's own record is dropped for
# any project.
APP_BUILD_ROOT="$(macos_path build_root)"
if [ -z "$APP_BUILD_ROOT" ] && [ -n "$APP_SRC" ]; then
  APP_BUILD_ROOT="${APP_SRC%/*}"
  [ -n "$APP_BUILD_ROOT" ] || APP_BUILD_ROOT=/
fi
# THE NOTARY CREDENTIAL IS ONE notarytool KEYCHAIN PROFILE (issue 0323), the
# one every notarisation submits under, an app's and a binary's alike, and the
# team picks the Developer ID identity when the keychain holds more than one.
NOTARY_PROFILE="$(macos_key notary_profile)"
MACOS_TEAM="$(macos_key team)"
APP_NAME="${APP_SRC##*/}"
APP_ASSET="$(macos_key asset)"
[ -n "$APP_ASSET" ] || APP_ASSET="${APP_NAME:+$APP_NAME.zip}"

# THE STAGE, one per checkout: two worktrees of one project, one of them at the
# tag, must not sign each other's copy. Under XDG state, keyed by the project's
# name and its root's sha256.
stage_key() {
  local sum
  sum="$(printf '%s' "$ROOT" | sha256_stdin 2>/dev/null)" || sum=""
  [ -n "$sum" ] || die "macos: could not hash the project root to name its stage"
  printf '%s-%s' "${DEVBIN_NAME:-${ROOT##*/}}" "${sum:0:12}"
}
APP_STATE_BASE="$(xdg_dir state)" ||
  die "macos: there is no XDG state directory to stage in: XDG_STATE_HOME is not an absolute path, and HOME (${HOME:-unset}) is not an absolute path below /"
APP_STAGE_DIR="$APP_STATE_BASE/devbin/macos/$(stage_key)"
app_dist() { printf '%s' "$APP_STAGE_DIR/$APP_NAME"; }
# THE COMMIT THE STAGED COPY WAS SIGNED AT (ST0011 WP-06), one full sha on one
# line beside it, written by app-sign once the signature reads back. publish
# ships the copy only when this is the tag's commit, so a copy signed at the
# release commit before its tag was cut, as a cut's macos leg signs it, ships,
# and one signed at any other commit does not.
APP_STAGE_RECORD="$APP_STAGE_DIR/commit"
# THE BINARIES' STAGE (issue 0323), a sibling of the app's and never inside it,
# since app-sign removes its stage whole: the staged binaries under stage/, and
# the commit bin-sign signed them at beside it, read by bin-publish as publish
# reads the app's.
BIN_DIR="$(macos_path bin_dir)"
BIN_STATE_DIR="$APP_STAGE_DIR.bin"
BIN_STAGE_DIR="$BIN_STATE_DIR/stage"
BIN_STAGE_RECORD="$BIN_STATE_DIR/commit"

# require_declared -- the keys a release cannot be made without. Each one
# missing is named, all at once.
require_declared() {
  local missing=""
  [ -n "$APP_SRC" ] || missing+=", macos.app (the .app bundle the build leaves)"
  [ -n "$APP_BUNDLE_ID" ] || missing+=", macos.bundle_id (the bundle id it is signed as)"
  [ -z "$missing" ] || die "macos: $DEVBIN_DIR/config.yaml declares no ${missing#, } -- see ${DEVBIN_INVOKE:-bin/devbin} help macos"
  case "$APP_NAME" in
    *.app) ;;
    *) die "macos: macos.app is $APP_SRC, which is not a .app bundle's path" ;;
  esac
  if [ -n "$APP_ENTITLEMENTS" ] && [ ! -f "$APP_ENTITLEMENTS" ]; then
    die "macos: macos.entitlements is $APP_ENTITLEMENTS, and there is no such file"
  fi
  local why
  if why="$(release_name_problem "$APP_ASSET")"; then
    die "macos: the asset $APP_ASSET cannot be a release asset: $why -- declare macos.asset"
  fi
}

# --- the keychain -----------------------------------------------------------

# load_identity -- the signing identity, FOUND in the keychain, never composed:
# the "Developer ID Application" identity whose team is macos.team, else the
# one the keychain lists when it lists one. IDENTITY_COUNT is how many it
# lists, and IDENTITY_TEAMS their teams, comma-separated.
#
# MORE THAN ONE AND NO TEAM IS NO PICK (issue 0323): signing with the first of
# several is signing with an identity nobody chose, and the readback compares
# the bundle with that same pick, so it could never catch a wrong one.
# IDENTITY stays empty, and require_identity names the teams and the key.
load_identity() {
  local listed t
  local -a teams=()
  listed="$({ security find-identity -v -p codesigning 2>/dev/null || true; } |
    sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' | sort -u)"
  IDENTITY_COUNT="$(grep -c . <<<"$listed" || true)"
  while IFS= read -r t; do
    [ -z "$t" ] || teams+=("$t")
  done < <(sed -n 's/.*(\([^()]*\))$/\1/p' <<<"$listed" | sort -u)
  IDENTITY_TEAMS="$(printf '%s, ' ${teams[@]+"${teams[@]}"})"
  IDENTITY_TEAMS="${IDENTITY_TEAMS%, }"
  if [ -n "$MACOS_TEAM" ]; then
    IDENTITY="$(grep -F "($MACOS_TEAM)" <<<"$listed" | sed -n 1p || true)"
  elif [ "$IDENTITY_COUNT" -gt 1 ]; then
    IDENTITY=""
  else
    IDENTITY="$(sed -n 1p <<<"$listed")"
  fi
}

# identity_team -- the team the identity names, from its trailing "(TEAMID)".
identity_team() {
  local t="${IDENTITY##*(}"
  printf '%s' "${t%)}"
}

# identity_unpicked -- true when the keychain lists more than one identity and
# no macos.team picks one.
identity_unpicked() { [ -z "$MACOS_TEAM" ] && [ "${IDENTITY_COUNT:-0}" -gt 1 ]; }

require_identity() {
  [ -z "$IDENTITY" ] || return 0
  identity_unpicked &&
    die "macos: the login keychain holds $IDENTITY_COUNT Developer ID Application identities, of the teams $IDENTITY_TEAMS, and no macos.team picks one -- declare macos.team as the team to sign with"
  die "macos: no Developer ID Application identity in the login keychain${MACOS_TEAM:+ for the team macos.team names} -- run: $ME doctor"
}

# notary_submit <zip> -- <zip> submitted to Apple under the notary profile,
# waiting for the verdict: 0 when it is Accepted; 1 when it is anything else,
# NOTARY_STATUS holding it and notarytool's log printed; 3 when notarytool gave
# no submission id, as it gives none for a profile the keychain does not hold
# (3, never 2, which is the dispatcher's word under lib/cmd).
# notarytool's report is printed, and it exits non-zero on an Invalid verdict,
# so the verdict is read from the report. Every notarisation goes through here,
# an app's and a binary's, and each caller clears its own submission and says
# what it did not do.
notary_submit() {
  local zip="$1" out id
  out="$(xcrun notarytool submit "$zip" --keychain-profile "$NOTARY_PROFILE" --wait 2>&1)" || true
  printf '%s\n' "$out"
  NOTARY_STATUS="$(awk '/^  status: / { s = $2 } END { print s }' <<<"$out")"
  id="$(awk '/id: [0-9a-f-]+/ { print $2; exit }' <<<"$out")"
  [ -n "$id" ] || return 3
  if [ "$NOTARY_STATUS" != Accepted ]; then
    xcrun notarytool log "$id" --keychain-profile "$NOTARY_PROFILE" 2>&1 | sed -n '1,40p' || true
    return 1
  fi
  return 0
}

# notary_refused <rc> <what was not done> -- the stop for notary_submit's
# non-zero answer, naming the profile when there was no submission at all.
notary_refused() {
  case "$1" in
    3) die "macos: notarytool gave no submission id under the notary profile $NOTARY_PROFILE -- $2; store the profile with: $ME store-creds (see: $ME doctor)" ;;
    *) die "macos: notarisation was not Accepted (status: ${NOTARY_STATUS:-unknown}) -- $2" ;;
  esac
}

# --- the bundle -------------------------------------------------------------

# plist_get <bundle> <key> -- one key of a bundle's Info.plist, or empty.
plist_get() { plutil -extract "$2" raw -o - "$1/Contents/Info.plist" 2>/dev/null || true; }

app_executable() { # $1 bundle
  local name
  name="$(plist_get "$1" CFBundleExecutable)"
  printf '%s' "$1/Contents/MacOS/${name:-$(basename "$1" .app)}"
}

# --- Launch Services --------------------------------------------------------
#
# Every copy of ours that codesign, stapler or spctl can register has its
# record dropped on every path out, and the drop is checked: the record list is
# read whole and must hold none at or under the copy (issue 0243). Every drop
# of a copy runs with INT, TERM and HUP ignored and every read-back without, so
# a signal can cut short only a read. publish's last drop, of the build's own
# records under the build root, only warns, and runs without the hold. These
# print and return, and each caller says a failure in its own voice.

# Launch Services' registrar, not on PATH on macOS.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

# ls_cmd -- lsregister: an executable one on PATH first (a test's fake), then
# the system's.
ls_cmd() {
  local found
  if found="$(command -v lsregister)" && [ -x "$found" ]; then
    printf '%s\n' "$found"
  else
    printf '%s\n' "$LSREGISTER"
  fi
}

# ls_records_parse <dir> -- from lsregister -dump's text on stdin, the paths of
# the records at or under <dir>, one a line and each once, read without its
# ` (0x...)` id. Exit 3 when the text holds no path: line at all: the real list always
# holds the system's own apps, so none means it was not read. Any other
# non-zero is awk's own failure.
ls_records_parse() {
  VALUE="$1" awk '
    /^path:/ {
      seen = 1
      p = $0
      sub(/^path:[ \t]+/, "", p); sub(/ \(0x[0-9a-fA-F]+\)$/, "", p)
      if ((p == ENVIRON["VALUE"] || index(p, ENVIRON["VALUE"] "/") == 1) && !listed[p]++) print p
    }
    END { if (!seen) exit 3 }'
}

# ls_records <dir> -- ls_records_parse over lsregister -dump, read whole. rc 1,
# printing why on one line, when the list cannot be read: a failed -dump, with
# the first line it said, one that lists no path: line, or a search that failed.
ls_records() {
  local dump rc=0 found prc=0 said
  dump="$("$(ls_cmd)" -dump 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    said="${dump%%$'\n'*}"
    printf 'lsregister -dump failed (exit %s), saying %s\n' "$rc" "${said:-nothing}"
    return 1
  fi
  found="$(ls_records_parse "$1" <<<"$dump")" || prc=$?
  case "$prc" in
    0) ;;
    3)
      printf 'lsregister -dump listed no record at all, so the list was not read\n'
      return 1
      ;;
    *)
      printf 'the record list could not be searched (exit %s)\n' "$prc"
      return 1
      ;;
  esac
  [ -z "$found" ] || printf '%s\n' "$found"
}

# ls_unregister <bundle> -- lsregister -u, its words in LS_ANSWER and its exit
# in LS_URC for ls_report. The real lsregister exits non-zero on a path it holds
# no record for, the usual answer for a fresh copy, so LS_URC alone decides
# nothing: the record list does.
LS_ANSWER=""
LS_URC=0
ls_unregister() {
  LS_URC=0
  LS_ANSWER="$("$(ls_cmd)" -u "$1" 2>&1)" || LS_URC=$?
}

# ls_report <bundle> <dir> <urc> <answer> -- after an lsregister -u <bundle>
# that exited <urc> saying <answer>, the record list must hold no record at or
# under <dir>. Prints nothing when it holds none; otherwise one line for each
# record left, or one saying the list was not read, each naming the path and
# the command that drops it, quoted as a shell reads it, and returns 1.
ls_report() {
  local bundle="$1" dir="$2" urc="$3" said="${4%%$'\n'*}" ls left rc=0 why path shown
  printf -v ls '%q' "$(ls_cmd)"
  left="$(ls_records "$dir")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf -v shown '%q' "$bundle"
    printf 'could not drop the Launch Services record for %s: %s, so whether it is gone is unknown; drop it with: %s -u %s\n' "$bundle" "$left" "$ls" "$shown"
    return 1
  fi
  [ -n "$left" ] || return 0
  if [ "$urc" -ne 0 ]; then
    why="lsregister -u said: ${said:-nothing} (exit $urc)"
  else
    why="lsregister -u exited 0 and the record is still listed"
  fi
  while IFS= read -r path; do
    printf -v shown '%q' "$path"
    printf 'could not drop the Launch Services record for %s: %s; drop it with: %s -u %s\n' "$path" "$why" "$ls" "$shown"
  done <<<"$left"
  return 1
}

# ls_drop <bundle> <dir> <remove> -- with INT, TERM and HUP already ignored by
# the caller: the record of our copy <bundle> dropped (ls_unregister), and <dir>
# removed when <remove> is yes, each path as Launch Services lists it. A dir not
# removed adds its line to LS_LINES and returns 1. Runs in the caller's shell,
# never in a `$(...)`: the signals held are the caller's.
LS_LINES=""
ls_drop() {
  local shown
  ls_unregister "$1"
  [ "$3" = yes ] || return 0
  rm -rf -- "$2" && return 0
  printf -v shown '%q' "$2"
  LS_LINES+="could not remove $2; remove it with: rm -rf $shown"$'\n'
  return 1
}

# ls_check <bundle> <dir> <urc> <answer> -- the read-back after ls_drop
# (ls_report), its lines added to LS_LINES; rc 1 when there are any.
ls_check() {
  local said
  said="$(ls_report "$@")" && return 0
  LS_LINES+="$said"$'\n'
  return 1
}

# ls_say -- each line of LS_LINES said on stderr, after whatever the run said.
ls_say() {
  local line
  while IFS= read -r line; do
    [ -z "$line" ] || warn "macos: $line"
  done <<<"$LS_LINES"
}

# build_root_why <dir> -- why <dir>, as Launch Services lists it, cannot be the
# root of publish's last drop, on one line with rc 0; rc 1 when it can be. The
# drop unregisters every record at or under its root, so the root must not be
# /, and must hold neither the home directory nor a directory installed apps
# live in, the system's own among them, whose records would go with it.
build_root_why() {
  local p at home="${HOME:-}"
  if [ "$1" = / ]; then
    printf 'is /, so the drop would sweep every record on this Mac'
    return 0
  fi
  for p in "$home" /Applications "${home:+$home/Applications}" /System/Applications /System/Library/CoreServices; do
    [ -n "$p" ] || continue
    cargo_place "$p" at getcwd || at="$p"
    case "$at/" in
      "$1"/*)
        printf 'holds %s, so the drop would sweep the records of the apps installed there' "$at"
        return 0
        ;;
    esac
  done
  return 1
}

# ls_drop_under <dir> -- every record at or under <dir> dropped, each drop
# checked as ls_report reads it: publish's last step, for the build products a
# build registers. The records go deepest first, so a record nested in a bundle,
# a plugin's, is dropped before its container's read-back, which would
# otherwise list it. Prints each line to say, and returns 1 when a record is left,
# the list was not read, or <dir> cannot be resolved or is no root for it
# (build_root_why), which drops nothing.
ls_drop_under() {
  local dir found path said why rc=0
  if [ -z "$1" ] || ! cargo_place "$1" dir getcwd; then
    printf 'could not resolve %s as Launch Services lists it, so the records under it were not read\n' "${1:-an empty build root}"
    return 1
  fi
  if why="$(build_root_why "$dir")"; then
    printf 'did not drop the Launch Services records under %s, which %s\n' "$dir" "$why"
    return 1
  fi
  if ! found="$(ls_records "$dir")"; then
    printf 'could not drop the Launch Services records under %s: %s\n' "$dir" "$found"
    return 1
  fi
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    ls_unregister "$path"
    if ! said="$(ls_report "$path" "$path" "$LS_URC" "$LS_ANSWER")"; then
      printf '%s\n' "$said"
      rc=1
    fi
  done < <(LC_ALL=C sort -r <<<"$found")
  return "$rc"
}

# The copies the EXIT trap drops, globals because bash runs an EXIT trap with a
# function's locals already unwound: the staged copy, placed when the trap is
# armed, whose record left warns with the exit standing, since the next step
# drops it again and Launch Services can register it again on its own; the
# Gatekeeper check's copy and its dir, set while they exist; and publish's
# proof copy with its staging dir, and whether the attach finished. Either of
# the last two left fails the run, leading with what is true when the asset is
# already up.
_DIST_TO_DROP=""
_CHECK_DIR=""
_PUBLISH_STAGING=""
_PUBLISHED=no

# drop_on_exit -- the EXIT trap of app-sign, app-notarize, app-verify and
# publish (arm_drops). INT, TERM and HUP are ignored at once, before anything
# forks, through every drop and removal, and one handled before that first line
# does nothing (arm_drops); then they are put back to their defaults for the
# read-backs, since the shell is already leaving. A copy left that fails
# the run makes an exit of 0 an exit of 1; any other status stands.
drop_on_exit() {
  local rc=$? check_urc=0 check_said="" check_lines="" proof_urc=0 proof_said="" proof_lines="" dist_urc=0 dist_said=""
  trap '' INT TERM HUP
  if [ -n "$_CHECK_DIR" ]; then
    LS_LINES=""
    ls_drop "$_CHECK_DIR/$APP_NAME" "$_CHECK_DIR" yes || true
    check_urc="$LS_URC" check_said="$LS_ANSWER" check_lines="$LS_LINES"
  fi
  if [ -n "$_PUBLISH_STAGING" ]; then
    LS_LINES=""
    ls_drop "$_PUBLISH_STAGING/unpacked/$APP_NAME" "$_PUBLISH_STAGING" yes || true
    proof_urc="$LS_URC" proof_said="$LS_ANSWER" proof_lines="$LS_LINES"
  fi
  if [ -n "$_DIST_TO_DROP" ]; then
    ls_unregister "$_DIST_TO_DROP"
    dist_urc="$LS_URC" dist_said="$LS_ANSWER"
  fi
  trap - INT TERM HUP
  if [ -n "$_PUBLISH_STAGING" ]; then
    LS_LINES="$proof_lines"
    ls_check "$_PUBLISH_STAGING/unpacked/$APP_NAME" "$_PUBLISH_STAGING" "$proof_urc" "$proof_said" || true
    if [ -n "$LS_LINES" ]; then
      [ "$_PUBLISHED" != yes ] ||
        warn "macos: published $APP_ASSET on release $APP_TAG; could not drop its proof copy's Launch Services record or remove the dir it was proven in:"
      ls_say
      [ "$rc" -ne 0 ] || rc=1
    fi
  fi
  if [ -n "$_CHECK_DIR" ]; then
    LS_LINES="$check_lines"
    ls_check "$_CHECK_DIR/$APP_NAME" "$_CHECK_DIR" "$check_urc" "$check_said" || true
    if [ -n "$LS_LINES" ]; then
      warn "macos: the Gatekeeper check's copy of $APP_NAME was not dropped from Launch Services and removed:"
      ls_say
      [ "$rc" -ne 0 ] || rc=1
    fi
  fi
  if [ -n "$_DIST_TO_DROP" ]; then
    LS_LINES=""
    ls_check "$_DIST_TO_DROP" "$_DIST_TO_DROP" "$dist_urc" "$dist_said" || ls_say
  fi
  exit "$rc"
}

# arm_drops <left> -- drop_on_exit on EXIT, and an interrupt made the command's
# own failure, exit 1, so the drops run on every path out. The staged copy is
# placed as Launch Services lists it now (cargo_place), so the trap has nothing
# to resolve before it holds the signals; when it cannot be, the command stops,
# saying <left>. Armed before any copy is made. drop_on_exit runs with
# _DROPPING set for its call, and the interrupt handler does nothing while it
# is set, so a signal already pending as the trap starts cannot end the shell
# before its first line holds the signals, with no copy dropped.
arm_drops() {
  cargo_place "$(app_dist)" _DIST_TO_DROP getcwd ||
    die "macos: the staged copy's path $(app_dist) cannot be resolved as Launch Services lists it, so its record could not be checked$1"
  trap '_DROPPING=yes drop_on_exit' EXIT
  trap '[ "${_DROPPING:-}" = yes ] || exit 1' INT TERM HUP
}

# app_sign_nested <bundle> -- every Mach-O inside the bundle except its main
# executable, deepest path first, so a container is signed after what it
# holds; the main executable is sealed by the bundle signature, last. An app
# with no nested code signs nothing and says so; the first framework or helper
# added is then signed on the way through, rather than found by notarisation
# refusing the bundle.
app_sign_nested() {
  local bundle="$1" main f ftype signed=0
  local -a found=() files=() ent=()
  [ -z "$APP_ENTITLEMENTS" ] || ent=(--entitlements "$APP_ENTITLEMENTS")
  main="$(app_executable "$bundle")"
  # Read whole, so a walk that could not read everything is never a short list
  # signed as if it were all.
  find_list found "$bundle" -type f -print0 || die "macos: the files under $bundle could not be listed (above) -- nothing more signed"
  while IFS= read -r f; do files+=("$f"); done < <(printf '%s\n' ${found[@]+"${found[@]}"} | awk -F/ '{ print NF "\t" $0 }' | sort -t "$(printf '\t')" -k1,1nr | cut -f2-)
  [ "${#files[@]}" -gt 0 ] || die "macos: no files under $bundle -- refusing to sign an empty bundle"
  for f in "${files[@]}"; do
    [ "$f" != "$main" ] || continue
    # A classification error fails; it is never read as "not Mach-O" and
    # skipped, which would let unsigned code into a notarised bundle.
    ftype="$(file -b "$f")" || die "macos: file(1) could not classify $f"
    case "$ftype" in
      *Mach-O*executable*)
        # An entry point: entitlements are not inherited across exec().
        codesign --force --options runtime --timestamp ${ent[@]+"${ent[@]}"} --sign "$IDENTITY" "$f"
        signed=$((signed + 1))
        ;;
      *Mach-O*)
        codesign --force --options runtime --timestamp --sign "$IDENTITY" "$f"
        signed=$((signed + 1))
        ;;
      *)
        # An executable helper directly in Contents/MacOS is signed for the
        # seal; resources are sealed, not signed.
        if [ "$(dirname "$f")" = "$bundle/Contents/MacOS" ] && [ -x "$f" ]; then
          codesign --force --timestamp --sign "$IDENTITY" "$f"
          signed=$((signed + 1))
        fi
        ;;
    esac
  done
  printf '  %-21s %s\n' "nested code signed" "$signed"
}

# app_signature_readback <bundle> -- what the bytes say, not what was asked for:
# the identifier, the team and the hardened runtime read off the signature. A
# bundle still carrying the build's signature names itself otherwise, and is
# refused here.
app_signature_readback() {
  local bundle="$1" desc flags team ident want_team
  codesign --verify --strict --deep "$bundle" >/dev/null 2>&1 ||
    die "macos: $bundle does not verify -- its signature is broken or incomplete"
  desc="$(codesign -d --verbose=2 "$bundle" 2>&1)" || true
  flags="$(sed -n 's/.*flags=\([^ ]*\).*/\1/p' <<<"$desc" | sed -n 1p)"
  team="$(sed -n 's/^TeamIdentifier=//p' <<<"$desc")"
  ident="$(sed -n 's/^Identifier=//p' <<<"$desc")"
  want_team="$(identity_team)"
  printf '  %-21s %s\n' "identifier" "${ident:-<unreadable>}"
  printf '  %-21s %s\n' "team" "${team:-<none>}"
  printf '  %-21s %s\n' "flags" "${flags:-<unreadable>}"
  [ "$ident" = "$APP_BUNDLE_ID" ] ||
    die "macos: the bundle is signed as '${ident:-<none>}', not $APP_BUNDLE_ID -- it still carries the build's signature, not a Developer ID one"
  [ "$team" = "$want_team" ] ||
    die "macos: the bundle's team is '${team:-<none>}', not $want_team -- it is not signed with the Developer ID identity"
  case "$flags" in
    *runtime*) ;;
    *) die "macos: the hardened runtime is not set on the bundle (flags=${flags:-<unreadable>}) -- notarisation would refuse it" ;;
  esac
}

# app_verify_notarised <bundle> <left> -- the ticket, checked the way a download
# meets it: a quarantined copy in a dir of its own, the quarantine asserted
# before any verdict is read, and spctl's source. The app is not launched. 0
# when it passes. The copy's record is dropped and its dir removed before this
# returns (drop_check_copy), and on any other path out by the EXIT trap, which
# arm_drops has set; a record or the dir left stops the command, saying <left>
# after the reason, since nothing is left to drop it later.
app_verify_notarised() {
  local bundle="$1" t verdict rc=0
  if xcrun stapler validate "$bundle" >/dev/null 2>&1; then
    printf '  %-21s %s\n' "stapled ticket" "present, validates"
  else
    printf '  %-21s %s\n' "stapled ticket" "NONE (run: $ME app-notarize)"
    rc=1
  fi
  if ! t="$(mktemp -d "${TMPDIR:-/tmp}/devbin-macos-check.XXXXXX")" || ! cargo_place "$t" t getcwd; then
    die "macos: could not make a dir to check $bundle in$2"
  fi
  _CHECK_DIR="$t"
  ditto "$bundle" "$t/$APP_NAME" || die "macos: could not copy $bundle to check it$2"
  xattr -w com.apple.quarantine "0083;0;devbin-verify;" "$t/$APP_NAME" || true
  if ! xattr -p com.apple.quarantine "$t/$APP_NAME" >/dev/null 2>&1; then
    printf '  %-21s SKIPPED (could not set the quarantine attribute; no verdict)\n' "Gatekeeper"
    drop_check_copy "$2"
    return 1
  fi
  # spctl exits non-zero on a rejection, which is the verdict being read.
  verdict="$(spctl -a -t exec -vv "$t/$APP_NAME" 2>&1 | sed -n 's/^source=//p')" || true
  if [ "$verdict" = "Notarized Developer ID" ]; then
    printf '  %-21s quarantined copy accepted, source=%s\n' "Gatekeeper" "$verdict"
  else
    printf '  %-21s FAILED, source=%s (expected: Notarized Developer ID)\n' "Gatekeeper" "${verdict:-<none>}"
    rc=1
  fi
  drop_check_copy "$2"
  return $rc
}

# drop_check_copy <left> -- the Gatekeeper check's copy dropped from Launch
# Services and its dir (_CHECK_DIR) removed, mid-command: the caller's handlers
# saved, INT, TERM and HUP ignored through the drop and the removal, the
# handlers put back as they were saved, with no default between, then the
# record list read back. _CHECK_DIR is cleared only after the read-back: until
# then a signal exits through the EXIT trap, which drops the copy again and
# reads the list itself. A record or the dir left stops the command, naming
# each, then saying <left>.
drop_check_copy() {
  local t="$_CHECK_DIR" prev urc said rc=0
  prev="$(trap -p INT TERM HUP)"
  trap '' INT TERM HUP
  LS_LINES=""
  ls_drop "$t/$APP_NAME" "$t" yes || rc=1
  urc="$LS_URC" said="$LS_ANSWER"
  traps_restore "$prev" INT TERM HUP
  ls_check "$t/$APP_NAME" "$t" "$urc" "$said" || rc=1
  _CHECK_DIR=""
  [ "$rc" -ne 0 ] || return 0
  ls_say
  die "macos: the Gatekeeper check's copy of $APP_NAME was not dropped from Launch Services and removed (above)$1"
}

# --- the release --------------------------------------------------------------

# The project's version and the tag the release core cuts it under, and the
# app's version: the project's, unless macos.version_from names another file
# than project.version_from (issue 0243), which makes the app one that
# versions apart (APP_APART). The tag, the release and its attach stay the
# project's. APP_RELEASE_COMMIT and APP_RELEASE_STATE are the release's commit
# and whether it is the tag's (read_release_commit); empty until read, so a
# $(...) that expands them early under set -u still reaches app_ship_blockers,
# which refuses a state it does not know, rather than ending empty and passing.
REL_VERSION=""
APP_VERSION=""
APP_TAG=""
APP_VERSION_FILE=""
APP_APART=no
APP_RELEASE_COMMIT=""
APP_RELEASE_STATE=""
# HEAD as read_head_state last read it: its line, its commit and its state.
HEAD_LINE=""
HEAD_SHA=""
HEAD_STATE=""
release_names() {
  REL_VERSION="$(read_version)"
  [ "$REL_VERSION" != unknown ] || die "macos: the project's version cannot be read (project.version_from), so there is no release to sign for"
  APP_TAG="$(release_tag_name "$(cfg_release_get tag)" "$REL_VERSION")"
  APP_VERSION="$REL_VERSION"
  APP_VERSION_FILE="$(macos_path version_from)"
  [ -n "$APP_VERSION_FILE" ] || return 0
  ! [ "$APP_VERSION_FILE" -ef "$(version_path "${DEVBIN_VERSION_FILE:-VERSION}")" ] || return 0
  APP_APART=yes
  APP_VERSION="$(read_version "$APP_VERSION_FILE" version-file)"
  [ -n "$APP_VERSION" ] && [ "$APP_VERSION" != unknown ] ||
    die "macos: the app's version cannot be read from macos.version_from ($APP_VERSION_FILE)"
}

# require_freshness <what was not done> -- an app that versions apart has no
# version that shows a copy is the release's build, so its commit stamp, the one
# proof left, must be declared: refused, before anything is built or uploaded,
# naming the key.
require_freshness() {
  [ "$APP_APART" = yes ] && [ -z "$APP_COMMIT_STAMP" ] || return 0
  die "macos: macos.version_from ($APP_VERSION_FILE) is not the project's version file, so the app's version cannot show a copy is release $APP_TAG's build -- declare macos.commit_stamp, the Info.plist key the build writes its commit into; $1"
}

# require_build_root <what was not done> -- the root of publish's last drop,
# macos.build_root or the directory holding macos.app, refused before anything
# is done when it cannot be resolved or would reach past the build's products
# (build_root_why), since the drop unregisters every record under it.
require_build_root() {
  local dir why
  if [ -z "$APP_BUILD_ROOT" ] || ! cargo_place "$APP_BUILD_ROOT" dir getcwd; then
    die "macos: publish's last Launch Services drop has no root it can resolve (${APP_BUILD_ROOT:-empty}, from macos.build_root, else the directory holding macos.app) -- declare macos.build_root as the directory the build writes its products under; $1"
  fi
  why="$(build_root_why "$dir")" || return 0
  die "macos: publish's last Launch Services drop would sweep $dir (macos.build_root, else the directory holding macos.app), which $why -- declare macos.build_root as the directory the build writes its products under; $1"
}

# read_release_commit <suffix> -- APP_RELEASE_COMMIT and APP_RELEASE_STATE set
# from release_commit (lib/release.steps), the one reader of the release's
# commit, which the cut and release status ask too: tagged with the tag's
# commit once $APP_TAG is cut, untagged with HEAD before it. A git that cannot
# answer stops there with git's own words, and here with <suffix> saying what
# was not done, never read as a tag not cut yet.
#
# git's local variables are cleared from THIS shell first, so every git read
# after it asks the one repository at $ROOT: release_commit's, which honours
# them as the release core's writes do, git_head_identity's, which clears them
# for itself, and the release attach publish runs (ST0011 WP-06). An inherited
# GIT_DIR would otherwise answer the tag from one repository and HEAD from
# another. Cleared through require_git_local_env_cleared, as the cut, release
# status and release gates clear them, so one that was set is named, with
# $ROOT, and never dropped in silence; a clear whose naming line could not be
# written stops here too. Here, the first git read of app-sign and of publish,
# and not at file scope, so doctor and the subcommands that read no git need
# no git to run.
read_release_commit() {
  local line
  require_git_local_env_cleared macos "$ROOT" "$1"
  line="$(release_commit "$APP_TAG")" ||
    die "macos: the release commit of $APP_TAG could not be read (above)$1"
  APP_RELEASE_COMMIT="${line%%$'\t'*}"
  case "${line#*$'\t'}" in
    tag) APP_RELEASE_STATE=tagged ;;
    HEAD) APP_RELEASE_STATE=untagged ;;
    *) die "macos: release_commit answered '$line', neither tag nor HEAD$1" ;;
  esac
}

# read_head_state -- HEAD_SHA and HEAD_STATE from git_head_identity's one line,
# the one parse of it here: clean as git_identity_clean reads it, the reading
# the release verbs ask too, dirty for `<sha> +dirty`, unreadable for `<sha>
# +unreadable`, and unknown for anything else, `unknown` itself or a form this
# does not know, so a form added to git_head_identity is refused here rather
# than read as a clean tree. HEAD_LINE keeps the line as git_head_identity gave
# it, for a refusal to name.
read_head_state() {
  HEAD_LINE="$(git_head_identity "$ROOT")"
  HEAD_SHA="${HEAD_LINE%% *}"
  if git_identity_clean "$HEAD_LINE"; then
    HEAD_STATE=clean
  elif is_commit_sha "$HEAD_SHA" full && [ "$HEAD_LINE" = "$HEAD_SHA +dirty" ]; then
    HEAD_STATE=dirty
  elif is_commit_sha "$HEAD_SHA" full && [ "$HEAD_LINE" = "$HEAD_SHA +unreadable" ]; then
    HEAD_STATE=unreadable
  else
    HEAD_STATE=unknown
  fi
}

# app_ship_blockers <bundle> <commit> <tagged|untagged> -- why <bundle> cannot
# ship with the release, one reason a line; empty means it may. Its bundle id;
# its version against the app's, the project's unless macos.version_from names
# another file; and the stamps declared: the kind against macos.kind_value, and
# the commit, which must be a stamp is_commit_sha's stamp form takes and a
# prefix of <commit>, the release's commit. The caller decides which commit that is and
# says how it stands: tagged, the tag's, or untagged, the release commit before
# its tag is cut (require_release_head; publish passes the tag's alone), so
# no stamp is ever read against whatever HEAD happens to be. A bundle built
# before the version moved, or off the release's commit, passes every Apple
# check and would ship another build inside this release. A malformed commit
# is refused before any comparison, so a missing or garbled one never matches
# by prefix.
app_ship_blockers() {
  local id version kind commit release
  # Read in $(...) by refuse_blockers, where a die would end only the subshell
  # and leave no blocker: a state it does not know is a blocker line, so the
  # copy is refused rather than passed.
  case "$3" in
    tagged) release="the tag $APP_TAG's commit" ;;
    untagged) release="the release commit, HEAD until the tag $APP_TAG is cut," ;;
    *)
      printf 'app_ship_blockers was given no state it knows (%s, not tagged or untagged), so its commit cannot be checked\n' "${3:-none}"
      return 0
      ;;
  esac
  id="$(plist_get "$1" CFBundleIdentifier)"
  version="$(plist_get "$1" CFBundleShortVersionString)"
  [ "$id" = "$APP_BUNDLE_ID" ] ||
    printf 'its bundle id is %s, and macos.bundle_id is %s\n' "${id:-<unreadable>}" "$APP_BUNDLE_ID"
  if [ "$APP_APART" = yes ]; then
    [ "$version" = "$APP_VERSION" ] ||
      printf 'its version is %s, and macos.version_from (%s) says %s -- it was built from another tree\n' "${version:-<unreadable>}" "$APP_VERSION_FILE" "$APP_VERSION"
  else
    [ "$version" = "$APP_VERSION" ] ||
      printf 'its version is %s, and the project is at %s -- it was built from another tree\n' "${version:-<unreadable>}" "$APP_VERSION"
  fi
  if [ -n "$APP_KIND_STAMP" ]; then
    kind="$(plist_get "$1" "$APP_KIND_STAMP")"
    [ "$kind" = "$APP_KIND_VALUE" ] ||
      printf 'its %s is %s, not %s -- it was built off %s or from a dirty tree\n' "$APP_KIND_STAMP" "${kind:-<unreadable>}" "$APP_KIND_VALUE" "$release"
  fi
  if [ -n "$APP_COMMIT_STAMP" ]; then
    commit="$(plist_get "$1" "$APP_COMMIT_STAMP")"
    if ! is_commit_sha "$commit" stamp; then
      printf "its %s is %s, not a commit of eight or more lowercase hex characters, up to a whole name, so it cannot be checked against the release's commit %s\n" "$APP_COMMIT_STAMP" "${commit:-<unreadable>}" "${2:0:12}"
    elif [[ "$2" != "$commit"* ]]; then
      printf 'its %s is %s, and %s is %s -- it was built off another commit\n' "$APP_COMMIT_STAMP" "$commit" "$release" "${2:0:12}"
    fi
  fi
  return 0
}

# record_signed_at <bundle> -- APP_STAGE_RECORD written with the commit
# require_release_head checked as the release's (APP_RELEASE_COMMIT), which is
# what <bundle> was built and signed at, for publish to read back
# (require_stage_signed_at_tag). HEAD and the tree are read again first, as
# require_release_head read them: a HEAD that moved, or a tree the build left
# with changes, means the copy is not the build of the commit that was checked,
# and a git that cannot answer cannot show that it is; either way the stage is
# removed and nothing is recorded. The binaries' stage (issue 0323) passes its
# own stage, record and publishing subcommand; the app's are the defaults.
record_signed_at() {
  local why="" stage="${2:-$APP_STAGE_DIR}" record="${3:-$APP_STAGE_RECORD}" publisher="${4:-publish}"
  read_head_state
  case "$HEAD_STATE" in
    unknown) why="HEAD could not be read in $ROOT after $1 was built and signed (git_head_identity said: $HEAD_LINE)" ;;
    unreadable) why="git status could not be read in $ROOT after $1 was built and signed, so the tree cannot be shown clean" ;;
    dirty) why="the build left $ROOT with changes, so $1 is not ${APP_RELEASE_COMMIT:0:12}'s build" ;;
    clean)
      if [ "$HEAD_SHA" != "$APP_RELEASE_COMMIT" ]; then
        why="HEAD moved while $1 was built and signed, from ${APP_RELEASE_COMMIT:0:12} to ${HEAD_SHA:0:12}, so the copy is no checked commit's build"
      fi
      ;;
  esac
  if [ -n "$why" ]; then
    rm -rf "$stage"
    die "macos: $why -- the stage is removed and nothing recorded"
  fi
  printf '%s\n' "$APP_RELEASE_COMMIT" >"$record" ||
    die "macos: could not record the commit $1 was signed at in $record, and $publisher ships no copy without one"
}

# require_stage_signed_at_tag <tag's commit> -- the staged copy was signed at
# the tag's commit, by APP_STAGE_RECORD (record_signed_at): a copy signed at
# any other commit is another commit's build, and a stage with no record, or
# one that is not a whole commit name, is a build nobody can name, refused as
# such rather than read as fine. The binaries (issue 0323) pass their record,
# what is staged and the steps that sign it again; the app's are the defaults.
require_stage_signed_at_tag() {
  local signed="" record="${2:-$APP_STAGE_RECORD}" what="${3:-$APP_NAME}" redo="${4:-$ME app-sign, then $ME app-notarize}"
  [ ! -f "$record" ] || signed="$(<"$record")"
  is_commit_sha "$signed" full ||
    die "macos: the staged $what carries no record of the commit it was signed at ($record), so whose build it is cannot be told -- nothing uploaded; sign it again at the tag: in a tree at $APP_TAG, $redo"
  [ "$signed" = "$1" ] ||
    die "macos: the staged $what was signed at ${signed:0:12}, and $APP_TAG names ${1:0:12}: another commit's build -- nothing uploaded; sign it again at the tag: in a tree at $APP_TAG, $redo"
}

# refuse_blockers <headline> <blockers> [<path>] -- refuse with the blockers
# under the headline, removing <path> first; return when there are none.
refuse_blockers() {
  [ -n "$2" ] || return 0
  [ -z "${3:-}" ] || rm -rf "$3"
  die "$1:
       ${2//$'\n'/$'\n       '}"
}

# require_release_head -- HEAD is the release's commit, in a clean tree: the
# tag's once the tag is cut, and before then the release commit, the one whose
# version is the one being released ($REL_VERSION, read from this tree) and
# whose tag $APP_TAG does not exist yet, where a cut's macos leg signs (ST0011
# WP-06). What app-sign builds and signs must be the release's own build, and
# publish ships it only when the commit it was signed at is the tag's
# (APP_STAGE_RECORD), so a copy signed off the release commit never ships. A
# HEAD past the tag is refused, naming the route, a worktree at the tag.
#
# The release's commit comes from release_commit, the one reader the cut and
# release status ask too (read_release_commit), so the leg's R and the cut's R
# are one answer. What is macos's own is the two checks on it: HEAD is that
# commit, and the tree is clean. HEAD and the tree's state are read once,
# through read_head_state's one parse of git_head_identity (issue 0094:
# through git_readonly, so the clean-tree check takes no index lock).
# APP_RELEASE_COMMIT and APP_RELEASE_STATE then carry what was checked, for
# the stamp check and the record to use rather than read HEAD again. The
# binaries (issue 0323) name their own signer, steps and publisher; the app's
# are the defaults.
require_release_head() {
  local head dirty=no signer="${1:-app-sign}" steps="${2:-app-sign, app-notarize and publish}" publisher="${3:-publish}"
  read_release_commit " -- nothing built or signed"
  read_head_state
  head="$HEAD_SHA"
  case "$HEAD_STATE" in
    unknown) die "macos: HEAD could not be read in $ROOT (git_head_identity said: $HEAD_LINE), so it is no commit of release $APP_TAG -- nothing built or signed" ;;
    unreadable) die "macos: git status could not be read in $ROOT, so the tree cannot be shown clean -- nothing built or signed" ;;
    dirty) dirty=yes ;;
  esac
  if [ "$APP_RELEASE_STATE" = untagged ]; then
    [ "$head" = "$APP_RELEASE_COMMIT" ] ||
      die "macos: HEAD moved while $signer read it, from ${APP_RELEASE_COMMIT:0:12} to ${head:0:12} -- nothing built or signed"
    [ "$dirty" = no ] ||
      die "macos: $signer signs only the release's build, in a clean tree: HEAD ${head:0:12}, the release commit of $APP_TAG until it is cut, has changes -- nothing built or signed"
    printf '  no tag %s here: HEAD %s is taken as the release commit, and %s ships its build only under a tag cut there\n' "$APP_TAG" "${head:0:12}" "$publisher"
  elif [ "$head" != "$APP_RELEASE_COMMIT" ] || [ "$dirty" = yes ]; then
    die "macos: $signer signs only the release's build: HEAD at $APP_TAG (${APP_RELEASE_COMMIT:0:12}), in a clean tree, and HEAD is ${head:0:12}$([ "$dirty" = no ] || printf ', with changes') -- nothing built or signed. Run the steps in a worktree at the tag:
       git worktree add --detach <dir> $APP_TAG
       cd <dir>, then $ME $steps
       git worktree remove <dir>, once $publisher has run"
  fi
}

# require_stage_outside -- the stage at or under neither the project root nor
# the product's directory: a copy in the build tree is what the stage exists
# not to be. Asked before the stage is made, so a refusal writes nothing.
#
# PLACED BY cargo_place, THE ONE STATEMENT OF WHERE A TREE DEVBIN DID NOT MAKE
# LANDS (issue 0267). A copy of its walk here, `resolved`, appended the part
# that does not exist yet as written, `.` and `..` included, so a stage spelled
# <state>/nope/../<root> passed as outside and was made inside the project. So
# the stage is refused for what cargo_place refuses, and the root and the
# products are asked of physical_dir, where each was a `cd && pwd -P` of its
# own. All three are spelled as the filesystem spells them (getcwd), as
# macos's other placings are: on a volume that folds case, a stage typed
# <state>/PROJ/... was compared as text against <root>/proj, passed as
# outside, and was made inside the project. The binaries (issue 0323) pass
# their stage and macos.bin_dir; the app's stage and directory are the defaults.
require_stage_outside() {
  local want="${1:-$APP_STAGE_DIR}" products="${2:-${APP_SRC%/*}}" stage root product shown rc=0
  case "$want" in
    /*) ;;
    *) die "macos: the stage $want is not an absolute path -- XDG_STATE_HOME must be one" ;;
  esac
  cargo_place "$want" stage getcwd || rc=$?
  case "$rc" in
    0) ;;
    2) die "macos: the stage $want names . or .. beneath a directory that does not exist yet, so where it lands, in the build tree or outside it, cannot be known -- point XDG_STATE_HOME elsewhere" ;;
    1)
      printf -v shown '%q' "$stage"
      die "macos: the stage $want cannot be placed: $shown cannot be entered, so where it lands cannot be known -- point XDG_STATE_HOME elsewhere"
      ;;
    *) die "macos: the stage $want cannot be placed: cargo_place answered $rc, a status this does not read" ;;
  esac
  physical_dir "$ROOT" root getcwd || die "macos: the project root $ROOT cannot be entered"
  physical_dir "$products" product getcwd || product="$products"
  case "$stage/" in
    "$root"/* | "$product"/*)
      die "macos: the stage $stage is inside $([ "${stage#"$root"/}" != "$stage" ] && printf 'the project root %s' "$root" || printf 'the build products %s' "$product"), and the subject of signing is a copy outside the build tree -- point XDG_STATE_HOME elsewhere"
      ;;
  esac
}

# --- the binaries (issue 0323) ----------------------------------------------
#
# A project's command-line binaries, and a .app shipped beside them, released
# as two of the maintainer's projects released theirs with scripts of their
# own: each declared under macos.binaries and read from macos.bin_dir; staged
# under XDG state beside the app's stage; signed with the Developer ID, the
# hardened runtime and a secure timestamp; read back against its designated
# requirement; notarised in one submission and assessed by Gatekeeper; then
# packed as <project>-<version>-<host triple>.tar.gz, a .app at the archive's
# root and every other binary under bin/, with macos.pack.files at the root,
# and attached through release attach --from. Nothing is stapled: a bare
# binary cannot carry a ticket, and Gatekeeper asks Apple for its verdict.

# bin_labels -- the declared binaries' labels, one a line, in document order.
bin_labels() { cfg_macos_binaries; }

# bin_field <label> <field> -- one field of a binary, or the command stops.
bin_field() { cfg_macos_binary "$1" "$2" || die "macos: cannot read macos.binaries.$1.$2"; }

# bin_source <label> -- where the build left it: macos.bin_dir/<path>. Each
# read here is an assignment that returns its failure, since bash turns
# errexit off inside the command substitutions that call these.
bin_source() {
  local p
  p="$(bin_field "$1" path)" || return 1
  printf '%s/%s' "$BIN_DIR" "$p"
}

# bin_staged <label> -- its staged copy.
bin_staged() {
  local p
  p="$(bin_field "$1" path)" || return 1
  printf '%s/%s' "$BIN_STAGE_DIR" "$p"
}

# bin_entitlements <label> -- its entitlements file as a path, read from the
# project root as every macos path is, or empty when it declares none.
bin_entitlements() {
  local v
  v="$(bin_field "$1" entitlements)" || return 1
  [ -n "$v" ] || return 0
  macos_path_value "macos.binaries.$1.entitlements" "$v"
}

# bin_requirement <label> -- its designated requirement: its own when it
# declares one, else the Developer ID form filled from its identifier and the
# identity's team, which every requirement the projects declared by hand was.
bin_requirement() {
  local req id
  req="$(bin_field "$1" requirement)" || return 1
  if [ -n "$req" ]; then
    printf '%s' "$req"
    return 0
  fi
  id="$(bin_field "$1" identifier)" || return 1
  printf 'identifier "%s" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] and certificate leaf[field.1.2.840.113635.100.6.1.13] and certificate leaf[subject.OU] = "%s"' \
    "$id" "$(identity_team)"
}

# require_binaries -- at least one binary declared, each with a path that is a
# name under macos.bin_dir and an identifier, and each entitlements file it
# names present. Every problem is named, all at once.
require_binaries() {
  local label path ent n=0 missing="" wrong=""
  while IFS= read -r label; do
    [ -n "$label" ] || continue
    n=$((n + 1))
    path="$(bin_field "$label" path)"
    [ -n "$path" ] || missing+=", macos.binaries.$label.path"
    [ -n "$(bin_field "$label" identifier)" ] || missing+=", macos.binaries.$label.identifier"
    case "$path" in
      */* | . | ..) wrong+=$'\n'"  macos.binaries.$label.path is $path, and it must be a name in macos.bin_dir" ;;
    esac
    ent="$(bin_entitlements "$label")"
    [ -z "$ent" ] || [ -f "$ent" ] || wrong+=$'\n'"  macos.binaries.$label.entitlements is $ent, and there is no such file"
  done <<<"$(bin_labels)"
  [ "$n" -gt 0 ] || die "macos: $DEVBIN_DIR/config.yaml declares no macos.binaries -- see ${DEVBIN_INVOKE:-bin/devbin} help macos"
  [ -z "$missing" ] || die "macos: $DEVBIN_DIR/config.yaml declares no ${missing#, } -- see ${DEVBIN_INVOKE:-bin/devbin} help macos"
  [ -z "$wrong" ] || die "macos: the binaries cannot be released:$wrong"
}

# bin_check <label> <yes|no> -- its staged copy read back: it meets its
# designated requirement, carries the hardened runtime and every entitlement
# its declared file names, and, with yes, Gatekeeper accepts it. The first that
# fails stops the command; a pass prints one line of what was read.
bin_check() {
  local label="$1" f name req flags ent keys key sig
  f="$(bin_staged "$label")"
  name="$(bin_field "$label" path)"
  req="$(bin_requirement "$label")"
  # A requirement argument that opens with = is the requirement's text, not a
  # file holding it.
  codesign --verify --strict -R "=$req" "$f" >/dev/null 2>&1 ||
    die "macos: $name does not meet its designated requirement: $req"
  flags="$({ codesign -d --verbose=2 "$f" 2>&1 || true; } | sed -n 's/.*flags=\([^ ]*\).*/\1/p' | sed -n 1p)"
  case "$flags" in
    *runtime*) ;;
    *) die "macos: $name carries no hardened runtime (flags=${flags:-<unreadable>}) -- notarisation would refuse it" ;;
  esac
  ent="$(bin_entitlements "$label")"
  if [ -n "$ent" ]; then
    keys="$(sed -n 's:.*<key>\(.*\)</key>.*:\1:p' "$ent")" || die "macos: could not read $ent"
    [ -n "$keys" ] || die "macos: $ent names no entitlement, so there is nothing to sign $name with"
    sig="$(codesign -d --entitlements - --xml "$f" 2>/dev/null)" || sig=""
    while IFS= read -r key; do
      [[ "$sig" == *"<key>$key</key>"* ]] ||
        die "macos: $name is signed without $key, which $ent declares -- the hardened runtime would deny it"
    done <<<"$keys"
  fi
  if [ "$2" = yes ]; then
    spctl -a -t open --context context:primary-signature "$f" >/dev/null 2>&1 ||
      die "macos: Gatekeeper refuses $name -- has it been notarised? run: $ME bin-notarize"
  fi
  printf '  %-21s requirement, hardened runtime%s%s\n' "$name" "${ent:+, entitlements}" "$([ "$2" = no ] || printf ', Gatekeeper')"
}

# bin_require_staged -- every declared binary is staged, or the command stops.
bin_require_staged() {
  local label f
  while IFS= read -r label; do
    f="$(bin_staged "$label")"
    [ -e "$f" ] || die "macos: $(bin_field "$label" path) is not staged at $f -- run: $ME bin-sign"
  done <<<"$(bin_labels)"
}

# --- the subcommands --------------------------------------------------------

# doctor: what the release needs, each PRESENT or MISSING. Exit 1 when the
# declaration, a tool, the identity or a credential is missing, or the
# identity cannot sign.
cmd_doctor() {
  local ok=1 t bins
  bins="$(bin_labels)"
  printf 'platform: %s\n' "$platform"
  printf '\ndeclaration (macos: in %s):\n' "$DEVBIN_DIR/config.yaml"
  if [ -n "$APP_SRC" ]; then
    printf '  %-21s %s (%s)\n' "app" "$APP_SRC" "$([ -d "$APP_SRC" ] && printf present || printf 'not built yet')"
  elif [ -n "$bins" ]; then
    printf '  %-21s none: binaries alone\n' "app"
  else
    printf '  %-21s MISSING (declare macos.app, or macos.binaries)\n' "app"
    ok=0
  fi
  printf '  %-21s %s\n' "build" "${APP_BUILD:-none: the app is built already}"
  if [ -n "$APP_BUNDLE_ID" ]; then
    printf '  %-21s %s\n' "bundle id" "$APP_BUNDLE_ID"
  elif [ -z "$APP_SRC" ] && [ -n "$bins" ]; then
    printf '  %-21s none: no app\n' "bundle id"
  else
    printf '  %-21s MISSING (declare macos.bundle_id)\n' "bundle id"
    ok=0
  fi
  if [ -z "$APP_ENTITLEMENTS" ]; then
    printf '  %-21s none: signed without\n' "entitlements"
  elif [ -f "$APP_ENTITLEMENTS" ]; then
    printf '  %-21s %s\n' "entitlements" "$APP_ENTITLEMENTS"
  else
    printf '  %-21s MISSING (%s)\n' "entitlements" "$APP_ENTITLEMENTS"
    ok=0
  fi
  printf '  %-21s %s\n' "team" "${MACOS_TEAM:-none: needed when the keychain holds more than one Developer ID identity}"
  printf '  %-21s %s\n' "notary profile" "$NOTARY_PROFILE"
  printf '  %-21s %s\n' "asset" "${APP_ASSET:-<none until macos.app is declared>}"
  printf '  %-21s %s\n' "stage" "$APP_STAGE_DIR"
  if [ -n "$bins" ]; then
    local label path id ent src
    printf '  %-21s %s\n' "bin dir" "$BIN_DIR"
    printf '  %-21s %s\n' "binaries' stage" "$BIN_STAGE_DIR"
    while IFS= read -r label; do
      path="$(bin_field "$label" path)"
      id="$(bin_field "$label" identifier)"
      ent="$(bin_entitlements "$label")"
      src="$BIN_DIR/$path"
      if [ -z "$path" ] || [ -z "$id" ]; then
        printf '  %-21s MISSING (declare macos.binaries.%s.path and .identifier)\n' "binary $label" "$label"
        ok=0
        continue
      fi
      printf '  %-21s %s as %s (%s)\n' "binary $label" "$path" "$id" "$([ -e "$src" ] && printf built || printf 'not built yet')"
      if [ -n "$ent" ] && [ ! -f "$ent" ]; then
        printf '  %-21s MISSING (%s)\n' "  entitlements" "$ent"
        ok=0
      fi
    done <<<"$bins"
  fi
  local root why
  if [ -z "$APP_BUILD_ROOT" ]; then
    printf '  %-21s %s\n' "build root" "<none until macos.app or macos.build_root is declared>"
  elif cargo_place "$APP_BUILD_ROOT" root getcwd; then
    if why="$(build_root_why "$root")"; then
      printf '  %-21s REFUSED (%s %s; declare macos.build_root)\n' "build root" "$root" "$why"
      ok=0
    else
      printf '  %-21s %s\n' "build root" "$root"
    fi
  else
    printf '  %-21s REFUSED (%s cannot be resolved; declare macos.build_root)\n' "build root" "$APP_BUILD_ROOT"
    ok=0
  fi
  printf '\ntools:\n'
  for t in codesign xcrun spctl ditto plutil xattr security gh; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '  %-21s %s\n' "$t" "$(command -v "$t")"
    else
      printf '  %-21s MISSING\n' "$t"
      ok=0
    fi
  done
  # Not on PATH on macOS: ls_cmd names the one every drop runs.
  if [ -x "$(ls_cmd)" ]; then
    printf '  %-21s %s\n' "lsregister" "$(ls_cmd)"
  else
    printf '  %-21s MISSING (%s)\n' "lsregister" "$(ls_cmd)"
    ok=0
  fi
  load_identity
  printf '\nsigning:\n'
  if [ -n "$IDENTITY" ]; then
    printf '  %-21s %s found, team %s\n' "Developer ID" "$IDENTITY_COUNT" "$(identity_team)"
    # A real test-sign: an identity can be listed and still not sign (expired,
    # revoked, its private key gone), and a release is too late to learn it.
    local tmp
    tmp="$(mktemp -d)"
    if cp /bin/echo "$tmp/probe" 2>/dev/null &&
      codesign --force --options runtime --timestamp --sign "$IDENTITY" "$tmp/probe" >/dev/null 2>&1 &&
      codesign --verify --strict "$tmp/probe" >/dev/null 2>&1; then
      printf '  %-21s signs and verifies\n' "test-sign"
    else
      printf '  %-21s FAILED (the identity is listed and cannot make a valid signature)\n' "test-sign"
      ok=0
    fi
    rm -rf "$tmp"
  elif identity_unpicked; then
    printf '  %-21s REFUSED (%s found, of the teams %s, and no macos.team picks one; declare macos.team)\n' "Developer ID" "$IDENTITY_COUNT" "$IDENTITY_TEAMS"
    ok=0
  else
    printf '  %-21s MISSING (no "Developer ID Application" identity in the login keychain)\n' "Developer ID"
    ok=0
  fi
  # The profile is read the one way notarytool offers, a history query under
  # it, which asks Apple, as the test-sign's timestamp above does; its output
  # is never printed, so no value can be.
  printf '\nnotary profile (its values are never printed):\n'
  if xcrun notarytool history --keychain-profile "$NOTARY_PROFILE" >/dev/null 2>&1; then
    printf '  %-21s PRESENT\n' "$NOTARY_PROFILE"
  else
    printf '  %-21s NOT USABLE (notarytool could not query Apple under it: store it with %s store-creds, or check the network)\n' "$NOTARY_PROFILE" "$ME"
    ok=0
  fi
  [ "$ok" = 1 ] || die "macos: incomplete -- see MISSING, NOT USABLE, FAILED and REFUSED above"
}

# store-creds: notarytool store-credentials itself prompts for each value and
# checks them with Apple before it saves the profile to the login keychain, so
# no value passes through this command, its arguments or its output.
cmd_store_creds() {
  [ -t 0 ] || die "macos: store-creds is interactive and reads the terminal; stdin is not one -- run it yourself in a terminal"
  printf 'Storing the notary profile "%s" in the login keychain, through notarytool.\n' "$NOTARY_PROFILE"
  printf 'It prompts for the Apple ID, the team id and an app-specific password (not the\n'
  printf 'account password), checks them with Apple, and saves them; nothing is written to\n'
  printf 'the tree.\n\n'
  xcrun notarytool store-credentials "$NOTARY_PROFILE" ||
    die "macos: notarytool could not store the notary profile $NOTARY_PROFILE"
  printf '\nStored. Check with: %s doctor\n' "$ME"
}

# app_build_cached -- macos.build, through the artefact cache where the app is
# one of the build: block's artefacts (cfg_macos_artefact; ST0011 WP-06, the
# core calling the cache where the handler is its own): the artefact pulled at
# the release commit when the cache holds it, and macos.build not run; else
# macos.build, then the app put under the commit's key. The cache's own lines
# say what it did, and a refusal costs the build alone: a get it refuses
# builds, and a put it refuses, or that fails, leaves the build standing. With
# no such artefact the app builds uncached, as it did before.
app_build_cached() {
  local -a words=()
  local art s=0 rc=0 launcher="$ROOT/bin/devbin"
  run_words words macos.build "$APP_BUILD" || die "macos: macos.build holds no command to run"
  art="$(cfg_macos_artefact)" || s=$?
  case "$s" in
    0)
      step "pulling $art from the artefact cache at ${APP_RELEASE_COMMIT:0:12}"
      "$launcher" cache get "$art" --commit "$APP_RELEASE_COMMIT" || rc=$?
      if [ "$rc" -eq 0 ]; then
        printf '  pulled, so macos.build is not run\n'
        return 0
      fi
      ;;
    1) ;;
    *) warn "macos: $art, so the app builds uncached" ;;
  esac
  step "building: $APP_BUILD"
  "${words[@]}" || die "macos: macos.build failed (exit $?) -- nothing signed"
  [ "$s" -eq 0 ] || return 0
  step "putting $art into the artefact cache at ${APP_RELEASE_COMMIT:0:12}"
  "$launcher" cache put "$art" || warn "macos: cache put $art did not record the app (above); the build stands"
}

# app-sign: refused unless HEAD is the release's commit in a clean tree, the
# tag's or before the tag is cut the release commit; then macos.build, through
# the artefact cache where the app is a build: artefact (app_build_cached), a
# copy staged outside the build tree and refused, with nothing signed, unless it
# is the release's; then signed inside-out, read back, and the commit recorded.
cmd_app_sign() {
  require_declared
  load_identity
  require_identity
  release_names
  require_freshness "nothing built or signed"
  require_build_root "nothing built or signed"
  step "checking HEAD is release $APP_TAG's commit, in a clean tree"
  require_release_head
  [ -z "$APP_BUILD" ] || app_build_cached
  [ -f "$APP_SRC/Contents/Info.plist" ] ||
    die "macos: there is no app at $APP_SRC (no Contents/Info.plist)${APP_BUILD:+ after macos.build ran} -- nothing signed"
  local dist
  dist="$(app_dist)"
  step "staging a copy outside the build tree"
  require_stage_outside
  arm_drops " -- nothing signed"
  rm -rf "$APP_STAGE_DIR"
  mkdir -p "$APP_STAGE_DIR"
  ditto "$APP_SRC" "$dist" || die "macos: could not stage $APP_SRC -> $dist"
  # codesign refuses "resource fork, Finder information, or similar detritus".
  xattr -cr "$dist" || true
  printf '  %s\n' "$dist"
  step "checking the staged copy is the release's, as publish will"
  refuse_blockers "macos: the staged $APP_NAME cannot ship with release $APP_TAG -- nothing signed" "$(app_ship_blockers "$dist" "$APP_RELEASE_COMMIT" "$APP_RELEASE_STATE")" "$APP_STAGE_DIR"
  step "signing $APP_NAME inside-out (nested code, then the bundle), team $(identity_team)"
  app_sign_nested "$dist"
  local -a ent=()
  [ -z "$APP_ENTITLEMENTS" ] || ent=(--entitlements "$APP_ENTITLEMENTS")
  codesign --force --options runtime --timestamp ${ent[@]+"${ent[@]}"} --sign "$IDENTITY" "$dist" ||
    die "macos: codesign could not sign $dist"
  step "reading the signature back off the bundle"
  app_signature_readback "$dist"
  record_signed_at "$dist"
  printf '\nsigned: %s, at %s\nnext: %s app-notarize\n' "$dist" "${APP_RELEASE_COMMIT:0:12}" "$ME"
}

# app-notarize: the signed copy submitted with notarytool --wait; anything but
# Accepted prints Apple's log and stops with nothing stapled; then the ticket
# stapled and the bundle checked as a download meets it.
cmd_app_notarize() {
  require_declared
  load_identity
  require_identity
  local dist staging zip rc=0
  dist="$(app_dist)"
  [ -d "$dist" ] || die "macos: no signed bundle at $dist -- run: $ME app-sign"
  arm_drops " -- nothing submitted"
  step "checking the bundle is the signed one"
  app_signature_readback "$dist"
  staging="$(mktemp -d)"
  zip="$staging/submission.zip"
  # ditto, never zip(1): it keeps the signature and the extended attributes
  # notarisation reads.
  ditto -c -k --keepParent --sequesterRsrc "$dist" "$zip" || {
    rm -rf "$staging"
    die "macos: could not build the submission archive"
  }
  step "submitting to Apple (notarytool waits; usually minutes)"
  notary_submit "$zip" || rc=$?
  rm -rf "$staging"
  [ "$rc" = 0 ] || notary_refused "$rc" "nothing stapled"
  step "stapling the ticket to the bundle"
  xcrun stapler staple "$dist" || die "macos: stapler could not staple the ticket to $dist"
  step "checking the stapled bundle as a download meets it"
  app_verify_notarised "$dist" " -- $APP_NAME is Accepted and its ticket stapled at $dist, so check it again with $ME app-verify, not app-notarize, which would submit it again" ||
    die "macos: the bundle was Accepted and stapled, and does not pass the check above"
  printf '\nnotarised and stapled: %s\nnext: %s publish\n' "$dist" "$ME"
}

# app-verify: the staged copy's signature and ticket. Changes no bundle.
cmd_app_verify() {
  require_declared
  load_identity
  require_identity
  local dist rc=0
  dist="$(app_dist)"
  [ -d "$dist" ] || die "macos: no signed bundle at $dist -- run: $ME app-sign"
  arm_drops " -- nothing checked"
  printf '  %-21s %s\n' "bundle" "$dist"
  app_signature_readback "$dist"
  app_verify_notarised "$dist" "" || rc=1
  [ "$rc" -eq 0 ] || die "macos: the signed bundle is not notarised and stapled"
}

# publish: the stapled copy zipped as macos.asset, proven by unpacking it as a
# user does and checking the bundle inside, then attached to the release at the
# tag by `release attach --from`, the core's own path: its checks, its upload
# that never replaces an asset, its SHA256SUMS over every asset and its
# readback. Refused, with nothing uploaded, when the copy is not the
# release's, when the tag is not here, or when the zip does not prove. The
# staged copy, the Gatekeeper check's copy and the proof copy are dropped on
# every path out (drop_on_exit).
cmd_publish() {
  require_declared
  release_names
  require_freshness "nothing uploaded"
  require_build_root "nothing uploaded"
  local dist staging launcher said
  dist="$(app_dist)"
  [ -d "$dist" ] || die "macos: no signed bundle at $dist -- run: $ME app-sign, then app-notarize"
  # An interrupt is the command's own failure, exit 1, through the EXIT trap,
  # so every copy goes on every path out.
  arm_drops " -- nothing uploaded"
  read_release_commit " -- nothing uploaded"
  [ "$APP_RELEASE_STATE" = tagged ] ||
    die "macos: there is no tag $APP_TAG here, the tag the project's version $REL_VERSION is released under -- nothing uploaded; cut the release first (or fetch its tag), then publish"
  require_stage_signed_at_tag "$APP_RELEASE_COMMIT"
  refuse_blockers "macos: $APP_NAME cannot ship with release $APP_TAG -- nothing uploaded" "$(app_ship_blockers "$dist" "$APP_RELEASE_COMMIT" tagged)"
  launcher="$ROOT/bin/devbin"
  [ -x "$launcher" ] || die "macos: no launcher at $launcher -- publish attaches through this project's release command"
  if ! staging="$(mktemp -d)" || [ -z "$staging" ] || ! cargo_place "$staging" staging getcwd; then
    die "macos: could not make a staging dir -- nothing uploaded"
  fi
  _PUBLISH_STAGING="$staging"
  mkdir "$staging/asset" "$staging/unpacked" || die "macos: could not make the staging dirs -- nothing uploaded"
  step "zipping the stapled bundle as $APP_ASSET"
  ditto -c -k --keepParent "$dist" "$staging/asset/$APP_ASSET" || die "macos: could not zip $dist"
  step "proving the zip as a download meets it"
  if ! ditto -x -k "$staging/asset/$APP_ASSET" "$staging/unpacked" || [ ! -d "$staging/unpacked/$APP_NAME" ]; then
    die "macos: $APP_ASSET does not unpack to $APP_NAME -- nothing uploaded"
  fi
  refuse_blockers "macos: the bundle inside $APP_ASSET cannot ship with release $APP_TAG -- nothing uploaded" "$(app_ship_blockers "$staging/unpacked/$APP_NAME" "$APP_RELEASE_COMMIT" tagged)"
  app_verify_notarised "$staging/unpacked/$APP_NAME" " -- nothing uploaded" ||
    die "macos: the bundle inside $APP_ASSET is not notarised and stapled -- nothing uploaded"
  step "attaching $APP_ASSET to release $APP_TAG through release attach --from"
  # The project's version, whatever the app's: the release is the project's.
  "$launcher" release attach "$REL_VERSION" --from "$staging/asset" ||
    die "macos: release attach did not finish (above) -- run publish again once what it names is fixed: the attach reads what is already done first"
  _PUBLISHED=yes
  printf '\npublished: %s on release %s\n' "$APP_ASSET" "$APP_TAG"
  # THE LAST DROP (issue 0243): every record at or under the build root, so the
  # bundle id resolves to the installed app alone. A build can register its
  # product again after any drop, so one left is a warning and the exit stands.
  if ! said="$(ls_drop_under "$APP_BUILD_ROOT")"; then
    LS_LINES="$said"
    ls_say
  fi
}

# bin-sign: the binaries built (macos.build, when no macos.app is declared,
# whose app-sign builds), staged outside the build tree, each signed with the
# Developer ID, the hardened runtime and a secure timestamp, each read back,
# and the commit they were signed at recorded for bin-publish. Refuses, building
# nothing, unless HEAD, in a clean tree, is the release's commit, as app-sign.
cmd_bin_sign() {
  local label src staged id ent name names=""
  local -a with_ent
  require_binaries
  load_identity
  require_identity
  release_names
  step "checking HEAD is release $APP_TAG's commit, in a clean tree"
  require_release_head bin-sign "bin-sign, bin-notarize and bin-publish" bin-publish
  [ -n "$APP_SRC" ] || [ -z "$APP_BUILD" ] || app_build_cached
  while IFS= read -r label; do
    src="$(bin_source "$label")"
    [ -e "$src" ] || die "macos: there is no build of $(bin_field "$label" path) at $src -- nothing signed"
  done <<<"$(bin_labels)"
  step "staging the binaries outside the build tree"
  require_stage_outside "$BIN_STATE_DIR" "$BIN_DIR"
  rm -rf "$BIN_STATE_DIR"
  mkdir -p "$BIN_STAGE_DIR" || die "macos: could not make the stage $BIN_STAGE_DIR"
  while IFS= read -r label; do
    src="$(bin_source "$label")"
    staged="$(bin_staged "$label")"
    ditto "$src" "$staged" || die "macos: could not stage $src -> $staged"
    # codesign refuses "resource fork, Finder information, or similar detritus".
    xattr -cr "$staged" || die "macos: could not clear the extended attributes of $staged"
  done <<<"$(bin_labels)"
  while IFS= read -r label; do
    staged="$(bin_staged "$label")"
    name="$(bin_field "$label" path)"
    id="$(bin_field "$label" identifier)"
    ent="$(bin_entitlements "$label")"
    with_ent=()
    [ -z "$ent" ] || with_ent=(--entitlements "$ent")
    step "signing $name as $id, team $(identity_team)"
    # --force replaces the ad hoc signature the linker puts on every arm64
    # binary; a .app is signed whole, as the projects signed theirs.
    codesign --force --options runtime --timestamp --identifier "$id" ${with_ent[@]+"${with_ent[@]}"} --sign "$IDENTITY" "$staged" ||
      die "macos: codesign could not sign $staged"
    names+=", $name"
  done <<<"$(bin_labels)"
  step "reading each signature back"
  while IFS= read -r label; do
    bin_check "$label" no
  done <<<"$(bin_labels)"
  record_signed_at "the binaries" "$BIN_STATE_DIR" "$BIN_STAGE_RECORD" bin-publish
  printf '\nsigned: %s, at %s\nnext: %s bin-notarize\n' "${names#, }" "${APP_RELEASE_COMMIT:0:12}" "$ME"
}

# bin-notarize: each staged binary checked as bin-sign left it, all of them
# submitted to Apple in one archive under the notary profile, and once
# Accepted, each assessed by Gatekeeper, every Apple verdict so before the tag.
cmd_bin_notarize() {
  local label staged staging payload zip project rc=0
  require_binaries
  load_identity
  require_identity
  bin_require_staged
  step "checking each staged binary is the signed one"
  while IFS= read -r label; do
    bin_check "$label" no
  done <<<"$(bin_labels)"
  project="$(cfg_get project.name)"
  staging="$(mktemp -d)" || die "macos: could not make a dir to build the submission in -- nothing submitted"
  payload="$staging/${project:-binaries}-notary"
  mkdir "$payload" || {
    rm -rf "$staging"
    die "macos: could not make $payload -- nothing submitted"
  }
  while IFS= read -r label; do
    staged="$(bin_staged "$label")"
    ditto "$staged" "$payload/${staged##*/}" || {
      rm -rf "$staging"
      die "macos: could not copy $staged into the submission -- nothing submitted"
    }
  done <<<"$(bin_labels)"
  zip="$staging/submission.zip"
  # ditto, never zip(1): it keeps the signatures notarisation reads.
  ditto -c -k --keepParent --sequesterRsrc "$payload" "$zip" || {
    rm -rf "$staging"
    die "macos: could not build the submission archive -- nothing submitted"
  }
  step "submitting the binaries to Apple (notarytool waits; usually minutes)"
  notary_submit "$zip" || rc=$?
  rm -rf "$staging"
  [ "$rc" = 0 ] || notary_refused "$rc" "nothing is assessed"
  step "Gatekeeper's verdict on each notarised binary"
  while IFS= read -r label; do
    bin_check "$label" yes
  done <<<"$(bin_labels)"
  printf '\nnotarised: every staged binary, each accepted by Gatekeeper\nnext: %s bin-publish, once the tag is cut\n' "$ME"
}

# bin-verify: each staged binary's signature read back, with Gatekeeper's
# verdict; changes nothing.
cmd_bin_verify() {
  local label
  require_binaries
  load_identity
  require_identity
  bin_require_staged
  while IFS= read -r label; do
    bin_check "$label" yes
  done <<<"$(bin_labels)"
}

# bin-publish: refuses, uploading nothing, unless the tag is cut; answers
# already, packing and uploading nothing, where the release carries its archive
# with SHA256SUMS agreeing, and refuses where it carries it and SHA256SUMS
# disagrees (release_bins_read, the read the cut's object step asks too); else
# refuses unless the staged binaries were signed at the tag's commit (bin-sign's
# record) and each passes its check with Gatekeeper, then packs them as
# release_bin_archive names the archive, a .app at its root, every other binary
# under bin/ and macos.pack.files at the root, and attaches it through release
# attach --from, the core's one way an asset reaches a release.
cmd_bin_publish() {
  local label staged name f src staging tree out project archive launcher only repo answer
  require_binaries
  release_names
  read_release_commit " -- nothing uploaded"
  [ "$APP_RELEASE_STATE" = tagged ] ||
    die "macos: there is no tag $APP_TAG here, the tag the project's version $REL_VERSION is released under -- nothing uploaded; cut the release first (or fetch its tag), then bin-publish"
  project="$(cfg_get project.name)"
  [ -n "$project" ] || die "macos: project.name is not declared, so the archive cannot be named -- nothing uploaded"
  archive="$(release_bin_archive "$project" "$REL_VERSION")" ||
    die "macos: rustc -vV names no host triple, so the archive cannot be named -- nothing uploaded"
  # Read before any binary is checked, since the checks ask Apple: a finished
  # release, the cut's re-run's included, asks nothing.
  repo="$(release_repo "$(cfg_release_get repo)" "$(cfg_release_first_remote)" 2>&1)" ||
    die "macos: the release's repository cannot be read: ${repo//$'\n'/ } -- nothing uploaded"
  answer="$(release_wait 0 "" UNREADABLE release_bins_read "$repo" "$APP_TAG" "$archive")" ||
    die "macos: whether release $APP_TAG carries $archive could not be read (exit $?) -- nothing uploaded"
  case "${answer%%$'\t'*}" in
    already)
      printf '\nalready: %s on release %s, %s -- nothing packed or uploaded\n' "$archive" "$APP_TAG" "${answer#*$'\t'}"
      return 0
      ;;
    absent) ;;
    pending) die "macos: $(release_bins_pending "$APP_TAG" "$archive" "${answer#*$'\t'}")" ;;
    *) die "macos: whether release $APP_TAG carries $archive cannot be read: ${answer#*$'\t'} -- nothing uploaded" ;;
  esac
  load_identity
  require_identity
  bin_require_staged
  require_stage_signed_at_tag "$APP_RELEASE_COMMIT" "$BIN_STAGE_RECORD" binaries "$ME bin-sign, then $ME bin-notarize"
  step "checking each staged binary as it ships"
  while IFS= read -r label; do
    bin_check "$label" yes
  done <<<"$(bin_labels)"
  launcher="$ROOT/bin/devbin"
  [ -x "$launcher" ] || die "macos: no launcher at $launcher -- bin-publish attaches through this project's release command"
  staging="$(mktemp -d)" || die "macos: could not make a staging dir -- nothing uploaded"
  # Removed on every way out, a refusal's included: no app path's drops run
  # here, so this command's EXIT is its own.
  _BIN_STAGING="$staging"
  trap 'rm -rf -- "$_BIN_STAGING"' EXIT
  tree="$staging/tree"
  out="$staging/asset"
  mkdir "$tree" "$out" || die "macos: could not make the staging dirs in $staging -- nothing uploaded"
  while IFS= read -r label; do
    staged="$(bin_staged "$label")"
    name="$(bin_field "$label" path)"
    case "$name" in
      *.app) ditto "$staged" "$tree/$name" ;;
      *) mkdir -p "$tree/bin" && ditto "$staged" "$tree/bin/$name" ;;
    esac || die "macos: could not place $name in the archive's tree -- nothing uploaded"
  done <<<"$(bin_labels)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    src="$(macos_path_value macos.pack.files "$f")"
    [ -f "$src" ] || die "macos: macos.pack.files names $f, and there is no such file -- nothing uploaded"
    cp "$src" "$tree/${src##*/}" || die "macos: could not place $src in the archive's tree -- nothing uploaded"
  done <<<"$(cfg_macos_pack_files)"
  # HOMEBREW INSTALLS FROM INSIDE AN ARCHIVE WHOSE ONE TOP-LEVEL ENTRY IS A
  # DIRECTORY, so bin/ alone, or one .app alone, would put what is inside it at
  # the keg's root, where a formula's bin/<name> or <name>.app finds nothing.
  # find-walk: -maxdepth 1 -- the tree's top level alone; it never enters one
  only="$(cd "$tree" && find . -mindepth 1 -maxdepth 1)" || die "macos: could not list the archive's tree -- nothing uploaded"
  if [ "$(grep -c . <<<"$only")" -eq 1 ] && [ -d "$tree/${only#./}" ]; then
    die "macos: the archive would hold ${only#./}/ alone, and Homebrew installs from inside an archive's one top-level directory -- declare macos.pack.files, or ship another binary beside it; nothing uploaded"
  fi
  step "packing $archive"
  # dotglob, so a pack file whose name opens with a dot is packed too; the glob
  # still takes neither . nor ..
  (cd "$tree" && shopt -s dotglob && COPYFILE_DISABLE=1 tar -czf "$out/$archive" -- *) || die "macos: could not pack $archive -- nothing uploaded"
  step "attaching $archive to release $APP_TAG through release attach --from"
  "$launcher" release attach "$REL_VERSION" --from "$out" ||
    die "macos: release attach did not finish (above) -- nothing more is uploaded"
  rm -rf "$staging"
  printf '\npublished: %s on release %s\n' "$archive" "$APP_TAG"
}

# leg: what a cut's macOS stage runs, before the tag, for what the project
# declares: app-sign then app-notarize where macos.app is declared, and
# bin-sign then bin-notarize where macos.binaries is declared and the release
# object is the project's own (release.object local), each through the
# project's launcher, the first that fails ending the leg.
cmd_leg() {
  local launcher="$ROOT/bin/devbin" ran=no
  [ -x "$launcher" ] || die "macos: no launcher at $launcher -- the leg runs each step through it"
  if [ -n "$APP_SRC" ]; then
    "$launcher" macos app-sign || exit
    "$launcher" macos app-notarize || exit
    ran=yes
  fi
  if [ -n "$(bin_labels)" ] && [ "$(cfg_release_get object)" = local ]; then
    "$launcher" macos bin-sign || exit
    "$launcher" macos bin-notarize || exit
    ran=yes
  fi
  [ "$ran" = yes ] ||
    die "macos: $DEVBIN_DIR/config.yaml declares no macos.app, and no macos.binaries under release.object local -- the macOS stage has nothing to sign"
}

case "$sub" in
  doctor) cmd_doctor ;;
  store-creds) cmd_store_creds ;;
  app-sign) cmd_app_sign ;;
  app-notarize | app-notarise) cmd_app_notarize ;;
  app-verify) cmd_app_verify ;;
  publish) cmd_publish ;;
  bin-sign) cmd_bin_sign ;;
  bin-notarize | bin-notarise) cmd_bin_notarize ;;
  bin-verify) cmd_bin_verify ;;
  bin-publish) cmd_bin_publish ;;
  leg) cmd_leg ;;
esac
