#!/usr/bin/env bash
#
# The built-in `version`. Tier 1 -- every corpus project has the
# same sub-commands over the same semver logic -- and it is the family
# with the most real code and the most risk in it.
#
# THE SUB-COMMANDS ARE NOT CATALOGUE OPTIONS, deliberately. An option set gets a
# synthesised `all`, and `version all` -- show, then set, then bump, then
# sync -- is nonsense at best. These are sub-commands of a tier-1 handler.
#
#   (bare)     print "<name> <version>"
#   show       print the bare number, for scripting
#   set <v>    write <v> to the version file and every sidecar
#   bump <p>   advance major|minor|patch and write
#   sync       re-apply the CURRENT version everywhere, healing drift
#   check      report drift, write nothing, exit non-zero if any
#
# THE INVARIANTS, each learned the hard way in the corpus and each load-bearing.
#
# DERIVED FILES FIRST, THE VERSION FILE LAST. One project states the rule: a
# partial failure then leaves the version file un-advanced, so re-running
# `bump patch` recomputes the SAME target and retries cleanly. Write the
# version file first and a failure halfway leaves it advanced, so the rerun
# bumps again -- a double-bump on top of a half-synced tree. Another writes it
# first and has `sync`/`check` to heal the drift that causes, which is treating
# the symptom. Raised against that project, not fixed from here.
#
# THE SYNC IS UNCONDITIONAL. A corpus comment records the shipped defect: an
# earlier "only if the current version differs" gate skipped sidecar healing
# whenever the version file already held the target, so a tree with the version
# bumped in one commit and a plist lagging shipped a wrong
# CFBundleShortVersionString at v0.3.2. Always write; let git decide what
# actually changed.
#
set -euo pipefail

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"

cd "${PROJECT_ROOT:?}" || die "cannot enter $PROJECT_ROOT"

version_file="${DEVBIN_VERSION_FILE:-VERSION}"

usage() {
  printf 'usage: %s version [show|set <version>|bump <major|minor|patch>|sync|check]\n' \
    "${DEVBIN_INVOKE:-bin/devbin}"
}

# sidecars -- the declared mirror files, one per line, absent ones included so
# they can be reported rather than silently skipped.
sidecars() {
  printf '%s' "${DEVBIN_VERSION_SIDECARS:-}"
}

# READING IS read_version's JOB, not this file's.
#
# The first draft of this command had its own per-kind extractors, and they
# disagreed with read_version's within an hour: read_version anchors mix.exs's
# `version:` at the start of a line and the copy here did not. A reader and a
# writer that disagree about which line they mean is the precise mechanism by
# which `check` reports a file clean that `set` would rewrite differently.
#
# So the write recipes below MIRROR read_version's patterns deliberately, and
# `check` reads through read_version rather than around it. For the kinds a
# recipe rewrites one line of, which line is version_line's answer, asked by
# the reader and the recipe alike (issue 0263).

# THERE IS DELIBERATELY NO Cargo.lock RECIPE, and one project declares two.
#
# A lockfile carries a `version` for every package in the graph, so a recipe has
# to know WHICH entries are this project's own -- and it cannot derive that from
# the file. That project's own `sync_cargo_lock` hardcodes `demo` and `demod`;
# devbin has no equivalent to hardcode.
#
# Each derivation that looks available fails. Bumping every entry whose
# version matches the project's would corrupt any third-party dependency that
# happens to share the number. Taking the package names from the project's
# declared `Cargo.toml` sidecars does work -- but it would have to work for the
# READER too, and `read_version` lives in `lib/helpers`, which has no
# dependencies by rule and so cannot consult config. A recipe present in
# the writer and absent from the reader is precisely the asymmetry the comment
# above ("READING IS read_version's JOB") exists to prevent.
#
# So the bare-sidecar guard below refuses a Cargo.lock, by what it holds, and
# says what to do instead.
# Whether a migrated project syncs its locks from its own command is that
# project's call, not the framework's (issue 0002).

# THE BARE-SIDECAR GUARD IS version_file_state's `norecipe` (issue 0265). The
# bare-version default writes the version over the WHOLE file. For the version
# file that is the entire job. For a sidecar it is a guess about a file the
# PROJECT chose, and the guess was unchecked: devbin dispatches on basename and
# then writes content it never looked at. One project declares two
# `Cargo.lock` sidecars, and before the guard each was replaced by five bytes
# and the run exited 0; `check` then reported the tree clean, and the cure
# `check` advertised -- `version sync` -- was the command that did it (issue
# 0002). The classifier asks the FILE, not its name: a guard keyed on "a
# basename I recognise" would refuse `plain.txt`, which is a documented, tested
# and perfectly good sidecar, a second file holding nothing but the version.
# One that holds nothing is `empty`, legal to fill, and one devbin cannot read
# is `noread`, never taken as empty.

# write_version_into <file> <version> [role] [phase] -- apply the recipe for
# this file's kind. `role` is `sidecar` (the default) or `version-file`, the
# role version_file_state and version_unread answer in: it selects whether the
# bare-version default is a known fact or a guess, and with it the states, the
# key a refusal names and its remedies. `phase` is `write` (the default) or `preflight`: preflight raises
# every refusal this file could raise and stops short of mutating anything,
# which is everything version_unread says of it in its role, asked as the
# writer asks (issue 0259, 0260, 0265).
#
# Preflight exists because the guards used to fire mid-loop, INSIDE the write
# pass: with sidecars [Cargo.toml, Cargo.lock] the .toml was already rewritten
# when the .lock was refused, while the refusal said "Nothing has been written"
# -- the command that reported writing nothing had introduced exactly the drift
# it polices, and `version check` then flagged it.
# Refusing every file before touching any is what makes the message true.
write_version_into() {
  local file="$1" version="$2" role="${3:-sidecar}" phase="${4:-write}" kind line nth
  # The kind is lib/helpers' version_kind, the one table read_version reads by,
  # so a reader and a writer cannot disagree about what a file is.
  kind="$(version_kind "$file")"
  # EVERY REFUSAL IS version_unread's, IN THE FILE'S ROLE, ASKED AS THE WRITER
  # ASKS (issue 0259, 0260, 0265), in the words show, check and doctor use,
  # while the tree is as it was: a write that failed after the sidecars would
  # strand a half-written set.
  # - A missing version file is started where the write will take: `version
  #   set 0.1.0` is how a project begins one. Only a path with nothing at it,
  #   of the bare kind, in a directory that takes a new file, is started. A
  #   missing sidecar is refused: one silently skipped is how a tree drifts.
  # - A link to no file is refused, since writing through it would create the
  #   file it names, somewhere the project never put one.
  # - One devbin cannot read is refused, never taken as empty: a sidecar
  #   holding prose was overwritten at exit 0 that way (0264's P2).
  # - A structured one in which read_version reads no version is refused,
  #   since its recipe then rewrote nothing and set printed `unknown` at exit
  #   0, and so is a bare sidecar holding more than a version (the guard
  #   above). A plist needs PlistBuddy, which is macOS-only: a skipped plist is
  #   precisely the silent drift the unconditional sync exists to prevent.
  # - Last, one its write could not change, asked by kind (version_unwritten),
  #   so its remedy is never moot: the write pass failed on it after the files
  #   before it had taken the new version.
  if version_unread why "$file" "$role" write >/dev/null; then
    die "cannot write the version: $(version_unread why "$file" "$role" write) -- $(version_unread fix "$file" "$role" write)"
  fi
  [ "$phase" = write ] || return 0
  case "$kind" in
    cargo | mix | npm)
      # THE ONE LINE read_version READS, AND NO OTHER (issue 0263): version_line
      # names it, so the recipe rewrites the line the reader reads. Each sed,
      # unaddressed, rewrote every line that looked like a version, a
      # dependency table's included, at exit 0. The preflight refused a file
      # with no such line, so one is there.
      line="$(version_line "$file")" ||
        die "cannot write the version into $file: devbin reads no version line in it"
      nth="${line##*$'\t'}"
      line="${line%%$'\t'*}"
      case "$kind" in
        cargo) sed_inplace "${line}s/^version *= *\"[^\"]*\"/version = \"$version\"/" "$file" ;;
        # Leading whitespace kept: the line is indented inside `def project`.
        mix) sed_inplace "${line}s/^\\( *\\)version: *\"[^\"]*\"/\\1version: \"$version\"/" "$file" ;;
        # The pair version_line counted, the top-level one, wherever it sits on
        # its line, so a nested pair ahead of it is never the one rewritten
        # (issue 0280).
        npm) sed_inplace "${line}s/\"version\"\([[:space:]]*\):\([[:space:]]*\)\"[^\"]*\"/\"version\"\1:\2\"$version\"/$nth" "$file" ;;
      esac
      ;;
    plist)
      "$(plistbuddy_path)" -c "Set :CFBundleShortVersionString $version" "$file"
      ;;
    bare)
      # A version file that is not there yet is written here, which creates it.
      printf '%s\n' "$version" >"$file"
      ;;
  esac
}

# apply_version <version> -- write it everywhere, derived files FIRST.
#
# TWO passes. The first is preflight: every file raises any refusal it is
# going to raise while the tree is still exactly as it was, so a refusal never
# strands a half-written set. Only when every file has passed does the write
# pass run. See write_version_into for the defect this closed.
#
# THEN EVERY FILE WRITTEN IS READ BACK (issue 0264). A write's own status
# proves nothing -- PlistBuddy exits 0 when it cannot write -- so set, bump and
# sync each read every file through its own recipe, as check would, and refuse,
# naming each, unless every one reads the version written. The sidecars are
# read back BEFORE the version file is written, so one whose write did not take
# leaves the version file where it was, as DERIVED FILES FIRST requires: a
# rerun of `bump patch` then computes the same target. The remedy is `version
# set <version>`, which is right whichever file did not take.
apply_version() {
  local version="$1" file have unread="" redo
  assert_semver "$version"
  redo="${DEVBIN_INVOKE:-bin/devbin} version set $version"
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    write_version_into "$file" "$version" sidecar preflight
  done <<EOF
$(sidecars)
EOF
  write_version_into "$version_file" "$version" version-file preflight
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    write_version_into "$file" "$version"
  done <<EOF
$(sidecars)
EOF
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    have="$(read_version "$file")"
    [ "$have" = "$version" ] || unread+=$'\n'"       $file reads $have"
  done <<EOF
$(sidecars)
EOF
  [ -z "$unread" ] || die "the write of $version did not take in every sidecar it was written to:$unread
       $version_file was not written, so it still holds the version it held. Fix what kept each from taking, then run '$redo'."
  # LAST, and only once every sidecar has succeeded. See DERIVED FILES FIRST
  # above. The role is what tells write_version_into that the bare-version
  # default is a fact here rather than a guess: this file is the one
  # `version_from` names.
  write_version_into "$version_file" "$version" version-file
  have="$(read_version "$version_file" version-file)"
  [ "$have" = "$version" ] || die "the write of $version did not take in $version_file, which reads $have, though every sidecar took it.
       Fix what kept it from taking, then run '$redo'."
  return 0
}

# report_drift -- print every sidecar disagreeing with the version file.
# Returns non-zero when any does.
# Set by report_drift alongside its exit status: 1 when at least one sidecar
# is one `version sync` would refuse, as distinct from drift a sync heals: one
# that gives no version to compare, or one whose write could not change it. A
# shell function has one exit code and this is the second fact the caller
# needs -- "drifted" is a claim about a comparison that happened, and saying it
# about a file devbin never parsed is the gate asserting something it did not
# verify, as prescribing a sync for a file sync refuses is.
DEVBIN_VERSION_SYNC_REFUSES=0

report_drift() {
  local want file state have clause drift=0
  DEVBIN_VERSION_SYNC_REFUSES=0
  # THE POPULATION IS COUNTED, NOT JUST THE FAILURES. `drift` alone answers
  # "did anything disagree", which is 0 both when every sidecar agreed and
  # when there were none -- so the caller could not tell a real pass from a
  # vacuous one, and said `every sidecar agrees` for both. A universally
  # quantified claim over an empty set is TRUE and says nothing. Issue 0061,
  # reported from a consumer's checkout.
  DEVBIN_VERSION_EXAMINED=0
  want="$(read_version)"
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    DEVBIN_VERSION_EXAMINED=$((DEVBIN_VERSION_EXAMINED + 1))
    # WHAT STANDS AT IT IS version_file_state's ANSWER, IN THE SIDECAR ROLE, and
    # its words version_unread's (issue 0265), the ones set refuses with. Only a
    # sidecar that reads is compared. An empty one of the bare kind is drift
    # `sync` heals, since a write fills it, never one to un-declare. Any other
    # gives no version to compare, and set and sync refuse it as well: it was
    # once called missing, or empty when its read had failed, and check then
    # prescribed the sync that refused it. An empty one is worded by the table,
    # in version_unread's clause, never in words of this reader's own (issue
    # 0289). A drifted or empty one is asked the writer's question too, as sync
    # asks it (version_unread's `write`), so one sync could not change is named
    # for that and no sync is prescribed.
    state="$(version_file_state "$file" sidecar)"
    case "$state" in
      reads | empty)
        if [ "$state" = reads ]; then
          have="$(read_version "$file")"
          [ "$have" != "$want" ] || continue
        else
          have="$(version_unread clause "$file" sidecar)"
        fi
        if clause="$(version_unread clause "$file" sidecar write)"; then
          printf '  %-40s %s (expected %s) -- %s\n' "$file" "$have" "$want" "$clause"
          DEVBIN_VERSION_SYNC_REFUSES=1
        else
          printf '  %-40s %s (expected %s)\n' "$file" "$have" "$want"
        fi
        drift=1
        ;;
      *)
        printf '  %-40s not compared -- %s\n' "$file" "$(version_unread clause "$file" sidecar)"
        DEVBIN_VERSION_SYNC_REFUSES=1
        drift=1
        ;;
    esac
  done <<EOF
$(sidecars)
EOF
  return "$drift"
}

case "${1:-}" in
  "")
    # Rendered by lib/helpers, NOT here. This arm and the `--version` flag in
    # bin/devbin answer the same question and used to print two different
    # things; see version_identity for what that cost and why show stays bare.
    #
    # The suppression sits HERE, at the call site, which is the lesson from the
    # day this call was created: the same directive was left behind in
    # bin/devbin when the printf moved out of it, suppressing nothing while
    # still reading as a considered decision. It was deleted there rather than
    # copied. CI has been red on this exact line since -- local lint runs at a
    # higher severity floor and never saw it. devbin issue 0052.
    # shellcheck disable=SC2119  # the bare call IS the point: project-root role.
    version_identity
    ;;
  show)
    # NOTHING ON STDOUT WITHOUT A VERSION (issue 0259). A script reads this line
    # as the number, and `unknown` read as one names a tag or an artefact
    # `vunknown`, at exit 0.
    if why="$(version_unread why)"; then
      die "no version to show: $why -- $(version_unread fix)"
    fi
    # read_version emits no terminator (every extractor path strips it), and a
    # bare number with no newline glues itself to the next prompt and breaks
    # line-oriented readers. The corpus's own show printed the newline; found
    # by a migration's first probe.
    # shellcheck disable=SC2119  # the bare call IS the point: version-file role
    printf '%s\n' "$(read_version)"
    ;;
  set)
    [ $# -ge 2 ] || die "version set needs a version (eg: version set 1.2.3)"
    apply_version "$2"
    printf '%s\n' "$(read_version)"
    ;;
  bump)
    [ $# -ge 2 ] || die "version bump needs a part (major, minor or patch)"
    # NOTHING TO BUMP WITHOUT A VERSION (issue 0259), said once, in the words
    # show uses. The next version is worked out in this shell, never inside
    # apply_version's argument: a refusal there was said, and then said again of
    # the empty string apply_version was handed.
    if why="$(version_unread why)"; then
      die "no version to bump: $why -- $(version_unread fix)"
    fi
    bumped="$(bump_semver "$(read_version)" "$2")"
    apply_version "$bumped"
    printf '%s\n' "$(read_version)"
    ;;
  sync)
    # Unconditional, by design. See THE SYNC IS UNCONDITIONAL above. With no
    # version to sync it is refused in the words show uses (issue 0259).
    if why="$(version_unread why)"; then
      die "no version to sync: $why -- $(version_unread fix)"
    fi
    apply_version "$(read_version)"
    printf '%s\n' "$(read_version)"
    ;;
  check)
    # A VERSION THAT CANNOT BE READ IS NOT A PASS (issue 0259). With no sidecar
    # declared there was nothing to compare, so the line said `version:
    # unknown` at exit 0, and a gate read a project with no version as clean.
    if why="$(version_unread why)"; then
      die "version check: the version cannot be read: $why -- $(version_unread fix)"
    fi
    if report_drift; then
      # ZERO IS A DIFFERENT VERDICT, NOT A QUIETER PASS. It stays exit 0 because
      # zero is the ORDINARY configuration rather than a misconfiguration --
      # measured as the common case across projects, devbin's own included --
      # so failing it would break `version check` in most of them, for projects
      # that are correctly set up with a single version file. That is the line
      # `infra check` already draws: a gate that COULD NOT examine fails, a gate
      # with NOTHING DECLARED to examine says so.
      #
      # The count alone would not have been enough. `0 sidecar(s) agree` still
      # reads as success to a skimming eye, which is issue 0061's point and the
      # reason both halves landed rather than the cheaper one.
      if [ "${DEVBIN_VERSION_EXAMINED:-0}" -eq 0 ]; then
        printf 'version: %s, NO sidecars declared -- nothing was compared\n' "$(read_version)"
      else
        printf 'version: %s, %s sidecar(s) agree\n' "$(read_version)" "$DEVBIN_VERSION_EXAMINED"
      fi
    elif [ "$DEVBIN_VERSION_SYNC_REFUSES" = 1 ]; then
      # Naming `sync` here would send the reader at a command that refuses this
      # file too. The fix is in the file or the config, not in a heal.
      die "a declared sidecar is one 'version sync' would refuse as well (above), so no sync is prescribed.
       Make it one devbin reads and writes, drop it from project.version_sidecars, or have the project's own command sync it."
    else
      die "version sidecars have drifted (heal with: ${DEVBIN_INVOKE:-bin/devbin} version sync)"
    fi
    ;;
  -h | --help)
    usage
    ;;
  *)
    usage
    die "unknown version sub-command: $1"
    ;;
esac
