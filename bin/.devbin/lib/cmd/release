#!/usr/bin/env bash
#
# The built-in `release` (ST0007): one copy of the release sequence for every
# project that releases. Opt-in, like `publish`: a project enables
# it with `commands.release.enabled: true`, and a `release:` block does not
# enable it by being present.
#
#   release <--patch|--minor|--major|vX.Y.Z> [--dry-run] [--yes]   cut a release
#   release status <vX.Y.Z>                                         the resume map
#   release notes                                                   regenerate the notes views
#   release check                                                   the declaration, the writers, the notes views
#   release attach <vX.Y.Z>                                         CI-built assets onto the release object
#   release attach <vX.Y.Z> --from <dir>                            the files in <dir> onto it (issue 0226)
#   release snapshot <vX.Y.Z> <new-dir> [--no-parent]               the tag's public snapshot, made in <new-dir> (issue 0239)
#   release snapshot --commit <rev> <new-dir> [--no-parent]         the same of any commit, for an audit ahead of a cut
#   release publish <vX.Y.Z> [--expect <sha>] [--dry-run] [--yes]   the tag's snapshot made public through CI (issue 0240)
#   release                                                         usage, exit 1
#
# EVERY ARGUMENT IS PARSED BEFORE ANYTHING ACTS, and `-h` or `--help` in any
# position prints usage and exits 0. Issue 0064 recorded
# `macos prepare --help` rebuilding a project's app: a handler that acts on its
# first word before reading the rest cannot promise that --help is safe.
#
# A PROJECT OFFERS THE VERBS release.verbs NAMES, every one by default (ST0008
# WP-08). A verb it leaves out is refused with exit 2, the dispatcher's code for
# what is not available here, before anything else is read: so a project whose
# own command cuts its releases offers `check` and `attach` with the cut off,
# and a script can tell "switched off" (2) from "ran and failed" (1). A cut has
# no verb word on the command line, and is named `cut`.
#
# AS BUILT BY WP-06: the argument loop, `release check` (the declaration and the
# notes), `release notes`, whose providers are lib/release.notes, `release
# status`, whose readers are lib/release.steps, and a cut's steps, resolve to ci, with
# --dry-run (cut_run), under every `object:`. Nothing in a cut exits 3 now.
# ST0008 WP-08 added release.verbs; `release attach`, which the object step of a
# cut runs too under object: local (attach_assets); and a writers check that
# reads every release-writing step (check_release_writers).
#
set -euo pipefail

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
# shellcheck source=lib/runlog
. "$DEVBIN_LIB/runlog"
# shellcheck source=lib/config
. "$DEVBIN_LIB/config"
# shellcheck source=lib/release.notes
. "$DEVBIN_LIB/release.notes"
# shellcheck source=lib/release.steps
. "$DEVBIN_LIB/release.steps"
# shellcheck source=lib/resolve
# command_active, for the cut's note back to brew (cut_back_to_brew).
. "$DEVBIN_LIB/resolve"

# usage -- the forms of the verbs this project offers, and only those.
usage() {
  local me="${DEVBIN_INVOKE:-bin/devbin} release" lead="usage:" v docs
  while IFS= read -r v; do
    if [ -z "$v" ] || ! offered "$v"; then continue; fi
    case "$v" in
      cut) printf '%s %s <--patch|--minor|--major|vX.Y.Z> [--dry-run] [--yes]\n' "$lead" "$me" ;;
      status) printf '%s %s %s <vX.Y.Z>\n' "$lead" "$me" "$v" ;;
      attach) printf '%s %s %s <vX.Y.Z> [--from <dir>]\n' "$lead" "$me" "$v" ;;
      snapshot) printf '%s %s %s <vX.Y.Z | --commit <rev>> <new-dir> [--no-parent]\n' "$lead" "$me" "$v" ;;
      publish) printf '%s %s %s <vX.Y.Z> [--expect <sha>] [--dry-run] [--yes]\n' "$lead" "$me" "$v" ;;
      *) printf '%s %s %s\n' "$lead" "$me" "$v" ;;
    esac
    lead="      "
  done <<<"$ALL_VERBS"
  [ "$lead" != "usage:" ] || printf 'usage: none -- release.verbs offers no verb of %s\n' "$me"
  printf '\n'
  if offered cut; then
    printf '  Cut a release: stamp, commit, gate, confirm, tag, push, the release object,\n'
    printf '  then after: and the CI verdict. Each step with a postcondition reads it\n'
    printf '  first, so a re-run continues. --dry-run makes no commit, tag, push or\n'
    printf '  release object, but runs the gates.\n'
  fi
  if offered attach; then
    printf '  attach: the assets release.assets.workflow'"'"'s run at the tag built, onto\n'
    printf '  its release object, with one SHA256SUMS over every asset. --from <dir>\n'
    printf '  attaches the files in <dir> instead, as the built-in macos attaches its app.\n'
  fi
  if offered snapshot; then
    printf '  snapshot: one commit holding the tag'"'"'s tracked files over\n'
    printf '  release.snapshot.list, made in <new-dir>, which must not exist yet: on the\n'
    printf '  tip of the publish branch at release.publish.url, or with no parent under\n'
    printf '  --no-parent or when there is no tip. --commit <rev> snapshots any commit.\n'
  fi
  if offered publish; then
    printf '  publish: under release.publish.url a cut stops after its push, and this\n'
    printf '  makes the tag'"'"'s snapshot public: pushed to its candidate branch, then,\n'
    printf '  once ci.query reads green on it, the publish branch and the tag. Nothing\n'
    printf '  is forced. --expect refuses a snapshot of any other sha.\n'
  fi
  if cfg_release_declared verbs; then
    printf '  This project'"'"'s release.verbs offers %s.\n' "${OFFERED//$'\n'/, }"
  fi
  # THE GUIDE BY ITS PLACE IN THIS MACHINE'S INSTALL (issue 0254): a bare
  # docs/configuration.md named a file in a checkout a brew user has not got.
  printf '  Declared in the release: block of bin/.devbin/config.yaml; see\n'
  if docs="$(devbin_docs_place "$PROJECT_ROOT")"; then
    printf '  %s/configuration.md.\n' "$docs"
  else
    printf "  configuration.md among devbin's guides, which are not here: %s.\n" "$docs"
  fi
}

# refuse <message> -- a usage refusal: usage on stderr, the reason, exit 1.
refuse() {
  usage >&2
  printf '\n' >&2
  die "release: $1"
}

# THE CONFIG IS LOADED FIRST, before --help, because usage prints only the verbs
# this project offers (ST0008 WP-08). Loading reads the file and acts on
# nothing; the dispatcher has already loaded it to send the command here.
#
# THE CONFIG CACHE DOES NOT CROSS INTO A HANDLER, and an empty cache would read
# as "declared nothing" -- every key at its default, in a project that declared
# otherwise. So a config that does not load stops the command.
cd "${PROJECT_ROOT:?}" || die "cannot enter $PROJECT_ROOT"
cfg_load "${DEVBIN_DIR:?}/config.yaml" || die "release: cannot read $DEVBIN_DIR/config.yaml"
ALL_VERBS="$(cfg_release_verbs)" || die "release: the release: schema names no verbs"
OFFERED="$(cfg_release_list verbs)" || die "release: cannot read release.verbs"

# offered <verb> -- true when this project's release.verbs offers <verb>.
offered() { grep -qxF -- "$1" <<<"$OFFERED"; }

# --help first, over every argument, so no later word can act or refuse first.
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

if [ $# -eq 0 ]; then
  usage >&2
  exit 1
fi

# --- parse ----------------------------------------------------------------
verb="cut"
target=""
version=""
dry_run=0
assume_yes=0
from=""
snap_commit=""
snap_dir=""
no_parent=0
snap_words=()
expect=""

# Every verb but the cut has a word, read from the one list (cfg_release_verbs).
if [ "$1" != cut ] && grep -qxF -- "$1" <<<"$ALL_VERBS"; then
  verb="$1"
  shift
fi

# A release.verbs THAT DOES NOT VALIDATE FAILS AS CONFIG, exit 1, before the
# refusal below reads it: a misspelt verb, or "-", would otherwise read as a
# verb switched off, exit 2, and a script that passes over what is switched off
# would pass over it in silence. The validator names what is wrong.
verbs_bad=""
while IFS= read -r v; do
  [ -z "$v" ] || grep -qxF -- "$v" <<<"$ALL_VERBS" || verbs_bad+=" $v"
done <<<"$OFFERED"
if [ -n "$verbs_bad" ] || { cfg_release_declared verbs && [ -z "$OFFERED" ]; }; then
  cfg_validate || true
  die "release: release.verbs in $DEVBIN_DIR/config.yaml does not validate (above), so which verbs this project offers cannot be read"
fi

# A VERB THIS PROJECT SWITCHED OFF IS REFUSED HERE, before its arguments are
# read and before anything else is: no validation, no git, no gh (ST0008 WP-08).
if ! offered "$verb"; then
  offers="${OFFERED//$'\n'/, }"
  warn "release: $verb is not available here: release.verbs offers ${offers:-no verb} ($DEVBIN_DIR/config.yaml)"
  # code-2: a verb release.verbs leaves out is not available here, which is
  # what 2 means from the dispatcher for a command.
  exit 2
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --patch | --minor | --major)
      [ "$verb" = cut ] || refuse "$1 is a cut's target, and this is release $verb"
      [ -z "$target" ] || refuse "one target only, got $target and $1"
      target="$1"
      ;;
    --dry-run)
      [ "$verb" = cut ] || [ "$verb" = publish ] || refuse "--dry-run applies to a cut, not to release $verb: a cut and release publish take it"
      dry_run=1
      ;;
    --yes)
      [ "$verb" = cut ] || [ "$verb" = publish ] || refuse "--yes applies to a cut, not to release $verb: a cut and release publish take it"
      assume_yes=1
      ;;
    --expect)
      # THE SHA WHOLE, as release snapshot prints it: a person approves one
      # commit, and a prefix would let another that shares it through.
      [ "$verb" = publish ] || refuse "--expect applies to release publish, not to release $verb"
      [ -z "$expect" ] || refuse "--expect once only, got $expect and ${2:-nothing}"
      [ $# -ge 2 ] && [[ "${2,,}" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] ||
        refuse "--expect takes the snapshot's whole sha, as release snapshot prints it, not ${2:-nothing}"
      expect="${2,,}"
      shift
      ;;
    --from)
      [ "$verb" = attach ] || refuse "--from applies to release attach, not to release $verb"
      [ -z "$from" ] || refuse "--from once only, got $from and ${2:-nothing}"
      [ $# -ge 2 ] && [ -n "$2" ] || refuse "--from needs a directory"
      # Read from the project root, where the command runs (it entered it
      # above), by physical_dir: a bare cd found a relative name through
      # CDPATH, and its printed line went into the path (issue 0267).
      [ -d "$2" ] || refuse "--from $2 is not a directory (a relative one is read from the project root)"
      physical_dir "$2" from || refuse "--from $2 could not be entered"
      shift
      ;;
    --commit)
      [ "$verb" = snapshot ] || refuse "--commit applies to release snapshot, not to release $verb"
      [ -z "$snap_commit" ] || refuse "--commit once only, got $snap_commit and ${2:-nothing}"
      [ $# -ge 2 ] && [ -n "$2" ] || refuse "--commit needs a commit"
      snap_commit="$2"
      shift
      ;;
    --no-parent)
      [ "$verb" = snapshot ] || refuse "--no-parent applies to release snapshot, not to release $verb"
      no_parent=1
      ;;
    -*)
      refuse "unknown argument: $1"
      ;;
    *)
      case "$verb" in
        cut)
          [ -z "$target" ] || refuse "one target only, got $target and $1"
          is_semver "${1#v}" || refuse "not a version: $1 (want vX.Y.Z or X.Y.Z)"
          target="v${1#v}"
          ;;
        status | attach | publish)
          [ -z "$version" ] || refuse "release $verb takes one version, got $version and $1"
          is_semver "${1#v}" || refuse "not a version: $1 (want vX.Y.Z or X.Y.Z)"
          version="${1#v}"
          ;;
        # Its words are read once all are in: with --commit the one word is
        # the directory, without it the version and then the directory.
        snapshot) snap_words+=("$1") ;;
        *)
          refuse "release $verb takes no argument, got: $1"
          ;;
      esac
      ;;
  esac
  shift
done

case "$verb" in
  cut) [ -n "$target" ] || refuse "a cut needs a target: --patch, --minor, --major or vX.Y.Z" ;;
  status | attach | publish) [ -n "$version" ] || refuse "release $verb needs a version" ;;
  snapshot)
    if [ -n "$snap_commit" ]; then
      [ "${#snap_words[@]}" -eq 1 ] || refuse "release snapshot --commit <rev> takes the new directory alone"
      snap_dir="${snap_words[0]}"
    else
      [ "${#snap_words[@]}" -eq 2 ] || refuse "release snapshot takes a version and a new directory, or --commit <rev> and a new directory"
      is_semver "${snap_words[0]#v}" || refuse "not a version: ${snap_words[0]} (want vX.Y.Z or X.Y.Z)"
      version="${snap_words[0]#v}"
      snap_dir="${snap_words[1]}"
    fi
    ;;
esac

# --- act ------------------------------------------------------------------
# The config was loaded, and the working directory entered, above.

# check_declaration -- validate, then print every release key with its value
# and whether the project declared it or it is the default.
check_declaration() {
  local key shape value from IFS=$' \t\n' i kw vw
  local -a keys=() values=() froms=()
  if ! cfg_validate; then
    die "release check: $DEVBIN_DIR/config.yaml does not validate (above)"
  fi
  printf 'release: declaration (%s)\n' "$DEVBIN_DIR/config.yaml"
  while read -r shape key _; do
    [ -n "$shape" ] || continue
    if cfg_release_declared "$key"; then from=declared; else from=default; fi
    if [ "$shape" = scalar ]; then
      value="$(cfg_release_get "$key")"
    else
      value="$(cfg_release_list "$key")"
      value="${value//$'\n'/, }"
      if [ -z "$value" ] && [ "$key" = remotes ]; then
        value="every remote git lists"
      fi
    fi
    keys+=("$key") values+=("${value:-(none)}") froms+=("$from")
  done <<<"$_DEVBIN_RELEASE_SCHEMA"
  # EACH COLUMN IS AS WIDE AS ITS LONGEST ENTRY, read off what this run prints
  # (issue 0207): a width written here was overrun by a key or a value added
  # later, and that row printed its source out of line.
  kw="$(_release_widest "${keys[@]}")"
  vw="$(_release_widest "${values[@]}")"
  for i in "${!keys[@]}"; do
    printf '  %-*s %-*s %s\n' "$kw" "${keys[$i]}" "$vw" "${values[$i]}" "${froms[$i]}"
  done
  check_release_writers
}

# check_release_writers -- one writer per release object. Under object:
# local the core writes it, so a workflow STEP that writes a release object is a
# second writer, whatever starts the workflow (ST0008 WP-08): a tag, a `release:`
# event, a dispatch. It races the core's create, or replaces what the core
# made. Each is named by file and line (release_workflow_writers), for the
# project to decide, and the warning leaves the exit status alone.
#
# A PASS IS NEVER READ FROM SILENCE. Every outcome prints a line: how many
# workflow files were read and that none writes a release object, a tree with
# none, and why nothing is looked for under `ci` or `none`.
#
# A WORKFLOW THAT COULD NOT BE READ IS NAMED, NOT SKIPPED, and the pass line
# then does not say none writes one. grep's exit 2 on an unreadable file was
# once read as "no match", which said there was no second writer when nobody
# had looked.
check_release_writers() {
  local object wf rc hits line what err n=0 writers=0 unread=0
  object="$(cfg_release_get object)" || die "release check: cannot read release.object"
  if [ "$object" != local ]; then
    printf 'release: object is %s, so the core makes no release object, and no second writer of one is looked for\n' "$object"
    return 0
  fi
  if [ ! -d .github/workflows ]; then
    printf 'release: there is no .github/workflows here, so no workflow writes a release object\n'
    return 0
  fi
  # The reader's words go to a file of their own, so a failure is named in them
  # and a word on stderr is never read as a step.
  if ! err="$(mktemp "${TMPDIR:-/tmp}/devbin-writers.XXXXXX")"; then
    printf 'release: WARNING: no file under %s to take the workflows'"'"' errors in, so no workflow was checked for a second writer\n' "${TMPDIR:-/tmp}"
    return 0
  fi
  for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
    [ -f "$wf" ] || continue
    n=$((n + 1))
    rc=0
    hits="$(release_workflow_writers "$wf" 2>"$err")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      printf 'release: WARNING: could not read %s (exit %s: %s), so whether it also makes the release object was not checked\n' \
        "$wf" "$rc" "$(one_line "$(cat "$err")")"
      unread=$((unread + 1))
      continue
    fi
    while IFS=$'\t' read -r line what; do
      [ -n "$line" ] || continue
      writers=$((writers + 1))
      printf 'release: WARNING: %s:%s %s, and object is local: both would make the\n' "$wf" "$line" "$what"
      printf '         release object. Declare release.object: ci if the workflow makes it,\n'
      printf '         or remove the step.\n'
    done <<<"$hits"
  done
  rm -f "$err"
  if [ "$n" -eq 0 ]; then
    printf 'release: .github/workflows holds no workflow file, so none writes a release object\n'
  elif [ "$writers" -eq 0 ] && [ "$unread" -eq 0 ]; then
    printf 'release: read %s workflow file(s) in .github/workflows, and none writes a release object by a step this check reads: gh or hub release, gh api on releases, the releases API, or a release action it knows\n' "$n"
  else
    printf 'release: read %s of %s workflow file(s) in .github/workflows: %s release-writing step(s), named above%s\n' \
      "$((n - unread))" "$n" "$writers" "$([ "$unread" -eq 0 ] || printf ', and %s that could not be read' "$unread")"
  fi
  return 0
}

# select_notes -- the notes provider this project declares. The library
# never reads config, so the facts it needs are read here and passed in.
select_notes() {
  local kind run
  kind="$(cfg_release_get notes.kind)" || die "release: cannot read release.notes.kind"
  run="$(cfg_release_get notes.run)" || die "release: cannot read release.notes.run"
  notes_select "$kind" "$run" "${DEVBIN_NAME:?}" || die "release: no notes provider (above)"
}

# check_notes -- the notes half of `release check`: the generated views
# match their source, the version this project claims has a note, and
# notes_lint passes that note.
#
# BOTH HALVES WARN AND CARRY ON, so one run names everything wrong; the status
# is 1 if either found anything. A kind that generates no views says so, in
# words that cannot be read as "every view is current" -- zero views compared is
# a fact about the kind, and a count of zero printed as a pass would hide it.
check_notes() {
  local kind compare verdict path n=0 stale=0 rc=0 v state
  kind="$(cfg_release_get notes.kind)" || die "release: cannot read release.notes.kind"
  if compare="$(notes_views_check "$PROJECT_ROOT")"; then
    while read -r verdict path; do
      [ -n "$verdict" ] || continue
      n=$((n + 1))
      case "$verdict" in
        current) ;;
        STALE)
          warn "$path is STALE -- regenerate with: $DEVBIN_INVOKE release notes"
          stale=$((stale + 1))
          ;;
        *)
          # Not reachable through the shipped kinds, which print only the two
          # verdicts; refused here all the same, because an answer this reader
          # does not recognise must never count as current.
          warn "release check: the notes provider answered '$verdict $path', which is neither current nor STALE"
          stale=$((stale + 1))
          ;;
      esac
    done <<<"$compare"
    if [ "$n" -eq 0 ]; then
      printf 'release: notes.kind %s generates no views, so none were compared\n' "$kind"
    else
      printf 'release: %s of %s generated view(s) current\n' "$((n - stale))" "$n"
    fi
    [ "$stale" -eq 0 ] || rc=1
  else
    warn "release check: the generated views could not be compared (above)"
    rc=1
  fi

  v="$(read_version)"
  if ! is_semver "$v"; then
    warn "release check: this project's version reads '$v', which is not X.Y.Z, so its note cannot be looked up"
    rc=1
  elif ! state="$(notes_state "$PROJECT_ROOT" "$v")"; then
    warn "release check: the note for $v could not be read (above)"
    rc=1
  elif [ "$state" = absent ]; then
    warn "this project's version is $v and there is no $(notes_where "$v") -- the notes describe a version it no longer claims to be"
    rc=1
  else
    printf 'release: the note for %s is %s\n' "$v" "$state"
    notes_lint "$PROJECT_ROOT" "$v" || rc=1
  fi
  return "$rc"
}

# write_notes -- `release notes`: regenerate the generated views.
write_notes() {
  local written path n=0
  written="$(notes_views "$PROJECT_ROOT")" || die "release notes: the views were not regenerated (above)"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    printf 'release: wrote %s\n' "$path"
    n=$((n + 1))
  done <<<"$written"
  if [ "$n" -eq 0 ]; then
    printf 'release: notes.kind %s generates no views, so nothing was written\n' "$(cfg_release_get notes.kind)"
  fi
  return 0
}

# open_scratch <who> -- the run's ONE scratch root, outside the project, and the
# ONE trap that removes it (WP-04). Every commit the run materialises is written
# into a directory of its own under the root, with its index beside that
# directory, so an interrupt at any point leaves nothing behind: until WP-04
# the tree WAS the root and the index its sibling, which the trap missed.
# Opened in this shell, never in a `$(...)`, because a trap
# set in a subshell is gone when the subshell is.
SCRATCH=""
open_scratch() {
  [ -z "$SCRATCH" ] || return 0
  SCRATCH="$(release_scratch "$PROJECT_ROOT")" || die "$1: no scratch directory to read a commit in (above)"
  # shellcheck disable=SC2064 # expand now: the path is fixed, and a later
  # reassignment must not change what is removed.
  trap "rm -rf '$SCRATCH'" EXIT
}

# materialise <name> <commit> <version> -- <commit>'s whole tree, written into
# $SCRATCH/<name>, checked for every path the release owns. The reason is on
# stderr when it cannot be. open_scratch first.
materialise() {
  local owned
  local -a paths=()
  owned="$(release_owned "$PROJECT_ROOT" "$3")" || return 1
  mapfile -t paths <<<"$owned"
  release_materialise "$2" "$SCRATCH/$1" "${paths[@]}"
}

# ---------------------------------------------------------------------------
# THE CUT, THE STEPS FROM RESOLVE TO GATES (WP-04)
#
# Each step reads its postcondition first, so a re-run of the same target
# continues, and each step's row is one of the cut's states: `done`, `already`,
# `skipped`, `not re-run`, `FAILED`, or under --dry-run `would`. The rows are
# collected and printed as one table when the run stops, through release_row,
# the renderer `release status` prints through: the summary of a run and the
# map of where it got to are the same table. A step's own output (a gate's, a
# commit hook's) is printed as it happens, above that table.
#
# A FAILED STEP STOPS THE RUN, exit 1, and its row names what failed. The steps from
# resolve to gates are local and reversible, and nothing irreversible runs before
# them, so a stop leaves nothing another
# machine has seen, and the remedy is forward: fix it and run the same target.
#
# PAST THE PUSH THE RULE CHANGES. The object step under `object: ci` fails as any step
# does, since a re-run continues it. The after and ci steps run on a published
# release: a failed `after:` or a CI verdict that is not green is
# reported, undoes nothing, and ends the cut at exit 1 with the remedy, which
# is forward -- the next release, never a moved tag.
# ---------------------------------------------------------------------------

CUT_ROWS=()
CUT_HEAD=""
CUT_UNREACHED=()
CUT_OUTWARD=""

cut_row() { CUT_ROWS+=("$(release_row "$1" "$2" "$3")"); }

cut_summary() {
  printf '\n%s\n' "$CUT_HEAD"
  printf '%s\n' "${CUT_ROWS[@]}"
}

# cut_back_to_brew <tag> <version> <commit> -- a released cut's last line, for
# a project that publishes a Homebrew formula (issue 0228): the steps that put
# the maintainer back on the install the release made, since the switch rests
# at brew (docs/dev-opt-brew.md, T5).
#
# A NOTE, NEVER AN ACTION. The core runs no brew and points no link: `use` is
# the one verb that points links, and a change to the machine is the person's
# to make. A project publishes a formula when its `formula` command is active
# (command_active, the one rule): the built-in enabled, or the project's own
# handler or run:. The formula's name is cfg_formula_name's, the one
# derivation the built-in reads too. A project with no formula gets no line,
# since brew has nothing of it to upgrade. A cut whose after: failed or whose
# CI is not green gets none either: its last line stays the remedy (0181), and
# the tap may not have the release, or should not be taken from.
cut_back_to_brew() {
  local name
  command_active formula || return 0
  if ! name="$(cfg_formula_name)" || [ -z "$name" ]; then
    printf 'release: NOTE: the switch rests at brew -- once the tap has %s, upgrade it with brew and run use brew (the formula'"'"'s name could not be read: formula.name, or project.name)\n' "$1"
    return 0
  fi
  printf 'release: NOTE: the switch rests at brew -- once the tap has %s: brew upgrade %s, then %s use brew, and %s --version reads %s %s (brew, %s)\n' \
    "$1" "$name" "$name" "$name" "$name" "$2" "${3:0:12}"
}

# cut_fail <n> <detail> -- step <n> FAILED: its row, the table so far, and what
# this run did that another machine can see, then exit 1.
#
# EXIT 1 WHEN NOBODY COULD BE ASKED, TOO (issue 0130). The confirm step passed 2 here, as
# ST0007's AC-5.3 asked, so that "declined" and "could not ask" were different
# codes -- and 2 is the dispatcher's code for an unknown or inactive command, so
# a script running `release` without `--yes` read the same code as one running
# it where `release` is not enabled. A new refusal takes a new code, never a
# spare one, and this is not a new refusal: fullcycle and clean already exit 1
# when nobody is there to ask. The row's detail carries the difference: only a
# person at a terminal can decline.
cut_fail() {
  cut_row "$1" FAILED "$2"
  cut_summary
  printf '\nrelease: stopped at the %s step. %s. Fix what the row names, then run again.\n' \
    "$1" "$(cut_outward)"
  exit 1
}

# cut_outward -- what this run has done that is not local and reversible, as a
# sentence: EVERY such act, in order, or that there was none. Every act, not
# the last: a run that pushed to two remotes and then failed must name both.
cut_outward() {
  if [ -n "$CUT_OUTWARD" ]; then
    printf 'This run %s' "${CUT_OUTWARD#, }"
  else
    printf 'This run tagged nothing and pushed nothing'
  fi
}

# cut_call <step> <what> <cmd>... -- one write to another machine (a push, a
# gh create or edit), bounded at RELEASE_CALL_SECONDS (release_run_bounded),
# its output shown as it was when it ran unbounded. A failure or a hang fails
# <step>, naming <what>; a hang also says the effect is unknown, since a push
# cut off mid-flight may or may not have landed, and `release status` reads it.
cut_call() {
  local step="$1" what="$2" rc=0
  shift 2
  release_run_bounded "$RELEASE_CALL_SECONDS" "$SCRATCH/call.out" "$SCRATCH/call.err" "$@" || rc=$?
  cat "$SCRATCH/call.out" "$SCRATCH/call.err"
  case "$rc" in
    0) return 0 ;;
    124) cut_fail "$step" "$what did not finish within ${RELEASE_CALL_SECONDS}s and was stopped -- whether it took effect is unknown; release status reads it" ;;
    *) cut_fail "$step" "$what failed (exit $rc, above)" ;;
  esac
}

# one_line <text> -- the text on one line, for a row's detail.
one_line() { printf '%s' "${1//$'\n'/ }"; }

# cut_remotes -- the remotes a release pushes to: the declared list, else every
# remote git lists.
cut_remotes() {
  if cfg_release_declared remotes; then
    cfg_release_list remotes
  else
    git remote
  fi
}

# declared_remote -- the first declared `remotes` entry, or nothing when none is
# declared: release_repo's second argument.
declared_remote() {
  local r=""
  if cfg_release_declared remotes; then
    IFS= read -r r <<<"$(cfg_release_list remotes)"
  fi
  printf '%s\n' "$r"
}

# object_title <tag> <version> -- the release object's title: `title:`, with
# {tag} and {version} filled in. One home, read by a cut's confirm step and by status.
object_title() {
  local title
  title="$(cfg_release_get title)"
  title="${title//\{tag\}/$1}"
  printf '%s\n' "${title//\{version\}/$2}"
}

# cut_gh_signed_in <object> -- pre-flight's gh half: gh is there,
# the repository resolves, and gh is signed in to its host. Prints the refusal
# and returns 1; `object: none` never needs gh.
cut_gh_signed_in() {
  local repo host out
  case "$1" in local | ci) ;; *) return 0 ;; esac
  if ! command -v gh >/dev/null 2>&1; then
    printf 'gh is not installed, and object: %s needs it' "$1"
    return 1
  fi
  if ! repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
    one_line "$repo"
    return 1
  fi
  host=github.com
  [[ "$repo" != */*/* ]] || host="${repo%%/*}"
  if ! out="$(release_gh "" auth status --hostname "$host" 2>&1)"; then
    printf 'gh is not signed in to %s: %s' "$host" "$(one_line "$out")"
    return 1
  fi
}

# cut_notes_body <commit> <version> <file> <step> -- the notes body, read from
# the release commit's own tree (materialised once, as `rel`) into <file>: the
# tag's message and the release object's notes. A failure is <step>'s.
cut_notes_body() {
  local out
  if [ ! -d "$SCRATCH/rel" ]; then
    out="$(materialise rel "$1" "$2" 2>&1)" ||
      cut_fail "$4" "the release commit could not be materialised: $(one_line "$out")"
  fi
  notes_body "$SCRATCH/rel" "$2" >"$3" 2>"$3.err" ||
    cut_fail "$4" "the notes body could not be read: $(one_line "$(cat "$3.err")")"
}

# cut_stamp_read <name> <commit> <version> <views> -- the stamp step's postcondition
# read against <commit>'s own tree, materialised as $SCRATCH/<name>.
cut_stamp_read() {
  local why
  if ! why="$(materialise "$1" "$2" "$3" 2>&1)"; then
    printf 'UNREADABLE\t%s\n' "$(one_line "$why")"
    return 0
  fi
  release_read_stamp "$SCRATCH/$1" "$3" "$4"
}

# cut_run -- a cut of $target: the steps from resolve to ci. With --dry-run, the same reads
# and gates with every write, every wait and every after: reported as `would`,
# and a verdict as the last line when no step failed.
cut_run() {
  local tpl branch object today launcher line v tag how rc_line commit source
  local state detail remotes remote answer nremote=0 owned dirt outside="" deferred=""
  local derived gates out written="" have n ignored_rc ignored_why assets_wf
  local -a refusals=()

  # THE TAG REACHES ci.query ALONE (issue 0149): one exported from outside,
  # to try a query by hand, would reach every gate and after: command, and a
  # gate exercising the query would read a stale tag.
  unset DEVBIN_RELEASE_TAG
  cfg_validate || die "release: $DEVBIN_DIR/config.yaml does not validate (above)"
  select_notes
  tpl="$(cfg_release_get tag)"
  branch="$(cfg_release_get branch)"
  object="$(cfg_release_get object)"
  derived="$(cfg_release_list derived)"
  gates="$(cfg_release_list gates)"
  # Read with its status: empty would turn the attach off in silence.
  assets_wf="$(cfg_release_get assets.workflow)" || die "release: cannot read release.assets.workflow"
  # A PUBLISHING CUT (issue 0240) stops after its push: the public repository
  # takes the snapshot, through release publish, and never the workroom.
  local publish_url named rc
  publish_url="$(cfg_release_get publish.url)" || die "release: cannot read release.publish.url"
  # ONE READ OF THE CLOCK, so the release carries one date (notes_date's rule).
  # The person's local date: the day they released on.
  today="$(date +%F)"
  launcher="$PROJECT_ROOT/bin/devbin"
  [ -x "$launcher" ] || die "release: no launcher at $launcher -- the cut runs this project's own verbs through it"
  open_scratch release
  local dry_note=""
  [ "$dry_run" = 0 ] || dry_note=" (DRY RUN: no commit, tag, push or release object; the gates run)"
  CUT_HEAD="release: $target$dry_note"

  # --- resolve -----------------------------------------------------
  if ! line="$(release_resolve "$tpl" "$target" 2>&1)"; then
    cut_fail resolve "$(one_line "$line")"
  fi
  IFS=$'\t' read -r v tag how <<<"$line"
  if ! rc_line="$(release_commit "$tag" 2>&1)"; then
    cut_fail resolve "$(one_line "$rc_line")"
  fi
  commit="${rc_line%%$'\t'*}"
  source="${rc_line#*$'\t'}"
  # THE HEADER NAMES THE COMMAND THAT RELEASES FOR REAL (0181): a cut that
  # stops is resumed with it, and after a dry run it is the cut. "resume with"
  # after a dry run that had passed read as though a cut had stopped.
  local next="resume with"
  [ "$dry_run" = 0 ] || next="cut with"
  CUT_HEAD="release: $tag$dry_note -- $next: ${DEVBIN_INVOKE:-bin/devbin} release v$v"
  if [ "$how" = resume ]; then
    cut_row resolve "done" "$tag exists, at ${commit:0:12}: resuming it"
  else
    cut_row resolve "done" "$v from $target, tag $tag, new"
  fi

  # --- pre-flight --------------------------------------------------
  # Every check runs and every refusal is named, so one run says everything
  # that is wrong; nothing here writes.
  line="$(git symbolic-ref -q --short HEAD)" || line=""
  [ "$line" = "$branch" ] || refusals+=("not on $branch: HEAD is ${line:-detached}")

  # THE COMMIT STEP'S POSTCONDITION, READ ONCE HERE AND USED AT THE STAMP AND COMMIT STEPS: whether
  # HEAD is already the release commit (it carries the stamp and the tree is
  # clean). That one answer decides what a remote that has moved past HEAD
  # means (release_read_remote, preflight-new), whether the stamp step runs, and
  # whether the commit step commits. So a cut never commits on HEAD under `preflight`:
  # the mode and the commit are the same answer.
  local mode=preflight head_read="" head_is_release=no
  if [ "$source" = HEAD ]; then
    head_read="$(cut_stamp_read head "$commit" "$v" count)"
    if [ "${head_read%%$'\t'*}" = already ] && [ "$(release_read_clean | cut -f1)" = already ]; then
      head_is_release=yes
    else
      mode=preflight-new
    fi
  fi

  if ! remotes="$(cut_remotes 2>&1)"; then
    refusals+=("cannot list the remotes: $(one_line "$remotes")")
    remotes=""
  elif [ -z "$remotes" ]; then
    refusals+=("this repository has no remote to push to")
  fi
  while IFS= read -r remote <&3; do
    [ -n "$remote" ] || continue
    nremote=$((nremote + 1))
    if ! git remote get-url "$remote" >/dev/null 2>&1; then
      # Named through release_url_shown: an entry can be a url, and a url can
      # carry a token (issue 0189).
      refusals+=("remote $(release_url_shown "$remote") is declared and does not exist")
      continue
    fi
    # A PUBLISHING CUT NEVER PUSHES TO THE PUBLIC REPOSITORY (issue 0240): a
    # cut pushes the workroom, its whole history, so a remote it pushes to that
    # names the repository release.publish.url names, by OWNER/NAME on any host
    # or as the same path, is refused, as the snapshot and the publish flow
    # refuse one, and so is one whose url says too little to tell.
    if [ -n "$publish_url" ]; then
      rc=0
      named="$(release_remote_naming "$publish_url" "$remote" 3<&-)" || rc=$?
      case "$rc" in
        0)
          refusals+=("remote $remote names ${named#*$'\t'}, the repository release.publish.url names, and a cut pushes this workroom, its whole history, to every remote it pushes to -- the public repository takes the snapshot alone, through release publish: leave $remote out of release.remotes")
          continue
          ;;
        1) ;;
        *)
          refusals+=("whether remote $remote names the repository release.publish.url names cannot be told: $named -- a cut never pushes the workroom where that is not known")
          continue
          ;;
      esac
    fi
    answer="$(release_read_remote "$remote" "$branch" "$tag" "$commit" "$mode" 3<&-)"
    case "${answer%%$'\t'*}" in
      already | pending) ;;
      *) refusals+=("${answer#*$'\t'}") ;;
    esac
  done 3<<<"$remotes"

  if [ "$source" = HEAD ]; then
    # THE TREE RULE, while the tag is absent: dirt inside the owned
    # set belongs in the release commit, whoever wrote it; dirt outside it is
    # refused, untracked files included. A `derived:` path is owned too, and
    # only running the command says which paths those are, so with `derived:`
    # declared the rest is checked at the stamp step, after they run.
    if ! owned="$(release_owned "$PROJECT_ROOT" "$v" 2>&1)"; then
      refusals+=("the paths this release owns cannot be listed: $(one_line "$owned")")
    elif ! dirt="$(release_dirt 2>&1)"; then
      refusals+=("git status failed: $(one_line "$dirt")")
    else
      outside="$(release_outside "$dirt" "$owned")"
      if [ -n "$outside" ] && [ -n "$derived" ]; then
        deferred="$outside"
      elif [ -n "$outside" ]; then
        refusals+=("dirty outside what this release owns: ${outside//$'\n'/, } -- commit or stash it first")
      fi
    fi
    if ! out="$(notes_check "$PROJECT_ROOT" "$v" "$today" 2>&1)"; then
      refusals+=("$(one_line "$out")")
    fi
    # THE VERSION FILE MUST READ BEFORE A CUT STAMPS IT (issue 0259). The stamp
    # step runs `version set`, which starts a missing VERSION: inside a cut that
    # is a side effect, a release commit holding a version file the project
    # never kept, while the file that does hold its version, a mix.exs that
    # project.version_from was never pointed at, say, stays stale. So a version
    # that does not read is refused here, in version_unread's words, before
    # anything is written.
    local unread
    if unread="$(version_unread why)"; then
      refusals+=("the version cannot be read: $unread -- $(version_unread fix)")
    fi
    # THE RUN LOGS MUST BE IGNORED. A cut runs behind its own gate, and its gates
    # are devbin verbs behind theirs, so every one writes a log under
    # $(gate_out_dir <name>) for the whole of its run. Not ignored, each is dirt:
    # the tree rule would refuse the cut's own log, and the gates step's re-read would
    # see every gate change the tree. Each such directory ignores itself (issue
    # 0157), so this refuses only where it will not -- a .gitignore the project
    # put there, a tmp/ that leads outside the tree -- and asks the writer's own
    # rule, without writing, so a dry run and the cut agree. Where git could not
    # say, it says that, and never offers the remedy (issue 0186).
    ignored_rc=0
    ignored_why="$(gate_out_ignored "$(gate_out_dir release)")" || ignored_rc=$?
    case "$ignored_rc" in
      0) ;;
      2) refusals+=("git could not say whether $(gate_out_dir release)/ is ignored${ignored_why:+ -- $ignored_why}") ;;
      *) refusals+=("$(gate_out_dir release)/ is not ignored, and every gated run writes its log there -- add tmp/ to .gitignore") ;;
    esac
  else
    # A TAG FOR THE TARGET MUST CARRY THE RELEASE, or it is refused and never
    # moved or deleted (AC-4.5): its commit's VERSION is the target and its note
    # is dated for it, read from the tagged commit's own tree.
    answer="$(cut_stamp_read tag "$commit" "$v" name)"
    case "${answer%%$'\t'*}" in
      already) ;;
      *) refusals+=("$tag exists and its commit (${commit:0:12}) does not carry the release: ${answer#*$'\t'} -- a tag is never moved or deleted; release a later version") ;;
    esac
  fi

  if ! out="$(cut_gh_signed_in "$object")"; then
    refusals+=("$out")
  fi

  # THE ASSETS' WORKFLOW IS IN THE RELEASE COMMIT (ST0008 WP-08): a run at the
  # tag runs the workflow the tag's commit holds, and the commit step commits nothing
  # under .github. A name that names none would be found only at the object step, with
  # the release public, at the end of assets.wait.
  if [ -n "$assets_wf" ] && ! git cat-file -e "$commit:.github/workflows/$assets_wf" 2>/dev/null; then
    refusals+=("release.assets.workflow is $assets_wf, and ${commit:0:12} holds no .github/workflows/$assets_wf, so no run at the tag could build the assets")
  fi

  # CI GREEN ON THE BASE BEFORE THE CUT (issue 0223, release.ci.base): the
  # suite and the gates run on the maintainer's machine, so a defect only
  # another platform shows was found by CI after the tag, more than once. With
  # ci.base on, ci.query is asked once about the base, the commit the
  # release commit is made on, and anything but green refuses the cut here,
  # before any stamp, commit or gate. The base is HEAD, or, once HEAD is the
  # release commit, the commit before it, which stands for the release commit
  # only while that changes nothing outside what the release owns. Asked with
  # no tag, so the query reads the branch's runs; asked once, never waited on:
  # a run still going refuses, and the remedy is to wait for it. Once the tag
  # exists the cut is past every step this guards.
  local base_detail=""
  if [ "$source" = HEAD ] && is_true_word "$(cfg_release_get ci.base)"; then
    local base="$commit" base_note="" changed ci_secs remedy
    local -a bq=()
    remedy="ci.base needs CI green on the commit a cut starts from: push $branch, wait for CI green on it, then cut"
    if [ "$head_is_release" = yes ]; then
      if ! base="$(git rev-parse -q --verify "$commit^1")"; then
        refusals+=("the release commit ${commit:0:12} has no parent, so no CI run can stand for it (ci.base)")
        base=""
      elif ! changed="$(git diff --name-only -z --no-renames "$base" "$commit" | tr '\0' '\n')"; then
        refusals+=("git could not list what the release commit ${commit:0:12} changes (ci.base)")
        base=""
      else
        outside="$(release_outside "$changed" "$owned")"
        if [ -n "$outside" ]; then
          refusals+=("the release commit ${commit:0:12} changes ${outside//$'\n'/, }, outside what this release owns, so CI on the commit before it does not stand for it (ci.base)$([ -z "$derived" ] || printf -- ' -- a derived: path is owned too, and only running derived: says which, which a cut resumed on its release commit does not')")
          base=""
        else
          base_note=", which the release commit ${commit:0:12} changes only in what this release owns"
        fi
      fi
    fi
    if [ -n "$base" ]; then
      if ! run_words bq release.ci.query "$(cfg_release_get ci.query)" 2>/dev/null; then
        refusals+=("ci.query holds no words, so CI on the base cannot be asked (ci.base)")
      elif ! ci_secs="$(release_seconds "$(cfg_release_get ci.wait)" 2>&1)"; then
        refusals+=("$(one_line "$ci_secs")")
      else
        answer="$(release_wait "$ci_secs" "" unknown release_ci_verdict "$base" "" "${bq[@]}")"
        case "${answer%%$'\t'*}" in
          green) base_detail="; CI is green on the base commit ${base:0:12}$base_note: ${answer#*$'\t'}" ;;
          # STILL GOING IS NOT A FAILURE, and the refusal says so: the remedy
          # is to wait for the run and cut again.
          pending) refusals+=("CI is still running on the base commit ${base:0:12}: ${answer#*$'\t'} -- wait for it to finish, then cut again (ci.base needs it green)") ;;
          unknown) refusals+=("no verdict from ci.query for the base commit ${base:0:12}: ${answer#*$'\t'} -- $remedy") ;;
          *) refusals+=("ci.query answers ${answer%%$'\t'*} for the base commit ${base:0:12}: ${answer#*$'\t'} -- $remedy") ;;
        esac
      fi
    fi
  fi

  if [ "${#refusals[@]}" -gt 0 ]; then
    cut_fail pre-flight "$(printf '%s; ' "${refusals[@]}" | sed 's/; $//')"
  fi
  cut_row pre-flight "done" "on $branch; $nremote remote(s) can take the push; $([ "$source" = HEAD ] && printf 'the tree and the note are ready' || printf '%s carries the release' "$tag")$base_detail"
  if [ -n "$deferred" ] && [ "$dry_run" = 1 ]; then
    CUT_UNREACHED+=("the stamp step checks ${deferred//$'\n'/, } against what derived: writes, after it runs")
  fi

  # --- stamp -------------------------------------------------------
  if [ "$source" = tag ]; then
    cut_row stamp already "$tag's commit carries it (read at pre-flight)"
  elif [ "$head_is_release" = yes ]; then
    # THE RELEASE COMMIT EXISTS, so derived: is not re-run: its output need not
    # be byte-stable, and a second run of it would make a second release commit
    # on top of one a remote may already carry.
    cut_row stamp already "${commit:0:12} carries the stamp and the tree is clean (read at pre-flight); derived: is not re-run"
  else
    answer="$(release_read_stamp "$PROJECT_ROOT" "$v" count)"
    state="${answer%%$'\t'*}"
    detail="${answer#*$'\t'}"
    if [ "$state" = UNREADABLE ]; then
      cut_fail stamp "$detail"
    elif [ "$state" = already ] && [ -z "$derived" ]; then
      cut_row stamp already "$detail"
    elif [ "$dry_run" = 1 ]; then
      have="$(read_version)"
      cut_row stamp would "$([ "$have" = "$v" ] || printf 'version set %s (it is %s); ' "$v" "$have")$([ -z "$derived" ] || printf 'run derived: (%s command(s)); ' "$(grep -c . <<<"$derived")")date the note $today; regenerate the views"
      [ -z "$derived" ] || CUT_UNREACHED+=("the stamp step's owned-set check of what derived: writes: a dry run does not run derived: commands")
    else
      have="$(read_version)"
      if [ "$have" != "$v" ]; then
        gate_exec "$launcher" version set "$v" || cut_fail stamp "version set $v failed (exit $?, above)"
      fi
      local d
      local -a words=()
      while IFS= read -r d <&3; do
        [ -n "$d" ] || continue
        run_words words release.derived "$d" 2>/dev/null || cut_fail stamp "the derived: command '$d' holds no words"
        out="$("${words[@]}" 3<&-)" || cut_fail stamp "the derived: command '$d' failed (exit $?)"
        written+="$out"$'\n'
      done 3<<<"$derived"
      if ! out="$(notes_date "$PROJECT_ROOT" "$v" "$today" 2>&1)"; then
        cut_fail stamp "dating the note failed: $(one_line "$out")"
      fi
      if ! out="$(notes_views "$PROJECT_ROOT" 2>&1)"; then
        cut_fail stamp "regenerating the views failed: $(one_line "$out")"
      fi
      # The owned set is now whole: what was known, plus what derived: wrote.
      local w norm=""
      while IFS= read -r w; do
        [ -z "$w" ] || norm+="${w#"$PROJECT_ROOT"/}"$'\n'
      done <<<"$written"
      written="$norm"
      if ! dirt="$(release_dirt 2>&1)"; then
        cut_fail stamp "git status failed: $(one_line "$dirt")"
      fi
      outside="$(release_outside "$dirt" "$owned"$'\n'"$written")"
      [ -z "$outside" ] || cut_fail stamp "dirty outside what this release owns: ${outside//$'\n'/, } -- commit or stash it first"
      # The postcondition, read again: a write that did not take is a failure,
      # never a `done`. NO ARM REACHES IT: version set and notes_date each read
      # their own write back, so a mutant dropping this lives. It is kept
      # because it is one read, and it holds for a writer that does not.
      answer="$(release_read_stamp "$PROJECT_ROOT" "$v" count)"
      [ "${answer%%$'\t'*}" = already ] || cut_fail stamp "the stamp did not take: ${answer#*$'\t'}"
      cut_row stamp "done" "${answer#*$'\t'}$([ -z "$derived" ] || printf '; derived: ran')"
    fi
  fi

  # --- commit ------------------------------------------------------
  local release_made=yes
  if [ "$source" = tag ]; then
    cut_row commit already "${commit:0:12}, $tag's commit, is the release commit"
  else
    answer="$head_read"
    state="${answer%%$'\t'*}"
    if [ "$head_is_release" = yes ]; then
      cut_row commit already "${commit:0:12} carries the stamp and the tree is clean"
    elif [ "$state" = UNREADABLE ]; then
      cut_fail commit "${answer#*$'\t'}"
    elif [ "$dry_run" = 1 ]; then
      cut_row commit would "commit the stamp as \"release: $tag\""
      release_made=no
    else
      dirt="$(release_dirt)" || cut_fail commit "git status failed"
      [ -n "$dirt" ] || cut_fail commit "${commit:0:12} does not carry the stamp, and there is nothing to commit: ${answer#*$'\t'}"
      local -a paths=()
      mapfile -t paths <<<"$dirt"
      git add -- "${paths[@]}" || cut_fail commit "git add failed (exit $?)"
      # `--only` is EQUIVALENT here and no arm can tell it gone:
      # pre-flight and the stamp step refuse any dirt outside the owned
      # set, staged included, so the index holds nothing these paths do not.
      # Kept so the commit stays exactly these paths if that rule ever moves.
      git commit -q --only -m "release: $tag" -- "${paths[@]}" </dev/null ||
        cut_fail commit "git commit failed (exit $?, above)"
      commit="$(git rev-parse HEAD)"
      # Read again on the new HEAD. NO ARM REACHES IT: the stamp step left the stamp in
      # the tree and every dirty path is in this commit, so a mutant dropping it
      # lives. Kept as the guard that a commit hook rewriting the
      # commit, or a commit of the wrong paths, is FAILED rather than done.
      answer="$(cut_stamp_read commit "$commit" "$v" count)"
      [ "${answer%%$'\t'*}" = already ] || cut_fail commit "${commit:0:12} does not carry the stamp: ${answer#*$'\t'}"
      [ "$(release_read_clean | cut -f1)" = already ] || cut_fail commit "the tree is not clean after the commit: $(release_read_clean | cut -f2-)"
      cut_row commit "done" "${commit:0:12} \"release: $tag\", ${#paths[@]} path(s)"
    fi
  fi

  # WHERE THE COMMIT STEP READS `would`, THERE IS NO RELEASE COMMIT YET (0181), and
  # `commit` is still HEAD, which the cut never tags: its commit step makes a new
  # commit on HEAD. So the confirm, tag and ci rows name the commit the commit step makes, never
  # HEAD's sha, and the confirm step reads every remote as lacking it (push-new), as the
  # cut's own read does once the commit step has made it: a remote at HEAD is sent the
  # commit as well as the tag. The gates row names HEAD, which is what the gates ran on.
  local rel_at="${commit:0:12}" push_mode=push
  if [ "$release_made" = no ]; then
    rel_at="the release commit the commit step makes"
    push_mode=push-new
  fi

  # --- gates -------------------------------------------------------
  # In place, on the release commit, and checked rather than trusted:
  # the tree is read before and after, and a path any gate changed or created
  # fails the step. Never `already`: the gates leave no postcondition the
  # repository can show.
  if [ -z "$gates" ]; then
    cut_row gates skipped "no gates: declared"
  elif [ "$source" = tag ]; then
    cut_row gates "not re-run" "the tag exists, so the gates are not re-run -- this says nothing about a verdict"
  else
    local gate before after changed head_before head_after
    local -a gw=()
    before="$(release_tree_state)" || cut_fail gates "the tree could not be read before the gates"
    head_before="$(git rev-parse HEAD)" || cut_fail gates "HEAD could not be read before the gates"
    n=0
    while IFS= read -r gate <&3; do
      [ -n "$gate" ] || continue
      run_words gw release.gates "$gate" 2>/dev/null || cut_fail gates "the gate '$gate' holds no words"
      printf '\nrelease: gate: %s %s\n' "${DEVBIN_INVOKE:-bin/devbin}" "$gate"
      "$launcher" "${gw[@]}" 3<&- || cut_fail gates "gate '$gate' failed (exit $?)"
      n=$((n + 1))
    done 3<<<"$gates"
    after="$(release_tree_state)" || cut_fail gates "the tree could not be read after the gates"
    changed="$(release_tree_changed "$before" "$after")"
    [ -z "$changed" ] || cut_fail gates "a gate changed the tree: ${changed//$'\n'/, } -- the gates examine the release commit and must not write to it"
    # A GATE THAT COMMITS leaves the tree clean and HEAD somewhere else, so the
    # tree's re-read cannot see it: HEAD is read too (found by WP-05's mutants).
    head_after="$(git rev-parse HEAD)" || cut_fail gates "HEAD could not be read after the gates"
    [ "$head_after" = "$head_before" ] ||
      cut_fail gates "a gate moved HEAD from ${head_before:0:12} to ${head_after:0:12} -- the gates examine the release commit and must not commit"
    if [ "$dry_run" = 1 ]; then
      cut_row gates "done" "$n gate(s) passed on HEAD ${commit:0:12} in place -- a dry run makes no release commit, so this predicts the gates rather than gating the release"
    else
      cut_row gates "done" "$n gate(s) passed on ${commit:0:12}, and none wrote to the tree"
    fi
  fi

  # --- confirm ------------------------------------------------------
  # What is left that another machine will see: each remote still to receive
  # the commit or the tag, and under `object: local` the release object. Read
  # through the same readers `release status` reads the confirm step from, so the two
  # cannot disagree about whether anything is left.
  local -a left=() push_plan=()
  local object_work="" object_detail="" title repo="" declared_repo drem
  local attach_work=no assets_detail=""
  declared_repo="$(cfg_release_get repo)"
  drem="$(declared_remote)"
  while IFS= read -r remote <&3; do
    [ -n "$remote" ] || continue
    answer="$(release_read_remote "$remote" "$branch" "$tag" "$commit" "$push_mode" 3<&-)"
    case "${answer%%$'\t'*}" in
      already) ;;
      pending)
        push_plan+=("$remote ${answer#*$'\t'}")
        left+=("push ${answer#*$'\t'} to $remote")
        ;;
      *) cut_fail confirm "${answer#*$'\t'}" ;;
    esac
  done 3<<<"$remotes"
  title="$(object_title "$tag" "$v")"
  local body_file="$SCRATCH/notes-body"
  # A PUBLISHING CUT'S RELEASE OBJECT IS release publish's (issue 0240), made on
  # the public repository once the snapshot is there, so it is no work of this
  # cut's, and the cut does not ask about it.
  if [ "$object" = local ] && [ -z "$publish_url" ]; then
    cut_object_left
  fi
  [ "$how" = resume ] || left=("tag $tag at $rel_at" "${left[@]}")

  # Set by cut_confirm, read by the steps after it.
  local confirmed=no ask_next="" prompted=""
  cut_confirm "the cut" "release: $tag, release commit ${commit:0:12}"

  # --- tag ----------------------------------------------------------
  # Annotated, at the release commit's SHA and never HEAD, its message the notes
  # body read from the release commit's own tree. A tag found is reused
  # and reported, never rewritten (release_read_tag).
  cut_notes_body "$commit" "$v" "$body_file" tag
  if [ "$how" = resume ]; then
    answer="$(release_read_tag "$tag" "$SCRATCH/rel" "$v")"
    cut_row tag already "${answer#*$'\t'}"
  elif [ "$dry_run" = 1 ]; then
    cut_row tag would "annotated tag $tag at $rel_at, its message the notes body"
  else
    # At the release commit's SHA, never HEAD. NO ARM REACHES THE
    # DIFFERENCE: the gates step fails a gate that moves HEAD, so HEAD is the release
    # commit here unless someone commits while the confirm step waits for its answer.
    git tag -a "$tag" "$commit" -F "$body_file" --cleanup=whitespace </dev/null ||
      cut_fail tag "git tag failed (exit $?, above)"
    CUT_OUTWARD+=", tagged $tag locally"
    # Read back by its FIELDS: the status is `already` and the reuse note is
    # empty, never a match on the detail's wording.
    answer="$(release_read_tag "$tag" "$SCRATCH/rel" "$v")"
    [ "${answer%%$'\t'*}" = already ] && [ -z "$(release_tag_reuse_note "$tag" "$SCRATCH/rel" "$v")" ] ||
      cut_fail tag "the tag was made and does not read back as made: ${answer#*$'\t'}"
    cut_row tag "done" "annotated $tag at ${commit:0:12}, its message the notes body"
  fi

  # --- push ---------------------------------------------------------
  # Per remote, in order: the RELEASE COMMIT to its branch (never HEAD, which
  # may have moved on), then the tag -- each only if the remote lacks it, so a
  # branch that has moved past the release commit is never pushed at.
  #
  # NEVER --force, ON EITHER PUSH. Both are fast-forwards when the confirm step
  # read the remote, so a forced push reads the same to every arm -- and when
  # the remote has moved since that read, a rejected push is the remote saying
  # someone else's work is there. Forcing it would overwrite that work. A
  # rejection stops the push step, naming what this run already sent (cut_outward).
  local plan r halves pushed=""
  if [ "${#push_plan[@]}" -eq 0 ]; then
    cut_row push already "every remote holds the release commit on $branch and $tag"
  elif [ "$dry_run" = 1 ]; then
    cut_row push would "$(printf '%s; ' "${push_plan[@]}" | sed 's/; $//')"
  else
    for plan in "${push_plan[@]}"; do
      r="${plan%% *}"
      halves=" ${plan#* } "
      if [[ "$halves" == *" commit "* ]]; then
        # The release commit, never HEAD: the same declaration as the tag step's. No
        # --force (above).
        cut_call push "pushing the release commit to $r's $branch" \
          release_git_remote push -q "$r" "$commit:refs/heads/$branch"
        CUT_OUTWARD+=", pushed $branch to $r"
      fi
      if [[ "$halves" == *" tag "* ]]; then
        # No --force (above): a tag the remote already has differently is not
        # this run's to replace (a tag is never moved).
        cut_call push "pushing $tag to $r" \
          release_git_remote push -q "$r" "refs/tags/$tag:refs/tags/$tag"
        CUT_OUTWARD+=", pushed $tag to $r"
      fi
      # READ BACK THROUGH A READ THAT DID NOT ANSWER (issue 0194): an
      # UNANSWERED read, and an ask cut off at its bound, is asked again up to
      # RELEASE_READBACK_SECONDS. What it ends as, and an UNREADABLE the remote
      # did answer, fails as a read that could not tell, never as the remote
      # lacking the release; a remote that answered without it fails at once.
      answer="$(release_wait "$RELEASE_READBACK_SECONDS" UNANSWERED UNANSWERED \
        release_read_remote "$r" "$branch" "$tag" "$commit" readback)"
      case "${answer%%$'\t'*}" in
        already) ;;
        UNANSWERED) cut_fail push "could not read back whether $r holds the release after the push, in the ${RELEASE_READBACK_SECONDS}s a read-back waits: ${answer#*$'\t'}" ;;
        UNREADABLE) cut_fail push "could not read back whether $r holds the release after the push: ${answer#*$'\t'}" ;;
        *) cut_fail push "$r does not hold the release after the push: ${answer#*$'\t'}" ;;
      esac
      pushed+=", $r (${plan#* })"
    done
    cut_row push "done" "pushed to ${pushed#, }"
  fi

  # --- snapshot, candidate, publish ----------------------------------
  # release publish's steps (issue 0240). A project that declares
  # release.publish.url makes its tag's snapshot public through CI once this
  # cut has pushed, so its cut stops here; one that does not publishes no
  # snapshot, and its cut goes on as it always has.
  if [ -n "$publish_url" ]; then
    cut_publish_stop
    return 0
  fi
  local s
  for s in snapshot candidate publish; do
    cut_row "$s" skipped "no publish.url declared"
  done
  cut_tail
}

# cut_object_left -- the confirm step's read of the release object under
# object: local, for a cut and for release publish (issue 0240) alike. THE
# OBJECT IS READ HERE, whole: whether it exists, and when it does, whether it
# carries this release's title and notes. A difference is work left, so it is
# named in the question and only a confirmed run changes it; no run reports
# `already` over an object that differs. Reads the caller's tag, v, commit
# (whose tree the notes body is read from), title, declared_repo, drem,
# assets_wf and body_file; sets its repo, object_work, object_detail,
# attach_work and assets_detail, and adds to its left the work it finds. A read
# that fails fails the confirm step.
cut_object_left() {
  local answer
  repo="$(release_repo "$declared_repo" "$drem" 2>&1)" || cut_fail confirm "$(one_line "$repo")"
  answer="$(release_read_object local "$tag" "$declared_repo" "$drem")"
  case "${answer%%$'\t'*}" in
    already)
      cut_notes_body "$commit" "$v" "$body_file" confirm
      answer="$(release_read_object_content "$repo" "$tag" "$title" "$body_file")"
      case "${answer%%$'\t'*}" in
        already) object_detail="${answer#*$'\t'}" ;;
        pending)
          object_work=edit
          object_detail="${answer#*$'\t'}"
          left+=("set the release object's title and notes: $object_detail")
          ;;
        *) cut_fail confirm "${answer#*$'\t'}" ;;
      esac
      ;;
    pending)
      object_work=create
      left+=("make the release object \"$title\"")
      ;;
    *) cut_fail confirm "${answer#*$'\t'}" ;;
  esac
  # THE ASSETS (ST0008 WP-08) are work left unless the object is this
  # release's and its SHA256SUMS agrees with it, read through the reader
  # status reads the object row with (release_read_assets), so status and a cut cannot
  # disagree, and bounded, as a resume past the push step reads a public release.
  # An object still to be made or set has none attached yet.
  if [ -n "$assets_wf" ]; then
    if [ -n "$object_work" ]; then
      attach_work=yes
      left+=("attach the assets $assets_wf's run at $tag built, and SHA256SUMS")
    else
      answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
      case "${answer%%$'\t'*}" in
        already) assets_detail="${answer#*$'\t'}" ;;
        pending)
          attach_work=yes
          left+=("attach the assets $assets_wf's run at $tag built, and SHA256SUMS: ${answer#*$'\t'}")
          ;;
        *) cut_fail confirm "${answer#*$'\t'}" ;;
      esac
    fi
  fi
}

# cut_confirm <who> <heading> -- the confirm step's question, for a cut and for
# release publish (issue 0240) alike. THE WORK LEFT, JOINED ONCE, and the
# --yes row's words built once (0181), so every row and the question name one
# list, and a dry run given --yes says what the run's own row says. <who> names
# the run in a dry run's verdict (`the cut`), and <heading> opens the question
# at a terminal. Reads the caller's left, tag, dry_run and assume_yes, and sets
# its confirmed, ask_next and prompted, which it declares:
#   ask_next  what a dry run's verdict says the run does at this step (0181)
#   prompted  the tag a person said yes to AT THE PROMPT, and nothing under
#             --yes: the after step hands it to its commands (issue 0227)
cut_confirm() {
  local who="$1" heading="$2" work="" yes_detail asked=0
  [ "${#left[@]}" -eq 0 ] || work="$(printf '%s; ' "${left[@]}" | sed 's/; $//')"
  yes_detail="--yes given: $work"
  if [ "${#left[@]}" -eq 0 ]; then
    cut_row confirm "not re-run" "no irreversible step has work left"
    ask_next="$who has nothing left to ask about"
  elif [ "$dry_run" = 1 ] && [ "$assume_yes" = 1 ]; then
    # --YES ANSWERS THE QUESTION, so a dry run given it predicts the confirm step whole
    # and leaves nothing of it unpredicted.
    cut_row confirm would "$yes_detail"
    ask_next="given --yes, $who does not stop to ask"
  elif [ "$dry_run" = 1 ]; then
    cut_row confirm would "ask before: $work"
    CUT_UNREACHED+=("the confirm step's confirmation: a dry run never asks")
    ask_next="$who stops to ask at the confirm step"
  elif [ "$assume_yes" = 1 ]; then
    confirmed=yes
    cut_row confirm "done" "$yes_detail"
  else
    printf '\n%s. Still to do, and seen by other machines once done:\n' "$heading"
    printf '  - %s\n' "${left[@]}"
    ask_person "release: go ahead?" || asked=$?
    case "$asked" in
      0)
        confirmed=yes
        prompted="$tag"
        cut_row confirm "done" "confirmed: $work"
        ;;
      1) cut_fail confirm "declined at the prompt" ;;
      *) cut_fail confirm "nobody to ask: no terminal, and --yes was not given" ;;
    esac
  fi
}

# cut_publish_stop -- a publishing cut's end, past its push (issue 0240). The
# snapshot, candidate and publish rows are pending on release publish, which
# runs them, and the object, after and ci rows are not reached: each reads the
# public repository, which holds nothing of this release until it is made
# public. Exit 0, since the cut did all a cut does here. Reads the caller's v,
# tag, dry_run and ask_next.
cut_publish_stop() {
  local cmd="${DEVBIN_INVOKE:-bin/devbin} release publish v$v" s
  for s in snapshot candidate publish; do
    cut_row "$s" pending "$cmd"
  done
  for s in object after ci; do
    cut_row "$s" "not reached" "the public repository holds nothing of $tag until $cmd makes it public"
  done
  cut_summary
  if [ "$dry_run" = 1 ]; then
    cut_dry_verdict
    return 0
  fi
  printf '\nrelease: %s is cut, and nothing of it is public yet: %s makes its snapshot public, once CI is green on it.\n' "$tag" "$cmd"
}

# cut_dry_verdict -- a dry run's last lines, under its table: what it could not
# reach, then THE VERDICT AS THE LAST LINE (0181). A passing dry run ended on
# "NOT REACHED" and "not predicted", and was read as a failure; a failing one
# stops at cut_fail, exit 1, and never gets here. Reads the caller's tag and
# ask_next.
cut_dry_verdict() {
  if [ "${#CUT_UNREACHED[@]}" -gt 0 ]; then
    printf '\nrelease: NOT REACHED by this dry run, so not predicted:\n'
    printf '  - %s\n' "${CUT_UNREACHED[@]}"
  fi
  printf '\nrelease: dry run of %s -- no step failed; %s\n' "$tag" "$ask_next"
}

# cut_tail -- the object, after and ci steps, and the run's end, for a cut and
# for release publish (issue 0240) alike: what reads and writes the release
# object, runs after:, and reads the CI verdict, against the repository
# release.repo names, or the one read off the first remote. Run in the
# caller's shell, it reads the caller's tag, v, commit (the commit the tag
# names where CI and brew read it), rel_at, branch, object, title, repo,
# declared_repo, drem, body_file, object_work, object_detail, attach_work,
# assets_detail, assets_wf, confirmed, prompted, ask_next and dry_run.
cut_tail() {
  # --- the release object ------------------------------------------
  case "$object" in
    none) cut_row object skipped "object: none" ;;
    ci)
      # THE PROJECT'S WORKFLOW MAKES THE OBJECT, from the tag the push step pushed, and
      # the core makes none: one writer per release object. The object step reads the
      # OBJECT, through the reader status reads it with, never a CI verdict:
      # another workflow's run on the release commit cannot stand in for it
      # (AC-6.1).
      local wait_for
      wait_for="$(cfg_release_get object_wait)"
      if [ "$dry_run" = 1 ]; then
        answer="$(release_wait 0 "" UNREADABLE release_read_object ci "$tag" "$declared_repo" "$drem")"
        if [ "${answer%%$'\t'*}" = already ]; then
          cut_row object already "${answer#*$'\t'}"
        else
          cut_row object would "wait up to $wait_for (object_wait) for the workflow's release object for $tag; the core makes none"
        fi
      else
        # The postcondition first, one bounded ask, as every step reads its own:
        # an object already there is `already`, and only an absent one is waited
        # for.
        local secs
        secs="$(release_seconds "$wait_for" 2>&1)" || cut_fail object "$(one_line "$secs")"
        answer="$(release_wait 0 "" UNREADABLE release_read_object ci "$tag" "$declared_repo" "$drem")"
        if [ "${answer%%$'\t'*}" = already ]; then
          cut_row object already "${answer#*$'\t'}; the core made none"
        else
          answer="$(release_wait "$secs" "pending UNREADABLE" UNREADABLE \
            release_read_object ci "$tag" "$declared_repo" "$drem")"
          case "${answer%%$'\t'*}" in
            already) cut_row object "done" "the workflow made the release object for $tag within $wait_for; the core made none" ;;
            *) cut_fail object "no release object within $wait_for (object_wait): ${answer%%$'\t'*}, ${answer#*$'\t'}" ;;
          esac
        fi
      fi
      ;;
    local)
      local obj_state="" obj_detail=""
      if [ "$object_work" = create ]; then
        if [ "$dry_run" = 1 ]; then
          obj_state=would obj_detail="gh release create $tag --title \"$title\""
        else
          # --verify-tag: without it GitHub MAKES a tag it lacks, from the
          # default branch. THE LIMIT, DECLARED: nothing
          # checks that a remote in `remotes` reaches $repo. With `repo:`
          # declared and every push going elsewhere, --verify-tag refuses here,
          # after the pushes. A pre-flight check would have to map a remote's
          # url to a repository, which ssh host aliases, insteadOf and mirrors
          # all defeat, so a refusal there would refuse working setups.
          cut_call object "gh release create $tag" \
            release_gh "$repo" release create "$tag" --verify-tag --title "$title" --notes-file "$body_file"
          CUT_OUTWARD+=", made the release object for $tag"
          answer="$(release_wait 0 "" UNREADABLE release_read_object local "$tag" "$declared_repo" "$drem")"
          [ "${answer%%$'\t'*}" = already ] || cut_fail object "gh made no release object that reads back: ${answer#*$'\t'}"
          obj_state="done" obj_detail="made the release object \"$title\""
        fi
      elif [ "$object_work" = edit ]; then
        # The confirm step named the difference, and only a confirmed run gets here: the
        # object is brought to this release's title and notes, never made twice.
        if [ "$dry_run" = 1 ]; then
          obj_state=would obj_detail="gh release edit $tag: $object_detail"
        else
          # NO ARM REACHES IT: an edit is work left, so the confirm step has confirmed it or
          # stopped the run. Kept so the object step never edits on its own say-so.
          [ "$confirmed" = yes ] || cut_fail object "the release object differs and nobody confirmed changing it: $object_detail"
          cut_call object "gh release edit $tag" \
            release_gh "$repo" release edit "$tag" --title "$title" --notes-file "$body_file"
          CUT_OUTWARD+=", set the release object's title and notes for $tag"
          answer="$(release_wait 0 "" UNREADABLE release_read_object_content "$repo" "$tag" "$title" "$body_file")"
          [ "${answer%%$'\t'*}" = already ] || cut_fail object "the release object does not read back as set: ${answer#*$'\t'}"
          obj_state="done" obj_detail="the release object existed ($object_detail); its title and notes were set to this release's"
        fi
      else
        obj_state=already obj_detail="$object_detail"
      fi
      # THE ATTACH, THE SAME FUNCTION `release attach` RUNS (ST0008 WP-08), after
      # the object, and only where the confirm step named it as work left.
      if [ "$attach_work" != yes ]; then
        cut_row object "$obj_state" "$obj_detail${assets_detail:+; $assets_detail}"
      elif [ "$dry_run" = 1 ]; then
        cut_row object would "$obj_detail; then attach the assets $assets_wf's run at $tag built, and SHA256SUMS, waiting up to $(cfg_release_get assets.wait) (assets.wait) for the run"
        CUT_UNREACHED+=("the object step's attach: a dry run reads no run's files and attaches nothing")
      else
        # NO ARM REACHES IT: the attach is work left, so the confirm step has confirmed it
        # or stopped the run. Kept so the object step never attaches on its own say-so.
        [ "$confirmed" = yes ] || cut_fail object "the assets have work left and nobody confirmed attaching them"
        printf '\nrelease: attach: the assets %s'"'"'s run at %s built\n' "$assets_wf" "$tag"
        if ! attach_assets "$tag" "$commit" "$repo" "$assets_wf" "$(cfg_release_get assets.wait)"; then
          [ -z "$ATTACH_OUTWARD" ] || CUT_OUTWARD+=", $ATTACH_OUTWARD"
          cut_fail object "$obj_detail; the attach stopped at $ATTACH_STAGE: $ATTACH_DETAIL"
        fi
        [ -z "$ATTACH_OUTWARD" ] || CUT_OUTWARD+=", $ATTACH_OUTWARD"
        if [ "$obj_state" = already ] && [ "$ATTACH_WROTE" = no ]; then
          cut_row object already "$obj_detail; the attach found $ATTACH_DETAIL"
        else
          cut_row object "done" "$obj_detail; attached $ATTACH_DETAIL"
        fi
      fi
      ;;
  esac

  # --- after ------------------------------------------------------
  # Each command in order, reported. Outside the core's guarantees: the
  # release is published by now, so a failure is reported and undoes nothing,
  # and the next command and the ci step still run. This step has no
  # postcondition, so a re-run of a finished release runs them again.
  local after cmd after_failed="" ran=0
  local -a aw=()
  # A mark inherited from whatever started this cut is not this cut's yes.
  unset DEVBIN_RELEASE_CONFIRMED
  after="$(cfg_release_list after)"
  if [ -z "$after" ]; then
    cut_row after skipped "no after: declared"
  elif [ "$dry_run" = 1 ]; then
    cut_row after would "run: $(printf '%s; ' "${after//$'\n'/; }" | sed 's/; $//')"
  else
    while IFS= read -r cmd <&3; do
      [ -n "$cmd" ] || continue
      run_words aw release.after "$cmd" 2>/dev/null || {
        after_failed+=", after: $cmd holds no words"
        continue
      }
      printf '\nrelease: after: %s\n' "$cmd"
      local arc=0
      # NOT THE ONLY THING KEEPING THE TERMINAL AWAY: the real cut runs
      # inside run_gate, whose stdin is /dev/null for everything in it, and a dry
      # run never gets here. Through gate_exec the line keeps the flag the
      # release gate set, since it runs inside that gate (issue 0158): an
      # `after:` command that is a script asking through ask_person can still ask
      # the person who was there when the cut began. A `bin/devbin` line cannot,
      # since the dispatcher drops the gate's mark and reads the person from its
      # own stdin, which is /dev/null here; it gets DEVBIN_RELEASE_CONFIRMED
      # instead, the tag a person said yes to at the confirm step's prompt, and
      # empty under --yes (issue 0227), which `formula publish` reads as the yes
      # for the push the cut lists. Nothing but these commands is given it. And
      # the after step does not depend on its caller to keep stdin off the
      # terminal.
      if [ -n "$prompted" ]; then
        DEVBIN_RELEASE_CONFIRMED="$prompted" gate_exec "${aw[@]}" 3<&- || arc=$?
      else
        gate_exec "${aw[@]}" 3<&- || arc=$?
      fi
      if [ "$arc" -eq 0 ]; then
        ran=$((ran + 1))
      else
        after_failed+=", after: $cmd failed (exit $arc)"
      fi
    done 3<<<"$after"
    if [ -z "$after_failed" ]; then
      cut_row after "done" "$ran command(s) ran"
    else
      cut_row after FAILED "${after_failed#, }; $ran ran -- the release is published and nothing was undone"
    fi
  fi

  # --- the CI verdict ---------------------------------------------
  # Fail forward: CI does not gate the release, it reports on it. The project's
  # ci.query is asked about the RELEASE COMMIT, the tagged commit and never
  # HEAD, with the RELEASE TAG in its environment, whose runs are the verdict
  # (issue 0149), while it answers pending or none, up to ci.wait. Only green is
  # 0: a cut that could not confirm green must not exit as though it had. The
  # rows say what the query answered: the core cannot see whether it read the
  # tag.
  # ci.tag OFF (issue 0223): the project's tag run takes longer than any wait a
  # cut should hold, and under ci.base its base was green before the cut, so
  # the tag's run is read after it instead.
  local verdict_failed=""
  if ! cfg_release_declared ci.query; then
    cut_row ci skipped "no ci.query declared"
  elif ! is_true_word "$(cfg_release_get ci.tag)"; then
    cut_row ci skipped "ci.tag is off: the cut does not wait for $tag's CI run -- read it once it has run"
  elif [ "$dry_run" = 1 ]; then
    cut_row ci would "ask ci.query about $tag ($rel_at) for up to $(cfg_release_get ci.wait) (ci.wait)"
  else
    local query ci_wait ci_secs
    local -a qw=()
    query="$(cfg_release_get ci.query)"
    ci_wait="$(cfg_release_get ci.wait)"
    run_words qw release.ci.query "$query" 2>/dev/null || cut_fail ci "ci.query holds no words"
    ci_secs="$(release_seconds "$ci_wait" 2>&1)" || cut_fail ci "$(one_line "$ci_secs")"
    answer="$(release_wait "$ci_secs" "pending none" unknown release_ci_verdict "$commit" "$tag" "${qw[@]}")"
    case "${answer%%$'\t'*}" in
      green) cut_row ci "done" "ci.query answers green for $tag (${commit:0:12}): ${answer#*$'\t'}" ;;
      pending | none)
        verdict_failed=yes
        cut_row ci FAILED "ci.query gave no verdict within $ci_wait (ci.wait) for $tag (${commit:0:12}); last: ${answer%%$'\t'*}, ${answer#*$'\t'}"
        ;;
      # unknown is no answer: the query exited non-zero, was cut off, printed
      # nothing or printed what is not a verdict, or said it could not tell.
      unknown)
        verdict_failed=yes
        cut_row ci FAILED "no verdict from ci.query for $tag (${commit:0:12}): ${answer#*$'\t'}"
        ;;
      *)
        verdict_failed=yes
        cut_row ci FAILED "ci.query answers ${answer%%$'\t'*} for $tag (${commit:0:12}): ${answer#*$'\t'}"
        ;;
    esac
  fi

  cut_summary
  if [ "$dry_run" = 1 ]; then
    cut_dry_verdict
    return 0
  fi
  if [ -n "$after_failed$verdict_failed" ]; then
    # THE RELEASE STANDS, and saying so is half the message: nothing here is
    # undone, and the tag is never moved. The other half is the remedy,
    # which is forward.
    printf '\nrelease: %s is published, and the tag and the release stand.\n' "$tag"
    [ -z "$after_failed" ] ||
      printf 'release: %s -- after: runs outside the core'"'"'s guarantees; run what failed by hand.\n' "${after_failed#, }"
    [ -z "$verdict_failed" ] ||
      printf 'release: CI did not report green on %s. Fix forward: fix it on %s and cut the next patch -- never move, delete or re-point %s.\n' \
        "${commit:0:12}" "$branch" "$tag"
    exit 1
  fi
  printf '\nrelease: %s is released.\n' "$tag"
  cut_back_to_brew "$tag" "$v" "$commit"
}

# ---------------------------------------------------------------------------
# THE ATTACH (ST0008 WP-08)
#
# ONE FUNCTION, WHEREVER IT RUNS: `release attach <v>`, which a project whose
# own command cuts its releases runs once its release object is made, and the object step
# of a cut under object: local, after the object. It attaches what the EARLIEST
# SUCCESSFUL run of release.assets.workflow at the tag built
# (release_read_assets_run), and writes one SHA256SUMS over every asset on the
# object. It never makes the release object and never dispatches a run.
#
# AND ONE WAY AN ASSET BUILT ON THIS MACHINE REACHES A RELEASE (issue 0226):
# `release attach <v> --from <dir>` attaches the files in <dir> instead of a
# run's, through the same checks, upload, SHA256SUMS and readback; the built-in
# macos attaches its zipped app this way. Its stages are object, assets, files,
# then upload, sums and readback as below. Its assets stage is not a finish
# line: with release.assets.workflow declared it requires the run's attach to
# have finished first, because an attach --from before it would leave
# SHA256SUMS agreeing with the object, and the run's attach would then read
# finished and attach nothing. Its files stage takes every file under <dir>, as
# download takes every file of the run's artifacts.
#
# ITS STAGES, EACH READING ITS POSTCONDITION FIRST, so a re-run continues:
#   object    the release object for the tag exists
#   assets    the attach's own postcondition, read before any run: SHA256SUMS
#             agreeing with every other asset on the object, through the reader
#             the object row and a cut's confirm step read (release_read_assets). When it
#             agrees the attach is finished: it reads no run, downloads nothing
#             but SHA256SUMS's own text, and writes nothing, so a re-run after
#             the run's artifacts expire is already, never a refusal
#   run       the run that ships, waited for within assets.wait, one bound for
#             both waits: while no run is listed, and while it is queued or in
#             progress
#   download  the run's artifacts as GitHub lists them, none expired, into this
#             run's scratch, one directory per artifact; every file inside them
#             is an asset, and every artifact listed must have arrived
#   upload    first every check the object's listing can answer: a file the
#             object holds at the same sha256 is already, one it holds with
#             other bytes is refused, never replaced, and every other asset must
#             be one SHA256SUMS can be written over. Then each file it lacks,
#             never with --clobber, and each reads back at its sha256.
#   sums      SHA256SUMS over every asset on the object, each hash from bytes
#             the attach holds: the run's files, and every other asset
#             downloaded from the release. The one asset it replaces, and only
#             when its text differs. Written LAST, once every upload has read
#             back, so its agreement with the object is what release_read_assets
#             reads a finished attach by.
#   readback  every asset this run wrote reads back at its sha256
#
# A stage that fails prints its FAILED row and returns 1 with ATTACH_STAGE and
# ATTACH_DETAIL set; ATTACH_OUTWARD says what it wrote to the release object,
# and what it MAY have written: a write cut off at its bound, and a --clobber
# that failed, which deletes before it uploads. ATTACH_WROTE says whether it
# wrote anything. EVERY CALL TO GITHUB IS BOUNDED, at
# RELEASE_CALL_SECONDS (attach_call) or the ask floor (release_wait): from step
# 9 on the release is public, and a call that hangs would hold it with nothing
# reporting it.
# ---------------------------------------------------------------------------
ATTACH_STAGE=""
ATTACH_DETAIL=""
ATTACH_OUTWARD=""
ATTACH_WROTE=no
ATTACH_CALL=""
ATTACH_CUT_OFF=no
ASSET_LIST=""
HELD_SHA=""

attach_row() { printf '  %-9s %-8s %s\n' "$1" "$2" "$3"; }

# attach_outward <act> -- add <act> to ATTACH_OUTWARD, what this run did, or
# may have done, to the release object, as a stop line says it.
attach_outward() { ATTACH_OUTWARD="${ATTACH_OUTWARD:+$ATTACH_OUTWARD, and }$1"; }

# attach_fail <stage> <detail> -- the stage's FAILED row, and the caller's facts.
attach_fail() {
  ATTACH_STAGE="$1"
  ATTACH_DETAIL="$2"
  attach_row "$1" FAILED "$2"
}

# attach_call <what> <cmd>... -- one gh call, bounded, its output kept in this
# run's scratch (attach.out); on failure ATTACH_CALL says why, naming <what>,
# and a call cut off at its bound says its effect is unknown and sets
# ATTACH_CUT_OFF, so a write cut off is named as one that may have happened.
attach_call() {
  local what="$1" rc=0
  shift
  ATTACH_CUT_OFF=no
  release_run_bounded "$RELEASE_CALL_SECONDS" "$SCRATCH/attach.out" "$SCRATCH/attach.err" "$@" || rc=$?
  case "$rc" in
    0) return 0 ;;
    124)
      ATTACH_CUT_OFF=yes
      ATTACH_CALL="$what did not finish within ${RELEASE_CALL_SECONDS}s and was stopped -- whether it took effect is unknown"
      ;;
    *) ATTACH_CALL="$what failed (exit $rc): $(one_line "$(cat "$SCRATCH/attach.err")")" ;;
  esac
  return 1
}

# attach_listing <repo> <tag> -- the release object's assets
# (release_object_assets) into ASSET_LIST, through attach_call.
attach_listing() {
  attach_call "listing the release object's assets" release_object_assets "$1" "$2" || return 1
  ASSET_LIST="$(cat "$SCRATCH/attach.out")"
}

# attach_upload <repo> <tag> <dir> <name> [--clobber] -- gh release upload of
# <dir>/<name>, run FROM <dir> with the bare name, in a subshell: gh reads a `#`
# anywhere in an upload's path as the start of a label, and a TMPDIR or an
# artifact's directory may hold one, while <name> has passed
# release_name_problem, which admits none.
attach_upload() (
  cd "$3" || exit 1
  release_gh "$1" release upload "$2" "${@:4}"
)

# attach_held <repo> <tag> <name> <dir> -- download the release's asset <name>
# into <dir>, which must not hold it yet, and set HELD_SHA to its sha256. Run in
# the caller's shell, never in a `$(...)`, so ATTACH_CALL reaches the caller
# when it fails.
attach_held() {
  local why
  HELD_SHA=""
  if why="$(release_pattern_problem "$3")"; then
    ATTACH_CALL="$3 cannot be read back from the release: $why"
    return 1
  fi
  mkdir -p "$4" || {
    ATTACH_CALL="no directory to download $3 into"
    return 1
  }
  attach_call "gh release download $3" release_gh "$1" release download "$2" --pattern "$3" --dir "$4" || return 1
  if [ ! -f "$4/$3" ]; then
    ATTACH_CALL="gh release download $3 wrote no file named $3"
    return 1
  fi
  if ! HELD_SHA="$(sha256_of "$4/$3")" || [ -z "$HELD_SHA" ]; then
    ATTACH_CALL="$3, downloaded, could not be hashed"
    return 1
  fi
}

# attach_reads_back <stage> <repo> <tag> <pairs> [<after>] -- each
# `<name><TAB><sha256>` of <pairs> is on the object at that sha256, read from a
# listing taken now (into ASSET_LIST); one that is not fails <stage>, its detail
# ending in <after>. The one read-back, after the run's uploads and after
# SHA256SUMS. READ_BACK counts what was read back.
READ_BACK=0
attach_reads_back() {
  local stage="$1" repo="$2" tag="$3" pairs="$4" after="${5:-}" name sha digest
  READ_BACK=0
  if ! attach_listing "$repo" "$tag"; then
    attach_fail "$stage" "the release object's assets could not be read back: $ATTACH_CALL$after"
    return 1
  fi
  while IFS=$'\t' read -r name sha; do
    [ -n "$name" ] || continue
    if ! digest="$(release_asset_digest "$ASSET_LIST" "$name")"; then
      attach_fail "$stage" "uploaded $name, and it does not read back at its sha256 $sha: the object holds no asset of that name$after"
      return 1
    fi
    if [ "$digest" != "sha256:$sha" ]; then
      attach_fail "$stage" "uploaded $name, and it does not read back at its sha256 $sha: GitHub lists ${digest:-no digest}$after"
      return 1
    fi
    READ_BACK=$((READ_BACK + 1))
  done <<<"$pairs"
}

# attach_take <stage> <place> <root> <none> -- every file of the caller's
# `files`, each found under <root>, checked as an asset and held, for the
# download stage and for --from's files stage alike: its name, sha256 and
# directory appended to the caller's names, shas and dirs, then every one's
# index in name order into the caller's order. <place> names the files' source
# in each refusal, as "in run 101's artifacts", and <none> is the refusal when
# there is no file at all. 0 when every file can be an asset, else <stage>'s
# FAILED row and 1. Called in the caller's shell, which owns the arrays.
attach_take() {
  local stage="$1" place="$2" root="$3" none="$4" f rel name sha why j i
  for f in "${files[@]}"; do
    rel="${f#"$root"/}"
    name="${f##*/}"
    if [ ! -f "$f" ] || [ -L "$f" ]; then
      attach_fail "$stage" "$rel, $place, is not a regular file"
      return 1
    fi
    if [ "$name" = SHA256SUMS ]; then
      attach_fail "$stage" "$rel, $place, cannot be an asset: SHA256SUMS is the name the attach writes its sums under"
      return 1
    fi
    if why="$(release_name_problem "$name")"; then
      attach_fail "$stage" "$rel, $place, cannot be an asset: $why"
      return 1
    fi
    for j in "${names[@]}"; do
      if [ "$j" = "$name" ]; then
        attach_fail "$stage" "two files $place are named $name, and a release object holds one asset of a name"
        return 1
      fi
    done
    if ! sha="$(sha256_of "$f")" || [ -z "$sha" ]; then
      attach_fail "$stage" "$rel could not be hashed"
      return 1
    fi
    names+=("$name")
    shas+=("$sha")
    dirs+=("${f%/*}")
  done
  if [ "${#names[@]}" -eq 0 ]; then
    attach_fail "$stage" "$none"
    return 1
  fi
  # In name order, so the rows and the uploads do not follow find's. The order
  # is checked whole: one shorter than the files would attach a part of them
  # and read the rest as already there.
  mapfile -t order < <(for i in "${!names[@]}"; do printf '%s\t%s\n' "${names[$i]}" "$i"; done | LC_ALL=C sort -t $'\t' -k1,1 | cut -f2)
  if [ "${#order[@]}" -ne "${#names[@]}" ]; then
    attach_fail "$stage" "the ${#names[@]} file(s) $place could not be put in order"
    return 1
  fi
}

# attach_assets <tag> <commit> <repo> <workflow> <wait> [<from>] -- the stages
# above, their rows printed as they run. With <from>, a directory, the files
# under it are attached instead of a run's (issue 0226). 0 when every stage
# holds, 1 when one FAILED.
attach_assets() {
  local tag="$1" commit="$2" repo="$3" wf="$4" wait_for="$5" from="${6:-}"
  local answer state rest id secs dl f rel name sha why i j digest sums_state n arts expired a source files_of
  local -a files=() names=() shas=() dirs=() order=() todo=() uploaded=() already=()
  local conflicts="" others="" pairs="" upl_pairs="" upl_sha=""
  ATTACH_STAGE="" ATTACH_DETAIL="" ATTACH_OUTWARD="" ATTACH_WROTE=no

  # --- object -------------------------------------------------------------
  # Asked of the repository this attach writes to, never resolved a second time.
  answer="$(release_wait 0 "" UNREADABLE release_read_object local "$tag" "$repo" "")"
  case "${answer%%$'\t'*}" in
    already) attach_row object already "${answer#*$'\t'}" ;;
    pending)
      attach_fail object "no release object for $tag, and the attach makes none -- make it, then attach"
      return 1
      ;;
    *)
      attach_fail object "${answer#*$'\t'}"
      return 1
      ;;
  esac

  if [ -n "$from" ]; then
    # --- assets, for --from ---------------------------------------------------
    # The run's attach first, where there is one: see the header.
    if [ -n "$wf" ]; then
      answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
      case "${answer%%$'\t'*}" in
        already) attach_row assets already "the run's attach has finished: ${answer#*$'\t'}" ;;
        pending)
          attach_fail assets "${answer#*$'\t'} -- release.assets.workflow is $wf, and its run's attach comes first: attach without --from first, then with it"
          return 1
          ;;
        *)
          attach_fail assets "${answer#*$'\t'}"
          return 1
          ;;
      esac
    else
      attach_row assets none "release.assets.workflow is not declared, so no run's attach comes first"
    fi

    # --- files ------------------------------------------------------------------
    if ! find_list files "$from" ! -type d -print0; then
      attach_fail files "the files under $from could not be listed (above)"
      return 1
    fi
    attach_take files "in $from" "$from" "there is no file under $from, so there is nothing to attach" || return 1
    source="$from's" files_of="$from"
    attach_row files "done" "${#names[@]} file(s) under $from: $(for i in "${order[@]}"; do printf '%s, ' "${names[$i]}"; done | sed 's/, $//')"
  else
    # --- assets ---------------------------------------------------------------
    # Read as the object row and a cut's confirm step read it, and as bounded: work is left only
    # when the reader says pending.
    answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
    case "${answer%%$'\t'*}" in
      already)
        attach_row assets already "${answer#*$'\t'}"
        ATTACH_DETAIL="finished already, so no run was read: ${answer#*$'\t'}"
        return 0
        ;;
      pending) attach_row assets pending "${answer#*$'\t'}" ;;
      *)
        attach_fail assets "${answer#*$'\t'}"
        return 1
        ;;
    esac

    # --- run -----------------------------------------------------------------
    if ! secs="$(release_seconds "$wait_for" 2>&1)"; then
      attach_fail run "$(one_line "$secs")"
      return 1
    fi
    answer="$(release_wait "$secs" "pending UNREADABLE" UNREADABLE release_read_assets_run "$repo" "$wf" "$tag" "$commit")"
    state="${answer%%$'\t'*}"
    rest="${answer#*$'\t'}"
    case "$state" in
      already)
        id="${rest%%$'\t'*}"
        attach_row run already "${rest#*$'\t'}"
        ;;
      failed)
        id="${rest%%$'\t'*}"
        attach_fail run "${rest#*$'\t'} -- the attach never dispatches a run: rerun it (gh run rerun $id) or dispatch one at the tag (gh workflow run $wf --ref $tag), then attach again"
        return 1
        ;;
      refused)
        attach_fail run "$rest"
        return 1
        ;;
      *)
        attach_fail run "no successful run within $wait_for (assets.wait): $state, $rest -- the attach never dispatches a run: dispatch one at the tag (gh workflow run $wf --ref $tag), or rerun a failed one (gh run rerun <id>), then attach again"
        return 1
        ;;
    esac

    # --- download ------------------------------------------------------------
    # THE RUN'S ARTIFACTS AS GITHUB LISTS THEM come first, and what gh run
    # download wrote is held to them: it passes over an expired artifact and
    # succeeds while any other downloads, which would attach part of the run and
    # write SHA256SUMS over that part.
    dl="$SCRATCH/assets/run-$id"
    if ! mkdir -p "$SCRATCH/assets" || [ -e "$dl" ]; then
      attach_fail download "no fresh directory under $SCRATCH for run $id's artifacts"
      return 1
    fi
    if ! attach_call "listing run $id's artifacts" release_run_artifacts "$repo" "$id"; then
      attach_fail download "$ATTACH_CALL"
      return 1
    fi
    arts="$(cat "$SCRATCH/attach.out")"
    if [ -z "$arts" ]; then
      attach_fail download "run $id lists no artifact, so there is nothing to attach"
      return 1
    fi
    expired="$(awk -F'\t' '$2 == "true" { printf "%s%s", sep, $1; sep = ", " }' <<<"$arts")"
    if [ -n "$expired" ]; then
      attach_fail download "run $id, the earliest successful run at $tag, has expired artifacts ($expired), and the attach ships that run's files alone -- a rerun of it (gh run rerun $id) is the one way that might give them back, and whether it does is not measured"
      return 1
    fi
    if ! attach_call "gh run download $id" release_gh "$repo" run download "$id" --dir "$dl"; then
      attach_fail download "$ATTACH_CALL"
      return 1
    fi
    while IFS=$'\t' read -r a _; do
      [ -n "$a" ] || continue
      if [ ! -d "$dl/$a" ]; then
        attach_fail download "run $id lists the artifact $a, and gh run download wrote no $a under $dl"
        return 1
      fi
    done <<<"$arts"
    if ! find_list files "$dl" ! -type d -print0; then
      attach_fail download "the files of run $id's artifacts could not be listed under $dl (above)"
      return 1
    fi
    attach_take download "in run $id's artifacts" "$dl" "run $id's artifacts hold no file, so there is nothing to attach" || return 1
    source="run $id's" files_of="run $id"
    attach_row download "done" "${#names[@]} file(s) from run $id's $(grep -c . <<<"$arts") artifact(s): $(for i in "${order[@]}"; do printf '%s, ' "${names[$i]}"; done | sed 's/, $//')"
  fi

  # --- upload ---------------------------------------------------------------
  if ! attach_listing "$repo" "$tag"; then
    attach_fail upload "$ATTACH_CALL"
    return 1
  fi
  # EVERY CHECK THE LISTING CAN ANSWER COMES BEFORE THE FIRST UPLOAD, so a
  # refusal it can name leaves the object as it was.
  for i in "${order[@]}"; do
    if ! digest="$(release_asset_digest "$ASSET_LIST" "${names[$i]}")"; then
      todo+=("$i")
      continue
    fi
    if [ -z "$digest" ]; then
      # GitHub lists no digest for it, so its bytes are read to compare.
      if ! attach_held "$repo" "$tag" "${names[$i]}" "$SCRATCH/assets/held"; then
        attach_fail upload "${names[$i]} is on the release object with no GitHub digest, and $ATTACH_CALL"
        return 1
      fi
      digest="sha256:$HELD_SHA"
    fi
    if [ "$digest" = "sha256:${shas[$i]}" ]; then
      already+=("${names[$i]}")
    else
      conflicts+="; ${names[$i]} at ${digest#sha256:}, where the run built ${shas[$i]}"
    fi
  done
  while IFS=$'\t' read -r name state digest; do
    [ -n "$name" ] && [ "$name" != SHA256SUMS ] || continue
    for i in "${order[@]}"; do [ "${names[$i]}" != "$name" ] || continue 2; done
    if [ "$state" != uploaded ]; then
      others+="; $name is $state, not uploaded"
    elif why="$(release_pattern_problem "$name")"; then
      others+="; $name: $why"
    fi
  done <<<"$ASSET_LIST"
  if [ -n "$conflicts" ]; then
    attach_fail upload "the release object already holds ${conflicts#; } -- the attach never replaces an asset: if the run's bytes are the ones to ship, delete that asset (gh release delete-asset $tag <name>), then attach again"
    return 1
  fi
  if [ -n "$others" ]; then
    attach_fail upload "SHA256SUMS could not be written over every asset on the release object: ${others#; } -- nothing was uploaded"
    return 1
  fi
  for i in "${todo[@]}"; do
    if ! attach_call "gh release upload ${names[$i]}" attach_upload "$repo" "$tag" "${dirs[$i]}" "${names[$i]}"; then
      [ "$ATTACH_CUT_OFF" = no ] || attach_outward "may have uploaded ${names[$i]}, whose upload was cut off at its bound"
      attach_fail upload "$ATTACH_CALL${uploaded[*]:+; uploaded before it: ${uploaded[*]}}"
      return 1
    fi
    uploaded+=("${names[$i]}")
    upl_pairs+="${names[$i]}"$'\t'"${shas[$i]}"$'\n'
    ATTACH_WROTE=yes
    ATTACH_OUTWARD="uploaded ${#uploaded[@]} asset(s) to the release object for $tag"
  done
  if [ "${#uploaded[@]}" -gt 0 ]; then
    # EACH UPLOAD READS BACK BEFORE SHA256SUMS IS WRITTEN, so SHA256SUMS on the
    # object always stands for uploads that took. This listing is the one the
    # sums are written over.
    attach_reads_back upload "$repo" "$tag" "$upl_pairs" " -- SHA256SUMS is not written" || return 1
    attach_row upload "done" "${#uploaded[@]} uploaded and read back (${uploaded[*]}), ${#already[@]} already"
  else
    attach_row upload already "every file of $files_of is on the release object at its sha256 (${already[*]})"
  fi

  # --- sums -----------------------------------------------------------------
  n=0
  while IFS=$'\t' read -r name state digest; do
    [ -n "$name" ] && [ "$name" != SHA256SUMS ] || continue
    n=$((n + 1))
    sha=""
    for i in "${order[@]}"; do
      if [ "${names[$i]}" = "$name" ]; then
        sha="${shas[$i]}"
        break
      fi
    done
    if [ -z "$sha" ]; then
      if ! attach_held "$repo" "$tag" "$name" "$SCRATCH/assets/release"; then
        attach_fail sums "$name could not be hashed for SHA256SUMS: $ATTACH_CALL"
        return 1
      fi
      sha="$HELD_SHA"
    fi
    pairs+="$name"$'\t'"$sha"$'\n'
  done <<<"$ASSET_LIST"
  mkdir -p "$SCRATCH/assets/sums" || {
    attach_fail sums "no directory to write SHA256SUMS in"
    return 1
  }
  if ! release_sums_text <<<"$pairs" >"$SCRATCH/assets/sums/SHA256SUMS"; then
    attach_fail sums "SHA256SUMS could not be written"
    return 1
  fi
  sums_state="done"
  if release_asset_digest "$ASSET_LIST" SHA256SUMS >/dev/null; then
    if ! attach_held "$repo" "$tag" SHA256SUMS "$SCRATCH/assets/current"; then
      attach_fail sums "the SHA256SUMS on the release object could not be read: $ATTACH_CALL"
      return 1
    fi
    if cmp -s "$SCRATCH/assets/current/SHA256SUMS" "$SCRATCH/assets/sums/SHA256SUMS"; then
      sums_state=already
    elif ! attach_call "gh release upload SHA256SUMS --clobber" attach_upload "$repo" "$tag" "$SCRATCH/assets/sums" SHA256SUMS --clobber; then
      # THE ONE ASSET THE ATTACH REPLACES: its own, and only on other text.
      # --clobber deletes the old one before it uploads the new, so a failure
      # here may already have deleted it.
      attach_outward "may have deleted or replaced the release object's SHA256SUMS, which --clobber deletes before it uploads"
      attach_fail sums "$ATTACH_CALL -- gh's --clobber deletes the old SHA256SUMS before it uploads the new one, so the object may now carry none; a re-run writes it"
      return 1
    fi
  elif ! attach_call "gh release upload SHA256SUMS" attach_upload "$repo" "$tag" "$SCRATCH/assets/sums" SHA256SUMS; then
    [ "$ATTACH_CUT_OFF" = no ] || attach_outward "may have written SHA256SUMS, whose upload was cut off at its bound"
    attach_fail sums "$ATTACH_CALL"
    return 1
  fi
  if [ "$sums_state" = "done" ]; then
    ATTACH_WROTE=yes
    if ! upl_sha="$(sha256_of "$SCRATCH/assets/sums/SHA256SUMS")" || [ -z "$upl_sha" ]; then
      attach_fail sums "SHA256SUMS was uploaded, and could not be hashed to read it back"
      return 1
    fi
    upl_pairs+="SHA256SUMS"$'\t'"$upl_sha"$'\n'
    attach_outward "wrote SHA256SUMS to the release object for $tag"
    attach_row sums "done" "SHA256SUMS written over the object's $n other asset(s)"
  else
    attach_row sums already "SHA256SUMS on the object already names its $n other asset(s) at the sha256 of their bytes"
  fi

  # --- readback ---------------------------------------------------------------
  if [ "$ATTACH_WROTE" = no ]; then
    attach_row readback already "nothing was written, so there is nothing to read back"
  else
    attach_reads_back readback "$repo" "$tag" "$upl_pairs" || return 1
    attach_row readback "done" "$READ_BACK upload(s) read back at their sha256"
  fi
  ATTACH_DETAIL="$source ${#names[@]} file(s): ${#uploaded[@]} uploaded, ${#already[@]} already; SHA256SUMS $([ "$sums_state" = "done" ] && printf written || printf current) over $n asset(s)"
  return 0
}

# attach_verb <version> [<from>] -- `release attach <version> [--from <dir>]`:
# the attach, for the tag this project releases <version> under, which must be
# here. Refused outside object: local; without <from>, also when
# release.assets.workflow names no workflow and when the tag's commit holds no
# such workflow. With <from>, the files under it are attached (issue 0226). 0
# when every stage holds, 1 when one FAILED.
attach_verb() {
  local v="$1" from="${2:-}" object wf tag commit repo
  object="$(cfg_release_get object)" || die "release attach: cannot read release.object"
  [ "$object" = local ] ||
    die "release attach: object is $object, and the core attaches assets under object: local alone -- under ci the workflow writes the release object, and an attach would be its second writer"
  wf="$(cfg_release_get assets.workflow)" || die "release attach: cannot read release.assets.workflow"
  [ -n "$wf" ] || [ -n "$from" ] ||
    die "release attach: release.assets.workflow is not declared, so no run is named to attach the assets of -- declare the workflow whose run at the tag builds them, or attach files with --from <dir>"
  tag="$(release_tag_name "$(cfg_release_get tag)" "$v")"
  commit="$(git rev-parse -q --verify "refs/tags/$tag^{commit}" 2>/dev/null)" ||
    die "release attach: there is no tag $tag here, and the assets are those of the release at it -- fetch the tags, or cut the release first"
  if [ -z "$from" ]; then
    git cat-file -e "$commit:.github/workflows/$wf" 2>/dev/null ||
      die "release attach: release.assets.workflow is $wf, and $tag's commit (${commit:0:12}) holds no .github/workflows/$wf, so no run at the tag could have built the assets"
  fi
  repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)" ||
    die "release attach: $(one_line "${repo#*release: }")"
  open_scratch "release attach"
  if [ -n "$from" ]; then
    printf 'release: attach %s: the files under %s, onto %s'"'"'s release object for %s (%s)\n' \
      "$tag" "$from" "$repo" "$tag" "${commit:0:12}"
  else
    printf 'release: attach %s: the assets %s'"'"'s run at %s (%s) built, onto %s'"'"'s release object\n' \
      "$tag" "$wf" "$tag" "${commit:0:12}" "$repo"
  fi
  if attach_assets "$tag" "$commit" "$repo" "$wf" "$(cfg_release_get assets.wait)" "$from"; then
    printf 'release: attach %s: %s\n' "$tag" "$ATTACH_DETAIL"
    return 0
  fi
  printf '\nrelease: attach %s stopped at %s. This run %s. Fix what the row names, then run it again: each stage reads what is already done first.\n' \
    "$tag" "$ATTACH_STAGE" "${ATTACH_OUTWARD:-uploaded nothing}"
  return 1
}

# --- the snapshot (issue 0239) ------------------------------------------------
#
# THE PUBLIC TREE IS ONE COMMIT OF THE PRODUCT (ST0010), made from a workroom
# commit and the shipped list, never from a checkout. `release snapshot` makes
# it, for an audit or a publication, and the publish flow (issue 0240) makes
# the same commit again before it pushes, through snapshot_build, which reads
# every input the sha depends on, so what was read is what goes public.
#
# PLUMBING THROUGHOUT. The commit's tree is read into an index of its own, the
# list selects from it as git reads a pathspec, exactly the selected blobs are
# copied into the new repository, and write-tree and commit-tree make the
# commit there. Nothing is read from a working tree, so every mode and every
# byte is the commit's, and the new repository holds no workroom object but the
# shipped blobs. Not `git archive`: it applies export-ignore and export-subst,
# and it writes files, whose modes and bytes would be read back off disk.
#
# DETERMINISTIC. Author and committer are release.snapshot.author, both dates
# the source commit's committer date in UTC, the message the template filled
# from the commit's own tree, and the commit is never signed, so the same
# inputs give the same sha, and a person approves a snapshot by its sha.
#
# A PARENT AFTER THE FIRST. Every release publishes a snapshot, and a second
# parentless commit is never a fast-forward of the first, so a snapshot is made
# on the tip of the publish branch at release.publish.url when there is one. It
# has no parent under --no-parent, or when the url is not declared, or when the
# branch is not there. A tip that is already this commit's snapshot is found,
# not built on (issue 0240), so a release published reads as the one sha.
#
# NEVER ON A HISTORY THAT IS NOT SNAPSHOTS. Until the public repository is
# made, its url can resolve to the private workroom copy, and building on that
# main would chain the workroom's whole history under the snapshot. So a
# publish.url that names the repository one of the project's own remotes
# names, by OWNER/NAME on any host (release_remote_naming), is refused before
# anything is fetched: its history is the project's own, and a first snapshot
# is made with --no-parent. Then the tip is fetched into the run's scratch,
# never into the new directory, and every commit behind it must be made and
# committed by snapshot.author, have one parent at most, and hold exactly its
# own tree filtered by the list its own tree carries, or by the given list when
# it carries none; only then does that history reach the new repository. The
# path test is the one that tells a workroom commit from a snapshot when both
# are made under one identity, for a copy of the history under a name no remote
# carries, and it does so only where the workroom carries a path outside its
# list, as devbin's carries intent/. Reading each commit's own list keeps an
# older snapshot good after a path leaves the list. The walk always ends in a
# parentless root: git's fetch takes nothing from a shallow history and refuses
# a missing parent, and every call runs with git's local variables cleared,
# GIT_SHALLOW_FILE and GIT_GRAFT_FILE among them.
#
# ONE SCRATCH, ONE TRAP. What the build reads and writes on the way, the
# selection's index, the pack, the version file, and the tip with its history,
# is under the release core's scratch root (open_scratch), outside the project,
# which its trap removes at exit, an interrupt's included. The new directory is
# made only once every refusal has been made, and a failure after that removes
# it. An interrupt can leave it part-made, holding only shipped blobs and the
# checked public history, for a rerun to refuse as existing. Its checkout is
# written under the person's own git attributes and filters, as
# release_materialise's is; the commit is made from the index, never from it.

SNAPSHOT_WHY=""
SNAPSHOT_DIR=""
SNAPSHOT_COMMIT=""
SNAPSHOT_TREE=""
SNAPSHOT_PARENT=""
SNAPSHOT_LIST=""
SNAPSHOT_BRANCH=""

# _snapshot_git [--index <file>] <git-args>... -- git with every one of its
# repository-local variables cleared, as git lists them (git_local_env_clear),
# and the pathspec variables, which that list leaves out, so each call acts on
# the repository its -C names, walks its whole history, and reads a line of the
# list as git reads a pathspec by default, whatever the caller exported.
# --index names the index the call reads and writes; with none, a call has its
# repository's own. No hook runs and no reflog is written, so a build's index
# and ref writes run none of the person's hooks and record no identity but the
# snapshot's. A subshell, never `env` or `exec`, so a caller's `git` that is a
# shell function still answers, as git_remote keeps. snapshot_build primes the
# list of variables in its own shell first, so git is asked for it once.
_snapshot_git() {
  local index=""
  if [ "${1-}" = --index ]; then
    index="$2"
    shift 2
  fi
  git_readonly_prime || return 1
  (
    git_local_env_clear || exit 1
    unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
    # shellcheck disable=SC2031 # the subshell is the point: the index is this call's alone
    if [ -n "$index" ]; then export GIT_INDEX_FILE="$index"; fi
    git -c core.hooksPath=/dev/null -c core.logAllRefUpdates=false "$@"
  )
}

# _snapshot_remote <repo> <git-args>... -- a call to a remote, through
# release_git_remote, made from <repo> with git's local variables cleared as
# _snapshot_git clears them, so the url is read in that repository's context
# alone: the ls-remote that finds the tip and the fetch that takes it read one
# url one way.
_snapshot_remote() {
  local repo="$1"
  shift
  git_readonly_prime || return 1
  (
    git_local_env_clear || exit 1
    release_git_remote -C "$repo" -c core.hooksPath=/dev/null -c core.logAllRefUpdates=false "$@"
  )
}

# snapshot_publish_branch -- the public branch each release's snapshot follows:
# release.publish.branch, else release.branch. THE ONE READER of it, the
# snapshot's and the publish flow's (issue 0240), so the branch a snapshot is
# made on is the branch it is published to.
snapshot_publish_branch() {
  if cfg_release_declared publish.branch; then
    cfg_release_get publish.branch
  else
    cfg_release_get branch
  fi
}

# _snapshot_commit_tree <repo> <tree> [<parent>] -- the snapshot's commit of
# <tree> in <repo>, on <parent> when one is given, its sha printed: one
# identity, one date, one message, and no encoding header a config could add,
# so the same inputs give the same sha. commit-tree signs only under -S, which
# is never given, and --no-gpg-sign says so on the line. THE ONE WAY a
# snapshot's commit is made, the one asked of a publish branch's tip included
# (issue 0240), from snapshot_build's name, email, date and message, read in
# its shell.
_snapshot_commit_tree() {
  local -a ps=()
  [ -z "${3:-}" ] || ps=(-p "$3")
  GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_AUTHOR_DATE="$date +0000" \
    GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" GIT_COMMITTER_DATE="$date +0000" \
    _snapshot_git -C "$1" -c i18n.commitEncoding=UTF-8 \
    commit-tree --no-gpg-sign "$2" ${ps[@]+"${ps[@]}"} -m "$message"
}

# _snapshot_select <repo> <commit> <index> <out> <spec>... -- <commit>'s tree
# read into <index>, and the entries the specs select written to <out> as
# `git ls-files -s -z` writes them. rc 1 with SNAPSHOT_WHY, carrying git's
# first line, when either cannot be done.
_snapshot_select() {
  local repo="$1" commit="$2" index="$3" out="$4" err
  shift 4
  if ! err="$(_snapshot_git --index "$index" -C "$repo" read-tree "$commit" 2>&1)"; then
    SNAPSHOT_WHY="git could not read the tree of ${commit:0:12}: ${err%%$'\n'*}"
    return 1
  fi
  if ! err="$(_snapshot_git --index "$index" -C "$repo" ls-files -s -z -- "$@" 2>&1 >"$out")"; then
    SNAPSHOT_WHY="git could not list what the list selects at ${commit:0:12}: ${err%%$'\n'*}"
    return 1
  fi
}

# _snapshot_norm <file> <ls-files|ls-tree> -- the NUL-ended records in <file>,
# as `ls-files -s -z` or `ls-tree -r -z` writes them, as `<mode> <sha><TAB><path>`
# records, so a selection and a tree read back compare byte for byte. Both are
# in git's one order, a path's bytes, so neither is sorted.
_snapshot_norm() {
  local rec meta rest
  while IFS= read -r -d '' rec; do
    meta="${rec%%$'\t'*}"
    case "$2" in
      ls-files)
        rest="${meta#* }"
        printf '%s %s\t%s\0' "${meta%% *}" "${rest%% *}" "${rec#*$'\t'}"
        ;;
      *) printf '%s %s\t%s\0' "${meta%% *}" "${meta##* }" "${rec#*$'\t'}" ;;
    esac
  done <"$1"
}

# _snapshot_abort <made> <dir> <why> -- SNAPSHOT_WHY set to <why>, and <dir>
# removed when this run made it (<made> yes), saying so, so a failure leaves
# nothing behind that a rerun would refuse. The scratch is the trap's.
_snapshot_abort() {
  local shown
  SNAPSHOT_WHY="$3"
  [ "$1" = yes ] || return 0
  if rm -rf -- "$2"; then
    SNAPSHOT_WHY+="; $2, which this run made, was removed"
  else
    printf -v shown '%q' "$2"
    SNAPSHOT_WHY+="; $2, which this run made, could not be removed: remove it with rm -rf $shown"
  fi
}

# _snapshot_history <repo> <tip> <list> <author> <work> <spec>... -- rc 0 when
# every commit behind <tip> in <repo>, <tip> included, is a snapshot: made and
# committed by <author>, with one parent at most, and holding exactly its own
# tree filtered by the list its tree carries at <list> (the given specs when it
# carries none). rc 1 with SNAPSHOT_WHY naming the first commit that is not,
# and who made it. Its scratch is under <work>.
_snapshot_history() {
  local repo="$1" tip="$2" list="$3" author="$4" work="$5" line c text who byline extra err
  shift 5
  local -a given=("$@") walk=() own=()
  SNAPSHOT_WHY=""
  if ! err="$(_snapshot_git -C "$repo" rev-list --parents "$tip" 2>&1 >"$work/walk")"; then
    SNAPSHOT_WHY="git could not walk the history behind the publish branch's tip ${tip:0:12}: ${err%%$'\n'*}"
    return 1
  fi
  while IFS= read -r line; do
    read -r -a walk <<<"$line"
    c="${walk[0]}"
    if ! who="$(_snapshot_git -C "$repo" show -s --no-show-signature --format='%an <%ae>%n%cn <%ce>' "$c" 2>/dev/null)"; then
      SNAPSHOT_WHY="git could not read who made ${c:0:12}, in the publish branch's history"
      return 1
    fi
    byline="made by ${who%%$'\n'*} and committed by ${who#*$'\n'}"
    if [ "${#walk[@]}" -gt 2 ]; then
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, a merge, $byline, and a snapshot has one parent at most, so it is no snapshot"
      return 1
    fi
    if [ "$who" != "$author"$'\n'"$author" ]; then
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, $byline, not by release.snapshot.author ($author), so it is no snapshot"
      return 1
    fi
    if text="$(_snapshot_git -C "$repo" cat-file blob "$c:$list" 2>/dev/null)"; then
      mapfile -t own < <(pathlist_specs "$text")
    else
      own=("${given[@]}")
    fi
    if [ "${#own[@]}" -eq 0 ]; then
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, $byline, whose list $list names no path, so it is no snapshot"
      return 1
    fi
    _snapshot_select "$repo" "$c" "$work/hist.index" "$work/hist.sel" "${own[@]}" || return 1
    if ! err="$(_snapshot_git --index "$work/hist.index" -C "$repo" ls-files -s -z 2>&1 >"$work/hist.all")"; then
      SNAPSHOT_WHY="git could not list the tree of ${c:0:12}, in the publish branch's history: ${err%%$'\n'*}"
      return 1
    fi
    if ! cmp -s "$work/hist.sel" "$work/hist.all"; then
      # The first path, in byte order, that it carries outside its list, for
      # the refusal to name.
      extra=""
      if tr '\0' '\n' <"$work/hist.all" | cut -f2- | LC_ALL=C sort >"$work/hist.all.txt" &&
        tr '\0' '\n' <"$work/hist.sel" | cut -f2- | LC_ALL=C sort >"$work/hist.sel.txt" &&
        LC_ALL=C comm -23 "$work/hist.all.txt" "$work/hist.sel.txt" >"$work/hist.extra.txt"; then
        IFS= read -r extra <"$work/hist.extra.txt" || extra=""
      fi
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, $byline, which carries ${extra:-a path} outside the list its own tree carries, so it is no snapshot"
      return 1
    fi
  done <"$work/walk"
  return 0
}

# snapshot_build <commit> <dir> <no-parent> -- the snapshot of <commit>, a
# workroom commit, made in <dir>, which must not exist yet and must be outside
# the project, from the release keys the snapshot reads: on the tip of the
# publish branch at release.publish.url, unless <no-parent> is 1, the url is not
# declared or there is no such branch there. Every input the sha depends on is
# read here, so the verb and the publish flow make one commit from one commit.
# rc 0 with SNAPSHOT_DIR (where it was made, as it resolves), SNAPSHOT_COMMIT,
# SNAPSHOT_TREE, SNAPSHOT_PARENT (empty for none), SNAPSHOT_LIST and
# SNAPSHOT_BRANCH set; rc 1 with SNAPSHOT_WHY: a refusal writes nothing, and a
# failure once <dir> is made removes it. Runs in the caller's shell, never in a
# `$(...)`, because it opens the run's scratch and its trap (open_scratch).
snapshot_build() {
  local commit="$1" dir="$2" no_parent="$3"
  local list author name email template url branch up root placed x work vfile ver pname message
  local text spec rec mode rest fmt own rc heads sha ref tip="" got err date made=no
  local parent="" tparent ttree trial
  local -a specs=() blobs=()
  SNAPSHOT_WHY="" SNAPSHOT_DIR="" SNAPSHOT_COMMIT="" SNAPSHOT_TREE="" SNAPSHOT_PARENT=""
  SNAPSHOT_LIST="" SNAPSHOT_BRANCH=""
  if ! git_readonly_prime; then
    SNAPSHOT_WHY="git could not list its local variables, so none could be cleared -- nothing written"
    return 1
  fi

  # THE KEYS, every one the sha depends on but the commit's own tree.
  list="$(cfg_release_get snapshot.list)"
  if [ -z "$list" ]; then
    SNAPSHOT_WHY="release.snapshot.list is not declared, so nothing says what ships -- declare it in $DEVBIN_DIR/config.yaml (docs/configuration.md#release); nothing written"
    return 1
  fi
  author="$(cfg_release_get snapshot.author)"
  if ! cfg_ident "$author" name email; then
    SNAPSHOT_WHY="release.snapshot.author is $author, not Name <email> as git writes an identity -- nothing written"
    return 1
  fi
  template="$(cfg_release_get snapshot.message)"
  url="$(cfg_release_get publish.url)"
  branch="$(snapshot_publish_branch)"
  if ! _snapshot_git check-ref-format "refs/heads/$branch"; then
    SNAPSHOT_WHY="$branch is not a name git takes for a branch, so the snapshot has no branch to be made on -- nothing written"
    return 1
  fi

  # THE DIRECTORY, refused before anything is made.
  if [ -e "$dir" ] || [ -L "$dir" ]; then
    SNAPSHOT_WHY="$dir already exists: a snapshot is made in a new directory, never rebuilt in place -- nothing written"
    return 1
  fi
  up="${dir%/*}"
  [ -n "$up" ] || up=/
  if [ ! -d "$up" ]; then
    SNAPSHOT_WHY="$up does not exist, so $dir cannot be made there -- nothing written"
    return 1
  fi
  # A REPOSITORY INSIDE THE WORKROOM is one `git add -A` away from an embedded
  # repository in it, so the snapshot is made outside the project. Placed as it
  # resolves (cargo_place) and asked by identity up its ancestors, as
  # cargo_tree_outside_why asks, never by comparing text: APFS ignores case, and
  # a leading // or a `..` after a link spells the project's directory another
  # way. What is made from here is the placed path.
  if ! physical_dir "$PROJECT_ROOT" root; then
    SNAPSHOT_WHY="cannot resolve the project root $PROJECT_ROOT -- nothing written"
    return 1
  fi
  if ! cargo_place "$dir" placed; then
    SNAPSHOT_WHY="$dir cannot be placed where it resolves, so whether it is inside the project cannot be known -- nothing written"
    return 1
  fi
  x="$placed"
  while :; do
    if [ "$x" -ef "$root" ]; then
      SNAPSHOT_WHY="$dir is inside the project $root, where a snapshot would be a repository inside the workroom -- make it outside; nothing written"
      return 1
    fi
    _path_parent x || break
  done

  # THE MESSAGE, filled from the commit's own tree: {version} is the version
  # its file project.version_from names declares, read through the one reader,
  # written out under its own name so the reader's recipe for that kind of file
  # applies. The replacements are quoted: bash 5.2's patsub_replacement reads an
  # unquoted `&` as the matched text, so a name `R&D` would give two shas on two
  # bashes (issue 0200 found the same in shell-init).
  open_scratch "release snapshot"
  if ! work="$(mktemp -d "$SCRATCH/snapshot.XXXXXX")"; then
    SNAPSHOT_WHY="cannot make a directory under the run's scratch $SCRATCH -- nothing written"
    return 1
  fi
  vfile="${DEVBIN_VERSION_FILE:-VERSION}"
  ver=""
  if mkdir -- "$work/version" &&
    _snapshot_git -C "$PROJECT_ROOT" cat-file blob "$commit:$vfile" >"$work/version/${vfile##*/}" 2>/dev/null; then
    ver="$(read_version "$work/version/${vfile##*/}" version-file)"
  fi
  if [ -z "$ver" ] || [ "$ver" = unknown ]; then
    SNAPSHOT_WHY="${commit:0:12} declares no version in $vfile (project.version_from), so the message would carry none -- nothing written"
    return 1
  fi
  pname="$(cfg_get project.name)"
  message="${template//\{name\}/"$pname"}"
  message="${message//\{version\}/"$ver"}"

  # THE LIST, read from the commit's own tree, and what it selects.
  if ! text="$(_snapshot_git -C "$PROJECT_ROOT" cat-file blob "$commit:$list" 2>/dev/null)"; then
    SNAPSHOT_WHY="release.snapshot.list is $list, and ${commit:0:12} holds no such file to read -- nothing written"
    return 1
  fi
  mapfile -t specs < <(pathlist_specs "$text")
  if [ "${#specs[@]}" -eq 0 ]; then
    SNAPSHOT_WHY="the list $list at ${commit:0:12} names no path -- nothing written"
    return 1
  fi
  if ! _snapshot_select "$PROJECT_ROOT" "$commit" "$work/index" "$work/sel" "${specs[@]}"; then
    SNAPSHOT_WHY+=" -- nothing written"
    return 1
  fi
  # AN INCLUDE LINE THAT MATCHES NOTHING IS A LIST THAT DRIFTED from the tree,
  # refused rather than shipped as a quietly smaller snapshot. An exclude that
  # matches nothing leaves nothing out, and is let be.
  for spec in "${specs[@]}"; do
    pathspec_excludes "$spec" && continue
    if ! _snapshot_git --index "$work/index" -C "$PROJECT_ROOT" ls-files --error-unmatch -- "$spec" >/dev/null 2>&1; then
      SNAPSHOT_WHY="the list $list holds '$spec', which matches no file at ${commit:0:12} -- nothing written"
      return 1
    fi
  done
  while IFS= read -r -d '' rec; do
    mode="${rec%% *}"
    if [ "$mode" = 160000 ]; then
      SNAPSHOT_WHY="the list selects ${rec#*$'\t'}, a gitlink, and the commit it names is not in the snapshot -- nothing written"
      return 1
    fi
    rest="${rec#* }"
    blobs+=("${rest%% *}")
  done <"$work/sel"
  if [ "${#blobs[@]}" -eq 0 ]; then
    SNAPSHOT_WHY="the list $list selects no file at ${commit:0:12} -- nothing written"
    return 1
  fi
  # The new repositories take the workroom's object format, whatever
  # init.defaultObjectFormat or GIT_DEFAULT_HASH says, so its blobs unpack there.
  if ! fmt="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse --show-object-format)"; then
    SNAPSHOT_WHY="git could not say the project's object format -- nothing written"
    return 1
  fi
  # EXACTLY THE SELECTED BLOBS, packed once from the workroom: unpacked into the
  # new repository, so no other workroom object reaches it, and into the
  # scratch where the publish branch is read, for the commit asked of its tip.
  if ! printf '%s\n' "${blobs[@]}" | LC_ALL=C sort -u >"$work/blobs" ||
    ! _snapshot_git -C "$PROJECT_ROOT" pack-objects -q --stdout <"$work/blobs" >"$work/pack"; then
    SNAPSHOT_WHY="git could not pack the shipped blobs of ${commit:0:12} -- nothing written"
    return 1
  fi
  # THE DATE, the source's committer date, read once for every commit made.
  if ! date="$(_snapshot_git -C "$PROJECT_ROOT" show -s --no-show-signature --format=%ct "$commit")"; then
    SNAPSHOT_WHY="git could not read the date of ${commit:0:12} -- nothing written"
    return 1
  fi

  # THE PARENT: the publish branch's tip, fetched with its history into the
  # scratch and checked there, before the new directory exists, and never from
  # a url naming the repository one of the project's own remotes names, asked
  # with git's local variables cleared, so the remotes are this project's.
  if [ "$no_parent" != 1 ] && [ -n "$url" ]; then
    rc=0
    own="$(
      git_local_env_clear || exit 3
      release_remote_naming "$url"
    )" || rc=$?
    case "$rc" in
      0)
        SNAPSHOT_WHY="release.publish.url names ${own#*$'\t'}, the repository this project's remote ${own%%$'\t'*} names, so its history is this project's own and a snapshot made on it would publish that history -- a first snapshot is made with --no-parent; nothing written"
        return 1
        ;;
      1) ;;
      *)
        SNAPSHOT_WHY="whether release.publish.url names the repository one of this project's remotes names cannot be told: $own -- nothing written"
        return 1
        ;;
    esac
    if ! err="$(_snapshot_git init -q --bare --template= --object-format="$fmt" "$work/parent.git" 2>&1)"; then
      SNAPSHOT_WHY="git could not make a repository in the run's scratch to read the publish branch in: ${err%%$'\n'*} -- nothing written"
      return 1
    fi
    if ! heads="$(_snapshot_remote "$work/parent.git" ls-remote --heads --end-of-options "$url" "refs/heads/$branch")"; then
      SNAPSHOT_WHY="cannot read the publish branch $branch at $(release_url_shown "$url"), so the snapshot's parent is unknown -- make it with --no-parent where there is no public repository yet; nothing written"
      return 1
    fi
    while read -r sha ref; do
      [ "$ref" != "refs/heads/$branch" ] || tip="$sha"
    done <<<"$heads"
    if [ -n "$tip" ]; then
      if ! _snapshot_remote "$work/parent.git" fetch -q --no-tags --no-write-fetch-head --end-of-options "$url" "refs/heads/$branch:refs/snapshot/parent"; then
        SNAPSHOT_WHY="cannot fetch the publish branch's tip ${tip:0:12} from $(release_url_shown "$url") -- nothing written"
        return 1
      fi
      got="$(_snapshot_git -C "$work/parent.git" rev-parse -q --verify refs/snapshot/parent 2>/dev/null)" || got=""
      if [ -z "$got" ]; then
        SNAPSHOT_WHY="git wrote no ref for the publish branch's tip ${tip:0:12} from $(release_url_shown "$url"): it takes nothing from a shallow repository, whose history ends in no parentless root (its words are above) -- nothing written"
        return 1
      fi
      if [ "$got" != "$tip" ]; then
        SNAPSHOT_WHY="the publish branch moved from ${tip:0:12} to ${got:0:12} while it was read -- nothing written"
        return 1
      fi
      if ! _snapshot_history "$work/parent.git" "$tip" "$list" "$author" "$work" "${specs[@]}"; then
        SNAPSHOT_WHY+=" -- refusing to make a snapshot on it; nothing written"
        return 1
      fi
      parent="$tip"
      # A PUBLISHED SNAPSHOT IS FOUND, NEVER MADE TWICE (issue 0240). Where the
      # tip is itself the snapshot of <commit>, the commit made on the tip's own
      # parent is the tip, so the snapshot is the tip, on that parent: a publish
      # that stopped once the branch had moved, or one run again once it
      # finished, reads the same sha as the run that published it, and makes no
      # second commit of one release. Asked by making that commit in the
      # scratch, where the tip's history was read and checked, so the new
      # repository holds no commit but the snapshot's.
      tparent="$(_snapshot_git -C "$work/parent.git" rev-parse -q --verify "$tip^1" 2>/dev/null)" || tparent=""
      if ! _snapshot_git -C "$work/parent.git" unpack-objects -q <"$work/pack" ||
        ! _snapshot_git --index "$work/trial.index" -C "$work/parent.git" update-index -z --index-info <"$work/sel" ||
        ! ttree="$(_snapshot_git --index "$work/trial.index" -C "$work/parent.git" write-tree)" ||
        ! trial="$(_snapshot_commit_tree "$work/parent.git" "$ttree" "$tparent")"; then
        SNAPSHOT_WHY="git could not ask whether the publish branch's tip ${tip:0:12} is already this snapshot -- nothing written"
        return 1
      fi
      [ "$trial" != "$tip" ] || parent="$tparent"
    fi
  fi

  # THE NEW REPOSITORY. From here a failure removes the directory it made.
  if ! mkdir -- "$placed"; then
    SNAPSHOT_WHY="cannot make $dir -- nothing written"
    return 1
  fi
  made=yes
  if ! err="$(_snapshot_git init -q --template= --object-format="$fmt" -b "$branch" "$placed" 2>&1)"; then
    _snapshot_abort "$made" "$placed" "git could not make a repository in $dir: ${err%%$'\n'*}"
    return 1
  fi
  # THE SELECTED BLOBS, packed above, unpacked here, and the checked history,
  # taken from the scratch, where it was read.
  if ! _snapshot_git -C "$placed" unpack-objects -q <"$work/pack"; then
    _snapshot_abort "$made" "$placed" "git could not copy the shipped blobs into $dir"
    return 1
  fi
  if [ -n "$tip" ] &&
    ! _snapshot_git -C "$placed" fetch -q --no-tags --no-write-fetch-head "$work/parent.git" "refs/snapshot/parent:refs/snapshot/parent"; then
    _snapshot_abort "$made" "$placed" "git could not take the checked publish branch into $dir"
    return 1
  fi
  if ! _snapshot_git -C "$placed" update-index -z --index-info <"$work/sel" ||
    ! SNAPSHOT_TREE="$(_snapshot_git -C "$placed" write-tree)"; then
    _snapshot_abort "$made" "$placed" "git could not write the snapshot's tree in $dir"
    return 1
  fi

  # THE COMMIT, made as _snapshot_commit_tree makes every snapshot's commit.
  if ! SNAPSHOT_COMMIT="$(_snapshot_commit_tree "$placed" "$SNAPSHOT_TREE" "$parent")"; then
    _snapshot_abort "$made" "$placed" "git could not make the snapshot's commit in $dir"
    return 1
  fi
  if ! _snapshot_git -C "$placed" update-ref "refs/heads/$branch" "$SNAPSHOT_COMMIT" ||
    { [ -n "$tip" ] && ! _snapshot_git -C "$placed" update-ref -d refs/snapshot/parent; } ||
    ! _snapshot_git -C "$placed" reset -q --hard; then
    _snapshot_abort "$made" "$placed" "git could not check the snapshot out in $dir"
    return 1
  fi

  # READ BACK: the commit's tree is the selection, in paths, modes and blobs,
  # its tree and parent are the ones made, and its author and committer are
  # release.snapshot.author as declared, which the next release's history check
  # reads it against.
  if ! _snapshot_git -C "$placed" ls-tree -r -z --full-tree "$SNAPSHOT_COMMIT" >"$work/back" ||
    ! _snapshot_norm "$work/sel" ls-files >"$work/want" ||
    ! _snapshot_norm "$work/back" ls-tree >"$work/got" ||
    [ ! -s "$work/want" ]; then
    _snapshot_abort "$made" "$placed" "git could not read the snapshot in $dir back"
    return 1
  fi
  if ! cmp -s "$work/want" "$work/got" ||
    [ "$(_snapshot_git -C "$placed" show -s --no-show-signature --format='%T %P%n%an <%ae>%n%cn <%ce>' "$SNAPSHOT_COMMIT")" != "$SNAPSHOT_TREE $parent"$'\n'"$author"$'\n'"$author" ]; then
    _snapshot_abort "$made" "$placed" "the snapshot in $dir does not read back as the selection, the parent and the identity it was made from"
    return 1
  fi
  SNAPSHOT_DIR="$placed" SNAPSHOT_PARENT="$parent" SNAPSHOT_LIST="$list" SNAPSHOT_BRANCH="$branch"
  return 0
}

# snapshot_verb -- `release snapshot`: the snapshot of the tag's commit, or of
# --commit's, made in the new directory by snapshot_build, and its shas
# printed. Refused, writing nothing, when the source is no commit.
snapshot_verb() {
  local commit from
  git_readonly_prime || die "release snapshot: git could not list its local variables, so none could be cleared -- nothing written"
  if [ -n "$snap_commit" ]; then
    commit="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse -q --verify "$snap_commit^{commit}" 2>/dev/null)" ||
      die "release snapshot: $snap_commit is not a commit here -- nothing written"
    from="$snap_commit"
  else
    from="$(release_tag_name "$(cfg_release_get tag)" "$version")"
    commit="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse -q --verify "refs/tags/$from^{commit}" 2>/dev/null)" ||
      die "release snapshot: there is no tag $from here -- cut the release first, or name a commit with --commit; nothing written"
  fi
  # A relative directory is read from the project root, where the command runs.
  case "$snap_dir" in /*) ;; *) snap_dir="$PROJECT_ROOT/$snap_dir" ;; esac
  [ "$snap_dir" = / ] || snap_dir="${snap_dir%/}"
  snapshot_build "$commit" "$snap_dir" "$no_parent" || die "release snapshot: $SNAPSHOT_WHY"
  printf 'release snapshot: %s\n' "$SNAPSHOT_DIR"
  printf '  from    %s (%s)\n' "$commit" "$from"
  printf '  list    %s\n' "$SNAPSHOT_LIST"
  printf '  tree    %s\n' "$SNAPSHOT_TREE"
  printf '  commit  %s\n' "$SNAPSHOT_COMMIT"
  printf '  parent  %s\n' "${SNAPSHOT_PARENT:-none}"
  printf '  branch  %s\n' "$SNAPSHOT_BRANCH"
}

# --- the publish flow (issue 0240) --------------------------------------------
#
# A PROJECT THAT DECLARES release.publish.url PUBLISHES A SNAPSHOT, NEVER ITS
# WORKROOM. Its cut pushes to release.remotes and stops, and `release publish
# <vX.Y.Z>` makes the tag's snapshot public, through CI on that very commit.
# Its steps, each reading its postcondition first, so a re-run continues:
#
#   resolve     the tag is here: the workroom commit the snapshot is made of
#   pre-flight  no remote of this project names the publish repository, by
#               OWNER/NAME on any host (release_remote_naming); the tag's
#               commit carries the release and holds the list; ci.query is
#               declared; and the url answers, its publish branch, candidate
#               branch and tag read. Every refusal is named, nothing is
#               written, and a url naming this project's own repository is
#               never read
#   snapshot    snapshot_build, in the run's scratch, on the public tip, where
#               a tip that is this snapshot already is found. --expect refuses
#               any other sha, and so are a public tag and a candidate holding
#               another commit, here, before anything is pushed
#   confirm     the work left, asked about once, as a cut asks (cut_confirm)
#   candidate   the snapshot pushed to its candidate branch and read back, then
#               ci.query asked about its sha, with no tag, up to ci.wait. Only
#               green goes on: red, a run still going at the bound, or no
#               verdict stops the run, and the publish branch and the tag stay
#               where they were
#   publish     the publish branch fast-forwarded to the snapshot, then the tag,
#               lightweight, at it, each read back; then the candidate branch,
#               its work done, deleted and its absence read back. A red
#               candidate never gets here, and stays as the record of it
#   object, after, ci
#               a cut's (cut_tail), against the repository release.repo names,
#               which is the public one, about the snapshot's sha
#
# NOTHING IS FORCED. A push the public repository refuses stops the run, naming
# what this run already pushed: a branch moved under it, or a ref another
# commit holds, is for a person to account for, and a tag is never moved.
#
# EVERY CALL TO THE PUBLIC REPOSITORY is made from a repository of the run's
# own (_snapshot_remote), so the url is read as the person's git reads it,
# never through this workroom's remotes or their rewrites, and every push is
# bounded, as a cut's are (cut_call).

# publish_read <repo> <url> <branch> <candidate> <tag> -- the public refs a
# publish reads, in one ls-remote made from <repo>, as one line:
# `read<TAB><branch><TAB><candidate><TAB><tag><TAB><kind>`, each the sha that
# ref is at, the tag's the commit it names, or `-` where there is none, and
# <kind> lightweight or annotated, `-` with no tag; or `UNANSWERED<TAB><why>`
# when the url did not answer. A reader, for release_wait. The tag is read by
# release_listed_tag, the one reader of a public tag, its peel asked for by
# name, as that reader needs.
publish_read() {
  local repo="$1" url="$2" listing heads tagged
  if ! listing="$(_snapshot_remote "$repo" ls-remote --end-of-options "$url" \
    "refs/heads/$3" "refs/heads/$4" "refs/tags/$5" "refs/tags/$5^{}" 2>&1)"; then
    printf 'UNANSWERED\t%s did not answer ls-remote: %s\n' "$(release_url_shown "$url")" "$(one_line "$listing")"
    return 0
  fi
  heads="$(awk -v b="refs/heads/$3" -v c="refs/heads/$4" '
    $2 == b { rb = $1 }
    $2 == c { rc = $1 }
    END { printf "%s\t%s\n", (rb == "" ? "-" : rb), (rc == "" ? "-" : rc) }
  ' <<<"$listing")"
  tagged="$(release_listed_tag "$listing" "$5")"
  printf 'read\t%s\t%s\n' "$heads" "${tagged:-$'-\t-'}"
}

# publish_refs <line> -- publish_read's `read` line into the caller's
# pub_branch, pub_cand and pub_tag, the commit the tag names, each empty for none,
# and pub_tag_kind: lightweight, annotated, or empty for no tag.
publish_refs() {
  local _read
  IFS=$'\t' read -r _read pub_branch pub_cand pub_tag pub_tag_kind <<<"$1"
  dash_to_empty pub_branch pub_cand pub_tag pub_tag_kind
}

# publish_reread <step> <when> -- the public refs read again, <when> it is (eg
# "after the push"), into the caller's pub_ names (publish_refs), from the
# caller's url, pbranch, cand and tag. A read that does not answer is asked
# again up to RELEASE_READBACK_SECONDS, as a cut's push step reads a remote
# back (issue 0194); one that never answers fails <step> as a read that could
# not tell, never as a ref that is not there.
publish_reread() {
  local answer
  answer="$(release_wait "$RELEASE_READBACK_SECONDS" UNANSWERED UNANSWERED \
    publish_read "$SCRATCH/public.git" "$url" "$pbranch" "$cand" "$tag")"
  case "${answer%%$'\t'*}" in
    read) publish_refs "$answer" ;;
    *) cut_fail "$1" "could not read $(release_url_shown "$url") $2, in the ${RELEASE_READBACK_SECONDS}s a read-back waits: ${answer#*$'\t'}" ;;
  esac
}

# publish_at <sha> -- `at <sha12>`, or `not there` for none.
publish_at() {
  if [ -z "$1" ]; then printf 'not there'; else printf 'at %s' "${1:0:12}"; fi
}

# publish_run -- `release publish <version>`: the steps above, their rows
# printed as a cut's are, through the table a cut prints (release_row). With
# --dry-run, every read and the snapshot, in the run's scratch, with every
# push, wait and after: reported as `would`.
publish_run() {
  local v="$version" tpl tag commit url shown pbranch cand object declared_repo drem
  local answer rc own out list ci_wait ci_secs="" cmd snap made_on cand_detail parts
  local pub_branch="" pub_cand="" pub_tag="" pub_tag_kind="" published=no wrote=no
  local moved tagged deleted want_kind ancestry
  local -a refusals=() cq=() left=()
  # The names a cut sets for cut_object_left, cut_confirm and cut_tail.
  local branch rel_at title repo="" body_file assets_wf
  local object_work="" object_detail="" attach_work=no assets_detail=""
  local confirmed=no ask_next="" prompted=""

  # The tag reaches ci.query alone (issue 0149), as in a cut.
  unset DEVBIN_RELEASE_TAG
  cfg_validate || die "release publish: $DEVBIN_DIR/config.yaml does not validate (above)"
  url="$(cfg_release_get publish.url)" || die "release publish: cannot read release.publish.url"
  [ -n "$url" ] ||
    die "release publish: release.publish.url is not declared, so this project publishes no snapshot, and its cut releases it whole -- declare the public repository there to publish through it"
  select_notes
  git_readonly_prime || die "release publish: git could not list its local variables, so none could be cleared -- nothing written"
  tpl="$(cfg_release_get tag)"
  tag="$(release_tag_name "$tpl" "$v")"
  branch="$(cfg_release_get branch)"
  pbranch="$(snapshot_publish_branch)"
  # Quoted, so bash 5.2's patsub_replacement cannot read an `&` as the match.
  cand="$(cfg_release_get publish.candidate)"
  cand="${cand//\{tag\}/"$tag"}"
  object="$(cfg_release_get object)"
  declared_repo="$(cfg_release_get repo)"
  drem="$(declared_remote)"
  assets_wf="$(cfg_release_get assets.workflow)" || die "release publish: cannot read release.assets.workflow"
  list="$(cfg_release_get snapshot.list)"
  ci_wait="$(cfg_release_get ci.wait)"
  shown="$(release_url_shown "$url")"
  cmd="${DEVBIN_INVOKE:-bin/devbin} release publish v$v"
  open_scratch "release publish"
  body_file="$SCRATCH/notes-body"
  local dry_note="" next="resume with"
  if [ "$dry_run" = 1 ]; then
    dry_note=" (DRY RUN: nothing is pushed; the snapshot is made in the run's scratch)"
    next="publish with"
  fi
  CUT_HEAD="release: publish $tag to $shown$dry_note -- $next: $cmd"

  # --- resolve -----------------------------------------------------
  commit="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse -q --verify "refs/tags/$tag^{commit}" 2>/dev/null)" ||
    cut_fail resolve "there is no tag $tag here -- cut the release first (${DEVBIN_INVOKE:-bin/devbin} release v$v), which under release.publish.url stops once it has pushed"
  cut_row resolve "done" "$tag is here, at ${commit:0:12}, the commit its snapshot is made of"

  # --- pre-flight --------------------------------------------------
  # Every check runs and every refusal is named, so one run says everything
  # that is wrong; nothing here writes. The remotes are this project's, asked
  # with git's local variables cleared, as the snapshot asks them.
  rc=0
  own="$(
    git_local_env_clear || exit 3
    release_remote_naming "$url"
  )" || rc=$?
  case "$rc" in
    0) refusals+=("this project's remote ${own%%$'\t'*} names ${own#*$'\t'}, the repository release.publish.url names, so a push or a fetch through it would carry this workroom's whole history there -- remove that remote, or point it at another repository, then publish") ;;
    1) ;;
    *) refusals+=("whether one of this project's remotes names the repository release.publish.url names cannot be told: $own") ;;
  esac
  # THE TAG MUST CARRY THE RELEASE, as a cut reads a tag it resumes: its
  # commit's version is the target and its note is dated, read from its own tree.
  answer="$(cut_stamp_read tag "$commit" "$v" name)"
  [ "${answer%%$'\t'*}" = already ] ||
    refusals+=("$tag's commit (${commit:0:12}) does not carry the release: ${answer#*$'\t'} -- a tag is never moved; release a later version")
  _snapshot_git -C "$PROJECT_ROOT" cat-file -e "$commit:$list" 2>/dev/null ||
    refusals+=("release.snapshot.list is $list, and $tag's commit (${commit:0:12}) holds no such file, so nothing says what ships")
  # CI ON THE CANDIDATE IS THE GATE, so a project that cannot read it publishes
  # nothing.
  if ! cfg_release_declared ci.query; then
    refusals+=("release.ci.query is not declared, so CI on the candidate cannot be read, and nothing is made public before it reads green")
  elif ! run_words cq release.ci.query "$(cfg_release_get ci.query)" 2>/dev/null; then
    refusals+=("ci.query holds no words, so CI on the candidate cannot be read")
  elif ! ci_secs="$(release_seconds "$ci_wait" 2>&1)"; then
    refusals+=("$(one_line "$ci_secs")")
  fi
  _snapshot_git check-ref-format "refs/heads/$cand" ||
    refusals+=("$cand, release.publish.candidate for $tag, is not a name git takes for a branch")
  # THE RELEASE OBJECT IS THE PUBLIC REPOSITORY'S, which no remote of this
  # project names, so release.repo must: read off a remote, it would name
  # another repository.
  if [ "$object" != none ] && [ -z "$declared_repo" ]; then
    refusals+=("release.repo is not declared, and object: $object reads the release object of the public repository, which no remote of this project names -- declare release.repo: OWNER/NAME")
  elif ! out="$(cut_gh_signed_in "$object")"; then
    refusals+=("$out")
  fi
  # THE URL ANSWERS, and its refs are read, unless it names this project's own
  # repository, which is never read.
  if [ "$rc" = 1 ]; then
    if ! out="$(_snapshot_git init -q --bare --template= "$SCRATCH/public.git" 2>&1)"; then
      refusals+=("git could not make a repository in the run's scratch to read $shown from: $(one_line "$out")")
    else
      answer="$(release_wait 0 "" UNANSWERED publish_read "$SCRATCH/public.git" "$url" "$pbranch" "$cand" "$tag")"
      case "${answer%%$'\t'*}" in
        read) publish_refs "$answer" ;;
        *) refusals+=("${answer#*$'\t'}") ;;
      esac
    fi
  fi
  if [ "${#refusals[@]}" -gt 0 ]; then
    cut_fail pre-flight "$(printf '%s; ' "${refusals[@]}" | sed 's/; $//')"
  fi
  cut_row pre-flight "done" "no remote of this project names the publish repository; $tag's commit carries the release and the list; $shown answers: $pbranch $(publish_at "$pub_branch"), $cand $(publish_at "$pub_cand"), $tag $(publish_at "$pub_tag")"

  # --- snapshot ----------------------------------------------------
  snapshot_build "$commit" "$SCRATCH/snapshot" 0 || cut_fail snapshot "$SNAPSHOT_WHY"
  snap="$SNAPSHOT_COMMIT"
  made_on="${SNAPSHOT_PARENT:0:12}"
  [ -n "$made_on" ] || made_on="no parent"
  # THE COMMIT APPROVED IS THE COMMIT PUBLISHED: a snapshot is approved by its
  # sha, and the same inputs give the same sha.
  if [ -n "$expect" ] && [ "$expect" != "$snap" ]; then
    cut_fail snapshot "the snapshot of $tag is $snap, and --expect names $expect: what is published is the commit approved, so another sha needs its own approval -- nothing pushed"
  fi
  cut_row snapshot "done" "${snap:0:12}, made of $tag (${commit:0:12}) over $SNAPSHOT_LIST, on $made_on$([ "$snap" != "$pub_branch" ] || printf '; the tip of %s is this snapshot already' "$pbranch")$([ -z "$expect" ] || printf ', the sha --expect names')"
  # A PUBLIC REF ANOTHER COMMIT HOLDS IS REFUSED BEFORE ANYTHING IS PUSHED: a
  # tag is never moved, and a release has one candidate, so a candidate that
  # holds another snapshot is a release changed after its candidate was pushed.
  # A TAG ALREADY IN THE PUBLIC HISTORY is a release published before a later
  # one was made on it: its snapshot on today's tip is another commit, and
  # there is nothing of it left to publish.
  if [ -n "$pub_tag" ] && [ "$pub_tag" != "$snap" ]; then
    # Asked through commit_direction, with git's local variables cleared as
    # every snapshot read is: the tag in the parent's history reads same or
    # forward from it.
    ancestry=""
    [ -z "$SNAPSHOT_PARENT" ] ||
      ancestry="$(git_local_env_clear && commit_direction "$SNAPSHOT_DIR" "$pub_tag" "$SNAPSHOT_PARENT")"
    if [ "$ancestry" = same ] || [ "$ancestry" = forward ]; then
      cut_fail publish "$tag is public already, at ${pub_tag:0:12}, in the history of $pbranch at $shown, which a later release was published on: nothing of it is left to publish, and a tag is never moved -- nothing pushed"
    fi
    cut_fail publish "$shown carries $tag at ${pub_tag:0:12}, and this release's snapshot is ${snap:0:12}: a tag is never moved -- nothing pushed"
  fi
  # PUBLISHED IS BOTH: the branch and the tag at the snapshot. A tag there with
  # the branch still to move is a tag pushed by another hand, and the branch
  # moves only once CI on the candidate reads green, in this run.
  if [ "$pub_tag" = "$snap" ] && [ "$pub_branch" = "$snap" ]; then published=yes; fi
  if [ "$published" = no ] && [ -n "$pub_cand" ] && [ "$pub_cand" != "$snap" ]; then
    cut_fail candidate "$cand at $shown holds ${pub_cand:0:12}, not this release's snapshot ${snap:0:12}: $tag changed after its candidate was pushed, and a release has one candidate -- release a later version; nothing pushed"
  fi

  # --- confirm -----------------------------------------------------
  if [ "$published" = no ]; then
    [ "$pub_cand" = "$snap" ] || left+=("push ${snap:0:12} to $cand at $shown, for CI to run on")
    [ "$pub_branch" = "$snap" ] || left+=("once ci.query reads green on it, fast-forward $pbranch at $shown to it")
    [ "$pub_tag" = "$snap" ] || left+=("tag $tag at it, lightweight")
    left+=("delete $cand, its work done")
  elif [ "$pub_cand" = "$snap" ]; then
    left+=("delete $cand at $shown, its work done")
  fi
  title="$(object_title "$tag" "$v")"
  if [ "$object" = local ]; then
    cut_notes_body "$commit" "$v" "$body_file" confirm
    cut_object_left
  fi
  cut_confirm "the publish" "release: publish $tag, snapshot ${snap:0:12}, to $shown"

  # --- candidate ---------------------------------------------------
  if [ "$published" = yes ]; then
    cut_row candidate already "$tag is at ${snap:0:12} at $shown, so its candidate has done its work"
  elif [ "$dry_run" = 1 ]; then
    if [ "$pub_cand" = "$snap" ]; then cand_detail="$cand holds ${snap:0:12} already"; else cand_detail="push ${snap:0:12} to $cand and read it back"; fi
    cut_row candidate would "$cand_detail; then ask ci.query about ${snap:0:12} for up to $ci_wait (ci.wait), and go on on green alone"
  else
    if [ "$pub_cand" = "$snap" ]; then
      cand_detail="$cand holds ${snap:0:12} already"
    else
      # Never --force: a candidate another commit holds was refused above, and
      # one pushed since is someone else's, which a rejection names.
      cut_call candidate "pushing ${snap:0:12} to $cand at $shown" \
        _snapshot_remote "$SNAPSHOT_DIR" push -q --end-of-options "$url" "$snap:refs/heads/$cand"
      CUT_OUTWARD+=", pushed ${snap:0:12} to $cand at $shown"
      publish_reread candidate "after the push"
      [ "$pub_cand" = "$snap" ] ||
        cut_fail candidate "$cand at $shown is $(publish_at "$pub_cand") after the push, not at ${snap:0:12}"
      cand_detail="pushed ${snap:0:12} to $cand and read it back"
    fi
    # ASKED ABOUT THE SNAPSHOT'S SHA, WITH NO TAG: the candidate branch's runs
    # are its verdict, and no public tag exists yet. Waited on while it answers
    # pending or none, up to ci.wait.
    answer="$(release_wait "$ci_secs" "pending none" unknown release_ci_verdict "$snap" "" "${cq[@]}")"
    case "${answer%%$'\t'*}" in
      green) cut_row candidate "done" "$cand_detail; ci.query answers green for ${snap:0:12}: ${answer#*$'\t'}" ;;
      pending | none)
        cut_fail candidate "$cand_detail; ci.query gave no verdict within $ci_wait (ci.wait) for ${snap:0:12}; last: ${answer%%$'\t'*}, ${answer#*$'\t'} -- $pbranch and $tag did not move: run $cmd again, which reads CI on the candidate again"
        ;;
      unknown)
        cut_fail candidate "$cand_detail; no verdict from ci.query for ${snap:0:12}: ${answer#*$'\t'} -- $pbranch and $tag did not move: run $cmd again once the query answers"
        ;;
      *)
        cut_fail candidate "$cand_detail; ci.query answers ${answer%%$'\t'*} for ${snap:0:12}: ${answer#*$'\t'} -- $pbranch and $tag did not move, and $cand stays as the record of it: fix it, then release the next version"
        ;;
    esac
  fi

  # --- publish -----------------------------------------------------
  if [ "$dry_run" = 1 ]; then
    parts=""
    [ "$pub_branch" = "$snap" ] || parts+="; fast-forward $pbranch to ${snap:0:12}"
    [ "$pub_tag" = "$snap" ] || parts+="; tag $tag at it, lightweight"
    if [ "$published" = no ] || [ -n "$pub_cand" ]; then parts+="; delete $cand"; fi
    if [ -z "$parts" ]; then
      cut_row publish already "$pbranch and $tag are at ${snap:0:12} at $shown, and $cand is not there"
    else
      cut_row publish would "${parts#; }, each read back"
    fi
  else
    # Read again, after CI: what moved meanwhile is read, never assumed.
    publish_reread publish "before anything moves"
    # THE TAG FIRST, as a question: the branch does not move for a tag that
    # could not follow it.
    if [ -n "$pub_tag" ] && [ "$pub_tag" != "$snap" ]; then
      cut_fail publish "$shown carries $tag at ${pub_tag:0:12}, not at the snapshot ${snap:0:12}: a tag is never moved -- $pbranch did not move"
    fi
    if [ "$pub_branch" = "$snap" ]; then
      moved="$pbranch was at ${snap:0:12} already"
    elif [ "$pub_branch" = "$SNAPSHOT_PARENT" ]; then
      # A fast-forward, never --force: the snapshot was made on this tip.
      cut_call publish "fast-forwarding $pbranch at $shown to ${snap:0:12}" \
        _snapshot_remote "$SNAPSHOT_DIR" push -q --end-of-options "$url" "$snap:refs/heads/$pbranch"
      CUT_OUTWARD+=", moved $pbranch at $shown to ${snap:0:12}"
      moved="fast-forwarded $pbranch to ${snap:0:12}"
      wrote=yes
    else
      cut_fail publish "$pbranch at $shown is $(publish_at "$pub_branch"), and the snapshot was made on $made_on, so it cannot fast-forward, and nothing is forced -- run $cmd again, which makes the snapshot on the new tip, a new sha, which --expect refuses until it is approved; $tag did not move"
    fi
    want_kind="$pub_tag_kind"
    if [ "$pub_tag" = "$snap" ]; then
      tagged="$tag was at ${snap:0:12} already, $pub_tag_kind"
    else
      # Lightweight: the commit pushed to the tag's ref, so it carries no
      # tagger identity. Never --force: a tag is never moved.
      cut_call publish "pushing $tag to $shown" \
        _snapshot_remote "$SNAPSHOT_DIR" push -q --end-of-options "$url" "$snap:refs/tags/$tag"
      CUT_OUTWARD+=", pushed $tag to $shown"
      tagged="tagged $tag at ${snap:0:12}, lightweight"
      want_kind=lightweight
      wrote=yes
    fi
    publish_reread publish "after the push"
    if [ "$pub_branch" != "$snap" ] || [ "$pub_tag" != "$snap" ] || [ "$pub_tag_kind" != "$want_kind" ]; then
      cut_fail publish "$shown does not read back as published: $pbranch $(publish_at "$pub_branch"), $tag $(publish_at "$pub_tag")${pub_tag_kind:+, $pub_tag_kind}, where both are to be at ${snap:0:12}, the tag $want_kind"
    fi
    # THE CANDIDATE, ITS WORK DONE, deleted once the branch and the tag read
    # back, and only while it holds the snapshot.
    if [ -z "$pub_cand" ]; then
      deleted="$cand is not there"
    elif [ "$pub_cand" = "$snap" ]; then
      # The lease makes the deletion conditional on the candidate still being
      # the snapshot, as just read, and forces nothing: a branch another push
      # moved since is left, and the push is refused.
      cut_call publish "deleting $cand at $shown" \
        _snapshot_remote "$SNAPSHOT_DIR" push -q "--force-with-lease=refs/heads/$cand:$snap" --end-of-options "$url" ":refs/heads/$cand"
      CUT_OUTWARD+=", deleted $cand at $shown"
      publish_reread publish "after deleting $cand"
      [ -z "$pub_cand" ] || cut_fail publish "$cand at $shown is still there, $(publish_at "$pub_cand"), after it was deleted"
      deleted="deleted $cand and read it back as gone"
      wrote=yes
    else
      deleted="left $cand as it is: it holds ${pub_cand:0:12}, not the snapshot"
    fi
    if [ "$wrote" = yes ]; then
      cut_row publish "done" "$moved; $tagged; each read back; $deleted"
    else
      cut_row publish already "$moved; $tagged; $deleted"
    fi
  fi

  # --- object, after, ci -------------------------------------------
  # A cut's, about the commit the public tag names, where CI and brew read it.
  commit="$snap"
  rel_at="${snap:0:12}"
  cut_tail
}

# status_report <version> -- `release status`: every step of a cut, read from the
# repository, its remotes and the release object, printed as the table a cut's
# summary prints (release_row), writing nothing. Exit 0 when every row was
# read, 1 when any row is UNREADABLE -- a map with a hole in it is not a
# complete answer, and a script reading the status must not take it for one.
#
# THE RELEASE COMMIT'S TREE IS ALWAYS MATERIALISED, before the tag as well as
# after it, so the commit step reads a commit and never the working tree: "HEAD's tree
# carries the stamp" is a question about HEAD, and a working tree carrying it
# uncommitted must read pending. The stamp step reads the working tree while the tag is
# absent and the release commit once it exists, since nothing after the tag step
# writes the tree.
# status_object_content <tag> <version> <materialised> <tree> <why> -- the object row's
# answer for an object that exists under `object: local`: its title and notes
# against this release's, the notes read from the release commit's own tree.
# Anything that cannot be read is UNREADABLE, never `already`.
status_object_content() {
  local tag="$1" v="$2" repo body_file="$SCRATCH/notes-body"
  if [ "$3" != yes ]; then
    printf 'UNREADABLE\ta release object exists for %s, and its notes cannot be compared: %s\n' "$tag" "$(one_line "$5")"
    return 0
  fi
  if ! notes_body "$4" "$v" >"$body_file" 2>"$body_file.err"; then
    printf 'UNREADABLE\ta release object exists for %s, and the notes body could not be read: %s\n' "$tag" "$(one_line "$(cat "$body_file.err")")"
    return 0
  fi
  if ! repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
    printf 'UNREADABLE\t%s\n' "$(one_line "${repo#release: }")"
    return 0
  fi
  release_read_object_content "$repo" "$tag" "$(object_title "$tag" "$v")" "$body_file"
}

# status_assets <tag> <detail> -- the object row's answer, under object: local with
# release.assets.workflow declared, for an object that carries this release's
# title and notes (<detail>): `already` only when its SHA256SUMS agrees with it
# too, read through the reader a cut's confirm step reads (release_read_assets), and
# as bounded, so status and a cut cannot disagree about whether the object step has work
# left. An answer that is neither is UNREADABLE, never passed on as a state.
status_assets() {
  local tag="$1" detail="$2" repo answer
  if ! repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
    printf 'UNREADABLE\t%s\n' "$(one_line "${repo#*release: }")"
    return 0
  fi
  answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
  case "${answer%%$'\t'*}" in
    already) printf 'already\t%s; %s\n' "$detail" "${answer#*$'\t'}" ;;
    pending | UNREADABLE) printf '%s\n' "$answer" ;;
    *) printf 'UNREADABLE\tthe assets reader answered "%s"\n' "$(one_line "$answer")" ;;
  esac
}

status_report() {
  local v="$1" tag rc_line commit source tree state detail unreadable=0
  local clean tag_row push_state push_detail object gates after
  tag="$(release_tag_name "$(cfg_release_get tag)" "$v")"
  rc_line="$(release_commit "$tag")" || exit 1
  commit="${rc_line%%$'\t'*}"
  source="${rc_line#*$'\t'}"

  open_scratch "release status"
  tree="$SCRATCH/commit"
  local materialised=yes why=""
  if ! why="$(materialise commit "$commit" "$v" 2>&1)"; then
    materialised=no
  fi

  row() {
    [ "$1" != UNREADABLE ] || unreadable=1
    release_row "$2" "$1" "$3"
  }
  split() {
    state="${1%%$'\t'*}"
    detail="${1#*$'\t'}"
  }

  printf 'release: status of %s, release commit %s (%s)\n' "$tag" "${commit:0:12}" \
    "$([ "$source" = tag ] && printf "the tag's commit" || printf 'HEAD, no tag yet')"

  row pending resolve "no postcondition: tag $tag, release commit ${commit:0:12}"
  row pending pre-flight "no postcondition: every run pre-flights"

  # The stamp step.
  if [ "$source" = tag ]; then
    if [ "$materialised" = yes ]; then
      split "$(release_read_stamp "$tree" "$v" name)"
    else
      state=UNREADABLE detail="${why//$'\n'/ }"
    fi
  else
    split "$(release_read_stamp "$PROJECT_ROOT" "$v" count)"
  fi
  row "$state" stamp "$detail"

  # The commit step: the stamp read against the release commit, and while the tag is
  # absent, the tree clean.
  if [ "$materialised" = yes ]; then
    split "$(release_read_stamp "$tree" "$v" "$([ "$source" = tag ] && printf name || printf count)")"
    if [ "$state" = already ]; then
      detail="${commit:0:12} carries the stamp"
      if [ "$source" = HEAD ]; then
        clean="$(release_read_clean)"
        state="${clean%%$'\t'*}"
        [ "$state" = already ] || detail="${clean#*$'\t'}"
      fi
    elif [ "$state" = pending ]; then
      detail="${commit:0:12} does not carry the stamp: $detail"
    fi
  else
    state=UNREADABLE detail="${why//$'\n'/ }"
  fi
  row "$state" commit "$detail"

  # The gates step: never already, since it leaves no postcondition the
  # repository can show.
  gates="$(cfg_release_list gates)"
  if [ -z "$gates" ]; then
    row skipped gates "no gates: declared"
  elif [ "$source" = tag ]; then
    row "not re-run" gates "the tag exists, so the gates are not re-run -- this says nothing about a verdict"
  else
    row pending gates "never already: the gates run on every run until the tag exists"
  fi

  # The tag, push and object steps are read before confirm's, whose state is a predicate over them.
  # With no materialised tree the message has nothing honest to be compared
  # with: the working tree's note is another commit's.
  tag_row="$(release_read_tag "$tag" "$([ "$materialised" = yes ] && printf '%s' "$tree")" "$v")"

  local remotes remote r_state r_detail branch
  branch="$(cfg_release_get branch)"
  if cfg_release_declared remotes; then
    remotes="$(cfg_release_list remotes)"
  else
    remotes="$(git remote)" || die "release status: cannot list this repository's remotes"
  fi
  push_state=already push_detail=""
  if [ -z "$remotes" ]; then
    push_state=UNREADABLE push_detail="this repository has no remote to push to"
  fi
  while IFS= read -r remote; do
    [ -n "$remote" ] || continue
    local answer
    # AN ENTRY THAT NAMES NO REMOTE IS NOT READ, as pre-flight refuses it (issue
    # 0189): it can be a url, whose userinfo would reach this row in devbin's
    # words and in git's.
    if git remote get-url "$remote" >/dev/null 2>&1; then
      answer="$(release_read_remote "$remote" "$branch" "$tag" "$commit")"
    else
      answer="UNREADABLE"$'\t'"remote $(release_url_shown "$remote") is declared and does not exist"
    fi
    r_state="${answer%%$'\t'*}"
    r_detail="${answer#*$'\t'}"
    push_detail+="; $r_detail"
    case "$r_state" in
      UNREADABLE) push_state=UNREADABLE ;;
      pending) [ "$push_state" = UNREADABLE ] || push_state=pending ;;
    esac
  done <<<"$remotes"
  push_detail="${push_detail#; }"

  local object_row object_state
  object="$(cfg_release_get object)"
  if [ "$object" = none ]; then
    object_row=$'skipped\tobject: none'
  else
    object_row="$(release_read_object "$object" "$tag" "$(cfg_release_get repo)" "$(declared_remote)")"
  fi
  # UNDER object: local AN OBJECT THAT EXISTS IS READ WHOLE, as a cut's confirm step
  # reads it and through the same reader: `already` only when it
  # carries this release's title and notes, so status and a cut cannot disagree
  # about whether the object step has work left.
  if [ "$object" = local ] && [ "${object_row%%$'\t'*}" = already ]; then
    object_row="$(status_object_content "$tag" "$v" "$materialised" "$tree" "$why")"
    # And with assets declared, its SHA256SUMS against it (ST0008 WP-08). The
    # key is read with its status: empty would skip the read in silence.
    local assets_wf
    assets_wf="$(cfg_release_get assets.workflow)" || die "release status: cannot read release.assets.workflow"
    if [ "${object_row%%$'\t'*}" = already ] && [ -n "$assets_wf" ]; then
      object_row="$(status_assets "$tag" "${object_row#*$'\t'}")"
    fi
  fi
  object_state="${object_row%%$'\t'*}"

  # The confirm step: not re-run only when no irreversible step has work left.
  # The object holds it only when it is the cut's to make: object: local, and
  # no release.publish.url, under which release publish makes it (issue 0240).
  local publish_url cut_object=no
  publish_url="$(cfg_release_get publish.url)" || die "release status: cannot read release.publish.url"
  if [ "$object" = local ] && [ -z "$publish_url" ]; then cut_object=yes; fi
  if [ "$push_state" = UNREADABLE ] || { [ "$cut_object" = yes ] && [ "$object_state" = UNREADABLE ]; }; then
    row UNREADABLE confirm "whether an irreversible step has work left cannot be read (push or object, below)"
  elif [ "$push_state" = already ] && { [ "$cut_object" = no ] || [ "$object_state" = already ]; }; then
    row "not re-run" confirm "no irreversible step has work left"
  else
    row pending confirm "never already: an irreversible step has work left"
  fi

  split "$tag_row"
  row "$state" tag "$detail"
  row "$push_state" push "$push_detail"
  # The publish steps (issue 0240), release publish's under
  # release.publish.url. That verb reads each against the snapshot it makes,
  # and status makes none and reads no public repository, so each is `not
  # read`: neither done nor to do, as far as status can say.
  local s
  for s in snapshot candidate publish; do
    if [ -z "$publish_url" ]; then
      row skipped "$s" "no publish.url declared"
    else
      row "not read" "$s" "${DEVBIN_INVOKE:-bin/devbin} release publish v$v reads it, against the snapshot it makes, which status does not"
    fi
  done
  split "$object_row"
  row "$state" object "$detail"

  after="$(cfg_release_list after)"
  if [ -z "$after" ]; then
    row skipped after "no after: declared"
  else
    row pending after "no postcondition: after: runs on every run that reaches it"
  fi
  if ! cfg_release_declared ci.query; then
    row skipped ci "no ci.query declared"
  elif ! is_true_word "$(cfg_release_get ci.tag)"; then
    row skipped ci "ci.tag is off: a cut does not wait for the tag's CI run"
  else
    row pending ci "no postcondition: ci.query is read on every run that reaches it"
  fi

  return "$unreadable"
}

case "$verb" in
  check)
    check_declaration
    select_notes
    check_notes || exit 1
    ;;
  notes)
    # Validated first, as `check` is: a malformed release: block must never be
    # read as its defaults and regenerate views from the wrong provider.
    cfg_validate || die "release notes: $DEVBIN_DIR/config.yaml does not validate (above)"
    select_notes
    write_notes
    ;;
  status)
    # Validated first, as `check` and `notes` are: a malformed release: block
    # read as its defaults would report a different project's release.
    cfg_validate || die "release status: $DEVBIN_DIR/config.yaml does not validate (above)"
    select_notes
    status_report "$version" || exit 1
    ;;
  attach)
    # Validated first, as every verb is: the assets keys are refused outside
    # object: local, and a malformed block would name another run.
    cfg_validate || die "release attach: $DEVBIN_DIR/config.yaml does not validate (above)"
    attach_verb "$version" "$from" || exit 1
    ;;
  snapshot)
    # Validated first, as every verb is: a key the snapshot reads beside one it
    # needs is refused, and a malformed block would name another list.
    cfg_validate || die "release snapshot: $DEVBIN_DIR/config.yaml does not validate (above)"
    snapshot_verb
    ;;
  publish)
    # BEHIND A GATE, AS A CUT IS, AND ITS DRY RUN NOT (issue 0240): the confirm
    # step asks through ask_person, which answers only inside one, and the run's
    # log is sealed beside a cut's. publish_run validates first, as cut_run does.
    if [ "$dry_run" = 1 ]; then
      publish_run
    else
      run_gate --label "release publish" --suffix PUBLISH --grammar generic \
        --out-dir "$(gate_out_dir release)" \
        --source "devbin's own publish sequence -- publish_run in this process, not a command line" \
        -- publish_run
    fi
    ;;
  cut)
    # THE REAL CUT RUNS BEHIND A GATE, THE DRY RUN DOES NOT (WP-05). The confirm step asks
    # through ask_person, which answers only inside a gate: the gate says
    # whether ITS stdin was a person's terminal (DEVBIN_GATE_TTY, 0088), and
    # hands everything inside it </dev/null. The generic grammar passes the
    # cut's own exit through, so 1 -- a step failed, the confirm step with nobody to ask
    # among them since issue 0130 -- reaches the caller as it is. No step exits
    # 2 or 3 (the header says so for 3, and this comment said otherwise until
    # issue 0118). A dry run makes no release, so it seals nothing of its own,
    # as fullcycle's dry run seals nothing: its verdict line is a prediction,
    # printed and not sealed (0181), and the gates it runs still seal theirs.
    if [ "$dry_run" = 1 ]; then
      cut_run
    else
      run_gate --label release --suffix RELEASE --grammar generic \
        --out-dir "$(gate_out_dir release)" \
        --source "devbin's own release sequence -- cut_run in this process, not a command line" \
        -- cut_run
    fi
    ;;
esac
