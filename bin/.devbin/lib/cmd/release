#!/usr/bin/env bash
#
# The built-in `release` (ST0007): one copy of the release sequence for every
# project that releases. Opt-in, like `publish`: a project enables
# it with `commands.release.enabled: true`, and a `release:` block does not
# enable it by being present.
#
#   release <--patch|--minor|--major|vX.Y.Z> [--dry-run] [--yes]   cut a release
#   release status <vX.Y.Z>                                         the resume map
#   release notes                                                   regenerate the notes views
#   release check                                                   the declaration, the writers, the notes views
#   release attach <vX.Y.Z>                                         CI-built assets onto the release object
#   release attach <vX.Y.Z> --from <dir>                            the files in <dir> onto it (issue 0226)
#   release snapshot <vX.Y.Z> <new-dir> [--no-parent]               the tag's public snapshot, made in <new-dir> (issue 0239)
#   release snapshot --commit <rev> <new-dir> [--no-parent]         the same of any commit, for an audit ahead of a cut
#   release gates [--rerun]                                         release.gates in place, under one seal (ST0011)
#   release                                                         usage, exit 1
#
# EVERY ARGUMENT IS PARSED BEFORE ANYTHING ACTS, and `-h` or `--help` in any
# position prints usage and exits 0. Issue 0064 recorded
# `macos prepare --help` rebuilding a project's app: a handler that acts on its
# first word before reading the rest cannot promise that --help is safe.
#
# A PROJECT OFFERS THE VERBS release.verbs NAMES, every one by default (ST0008
# WP-08). A verb it leaves out is refused with exit 2, the dispatcher's code for
# what is not available here, before anything else is read: so a project whose
# own command cuts its releases offers `check` and `attach` with the cut off,
# and a script can tell "switched off" (2) from "ran and failed" (1). A cut has
# no verb word on the command line, and is named `cut`.
#
# AS BUILT BY WP-06: the argument loop, `release check` (the declaration and the
# notes), `release notes`, whose providers are lib/release.notes, `release
# status`, whose readers are lib/release.steps, and a cut's steps, resolve to after, with
# --dry-run (cut_run), under every `object:`. Nothing in a cut exits 3 now.
# ST0008 WP-08 added release.verbs; `release attach`, which the object step of a
# cut runs too under object: local (attach_assets); and a writers check that
# reads every release-writing step (check_release_writers).
#
set -euo pipefail

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
# shellcheck source=lib/runlog
. "$DEVBIN_LIB/runlog"
# shellcheck source=lib/config
. "$DEVBIN_LIB/config"
# shellcheck source=lib/release.notes
. "$DEVBIN_LIB/release.notes"
# shellcheck source=lib/release.steps
. "$DEVBIN_LIB/release.steps"
# shellcheck source=lib/release.legs
. "$DEVBIN_LIB/release.legs"
# shellcheck source=lib/release.macos
. "$DEVBIN_LIB/release.macos"
# shellcheck source=lib/resolve
# command_active, for the cut's note back to brew (cut_back_to_brew).
. "$DEVBIN_LIB/resolve"

# usage -- the forms of the verbs this project offers, and only those.
usage() {
  local me="${DEVBIN_INVOKE:-bin/devbin} release" lead="usage:" v docs
  while IFS= read -r v; do
    if [ -z "$v" ] || ! offered "$v"; then continue; fi
    case "$v" in
      cut) printf '%s %s <--patch|--minor|--major|vX.Y.Z> [--dry-run] [--yes]\n' "$lead" "$me" ;;
      status) printf '%s %s %s <vX.Y.Z>\n' "$lead" "$me" "$v" ;;
      attach) printf '%s %s %s <vX.Y.Z> [--from <dir>]\n' "$lead" "$me" "$v" ;;
      snapshot) printf '%s %s %s <vX.Y.Z | --commit <rev>> <new-dir> [--no-parent]\n' "$lead" "$me" "$v" ;;
      gates) printf '%s %s %s [--rerun]\n' "$lead" "$me" "$v" ;;
      *) printf '%s %s %s\n' "$lead" "$me" "$v" ;;
    esac
    lead="      "
  done <<<"$ALL_VERBS"
  [ "$lead" != "usage:" ] || printf 'usage: none -- release.verbs offers no verb of %s\n' "$me"
  printf '\n'
  if offered cut; then
    printf '  Cut a release: confirm once, then stamp, commit, run every leg (the gates\n'
    printf '  and the candidate'"'"'s CI) under one wait, and tag and push once all are\n'
    printf '  green; then the release object and after:, all under that one yes. Each\n'
    printf '  step with a postcondition reads it first, so a re-run continues.\n'
    printf '  --dry-run makes no commit, tag, push or release object and runs no gate.\n'
    printf '  Under release.publish.url the candidate is the release commit'"'"'s snapshot,\n'
    printf '  pushed to that repository for its CI, and the push makes the snapshot\n'
    printf '  public there: its branch fast-forwarded and the tag at it. Nothing is forced.\n'
  fi
  if offered attach; then
    printf '  attach: the assets release.assets.workflow'"'"'s run at the release commit\n'
    printf '  built, on the candidate'"'"'s branch or at the tag, onto its release object,\n'
    printf '  with one SHA256SUMS over every asset. --from <dir> attaches the files in\n'
    printf '  <dir> instead, as the built-in macos attaches its app.\n'
  fi
  if offered snapshot; then
    printf '  snapshot: one commit holding the tag'"'"'s tracked files over\n'
    printf '  release.snapshot.list, made in <new-dir>, which must not exist yet: on the\n'
    printf '  tip of the publish branch at release.publish.url, or with no parent under\n'
    printf '  --no-parent or when there is no tip. --commit <rev> snapshots any commit.\n'
  fi
  if offered gates; then
    printf '  gates: release.gates, in order, in place, under one sealed run of their\n'
    printf '  own, tmp/release/<stamp>.GATES.{out,errors}: the record a cut reads for the\n'
    printf '  commit the tree stands on and this platform before it runs them again.\n'
    printf '  It reads that record first, as a cut does, and runs nothing where a\n'
    printf '  sealed green stands; --rerun runs them all the same.\n'
  fi
  if cfg_release_declared verbs; then
    printf '  This project'"'"'s release.verbs offers %s.\n' "${OFFERED//$'\n'/, }"
  fi
  # THE GUIDE BY ITS PLACE IN THIS MACHINE'S INSTALL (issue 0254): a bare
  # docs/configuration.md named a file in a checkout a brew user has not got.
  printf '  Declared in the release: block of bin/.devbin/config.yaml; see\n'
  if docs="$(devbin_docs_place "$PROJECT_ROOT")"; then
    printf '  %s/configuration.md.\n' "$docs"
  else
    printf "  configuration.md among devbin's guides, which are not here: %s.\n" "$docs"
  fi
}

# refuse <message> -- a usage refusal: usage on stderr, the reason, exit 1.
refuse() {
  usage >&2
  printf '\n' >&2
  die "release: $1"
}

# THE CONFIG IS LOADED FIRST, before --help, because usage prints only the verbs
# this project offers (ST0008 WP-08). Loading reads the file and acts on
# nothing; the dispatcher has already loaded it to send the command here.
#
# THE CONFIG CACHE DOES NOT CROSS INTO A HANDLER, and an empty cache would read
# as "declared nothing" -- every key at its default, in a project that declared
# otherwise. So a config that does not load stops the command.
cd "${PROJECT_ROOT:?}" || die "cannot enter $PROJECT_ROOT"
cfg_load "${DEVBIN_DIR:?}/config.yaml" || die "release: cannot read $DEVBIN_DIR/config.yaml"
ALL_VERBS="$(cfg_release_verbs)" || die "release: the release: schema names no verbs"
OFFERED="$(cfg_release_list verbs)" || die "release: cannot read release.verbs"

# offered <verb> -- true when this project's release.verbs offers <verb>.
offered() { grep -qxF -- "$1" <<<"$OFFERED"; }

# --help first, over every argument, so no later word can act or refuse first.
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

if [ $# -eq 0 ]; then
  usage >&2
  exit 1
fi

# --- parse ----------------------------------------------------------------
verb="cut"
target=""
version=""
dry_run=0
assume_yes=0
from=""
snap_commit=""
snap_dir=""
no_parent=0
snap_words=()
rerun=0

# Every verb but the cut has a word, read from the one list (cfg_release_verbs).
if [ "$1" != cut ] && grep -qxF -- "$1" <<<"$ALL_VERBS"; then
  verb="$1"
  shift
fi

# RELEASE PUBLISH IS RETIRED (ST0011): a cut under release.publish.url makes
# its snapshot public itself, once every leg is green. Named, so the word is
# not read as a cut's target.
if [ "$verb" = cut ] && [ "${1-}" = publish ]; then
  refuse "release publish is retired: a cut under release.publish.url pushes the release commit's snapshot to its candidate branch, and makes it public once every leg is green -- cut the release: ${DEVBIN_INVOKE:-bin/devbin} release vX.Y.Z"
fi

# A release.verbs THAT DOES NOT VALIDATE FAILS AS CONFIG, exit 1, before the
# refusal below reads it: a misspelt verb, or "-", would otherwise read as a
# verb switched off, exit 2, and a script that passes over what is switched off
# would pass over it in silence. The validator names what is wrong.
verbs_bad=""
while IFS= read -r v; do
  [ -z "$v" ] || grep -qxF -- "$v" <<<"$ALL_VERBS" || verbs_bad+=" $v"
done <<<"$OFFERED"
if [ -n "$verbs_bad" ] || { cfg_release_declared verbs && [ -z "$OFFERED" ]; }; then
  cfg_validate || true
  die "release: release.verbs in $DEVBIN_DIR/config.yaml does not validate (above), so which verbs this project offers cannot be read"
fi

# A VERB THIS PROJECT SWITCHED OFF IS REFUSED HERE, before its arguments are
# read and before anything else is: no validation, no git, no gh (ST0008 WP-08).
if ! offered "$verb"; then
  offers="${OFFERED//$'\n'/, }"
  warn "release: $verb is not available here: release.verbs offers ${offers:-no verb} ($DEVBIN_DIR/config.yaml)"
  # code-2: a verb release.verbs leaves out is not available here, which is
  # what 2 means from the dispatcher for a command.
  exit 2
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --patch | --minor | --major)
      [ "$verb" = cut ] || refuse "$1 is a cut's target, and this is release $verb"
      [ -z "$target" ] || refuse "one target only, got $target and $1"
      target="$1"
      ;;
    --dry-run)
      [ "$verb" = cut ] || refuse "--dry-run applies to a cut, not to release $verb"
      dry_run=1
      ;;
    --yes)
      [ "$verb" = cut ] || refuse "--yes applies to a cut, not to release $verb"
      assume_yes=1
      ;;
    --from)
      [ "$verb" = attach ] || refuse "--from applies to release attach, not to release $verb"
      [ -z "$from" ] || refuse "--from once only, got $from and ${2:-nothing}"
      [ $# -ge 2 ] && [ -n "$2" ] || refuse "--from needs a directory"
      # Read from the project root, where the command runs (it entered it
      # above), by physical_dir: a bare cd found a relative name through
      # CDPATH, and its printed line went into the path (issue 0267).
      [ -d "$2" ] || refuse "--from $2 is not a directory (a relative one is read from the project root)"
      physical_dir "$2" from || refuse "--from $2 could not be entered"
      shift
      ;;
    --commit)
      [ "$verb" = snapshot ] || refuse "--commit applies to release snapshot, not to release $verb"
      [ -z "$snap_commit" ] || refuse "--commit once only, got $snap_commit and ${2:-nothing}"
      [ $# -ge 2 ] && [ -n "$2" ] || refuse "--commit needs a commit"
      snap_commit="$2"
      shift
      ;;
    --no-parent)
      [ "$verb" = snapshot ] || refuse "--no-parent applies to release snapshot, not to release $verb"
      no_parent=1
      ;;
    --rerun)
      [ "$verb" = gates ] || refuse "--rerun applies to release gates, not to release $verb"
      rerun=1
      ;;
    -*)
      refuse "unknown argument: $1"
      ;;
    *)
      case "$verb" in
        cut)
          [ -z "$target" ] || refuse "one target only, got $target and $1"
          is_semver "${1#v}" || refuse "not a version: $1 (want vX.Y.Z or X.Y.Z)"
          target="v${1#v}"
          ;;
        status | attach)
          [ -z "$version" ] || refuse "release $verb takes one version, got $version and $1"
          is_semver "${1#v}" || refuse "not a version: $1 (want vX.Y.Z or X.Y.Z)"
          version="${1#v}"
          ;;
        # Its words are read once all are in: with --commit the one word is
        # the directory, without it the version and then the directory.
        snapshot) snap_words+=("$1") ;;
        *)
          refuse "release $verb takes no argument, got: $1"
          ;;
      esac
      ;;
  esac
  shift
done

case "$verb" in
  cut) [ -n "$target" ] || refuse "a cut needs a target: --patch, --minor, --major or vX.Y.Z" ;;
  status | attach) [ -n "$version" ] || refuse "release $verb needs a version" ;;
  snapshot)
    if [ -n "$snap_commit" ]; then
      [ "${#snap_words[@]}" -eq 1 ] || refuse "release snapshot --commit <rev> takes the new directory alone"
      snap_dir="${snap_words[0]}"
    else
      [ "${#snap_words[@]}" -eq 2 ] || refuse "release snapshot takes a version and a new directory, or --commit <rev> and a new directory"
      is_semver "${snap_words[0]#v}" || refuse "not a version: ${snap_words[0]} (want vX.Y.Z or X.Y.Z)"
      version="${snap_words[0]#v}"
      snap_dir="${snap_words[1]}"
    fi
    ;;
esac

# --- act ------------------------------------------------------------------
# The config was loaded, and the working directory entered, above.

# check_declaration -- validate, then print every release key with its value
# and whether the project declared it or it is the default.
check_declaration() {
  local key shape value from IFS=$' \t\n' i kw vw
  local -a keys=() values=() froms=()
  if ! cfg_validate; then
    die "release check: $DEVBIN_DIR/config.yaml does not validate (above)"
  fi
  printf 'release: declaration (%s)\n' "$DEVBIN_DIR/config.yaml"
  while read -r shape key _; do
    [ -n "$shape" ] || continue
    if cfg_release_declared "$key"; then from=declared; else from=default; fi
    if [ "$shape" = scalar ]; then
      value="$(cfg_release_get "$key")"
    else
      value="$(cfg_release_list "$key")"
      value="${value//$'\n'/, }"
      if [ -z "$value" ] && [ "$key" = remotes ]; then
        value="every remote git lists"
      fi
    fi
    keys+=("$key") values+=("${value:-(none)}") froms+=("$from")
  done <<<"$_DEVBIN_RELEASE_SCHEMA"
  # EACH COLUMN IS AS WIDE AS ITS LONGEST ENTRY, read off what this run prints
  # (issue 0207): a width written here was overrun by a key or a value added
  # later, and that row printed its source out of line.
  kw="$(_release_widest "${keys[@]}")"
  vw="$(_release_widest "${values[@]}")"
  for i in "${!keys[@]}"; do
    printf '  %-*s %-*s %s\n' "$kw" "${keys[$i]}" "$vw" "${values[$i]}" "${froms[$i]}"
  done
  check_release_writers
}

# check_release_writers -- one writer per release object. Under object:
# local the core writes it, so a workflow STEP that writes a release object is a
# second writer, whatever starts the workflow (ST0008 WP-08): a tag, a `release:`
# event, a dispatch. It races the core's create, or replaces what the core
# made. Each is named by file and line (release_workflow_writers), for the
# project to decide, and the warning leaves the exit status alone.
#
# A PASS IS NEVER READ FROM SILENCE. Every outcome prints a line: how many
# workflow files were read and that none writes a release object, a tree with
# none, and why nothing is looked for under `ci` or `none`.
#
# A WORKFLOW THAT COULD NOT BE READ IS NAMED, NOT SKIPPED, and the pass line
# then does not say none writes one. grep's exit 2 on an unreadable file was
# once read as "no match", which said there was no second writer when nobody
# had looked.
check_release_writers() {
  local object wf rc hits line what err n=0 writers=0 unread=0
  object="$(cfg_release_get object)" || die "release check: cannot read release.object"
  if [ "$object" != local ]; then
    printf 'release: object is %s, so the core makes no release object, and no second writer of one is looked for\n' "$object"
    return 0
  fi
  if [ ! -d .github/workflows ]; then
    printf 'release: there is no .github/workflows here, so no workflow writes a release object\n'
    return 0
  fi
  # The reader's words go to a file of their own, so a failure is named in them
  # and a word on stderr is never read as a step.
  if ! err="$(mktemp "${TMPDIR:-/tmp}/devbin-writers.XXXXXX")"; then
    printf 'release: WARNING: no file under %s to take the workflows'"'"' errors in, so no workflow was checked for a second writer\n' "${TMPDIR:-/tmp}"
    return 0
  fi
  for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
    [ -f "$wf" ] || continue
    n=$((n + 1))
    rc=0
    hits="$(release_workflow_writers "$wf" 2>"$err")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      printf 'release: WARNING: could not read %s (exit %s: %s), so whether it also makes the release object was not checked\n' \
        "$wf" "$rc" "$(one_line "$(cat "$err")")"
      unread=$((unread + 1))
      continue
    fi
    while IFS=$'\t' read -r line what; do
      [ -n "$line" ] || continue
      writers=$((writers + 1))
      printf 'release: WARNING: %s:%s %s, and object is local: both would make the\n' "$wf" "$line" "$what"
      printf '         release object. Declare release.object: ci if the workflow makes it,\n'
      printf '         or remove the step.\n'
    done <<<"$hits"
  done
  rm -f "$err"
  if [ "$n" -eq 0 ]; then
    printf 'release: .github/workflows holds no workflow file, so none writes a release object\n'
  elif [ "$writers" -eq 0 ] && [ "$unread" -eq 0 ]; then
    printf 'release: read %s workflow file(s) in .github/workflows, and none writes a release object by a step this check reads: gh or hub release, gh api on releases, the releases API, or a release action it knows\n' "$n"
  else
    printf 'release: read %s of %s workflow file(s) in .github/workflows: %s release-writing step(s), named above%s\n' \
      "$((n - unread))" "$n" "$writers" "$([ "$unread" -eq 0 ] || printf ', and %s that could not be read' "$unread")"
  fi
  return 0
}

# select_notes -- the notes provider this project declares. The library
# never reads config, so the facts it needs are read here and passed in.
select_notes() {
  local kind run
  kind="$(cfg_release_get notes.kind)" || die "release: cannot read release.notes.kind"
  run="$(cfg_release_get notes.run)" || die "release: cannot read release.notes.run"
  notes_select "$kind" "$run" "${DEVBIN_NAME:?}" || die "release: no notes provider (above)"
}

# check_notes -- the notes half of `release check`: the generated views
# match their source, the version this project claims has a note, and
# notes_lint passes that note.
#
# BOTH HALVES WARN AND CARRY ON, so one run names everything wrong; the status
# is 1 if either found anything. A kind that generates no views says so, in
# words that cannot be read as "every view is current" -- zero views compared is
# a fact about the kind, and a count of zero printed as a pass would hide it.
check_notes() {
  local kind compare verdict path n=0 stale=0 rc=0 v state
  kind="$(cfg_release_get notes.kind)" || die "release: cannot read release.notes.kind"
  if compare="$(notes_views_check "$PROJECT_ROOT")"; then
    while read -r verdict path; do
      [ -n "$verdict" ] || continue
      n=$((n + 1))
      case "$verdict" in
        current) ;;
        STALE)
          warn "$path is STALE -- regenerate with: $DEVBIN_INVOKE release notes"
          stale=$((stale + 1))
          ;;
        *)
          # Not reachable through the shipped kinds, which print only the two
          # verdicts; refused here all the same, because an answer this reader
          # does not recognise must never count as current.
          warn "release check: the notes provider answered '$verdict $path', which is neither current nor STALE"
          stale=$((stale + 1))
          ;;
      esac
    done <<<"$compare"
    if [ "$n" -eq 0 ]; then
      printf 'release: notes.kind %s generates no views, so none were compared\n' "$kind"
    else
      printf 'release: %s of %s generated view(s) current\n' "$((n - stale))" "$n"
    fi
    [ "$stale" -eq 0 ] || rc=1
  else
    warn "release check: the generated views could not be compared (above)"
    rc=1
  fi

  v="$(read_version)"
  if ! is_semver "$v"; then
    warn "release check: this project's version reads '$v', which is not X.Y.Z, so its note cannot be looked up"
    rc=1
  elif ! state="$(notes_state "$PROJECT_ROOT" "$v")"; then
    warn "release check: the note for $v could not be read (above)"
    rc=1
  elif [ "$state" = absent ]; then
    warn "this project's version is $v and there is no $(notes_where "$v") -- the notes describe a version it no longer claims to be"
    rc=1
  else
    printf 'release: the note for %s is %s\n' "$v" "$state"
    notes_lint "$PROJECT_ROOT" "$v" || rc=1
  fi
  return "$rc"
}

# check_trigger -- release check's word on the next cut's candidate (ST0011
# WP-02c): where a cut is offered and has a candidate read by the built-in
# query, in a git repository with a commit, whether a push of the candidate's
# branch, for the tag the tree's version fills, starts release.ci.workflow as
# committed at HEAD, given the files the release commit would change, the
# stamp's own (release_owned), asked as the cut's pre-flight asks it
# (release_fires_read). A push that would start no run, or whose trigger
# cannot be read, is a finding, status 1. Elsewhere it says why nothing is
# asked, and finds nothing. With derived: declared no file is passed, as the
# cut passes none. Under release.publish.url the candidate is the snapshot,
# whose files the cut reads once it has made it, so the stamp's files stand in
# here, and the line says so.
check_trigger() {
  local v tag ref sha owned derived line rc=0 premise=""
  local -a paths=()
  if ! offered cut; then
    printf 'release: trigger not asked: release.verbs offers no cut, so no candidate is pushed\n'
    return 0
  fi
  if ! cut_candidate_declared; then
    printf 'release: trigger not asked: release.ci.query is -, the opt-out, so a cut has no candidate\n'
    return 0
  fi
  # Outside a repository git says so on stderr; this line says it in its own words.
  if ! sha="$(git_readonly rev-parse --verify --quiet HEAD 2>/dev/null)"; then
    printf 'release: trigger not asked: %s is not a git repository with a commit, and a trigger is read as committed\n' "$PROJECT_ROOT"
    return 0
  fi
  v="$(read_version)"
  tag="$(release_tag_name "$(cfg_release_get tag)" "$v")"
  if ! ref="$(cut_candidate_ref "$tag")"; then
    warn "release check: $ref"
    return 1
  fi
  if ! derived="$(cfg_release_list derived)"; then
    warn "release check: release.derived cannot be read"
    return 1
  fi
  if [ -z "$derived" ]; then
    if ! owned="$(release_owned "$PROJECT_ROOT" "$v")"; then
      warn "release check: the files the release commit would change cannot be listed (above)"
      return 1
    fi
    [ -z "$owned" ] || mapfile -t paths <<<"$owned"
  fi
  [ -z "$(cfg_release_get publish.url)" ] ||
    premise=", the stamp's files standing in for the snapshot's, which a cut reads once it has made it"
  line="$(release_fires_read "$ref" "$sha" "${paths[@]}")" || rc=$?
  case "$rc" in
    0) printf 'release: a push of %s at %s starts release.ci.workflow%s: %s\n' "$ref" "${sha:0:12}" "$premise" "$line" ;;
    3) printf 'release: trigger not asked: %s\n' "$line" ;;
    *)
      warn "release check: $line"
      return 1
      ;;
  esac
  return 0
}

# write_notes -- `release notes`: regenerate the generated views.
write_notes() {
  local written path n=0
  written="$(notes_views "$PROJECT_ROOT")" || die "release notes: the views were not regenerated (above)"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    printf 'release: wrote %s\n' "$path"
    n=$((n + 1))
  done <<<"$written"
  if [ "$n" -eq 0 ]; then
    printf 'release: notes.kind %s generates no views, so nothing was written\n' "$(cfg_release_get notes.kind)"
  fi
  return 0
}

# open_scratch <who> -- the run's ONE scratch root, outside the project, and the
# ONE trap that removes it (WP-04, run_exit). Every commit the run materialises is written
# into a directory of its own under the root, with its index beside that
# directory, so an interrupt at any point leaves nothing behind: until WP-04
# the tree WAS the root and the index its sibling, which the trap missed.
# Opened in this shell, never in a `$(...)`, because a trap
# set in a subshell is gone when the subshell is.
SCRATCH=""
open_scratch() {
  [ -z "$SCRATCH" ] || return 0
  SCRATCH="$(release_scratch "$PROJECT_ROOT")" || die "$1: no scratch directory to read a commit in (above)"
  # shellcheck disable=SC2064 # expand now: the path is fixed, and a later
  # reassignment must not change what is removed.
  trap "run_exit '$SCRATCH'" EXIT
}

# run_exit <scratch> -- the run's one exit trap, whatever ends the run: a stop,
# a die, the end, or a signal, since bash runs it on TERM, HUP and a Ctrl-C
# too (measured, bash 5.3). The local gates' run, when one still runs, is
# stopped, its whole group (legs_local_stop), so no gate goes on in the tree
# once the cut has gone: the run is a group of its own, which no signal to the
# cut's group reaches, and its wrapper outlives a TERM or a hangup to that
# group, so the stop still finds it (release_group_start). The scratch goes
# next, and only then is anything written: what was stopped, and a candidate
# this run pushed and never reached the delete of (legs_cand_note).
#
# A WRITE HERE MAY HAVE NO READER. A Ctrl-C, a hangup or a TERM sent to the
# cut's job reaches its whole group, the tee its output runs through
# included, so stderr may lead to a pipe nobody reads. A write there would
# end this trap with SIGPIPE before the scratch went (measured, bash 5.3), so
# SIGPIPE is ignored first, and each line goes through run_exit_say.
run_exit() {
  local stopped="$LEG_LOCAL_STOPPED" macos=no
  trap '' PIPE
  legs_local_stop
  # The macOS stage's run too, before the scratch holding its group's id goes.
  if release_macos_stop "$RELEASE_POLL_SECONDS"; then macos=yes; fi
  rm -rf "$1"
  [ "$stopped" = yes ] || [ "$LEG_LOCAL_STOPPED" = no ] ||
    run_exit_say 'release: legs: the local gates were stopped as the run ended, their whole process group'
  [ "$macos" = no ] ||
    run_exit_say 'release: legs: the macOS stage was stopped as the run ended, its whole process group'
  legs_cand_note
}

# run_exit_say <line> -- one line of the run's exit on stderr, where tee takes
# it into the run's log. When that write fails, the tee having gone with the
# signal that ended the run, the line goes to the terminal where a person is
# at one (gate_tty_flag), so a Ctrl-C still shows it. With neither, nobody can
# read it, and the next cut of the release deletes a candidate it names.
run_exit_say() {
  # stdout to stderr first, then bash's own write-error notice to nowhere.
  printf '%s\n' "$1" >&2 2>/dev/null && return 0
  [ "$(gate_tty_flag)" = 1 ] || return 0
  # A terminal that cannot be written has nobody at it to read the line.
  { printf '%s\n' "$1" >/dev/tty; } 2>/dev/null || :
}

# materialise <name> <commit> <version> -- <commit>'s whole tree, written into
# $SCRATCH/<name>, checked for every path the release owns. The reason is on
# stderr when it cannot be. open_scratch first.
materialise() {
  local owned
  local -a paths=()
  owned="$(release_owned "$PROJECT_ROOT" "$3")" || return 1
  mapfile -t paths <<<"$owned"
  release_materialise "$2" "$SCRATCH/$1" "${paths[@]}"
}

# release_one_repository <who> -- git's local variables cleared from THIS
# shell, once, at the start of the verb <who> names (`release`, `release
# status`, `release gates`), so every git read and write after it asks the
# one repository at the project root (ST0011): release_commit's and
# release_dirt's, which read the environment the writes use, and
# git_head_identity's, which clears it for itself, as the seal's commit lines
# read it. An inherited GIT_DIR, from a hook or a linked worktree's, would
# otherwise have a seal name one repository's commit while the cut committed
# into another. Through git_local_env_clear_named, which names a variable that
# was set, with the repository used instead, so a run never changes
# repositories in silence; a git that cannot list them stops the verb, and so
# does a clear whose naming line could not be written, each saying which.
# lib/cmd/macos clears them through the same helper before it reads the
# release commit (read_release_commit).
release_one_repository() {
  local rc=0
  git_local_env_clear_named "$1" "$PROJECT_ROOT" || rc=$?
  case "$rc" in
    0) ;;
    2) die "$1: git's local variables were cleared and the line naming them could not be written, so the run would change repositories in silence" ;;
    *) die "$1: git cannot list its local variables (git rev-parse --local-env-vars), so one inherited here could point a read or a write at another repository" ;;
  esac
}

# gates_sealed <sha> -- the gates in `gl`, release.gates as gates_list read it,
# in order, in place, under one sealed run of their own,
# tmp/release/<stamp>.GATES.{out,errors}, standing on <sha>, the commit the
# tree is (ST0011). THE ONE CALL the cut's local leg and `release gates` both
# make, each over release.gates as it read it once, so the pair either leaves
# is one producer's, and a remote leg's copy of it is
# the same record; the PUBLISH pair is sealed the same way. Its status is the
# run's -- 0 only when a gate ran, every gate passed and none wrote to the tree
# or committed -- AND THE RECORD MUST READ BACK: the verdict a cut reads for
# <sha> is green, naming the seal this run wrote. A green that does not, its
# tree moved before the seal, say, is a pass no later run would remember, so it
# fails, naming what stands instead. NO ARM REACHES THAT FAILURE: release_gates_run
# fails every change it can see, so only a change made between its last read
# and the seal, or a newer record written beside this one by another run,
# leaves a pass that does not read back; it is kept as the one read that says
# the record a cut will trust is the one just made. The cut's local leg decides
# on this status, never on a read of the record while the run writes it.
gates_sealed() {
  local sha="$1" why seal verdict
  # THE RECORD NAMES ITS SCOPE: the list goes in the invocation block's `from:`
  # line, and each gate is an argument of the one command the run ran. The
  # list is the declared one, never the verb's argv, so no flag of devbin's
  # reaches release_gates_run through it.
  if ! run_gate --label "release gates" --suffix GATES --grammar generic --purge \
    --out-dir "$(gate_out_dir release)" \
    --source "release.gates ($(printf '%s, ' "${gl[@]}" | sed 's/, $//')) -- release_gates_run in this process, not a command line" \
    -- release_gates_run "${gl[@]}"; then
    return 1
  fi
  # run_gate leaves the seal it wrote in its `errors` global (open_run_log).
  seal="$(abs_path "$errors")"
  verdict="$(release_gates_verdict "$sha")"
  if [ "${verdict%%$'\t'*}" = green ] && [ "${verdict#*$'\t'}" = "$seal" ]; then
    return 0
  fi
  why="the gates passed, and the record a cut reads for ${sha:0:12} is not this run's green: ${verdict%%$'\t'*}, ${verdict#*$'\t'}"
  printf 'release: gates: %s\n' "$why"
  [ -z "${RELEASE_GATES_WHY:-}" ] || printf '%s\n' "$why" >"$RELEASE_GATES_WHY" ||
    warn "could not write the gates' refusal to $RELEASE_GATES_WHY"
  return 1
}

# gates_list <list> -- the gates of release.gates, as read, into the caller's
# array `gl`, one element per declared gate.
gates_list() {
  local g
  gl=()
  while IFS= read -r g; do
    [ -z "$g" ] || gl+=("$g")
  done <<<"$1"
}

# gates_decision_words <state> -- release gates' decision in words, from a
# release_gates_word line: `<detail>, so they are not run again` when it is
# `already`, else `<detail>, so they run`: its legs row, or its line before
# the run. Pure.
gates_decision_words() {
  if [ "${1%%$'\t'*}" = already ]; then
    printf '%s, so they are not run again\n' "${1#*$'\t'}"
  else
    printf '%s, so they run\n' "${1#*$'\t'}"
  fi
}

# gates_verb -- `release gates [--rerun]`: THE DECLARED GATES, IN PLACE, UNDER
# ONE SEAL (ST0011): the record a cut's local leg reads for the commit the
# tree stands on and this platform, made the way that leg makes it
# (gates_sealed), and what a remote leg runs on its host, its pair kept under
# that leg's own directory. A TREE THAT IS NOT ONE COMMIT, CLEAN, IS REFUSED
# BEFORE ANYTHING RUNS: its seal could stand for no commit, so it would be a
# green no cut reads, and nothing is written. Clean is git_head_identity's
# grammar's, read by git_identity_clean.
#
# IT READS FIRST, THEN WRITES, through release_gates_state, which maps a fresh
# read of the record through release_gates_word, the one rule for whether the
# gates may be skipped at this commit, whoever asks: a sealed green for it on
# this platform prints the cut's row and runs nothing, 0; no record that
# stands runs the list, and a record that cannot be read runs it over that,
# saying why (gates_decision_words). --rerun runs the list whatever stands. A
# remote leg's host reads its own record, in the fresh worktree it runs in. 0
# when the gates are already or pass, 1 when they fail.
#
# RELEASE_GATES_WHY is unset first: gates_sealed writes its refusal to the file
# it names, which a cut names for its own local leg alone, so one inherited
# from the environment would have this verb write where nobody here chose.
gates_verb() {
  local stood list answer
  unset RELEASE_GATES_WHY
  release_one_repository "release gates"
  stood="$(git_head_identity "$PROJECT_ROOT")"
  git_identity_clean "$stood" ||
    die "release gates: the tree is not one commit, clean ($stood), so a run here would be a record of no commit -- commit or stash first"
  list="$(cfg_release_list gates)" || die "release gates: cannot read release.gates"
  gates_list "$list"
  if [ "$rerun" = 0 ]; then
    answer="$(release_gates_state "$stood")"
    if [ "${answer%%$'\t'*}" = already ]; then
      release_row legs already "the local gates: $(gates_decision_words "$answer") (--rerun runs them)"
      return 0
    fi
    printf 'release: gates: %s\n' "$(gates_decision_words "$answer")"
  fi
  # The purge after the seal reads RUNLOG_KEEP_RUNS: refused before anything
  # runs, never found after a green.
  runlog_assert_keep_runs
  gates_sealed "$stood"
}

# ---------------------------------------------------------------------------
# THE LEGS (ST0011, design.md's leg contract): every leg a cut waits on, behind
# one pair, leg_start <leg> and leg_read <leg>, each answering one
# `<word><TAB><detail>` line in ci-state's five words (green, failed, pending,
# none, unknown), 0 whenever it answered. <leg> is `local` (the declared gates
# in place at the release commit), `candidate` (the matrix on the candidate
# ref), `legs.<name>` (a remote leg on the host the name aliases) or `macos`
# (the macOS stage). The cut sets the context once, before the loop: LEG_ROOT,
# the project root; LEG_PROJECT, the name a remote host's bare repository
# takes; LEG_SHA, the release commit R; LEG_REF, the candidate's ref; and the
# candidate's own: LEG_CAND_SHA (R, or in the publish shape its snapshot S),
# LEG_CAND_REMOTE (the remote it is pushed to, or in the publish shape
# release.publish.url), LEG_CAND_REPO (the repository its git calls are made
# from: empty for the project's own, or in the publish shape the snapshot's,
# since S is in no other; _leg_cand_git) and LEG_CAND_SHOWN (LEG_CAND_REMOTE as
# a line names it: the remote's name, or the url as release_url_shown shows
# it). A remote leg runs through lib/release.legs and the macOS stage through
# lib/release.macos, each passed the context it reads, since neither library
# reads config. A start that finds its leg green already starts nothing.
LEG_ROOT="" LEG_PROJECT="" LEG_SHA="" LEG_REF="" LEG_CAND_SHA="" LEG_CAND_REMOTE="" LEG_CAND_REPO="" LEG_CAND_SHOWN=""
LEG_CQ=() LEGS=() LEGS_T0=0
# Pre-flight's reading of release.legs (ST0011 WP-05): each host it reached,
# a leg of the cut as legs.<host>, and each it could not, `<host><TAB><why>`,
# named and recorded as not run, never waited for. LEGS_MACOS is yes where the
# project declares the macOS stage (cfg_macos_declared), a leg of the cut.
LEGS_REMOTE=() LEGS_ABSENT=() LEGS_MACOS=no

# legs_project_name -- the name a remote host's bare repository takes:
# project.name, else the project root's own name. The one read of it, which
# pre-flight holds to the runner's rule (release_leg_project_problem) before
# anything is stamped, and the legs step passes to each host.
legs_project_name() {
  local n
  n="$(cfg_get project.name)" || n=""
  printf '%s\n' "${n:-${PROJECT_ROOT##*/}}"
}

# _leg_cand_git <verb> [<option>...] -- [<refspec>...] -- THE ONE DOOR for the
# candidate's git calls to its remote: its push, the clear and the delete of
# its ref, and the read of it. From the project root through
# release_git_remote, to LEG_CAND_REMOTE, where LEG_CAND_REPO is empty; else
# from LEG_CAND_REPO, the snapshot's repository, through _snapshot_remote, to
# the url after --end-of-options, so a url is never read as an option.
_leg_cand_git() {
  local verb="$1"
  local -a opts=()
  shift
  while [ $# -gt 0 ] && [ "$1" != -- ]; do
    opts+=("$1")
    shift
  done
  [ $# -eq 0 ] || shift
  if [ -n "$LEG_CAND_REPO" ]; then
    _snapshot_remote "$LEG_CAND_REPO" "$verb" ${opts[@]+"${opts[@]}"} --end-of-options "$LEG_CAND_REMOTE" "$@"
  else
    release_git_remote "$verb" ${opts[@]+"${opts[@]}"} "$LEG_CAND_REMOTE" "$@"
  fi
}
# Each leg's last answer, by leg: the loop prints a line when it changes, and
# a leg whose answer is green is not read again.
declare -gA LEG_LAST=()
# Each leg's seconds from the legs step's start (LEGS_T0, before any leg
# starts) to its last change of word, for its seal line.
declare -gA LEG_SECS=()

leg_start() {
  case "$1" in
    local) _leg_local_start ;;
    candidate) _leg_candidate_start ;;
    legs.*) _leg_remote_start "$1" ;;
    macos) release_macos_start "$LEG_ROOT" "$LEG_SHA" "$SCRATCH" ;;
    *) printf 'unknown\tno such leg: %s\n' "$1" ;;
  esac
}

# _leg_remote_start <legs.host> -- a remote leg at its start: green already,
# the pair its host's run of R left as _leg_at_start reads it, answered as it
# stands, starting nothing, as the local leg's is; else started on its host.
_leg_remote_start() {
  local v
  v="$(_leg_at_start "$1")"
  if [ "${v%%$'\t'*}" = green ]; then
    printf '%s\n' "$v"
    return 0
  fi
  release_leg_start "$LEG_ROOT" "${1#legs.}" "$LEG_PROJECT" "$LEG_SHA"
}

leg_read() {
  case "$1" in
    local) _leg_local_read ;;
    candidate) _leg_candidate_read ;;
    legs.*) release_leg_read "$LEG_ROOT" "${1#legs.}" "$LEG_PROJECT" "$LEG_SHA" ;;
    macos) release_macos_read "$LEG_ROOT" "$LEG_SHA" ;;
    *) printf 'unknown\tno such leg: %s\n' "$1" ;;
  esac
}

# _leg_at_start <leg> -- what <leg> answers before its start starts anything:
# the local gates' sealed verdict on LEG_SHA, or the candidate's run read by
# its ref. THE ONE READ OF "GREEN AT ITS START": a leg green here is not
# started, and a dry run predicts by the same read, so the two cannot come to
# disagree about which legs a cut runs.
_leg_at_start() {
  case "$1" in
    local) release_gates_verdict "$LEG_SHA" ;;
    candidate) _leg_candidate_verdict ;;
    *) leg_read "$1" ;;
  esac
}

# THE LOCAL LEG: the declared gates in place at R under one seal of their own,
# gates_sealed run in the background in a process group of its own
# (release_group_start), its output kept in scratch, so the loop reads the
# candidate meanwhile. leg_start runs in the cut's own shell, never in a
# command substitution, so the run is a job of the cut's, which the cut alone
# can reap and stop.
#
# WHILE ITS RUN IS ALIVE THE LEG IS PENDING, WHATEVER THE RECORD SAYS, AND ONCE
# THE RUN HAS ENDED ITS OWN STATUS DECIDES, the record giving only the detail.
# The record is no verdict while the run writes it: a red run's seal is empty
# for a moment while its close rewrites it, which every reader of a seal reads
# as green, and until the new run's first line the newest record of R is the
# last run's, so a cut run again after a red would read that red as this run's.
# gates_sealed's status is 0 only when the record reads back green, naming the
# seal this run wrote; any other is red.
#
# A GATE THAT OPENS THE TERMINAL ITSELF TO ASK (ssh, gpg, sudo asking) IS
# STOPPED THERE, since the run's group is not the terminal's foreground group
# (release_group_start): stopped, the run still reads as running, and the cut
# waits until it is interrupted. Such a gate runs under `release gates`, which
# runs the gates in its own process, in the terminal's foreground.
LEG_LOCAL_PID="" LEG_LOCAL_OUT="" LEG_LOCAL_GROUP="" LEG_LOCAL_STATE="" LEG_LOCAL_RC="" LEG_LOCAL_STOPPED=no
_leg_local_start() {
  local v
  v="$(_leg_at_start local)"
  if [ "${v%%$'\t'*}" = green ]; then
    printf '%s\n' "$v"
    return 0
  fi
  LEG_LOCAL_OUT="$SCRATCH/leg.local.out" LEG_LOCAL_GROUP="$SCRATCH/leg.local.group"
  release_group_start "$LEG_LOCAL_OUT" "" "$LEG_LOCAL_GROUP" _leg_local_run
  LEG_LOCAL_PID=$! LEG_LOCAL_STATE=running
  printf 'pending\trelease.gates (%s) run in place at %s, their output shown once they end\n' \
    "$(printf '%s, ' "${gl[@]}" | sed 's/, $//')" "${LEG_SHA:0:12}"
}

# _leg_local_run -- the local leg's run, in its own group: the gates' refusal
# file is named here, in the run's own shell and never exported, so no gate
# sees it in its environment (cut_run).
_leg_local_run() {
  RELEASE_GATES_WHY="$SCRATCH/gates.why"
  rm -f "$RELEASE_GATES_WHY"
  gates_sealed "$LEG_SHA"
}

# The leg's read, in a command substitution, from what the cut's shell knows
# of the run: pending while it runs; once it has ended (legs_local_reap), its
# status, with the record's detail and the gates' own refusal. With no run of
# this cut's, a start that started none, the leg is a stop, named, never a
# wait that nothing would end.
_leg_local_read() {
  local v why=""
  case "$LEG_LOCAL_STATE" in
    running)
      printf 'pending\trelease.gates are running at %s\n' "${LEG_SHA:0:12}"
      return 0
      ;;
    ended) ;;
    *)
      printf 'failed\tno run of the local gates was started at %s, and no green record stands for it\n' "${LEG_SHA:0:12}"
      return 0
      ;;
  esac
  v="$(release_gates_verdict "$LEG_SHA")"
  # The gates' own refusal (a gate that changed the tree or committed, a pass
  # that does not read back), as gates_sealed and release_gates_run write it.
  [ ! -s "$SCRATCH/gates.why" ] || why=" -- $(one_line "$(cat "$SCRATCH/gates.why")")"
  # A run that failed before its record's commit: line leaves the record an
  # earlier run wrote the newest, so its exit is named and the record is only
  # "the newest record", whichever run wrote it.
  if [ "$LEG_LOCAL_RC" != 0 ]; then
    printf 'failed\trelease.gates ended (exit %s) at %s, and the newest record of it reads %s: %s%s\n' \
      "$LEG_LOCAL_RC" "${LEG_SHA:0:12}" "${v%%$'\t'*}" "${v#*$'\t'}" "$why"
  elif [ "${v%%$'\t'*}" = green ]; then
    printf '%s\n' "$v"
  else
    printf 'failed\trelease.gates passed, and the record a cut reads for %s does not read green: %s, %s\n' "${LEG_SHA:0:12}" "${v%%$'\t'*}" "${v#*$'\t'}"
  fi
}

# legs_local_running -- 0 while the local run is a running job of this shell,
# 1 when it is not, 3 when the job table could not be written to be read,
# said once (release_job_running, the one read of it).
legs_local_running() {
  release_job_running "$LEG_LOCAL_PID" "$SCRATCH/leg.jobs" "the local gates"
}

# legs_local_reap -- the local run, once it no longer runs, reaped in this
# shell (_legs_local_wait). Nothing while it runs, or when there is none. The
# loop reaps it before it reads the leg, since leg_read runs in a command
# substitution, which cannot wait for a job of the cut's.
legs_local_reap() {
  if [ "$LEG_LOCAL_STATE" = running ] && ! legs_local_running; then
    _legs_local_wait
  fi
}

# _legs_local_wait -- wait for the local run and keep its status:
# LEG_LOCAL_RC, LEG_LOCAL_STATE ended, and its pid let go, so nothing later
# asks after a number another process may hold by then.
_legs_local_wait() {
  LEG_LOCAL_RC=0
  wait "$LEG_LOCAL_PID" || LEG_LOCAL_RC=$?
  LEG_LOCAL_PID="" LEG_LOCAL_STATE=ended
}

# legs_local_stop -- the local run stopped, if it still runs, then reaped. A
# kill of its own process reached none of its children, so the gate and its
# tee ran on in the tree once the cut had gone, holding every descriptor they
# inherited: release_run_stop sends its whole group TERM, gives it one poll,
# RELEASE_POLL_SECONDS, to end, and sends KILL if it still runs.
# LEG_LOCAL_STOPPED reads yes only where that stop signalled the run's group
# and the run's reaped status is the TERM's or the KILL's: a run that ended on
# its own between the read and the kill keeps its own status, read as the loop
# reads it (legs_stop). Nothing to do when no run runs.
legs_local_stop() {
  local rc=0
  [ "$LEG_LOCAL_STATE" = running ] || return 0
  release_run_stop legs_local_running "$LEG_LOCAL_PID" "$LEG_LOCAL_GROUP" "$RELEASE_POLL_SECONDS" \
    "release: legs: the local gates' process group was never written to $LEG_LOCAL_GROUP, so the stop signals their wrapper's own process alone, and a process their run started may run on" ||
    rc=$?
  _legs_local_wait
  if [ "$rc" = 0 ] && release_stopped_status "$LEG_LOCAL_RC"; then
    LEG_LOCAL_STOPPED=yes
  fi
}

# legs_show_local -- the local gates' own output, printed into the cut's once
# their run has ended or been stopped, and reaped, so it is whole: it ran in
# the background, kept in scratch, so the loop's lines stayed readable while
# it ran.
LEG_LOCAL_SHOWN=no
legs_show_local() {
  [ -n "$LEG_LOCAL_OUT" ] && [ -f "$LEG_LOCAL_OUT" ] && [ "$LEG_LOCAL_SHOWN" = no ] || return 0
  LEG_LOCAL_SHOWN=yes
  printf '\nrelease: legs: the local gates said:\n'
  cat "$LEG_LOCAL_OUT"
}

# THE CANDIDATE LEG: the matrix on LEG_REF, read by ci.query for LEG_CAND_SHA
# with the ref as DEVBIN_RELEASE_TAG, so only runs on the candidate count. Its
# start is the push, the legs step's first act: bounded as every write is,
# read back, and a push refused, or one that does not answer, is the leg's
# answer, failed or unknown, which stops the cut before any other leg starts.
#
# EVERY READ IS ONE BOUNDED ASK (release_wait, asking once): cut off at the
# time left to the loop's deadline, LEGS_DEADLINE, and never below
# RELEASE_ASK_FLOOR_SECONDS, so a query that hangs answers unknown, naming the
# bound, its whole process group killed and its scratch gone, as every ask of
# a query is. Before the loop has a deadline the floor is the bound.
LEGS_DEADLINE=""
_leg_candidate_verdict() {
  local left=0
  [ -z "$LEGS_DEADLINE" ] || left=$((LEGS_DEADLINE - SECONDS))
  [ "$left" -ge 0 ] || left=0
  release_wait "$left" "" unknown release_ci_verdict "$LEG_CAND_SHA" "$LEG_REF" "${LEG_CQ[@]}"
}

# The start runs in the cut's shell (legs_step), so the push it makes joins
# what the stop's sentence names (CUT_OUTWARD), and what the run's exit names
# when it never reaches the delete (LEGS_CAND_PUSHED); one cut off at its
# bound may have landed, and is named as tried. LEGS_CAND_PUSHED reads
# `trying` from before the push's call: the push runs in a process group of
# its own, which a Ctrl-C does not reach, so it can land after a signal has
# ended the run, and the run's exit names the candidate as pushed or being
# pushed.
#
# AN EARLIER RUN'S RED IS NOT THIS PUSH'S. A cut run again after a red
# candidate pushes the candidate again, and CI registers the new run a moment
# later, so the first reads can still name the earlier run's red. A red read
# before the push is kept (LEG_CAND_BEFORE), and the same answer after it reads
# pending, naming it, until CI says anything else: this push's run, green or
# red, or nothing new before the timeout, which names it.
#
# AND THIS PUSH MUST MAKE A RUN. A ref that already holds the release commit,
# as a run killed before its delete leaves one, takes the same commit again as
# no change, and CI starts nothing (measured, git 2.56: "Everything
# up-to-date", no receive event), so the earlier red would read as pending to
# the timeout. Such a ref, read red at the start, is deleted first, under a
# lease on that commit, and read back as gone (_leg_candidate_clear), so the
# push makes a run of its own. A ref that cannot be read is pushed to as it is.
LEG_CAND_BEFORE="" LEGS_CAND_PUSHED=no
_leg_candidate_start() {
  local v rc=0 held
  v="$(_leg_at_start candidate)"
  if [ "${v%%$'\t'*}" = green ]; then
    printf '%s\n' "$v"
    return 0
  fi
  if [ "${v%%$'\t'*}" = failed ]; then
    LEG_CAND_BEFORE="$v"
    if held="$(_legs_cand_held)" && [ "$held" = "$LEG_CAND_SHA" ]; then
      _leg_candidate_clear || return 0
    fi
  fi
  LEGS_CAND_PUSHED=trying
  cut_call_rc --reads "git ls-remote $LEG_CAND_SHOWN refs/heads/$LEG_REF reads it" "the candidate push to $LEG_CAND_SHOWN" \
    _leg_cand_git push -q -- "$LEG_CAND_SHA:refs/heads/$LEG_REF" >&2 || rc=$?
  case "$rc" in
    0)
      CUT_OUTWARD+=", pushed the candidate $LEG_REF to $LEG_CAND_SHOWN"
      LEGS_CAND_PUSHED=yes
      ;;
    124)
      CUT_OUTWARD+=", tried to push the candidate $LEG_REF to $LEG_CAND_SHOWN, which did not answer"
      LEGS_CAND_PUSHED=yes
      printf 'unknown\t%s\n' "$(one_line "$CUT_CALL_WHY")"
      return 0
      ;;
    *)
      LEGS_CAND_PUSHED=no
      printf 'failed\t%s\n' "$(one_line "$CUT_CALL_WHY")"
      return 0
      ;;
  esac
  if ! held="$(_legs_cand_held)"; then
    printf 'unknown\tthe candidate was pushed to %s and its ref could not be read back: %s\n' "$LEG_CAND_SHOWN" "$held"
    return 0
  fi
  if [ "$held" != "$LEG_CAND_SHA" ]; then
    printf 'unknown\tthe candidate was pushed to %s and %s reads back %s, not %s\n' "$LEG_CAND_SHOWN" "$LEG_REF" "${held:-nothing}" "${LEG_CAND_SHA:0:12}"
    return 0
  fi
  printf 'pending\t%s pushed to %s on %s; its run is read by that ref\n' "${LEG_CAND_SHA:0:12}" "$LEG_REF" "$LEG_CAND_SHOWN"
}

# _leg_candidate_clear -- the candidate ref an earlier run left holding the
# release commit, read red, deleted under a lease on that commit and read back
# as gone, so the push after it makes a run of its own. 0, saying so on
# stderr, when the ref is gone. 1 when the delete is refused, does not answer
# or does not read back as gone, printing the leg's answer for that, failed
# or unknown, which stops the cut at once, as a refused push does.
_leg_candidate_clear() {
  local rc=0 held
  cut_call_rc --reads "git ls-remote $LEG_CAND_SHOWN refs/heads/$LEG_REF reads it" \
    "deleting the candidate $LEG_REF an earlier run left on $LEG_CAND_SHOWN" _leg_cand_git push -q \
    "--force-with-lease=refs/heads/$LEG_REF:$LEG_CAND_SHA" -- ":refs/heads/$LEG_REF" >&2 || rc=$?
  case "$rc" in
    0) ;;
    124)
      CUT_OUTWARD+=", tried to delete the candidate $LEG_REF an earlier run left on $LEG_CAND_SHOWN, which did not answer"
      printf 'unknown\t%s\n' "$(one_line "$CUT_CALL_WHY")"
      return 1
      ;;
    *)
      printf 'failed\t%s holds %s, read red, so a push of it would start no run, and deleting it failed: %s\n' \
        "$LEG_REF" "${LEG_CAND_SHA:0:12}" "$(one_line "$CUT_CALL_WHY")"
      return 1
      ;;
  esac
  CUT_OUTWARD+=", deleted the candidate $LEG_REF an earlier run left on $LEG_CAND_SHOWN"
  if ! held="$(_legs_cand_held)"; then
    printf 'unknown\tthe candidate %s an earlier run left on %s was deleted, and its ref could not be read back: %s\n' "$LEG_REF" "$LEG_CAND_SHOWN" "$held"
    return 1
  fi
  if [ -n "$held" ]; then
    printf 'unknown\tthe candidate %s an earlier run left on %s was deleted, and it reads back %s\n' "$LEG_REF" "$LEG_CAND_SHOWN" "${held:0:12}"
    return 1
  fi
  printf 'release: legs: the candidate %s an earlier run left on %s, holding %s and read red, was deleted, so this push makes a run of its own\n' \
    "$LEG_REF" "$LEG_CAND_SHOWN" "${LEG_CAND_SHA:0:12}" >&2
}

_leg_candidate_read() {
  local v
  v="$(_leg_candidate_verdict)"
  if [ -n "$LEG_CAND_BEFORE" ] && [ "$v" = "$LEG_CAND_BEFORE" ]; then
    printf 'pending\tthe red of a run before this push, and none of this push yet: %s\n' "${v#*$'\t'}"
    return 0
  fi
  printf '%s\n' "$v"
}

# legs_stop <why> -- the legs step stops red: the local run stopped, its whole
# group, and its output shown, each remote leg left to finish named with where
# its seal lands, every leg's line in the RELEASE seal, then the step FAILED
# with <why>, a stop that deletes the candidate (cut_fail, legs_cand_delete).
# Nothing is public: no tag exists, and the candidate is gone or named.
legs_stop() {
  local why="$1" leg leg_word
  legs_local_stop
  [ "$LEG_LOCAL_STOPPED" = no ] || printf 'release: legs: the local gates were stopped, their whole process group, and their output follows\n'
  # The local leg's line says what became of a run the loop last read as
  # running: stopped by this stop, or ended on its own, its status deciding.
  if [ "${LEG_LAST[local]+set}" = set ] && [ "${LEG_LAST[local]%%$'\t'*}" = pending ]; then
    if [ "$LEG_LOCAL_STOPPED" = yes ]; then
      LEG_LAST[local]="none"$'\t'"release.gates were stopped by the cut at ${LEG_SHA:0:12} before they ended"
    else
      LEG_LAST[local]="$(_leg_local_read)"
    fi
    LEG_SECS[local]=$((SECONDS - LEGS_T0))
  fi
  legs_show_local
  # The macOS stage's run, a group of its own like the local gates', stopped
  # the same way, and its line says what became of a run the loop last read as
  # running: stopped by this stop, or ended on its own, its status deciding.
  local macos_stopped=no
  if release_macos_stop "$RELEASE_POLL_SECONDS"; then
    macos_stopped=yes
    printf 'release: legs: the macOS stage was stopped, its whole process group; its log, if its run opened one, is the newest MACOS pair under %s\n' "$(gate_out_dir release)"
  fi
  if [ "${LEG_LAST[macos]+set}" = set ] && [ "${LEG_LAST[macos]%%$'\t'*}" = pending ]; then
    if [ "$macos_stopped" = yes ]; then
      LEG_LAST[macos]="none"$'\t'"the macOS stage was stopped by the cut at ${LEG_SHA:0:12} before it ended"
    else
      LEG_LAST[macos]="$(release_macos_read "$LEG_ROOT" "$LEG_SHA")"
    fi
    LEG_SECS[macos]=$((SECONDS - LEGS_T0))
  fi
  for leg in "${LEGS[@]}"; do
    case "$leg" in
      legs.*)
        # Only a host whose run the loop last read as running has one to
        # finish: not one already green, one whose start failed, or one after
        # it that never started.
        leg_word="${LEG_LAST[$leg]:-none}"
        [ "${leg_word%%$'\t'*}" = pending ] || continue
        printf 'release: legs: %s is left to finish on its host; its seal lands in %s when read\n' "$leg" "$(gate_out_dir release)/legs/${leg#legs.}/"
        ;;
    esac
  done
  legs_lines
  cut_fail legs "$why"
}

# legs_cand_delete -- the candidate ref gone from its remote (AC-2.3): once the
# tag is pushed, and at any stop of a cut whose legs step named a candidate
# (cut_fail), once, whatever calls it. Read first: a ref holding LEG_CAND_SHA
# is deleted with a lease on that sha, so a ref moved since is never deleted,
# then read back; a ref that is not there is nothing to do, whoever pushed it,
# and a resumed cut deletes the one a killed run left. Whatever is left is
# named in LEGS_CAND_LEFT, and the answer is 1: a ref holding this release's
# sha that will not go, with the command that deletes it; a ref that could not
# be read, with that command for when it holds this release's sha; and a ref
# holding another sha, which is not this release's to delete, with none. A
# dry run deletes nothing. ONCE is LEGS_CAND_DELETE_STARTED, set as it starts;
# LEGS_CAND_DELETED reads yes only once it has reached its verdict, so a run a
# signal ends during the delete still names the candidate (legs_cand_note).
LEGS_CAND_DELETE_STARTED=no LEGS_CAND_DELETED=no LEGS_CAND_LEFT=""
legs_cand_delete() {
  local rc=0
  [ -n "$LEG_CAND_REMOTE" ] && [ "$LEGS_CAND_DELETE_STARTED" = no ] && [ "${dry_run:-0}" = 0 ] || return 0
  LEGS_CAND_DELETE_STARTED=yes
  _legs_cand_delete || rc=$?
  LEGS_CAND_DELETED=yes
  return "$rc"
}

# _legs_cand_delete -- legs_cand_delete's read, delete and read-back, its
# answer legs_cand_delete's.
_legs_cand_delete() {
  local held why="" remedy
  remedy=" -- delete it by hand: git push $LEG_CAND_SHOWN :refs/heads/$LEG_REF"
  if ! held="$(_legs_cand_held)"; then
    why="its ref could not be read: $held"
    remedy=" -- if git ls-remote $LEG_CAND_SHOWN refs/heads/$LEG_REF reads ${LEG_CAND_SHA:0:12}, delete it by hand: git push $LEG_CAND_SHOWN :refs/heads/$LEG_REF"
  elif [ -z "$held" ]; then
    return 0
  elif [ "$held" != "$LEG_CAND_SHA" ]; then
    why="it holds ${held:0:12}, not this release's ${LEG_CAND_SHA:0:12}, so it was left as it is, not this run's to delete"
    remedy=""
  elif ! cut_call_rc --reads "git ls-remote $LEG_CAND_SHOWN refs/heads/$LEG_REF reads it" \
    "deleting the candidate $LEG_REF on $LEG_CAND_SHOWN" _leg_cand_git push -q \
    "--force-with-lease=refs/heads/$LEG_REF:$LEG_CAND_SHA" -- ":refs/heads/$LEG_REF" >&2; then
    why="$(one_line "$CUT_CALL_WHY")"
  elif ! held="$(_legs_cand_held)"; then
    why="the delete went through, and the ref could not be read back: $held"
  elif [ -n "$held" ]; then
    why="the delete went through, and the ref reads back ${held:0:12}"
  else
    CUT_OUTWARD+=", deleted the candidate $LEG_REF from $LEG_CAND_SHOWN"
    printf 'release: legs: the candidate %s was deleted from %s\n' "$LEG_REF" "$LEG_CAND_SHOWN"
    return 0
  fi
  LEGS_CAND_LEFT="the candidate $LEG_REF on $LEG_CAND_SHOWN was NOT deleted ($why)$remedy"
  printf 'release: legs: %s\n' "$LEGS_CAND_LEFT"
  return 1
}

# _legs_cand_held -- the sha the candidate ref holds on its remote, nothing
# when the remote holds no such ref; 1, saying why, when it could not be read.
# A read that fails or does not answer is asked again up to
# RELEASE_READBACK_SECONDS (release_wait), as the push step's read-back is
# (issue 0194): a remote is slowest straight after taking a push.
_legs_cand_held() {
  local answer
  answer="$(release_wait "$RELEASE_READBACK_SECONDS" UNANSWERED UNANSWERED _legs_cand_read)"
  case "${answer%%$'\t'*}" in
    held) printf '%s' "${answer#*$'\t'}" ;;
    absent) ;;
    *)
      printf '%s' "${answer#*$'\t'}"
      return 1
      ;;
  esac
}

# _legs_cand_read -- release_wait's reader of the candidate ref:
# `held<TAB><sha>`, `absent<TAB>`, or `UNANSWERED<TAB><why>` when ls-remote
# failed, git's own words kept in the wait's scratch.
_legs_cand_read() {
  local out rc=0 err="${RELEASE_WAIT_DIR:?}/cand.err"
  out="$(_leg_cand_git ls-remote -- "refs/heads/$LEG_REF" 2>"$err")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'UNANSWERED\tgit ls-remote %s exited %s: %s\n' "$LEG_CAND_SHOWN" "$rc" "$(head -n 1 "$err")"
  elif [ -z "$out" ]; then
    printf 'absent\t\n'
  else
    printf 'held\t%s\n' "${out%%$'\t'*}"
  fi
}

# legs_cand_note -- at the run's exit (run_exit), a candidate this run pushed,
# tried to, or was pushing, whose delete never reached its verdict, a die or a
# signal having ended the run before the delete or during it, named with the
# command that removes it (run_exit_say). A stop and the end reach the delete
# themselves (legs_cand_delete), which names what it could not do.
legs_cand_note() {
  local what="" verdict="was NOT deleted: the run ended before its delete"
  case "$LEGS_CAND_PUSHED" in
    yes) ;;
    trying) what=", pushed or being pushed," ;;
    *) return 0 ;;
  esac
  [ "$LEGS_CAND_DELETED" = no ] || return 0
  [ "$LEGS_CAND_DELETE_STARTED" = no ] || verdict="may not be deleted: the run ended during its delete"
  run_exit_say "release: legs: the candidate $LEG_REF on $LEG_CAND_SHOWN$what $verdict -- the next cut of this release deletes it, or delete it by hand: git push $LEG_CAND_SHOWN :refs/heads/$LEG_REF"
}

# legs_lines -- the RELEASE seal's line per leg (cut_leg_line): its last
# answer, its sha, and its seconds from the legs step's start to that answer, 0
# for a leg green at its start; then a line for each remote leg pre-flight
# could not reach, `none`, absent and not run, with why (ST0011 WP-05).
legs_lines() {
  local leg sha a
  for leg in "${LEGS[@]}"; do
    if [ "$leg" = candidate ]; then
      sha="$LEG_CAND_SHA"
    else
      sha="$LEG_SHA"
    fi
    cut_leg_line "$leg" "$sha" "${LEG_SECS[$leg]:-0}" "${LEG_LAST[$leg]:-none$'\t'not read}"
  done
  for a in "${LEGS_ABSENT[@]}"; do
    cut_leg_line "legs.${a%%$'\t'*}" "$LEG_SHA" 0 "none"$'\t'"absent at pre-flight, not run: ${a#*$'\t'}"
  done
}

# legs_cache_lines -- once every leg is green, the RELEASE seal's
# `cache<TAB><artefact><TAB><key>` line for the artefact the macOS stage
# caches, through note_line, and one line of the cut's output naming it
# (ST0011 WP-06): the line cache gc reads to keep the key. The artefact is
# cfg_macos_artefact's, the one answer app-sign and doctor read too, so it is
# the one the stage's app-sign pulled or put, and its key at R is the cache's
# own answer (cache key --commit), the one derivation of a key. A stage that
# builds no app, or builds it uncached, says so, and a key that cannot be read
# is said with why, so the seal names no key it does not hold.
legs_cache_lines() {
  local art key s=0 err="$SCRATCH/cache.key.err"
  [ "$LEGS_MACOS" = yes ] || return 0
  art="$(cfg_macos_artefact)" || s=$?
  case "$s" in
    0) ;;
    1)
      printf "release: cache: the macOS stage builds its app uncached: no build.artefacts entry has macos.app's path\n"
      return 0
      ;;
    *)
      # Why there is none: macos.build is not declared, or two entries name the app.
      printf 'release: cache: %s\n' "$art"
      return 0
      ;;
  esac
  # The verb holds a key to its form before it prints one (lib/cmd/cache).
  if key="$("$PROJECT_ROOT/bin/devbin" cache key "$art" --commit "$LEG_SHA" 2>"$err")" && [ -n "$key" ]; then
    note_line "cache"$'\t'"$art"$'\t'"$key"
    printf 'release: cache: %s %s, the macOS stage'"'"'s app at %s\n' "$art" "$key" "${LEG_SHA:0:12}"
  else
    printf 'release: cache: the key of %s at %s could not be read, so the seal names none for it: %s\n' \
      "$art" "${LEG_SHA:0:12}" "$(one_line "$(cat "$err" 2>/dev/null)")"
  fi
}

# legs_say <leg> <line> -- one line of the loop's, with the clock: the leg,
# its word and its detail, printed when its answer changes.
legs_say() {
  printf 'release: legs: %s %s %s: %s\n' "$(date -u +'%H:%M:%SZ')" "$1" "${2%%$'\t'*}" "${2#*$'\t'}"
}

# legs_skipped_words -- why a cut has no leg, for its legs row and release
# status's: no gates declared, no remote leg and no macOS stage, and no
# candidate, since release.ci.query is -, the opt-out (cut_candidate_declared).
# The one wording of it.
legs_skipped_words() {
  printf 'no gates: declared, and release.ci.query is -, so no candidate is read\n'
}

# legs_gate_unrun <word>... -- each option a `<cmd> all` gate in release.gates
# runs that is active on none of the words given, the platform words of the
# hosts the cut's legs run on, empty for a host with none, though active on
# some platform: one line each, `<gate><TAB><option><TAB><platforms>`, the
# platforms as config lists them (ST0011 WP-02c, AC-6.3). Active is
# option_active's answer, the one rule `all` reads (command_options), asked of
# each word, and what `all` sweeps is option_in_all's. An option active on no
# platform at all (disabled, a language the project does not speak, what it
# needs missing) is held back by its own declaration, not by its platforms, and
# `in_all: false` keeps its one meaning, so neither is named. Reads cut_run's
# gl. Status 1, saying nothing more, when a command's options cannot be listed.
legs_gate_unrun() {
  local g cmd opt w on somewhere candidates
  local -a items=() words=()
  [ "$#" -gt 0 ] || return 0
  IFS=' ' read -r -a words <<<"$_DEVBIN_PLATFORM_WORDS"
  for g in "${gl[@]}"; do
    [[ "$g" =~ ^([^[:space:]]+)[[:space:]]+all$ ]] || continue
    cmd="${BASH_REMATCH[1]}"
    candidates="$(command_option_candidates "$cmd")" || return 1
    while IFS= read -r opt; do
      [ -n "$opt" ] || continue
      option_in_all "$cmd" "$opt" || continue
      somewhere=no
      for w in "${words[@]}"; do
        if option_active "$cmd" "$opt" "$w"; then
          somewhere=yes
          break
        fi
      done
      [ "$somewhere" = yes ] || continue
      # Active on one leg's host is run there, so it is not named.
      for w in "$@"; do
        ! option_active "$cmd" "$opt" "$w" || continue 2
      done
      mapfile -t items < <(cfg_option_platforms "$cmd" "$opt")
      on="$(printf '%s, ' "${items[@]}")"
      printf '%s\t%s\t%s\n' "$g" "$opt" "${on%, }"
    done <<<"$candidates"
  done
  return 0
}

# legs_round <now> -- what the legs' last answers decide, as one line: `done`
# when every leg is green; `red<TAB><leg> is red: <detail>` for the first leg
# that failed; `timeout<TAB><waiting>` at or past LEGS_DEADLINE while a leg it
# bounds is not green; else `wait<TAB><waiting>`. <waiting> names each leg the
# deadline bounds that is not green, with its last answer, and is empty when
# only the local gates are waited on, which run to their end. THE LOOP'S ONE
# DECISION: it reads LEGS, LEG_LAST and LEGS_DEADLINE and nothing else, and
# changes nothing, so legs_step only reads, calls this, and acts.
legs_round() {
  local now="$1" leg line word allgreen=yes waiting=""
  for leg in "${LEGS[@]}"; do
    line="${LEG_LAST[$leg]:-none$'\t'not read}"
    word="${line%%$'\t'*}"
    case "$word" in
      green) ;;
      failed)
        printf 'red\t%s is red: %s\n' "$leg" "${line#*$'\t'}"
        return 0
        ;;
      *)
        allgreen=no
        [ "$leg" = local ] || waiting+=", $leg ($word: ${line#*$'\t'})"
        ;;
    esac
  done
  if [ "$allgreen" = yes ]; then
    printf 'done\t\n'
  elif [ -n "$LEGS_DEADLINE" ] && [ -n "$waiting" ] && [ "$now" -ge "$LEGS_DEADLINE" ]; then
    printf 'timeout\t%s\n' "${waiting#, }"
  else
    printf 'wait\t%s\n' "${waiting#, }"
  fi
}

# legs_pause <waiting> -- the loop's rest between reads: RELEASE_POLL_SECONDS,
# cut short at the deadline while a leg it bounds is waited on (<waiting> not
# empty), as release_wait's rest is, and ended within a second of the local
# gates' run ending, so a cut whose last leg is the local one goes on once it
# has, as the gates step did, never a poll later.
legs_pause() {
  local until=$((SECONDS + RELEASE_POLL_SECONDS))
  if [ -n "$1" ] && [ -n "$LEGS_DEADLINE" ] && [ "$LEGS_DEADLINE" -lt "$until" ]; then
    until="$LEGS_DEADLINE"
  fi
  while [ "$SECONDS" -lt "$until" ]; do
    if [ "$LEG_LOCAL_STATE" = running ] && ! legs_local_running; then
      return 0
    fi
    sleep 1
  done
}

# legs_step -- the cut's legs step, in cut_run's scope (its gl, commit,
# source, release_made, dry_run, tag, publish_url, cand_remote, cand_ref,
# cand_shown, and in the publish shape snap and snap_public):
# every leg started together at the release commit and read by one wait loop
# (ST0011, AC-2.2). The candidate starts first, since its push is the one start
# that can be refused, and a refused or unanswered push stops the cut before
# anything else runs. Then the local gates in the background, and the loop:
# every RELEASE_POLL_SECONDS, one read of each leg not yet green, a line with
# the clock when a leg's answer changes, and legs_round's decision: every leg
# green ends the step done; a failed leg stops the cut; ci.wait from the
# loop's start is the deadline wherever a leg other than the local gates is
# waited on, and a leg still not green then is a timeout, named with its last
# answer. A local run alone waits for its end, as the gates step did. Either
# stop is legs_stop's. A dry run starts nothing and says what would run, or
# that every leg is green already.
#
# A LEG THAT HAS READ GREEN IS NOT READ AGAIN: one answer of green is that
# leg's verdict, so a query that stops answering once the candidate is green
# cannot time the cut out while the local gates still run.
legs_step() {
  local leg line ci_secs decision h
  LEGS=()
  [ -z "$cand_remote" ] || LEGS+=(candidate)
  [ "${#gl[@]}" -eq 0 ] || LEGS+=(local)
  # Each remote host pre-flight reached, and the macOS stage where declared
  # (ST0011 WP-05, WP-06); a host it could not reach is no leg of this cut.
  for h in "${LEGS_REMOTE[@]}"; do LEGS+=("legs.$h"); done
  [ "$LEGS_MACOS" = no ] || LEGS+=(macos)
  if [ "${#LEGS[@]}" -eq 0 ]; then
    cut_row legs skipped "$(legs_skipped_words)"
    return 0
  fi
  # THE CANDIDATE IS NAMED ONCE THE RELEASE COMMIT EXISTS, before the step can
  # return, so the push step, and any stop after this, delete the one this
  # release has, a resumed cut's included (legs_cand_delete). Its ref and its
  # target were named at pre-flight, for the confirm's question. In the
  # publish shape it is the release commit's snapshot S, made before this step
  # (cut_run), and its calls are made from the snapshot's repository.
  if [ -n "$cand_remote" ] && [ "$release_made" = yes ]; then
    LEG_REF="$cand_ref" LEG_CAND_REMOTE="$cand_remote" LEG_CAND_SHOWN="$cand_shown"
    if [ -n "$publish_url" ]; then
      LEG_CAND_SHA="$snap" LEG_CAND_REPO="$SNAPSHOT_DIR"
    else
      LEG_CAND_SHA="$commit" LEG_CAND_REPO=""
    fi
  fi
  # PAST THE TAG THE LEGS ARE NOT RE-RUN, the tag being the release, save in
  # the publish shape while the snapshot is not public: one made again on a
  # public branch that moved is a new commit, so its candidate is read again,
  # alone. The local gates' green on the release commit stands, and the tree in
  # place need not be that commit's any more.
  if [ "$source" = tag ]; then
    if [ -z "$publish_url" ] || [ -z "$cand_remote" ] || [ "$snap_public" = yes ]; then
      cut_row legs "not re-run" "the tag exists, so the legs are not re-run -- this says nothing about a verdict"
      return 0
    fi
    LEGS=(candidate)
  fi
  if [ "$release_made" = no ]; then
    cut_row legs would "start ${LEGS[*]} together on the release commit the commit step makes, then tag only when every one is green"
    return 0
  fi
  LEG_ROOT="$PROJECT_ROOT" LEG_SHA="$commit"
  LEG_PROJECT="$(legs_project_name)"
  if [ -n "$cand_remote" ]; then
    run_words LEG_CQ release.ci.query "$(cfg_release_get ci.query)" || cut_fail legs "release.ci.query cannot be read as words"
  fi
  # ci.wait bounds every leg but the local gates, which run to their end.
  if [ "${LEGS[*]}" != local ]; then
    ci_secs="$(release_seconds "$(cfg_release_get ci.wait)")" ||
      cut_fail legs "release.ci.wait is not a duration (a whole number of s, m or h), so the loop has no deadline to wait to"
  fi
  if [ "$dry_run" = 1 ]; then
    # Read as a cut reads them at their start (_leg_at_start): a leg green
    # there is started by none, and every one green is the step already. The
    # local gates' record is worded as release gates and status word it.
    local said="" starts=""
    for leg in "${LEGS[@]}"; do
      line="$(_leg_at_start "$leg")" || cut_fail legs "reading the $leg leg at its start failed (exit $?)"
      [ "${line%%$'\t'*}" = green ] || starts+=" $leg"
      if [ "$leg" = local ]; then
        line="$(release_gates_word "$commit" "$line")" || cut_fail legs "wording the local gates' record failed (exit $?)"
      fi
      said+="; $leg: ${line#*$'\t'}"
    done
    if [ -z "$starts" ]; then
      cut_row legs already "every leg green at ${commit:0:12} already, so none would run again${said}"
    else
      cut_row legs would "start${starts} at ${commit:0:12}, then tag only when every leg is green${said}"
    fi
    return 0
  fi
  LEGS_T0=$SECONDS
  local started=no
  for leg in "${LEGS[@]}"; do
    # In this shell, never a command substitution: the local leg's run is a
    # background job of the cut's, the cut's to reap and stop, and the
    # candidate's push joins what the stop's sentence names.
    leg_start "$leg" >"$SCRATCH/leg.line" ||
      legs_stop "the $leg leg could not be started: its answer could not be written to $SCRATCH/leg.line"
    line="$(cat "$SCRATCH/leg.line")" || legs_stop "the $leg leg's answer could not be read from $SCRATCH/leg.line"
    LEG_LAST[$leg]="$line" LEG_SECS[$leg]=0
    legs_say "$leg" "$line"
    # A remote leg's start sends R to its host, and the macOS stage's run
    # submits the app to Apple's notary service: acts another machine sees,
    # which the stop's sentence names (cut_outward).
    case "$leg:${line%%$'\t'*}" in
      legs.*:green | macos:green) ;;
      legs.*:pending) CUT_OUTWARD+=", sent ${LEG_SHA:0:12} to ${leg#legs.} to run its leg" ;;
      legs.*) CUT_OUTWARD+=", tried to start the $leg leg, which may have sent ${LEG_SHA:0:12} to ${leg#legs.}" ;;
      macos:*) CUT_OUTWARD+=", started the macOS stage, which submits the app to Apple's notary service" ;;
    esac
    # A start that fails, or does not answer, stops the cut at once: no read
    # after it could turn that leg green, and its read would put the host's
    # word on an absent run, or an earlier run's red, in place of the cause.
    case "$leg:${line%%$'\t'*}" in
      candidate:failed | candidate:unknown) legs_stop "the candidate did not start: ${line#*$'\t'}" ;;
      legs.*:failed | legs.*:unknown) legs_stop "the $leg leg did not start: ${line#*$'\t'}" ;;
      *:green) ;;
      *) started=yes ;;
    esac
  done
  [ "${LEGS[*]}" = local ] || LEGS_DEADLINE=$((SECONDS + ci_secs))
  while :; do
    for leg in "${LEGS[@]}"; do
      [ "${LEG_LAST[$leg]%%$'\t'*}" != green ] || continue
      [ "$leg" != local ] || legs_local_reap
      [ "$leg" != macos ] || release_macos_reap
      line="$(leg_read "$leg")" || legs_stop "reading the $leg leg failed (exit $?)"
      if [ "${line%%$'\t'*}" != "${LEG_LAST[$leg]%%$'\t'*}" ]; then
        legs_say "$leg" "$line"
        LEG_SECS[$leg]=$((SECONDS - LEGS_T0))
      fi
      LEG_LAST[$leg]="$line"
      # The local gates' own output, once their run has ended green: reaped
      # above, so it is whole.
      [ "$leg:${line%%$'\t'*}" != local:green ] || legs_show_local
    done
    decision="$(legs_round "$SECONDS")" || legs_stop "deciding on the legs' answers failed (exit $?)"
    case "${decision%%$'\t'*}" in
      done) break ;;
      red) legs_stop "${decision#*$'\t'}" ;;
      timeout) legs_stop "a timeout: not green within $(cfg_release_get ci.wait) (ci.wait) of the loop's start: ${decision#*$'\t'}" ;;
    esac
    legs_pause "${decision#*$'\t'}"
  done
  legs_lines
  legs_cache_lines
  local done_words="" a
  for leg in "${LEGS[@]}"; do
    done_words+="; $leg: ${LEG_LAST[$leg]#*$'\t'}"
  done
  for a in "${LEGS_ABSENT[@]}"; do
    done_words+="; legs.${a%%$'\t'*}: absent at pre-flight, not run"
  done
  # Every leg green at its start, none run: the step is already, as a resumed
  # cut's gates were.
  if [ "$started" = no ]; then
    cut_row legs already "every leg green at ${commit:0:12} already, so none is run again${done_words}"
  else
    cut_row legs "done" "every leg green at ${commit:0:12}${done_words}"
  fi
}

# ---------------------------------------------------------------------------
# THE CUT, THE STEPS FROM RESOLVE TO LEGS (WP-04)
#
# Each step reads its postcondition first, so a re-run of the same target
# continues, and each step's row is one of the cut's states: `done`, `already`,
# `skipped`, `not re-run`, `FAILED`, or under --dry-run `would`. The rows are
# collected and printed as one table when the run stops, through release_row,
# the renderer `release status` prints through: the summary of a run and the
# map of where it got to are the same table. A step's own output (a gate's, a
# commit hook's) is printed as it happens, above that table.
#
# A FAILED STEP STOPS THE RUN, exit 1, and its row names what failed. The steps
# from resolve to legs are local and reversible but for one act: the legs step
# pushes the candidate, the release commit on its candidate ref, for CI to run
# on, and a stop deletes it (cut_fail, legs_cand_delete). So a stop leaves
# nothing another machine has seen but a candidate the stop names when it
# would not go, and the remedy is forward: fix it and run the same target.
#
# THE ONE YES COMES FIRST (ST0011): the confirm step asks right after
# pre-flight, before the stamp, the commit or any leg runs, naming what other
# machines will see -- the candidate's push, the tag, the release commit the
# commit step makes, each remote's push, the object, the assets and the after:
# commands, which run under it -- and everything after it runs under that
# answer, so nobody waits at a prompt while the legs run. The remotes are read
# again at the tag step, once the release commit exists: a plan that differs
# from the one confirmed stops the run there, before anything is tagged.
#
# PAST THE PUSH THE RULE CHANGES. The object step under `object: ci` fails as any step
# does, since a re-run continues it. The after step runs on a published
# release: a failed `after:`, or a candidate that would not be deleted, is
# reported, undoes nothing, and ends the cut at exit 1 with the remedy, which
# is forward -- the next release, never a moved tag. Every CI verdict is read
# before the tag, on the candidate, by the legs step.
# ---------------------------------------------------------------------------

CUT_ROWS=()
CUT_HEAD=""
CUT_UNREACHED=()
CUT_OUTWARD=""

cut_row() { CUT_ROWS+=("$(release_row "$1" "$2" "$3")"); }

cut_summary() {
  printf '\n%s\n' "$CUT_HEAD"
  printf '%s\n' "${CUT_ROWS[@]}"
}

# cut_back_to_brew <tag> <version> <commit> -- a released cut's last line, for
# a project that publishes a Homebrew formula (issue 0228): the steps that put
# the maintainer back on the install the release made, since the switch rests
# at brew (docs/dev-opt-brew.md, T5).
#
# A NOTE, NEVER AN ACTION. The core runs no brew and points no link: `use` is
# the one verb that points links, and a change to the machine is the person's
# to make. A project publishes a formula when its `formula` command is active
# (command_active, the one rule): the built-in enabled, or the project's own
# handler or run:. The formula's name is cfg_formula_name's, the one
# derivation the built-in reads too. A project with no formula gets no line,
# since brew has nothing of it to upgrade. A cut whose after: failed, or whose
# candidate would not be deleted, gets none either: its last line stays the
# remedy (0181), and after a failed after: the tap may not have the release.
cut_back_to_brew() {
  local name
  command_active formula || return 0
  if ! name="$(cfg_formula_name)" || [ -z "$name" ]; then
    printf 'release: NOTE: the switch rests at brew -- once the tap has %s, upgrade it with brew and run use brew (the formula'"'"'s name could not be read: formula.name, or project.name)\n' "$1"
    return 0
  fi
  printf 'release: NOTE: the switch rests at brew -- once the tap has %s: brew upgrade %s, then %s use brew, and %s --version reads %s %s (brew, %s)\n' \
    "$1" "$name" "$name" "$name" "$name" "$2" "${3:0:12}"
}

# cut_fail <n> <detail> -- step <n> FAILED: its row, the table so far, and what
# this run did that another machine can see, then exit 1.
#
# EXIT 1 WHEN NOBODY COULD BE ASKED, TOO (issue 0130). The confirm step passed 2 here, as
# ST0007's AC-5.3 asked, so that "declined" and "could not ask" were different
# codes -- and 2 is the dispatcher's code for an unknown or inactive command, so
# a script running `release` without `--yes` read the same code as one running
# it where `release` is not enabled. A new refusal takes a new code, never a
# spare one, and this is not a new refusal: fullcycle and clean already exit 1
# when nobody is there to ask. The row's detail carries the difference: only a
# person at a terminal can decline.
#
# A STOP DELETES THE CANDIDATE (AC-2.3) a cut's legs step named, before the
# table, so the sentence under it names that too (legs_cand_delete, once), and
# a candidate that would not go is named on a line of its own after it, with
# what deletes it, as a published cut's last lines name it (cut_tail): the
# command is the line's last word, so a copy of it takes no full stop with it.
cut_fail() {
  # What a delete could not do is LEGS_CAND_LEFT, which the line after the
  # sentence below carries; the stop goes on either way.
  legs_cand_delete || :
  cut_row "$1" FAILED "$2"
  cut_summary
  printf '\nrelease: stopped at the %s step. %s. Fix what the row names, then run again.\n' "$1" "$(cut_outward)"
  [ -z "$LEGS_CAND_LEFT" ] || printf 'release: %s\n' "$LEGS_CAND_LEFT"
  exit 1
}

# cut_outward -- what this run has done that is not local and reversible, as a
# sentence: EVERY such act, in order, or that there was none. Every act, not
# the last: a run that pushed to two remotes and then failed must name both.
cut_outward() {
  if [ -n "$CUT_OUTWARD" ]; then
    printf 'This run %s' "${CUT_OUTWARD#, }"
  else
    printf 'This run tagged nothing and pushed nothing'
  fi
}

# cut_call <step> <what> <cmd>... -- one write to another machine (a push, a
# gh create or edit), bounded at RELEASE_CALL_SECONDS (release_run_bounded),
# its output shown as it was when it ran unbounded. A failure or a hang fails
# <step>, naming <what>; a hang also says the effect is unknown, since a push
# cut off mid-flight may or may not have landed, and `release status` reads it.
cut_call() {
  local step="$1"
  shift
  cut_call_rc "$@" || cut_fail "$step" "$CUT_CALL_WHY"
}

# cut_call_rc [--reads <how>] <what> <cmd>... -- cut_call's bounded write
# without the stop: 0 when it held, else the call's status, with CUT_CALL_WHY
# saying what failed in cut_call's own words, so a caller that records the
# failure before it stops (the legs step's candidate push and its delete)
# words it as every write does. <how> names what reads whether a write cut
# off at its bound took effect: `release status reads it` unless given, which
# is true of the tag and the branch, and not of a candidate ref.
CUT_CALL_WHY=""
cut_call_rc() {
  local reads="release status reads it" what rc=0
  if [ "$1" = --reads ]; then
    reads="$2"
    shift 2
  fi
  what="$1"
  shift
  CUT_CALL_WHY=""
  release_run_bounded "$RELEASE_CALL_SECONDS" "$SCRATCH/call.out" "$SCRATCH/call.err" "$@" || rc=$?
  cat "$SCRATCH/call.out" "$SCRATCH/call.err"
  case "$rc" in
    0) return 0 ;;
    124) CUT_CALL_WHY="$what did not finish within ${RELEASE_CALL_SECONDS}s and was stopped -- whether it took effect is unknown; $reads" ;;
    *) CUT_CALL_WHY="$what failed (exit $rc, above)" ;;
  esac
  return "$rc"
}

# one_line <text> -- the text on one line, for a row's detail.
one_line() { printf '%s' "${1//$'\n'/ }"; }

# cut_remotes -- the remotes a release pushes to: the declared list, else every
# remote git lists.
cut_remotes() {
  if cfg_release_declared remotes; then
    cfg_release_list remotes
  else
    git remote
  fi
}

# cut_read_remotes <mode> <step> -- every remote the cut pushes to, read for the
# push step in <mode>: `push`, or `push-new` while the commit step has still to
# make the release commit on HEAD (release_read_remote). CUT_PLAN is left
# holding one `<remote> <halves>` per remote still to receive something, in
# order, and a remote that refuses or cannot be read fails <step>. Read at the
# confirm step, for its question, and again at the tag step once the release
# commit exists, so the push carries out the plan that was confirmed (ST0011).
# Reads the caller's remotes, branch, tag and commit.
CUT_PLAN=()
cut_read_remotes() {
  local mode="$1" step="$2" remote answer rc
  CUT_PLAN=()
  while IFS= read -r remote <&3; do
    [ -n "$remote" ] || continue
    answer="$(release_read_remote "$remote" "$branch" "$tag" "$commit" "$mode" 3<&-)" || {
      rc=$?
      cut_fail "$step" "reading remote $(release_url_shown "$remote") failed (exit $rc)"
    }
    case "${answer%%$'\t'*}" in
      already) ;;
      pending) CUT_PLAN+=("$remote ${answer#*$'\t'}") ;;
      *) cut_fail "$step" "${answer#*$'\t'}" ;;
    esac
  done 3<<<"$remotes"
}

# cut_plan_words <entry>... -- a push plan in words, `push <halves> to
# <remote>` per entry, joined by `; `, or `nothing to push`: the one wording of
# it, which the confirm step's question gives each entry still to push and the
# tag step's refusal gives both plans. The push row shows the plan's own
# entries, `<remote> <halves>`, as its arms read them.
cut_plan_words() {
  local e out=""
  for e in "$@"; do
    out+="; push ${e#* } to ${e%% *}"
  done
  printf '%s' "${out:+${out#; }}"
  [ -n "$out" ] || printf 'nothing to push'
}

# cut_leg_line <leg> <sha> <seconds> <verdict> -- the RELEASE seal's line for
# one leg (ST0011): its name, the word of <verdict>, the sha, the seconds from
# the legs step's start to <verdict>, and the record or run it names,
# `leg: <name> <word> <sha> <secs>s <detail>`, through note_line, which puts
# it in the run's own log. <verdict> is the leg's last answer, the line the
# legs step decided on, so the seal names what the step stood on rather than
# a second read of it.
cut_leg_line() {
  note_line "leg: $1 ${4%%$'\t'*} $2 ${3}s ${4#*$'\t'}"
}

# cut_candidate_ref <tag> -- the candidate's branch for <tag>:
# release.publish.candidate filled (release_candidate_ref), a name git takes
# for a branch; or, exit 1, why it cannot be named. THE ONE READ of it, which a
# cut's pre-flight, release status, release check and release attach ask.
cut_candidate_ref() {
  local tmpl ref rc=0
  if ! tmpl="$(cfg_release_get publish.candidate)"; then
    printf "release.publish.candidate cannot be read, so the candidate's ref cannot be named\n"
  elif ! ref="$(release_candidate_ref "$tmpl" "$1")"; then
    printf "the candidate's ref cannot be named from release.publish.candidate, %s\n" "$tmpl"
  else
    is_branch_name "$ref" || rc=$?
    case "$rc" in
      0)
        printf '%s\n' "$ref"
        return 0
        ;;
      1) printf '%s, release.publish.candidate for %s, is not a name git takes for a branch\n' "$ref" "$1" ;;
      *) printf 'whether %s, release.publish.candidate for %s, is a name git takes for a branch cannot be asked of git (exit %s)\n' "$ref" "$1" "$rc" ;;
    esac
  fi
  return 1
}

# The three ways out of a candidate whose push would start no run the cut
# could read, which every refusal of one names (ST0011 WP-02c).
_RELEASE_FIRES_EXITS="fix the workflow's push trigger so a push of the candidate's branch starts it, declare release.ci.query: - to cut with no candidate, or declare a query of your own, which reads its own trigger"

# release_fires_read <ref> <sha> [<path>...] -- whether a push of the branch
# <ref> starts release.ci.workflow, as committed at <sha>, given the files the
# push's commit changes (ST0011 WP-02c), asked of the built-in query's own
# reader, `ci-state --fires`, as one line and a status: 0 when it fires, the
# reader's reason; 1 when it does not, or the reader could not say, which
# never reads as fires, with the reader's word and reason and the three ways
# out; 3 when the query is not the built-in, which reads its own trigger and is
# not asked, saying so. THE ONE ASK OF THE TRIGGER: a cut's pre-flight, a
# publishing cut's legs step, once it has built the snapshot, and release
# check each ask here, so a candidate whose push would start no run is refused
# before anything is stamped or pushed, never waited for to ci.wait.
release_fires_read() {
  local ref="$1" sha="$2" q line rc=0
  shift 2
  if ! q="$(cfg_release_get ci.query)"; then
    printf 'release.ci.query cannot be read (above), so whether a push of %s starts a run cannot be asked -- %s\n' "$ref" "$_RELEASE_FIRES_EXITS"
    return 1
  fi
  if ! cfg_ci_query_is_builtin "$q"; then
    printf "release.ci.query is '%s', a query of the project's own, which reads its own trigger, so whether a push of %s starts a run is not asked\n" "$q" "$ref"
    return 3
  fi
  # STDOUT ALONE, as release_commit is read: its one line is the answer, and
  # nothing said on stderr, a child shell's setlocale warning among it, can land
  # inside it; a refusal of its arguments has said why on stderr, above.
  line="$("$PROJECT_ROOT/bin/devbin" ci-state --fires "$ref" "$sha" "$@" </dev/null)" || rc=$?
  line="${line%%$'\n'*}"
  if [ "$rc" -ne 0 ]; then
    printf 'ci-state --fires could not say whether a push of %s at %s starts release.ci.workflow (exit %s, above) -- %s\n' \
      "$ref" "${sha:0:12}" "$rc" "$_RELEASE_FIRES_EXITS"
    return 1
  fi
  if [ "${line%%$'\t'*}" = fires ]; then
    printf '%s\n' "${line#*$'\t'}"
    return 0
  fi
  printf 'a push of %s at %s starts no run the cut could read: ci-state --fires answers %s, %s -- %s\n' \
    "$ref" "${sha:0:12}" "${line%%$'\t'*}" "${line#*$'\t'}" "$_RELEASE_FIRES_EXITS"
  return 1
}

# cut_snapshot_trigger -- a publishing cut's candidate trigger, in cut_run's
# scope once the legs step has made the snapshot S (ST0011 WP-02c): ci-state
# --fires reads only the project's own repository, and S is in the
# snapshot's, so S must carry the release commit's release.ci.workflow
# unchanged, and then the push is asked of at the release commit with the
# files S's commit changes, every file of a first snapshot
# (release_fires_read). A snapshot that changes the workflow, or a push that
# would start no run, stops the cut at the legs step, naming why, before
# anything is pushed. A query of the project's own reads its own trigger, and
# is not asked. The files are read as git lists them NUL-separated, each path
# whole and unquoted, and a rename as both its paths, since --fires reads a
# push's path filters against every path the push touches.
cut_snapshot_trigger() {
  local wf q r_blob s_blob listing="$SCRATCH/snapshot.files" fires_line fires_rc=0
  local -a paths=()
  q="$(cfg_release_get ci.query)" ||
    cut_fail legs "release.ci.query cannot be read (above), so whether the snapshot's push starts a run cannot be asked -- nothing pushed"
  cfg_ci_query_is_builtin "$q" || return 0
  wf="$(cfg_release_get ci.workflow)" || cut_fail legs "release.ci.workflow cannot be read"
  r_blob="$(git_readonly rev-parse --verify --quiet "$commit:.github/workflows/$wf")" || r_blob=""
  s_blob="$(_snapshot_git -C "$SNAPSHOT_DIR" rev-parse --verify --quiet "$snap:.github/workflows/$wf")" || s_blob=""
  if [ -n "$r_blob" ] && [ "$s_blob" != "$r_blob" ]; then
    cut_fail legs "the snapshot ${snap:0:12} does not carry ${commit:0:12}'s .github/workflows/$wf unchanged, so whether its push starts that workflow cannot be read at the release commit -- the shipped list, release.snapshot.list, takes the workflow whole -- nothing pushed"
  fi
  # To a file, since a command substitution drops the NULs that end each path.
  if [ -n "$SNAPSHOT_PARENT" ]; then
    _snapshot_git -C "$SNAPSHOT_DIR" diff -z --no-renames --name-only "$SNAPSHOT_PARENT" "$snap" >"$listing" ||
      cut_fail legs "the files the snapshot ${snap:0:12} changes cannot be listed -- nothing pushed"
  else
    _snapshot_git -C "$SNAPSHOT_DIR" ls-tree -r -z --name-only "$snap" >"$listing" ||
      cut_fail legs "the files of the first snapshot ${snap:0:12} cannot be listed -- nothing pushed"
  fi
  mapfile -t -d '' paths <"$listing"
  fires_line="$(release_fires_read "$cand_ref" "$commit" "${paths[@]}")" || fires_rc=$?
  # Fires, or a query of the project's own: anything else is no run the cut
  # could read, which is never read as fires.
  case "$fires_rc" in
    0 | 3) ;;
    *) cut_fail legs "the snapshot's push, read at the release commit ${commit:0:12} with the files ${snap:0:12} changes: $fires_line -- nothing pushed" ;;
  esac
}

# cut_public_left <tag-sha> <held> -- 0 when the public repository still has
# the release's snapshot to take: no public tag, or one its publish branch does
# not hold, <held> being publish_read's word (yes when the tag is at the
# branch's tip or in its history). A tag the branch holds reads as taken, at
# the tip or under a later release: whether it is this release's snapshot is
# the legs step's to read, which refuses one that is not, before anything is
# pushed. THE ONE PREDICATE, which a cut's confirm step and release status ask.
cut_public_left() {
  [ -z "$1" ] || [ "$2" != yes ]
}

# declared_remote -- the first declared `remotes` entry, or nothing when none is
# declared: release_repo's second argument. lib/config's one reader of it
# (cfg_release_first_remote), which the built-in ci-state reads too, so a cut
# and the CI it reads name one repository.
declared_remote() {
  cfg_release_first_remote
}

# object_title <tag> <version> -- the release object's title: `title:`, with
# {tag} and {version} filled in. One home, read by a cut's confirm step and by status.
# 1 when `title:` cannot be read.
object_title() {
  local title
  title="$(cfg_release_get title)" || return 1
  title="${title//\{tag\}/$1}"
  printf '%s\n' "${title//\{version\}/$2}"
}

# cut_gh_signed_in <object> -- pre-flight's gh half: gh is there,
# the repository resolves, and gh is signed in to its host. Prints the refusal
# and returns 1; `object: none` never needs gh.
cut_gh_signed_in() {
  local repo host out
  case "$1" in local | ci) ;; *) return 0 ;; esac
  if ! command -v gh >/dev/null 2>&1; then
    printf 'gh is not installed, and object: %s needs it' "$1"
    return 1
  fi
  if ! repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
    one_line "$repo"
    return 1
  fi
  host="$(release_repo_host "$repo")"
  if ! out="$(release_gh "" auth status --hostname "$host" 2>&1)"; then
    printf 'gh is not signed in to %s: %s' "$host" "$(one_line "$out")"
    return 1
  fi
}

# cut_notes_body <commit> <version> <file> <step> -- the notes body, read from
# the release commit's own tree (materialised once, as `rel`) into <file>: the
# tag's message and the release object's notes. A failure is <step>'s.
cut_notes_body() {
  local out
  if [ ! -d "$SCRATCH/rel" ]; then
    out="$(materialise rel "$1" "$2" 2>&1)" ||
      cut_fail "$4" "the release commit could not be materialised: $(one_line "$out")"
  fi
  notes_body "$SCRATCH/rel" "$2" >"$3" 2>"$3.err" ||
    cut_fail "$4" "the notes body could not be read: $(one_line "$(cat "$3.err")")"
}

# cut_stamp_read <name> <commit> <version> <views> -- the stamp step's postcondition
# read against <commit>'s own tree, materialised as $SCRATCH/<name>.
cut_stamp_read() {
  local why
  if ! why="$(materialise "$1" "$2" "$3" 2>&1)"; then
    printf 'UNREADABLE\t%s\n' "$(one_line "$why")"
    return 0
  fi
  release_read_stamp "$SCRATCH/$1" "$3" "$4"
}

# cut_run -- a cut of $target: the steps from resolve to after. With --dry-run, the
# same reads, with every write, every wait, every gate and every after:
# reported as `would`, and a verdict as the last line when no step failed.
cut_run() {
  local tpl branch object today launcher line v tag how rc_line commit source
  local state detail remotes remote answer nremote=0 owned dirt outside="" deferred=""
  local derived gates out written="" have n ignored_rc ignored_why assets_wf after_list
  local -a refusals=() gl=()
  # The candidate's target, its ref and the target as a line names it, found
  # at pre-flight: the remote the legs step pushes it to, or in the publish
  # shape release.publish.url.
  local cand_remote="" cand_ref="" cand_shown=""
  # THE PUBLISH SHAPE'S PUBLIC SIDE: the publish branch; the public refs, read
  # at pre-flight and read again before anything public moves (publish_read,
  # publish_refs); the snapshot S of the release commit, made once that commit
  # exists; and whether S is public already, the publish branch and the tag at
  # it.
  local pbranch="" pub_branch="" pub_cand="" pub_tag="" pub_tag_kind="" pub_held="" snap="" snap_public=no

  # THE TAG REACHES ci.query ALONE (issue 0149): one exported from outside,
  # to try a query by hand, would reach every gate and after: command, and a
  # gate exercising the query would read a stale tag.
  unset DEVBIN_RELEASE_TAG
  # THE GATES' WHY FILE IS THE CUT'S OWN (ST0011), set in the local leg's own
  # run and never exported: one inherited from outside, or assigned in front
  # of a call, would reach every gate as an environment variable.
  unset RELEASE_GATES_WHY
  release_one_repository release
  cfg_validate || die "release: $DEVBIN_DIR/config.yaml does not validate (above)"
  select_notes
  # Each read with its status, as every read below is (issue 0304): a cut runs
  # with errexit off, so a read that fails unchecked would go on empty.
  tpl="$(cfg_release_get tag)" || die "release: cannot read release.tag"
  branch="$(cfg_release_get branch)" || die "release: cannot read release.branch"
  object="$(cfg_release_get object)" || die "release: cannot read release.object"
  derived="$(cfg_release_list derived)" || die "release: cannot read release.derived"
  # THE ONE READ OF release.gates IN A CUT (ST0011): the local leg runs the
  # list read here, and the seal names it. Read with its status, as every list
  # a step runs is: empty would skip the gates in silence.
  gates="$(cfg_release_list gates)" || die "release: cannot read release.gates"
  gates_list "$gates"
  # Read once, for the confirm step's question and the after step's run.
  after_list="$(cfg_release_list after)" || die "release: cannot read release.after"
  # Read with its status: empty would turn the attach off in silence.
  assets_wf="$(cfg_release_get assets.workflow)" || die "release: cannot read release.assets.workflow"
  # A PUBLISHING CUT (issue 0240, folded into the cut by ST0011): the public
  # repository takes the release commit's snapshot, never the workroom, pushed
  # there as the candidate and made public by the push step once every leg is
  # green.
  local publish_url named rc
  publish_url="$(cfg_release_get publish.url)" || die "release: cannot read release.publish.url"
  launcher="$PROJECT_ROOT/bin/devbin"
  [ -x "$launcher" ] || die "release: no launcher at $launcher -- the cut runs this project's own verbs through it"
  open_scratch release
  local dry_note=""
  [ "$dry_run" = 0 ] || dry_note=" (DRY RUN: no commit, tag, push or release object, and no gate runs)"
  CUT_HEAD="release: $target$dry_note"

  # --- resolve -----------------------------------------------------
  # ONE READ OF THE CLOCK, so the release carries one date (notes_date's rule).
  # The person's local date: the day they released on. A clock that cannot be
  # read fails this step, in a dry run as in the cut.
  today="$(date +%F)" || cut_fail resolve "the date cannot be read: date +%F exited $?"
  if ! line="$(release_resolve "$tpl" "$target" 2>&1)"; then
    cut_fail resolve "$(one_line "$line")"
  fi
  IFS=$'\t' read -r v tag how <<<"$line"
  # STDOUT ALONE, as status_report reads it: the sha is the line, and nothing
  # git says on stderr can land inside it; a failure has said why on stderr.
  if ! rc_line="$(release_commit "$tag")"; then
    cut_fail resolve "the release commit could not be read (above)"
  fi
  commit="${rc_line%%$'\t'*}"
  source="${rc_line#*$'\t'}"
  # THE HEADER NAMES THE COMMAND THAT RELEASES FOR REAL (0181): a cut that
  # stops is resumed with it, and after a dry run it is the cut. "resume with"
  # after a dry run that had passed read as though a cut had stopped.
  local next="resume with"
  [ "$dry_run" = 0 ] || next="cut with"
  CUT_HEAD="release: $tag$dry_note -- $next: ${DEVBIN_INVOKE:-bin/devbin} release v$v"
  if [ "$how" = resume ]; then
    cut_row resolve "done" "$tag exists, at ${commit:0:12}: resuming it"
  else
    cut_row resolve "done" "$v from $target, tag $tag, new"
  fi

  # --- pre-flight --------------------------------------------------
  # Every check runs and every refusal is named, so one run says everything
  # that is wrong; nothing here writes.
  line="$(git symbolic-ref -q --short HEAD)" || line=""
  [ "$line" = "$branch" ] || refusals+=("not on $branch: HEAD is ${line:-detached}")

  # THE COMMIT STEP'S POSTCONDITION, READ ONCE HERE AND USED AT THE STAMP AND COMMIT STEPS: whether
  # HEAD is already the release commit (it carries the stamp and the tree is
  # clean). That one answer decides what a remote that has moved past HEAD
  # means (release_read_remote, preflight-new), whether the stamp step runs, and
  # whether the commit step commits. So a cut never commits on HEAD under `preflight`:
  # the mode and the commit are the same answer.
  local mode=preflight head_read="" head_is_release=no
  if [ "$source" = HEAD ]; then
    head_read="$(cut_stamp_read head "$commit" "$v" count)" ||
      head_read="UNREADABLE"$'\t'"reading the stamp at HEAD failed (exit $?)"
    if [ "${head_read%%$'\t'*}" = already ] && [ "$(release_read_clean | cut -f1)" = already ]; then
      head_is_release=yes
    else
      mode=preflight-new
    fi
    # REFUSED HERE, not at the commit step, since the confirm step comes
    # between them (ST0011): nobody is asked about a cut whose commit step could
    # not read its own postcondition.
    [ "${head_read%%$'\t'*}" != UNREADABLE ] ||
      refusals+=("whether HEAD is already the release commit cannot be read: ${head_read#*$'\t'}")
  fi
  # THE GATES' PURGE READS RUNLOG_KEEP_RUNS AFTER THEIR SEAL (ST0011), so a
  # value it refuses is refused here, through the one rule, before anything
  # runs: found by the purge, it ended a cut whose gates had passed with no row
  # and no summary.
  local keep_why
  if [ "${#gl[@]}" -gt 0 ] && [ "$source" = HEAD ] && keep_why="$(runlog_keep_runs_problem)"; then
    refusals+=("$keep_why, and the gates' run purges its older runs by it")
  fi

  if ! remotes="$(cut_remotes 2>&1)"; then
    refusals+=("cannot list the remotes: $(one_line "$remotes")")
    remotes=""
  elif [ -z "$remotes" ]; then
    refusals+=("this repository has no remote to push to")
  fi
  while IFS= read -r remote <&3; do
    [ -n "$remote" ] || continue
    nremote=$((nremote + 1))
    if ! git remote get-url "$remote" >/dev/null 2>&1; then
      # Named through release_url_shown: an entry can be a url, and a url can
      # carry a token (issue 0189).
      refusals+=("remote $(release_url_shown "$remote") is declared and does not exist")
      continue
    fi
    # A PUBLISHING CUT NEVER PUSHES THE WORKROOM TO THE PUBLIC REPOSITORY
    # (issue 0240): a cut pushes the workroom, its whole history, to every
    # remote it pushes to, so one that names the repository release.publish.url
    # names, by OWNER/NAME on any host or as the same path, is refused, as the
    # snapshot refuses one, and so is one whose url says too little to tell.
    if [ -n "$publish_url" ]; then
      rc=0
      named="$(release_remote_naming "$publish_url" "$remote" 3<&-)" || rc=$?
      case "$rc" in
        0)
          refusals+=("remote $remote names ${named#*$'\t'}, the repository release.publish.url names, and a cut pushes this workroom, its whole history, to every remote it pushes to -- the public repository takes the release commit's snapshot alone, which the cut pushes there itself: leave $remote out of release.remotes")
          continue
          ;;
        1) ;;
        *)
          refusals+=("whether remote $remote names the repository release.publish.url names cannot be told: $named -- a cut never pushes the workroom where that is not known")
          continue
          ;;
      esac
    fi
    answer="$(release_read_remote "$remote" "$branch" "$tag" "$commit" "$mode" 3<&-)" || {
      rc=$?
      refusals+=("reading remote $(release_url_shown "$remote") failed (exit $rc)")
      continue
    }
    case "${answer%%$'\t'*}" in
      already | pending) ;;
      *) refusals+=("${answer#*$'\t'}") ;;
    esac
  done 3<<<"$remotes"

  if [ "$source" = HEAD ]; then
    # THE TREE RULE, while the tag is absent: dirt inside the owned
    # set belongs in the release commit, whoever wrote it; dirt outside it is
    # refused, untracked files included. A `derived:` path is owned too, and
    # only running the command says which paths those are, so with `derived:`
    # declared the rest is checked at the stamp step, after they run. The list
    # is read from STDOUT ALONE, as release check reads it: notes.run's stderr,
    # or a child shell's warning, is never a path, here or in the trigger check
    # below, which asks with this list. A failure's own words go to the
    # terminal, and the refusal points at them.
    if ! owned="$(release_owned "$PROJECT_ROOT" "$v")"; then
      refusals+=("the paths this release owns cannot be listed (above)")
      # What it printed is no list a later read could take.
      owned=""
    elif ! dirt="$(release_dirt 2>&1)"; then
      refusals+=("git status failed: $(one_line "$dirt")")
    elif ! outside="$(release_outside "$dirt" "$owned")"; then
      refusals+=("which dirty paths lie outside what this release owns cannot be told")
    elif [ -n "$outside" ] && [ -n "$derived" ]; then
      deferred="$outside"
    elif [ -n "$outside" ]; then
      refusals+=("dirty outside what this release owns: ${outside//$'\n'/, } -- commit or stash it first")
    fi
    if ! out="$(notes_check "$PROJECT_ROOT" "$v" "$today" 2>&1)"; then
      refusals+=("$(one_line "$out")")
    fi
    # THE VERSION FILE MUST READ BEFORE A CUT STAMPS IT (issue 0259). The stamp
    # step runs `version set`, which starts a missing VERSION: inside a cut that
    # is a side effect, a release commit holding a version file the project
    # never kept, while the file that does hold its version, a mix.exs that
    # project.version_from was never pointed at, say, stays stale. So a version
    # that does not read is refused here, in version_unread's words, before
    # anything is written.
    local unread
    if unread="$(version_unread why)"; then
      refusals+=("the version cannot be read: $unread -- $(version_unread fix)")
    fi
    # THE RUN LOGS MUST BE IGNORED. A cut runs behind its own gate, and its gates
    # are devbin verbs behind theirs, so every one writes a log under
    # $(gate_out_dir <name>) for the whole of its run. Not ignored, each is dirt:
    # the tree rule would refuse the cut's own log, and the local gates' re-read would
    # see every gate change the tree. Each such directory ignores itself (issue
    # 0157), so this refuses only where it will not -- a .gitignore the project
    # put there, a tmp/ that leads outside the tree -- and asks the writer's own
    # rule, without writing, so a dry run and the cut agree. Where git could not
    # say, it says that, and never offers the remedy (issue 0186).
    ignored_rc=0
    ignored_why="$(gate_out_ignored "$(gate_out_dir release)")" || ignored_rc=$?
    case "$ignored_rc" in
      0) ;;
      2) refusals+=("git could not say whether $(gate_out_dir release)/ is ignored${ignored_why:+ -- $ignored_why}") ;;
      *) refusals+=("$(gate_out_dir release)/ is not ignored, and every gated run writes its log there -- add tmp/ to .gitignore") ;;
    esac
  else
    # A TAG FOR THE TARGET MUST CARRY THE RELEASE, or it is refused and never
    # moved or deleted (AC-4.5): its commit's VERSION is the target and its note
    # is dated for it, read from the tagged commit's own tree.
    if ! answer="$(cut_stamp_read tag "$commit" "$v" name)"; then
      refusals+=("whether $tag's commit (${commit:0:12}) carries the release cannot be read")
    else
      case "${answer%%$'\t'*}" in
        already) ;;
        *) refusals+=("$tag exists and its commit (${commit:0:12}) does not carry the release: ${answer#*$'\t'} -- a tag is never moved or deleted; release a later version") ;;
      esac
    fi
  fi

  if ! out="$(cut_gh_signed_in "$object")"; then
    refusals+=("$out")
  fi

  # THE ASSETS' WORKFLOW IS IN THE RELEASE COMMIT (ST0008 WP-08): a run at the
  # tag runs the workflow the tag's commit holds, and the commit step commits nothing
  # under .github. A name that names none would be found only at the object step, with
  # the release public, at the end of assets.wait.
  if [ -n "$assets_wf" ] && ! git cat-file -e "$commit:.github/workflows/$assets_wf" 2>/dev/null; then
    refusals+=("release.assets.workflow is $assets_wf, and ${commit:0:12} holds no .github/workflows/$assets_wf, so no run at the tag could build the assets")
  fi

  # THE CANDIDATE'S TARGET AND REF (ST0011): where the cut has a candidate leg
  # (cut_candidate_declared), the legs step pushes it to its candidate ref
  # where CI reads it. The ref is named once (release_candidate_ref), for the
  # confirm's question and the push, and must be a name git takes for a
  # branch. A PUBLISHING CUT'S candidate is the release commit's snapshot,
  # pushed to the public repository release.publish.url names. Any other's is
  # the release commit, pushed to the remote that pushes to the project's
  # repository, the one whose CI reads it (release_candidate_remote): none
  # pushing to it is refused here, before anything is stamped, and so are
  # remotes pushing to its OWNER/NAME on more than one host, none on its own,
  # each named with each host, the remedy naming the repository's own host
  # (release_repo_host).
  if cut_candidate_declared; then
    local cand_repo crc=0 cand_hit cand_host cand_named="" cand_own cand_on
    if ! cand_ref="$(cut_candidate_ref "$tag")"; then
      refusals+=("$cand_ref")
      cand_ref=""
    fi
    if [ -n "$publish_url" ]; then
      cand_remote="$publish_url"
      cand_shown="$(release_url_shown "$publish_url")"
    elif ! cand_repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
      refusals+=("the repository the candidate runs in cannot be named: $(one_line "$cand_repo")")
    else
      cand_remote="$(release_candidate_remote "$cand_repo" "$remotes")" || crc=$?
      case "$crc" in
        0) cand_shown="$cand_remote" ;;
        2) refusals+=("git cannot list the remotes or read a remote's urls, so the remote the candidate is pushed to cannot be found") ;;
        3)
          while IFS=$'\t' read -r cand_hit cand_host; do
            cand_named+=", $cand_hit on $cand_host"
          done <<<"$cand_remote"
          cand_remote=""
          if ! cand_own="$(release_repo_host "$cand_repo")"; then
            refusals+=("remotes push to the OWNER/NAME of $cand_repo on more than one host and none on its own, and its own host cannot be read from it: ${cand_named#, }")
          else
            cand_on="${cand_repo#"$cand_own"/}"
            refusals+=("no remote pushes to $cand_on on $cand_own, the repository's own host, and remotes push to $cand_on on more than one other host: ${cand_named#, }; the candidate's push to a mirror would run no CI -- point a remote's push url at $cand_on on $cand_own: a cut takes that remote before any other")
          fi
          ;;
        *) refusals+=("no remote of this repository pushes to $cand_repo, the repository whose CI runs the candidate -- add a remote for it, or declare release.repo as the repository a remote pushes to") ;;
      esac
    fi
  elif [ -n "$publish_url" ]; then
    # CI ON THE CANDIDATE IS THE PUBLISHING CUT'S GATE: one that cannot read it
    # makes nothing public.
    refusals+=("release.ci.query is -, the opt-out, so CI on the candidate cannot be read, and a cut under release.publish.url makes nothing public before it reads green -- drop the opt-out, or declare a query of your own")
  fi

  # THE PUBLISH SHAPE'S PUBLIC SIDE, refused before anything is stamped, as
  # the publish flow refused it (issue 0240): the snapshot list must be in the
  # commit the release commit is made on, since the stamp adds only its own
  # files; the release object is the public repository's, which no remote
  # names, so release.repo must name it; and the public repository must answer,
  # its refs read once here, from a repository of the run's own, for the
  # confirm's question and the legs step's refusal of a public tag at another
  # commit (publish_read).
  local snap_list pf_repo shown_pub=""
  if [ -n "$publish_url" ]; then
    shown_pub="$(release_url_shown "$publish_url")"
    if ! pbranch="$(snapshot_publish_branch)" || [ -z "$pbranch" ]; then
      refusals+=("the branch the snapshot is published to cannot be read: release.publish.branch, else release.branch")
      pbranch=""
    fi
    if ! snap_list="$(cfg_release_get snapshot.list)"; then
      refusals+=("release.snapshot.list cannot be read")
    elif [ -z "$snap_list" ]; then
      refusals+=("release.snapshot.list is not declared, so nothing says what ships to $shown_pub")
    elif ! git cat-file -e "$commit:$snap_list" 2>/dev/null; then
      refusals+=("release.snapshot.list is $snap_list, and ${commit:0:12} holds no such file, so nothing says what ships")
    fi
    if ! pf_repo="$(cfg_release_get repo)"; then
      refusals+=("release.repo cannot be read")
    elif [ "$object" != none ] && [ -z "$pf_repo" ]; then
      refusals+=("release.repo is not declared, and object: $object reads the release object of the public repository, which no remote of this project names -- declare release.repo: OWNER/NAME")
    fi
    # NO REMOTE OF THIS PROJECT MAY NAME THE PUBLIC REPOSITORY
    # (publish_url_named), and such a url is never read; any other's refs are
    # read once (publish_first_read), the read release status makes.
    if named="$(publish_url_named "$publish_url")"; then
      refusals+=("$named")
    elif [ -n "$pbranch" ] && [ -n "$cand_ref" ]; then
      answer="$(publish_first_read "$publish_url" "$pbranch" "$cand_ref" "$tag")"
      case "${answer%%$'\t'*}" in
        read) publish_refs "$answer" ;;
        *) refusals+=("${answer#*$'\t'}") ;;
      esac
    fi
  fi

  # THE REMOTE LEGS AND THE macOS STAGE (ST0011 WP-05, WP-06), read where the
  # legs will run, which they do not once the tag exists. Each host
  # release.legs names is reached (release_leg_reach): one reached is a leg of
  # the cut; one absent is named on this row, recorded as not run and never
  # waited for, so an absent machine never holds a release up; and one that
  # answered and cannot be read is refused, since its leg could only time out.
  # The macOS stage, where declared, is a leg of the cut, and on a host whose
  # platform word is not macos it is refused, naming the stage and the host's
  # word, as a gate active on no leg is: a release that ships a signed app is
  # never cut without it.
  local legs_list legs_host legs_reach legs_word legs_said="" legs_a legs_why
  # Each reached host with its platform word, `<host><TAB><word>`, empty for
  # a host with none: the words the gate check below reads.
  local -a legs_reached=()
  if [ "$source" != tag ]; then
    if legs_list="$(cfg_release_list legs)"; then
      # The name each host's bare repository takes, held to the runner's own
      # rule here, so a name no host can take refuses the cut before anything
      # is stamped, never at its first start after the release commit.
      legs_why=""
      [ -z "$legs_list" ] || legs_why="$(release_leg_project_problem "$(legs_project_name)")"
      [ -z "$legs_why" ] || refusals+=("release.legs: $legs_why -- set project.name to one")
      while IFS= read -r legs_host; do
        [ -n "$legs_host" ] || continue
        legs_reach="$(release_leg_reach "$legs_host")"
        case "${legs_reach%%$'\t'*}" in
          reached)
            LEGS_REMOTE+=("$legs_host")
            legs_reached+=("$legs_host"$'\t'"${legs_reach#*$'\t'}")
            ;;
          absent) LEGS_ABSENT+=("$legs_host"$'\t'"${legs_reach#*$'\t'}") ;;
          *) refusals+=("release.legs: $legs_host cannot be read as a leg: ${legs_reach#*$'\t'}") ;;
        esac
      done <<<"$legs_list"
    else
      refusals+=("release.legs cannot be read, so which remote legs the cut runs cannot be said")
    fi
    if cfg_macos_declared; then
      LEGS_MACOS=yes
      legs_word="$(platform_word)" || legs_word=""
      [ "$legs_word" = macos ] ||
        refusals+=("the macOS stage is declared (commands.macos.enabled), and this host is ${legs_word:-one devbin has no platform word for} -- cut the release on a macOS host, where the stage signs and notarises the app at the release commit")
    fi
  fi
  for legs_a in "${LEGS_ABSENT[@]}"; do
    legs_said+="; legs.${legs_a%%$'\t'*} absent, not run: ${legs_a#*$'\t'}"
  done

  # A GATE ACTIVE ON NO LEG IS REFUSED (ST0011 WP-02c, AC-6.3): an option a
  # gate's `all` runs, held back by its `platforms:` on every leg this cut will
  # run, here and on each host reached, would go unrun in silence, so the cut
  # stops here, before any gate runs, naming the gate, the option and its
  # platforms. A host absent at pre-flight runs nothing, so it is named as one
  # that might have covered the option, never counted as covering it. CI's own
  # platforms are the project's CI's business.
  if [ "$source" != tag ] && [ "${#gl[@]}" -gt 0 ]; then
    local here_word legs_on legs_gone="" unrun unrun_entry unrun_opt unrun_on
    local -a leg_words=()
    here_word="$(platform_word)" || here_word=""
    leg_words+=("$here_word")
    legs_on="this host is ${here_word:-one with no platform word}"
    for legs_a in "${legs_reached[@]}"; do
      leg_words+=("${legs_a#*$'\t'}")
      legs_word="${legs_a#*$'\t'}"
      legs_on+=", ${legs_a%%$'\t'*} is ${legs_word:-one with no platform word}"
    done
    for legs_a in "${LEGS_ABSENT[@]}"; do
      legs_gone+=", ${legs_a%%$'\t'*}"
    done
    # Read whole first, its status kept: a check that failed partway would name
    # fewer gates, and a gate left out of it would go unrun in silence.
    unrun="$(legs_gate_unrun "${leg_words[@]}")" ||
      refusals+=("which gates run on no leg of this cut cannot be said: the check of each gate's options stopped (above)")
    while IFS=$'\t' read -r unrun_entry unrun_opt unrun_on; do
      [ -n "$unrun_entry" ] || continue
      refusals+=("the gate $unrun_entry (release.gates) runs its option $unrun_opt only on $unrun_on, and no leg this cut runs is one: $legs_on${legs_gone:+; absent at pre-flight, and not counted: ${legs_gone#, }} -- cut the release where a leg is $unrun_on")
    done <<<"$unrun"
  fi

  # THE CANDIDATE'S PUSH MUST START ITS RUN (ST0011 WP-02c, AT-3.15): where
  # the cut has a candidate read by the built-in query (release_fires_read), a
  # push of its branch must start release.ci.workflow, as committed at HEAD,
  # given the files the release commit changes, the stamp's own
  # (release_owned), so a candidate whose push would start no run, or whose
  # trigger cannot be read, is refused here, naming the reader's reason and the
  # ways out, never waited for to ci.wait. With derived: declared, only running
  # the commands says which files they write, so no file is passed and the
  # reader reads the branch filters alone, naming that premise. Under
  # release.publish.url the candidate is the release commit's snapshot, whose
  # files the legs step reads once it has built it, and asks there. It asks
  # with the tree rule's own list of what this release owns, read above from
  # its stdout alone, which always names the version file: an empty one could
  # not be read, that rule has refused naming why, and nothing is asked
  # without it, since a refusal here would offer ways out that fix nothing.
  if [ "$source" != tag ] && [ -n "$cand_ref" ] && [ -z "$publish_url" ] && [ -n "$owned" ]; then
    local fires_line fires_rc=0
    local -a fires_paths=()
    if [ -z "$derived" ]; then
      mapfile -t fires_paths <<<"$owned"
    fi
    fires_line="$(release_fires_read "$cand_ref" "$commit" "${fires_paths[@]}")" || fires_rc=$?
    # Fires, or a query of the project's own: anything else is no run the cut
    # could read, which is never read as fires.
    case "$fires_rc" in
      0 | 3) ;;
      *) refusals+=("$fires_line") ;;
    esac
  fi

  if [ "${#refusals[@]}" -gt 0 ]; then
    cut_fail pre-flight "$(printf '%s; ' "${refusals[@]}" | sed 's/; $//')"
  fi
  local pf_public=""
  [ -z "$publish_url" ] ||
    pf_public="; $shown_pub answers: $pbranch $(publish_at "$pub_branch"), $cand_ref $(publish_at "$pub_cand"), $tag $(publish_at "$pub_tag")"
  cut_row pre-flight "done" "on $branch; $nremote remote(s) can take the push; $([ "$source" = HEAD ] && printf 'the tree and the note are ready' || printf '%s carries the release' "$tag")$legs_said$pf_public"
  if [ -n "$deferred" ] && [ "$dry_run" = 1 ]; then
    CUT_UNREACHED+=("the stamp step checks ${deferred//$'\n'/, } against what derived: writes, after it runs")
  fi

  # WHERE THE COMMIT STEP WILL COMMIT, THERE IS NO RELEASE COMMIT YET (0181), and
  # `commit` is still HEAD, which the cut never tags: its commit step makes a new
  # commit on HEAD. So the confirm step, which now comes first, and a dry run's
  # legs and tag rows name the commit the commit step makes, never HEAD's sha, and
  # the confirm step reads every remote as lacking it (push-new), as the cut's
  # own read does once the commit step has made it: a remote at HEAD is sent the
  # commit as well as the tag.
  local rel_at="${commit:0:12}" push_mode=push commit_to_make=no
  if [ "$source" = HEAD ] && [ "$head_is_release" = no ]; then
    commit_to_make=yes
    rel_at="the release commit the commit step makes"
    push_mode=push-new
  fi

  # --- confirm ------------------------------------------------------
  # THE ONE YES, BEFORE ANYTHING RUNS (ST0011): what is left that another
  # machine will see -- the candidate's push, the tag, each remote still to
  # receive the commit or the tag, and under `object: local` the release object
  # and its assets -- and the after: commands, which run under the same yes.
  # The tag, the pushes and the object are read through the same readers
  # `release status` reads the confirm step from, so the two cannot disagree
  # about whether anything is left.
  local -a left=() push_plan=()
  local object_work="" object_detail="" title repo="" declared_repo drem
  local attach_work=no assets_detail="" heading plan_words
  declared_repo="$(cfg_release_get repo)" || cut_fail confirm "release.repo cannot be read"
  drem="$(declared_remote)" || cut_fail confirm "the first declared remote cannot be read"
  cut_read_remotes "$push_mode" confirm
  push_plan=("${CUT_PLAN[@]}")
  local plan
  for plan in "${push_plan[@]}"; do
    plan_words="$(cut_plan_words "$plan")" || cut_fail confirm "the push plan cannot be worded"
    left+=("$plan_words")
  done
  title="$(object_title "$tag" "$v")" || cut_fail confirm "release.title cannot be read"
  local body_file="$SCRATCH/notes-body"
  # The release object is the cut's in either shape; in the publish shape it is
  # the public repository's, which release.repo names (pre-flight).
  if [ "$object" = local ]; then
    cut_object_left
  fi
  # THE PUBLIC SIDE'S WORK (publish shape): the snapshot made public, its
  # branch fast-forwarded and the tag at it, unless it is public already
  # (cut_public_left, over the refs pre-flight read).
  local public_left=no
  if [ -n "$publish_url" ] && cut_public_left "$pub_tag" "$pub_held"; then
    public_left=yes
    left=("make the snapshot public at $shown_pub, once every leg is green: fast-forward $pbranch to it and tag $tag at it, lightweight" "${left[@]}")
  fi
  [ "$how" = resume ] || left=("tag $tag at $rel_at" "${left[@]}")
  # THE CANDIDATE'S PUSH IS THE FIRST ACT ANOTHER MACHINE SEES (ST0011): the
  # legs step pushes it to its candidate ref, where CI runs on it, before
  # anything is tagged, and deletes it once the tag is pushed or the cut stops.
  # Past the tag the legs are not re-run, so nothing is pushed, save in the
  # publish shape while the snapshot is not public (legs_step). So do a remote
  # leg's start, which sends the release commit to its host, and the macOS
  # stage, which submits the app to Apple's notary service, both in the legs
  # step (ST0011 WP-05, WP-06).
  if [ "$source" != tag ]; then
    [ "$LEGS_MACOS" = no ] ||
      left=("sign the app at $rel_at and submit it to Apple's notary service (the macOS stage)" "${left[@]}")
    [ "${#LEGS_REMOTE[@]}" -eq 0 ] ||
      left=("send $rel_at to $(printf '%s, ' "${LEGS_REMOTE[@]}" | sed 's/, $//') and run the gates there (release.legs)" "${left[@]}")
  fi
  if [ -n "$cand_remote" ] && { [ "$source" != tag ] || [ "$public_left" = yes ]; }; then
    if [ -n "$publish_url" ]; then
      left=("push the snapshot of $rel_at to $cand_ref at $cand_shown, for CI, deleted once it is public" "${left[@]}")
    else
      left=("push $rel_at to $cand_shown as $cand_ref, for CI, deleted once $tag is pushed" "${left[@]}")
    fi
  fi
  if [ "$commit_to_make" = yes ]; then
    heading="release: $tag, at the release commit the commit step makes on ${commit:0:12}"
  else
    heading="release: $tag, release commit ${commit:0:12}"
  fi
  [ -z "$publish_url" ] || heading+=", its snapshot made public at $shown_pub"
  if { [ "$source" != tag ] || [ "$public_left" = yes ]; } && { [ "${#gl[@]}" -gt 0 ] || [ -n "$cand_remote" ] ||
    [ "${#LEGS_REMOTE[@]}" -gt 0 ] || [ "$LEGS_MACOS" = yes ]; }; then
    heading+=", once every leg is green"
  fi

  # Set by cut_confirm, read by the steps after it.
  local confirmed=no ask_next=""
  cut_confirm "the cut" "$heading" "$after_list"

  # --- stamp -------------------------------------------------------
  if [ "$source" = tag ]; then
    cut_row stamp already "$tag's commit carries it (read at pre-flight)"
  elif [ "$head_is_release" = yes ]; then
    # THE RELEASE COMMIT EXISTS, so derived: is not re-run: its output need not
    # be byte-stable, and a second run of it would make a second release commit
    # on top of one a remote may already carry.
    cut_row stamp already "${commit:0:12} carries the stamp and the tree is clean (read at pre-flight); derived: is not re-run"
  else
    answer="$(release_read_stamp "$PROJECT_ROOT" "$v" count)" || cut_fail stamp "reading the stamp failed (exit $?)"
    state="${answer%%$'\t'*}"
    detail="${answer#*$'\t'}"
    if [ "$state" = UNREADABLE ]; then
      cut_fail stamp "$detail"
    elif [ "$state" = already ] && [ -z "$derived" ]; then
      cut_row stamp already "$detail"
    elif [ "$dry_run" = 1 ]; then
      have="$(read_version)" || cut_fail stamp "reading the version failed (exit $?)"
      cut_row stamp would "$([ "$have" = "$v" ] || printf 'version set %s (it is %s); ' "$v" "$have")$([ -z "$derived" ] || printf 'run derived: (%s command(s)); ' "$(grep -c . <<<"$derived")")date the note $today; regenerate the views"
      [ -z "$derived" ] || CUT_UNREACHED+=("the stamp step's owned-set check of what derived: writes: a dry run does not run derived: commands")
    else
      have="$(read_version)" || cut_fail stamp "reading the version failed (exit $?)"
      if [ "$have" != "$v" ]; then
        gate_exec "$launcher" version set "$v" || cut_fail stamp "version set $v failed (exit $?, above)"
      fi
      local d
      local -a words=()
      while IFS= read -r d <&3; do
        [ -n "$d" ] || continue
        run_words words release.derived "$d" 2>/dev/null || cut_fail stamp "the derived: command '$d' holds no words"
        out="$("${words[@]}" 3<&-)" || cut_fail stamp "the derived: command '$d' failed (exit $?)"
        written+="$out"$'\n'
      done 3<<<"$derived"
      if ! out="$(notes_date "$PROJECT_ROOT" "$v" "$today" 2>&1)"; then
        cut_fail stamp "dating the note failed: $(one_line "$out")"
      fi
      if ! out="$(notes_views "$PROJECT_ROOT" 2>&1)"; then
        cut_fail stamp "regenerating the views failed: $(one_line "$out")"
      fi
      # The owned set is now whole: what was known, plus what derived: wrote.
      local w norm=""
      while IFS= read -r w; do
        [ -z "$w" ] || norm+="${w#"$PROJECT_ROOT"/}"$'\n'
      done <<<"$written"
      written="$norm"
      if ! dirt="$(release_dirt 2>&1)"; then
        cut_fail stamp "git status failed: $(one_line "$dirt")"
      fi
      outside="$(release_outside "$dirt" "$owned"$'\n'"$written")" ||
        cut_fail stamp "which dirty paths lie outside what this release owns cannot be told (exit $?)"
      [ -z "$outside" ] || cut_fail stamp "dirty outside what this release owns: ${outside//$'\n'/, } -- commit or stash it first"
      # The postcondition, read again: a write that did not take is a failure,
      # never a `done`. NO ARM REACHES IT: version set and notes_date each read
      # their own write back, so a mutant dropping this lives. It is kept
      # because it is one read, and it holds for a writer that does not.
      answer="$(release_read_stamp "$PROJECT_ROOT" "$v" count)" || cut_fail stamp "reading the stamp back failed (exit $?)"
      [ "${answer%%$'\t'*}" = already ] || cut_fail stamp "the stamp did not take: ${answer#*$'\t'}"
      cut_row stamp "done" "${answer#*$'\t'}$([ -z "$derived" ] || printf '; derived: ran')"
    fi
  fi

  # --- commit ------------------------------------------------------
  # An UNREADABLE postcondition is pre-flight's refusal now, read before the
  # confirm step asks.
  local release_made=yes
  if [ "$source" = tag ]; then
    cut_row commit already "${commit:0:12}, $tag's commit, is the release commit"
  else
    answer="$head_read"
    if [ "$head_is_release" = yes ]; then
      cut_row commit already "${commit:0:12} carries the stamp and the tree is clean"
    elif [ "$dry_run" = 1 ]; then
      cut_row commit would "commit the stamp as \"release: $tag\""
      release_made=no
    else
      dirt="$(release_dirt)" || cut_fail commit "git status failed"
      [ -n "$dirt" ] || cut_fail commit "${commit:0:12} does not carry the stamp, and there is nothing to commit: ${answer#*$'\t'}"
      local -a paths=()
      mapfile -t paths <<<"$dirt" || cut_fail commit "the dirty paths cannot be read into a list"
      git add -- "${paths[@]}" || cut_fail commit "git add failed (exit $?)"
      # `--only` is EQUIVALENT here and no arm can tell it gone:
      # pre-flight and the stamp step refuse any dirt outside the owned
      # set, staged included, so the index holds nothing these paths do not.
      # Kept so the commit stays exactly these paths if that rule ever moves.
      git commit -q --only -m "release: $tag" -- "${paths[@]}" </dev/null ||
        cut_fail commit "git commit failed (exit $?, above)"
      commit="$(git rev-parse HEAD)" || cut_fail commit "the new HEAD cannot be read: git rev-parse HEAD exited $?"
      rel_at="${commit:0:12}"
      # Read again on the new HEAD. NO ARM REACHES IT: the stamp step left the stamp in
      # the tree and every dirty path is in this commit, so a mutant dropping it
      # lives. Kept as the guard that a commit hook rewriting the
      # commit, or a commit of the wrong paths, is FAILED rather than done.
      answer="$(cut_stamp_read commit "$commit" "$v" count)" ||
        cut_fail commit "reading the stamp at ${commit:0:12} failed (exit $?)"
      [ "${answer%%$'\t'*}" = already ] || cut_fail commit "${commit:0:12} does not carry the stamp: ${answer#*$'\t'}"
      [ "$(release_read_clean | cut -f1)" = already ] || cut_fail commit "the tree is not clean after the commit: $(release_read_clean | cut -f2-)"
      cut_row commit "done" "${commit:0:12} \"release: $tag\", ${#paths[@]} path(s)"
    fi
  fi

  # --- legs --------------------------------------------------------
  # EVERY LEG AT ONCE, THEN ONE WAIT LOOP (ST0011, AC-2.2; legs_step): the
  # local gates in place at the release commit, under one seal of their own,
  # and, unless ci.query is -, the opt-out, the candidate's matrix on its ref.
  # The tag and push come only after every leg is green. A leg already green
  # for this commit is not started again (the local gates' seal, WP01); a dry
  # run starts nothing.
  #
  # THE SNAPSHOT, ONCE THE RELEASE COMMIT EXISTS (publish shape): S, made of R
  # alone (snapshot_build), in the run's scratch, on the tip of the publish
  # branch at release.publish.url, before any leg starts, a dry run's
  # included, which pushes nothing. A resumed cut makes it again and finds the
  # same commit, a published tip being found rather than built on. A PUBLIC TAG
  # AT ANOTHER COMMIT IS REFUSED HERE, before anything is pushed: a tag is never
  # moved, and one already in the public history is a release published before
  # a later one was made on it, with nothing of it left to publish.
  if [ -n "$publish_url" ] && [ "$release_made" = yes ]; then
    snapshot_build "$commit" "$SCRATCH/snapshot" 0 || cut_fail legs "the release commit's snapshot could not be made: $SNAPSHOT_WHY"
    snap="$SNAPSHOT_COMMIT"
    if [ -n "$pub_tag" ] && [ "$pub_tag" != "$snap" ]; then
      # Held by the publish branch, as pre-flight read it (publish_read): the
      # one ancestry read the confirm step and release status ask too.
      [ "$pub_held" != yes ] ||
        cut_fail legs "$tag is public already, at ${pub_tag:0:12}, in the history of $pbranch at $shown_pub, which a later release was published on: nothing of it is left to publish, and a tag is never moved -- nothing pushed"
      cut_fail legs "$shown_pub carries $tag at ${pub_tag:0:12}, and this release's snapshot is ${snap:0:12}: a tag is never moved -- nothing pushed"
    fi
    [ "$pub_tag" != "$snap" ] || [ "$pub_branch" != "$snap" ] || snap_public=yes
    # Its push must start its run, read before anything is pushed (ST0011
    # WP-02c): a snapshot already public has no candidate to push.
    if [ -n "$cand_remote" ] && [ "$snap_public" != yes ]; then
      cut_snapshot_trigger
    fi
  fi
  legs_step || cut_fail legs "the legs step ended with exit $? and no verdict"

  # --- tag ----------------------------------------------------------
  # THE REMOTES, READ AGAIN NOW THAT THE RELEASE COMMIT EXISTS (ST0011). The
  # confirm step read them before the stamp, the commit and the gates, which
  # take a while, and a remote that moved or stopped answering since stops the
  # run here, before anything is tagged, as the confirm step's own read stopped
  # it when that step came after the gates. A plan that differs from the one
  # confirmed is refused whole: the yes was to that plan, and the remedy is to
  # run again, which the gates' sealed green makes cheap.
  if [ "$dry_run" = 0 ]; then
    cut_read_remotes push tag
    if [ "${CUT_PLAN[*]}" != "${push_plan[*]}" ]; then
      cut_fail tag "the remotes changed after the confirm step, which confirmed $(cut_plan_words "${push_plan[@]}"), and they now read $(cut_plan_words "${CUT_PLAN[@]}") -- run again, and the confirm step names what is left"
    fi
  fi
  # Annotated, at the release commit's SHA and never HEAD, its message the notes
  # body read from the release commit's own tree. A tag found is reused
  # and reported, never rewritten (release_read_tag).
  cut_notes_body "$commit" "$v" "$body_file" tag
  if [ "$how" = resume ]; then
    answer="$(release_read_tag "$tag" "$SCRATCH/rel" "$v")" || cut_fail tag "reading $tag failed (exit $?)"
    cut_row tag already "${answer#*$'\t'}"
  elif [ "$dry_run" = 1 ]; then
    cut_row tag would "annotated tag $tag at $rel_at, its message the notes body"
  else
    # At the release commit's SHA, never HEAD. NO ARM REACHES THE
    # DIFFERENCE: the local gates fail a gate that moves HEAD, so HEAD is the
    # release commit here unless someone commits between the legs step and this one.
    git tag -a "$tag" "$commit" -F "$body_file" --cleanup=whitespace </dev/null ||
      cut_fail tag "git tag failed (exit $?, above)"
    CUT_OUTWARD+=", tagged $tag locally"
    # Read back by its FIELDS: the status is `already` and the reuse note is
    # empty, never a match on the detail's wording.
    answer="$(release_read_tag "$tag" "$SCRATCH/rel" "$v")" || cut_fail tag "reading $tag back failed (exit $?)"
    [ "${answer%%$'\t'*}" = already ] && [ -z "$(release_tag_reuse_note "$tag" "$SCRATCH/rel" "$v")" ] ||
      cut_fail tag "the tag was made and does not read back as made: ${answer#*$'\t'}"
    cut_row tag "done" "annotated $tag at ${commit:0:12}, its message the notes body"
  fi

  # --- push ---------------------------------------------------------
  # Per remote, in order: the RELEASE COMMIT to its branch (never HEAD, which
  # may have moved on), then the tag -- each only if the remote lacks it, so a
  # branch that has moved past the release commit is never pushed at.
  #
  # NEVER --force, ON EITHER PUSH. Both are fast-forwards when the tag step
  # read the remote, so a forced push reads the same to every arm -- and when
  # the remote has moved since that read, a rejected push is the remote saying
  # someone else's work is there. Forcing it would overwrite that work. A
  # rejection stops the push step, naming what this run already sent (cut_outward).
  #
  # THE PUBLIC REPOSITORY IS ONE MORE TARGET (publish shape), once every
  # remote holds the release: its branch fast-forwarded to S and the tag at S
  # (cut_push_public), named on the same row.
  local r halves pushed="" push_state push_detail
  if [ "${#push_plan[@]}" -eq 0 ]; then
    push_state=already push_detail="every remote holds the release commit on $branch and $tag"
  elif [ "$dry_run" = 1 ]; then
    push_state=would push_detail="$(printf '%s; ' "${push_plan[@]}" | sed 's/; $//')"
  else
    for plan in "${push_plan[@]}"; do
      r="${plan%% *}"
      halves=" ${plan#* } "
      if [[ "$halves" == *" commit "* ]]; then
        # The release commit, never HEAD: the same declaration as the tag step's. No
        # --force (above).
        cut_call push "pushing the release commit to $r's $branch" \
          release_git_remote push -q "$r" "$commit:refs/heads/$branch"
        CUT_OUTWARD+=", pushed $branch to $r"
      fi
      if [[ "$halves" == *" tag "* ]]; then
        # No --force (above): a tag the remote already has differently is not
        # this run's to replace (a tag is never moved).
        cut_call push "pushing $tag to $r" \
          release_git_remote push -q "$r" "refs/tags/$tag:refs/tags/$tag"
        CUT_OUTWARD+=", pushed $tag to $r"
      fi
      # READ BACK THROUGH A READ THAT DID NOT ANSWER (issue 0194): an
      # UNANSWERED read, and an ask cut off at its bound, is asked again up to
      # RELEASE_READBACK_SECONDS. What it ends as, and an UNREADABLE the remote
      # did answer, fails as a read that could not tell, never as the remote
      # lacking the release; a remote that answered without it fails at once.
      answer="$(release_wait "$RELEASE_READBACK_SECONDS" UNANSWERED UNANSWERED \
        release_read_remote "$r" "$branch" "$tag" "$commit" readback)" ||
        cut_fail push "reading back whether $r holds the release failed (exit $?)"
      case "${answer%%$'\t'*}" in
        already) ;;
        UNANSWERED) cut_fail push "could not read back whether $r holds the release after the push, in the ${RELEASE_READBACK_SECONDS}s a read-back waits: ${answer#*$'\t'}" ;;
        UNREADABLE) cut_fail push "could not read back whether $r holds the release after the push: ${answer#*$'\t'}" ;;
        *) cut_fail push "$r does not hold the release after the push: ${answer#*$'\t'}" ;;
      esac
      pushed+=", $r (${plan#* })"
    done
    push_state="done" push_detail="pushed to ${pushed#, }"
  fi
  if [ -n "$publish_url" ]; then
    cut_push_public
    push_detail+="; $shown_pub: $PUBLIC_DETAIL"
    if [ "$push_state" != "$PUBLIC_STATE" ]; then
      push_state="done"
      [ "$dry_run" = 0 ] || push_state=would
    fi
  fi
  cut_row push "$push_state" "$push_detail"
  # THE CANDIDATE GOES ONCE THE TAG IS PUSHED (AC-2.3), and in the publish
  # shape once the snapshot is public: its run has done its work, and the tag
  # is the release now. One that will not go is named, and the cut ends at exit
  # 1 saying so, the release standing (cut_tail).
  [ "$dry_run" = 1 ] || legs_cand_delete || :

  # THE OBJECT AND AFTER ARE READ AT THE COMMIT THE PUBLIC TAG NAMES: in the
  # publish shape the snapshot, where the attach and brew read it.
  if [ -n "$snap" ]; then
    commit="$snap"
    rel_at="${snap:0:12}"
  fi
  cut_tail
}

# cut_push_public -- the push step's public half, in cut_run's scope (its
# publish_url, shown_pub, pbranch, tag, snap, dry_run and the pub_ refs): S
# made public at release.publish.url, from the snapshot's repository. The
# publish branch fast-forwarded from the snapshot's parent to S, then the tag
# at S, lightweight, each read back (publish_reread). THE PUBLIC REFS ARE READ
# AGAIN FIRST: a tag another hand pushed, or a branch that moved while CI ran,
# is refused by name, and nothing is forced. Sets PUBLIC_STATE (already,
# would or done) and PUBLIC_DETAIL for the push row. A dry run pushes
# nothing, and with no release commit yet names the snapshot of the one the
# commit step makes.
PUBLIC_STATE="" PUBLIC_DETAIL=""
cut_push_public() {
  local moved tagged want_kind wrote=no url="$publish_url" cand="$cand_ref" made_on
  # publish_reread reads the caller's url, pbranch, cand and tag.
  if [ -z "$snap" ]; then
    PUBLIC_STATE=would
    PUBLIC_DETAIL="fast-forward $pbranch to the snapshot of the release commit the commit step makes, and tag $tag at it, lightweight"
    return 0
  fi
  if [ "$snap_public" = yes ]; then
    PUBLIC_STATE=already
    PUBLIC_DETAIL="$pbranch and $tag are at the snapshot ${snap:0:12}"
    return 0
  fi
  if [ "$dry_run" = 1 ]; then
    PUBLIC_STATE=would
    PUBLIC_DETAIL="$([ "$pub_branch" = "$snap" ] || printf 'fast-forward %s to the snapshot %s; ' "$pbranch" "${snap:0:12}")$([ "$pub_tag" = "$snap" ] || printf 'tag %s at it, lightweight; ' "$tag")each read back"
    return 0
  fi
  made_on="${SNAPSHOT_PARENT:0:12}"
  [ -n "$made_on" ] || made_on="no parent"
  publish_reread push "before anything public moves"
  # THE TAG FIRST, as a question: the branch does not move for a tag that could
  # not follow it.
  if [ -n "$pub_tag" ] && [ "$pub_tag" != "$snap" ]; then
    cut_fail push "$shown_pub carries $tag at ${pub_tag:0:12}, not at the snapshot ${snap:0:12}, pushed there by another hand: a tag is never moved -- $pbranch did not move"
  fi
  if [ "$pub_branch" = "$snap" ]; then
    moved="$pbranch was at ${snap:0:12} already"
  elif [ "$pub_branch" = "$SNAPSHOT_PARENT" ]; then
    # A fast-forward, never --force: the snapshot was made on this tip.
    cut_call push "fast-forwarding $pbranch at $shown_pub to ${snap:0:12}" \
      _snapshot_remote "$SNAPSHOT_DIR" push -q --end-of-options "$url" "$snap:refs/heads/$pbranch"
    CUT_OUTWARD+=", moved $pbranch at $shown_pub to ${snap:0:12}"
    moved="fast-forwarded $pbranch to ${snap:0:12}"
    wrote=yes
  else
    cut_fail push "$pbranch at $shown_pub is $(publish_at "$pub_branch"), and the snapshot was made on $made_on, so it cannot fast-forward, and nothing is forced -- cut the release again, which makes the snapshot on the new tip and reads CI on it; $tag did not move at $shown_pub"
  fi
  want_kind="$pub_tag_kind"
  if [ "$pub_tag" = "$snap" ]; then
    tagged="$tag was at ${snap:0:12} already, $pub_tag_kind"
  else
    # Lightweight: the commit pushed to the tag's ref, so it carries no tagger
    # identity. Never --force: a tag is never moved.
    cut_call push "pushing $tag to $shown_pub" \
      _snapshot_remote "$SNAPSHOT_DIR" push -q --end-of-options "$url" "$snap:refs/tags/$tag"
    CUT_OUTWARD+=", pushed $tag to $shown_pub"
    tagged="tagged $tag at ${snap:0:12}, lightweight"
    want_kind=lightweight
    wrote=yes
  fi
  publish_reread push "after the push"
  if [ "$pub_branch" != "$snap" ] || [ "$pub_tag" != "$snap" ] || [ "$pub_tag_kind" != "$want_kind" ]; then
    cut_fail push "$shown_pub does not read back as public: $pbranch $(publish_at "$pub_branch"), $tag $(publish_at "$pub_tag")${pub_tag_kind:+, $pub_tag_kind}, where both are to be at ${snap:0:12}, the tag $want_kind"
  fi
  PUBLIC_DETAIL="$moved; $tagged; each read back"
  if [ "$wrote" = yes ]; then PUBLIC_STATE="done"; else PUBLIC_STATE=already; fi
}

# cut_object_left -- the confirm step's read of the release object under
# object: local, in either shape, in the publish one the public repository's. THE
# OBJECT IS READ HERE, whole: whether it exists, and when it does, whether it
# carries this release's title and notes. A difference is work left, so it is
# named in the question and only a confirmed run changes it; no run reports
# `already` over an object that differs. Reads the caller's tag, v, commit
# (whose tree the notes body is read from), title, declared_repo, drem,
# assets_wf, body_file and commit_to_make; sets its repo, object_work,
# object_detail, attach_work and assets_detail, and adds to its left the work
# it finds. A read that fails fails the confirm step.
#
# WHILE THE COMMIT STEP HAS STILL TO MAKE THE RELEASE COMMIT (commit_to_make,
# since the confirm step comes first, ST0011), the notes body that object must
# carry is in no commit yet, and the tree that would be read is HEAD's, the
# note undated: so an object found then is named as work left whole, its title
# and notes set to this release's once the commit exists, and nothing is read
# from HEAD, whose tree the tag step must never take its message from.
cut_object_left() {
  local answer
  repo="$(release_repo "$declared_repo" "$drem" 2>&1)" || cut_fail confirm "$(one_line "$repo")"
  answer="$(release_read_object local "$tag" "$declared_repo" "$drem")" ||
    cut_fail confirm "reading the release object for $tag failed (exit $?)"
  case "${answer%%$'\t'*}" in
    already)
      if [ "${commit_to_make:-no}" = yes ]; then
        object_work=edit
        object_detail="a release object for $tag exists before its release commit does"
        left+=("set the release object's title and notes to this release's: $object_detail")
      else
        cut_notes_body "$commit" "$v" "$body_file" confirm
        answer="$(release_read_object_content "$repo" "$tag" "$title" "$body_file")" ||
          cut_fail confirm "reading the release object's title and notes failed (exit $?)"
        case "${answer%%$'\t'*}" in
          already) object_detail="${answer#*$'\t'}" ;;
          pending)
            object_work=edit
            object_detail="${answer#*$'\t'}"
            left+=("set the release object's title and notes: $object_detail")
            ;;
          *) cut_fail confirm "${answer#*$'\t'}" ;;
        esac
      fi
      ;;
    pending)
      object_work=create
      left+=("make the release object \"$title\"")
      ;;
    *) cut_fail confirm "${answer#*$'\t'}" ;;
  esac
  # THE ASSETS (ST0008 WP-08) are work left unless the object is this
  # release's and its SHA256SUMS agrees with it, read through the reader
  # status reads the object row with (release_read_assets), so status and a cut cannot
  # disagree, and bounded, as a resume past the push step reads a public release.
  # An object still to be made or set has none attached yet.
  if [ -n "$assets_wf" ]; then
    if [ -n "$object_work" ]; then
      attach_work=yes
      left+=("attach the assets $assets_wf's run at $tag built, and SHA256SUMS")
    else
      answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")" ||
        cut_fail confirm "reading the assets attached to $tag failed (exit $?)"
      case "${answer%%$'\t'*}" in
        already) assets_detail="${answer#*$'\t'}" ;;
        pending)
          attach_work=yes
          left+=("attach the assets $assets_wf's run at $tag built, and SHA256SUMS: ${answer#*$'\t'}")
          ;;
        *) cut_fail confirm "${answer#*$'\t'}" ;;
      esac
    fi
  fi
}

# cut_confirm <who> <heading> [<after>] -- the confirm step's question, for a
# cut, in either shape. THE WORK LEFT, JOINED ONCE,
# and the --yes row's words built once (0181), so every row and the question
# name one list, and a dry run given --yes says what the run's own row says.
# <who> names the run in a dry run's verdict (`the cut`), and <heading> opens
# the question at a terminal. <after> is release.after as read, one command a
# line: THE after: COMMANDS RUN UNDER THIS YES (ST0011), so wherever there is
# work to ask about the question and the row name them too. Reads the caller's
# left, tag, dry_run and assume_yes, and sets its confirmed and ask_next, which
# it declares:
#   confirmed  yes once this step was answered, at the prompt or by --yes: the
#              after step hands the tag to its commands as
#              DEVBIN_RELEASE_CONFIRMED. No yes is given where nothing is left
#              to ask about.
#   ask_next   what a dry run's verdict says the run does at this step (0181)
cut_confirm() {
  local who="$1" heading="$2" after="${3:-}" work="" then="" yes_detail asked=0
  [ "${#left[@]}" -eq 0 ] || work="$(printf '%s; ' "${left[@]}" | sed 's/; $//')"
  [ -z "$after" ] || then="; then, under this yes, after: ${after//$'\n'/; }"
  yes_detail="--yes given: $work$then"
  if [ "${#left[@]}" -eq 0 ]; then
    cut_row confirm "not re-run" "no irreversible step has work left"
    ask_next="$who has nothing left to ask about"
  elif [ "$dry_run" = 1 ] && [ "$assume_yes" = 1 ]; then
    # --YES ANSWERS THE QUESTION, so a dry run given it predicts the confirm step whole
    # and leaves nothing of it unpredicted.
    cut_row confirm would "$yes_detail"
    ask_next="given --yes, $who does not stop to ask"
  elif [ "$dry_run" = 1 ]; then
    cut_row confirm would "ask before: $work$then"
    CUT_UNREACHED+=("the confirm step's confirmation: a dry run never asks")
    ask_next="$who stops to ask at the confirm step"
  elif [ "$assume_yes" = 1 ]; then
    confirmed=yes
    cut_row confirm "done" "$yes_detail"
  else
    printf '\n%s. Still to do, and seen by other machines once done:\n' "$heading"
    printf '  - %s\n' "${left[@]}"
    [ -z "$after" ] || printf '  - then, under this yes, after: %s\n' "${after//$'\n'/; }"
    ask_person "release: go ahead?" || asked=$?
    case "$asked" in
      0)
        confirmed=yes
        cut_row confirm "done" "confirmed: $work$then"
        ;;
      1) cut_fail confirm "declined at the prompt" ;;
      *) cut_fail confirm "nobody to ask: no terminal, and --yes was not given" ;;
    esac
  fi
}

# cut_dry_verdict -- a dry run's last lines, under its table: what it could not
# reach, then THE VERDICT AS THE LAST LINE (0181). A passing dry run ended on
# "NOT REACHED" and "not predicted", and was read as a failure; a failing one
# stops at cut_fail, exit 1, and never gets here. Reads the caller's tag and
# ask_next.
cut_dry_verdict() {
  if [ "${#CUT_UNREACHED[@]}" -gt 0 ]; then
    printf '\nrelease: NOT REACHED by this dry run, so not predicted:\n'
    printf '  - %s\n' "${CUT_UNREACHED[@]}"
  fi
  printf '\nrelease: dry run of %s -- no step failed; %s\n' "$tag" "$ask_next"
}

# cut_tail -- the object and after steps, and the run's end, for a cut and
# in either shape, in the publish one about the snapshot: what reads and writes the release
# object and runs after:, against the repository
# release.repo names, or the one read off the first remote. Run in the
# caller's shell, it reads the caller's tag, v, commit (the commit the tag
# names, where the attach and brew read it), rel_at, branch, object, title,
# repo, declared_repo, drem, body_file, object_work, object_detail,
# attach_work, assets_detail, assets_wf, after_list, confirmed, ask_next and
# dry_run.
cut_tail() {
  # --- the release object ------------------------------------------
  case "$object" in
    none) cut_row object skipped "object: none" ;;
    ci)
      # THE PROJECT'S WORKFLOW MAKES THE OBJECT, from the tag the push step pushed, and
      # the core makes none: one writer per release object. The object step reads the
      # OBJECT, through the reader status reads it with, never a CI verdict:
      # another workflow's run on the release commit cannot stand in for it
      # (AC-6.1).
      local wait_for
      wait_for="$(cfg_release_get object_wait)" || cut_fail object "release.object_wait cannot be read"
      if [ "$dry_run" = 1 ]; then
        answer="$(release_wait 0 "" UNREADABLE release_read_object ci "$tag" "$declared_repo" "$drem")" ||
          cut_fail object "reading the release object for $tag failed (exit $?)"
        if [ "${answer%%$'\t'*}" = already ]; then
          cut_row object already "${answer#*$'\t'}"
        else
          cut_row object would "wait up to $wait_for (object_wait) for the workflow's release object for $tag; the core makes none"
        fi
      else
        # The postcondition first, one bounded ask, as every step reads its own:
        # an object already there is `already`, and only an absent one is waited
        # for.
        local secs
        secs="$(release_seconds "$wait_for" 2>&1)" || cut_fail object "$(one_line "$secs")"
        answer="$(release_wait 0 "" UNREADABLE release_read_object ci "$tag" "$declared_repo" "$drem")" ||
          cut_fail object "reading the release object for $tag failed (exit $?)"
        if [ "${answer%%$'\t'*}" = already ]; then
          cut_row object already "${answer#*$'\t'}; the core made none"
        else
          answer="$(release_wait "$secs" "pending UNREADABLE" UNREADABLE \
            release_read_object ci "$tag" "$declared_repo" "$drem")" ||
            cut_fail object "waiting for the release object for $tag failed (exit $?)"
          case "${answer%%$'\t'*}" in
            already) cut_row object "done" "the workflow made the release object for $tag within $wait_for; the core made none" ;;
            *) cut_fail object "no release object within $wait_for (object_wait): ${answer%%$'\t'*}, ${answer#*$'\t'}" ;;
          esac
        fi
      fi
      ;;
    local)
      local obj_state="" obj_detail=""
      if [ "$object_work" = create ]; then
        if [ "$dry_run" = 1 ]; then
          obj_state=would obj_detail="gh release create $tag --title \"$title\""
        else
          # --verify-tag: without it GitHub MAKES a tag it lacks, from the
          # default branch. THE LIMIT, DECLARED: nothing
          # checks that a remote in `remotes` reaches $repo. With `repo:`
          # declared and every push going elsewhere, --verify-tag refuses here,
          # after the pushes. A pre-flight check would have to map a remote's
          # url to a repository, which ssh host aliases, insteadOf and mirrors
          # all defeat, so a refusal there would refuse working setups.
          cut_call object "gh release create $tag" \
            release_gh "$repo" release create "$tag" --verify-tag --title "$title" --notes-file "$body_file"
          CUT_OUTWARD+=", made the release object for $tag"
          answer="$(release_wait 0 "" UNREADABLE release_read_object local "$tag" "$declared_repo" "$drem")" ||
            cut_fail object "reading back the release object for $tag failed (exit $?)"
          [ "${answer%%$'\t'*}" = already ] || cut_fail object "gh made no release object that reads back: ${answer#*$'\t'}"
          obj_state="done" obj_detail="made the release object \"$title\""
        fi
      elif [ "$object_work" = edit ]; then
        # The confirm step named the difference, and only a confirmed run gets here: the
        # object is brought to this release's title and notes, never made twice.
        if [ "$dry_run" = 1 ]; then
          obj_state=would obj_detail="gh release edit $tag: $object_detail"
        else
          # NO ARM REACHES IT: an edit is work left, so the confirm step has confirmed it or
          # stopped the run. Kept so the object step never edits on its own say-so.
          [ "$confirmed" = yes ] || cut_fail object "the release object differs and nobody confirmed changing it: $object_detail"
          cut_call object "gh release edit $tag" \
            release_gh "$repo" release edit "$tag" --title "$title" --notes-file "$body_file"
          CUT_OUTWARD+=", set the release object's title and notes for $tag"
          answer="$(release_wait 0 "" UNREADABLE release_read_object_content "$repo" "$tag" "$title" "$body_file")" ||
            cut_fail object "reading back the release object's title and notes failed (exit $?)"
          [ "${answer%%$'\t'*}" = already ] || cut_fail object "the release object does not read back as set: ${answer#*$'\t'}"
          obj_state="done" obj_detail="the release object existed ($object_detail); its title and notes were set to this release's"
        fi
      else
        obj_state=already obj_detail="$object_detail"
      fi
      # THE ATTACH, THE SAME FUNCTION `release attach` RUNS (ST0008 WP-08), after
      # the object, and only where the confirm step named it as work left.
      if [ "$attach_work" != yes ]; then
        cut_row object "$obj_state" "$obj_detail${assets_detail:+; $assets_detail}"
      elif [ "$dry_run" = 1 ]; then
        cut_row object would "$obj_detail; then attach the assets $assets_wf's run at $tag built, and SHA256SUMS, waiting up to $(cfg_release_get assets.wait) (assets.wait) for the run"
        CUT_UNREACHED+=("the object step's attach: a dry run reads no run's files and attaches nothing")
      else
        # NO ARM REACHES IT: the attach is work left, so the confirm step has confirmed it
        # or stopped the run. Kept so the object step never attaches on its own say-so.
        [ "$confirmed" = yes ] || cut_fail object "the assets have work left and nobody confirmed attaching them"
        printf '\nrelease: attach: the assets %s'"'"'s run at %s built\n' "$assets_wf" "$tag"
        if ! attach_assets "$tag" "$commit" "$repo" "$assets_wf" "$(cfg_release_get assets.wait)" "" "$cand_ref"; then
          [ -z "$ATTACH_OUTWARD" ] || CUT_OUTWARD+=", $ATTACH_OUTWARD"
          cut_fail object "$obj_detail; the attach stopped at $ATTACH_STAGE: $ATTACH_DETAIL"
        fi
        [ -z "$ATTACH_OUTWARD" ] || CUT_OUTWARD+=", $ATTACH_OUTWARD"
        if [ "$obj_state" = already ] && [ "$ATTACH_WROTE" = no ]; then
          cut_row object already "$obj_detail; the attach found $ATTACH_DETAIL"
        else
          cut_row object "done" "$obj_detail; attached $ATTACH_DETAIL"
        fi
      fi
      ;;
  esac

  # --- after ------------------------------------------------------
  # Each command in order, reported. Outside the core's guarantees: the
  # release is published by now, so a failure is reported and undoes nothing,
  # and the next command still runs. This step has no
  # postcondition, so a re-run of a finished release runs them again.
  local after="$after_list" cmd after_failed="" ran=0
  local -a aw=()
  # A mark inherited from whatever started this cut is not this cut's yes.
  unset DEVBIN_RELEASE_CONFIRMED
  if [ -z "$after" ]; then
    cut_row after skipped "no after: declared"
  elif [ "$dry_run" = 1 ]; then
    cut_row after would "run: $(printf '%s; ' "${after//$'\n'/; }" | sed 's/; $//')"
  else
    while IFS= read -r cmd <&3; do
      [ -n "$cmd" ] || continue
      run_words aw release.after "$cmd" 2>/dev/null || {
        after_failed+=", after: $cmd holds no words"
        continue
      }
      printf '\nrelease: after: %s\n' "$cmd"
      local arc=0
      # NOT THE ONLY THING KEEPING THE TERMINAL AWAY: the real cut runs
      # inside run_gate, whose stdin is /dev/null for everything in it, and a dry
      # run never gets here. Through gate_exec the line keeps the flag the
      # release gate set, since it runs inside that gate (issue 0158): an
      # `after:` command that is a script asking through ask_person can still ask
      # the person who was there when the cut began. A `bin/devbin` line cannot,
      # since the dispatcher drops the gate's mark and reads the person from its
      # own stdin, which is /dev/null here; it gets DEVBIN_RELEASE_CONFIRMED
      # instead, the tag, set whenever the confirm step was answered, at its
      # prompt or by --yes, since --yes IS that yes and the after: commands run
      # under it (ST0011; it was the prompt's alone, issue 0227), and never where
      # the step had nothing to ask. `formula publish` reads it as the yes for the
      # push the question named. Nothing but these commands is given it, and its
      # name and its value, the tag, stay what consumers read. And the after
      # step does not depend on its caller to keep stdin off the terminal.
      if [ "$confirmed" = yes ]; then
        DEVBIN_RELEASE_CONFIRMED="$tag" gate_exec "${aw[@]}" 3<&- || arc=$?
      else
        gate_exec "${aw[@]}" 3<&- || arc=$?
      fi
      if [ "$arc" -eq 0 ]; then
        ran=$((ran + 1))
      else
        after_failed+=", after: $cmd failed (exit $arc)"
      fi
    done 3<<<"$after"
    if [ -z "$after_failed" ]; then
      cut_row after "done" "$ran command(s) ran"
    else
      cut_row after FAILED "${after_failed#, }; $ran ran -- the release is published and nothing was undone"
    fi
  fi

  cut_summary
  if [ "$dry_run" = 1 ]; then
    cut_dry_verdict
    return 0
  fi
  if [ -n "$after_failed" ] || [ -n "$LEGS_CAND_LEFT" ]; then
    # THE RELEASE STANDS, and saying so is half the message: nothing here is
    # undone, and the tag is never moved. The other half is the remedy,
    # which is forward: what failed, run by hand, and a candidate that would
    # not go, deleted by hand.
    printf '\nrelease: %s is published, and the tag and the release stand.\n' "$tag"
    [ -z "$after_failed" ] ||
      printf 'release: %s -- after: runs outside the core'"'"'s guarantees; run what failed by hand.\n' "${after_failed#, }"
    # The command is the line's last word, so a copy of it takes no full stop.
    [ -z "$LEGS_CAND_LEFT" ] || printf 'release: %s\n' "$LEGS_CAND_LEFT"
    exit 1
  fi
  printf '\nrelease: %s is released.\n' "$tag"
  cut_back_to_brew "$tag" "$v" "$commit"
}

# ---------------------------------------------------------------------------
# THE ATTACH (ST0008 WP-08)
#
# ONE FUNCTION, WHEREVER IT RUNS: `release attach <v>`, which a project whose
# own command cuts its releases runs once its release object is made, and the object step
# of a cut under object: local, after the object. It attaches what the EARLIEST
# SUCCESSFUL run of release.assets.workflow at the tag built
# (release_read_assets_run), and writes one SHA256SUMS over every asset on the
# object. It never makes the release object and never dispatches a run.
#
# AND ONE WAY AN ASSET BUILT ON THIS MACHINE REACHES A RELEASE (issue 0226):
# `release attach <v> --from <dir>` attaches the files in <dir> instead of a
# run's, through the same checks, upload, SHA256SUMS and readback; the built-in
# macos attaches its zipped app this way. Its stages are object, assets, files,
# then upload, sums and readback as below. Its assets stage is not a finish
# line: with release.assets.workflow declared it requires the run's attach to
# have finished first, because an attach --from before it would leave
# SHA256SUMS agreeing with the object, and the run's attach would then read
# finished and attach nothing. Its files stage takes every file under <dir>, as
# download takes every file of the run's artifacts.
#
# ITS STAGES, EACH READING ITS POSTCONDITION FIRST, so a re-run continues:
#   object    the release object for the tag exists
#   assets    the attach's own postcondition, read before any run: SHA256SUMS
#             agreeing with every other asset on the object, through the reader
#             the object row and a cut's confirm step read (release_read_assets). When it
#             agrees the attach is finished: it reads no run, downloads nothing
#             but SHA256SUMS's own text, and writes nothing, so a re-run after
#             the run's artifacts expire is already, never a refusal
#   run       the run that ships, waited for within assets.wait, one bound for
#             both waits: while no run is listed, and while it is queued or in
#             progress
#   download  the run's artifacts as GitHub lists them, none expired, into this
#             run's scratch, one directory per artifact; every file inside them
#             is an asset, and every artifact listed must have arrived
#   upload    first every check the object's listing can answer: a file the
#             object holds at the same sha256 is already, one it holds with
#             other bytes is refused, never replaced, and every other asset must
#             be one SHA256SUMS can be written over. Then each file it lacks,
#             never with --clobber, and each reads back at its sha256.
#   sums      SHA256SUMS over every asset on the object, each hash from bytes
#             the attach holds: the run's files, and every other asset
#             downloaded from the release. The one asset it replaces, and only
#             when its text differs. Written LAST, once every upload has read
#             back, so its agreement with the object is what release_read_assets
#             reads a finished attach by.
#   readback  every asset this run wrote reads back at its sha256
#
# A stage that fails prints its FAILED row and returns 1 with ATTACH_STAGE and
# ATTACH_DETAIL set; ATTACH_OUTWARD says what it wrote to the release object,
# and what it MAY have written: a write cut off at its bound, and a --clobber
# that failed, which deletes before it uploads. ATTACH_WROTE says whether it
# wrote anything. EVERY CALL TO GITHUB IS BOUNDED, at
# RELEASE_CALL_SECONDS (attach_call) or the ask floor (release_wait): from step
# 9 on the release is public, and a call that hangs would hold it with nothing
# reporting it.
# ---------------------------------------------------------------------------
ATTACH_STAGE=""
ATTACH_DETAIL=""
ATTACH_OUTWARD=""
ATTACH_WROTE=no
ATTACH_CALL=""
ATTACH_CUT_OFF=no
ASSET_LIST=""
HELD_SHA=""

attach_row() { printf '  %-9s %-8s %s\n' "$1" "$2" "$3"; }

# attach_outward <act> -- add <act> to ATTACH_OUTWARD, what this run did, or
# may have done, to the release object, as a stop line says it.
attach_outward() { ATTACH_OUTWARD="${ATTACH_OUTWARD:+$ATTACH_OUTWARD, and }$1"; }

# attach_fail <stage> <detail> -- the stage's FAILED row, and the caller's facts.
attach_fail() {
  ATTACH_STAGE="$1"
  ATTACH_DETAIL="$2"
  attach_row "$1" FAILED "$2"
}

# attach_call <what> <cmd>... -- one gh call, bounded, its output kept in this
# run's scratch (attach.out); on failure ATTACH_CALL says why, naming <what>,
# and a call cut off at its bound says its effect is unknown and sets
# ATTACH_CUT_OFF, so a write cut off is named as one that may have happened.
attach_call() {
  local what="$1" rc=0
  shift
  ATTACH_CUT_OFF=no
  release_run_bounded "$RELEASE_CALL_SECONDS" "$SCRATCH/attach.out" "$SCRATCH/attach.err" "$@" || rc=$?
  case "$rc" in
    0) return 0 ;;
    124)
      ATTACH_CUT_OFF=yes
      ATTACH_CALL="$what did not finish within ${RELEASE_CALL_SECONDS}s and was stopped -- whether it took effect is unknown"
      ;;
    *) ATTACH_CALL="$what failed (exit $rc): $(one_line "$(cat "$SCRATCH/attach.err")")" ;;
  esac
  return 1
}

# attach_listing <repo> <tag> -- the release object's assets
# (release_object_assets) into ASSET_LIST, through attach_call.
attach_listing() {
  attach_call "listing the release object's assets" release_object_assets "$1" "$2" || return 1
  ASSET_LIST="$(cat "$SCRATCH/attach.out")"
}

# attach_upload <repo> <tag> <dir> <name> [--clobber] -- gh release upload of
# <dir>/<name>, run FROM <dir> with the bare name, in a subshell: gh reads a `#`
# anywhere in an upload's path as the start of a label, and a TMPDIR or an
# artifact's directory may hold one, while <name> has passed
# release_name_problem, which admits none.
attach_upload() (
  cd "$3" || exit 1
  release_gh "$1" release upload "$2" "${@:4}"
)

# attach_held <repo> <tag> <name> <dir> -- download the release's asset <name>
# into <dir>, which must not hold it yet, and set HELD_SHA to its sha256. Run in
# the caller's shell, never in a `$(...)`, so ATTACH_CALL reaches the caller
# when it fails.
attach_held() {
  local why
  HELD_SHA=""
  if why="$(release_pattern_problem "$3")"; then
    ATTACH_CALL="$3 cannot be read back from the release: $why"
    return 1
  fi
  mkdir -p "$4" || {
    ATTACH_CALL="no directory to download $3 into"
    return 1
  }
  attach_call "gh release download $3" release_gh "$1" release download "$2" --pattern "$3" --dir "$4" || return 1
  if [ ! -f "$4/$3" ]; then
    ATTACH_CALL="gh release download $3 wrote no file named $3"
    return 1
  fi
  if ! HELD_SHA="$(sha256_of "$4/$3")" || [ -z "$HELD_SHA" ]; then
    ATTACH_CALL="$3, downloaded, could not be hashed"
    return 1
  fi
}

# attach_reads_back <stage> <repo> <tag> <pairs> [<after>] -- each
# `<name><TAB><sha256>` of <pairs> is on the object at that sha256, read from a
# listing taken now (into ASSET_LIST); one that is not fails <stage>, its detail
# ending in <after>. The one read-back, after the run's uploads and after
# SHA256SUMS. READ_BACK counts what was read back.
READ_BACK=0
attach_reads_back() {
  local stage="$1" repo="$2" tag="$3" pairs="$4" after="${5:-}" name sha digest
  READ_BACK=0
  if ! attach_listing "$repo" "$tag"; then
    attach_fail "$stage" "the release object's assets could not be read back: $ATTACH_CALL$after"
    return 1
  fi
  while IFS=$'\t' read -r name sha; do
    [ -n "$name" ] || continue
    if ! digest="$(release_asset_digest "$ASSET_LIST" "$name")"; then
      attach_fail "$stage" "uploaded $name, and it does not read back at its sha256 $sha: the object holds no asset of that name$after"
      return 1
    fi
    if [ "$digest" != "sha256:$sha" ]; then
      attach_fail "$stage" "uploaded $name, and it does not read back at its sha256 $sha: GitHub lists ${digest:-no digest}$after"
      return 1
    fi
    READ_BACK=$((READ_BACK + 1))
  done <<<"$pairs"
}

# attach_take <stage> <place> <root> <none> -- every file of the caller's
# `files`, each found under <root>, checked as an asset and held, for the
# download stage and for --from's files stage alike: its name, sha256 and
# directory appended to the caller's names, shas and dirs, then every one's
# index in name order into the caller's order. <place> names the files' source
# in each refusal, as "in run 101's artifacts", and <none> is the refusal when
# there is no file at all. 0 when every file can be an asset, else <stage>'s
# FAILED row and 1. Called in the caller's shell, which owns the arrays.
attach_take() {
  local stage="$1" place="$2" root="$3" none="$4" f rel name sha why j i
  for f in "${files[@]}"; do
    rel="${f#"$root"/}"
    name="${f##*/}"
    if [ ! -f "$f" ] || [ -L "$f" ]; then
      attach_fail "$stage" "$rel, $place, is not a regular file"
      return 1
    fi
    if [ "$name" = SHA256SUMS ]; then
      attach_fail "$stage" "$rel, $place, cannot be an asset: SHA256SUMS is the name the attach writes its sums under"
      return 1
    fi
    if why="$(release_name_problem "$name")"; then
      attach_fail "$stage" "$rel, $place, cannot be an asset: $why"
      return 1
    fi
    for j in "${names[@]}"; do
      if [ "$j" = "$name" ]; then
        attach_fail "$stage" "two files $place are named $name, and a release object holds one asset of a name"
        return 1
      fi
    done
    if ! sha="$(sha256_of "$f")" || [ -z "$sha" ]; then
      attach_fail "$stage" "$rel could not be hashed"
      return 1
    fi
    names+=("$name")
    shas+=("$sha")
    dirs+=("${f%/*}")
  done
  if [ "${#names[@]}" -eq 0 ]; then
    attach_fail "$stage" "$none"
    return 1
  fi
  # In name order, so the rows and the uploads do not follow find's. The order
  # is checked whole: one shorter than the files would attach a part of them
  # and read the rest as already there.
  mapfile -t order < <(for i in "${!names[@]}"; do printf '%s\t%s\n' "${names[$i]}" "$i"; done | LC_ALL=C sort -t $'\t' -k1,1 | cut -f2)
  if [ "${#order[@]}" -ne "${#names[@]}" ]; then
    attach_fail "$stage" "the ${#names[@]} file(s) $place could not be put in order"
    return 1
  fi
}

# attach_assets <tag> <commit> <repo> <workflow> <wait> [<from>] [<candidate>]
# -- the stages above, their rows printed as they run. With <from>, a
# directory, the files under it are attached instead of a run's (issue 0226).
# <candidate> is the candidate's branch, empty where no candidate is in
# effect: the cut passes the one it pushed, and release attach names it as the
# cut would. 0 when every stage holds, 1 when one FAILED.
attach_assets() {
  local tag="$1" commit="$2" repo="$3" wf="$4" wait_for="$5" from="${6:-}" cand="${7:-}"
  local answer state rest id secs dl f rel name sha why i j digest sums_state n arts expired a source files_of
  local -a files=() names=() shas=() dirs=() order=() todo=() uploaded=() already=()
  local conflicts="" others="" pairs="" upl_pairs="" upl_sha=""
  ATTACH_STAGE="" ATTACH_DETAIL="" ATTACH_OUTWARD="" ATTACH_WROTE=no

  # --- object -------------------------------------------------------------
  # Asked of the repository this attach writes to, never resolved a second time.
  answer="$(release_wait 0 "" UNREADABLE release_read_object local "$tag" "$repo" "")"
  case "${answer%%$'\t'*}" in
    already) attach_row object already "${answer#*$'\t'}" ;;
    pending)
      attach_fail object "no release object for $tag, and the attach makes none -- make it, then attach"
      return 1
      ;;
    *)
      attach_fail object "${answer#*$'\t'}"
      return 1
      ;;
  esac

  if [ -n "$from" ]; then
    # --- assets, for --from ---------------------------------------------------
    # The run's attach first, where there is one: see the header.
    if [ -n "$wf" ]; then
      answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
      case "${answer%%$'\t'*}" in
        already) attach_row assets already "the run's attach has finished: ${answer#*$'\t'}" ;;
        pending)
          attach_fail assets "${answer#*$'\t'} -- release.assets.workflow is $wf, and its run's attach comes first: attach without --from first, then with it"
          return 1
          ;;
        *)
          attach_fail assets "${answer#*$'\t'}"
          return 1
          ;;
      esac
    else
      attach_row assets none "release.assets.workflow is not declared, so no run's attach comes first"
    fi

    # --- files ------------------------------------------------------------------
    if ! find_list files "$from" ! -type d -print0; then
      attach_fail files "the files under $from could not be listed (above)"
      return 1
    fi
    attach_take files "in $from" "$from" "there is no file under $from, so there is nothing to attach" || return 1
    source="$from's" files_of="$from"
    attach_row files "done" "${#names[@]} file(s) under $from: $(for i in "${order[@]}"; do printf '%s, ' "${names[$i]}"; done | sed 's/, $//')"
  else
    # --- assets ---------------------------------------------------------------
    # Read as the object row and a cut's confirm step read it, and as bounded: work is left only
    # when the reader says pending.
    answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
    case "${answer%%$'\t'*}" in
      already)
        attach_row assets already "${answer#*$'\t'}"
        ATTACH_DETAIL="finished already, so no run was read: ${answer#*$'\t'}"
        return 0
        ;;
      pending) attach_row assets pending "${answer#*$'\t'}" ;;
      *)
        attach_fail assets "${answer#*$'\t'}"
        return 1
        ;;
    esac

    # --- run -----------------------------------------------------------------
    # THE RUN ON THE CANDIDATE (ST0011 WP07): where one is in effect, the
    # commit CI tested is on the candidate's branch, and the run there is read
    # beside one at the tag.
    if ! secs="$(release_seconds "$wait_for" 2>&1)"; then
      attach_fail run "$(one_line "$secs")"
      return 1
    fi
    answer="$(release_wait "$secs" "pending UNREADABLE" UNREADABLE release_read_assets_run "$repo" "$wf" "$tag" "$commit" "$cand")"
    state="${answer%%$'\t'*}"
    rest="${answer#*$'\t'}"
    case "$state" in
      already)
        id="${rest%%$'\t'*}"
        attach_row run already "${rest#*$'\t'}"
        ;;
      failed)
        id="${rest%%$'\t'*}"
        attach_fail run "${rest#*$'\t'} -- the attach never dispatches a run: rerun it (gh run rerun $id) or dispatch one at the tag (gh workflow run $wf --ref $tag), then attach again"
        return 1
        ;;
      refused)
        attach_fail run "$rest"
        return 1
        ;;
      *)
        attach_fail run "no successful run within $wait_for (assets.wait): $state, $rest -- the attach never dispatches a run: dispatch one at the tag (gh workflow run $wf --ref $tag), or rerun a failed one (gh run rerun <id>), then attach again"
        return 1
        ;;
    esac

    # --- download ------------------------------------------------------------
    # THE RUN'S ARTIFACTS AS GITHUB LISTS THEM come first, and what gh run
    # download wrote is held to them: it passes over an expired artifact and
    # succeeds while any other downloads, which would attach part of the run and
    # write SHA256SUMS over that part.
    dl="$SCRATCH/assets/run-$id"
    if ! mkdir -p "$SCRATCH/assets" || [ -e "$dl" ]; then
      attach_fail download "no fresh directory under $SCRATCH for run $id's artifacts"
      return 1
    fi
    if ! attach_call "listing run $id's artifacts" release_run_artifacts "$repo" "$id"; then
      attach_fail download "$ATTACH_CALL"
      return 1
    fi
    arts="$(cat "$SCRATCH/attach.out")"
    if [ -z "$arts" ]; then
      attach_fail download "run $id lists no artifact, so there is nothing to attach"
      return 1
    fi
    expired="$(awk -F'\t' '$2 == "true" { printf "%s%s", sep, $1; sep = ", " }' <<<"$arts")"
    if [ -n "$expired" ]; then
      attach_fail download "run $id, the earliest successful run, has expired artifacts ($expired), and the attach ships that run's files alone -- a rerun of it (gh run rerun $id) is the one way that might give them back, and whether it does is not measured"
      return 1
    fi
    if ! attach_call "gh run download $id" release_gh "$repo" run download "$id" --dir "$dl"; then
      attach_fail download "$ATTACH_CALL"
      return 1
    fi
    while IFS=$'\t' read -r a _; do
      [ -n "$a" ] || continue
      if [ ! -d "$dl/$a" ]; then
        attach_fail download "run $id lists the artifact $a, and gh run download wrote no $a under $dl"
        return 1
      fi
    done <<<"$arts"
    if ! find_list files "$dl" ! -type d -print0; then
      attach_fail download "the files of run $id's artifacts could not be listed under $dl (above)"
      return 1
    fi
    attach_take download "in run $id's artifacts" "$dl" "run $id's artifacts hold no file, so there is nothing to attach" || return 1
    source="run $id's" files_of="run $id"
    attach_row download "done" "${#names[@]} file(s) from run $id's $(grep -c . <<<"$arts") artifact(s): $(for i in "${order[@]}"; do printf '%s, ' "${names[$i]}"; done | sed 's/, $//')"
  fi

  # --- upload ---------------------------------------------------------------
  if ! attach_listing "$repo" "$tag"; then
    attach_fail upload "$ATTACH_CALL"
    return 1
  fi
  # EVERY CHECK THE LISTING CAN ANSWER COMES BEFORE THE FIRST UPLOAD, so a
  # refusal it can name leaves the object as it was.
  for i in "${order[@]}"; do
    if ! digest="$(release_asset_digest "$ASSET_LIST" "${names[$i]}")"; then
      todo+=("$i")
      continue
    fi
    if [ -z "$digest" ]; then
      # GitHub lists no digest for it, so its bytes are read to compare.
      if ! attach_held "$repo" "$tag" "${names[$i]}" "$SCRATCH/assets/held"; then
        attach_fail upload "${names[$i]} is on the release object with no GitHub digest, and $ATTACH_CALL"
        return 1
      fi
      digest="sha256:$HELD_SHA"
    fi
    if [ "$digest" = "sha256:${shas[$i]}" ]; then
      already+=("${names[$i]}")
    else
      conflicts+="; ${names[$i]} at ${digest#sha256:}, where the run built ${shas[$i]}"
    fi
  done
  while IFS=$'\t' read -r name state digest; do
    [ -n "$name" ] && [ "$name" != SHA256SUMS ] || continue
    for i in "${order[@]}"; do [ "${names[$i]}" != "$name" ] || continue 2; done
    if [ "$state" != uploaded ]; then
      others+="; $name is $state, not uploaded"
    elif why="$(release_pattern_problem "$name")"; then
      others+="; $name: $why"
    fi
  done <<<"$ASSET_LIST"
  if [ -n "$conflicts" ]; then
    attach_fail upload "the release object already holds ${conflicts#; } -- the attach never replaces an asset: if the run's bytes are the ones to ship, delete that asset (gh release delete-asset $tag <name>), then attach again"
    return 1
  fi
  if [ -n "$others" ]; then
    attach_fail upload "SHA256SUMS could not be written over every asset on the release object: ${others#; } -- nothing was uploaded"
    return 1
  fi
  for i in "${todo[@]}"; do
    if ! attach_call "gh release upload ${names[$i]}" attach_upload "$repo" "$tag" "${dirs[$i]}" "${names[$i]}"; then
      [ "$ATTACH_CUT_OFF" = no ] || attach_outward "may have uploaded ${names[$i]}, whose upload was cut off at its bound"
      attach_fail upload "$ATTACH_CALL${uploaded[*]:+; uploaded before it: ${uploaded[*]}}"
      return 1
    fi
    uploaded+=("${names[$i]}")
    upl_pairs+="${names[$i]}"$'\t'"${shas[$i]}"$'\n'
    ATTACH_WROTE=yes
    ATTACH_OUTWARD="uploaded ${#uploaded[@]} asset(s) to the release object for $tag"
  done
  if [ "${#uploaded[@]}" -gt 0 ]; then
    # EACH UPLOAD READS BACK BEFORE SHA256SUMS IS WRITTEN, so SHA256SUMS on the
    # object always stands for uploads that took. This listing is the one the
    # sums are written over.
    attach_reads_back upload "$repo" "$tag" "$upl_pairs" " -- SHA256SUMS is not written" || return 1
    attach_row upload "done" "${#uploaded[@]} uploaded and read back (${uploaded[*]}), ${#already[@]} already"
  else
    attach_row upload already "every file of $files_of is on the release object at its sha256 (${already[*]})"
  fi

  # --- sums -----------------------------------------------------------------
  n=0
  while IFS=$'\t' read -r name state digest; do
    [ -n "$name" ] && [ "$name" != SHA256SUMS ] || continue
    n=$((n + 1))
    sha=""
    for i in "${order[@]}"; do
      if [ "${names[$i]}" = "$name" ]; then
        sha="${shas[$i]}"
        break
      fi
    done
    if [ -z "$sha" ]; then
      if ! attach_held "$repo" "$tag" "$name" "$SCRATCH/assets/release"; then
        attach_fail sums "$name could not be hashed for SHA256SUMS: $ATTACH_CALL"
        return 1
      fi
      sha="$HELD_SHA"
    fi
    pairs+="$name"$'\t'"$sha"$'\n'
  done <<<"$ASSET_LIST"
  mkdir -p "$SCRATCH/assets/sums" || {
    attach_fail sums "no directory to write SHA256SUMS in"
    return 1
  }
  if ! release_sums_text <<<"$pairs" >"$SCRATCH/assets/sums/SHA256SUMS"; then
    attach_fail sums "SHA256SUMS could not be written"
    return 1
  fi
  sums_state="done"
  if release_asset_digest "$ASSET_LIST" SHA256SUMS >/dev/null; then
    if ! attach_held "$repo" "$tag" SHA256SUMS "$SCRATCH/assets/current"; then
      attach_fail sums "the SHA256SUMS on the release object could not be read: $ATTACH_CALL"
      return 1
    fi
    if cmp -s "$SCRATCH/assets/current/SHA256SUMS" "$SCRATCH/assets/sums/SHA256SUMS"; then
      sums_state=already
    elif ! attach_call "gh release upload SHA256SUMS --clobber" attach_upload "$repo" "$tag" "$SCRATCH/assets/sums" SHA256SUMS --clobber; then
      # THE ONE ASSET THE ATTACH REPLACES: its own, and only on other text.
      # --clobber deletes the old one before it uploads the new, so a failure
      # here may already have deleted it.
      attach_outward "may have deleted or replaced the release object's SHA256SUMS, which --clobber deletes before it uploads"
      attach_fail sums "$ATTACH_CALL -- gh's --clobber deletes the old SHA256SUMS before it uploads the new one, so the object may now carry none; a re-run writes it"
      return 1
    fi
  elif ! attach_call "gh release upload SHA256SUMS" attach_upload "$repo" "$tag" "$SCRATCH/assets/sums" SHA256SUMS; then
    [ "$ATTACH_CUT_OFF" = no ] || attach_outward "may have written SHA256SUMS, whose upload was cut off at its bound"
    attach_fail sums "$ATTACH_CALL"
    return 1
  fi
  if [ "$sums_state" = "done" ]; then
    ATTACH_WROTE=yes
    if ! upl_sha="$(sha256_of "$SCRATCH/assets/sums/SHA256SUMS")" || [ -z "$upl_sha" ]; then
      attach_fail sums "SHA256SUMS was uploaded, and could not be hashed to read it back"
      return 1
    fi
    upl_pairs+="SHA256SUMS"$'\t'"$upl_sha"$'\n'
    attach_outward "wrote SHA256SUMS to the release object for $tag"
    attach_row sums "done" "SHA256SUMS written over the object's $n other asset(s)"
  else
    attach_row sums already "SHA256SUMS on the object already names its $n other asset(s) at the sha256 of their bytes"
  fi

  # --- readback ---------------------------------------------------------------
  if [ "$ATTACH_WROTE" = no ]; then
    attach_row readback already "nothing was written, so there is nothing to read back"
  else
    attach_reads_back readback "$repo" "$tag" "$upl_pairs" || return 1
    attach_row readback "done" "$READ_BACK upload(s) read back at their sha256"
  fi
  ATTACH_DETAIL="$source ${#names[@]} file(s): ${#uploaded[@]} uploaded, ${#already[@]} already; SHA256SUMS $([ "$sums_state" = "done" ] && printf written || printf current) over $n asset(s)"
  return 0
}

# attach_verb <version> [<from>] -- `release attach <version> [--from <dir>]`:
# the attach, for the tag this project releases <version> under, which must be
# here. Refused outside object: local; without <from>, also when
# release.assets.workflow names no workflow and when the tag's commit holds no
# such workflow. With <from>, the files under it are attached (issue 0226). 0
# when every stage holds, 1 when one FAILED.
attach_verb() {
  local v="$1" from="${2:-}" object wf tag commit repo named url rc=0 cand=""
  object="$(cfg_release_get object)" || die "release attach: cannot read release.object"
  [ "$object" = local ] ||
    die "release attach: object is $object, and the core attaches assets under object: local alone -- under ci the workflow writes the release object, and an attach would be its second writer"
  wf="$(cfg_release_get assets.workflow)" || die "release attach: cannot read release.assets.workflow"
  [ -n "$wf" ] || [ -n "$from" ] ||
    die "release attach: release.assets.workflow is not declared, so no run is named to attach the assets of -- declare the workflow whose run at the release commit builds them, or attach files with --from <dir>"
  tag="$(release_tag_name "$(cfg_release_get tag)" "$v")"
  # THE TAG'S COMMIT, through release_commit, the one reader of a release's
  # commit (ST0011 WP07): git's own words when it cannot read one, and a tag
  # that is not here refused, since release_commit answers HEAD for it.
  named="$(release_commit "$tag")" ||
    die "release attach: the commit $tag names cannot be read (above)"
  [ "${named#*$'\t'}" = tag ] ||
    die "release attach: there is no tag $tag here, and the assets are those of the release at it -- fetch the tags, or cut the release first"
  commit="${named%%$'\t'*}"
  if [ -z "$from" ]; then
    git cat-file -e "$commit:.github/workflows/$wf" 2>/dev/null ||
      die "release attach: release.assets.workflow is $wf, and $tag's commit (${commit:0:12}) holds no .github/workflows/$wf, so no run of it could have built the assets"
    # THE CANDIDATE, as the cut names the one it pushes, where the cut is
    # offered and a candidate is in effect (cut_candidate_declared, the one
    # test): with no cut, nothing pushes one.
    if offered cut && cut_candidate_declared; then
      cand="$(cut_candidate_ref "$tag")" || die "release attach: $cand"
    fi
    # UNDER release.publish.url THE RUN IS ON THE PUBLIC TAG'S COMMIT, the
    # release commit's snapshot, at the public repository, as the cut's own
    # attach reads it (ST0011 WP07): release_public_tag_commit, the one read.
    url="$(cfg_release_get publish.url)" || die "release attach: cannot read release.publish.url"
    if [ -n "$url" ]; then
      commit="$(release_public_tag_commit "$url" "$tag")" || rc=$?
      case "$rc" in
        0) ;;
        1) die "release attach: the public repository $(release_url_shown "$url") carries no tag $tag, and the assets' run is on the commit it names there -- a cut makes it public, once every leg is green: release $tag" ;;
        *) die "release attach: cannot read $tag at the public repository $(release_url_shown "$url") (above), so the commit the assets' run is on is not known" ;;
      esac
    fi
  fi
  repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)" ||
    die "release attach: $(one_line "${repo#*release: }")"
  open_scratch "release attach"
  if [ -n "$from" ]; then
    printf 'release: attach %s: the files under %s, onto %s'"'"'s release object for %s (%s)\n' \
      "$tag" "$from" "$repo" "$tag" "${commit:0:12}"
  else
    printf 'release: attach %s: the assets %s'"'"'s run at %s (%s) built, onto %s'"'"'s release object\n' \
      "$tag" "$wf" "$tag" "${commit:0:12}" "$repo"
  fi
  if attach_assets "$tag" "$commit" "$repo" "$wf" "$(cfg_release_get assets.wait)" "$from" "$cand"; then
    printf 'release: attach %s: %s\n' "$tag" "$ATTACH_DETAIL"
    return 0
  fi
  printf '\nrelease: attach %s stopped at %s. This run %s. Fix what the row names, then run it again: each stage reads what is already done first.\n' \
    "$tag" "$ATTACH_STAGE" "${ATTACH_OUTWARD:-uploaded nothing}"
  return 1
}

# --- the snapshot (issue 0239) ------------------------------------------------
#
# THE PUBLIC TREE IS ONE COMMIT OF THE PRODUCT (ST0010), made from a workroom
# commit and the shipped list, never from a checkout. `release snapshot` makes
# it, for an audit or a publication, and the publish flow (issue 0240) makes
# the same commit again before it pushes, through snapshot_build, which reads
# every input the sha depends on, so what was read is what goes public.
#
# PLUMBING THROUGHOUT. The commit's tree is read into an index of its own, the
# list selects from it as git reads a pathspec, exactly the selected blobs are
# copied into the new repository, and write-tree and commit-tree make the
# commit there. Nothing is read from a working tree, so every mode and every
# byte is the commit's, and the new repository holds no workroom object but the
# shipped blobs. Not `git archive`: it applies export-ignore and export-subst,
# and it writes files, whose modes and bytes would be read back off disk.
#
# DETERMINISTIC. Author and committer are release.snapshot.author, both dates
# the source commit's committer date in UTC, the message the template filled
# from the commit's own tree, and the commit is never signed, so the same
# inputs give the same sha, and a person approves a snapshot by its sha.
#
# A PARENT AFTER THE FIRST. Every release publishes a snapshot, and a second
# parentless commit is never a fast-forward of the first, so a snapshot is made
# on the tip of the publish branch at release.publish.url when there is one. It
# has no parent under --no-parent, or when the url is not declared, or when the
# branch is not there. A tip that is already this commit's snapshot is found,
# not built on (issue 0240), so a release published reads as the one sha.
#
# NEVER ON A HISTORY THAT IS NOT SNAPSHOTS. Until the public repository is
# made, its url can resolve to the private workroom copy, and building on that
# main would chain the workroom's whole history under the snapshot. So a
# publish.url that names the repository one of the project's own remotes
# names, by OWNER/NAME on any host (release_remote_naming), is refused before
# anything is fetched: its history is the project's own, and a first snapshot
# is made with --no-parent. Then the tip is fetched into the run's scratch,
# never into the new directory, and every commit behind it must be made and
# committed by snapshot.author, have one parent at most, and hold exactly its
# own tree filtered by the list its own tree carries, or by the given list when
# it carries none; only then does that history reach the new repository. The
# path test is the one that tells a workroom commit from a snapshot when both
# are made under one identity, for a copy of the history under a name no remote
# carries, and it does so only where the workroom carries a path outside its
# list, as devbin's carries intent/. Reading each commit's own list keeps an
# older snapshot good after a path leaves the list. The walk always ends in a
# parentless root: git's fetch takes nothing from a shallow history and refuses
# a missing parent, and every call runs with git's local variables cleared,
# GIT_SHALLOW_FILE and GIT_GRAFT_FILE among them.
#
# ONE SCRATCH, ONE TRAP. What the build reads and writes on the way, the
# selection's index, the pack, the version file, and the tip with its history,
# is under the release core's scratch root (open_scratch), outside the project,
# which its trap removes at exit, an interrupt's included. The new directory is
# made only once every refusal has been made, and a failure after that removes
# it. An interrupt can leave it part-made, holding only shipped blobs and the
# checked public history, for a rerun to refuse as existing. Its checkout is
# written under the person's own git attributes and filters, as
# release_materialise's is; the commit is made from the index, never from it.

SNAPSHOT_WHY=""
SNAPSHOT_DIR=""
SNAPSHOT_COMMIT=""
SNAPSHOT_TREE=""
SNAPSHOT_PARENT=""
SNAPSHOT_LIST=""
SNAPSHOT_BRANCH=""

# _snapshot_git [--index <file>] <git-args>... -- git with every one of its
# repository-local variables cleared, as git lists them (git_local_env_clear),
# and the pathspec variables, which that list leaves out, so each call acts on
# the repository its -C names, walks its whole history, and reads a line of the
# list as git reads a pathspec by default, whatever the caller exported.
# --index names the index the call reads and writes; with none, a call has its
# repository's own. No hook runs and no reflog is written, so a build's index
# and ref writes run none of the person's hooks and record no identity but the
# snapshot's. A subshell, never `env` or `exec`, so a caller's `git` that is a
# shell function still answers, as git_remote keeps. snapshot_build primes the
# list of variables in its own shell first, so git is asked for it once.
_snapshot_git() {
  local index=""
  if [ "${1-}" = --index ]; then
    index="$2"
    shift 2
  fi
  git_readonly_prime || return 1
  (
    git_local_env_clear || exit 1
    unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
    # shellcheck disable=SC2031 # the subshell is the point: the index is this call's alone
    if [ -n "$index" ]; then export GIT_INDEX_FILE="$index"; fi
    git -c core.hooksPath=/dev/null -c core.logAllRefUpdates=false "$@"
  )
}

# _snapshot_remote <repo> <git-args>... -- a call to a remote, through
# release_git_remote, made from <repo> with git's local variables cleared as
# _snapshot_git clears them, so the url is read in that repository's context
# alone: the ls-remote that finds the tip and the fetch that takes it read one
# url one way.
_snapshot_remote() {
  local repo="$1"
  shift
  git_readonly_prime || return 1
  (
    git_local_env_clear || exit 1
    release_git_remote -C "$repo" -c core.hooksPath=/dev/null -c core.logAllRefUpdates=false "$@"
  )
}

# snapshot_publish_branch -- the public branch each release's snapshot follows:
# release.publish.branch, else release.branch. THE ONE READER of it, the
# snapshot's and the publish flow's (issue 0240), so the branch a snapshot is
# made on is the branch it is published to.
snapshot_publish_branch() {
  if cfg_release_declared publish.branch; then
    cfg_release_get publish.branch
  else
    cfg_release_get branch
  fi
}

# _snapshot_commit_tree <repo> <tree> [<parent>] -- the snapshot's commit of
# <tree> in <repo>, on <parent> when one is given, its sha printed: one
# identity, one date, one message, and no encoding header a config could add,
# so the same inputs give the same sha. commit-tree signs only under -S, which
# is never given, and --no-gpg-sign says so on the line. THE ONE WAY a
# snapshot's commit is made, the one asked of a publish branch's tip included
# (issue 0240), from snapshot_build's name, email, date and message, read in
# its shell.
_snapshot_commit_tree() {
  local -a ps=()
  [ -z "${3:-}" ] || ps=(-p "$3")
  GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_AUTHOR_DATE="$date +0000" \
    GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" GIT_COMMITTER_DATE="$date +0000" \
    _snapshot_git -C "$1" -c i18n.commitEncoding=UTF-8 \
    commit-tree --no-gpg-sign "$2" ${ps[@]+"${ps[@]}"} -m "$message"
}

# _snapshot_select <repo> <commit> <index> <out> <spec>... -- <commit>'s tree
# read into <index>, and the entries the specs select written to <out> as
# `git ls-files -s -z` writes them. rc 1 with SNAPSHOT_WHY, carrying git's
# first line, when either cannot be done.
_snapshot_select() {
  local repo="$1" commit="$2" index="$3" out="$4" err
  shift 4
  if ! err="$(_snapshot_git --index "$index" -C "$repo" read-tree "$commit" 2>&1)"; then
    SNAPSHOT_WHY="git could not read the tree of ${commit:0:12}: ${err%%$'\n'*}"
    return 1
  fi
  if ! err="$(_snapshot_git --index "$index" -C "$repo" ls-files -s -z -- "$@" 2>&1 >"$out")"; then
    SNAPSHOT_WHY="git could not list what the list selects at ${commit:0:12}: ${err%%$'\n'*}"
    return 1
  fi
}

# _snapshot_norm <file> <ls-files|ls-tree> -- the NUL-ended records in <file>,
# as `ls-files -s -z` or `ls-tree -r -z` writes them, as `<mode> <sha><TAB><path>`
# records, so a selection and a tree read back compare byte for byte. Both are
# in git's one order, a path's bytes, so neither is sorted.
_snapshot_norm() {
  local rec meta rest
  while IFS= read -r -d '' rec; do
    meta="${rec%%$'\t'*}"
    case "$2" in
      ls-files)
        rest="${meta#* }"
        printf '%s %s\t%s\0' "${meta%% *}" "${rest%% *}" "${rec#*$'\t'}"
        ;;
      *) printf '%s %s\t%s\0' "${meta%% *}" "${meta##* }" "${rec#*$'\t'}" ;;
    esac
  done <"$1"
}

# _snapshot_abort <made> <dir> <why> -- SNAPSHOT_WHY set to <why>, and <dir>
# removed when this run made it (<made> yes), saying so, so a failure leaves
# nothing behind that a rerun would refuse. The scratch is the trap's.
_snapshot_abort() {
  local shown
  SNAPSHOT_WHY="$3"
  [ "$1" = yes ] || return 0
  if rm -rf -- "$2"; then
    SNAPSHOT_WHY+="; $2, which this run made, was removed"
  else
    printf -v shown '%q' "$2"
    SNAPSHOT_WHY+="; $2, which this run made, could not be removed: remove it with rm -rf $shown"
  fi
}

# _snapshot_history <repo> <tip> <list> <author> <work> <spec>... -- rc 0 when
# every commit behind <tip> in <repo>, <tip> included, is a snapshot: made and
# committed by <author>, with one parent at most, and holding exactly its own
# tree filtered by the list its tree carries at <list> (the given specs when it
# carries none). rc 1 with SNAPSHOT_WHY naming the first commit that is not,
# and who made it. Its scratch is under <work>.
_snapshot_history() {
  local repo="$1" tip="$2" list="$3" author="$4" work="$5" line c text who byline extra err
  shift 5
  local -a given=("$@") walk=() own=()
  SNAPSHOT_WHY=""
  if ! err="$(_snapshot_git -C "$repo" rev-list --parents "$tip" 2>&1 >"$work/walk")"; then
    SNAPSHOT_WHY="git could not walk the history behind the publish branch's tip ${tip:0:12}: ${err%%$'\n'*}"
    return 1
  fi
  while IFS= read -r line; do
    read -r -a walk <<<"$line"
    c="${walk[0]}"
    if ! who="$(_snapshot_git -C "$repo" show -s --no-show-signature --format='%an <%ae>%n%cn <%ce>' "$c" 2>/dev/null)"; then
      SNAPSHOT_WHY="git could not read who made ${c:0:12}, in the publish branch's history"
      return 1
    fi
    byline="made by ${who%%$'\n'*} and committed by ${who#*$'\n'}"
    if [ "${#walk[@]}" -gt 2 ]; then
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, a merge, $byline, and a snapshot has one parent at most, so it is no snapshot"
      return 1
    fi
    if [ "$who" != "$author"$'\n'"$author" ]; then
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, $byline, not by release.snapshot.author ($author), so it is no snapshot"
      return 1
    fi
    if text="$(_snapshot_git -C "$repo" cat-file blob "$c:$list" 2>/dev/null)"; then
      mapfile -t own < <(pathlist_specs "$text")
    else
      own=("${given[@]}")
    fi
    if [ "${#own[@]}" -eq 0 ]; then
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, $byline, whose list $list names no path, so it is no snapshot"
      return 1
    fi
    _snapshot_select "$repo" "$c" "$work/hist.index" "$work/hist.sel" "${own[@]}" || return 1
    if ! err="$(_snapshot_git --index "$work/hist.index" -C "$repo" ls-files -s -z 2>&1 >"$work/hist.all")"; then
      SNAPSHOT_WHY="git could not list the tree of ${c:0:12}, in the publish branch's history: ${err%%$'\n'*}"
      return 1
    fi
    if ! cmp -s "$work/hist.sel" "$work/hist.all"; then
      # The first path, in byte order, that it carries outside its list, for
      # the refusal to name.
      extra=""
      if tr '\0' '\n' <"$work/hist.all" | cut -f2- | LC_ALL=C sort >"$work/hist.all.txt" &&
        tr '\0' '\n' <"$work/hist.sel" | cut -f2- | LC_ALL=C sort >"$work/hist.sel.txt" &&
        LC_ALL=C comm -23 "$work/hist.all.txt" "$work/hist.sel.txt" >"$work/hist.extra.txt"; then
        IFS= read -r extra <"$work/hist.extra.txt" || extra=""
      fi
      SNAPSHOT_WHY="the publish branch's history holds ${c:0:12}, $byline, which carries ${extra:-a path} outside the list its own tree carries, so it is no snapshot"
      return 1
    fi
  done <"$work/walk"
  return 0
}

# snapshot_build <commit> <dir> <no-parent> -- the snapshot of <commit>, a
# workroom commit, made in <dir>, which must not exist yet and must be outside
# the project, from the release keys the snapshot reads: on the tip of the
# publish branch at release.publish.url, unless <no-parent> is 1, the url is not
# declared or there is no such branch there. Every input the sha depends on is
# read here, so the verb and the publish flow make one commit from one commit.
# rc 0 with SNAPSHOT_DIR (where it was made, as it resolves), SNAPSHOT_COMMIT,
# SNAPSHOT_TREE, SNAPSHOT_PARENT (empty for none), SNAPSHOT_LIST and
# SNAPSHOT_BRANCH set; rc 1 with SNAPSHOT_WHY: a refusal writes nothing, and a
# failure once <dir> is made removes it. Runs in the caller's shell, never in a
# `$(...)`, because it opens the run's scratch and its trap (open_scratch).
snapshot_build() {
  local commit="$1" dir="$2" no_parent="$3"
  local list author name email template url branch up root placed x work vfile ver pname message
  local text spec rec mode rest fmt own rc heads sha ref tip="" got err date made=no
  local parent="" tparent ttree trial
  local -a specs=() blobs=()
  SNAPSHOT_WHY="" SNAPSHOT_DIR="" SNAPSHOT_COMMIT="" SNAPSHOT_TREE="" SNAPSHOT_PARENT=""
  SNAPSHOT_LIST="" SNAPSHOT_BRANCH=""
  if ! git_readonly_prime; then
    SNAPSHOT_WHY="git could not list its local variables, so none could be cleared -- nothing written"
    return 1
  fi

  # THE KEYS, every one the sha depends on but the commit's own tree.
  list="$(cfg_release_get snapshot.list)"
  if [ -z "$list" ]; then
    SNAPSHOT_WHY="release.snapshot.list is not declared, so nothing says what ships -- declare it in $DEVBIN_DIR/config.yaml (docs/configuration.md#release); nothing written"
    return 1
  fi
  author="$(cfg_release_get snapshot.author)"
  if ! cfg_ident "$author" name email; then
    SNAPSHOT_WHY="release.snapshot.author is $author, not Name <email> as git writes an identity -- nothing written"
    return 1
  fi
  template="$(cfg_release_get snapshot.message)"
  url="$(cfg_release_get publish.url)"
  branch="$(snapshot_publish_branch)"
  rc=0
  is_branch_name "$branch" || rc=$?
  if [ "$rc" = 1 ]; then
    SNAPSHOT_WHY="$branch is not a name git takes for a branch, so the snapshot has no branch to be made on -- nothing written"
    return 1
  elif [ "$rc" != 0 ]; then
    SNAPSHOT_WHY="whether $branch is a name git takes for a branch cannot be asked of git (exit $rc), so the snapshot has no branch to be made on -- nothing written"
    return 1
  fi

  # THE DIRECTORY, refused before anything is made.
  if [ -e "$dir" ] || [ -L "$dir" ]; then
    SNAPSHOT_WHY="$dir already exists: a snapshot is made in a new directory, never rebuilt in place -- nothing written"
    return 1
  fi
  up="${dir%/*}"
  [ -n "$up" ] || up=/
  if [ ! -d "$up" ]; then
    SNAPSHOT_WHY="$up does not exist, so $dir cannot be made there -- nothing written"
    return 1
  fi
  # A REPOSITORY INSIDE THE WORKROOM is one `git add -A` away from an embedded
  # repository in it, so the snapshot is made outside the project. Placed as it
  # resolves (cargo_place) and asked by identity up its ancestors, as
  # cargo_tree_outside_why asks, never by comparing text: APFS ignores case, and
  # a leading // or a `..` after a link spells the project's directory another
  # way. What is made from here is the placed path.
  if ! physical_dir "$PROJECT_ROOT" root; then
    SNAPSHOT_WHY="cannot resolve the project root $PROJECT_ROOT -- nothing written"
    return 1
  fi
  if ! cargo_place "$dir" placed; then
    SNAPSHOT_WHY="$dir cannot be placed where it resolves, so whether it is inside the project cannot be known -- nothing written"
    return 1
  fi
  x="$placed"
  while :; do
    if [ "$x" -ef "$root" ]; then
      SNAPSHOT_WHY="$dir is inside the project $root, where a snapshot would be a repository inside the workroom -- make it outside; nothing written"
      return 1
    fi
    _path_parent x || break
  done

  # THE MESSAGE, filled from the commit's own tree: {version} is the version
  # its file project.version_from names declares, read through the one reader,
  # written out under its own name so the reader's recipe for that kind of file
  # applies. The replacements are quoted: bash 5.2's patsub_replacement reads an
  # unquoted `&` as the matched text, so a name `R&D` would give two shas on two
  # bashes (issue 0200 found the same in shell-init).
  open_scratch "release snapshot"
  if ! work="$(mktemp -d "$SCRATCH/snapshot.XXXXXX")"; then
    SNAPSHOT_WHY="cannot make a directory under the run's scratch $SCRATCH -- nothing written"
    return 1
  fi
  vfile="${DEVBIN_VERSION_FILE:-VERSION}"
  ver=""
  if mkdir -- "$work/version" &&
    _snapshot_git -C "$PROJECT_ROOT" cat-file blob "$commit:$vfile" >"$work/version/${vfile##*/}" 2>/dev/null; then
    ver="$(read_version "$work/version/${vfile##*/}" version-file)"
  fi
  if [ -z "$ver" ] || [ "$ver" = unknown ]; then
    SNAPSHOT_WHY="${commit:0:12} declares no version in $vfile (project.version_from), so the message would carry none -- nothing written"
    return 1
  fi
  pname="$(cfg_get project.name)"
  message="${template//\{name\}/"$pname"}"
  message="${message//\{version\}/"$ver"}"

  # THE LIST, read from the commit's own tree, and what it selects.
  if ! text="$(_snapshot_git -C "$PROJECT_ROOT" cat-file blob "$commit:$list" 2>/dev/null)"; then
    SNAPSHOT_WHY="release.snapshot.list is $list, and ${commit:0:12} holds no such file to read -- nothing written"
    return 1
  fi
  mapfile -t specs < <(pathlist_specs "$text")
  if [ "${#specs[@]}" -eq 0 ]; then
    SNAPSHOT_WHY="the list $list at ${commit:0:12} names no path -- nothing written"
    return 1
  fi
  if ! _snapshot_select "$PROJECT_ROOT" "$commit" "$work/index" "$work/sel" "${specs[@]}"; then
    SNAPSHOT_WHY+=" -- nothing written"
    return 1
  fi
  # AN INCLUDE LINE THAT MATCHES NOTHING IS A LIST THAT DRIFTED from the tree,
  # refused rather than shipped as a quietly smaller snapshot. An exclude that
  # matches nothing leaves nothing out, and is let be.
  for spec in "${specs[@]}"; do
    pathspec_excludes "$spec" && continue
    if ! _snapshot_git --index "$work/index" -C "$PROJECT_ROOT" ls-files --error-unmatch -- "$spec" >/dev/null 2>&1; then
      SNAPSHOT_WHY="the list $list holds '$spec', which matches no file at ${commit:0:12} -- nothing written"
      return 1
    fi
  done
  while IFS= read -r -d '' rec; do
    mode="${rec%% *}"
    if [ "$mode" = 160000 ]; then
      SNAPSHOT_WHY="the list selects ${rec#*$'\t'}, a gitlink, and the commit it names is not in the snapshot -- nothing written"
      return 1
    fi
    rest="${rec#* }"
    blobs+=("${rest%% *}")
  done <"$work/sel"
  if [ "${#blobs[@]}" -eq 0 ]; then
    SNAPSHOT_WHY="the list $list selects no file at ${commit:0:12} -- nothing written"
    return 1
  fi
  # The new repositories take the workroom's object format, whatever
  # init.defaultObjectFormat or GIT_DEFAULT_HASH says, so its blobs unpack there.
  if ! fmt="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse --show-object-format)"; then
    SNAPSHOT_WHY="git could not say the project's object format -- nothing written"
    return 1
  fi
  # EXACTLY THE SELECTED BLOBS, packed once from the workroom: unpacked into the
  # new repository, so no other workroom object reaches it, and into the
  # scratch where the publish branch is read, for the commit asked of its tip.
  if ! printf '%s\n' "${blobs[@]}" | LC_ALL=C sort -u >"$work/blobs" ||
    ! _snapshot_git -C "$PROJECT_ROOT" pack-objects -q --stdout <"$work/blobs" >"$work/pack"; then
    SNAPSHOT_WHY="git could not pack the shipped blobs of ${commit:0:12} -- nothing written"
    return 1
  fi
  # THE DATE, the source's committer date, read once for every commit made.
  if ! date="$(_snapshot_git -C "$PROJECT_ROOT" show -s --no-show-signature --format=%ct "$commit")"; then
    SNAPSHOT_WHY="git could not read the date of ${commit:0:12} -- nothing written"
    return 1
  fi

  # THE PARENT: the publish branch's tip, fetched with its history into the
  # scratch and checked there, before the new directory exists, and never from
  # a url naming the repository one of the project's own remotes names, asked
  # with git's local variables cleared, so the remotes are this project's.
  if [ "$no_parent" != 1 ] && [ -n "$url" ]; then
    rc=0
    own="$(
      git_local_env_clear || exit 3
      release_remote_naming "$url"
    )" || rc=$?
    case "$rc" in
      0)
        SNAPSHOT_WHY="release.publish.url names ${own#*$'\t'}, the repository this project's remote ${own%%$'\t'*} names, so its history is this project's own and a snapshot made on it would publish that history -- a first snapshot is made with --no-parent; nothing written"
        return 1
        ;;
      1) ;;
      *)
        SNAPSHOT_WHY="whether release.publish.url names the repository one of this project's remotes names cannot be told: $own -- nothing written"
        return 1
        ;;
    esac
    if ! err="$(_snapshot_git init -q --bare --template= --object-format="$fmt" "$work/parent.git" 2>&1)"; then
      SNAPSHOT_WHY="git could not make a repository in the run's scratch to read the publish branch in: ${err%%$'\n'*} -- nothing written"
      return 1
    fi
    if ! heads="$(_snapshot_remote "$work/parent.git" ls-remote --heads --end-of-options "$url" "refs/heads/$branch")"; then
      SNAPSHOT_WHY="cannot read the publish branch $branch at $(release_url_shown "$url"), so the snapshot's parent is unknown -- make it with --no-parent where there is no public repository yet; nothing written"
      return 1
    fi
    while read -r sha ref; do
      [ "$ref" != "refs/heads/$branch" ] || tip="$sha"
    done <<<"$heads"
    if [ -n "$tip" ]; then
      if ! _snapshot_remote "$work/parent.git" fetch -q --no-tags --no-write-fetch-head --end-of-options "$url" "refs/heads/$branch:refs/snapshot/parent"; then
        SNAPSHOT_WHY="cannot fetch the publish branch's tip ${tip:0:12} from $(release_url_shown "$url") -- nothing written"
        return 1
      fi
      got="$(_snapshot_git -C "$work/parent.git" rev-parse -q --verify refs/snapshot/parent 2>/dev/null)" || got=""
      if [ -z "$got" ]; then
        SNAPSHOT_WHY="git wrote no ref for the publish branch's tip ${tip:0:12} from $(release_url_shown "$url"): it takes nothing from a shallow repository, whose history ends in no parentless root (its words are above) -- nothing written"
        return 1
      fi
      if [ "$got" != "$tip" ]; then
        SNAPSHOT_WHY="the publish branch moved from ${tip:0:12} to ${got:0:12} while it was read -- nothing written"
        return 1
      fi
      if ! _snapshot_history "$work/parent.git" "$tip" "$list" "$author" "$work" "${specs[@]}"; then
        SNAPSHOT_WHY+=" -- refusing to make a snapshot on it; nothing written"
        return 1
      fi
      parent="$tip"
      # A PUBLISHED SNAPSHOT IS FOUND, NEVER MADE TWICE (issue 0240). Where the
      # tip is itself the snapshot of <commit>, the commit made on the tip's own
      # parent is the tip, so the snapshot is the tip, on that parent: a publish
      # that stopped once the branch had moved, or one run again once it
      # finished, reads the same sha as the run that published it, and makes no
      # second commit of one release. Asked by making that commit in the
      # scratch, where the tip's history was read and checked, so the new
      # repository holds no commit but the snapshot's.
      tparent="$(_snapshot_git -C "$work/parent.git" rev-parse -q --verify "$tip^1" 2>/dev/null)" || tparent=""
      if ! _snapshot_git -C "$work/parent.git" unpack-objects -q <"$work/pack" ||
        ! _snapshot_git --index "$work/trial.index" -C "$work/parent.git" update-index -z --index-info <"$work/sel" ||
        ! ttree="$(_snapshot_git --index "$work/trial.index" -C "$work/parent.git" write-tree)" ||
        ! trial="$(_snapshot_commit_tree "$work/parent.git" "$ttree" "$tparent")"; then
        SNAPSHOT_WHY="git could not ask whether the publish branch's tip ${tip:0:12} is already this snapshot -- nothing written"
        return 1
      fi
      [ "$trial" != "$tip" ] || parent="$tparent"
    fi
  fi

  # THE NEW REPOSITORY. From here a failure removes the directory it made.
  if ! mkdir -- "$placed"; then
    SNAPSHOT_WHY="cannot make $dir -- nothing written"
    return 1
  fi
  made=yes
  if ! err="$(_snapshot_git init -q --template= --object-format="$fmt" -b "$branch" "$placed" 2>&1)"; then
    _snapshot_abort "$made" "$placed" "git could not make a repository in $dir: ${err%%$'\n'*}"
    return 1
  fi
  # THE SELECTED BLOBS, packed above, unpacked here, and the checked history,
  # taken from the scratch, where it was read.
  if ! _snapshot_git -C "$placed" unpack-objects -q <"$work/pack"; then
    _snapshot_abort "$made" "$placed" "git could not copy the shipped blobs into $dir"
    return 1
  fi
  if [ -n "$tip" ] &&
    ! _snapshot_git -C "$placed" fetch -q --no-tags --no-write-fetch-head "$work/parent.git" "refs/snapshot/parent:refs/snapshot/parent"; then
    _snapshot_abort "$made" "$placed" "git could not take the checked publish branch into $dir"
    return 1
  fi
  if ! _snapshot_git -C "$placed" update-index -z --index-info <"$work/sel" ||
    ! SNAPSHOT_TREE="$(_snapshot_git -C "$placed" write-tree)"; then
    _snapshot_abort "$made" "$placed" "git could not write the snapshot's tree in $dir"
    return 1
  fi

  # THE COMMIT, made as _snapshot_commit_tree makes every snapshot's commit.
  if ! SNAPSHOT_COMMIT="$(_snapshot_commit_tree "$placed" "$SNAPSHOT_TREE" "$parent")"; then
    _snapshot_abort "$made" "$placed" "git could not make the snapshot's commit in $dir"
    return 1
  fi
  if ! _snapshot_git -C "$placed" update-ref "refs/heads/$branch" "$SNAPSHOT_COMMIT" ||
    { [ -n "$tip" ] && ! _snapshot_git -C "$placed" update-ref -d refs/snapshot/parent; } ||
    ! _snapshot_git -C "$placed" reset -q --hard; then
    _snapshot_abort "$made" "$placed" "git could not check the snapshot out in $dir"
    return 1
  fi

  # READ BACK: the commit's tree is the selection, in paths, modes and blobs,
  # its tree and parent are the ones made, and its author and committer are
  # release.snapshot.author as declared, which the next release's history check
  # reads it against.
  if ! _snapshot_git -C "$placed" ls-tree -r -z --full-tree "$SNAPSHOT_COMMIT" >"$work/back" ||
    ! _snapshot_norm "$work/sel" ls-files >"$work/want" ||
    ! _snapshot_norm "$work/back" ls-tree >"$work/got" ||
    [ ! -s "$work/want" ]; then
    _snapshot_abort "$made" "$placed" "git could not read the snapshot in $dir back"
    return 1
  fi
  if ! cmp -s "$work/want" "$work/got" ||
    [ "$(_snapshot_git -C "$placed" show -s --no-show-signature --format='%T %P%n%an <%ae>%n%cn <%ce>' "$SNAPSHOT_COMMIT")" != "$SNAPSHOT_TREE $parent"$'\n'"$author"$'\n'"$author" ]; then
    _snapshot_abort "$made" "$placed" "the snapshot in $dir does not read back as the selection, the parent and the identity it was made from"
    return 1
  fi
  SNAPSHOT_DIR="$placed" SNAPSHOT_PARENT="$parent" SNAPSHOT_LIST="$list" SNAPSHOT_BRANCH="$branch"
  return 0
}

# snapshot_verb -- `release snapshot`: the snapshot of the tag's commit, or of
# --commit's, made in the new directory by snapshot_build, and its shas
# printed. Refused, writing nothing, when the source is no commit.
snapshot_verb() {
  local commit from
  git_readonly_prime || die "release snapshot: git could not list its local variables, so none could be cleared -- nothing written"
  if [ -n "$snap_commit" ]; then
    commit="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse -q --verify "$snap_commit^{commit}" 2>/dev/null)" ||
      die "release snapshot: $snap_commit is not a commit here -- nothing written"
    from="$snap_commit"
  else
    from="$(release_tag_name "$(cfg_release_get tag)" "$version")"
    commit="$(_snapshot_git -C "$PROJECT_ROOT" rev-parse -q --verify "refs/tags/$from^{commit}" 2>/dev/null)" ||
      die "release snapshot: there is no tag $from here -- cut the release first, or name a commit with --commit; nothing written"
  fi
  # A relative directory is read from the project root, where the command runs.
  case "$snap_dir" in /*) ;; *) snap_dir="$PROJECT_ROOT/$snap_dir" ;; esac
  [ "$snap_dir" = / ] || snap_dir="${snap_dir%/}"
  snapshot_build "$commit" "$snap_dir" "$no_parent" || die "release snapshot: $SNAPSHOT_WHY"
  printf 'release snapshot: %s\n' "$SNAPSHOT_DIR"
  printf '  from    %s (%s)\n' "$commit" "$from"
  printf '  list    %s\n' "$SNAPSHOT_LIST"
  printf '  tree    %s\n' "$SNAPSHOT_TREE"
  printf '  commit  %s\n' "$SNAPSHOT_COMMIT"
  printf '  parent  %s\n' "${SNAPSHOT_PARENT:-none}"
  printf '  branch  %s\n' "$SNAPSHOT_BRANCH"
}

# --- the public repository's reads (issue 0240, the publish shape) ----------
#
# A PROJECT THAT DECLARES release.publish.url PUBLISHES A SNAPSHOT, NEVER ITS
# WORKROOM, and its cut does it (ST0011): the legs step makes S, the release
# commit's snapshot (snapshot_build), and pushes it to the candidate ref at
# the url for CI; once every leg is green the push step fast-forwards the
# publish branch there to S and tags S, lightweight (cut_push_public); the
# object and after steps read the public repository, about S. NOTHING IS
# FORCED: a push the public repository refuses stops the cut, naming what it
# already pushed, and a tag is never moved.
#
# EVERY CALL TO THE PUBLIC REPOSITORY is made from a repository of the run's
# own (_snapshot_remote), so the url is read as the person's git reads it,
# never through this workroom's remotes or their rewrites, and every push is
# bounded, as a cut's are (cut_call).

# publish_url_named <url> -- why <url>, release.publish.url, is never read:
# one of this project's remotes names the repository it names, pushed to or
# not, by OWNER/NAME on any host (release_remote_naming), asked with git's
# local variables cleared, as the snapshot asks; or whether one does cannot be
# told. Until the public repository is made, its url can resolve to the private
# workroom's copy, and a push or a fetch through such a remote carries the
# workroom's whole history there. Exit 1, printing nothing, when no remote
# names it. THE ONE TEST, which a cut's pre-flight and release status ask
# before either reads the url.
publish_url_named() {
  local own nrc=0
  own="$(
    git_local_env_clear || exit 3
    release_remote_naming "$1"
  )" || nrc=$?
  case "$nrc" in
    0) printf "this project's remote %s names %s, the repository release.publish.url names, so a push or a fetch through it would carry this workroom's whole history there -- remove that remote, or point it at another repository, then cut the release\n" "${own%%$'\t'*}" "${own#*$'\t'}" ;;
    1) return 1 ;;
    *) printf "whether one of this project's remotes names the repository release.publish.url names cannot be told: %s\n" "$own" ;;
  esac
}

# publish_first_read <url> <branch> <candidate> <tag> -- the public refs read
# once (publish_read), bounded, from a repository made for it in the run's
# scratch: publish_read's line, or `UNANSWERED<TAB><why>` when that repository
# cannot be made or the read fails. Asked of a url no remote names
# (publish_url_named). THE ONE FIRST READ, which a cut's pre-flight and release
# status make.
publish_first_read() {
  local out answer
  if ! out="$(_snapshot_git init -q --bare --template= "$SCRATCH/public.git" 2>&1)"; then
    printf "UNANSWERED\tgit could not make a repository in the run's scratch to read %s from: %s\n" "$(release_url_shown "$1")" "$(one_line "$out")"
    return 0
  fi
  answer="$(release_wait 0 "" UNANSWERED publish_read "$SCRATCH/public.git" "$1" "$2" "$3" "$4")" ||
    answer="UNANSWERED"$'\t'"reading $(release_url_shown "$1") failed (exit $?)"
  printf '%s\n' "$answer"
}

# publish_read <repo> <url> <branch> <candidate> <tag> -- the public refs a
# publish reads, in one ls-remote made from <repo>, as one line:
# `read<TAB><branch><TAB><candidate><TAB><tag><TAB><kind><TAB><held>`, each the
# sha that ref is at, the tag's the commit it names, or `-` where there is
# none; <kind> lightweight or annotated, and <held> yes when the branch holds
# the tag's commit, at its tip or in its history, or no, each `-` with no tag;
# or `UNANSWERED<TAB><why>` when the url did not answer. A tag at another
# commit than the branch's tip is asked about in the branch's history, fetched
# into <repo> (commit_direction, the one ancestry reader), so a release
# published before a later one reads as held. A reader, for release_wait. The
# tag is read by release_listed_tag, the one reader of a public tag, its peel
# asked for by name, as that reader needs.
publish_read() {
  local repo="$1" url="$2" listing heads tagged at_b at_t held=- out way
  if ! listing="$(_snapshot_remote "$repo" ls-remote --end-of-options "$url" \
    "refs/heads/$3" "refs/heads/$4" "refs/tags/$5" "refs/tags/$5^{}" 2>&1)"; then
    printf 'UNANSWERED\t%s did not answer ls-remote: %s\n' "$(release_url_shown "$url")" "$(one_line "$listing")"
    return 0
  fi
  heads="$(awk -v b="refs/heads/$3" -v c="refs/heads/$4" '
    $2 == b { rb = $1 }
    $2 == c { rc = $1 }
    END { printf "%s\t%s\n", (rb == "" ? "-" : rb), (rc == "" ? "-" : rc) }
  ' <<<"$listing")"
  tagged="$(release_listed_tag "$listing" "$5")"
  at_b="${heads%%$'\t'*}" at_t="${tagged%%$'\t'*}"
  dash_to_empty at_b
  if [ -n "$tagged" ]; then
    if [ -z "$at_b" ]; then
      held=no
    elif [ "$at_b" = "$at_t" ]; then
      held=yes
    elif ! out="$(_snapshot_remote "$repo" fetch -q --no-tags --no-write-fetch-head --end-of-options "$url" "+refs/heads/$3:refs/public/branch" 2>&1)"; then
      printf "UNANSWERED\t%s did not answer the fetch of %s, to read whether it holds %s: %s\n" "$(release_url_shown "$url")" "$3" "$5" "$(one_line "$out")"
      return 0
    elif ! way="$(git_local_env_clear && commit_direction "$repo" "$at_t" "$at_b")"; then
      printf "UNANSWERED\tgit's local variables could not be cleared to read whether %s's %s holds %s\n" "$(release_url_shown "$url")" "$3" "$5"
      return 0
    elif [ "$way" = forward ]; then
      held=yes
    else
      held=no
    fi
  fi
  printf 'read\t%s\t%s\t%s\n' "$heads" "${tagged:-$'-\t-'}" "$held"
}

# publish_refs <line> -- publish_read's `read` line into the caller's
# pub_branch, pub_cand and pub_tag, the commit the tag names, each empty for none,
# pub_tag_kind: lightweight, annotated, or empty for no tag, and pub_held: yes
# or no, whether the branch holds the tag, or empty for no tag.
publish_refs() {
  local _read
  IFS=$'\t' read -r _read pub_branch pub_cand pub_tag pub_tag_kind pub_held <<<"$1"
  dash_to_empty pub_branch pub_cand pub_tag pub_tag_kind pub_held
}

# publish_reread <step> <when> -- the public refs read again, <when> it is (eg
# "after the push"), into the caller's pub_ names (publish_refs), from the
# caller's url, pbranch, cand and tag. A read that does not answer is asked
# again up to RELEASE_READBACK_SECONDS, as a cut's push step reads a remote
# back (issue 0194); one that never answers fails <step> as a read that could
# not tell, never as a ref that is not there.
publish_reread() {
  local answer
  answer="$(release_wait "$RELEASE_READBACK_SECONDS" UNANSWERED UNANSWERED \
    publish_read "$SCRATCH/public.git" "$url" "$pbranch" "$cand" "$tag")"
  case "${answer%%$'\t'*}" in
    read) publish_refs "$answer" ;;
    *) cut_fail "$1" "could not read $(release_url_shown "$url") $2, in the ${RELEASE_READBACK_SECONDS}s a read-back waits: ${answer#*$'\t'}" ;;
  esac
}

# publish_at <sha> -- `at <sha12>`, or `not there` for none.
publish_at() {
  if [ -z "$1" ]; then printf 'not there'; else printf 'at %s' "${1:0:12}"; fi
}

# status_report <version> -- `release status`: every step of a cut, read from the
# repository, its remotes and the release object, printed as the table a cut's
# summary prints (release_row), writing nothing. Exit 0 when every row was
# read, 1 when any row is UNREADABLE -- a map with a hole in it is not a
# complete answer, and a script reading the status must not take it for one.
#
# THE RELEASE COMMIT'S TREE IS ALWAYS MATERIALISED, before the tag as well as
# after it, so the commit step reads a commit and never the working tree: "HEAD's tree
# carries the stamp" is a question about HEAD, and a working tree carrying it
# uncommitted must read pending. The stamp step reads the working tree while the tag is
# absent and the release commit once it exists, since nothing after the tag step
# writes the tree.
# status_object_content <tag> <version> <materialised> <tree> <why> -- the object row's
# answer for an object that exists under `object: local`: its title and notes
# against this release's, the notes read from the release commit's own tree.
# Anything that cannot be read is UNREADABLE, never `already`.
status_object_content() {
  local tag="$1" v="$2" repo body_file="$SCRATCH/notes-body"
  if [ "$3" != yes ]; then
    printf 'UNREADABLE\ta release object exists for %s, and its notes cannot be compared: %s\n' "$tag" "$(one_line "$5")"
    return 0
  fi
  if ! notes_body "$4" "$v" >"$body_file" 2>"$body_file.err"; then
    printf 'UNREADABLE\ta release object exists for %s, and the notes body could not be read: %s\n' "$tag" "$(one_line "$(cat "$body_file.err")")"
    return 0
  fi
  if ! repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
    printf 'UNREADABLE\t%s\n' "$(one_line "${repo#release: }")"
    return 0
  fi
  release_read_object_content "$repo" "$tag" "$(object_title "$tag" "$v")" "$body_file"
}

# status_assets <tag> <detail> -- the object row's answer, under object: local with
# release.assets.workflow declared, for an object that carries this release's
# title and notes (<detail>): `already` only when its SHA256SUMS agrees with it
# too, read through the reader a cut's confirm step reads (release_read_assets), and
# as bounded, so status and a cut cannot disagree about whether the object step has work
# left. An answer that is neither is UNREADABLE, never passed on as a state.
status_assets() {
  local tag="$1" detail="$2" repo answer
  if ! repo="$(release_repo "$(cfg_release_get repo)" "$(declared_remote)" 2>&1)"; then
    printf 'UNREADABLE\t%s\n' "$(one_line "${repo#*release: }")"
    return 0
  fi
  answer="$(release_wait 0 "" UNREADABLE release_read_assets "$repo" "$tag")"
  case "${answer%%$'\t'*}" in
    already) printf 'already\t%s; %s\n' "$detail" "${answer#*$'\t'}" ;;
    pending | UNREADABLE) printf '%s\n' "$answer" ;;
    *) printf 'UNREADABLE\tthe assets reader answered "%s"\n' "$(one_line "$answer")" ;;
  esac
}

status_report() {
  local v="$1" tag rc_line commit source tree state detail unreadable=0
  local clean tag_row push_state push_detail object gates after
  # One repository, the project root's, for every git read below, as a cut
  # reads it (ST0011).
  release_one_repository "release status"
  tag="$(release_tag_name "$(cfg_release_get tag)" "$v")"
  rc_line="$(release_commit "$tag")" || exit 1
  commit="${rc_line%%$'\t'*}"
  source="${rc_line#*$'\t'}"

  open_scratch "release status"
  tree="$SCRATCH/commit"
  local materialised=yes why=""
  if ! why="$(materialise commit "$commit" "$v" 2>&1)"; then
    materialised=no
  fi

  row() {
    [ "$1" != UNREADABLE ] || unreadable=1
    release_row "$2" "$1" "$3"
  }
  split() {
    state="${1%%$'\t'*}"
    detail="${1#*$'\t'}"
  }

  # The tag, push and object steps are read first: the confirm step's state is
  # a predicate over them, and its row comes second, as the step does in a cut
  # (ST0011). With no materialised tree the message has nothing honest to be
  # compared with: the working tree's note is another commit's.
  tag_row="$(release_read_tag "$tag" "$([ "$materialised" = yes ] && printf '%s' "$tree")" "$v")"

  local remotes remote r_state r_detail branch
  branch="$(cfg_release_get branch)"
  if cfg_release_declared remotes; then
    remotes="$(cfg_release_list remotes)"
  else
    remotes="$(git remote)" || die "release status: cannot list this repository's remotes"
  fi
  push_state=already push_detail=""
  if [ -z "$remotes" ]; then
    push_state=UNREADABLE push_detail="this repository has no remote to push to"
  fi
  while IFS= read -r remote; do
    [ -n "$remote" ] || continue
    local answer
    # AN ENTRY THAT NAMES NO REMOTE IS NOT READ, as pre-flight refuses it (issue
    # 0189): it can be a url, whose userinfo would reach this row in devbin's
    # words and in git's.
    if git remote get-url "$remote" >/dev/null 2>&1; then
      answer="$(release_read_remote "$remote" "$branch" "$tag" "$commit")"
    else
      answer="UNREADABLE"$'\t'"remote $(release_url_shown "$remote") is declared and does not exist"
    fi
    r_state="${answer%%$'\t'*}"
    r_detail="${answer#*$'\t'}"
    push_detail+="; $r_detail"
    case "$r_state" in
      UNREADABLE) push_state=UNREADABLE ;;
      pending) [ "$push_state" = UNREADABLE ] || push_state=pending ;;
    esac
  done <<<"$remotes"
  push_detail="${push_detail#; }"

  # THE PUBLIC REPOSITORY, ONE MORE TARGET OF THE PUSH (publish shape): never
  # read where one of this project's remotes names it (publish_url_named), and
  # otherwise its refs read once, by the read a cut's pre-flight makes
  # (publish_first_read), so the push row is pending while the snapshot is not
  # public (cut_public_left), and UNREADABLE when the url is not read or does
  # not answer. Status makes no snapshot, so a public tag the publish branch
  # holds reads as the release's, as the cut's question reads it.
  local publish_url public_left=no
  publish_url="$(cfg_release_get publish.url)" || die "release status: cannot read release.publish.url"
  if [ -n "$publish_url" ]; then
    local shown_pub pbranch cand_s named pub_branch="" pub_cand="" pub_tag="" pub_tag_kind="" pub_held="" answer
    shown_pub="$(release_url_shown "$publish_url")"
    pbranch="$(snapshot_publish_branch)" || die "release status: cannot read the publish branch (release.publish.branch, else release.branch)"
    cand_s="$(cut_candidate_ref "$tag")" || die "release status: $cand_s"
    if named="$(publish_url_named "$publish_url")"; then
      answer="UNANSWERED"$'\t'"$shown_pub is not read: $named"
    else
      answer="$(publish_first_read "$publish_url" "$pbranch" "$cand_s" "$tag")"
    fi
    if [ "${answer%%$'\t'*}" != read ]; then
      push_state=UNREADABLE
      push_detail+="; ${answer#*$'\t'}"
    else
      publish_refs "$answer"
      if cut_public_left "$pub_tag" "$pub_held"; then
        public_left=yes
        [ "$push_state" = UNREADABLE ] || push_state=pending
        push_detail+="; $shown_pub takes the release's snapshot, and has it not yet: $pbranch $(publish_at "$pub_branch"), $tag $(publish_at "$pub_tag")"
      elif [ "$pub_tag" = "$pub_branch" ]; then
        push_detail+="; $shown_pub has $pbranch and $tag at ${pub_tag:0:12}, the release's snapshot as status reads it"
      else
        push_detail+="; $shown_pub has $tag at ${pub_tag:0:12}, in the history of $pbranch, at ${pub_branch:0:12}: public already"
      fi
    fi
  fi

  local object_row object_state
  object="$(cfg_release_get object)"
  if [ "$object" = none ]; then
    object_row=$'skipped\tobject: none'
  else
    object_row="$(release_read_object "$object" "$tag" "$(cfg_release_get repo)" "$(declared_remote)")"
  fi
  # UNDER object: local AN OBJECT THAT EXISTS IS READ WHOLE, as a cut's confirm step
  # reads it and through the same reader: `already` only when it
  # carries this release's title and notes, so status and a cut cannot disagree
  # about whether the object step has work left.
  if [ "$object" = local ] && [ "${object_row%%$'\t'*}" = already ]; then
    object_row="$(status_object_content "$tag" "$v" "$materialised" "$tree" "$why")"
    # And with assets declared, its SHA256SUMS against it (ST0008 WP-08). The
    # key is read with its status: empty would skip the read in silence.
    local assets_wf
    assets_wf="$(cfg_release_get assets.workflow)" || die "release status: cannot read release.assets.workflow"
    if [ "${object_row%%$'\t'*}" = already ] && [ -n "$assets_wf" ]; then
      object_row="$(status_assets "$tag" "${object_row#*$'\t'}")"
    fi
  fi
  object_state="${object_row%%$'\t'*}"

  printf 'release: status of %s, release commit %s (%s)\n' "$tag" "${commit:0:12}" \
    "$([ "$source" = tag ] && printf "the tag's commit" || printf 'HEAD, no tag yet')"

  row pending resolve "no postcondition: tag $tag, release commit ${commit:0:12}"
  row pending pre-flight "no postcondition: every run pre-flights"

  # The confirm step: not re-run only when no irreversible step has work left.
  # The object holds it only when it is the cut's to make: object: local, in
  # either shape.
  local cut_object=no
  if [ "$object" = local ]; then cut_object=yes; fi
  if [ "$push_state" = UNREADABLE ] || { [ "$cut_object" = yes ] && [ "$object_state" = UNREADABLE ]; }; then
    row UNREADABLE confirm "whether an irreversible step has work left cannot be read (push or object, below)"
  elif [ "$push_state" = already ] && { [ "$cut_object" = no ] || [ "$object_state" = already ]; }; then
    row "not re-run" confirm "no irreversible step has work left"
  else
    row pending confirm "never already: an irreversible step has work left"
  fi

  # The stamp step.
  if [ "$source" = tag ]; then
    if [ "$materialised" = yes ]; then
      split "$(release_read_stamp "$tree" "$v" name)"
    else
      state=UNREADABLE detail="${why//$'\n'/ }"
    fi
  else
    split "$(release_read_stamp "$PROJECT_ROOT" "$v" count)"
  fi
  row "$state" stamp "$detail"

  # The commit step: the stamp read against the release commit, and while the tag is
  # absent, the tree clean.
  if [ "$materialised" = yes ]; then
    split "$(release_read_stamp "$tree" "$v" "$([ "$source" = tag ] && printf name || printf count)")"
    if [ "$state" = already ]; then
      detail="${commit:0:12} carries the stamp"
      if [ "$source" = HEAD ]; then
        clean="$(release_read_clean)"
        state="${clean%%$'\t'*}"
        [ "$state" = already ] || detail="${clean#*$'\t'}"
      fi
    elif [ "$state" = pending ]; then
      detail="${commit:0:12} does not carry the stamp: $detail"
    fi
  else
    state=UNREADABLE detail="${why//$'\n'/ }"
  fi
  row "$state" commit "$detail"

  # The local gates: release_gates_state's answer for the release commit, through
  # release_gates_word, the one mapping a cut's dry run words them by (ST0011):
  # already when a sealed green stands for it
  # on this platform, pending when none does, UNREADABLE when its record could
  # not be read. Pending, too, while the commit step has its commit still to
  # make, since the gates stand only on that commit, and UNREADABLE while the
  # commit row is, since whether that commit exists cannot be said.
  # THE LEGS ROW (ST0011): the local gates' record, as above; the candidate's
  # run, the remote legs and the macOS stage are read by a cut alone, which
  # status names and does not read.
  local commit_state="$state" cand_note="" legs_note="" legs_named
  gates="$(cfg_release_list gates)" || die "release status: cannot read release.gates"
  ! cut_candidate_declared ||
    cand_note="; the candidate's run is read by a cut, not by status"
  # The remote legs and the macOS stage, a cut's to read before its tag alone,
  # in a note of their own: past the tag a cut reads at most its candidate
  # (legs_step).
  legs_named="$(cfg_release_list legs)" || die "release status: cannot read release.legs"
  [ -z "$legs_named" ] ||
    legs_note+="; the remote legs (${legs_named//$'\n'/, }) are read by a cut, not by status"
  ! cfg_macos_declared || legs_note+="; the macOS stage is read by a cut, not by status"
  if [ -z "$gates" ] && [ -z "$cand_note$legs_note" ]; then
    row skipped legs "$(legs_skipped_words)"
  elif [ "$source" = tag ] && [ "$public_left" = yes ] && [ -n "$cand_note" ]; then
    # Past the tag a publishing cut reads its candidate again while the
    # snapshot is not public, since one made again on a moved branch is a new
    # commit (legs_step).
    row pending legs "the tag exists and the snapshot is not public, so a cut reads its candidate again${cand_note}"
  elif [ "$source" = tag ]; then
    row "not re-run" legs "the tag exists, so the legs are not re-run -- this says nothing about a verdict"
  elif [ "$commit_state" = UNREADABLE ]; then
    row UNREADABLE legs "whether the release commit exists cannot be read (the commit row), so whether a sealed green stands for it cannot be said"
  elif [ "$commit_state" != already ]; then
    row pending legs "the legs run on the release commit the commit step makes"
  elif [ -z "$gates" ]; then
    row pending legs "no gates: declared${cand_note}${legs_note}"
  else
    split "$(release_gates_state "$commit")"
    case "$state" in
      pending) row pending legs "the local gates: $detail -- a cut runs them${cand_note}${legs_note}" ;;
      already)
        # Green locally; with a candidate status cannot read, still work for a cut.
        if [ -n "$cand_note$legs_note" ]; then
          row pending legs "the local gates: $detail${cand_note}${legs_note}"
        else
          row already legs "the local gates: $detail"
        fi
        ;;
      *) row "$state" legs "the local gates: $detail${cand_note}${legs_note}" ;;
    esac
  fi

  split "$tag_row"
  row "$state" tag "$detail"
  row "$push_state" push "$push_detail"
  split "$object_row"
  row "$state" object "$detail"

  # Checked as the gates read is: a list that could not be read is no list,
  # and would print `skipped` for a project that declares after: commands.
  after="$(cfg_release_list after)" || die "release status: cannot read release.after"
  if [ -z "$after" ]; then
    row skipped after "no after: declared"
  else
    row pending after "no postcondition: after: runs on every run that reaches it"
  fi

  return "$unreadable"
}

case "$verb" in
  check)
    check_declaration
    select_notes
    # Both halves report before the exit says whether either found anything.
    check_rc=0
    check_notes || check_rc=1
    check_trigger || check_rc=1
    [ "$check_rc" -eq 0 ] || exit 1
    ;;
  notes)
    # Validated first, as `check` is: a malformed release: block must never be
    # read as its defaults and regenerate views from the wrong provider.
    cfg_validate || die "release notes: $DEVBIN_DIR/config.yaml does not validate (above)"
    select_notes
    write_notes
    ;;
  status)
    # Validated first, as `check` and `notes` are: a malformed release: block
    # read as its defaults would report a different project's release.
    cfg_validate || die "release status: $DEVBIN_DIR/config.yaml does not validate (above)"
    select_notes
    status_report "$version" || exit 1
    ;;
  attach)
    # Validated first, as every verb is: the assets keys are refused outside
    # object: local, and a malformed block would name another run.
    cfg_validate || die "release attach: $DEVBIN_DIR/config.yaml does not validate (above)"
    attach_verb "$version" "$from" || exit 1
    ;;
  snapshot)
    # Validated first, as every verb is: a key the snapshot reads beside one it
    # needs is refused, and a malformed block would name another list.
    cfg_validate || die "release snapshot: $DEVBIN_DIR/config.yaml does not validate (above)"
    snapshot_verb
    ;;
  cut)
    # THE REAL CUT RUNS BEHIND A GATE, THE DRY RUN DOES NOT (WP-05). The confirm step asks
    # through ask_person, which answers only inside a gate: the gate says
    # whether ITS stdin was a person's terminal (DEVBIN_GATE_TTY, 0088), and
    # hands everything inside it </dev/null. The generic grammar passes the
    # cut's own exit through, so 1 -- a step failed, the confirm step with nobody to ask
    # among them since issue 0130 -- reaches the caller as it is. No step exits
    # 2 or 3 (the header says so for 3, and this comment said otherwise until
    # issue 0118). A dry run makes no release, so it seals nothing of its own,
    # as fullcycle's dry run seals nothing: its verdict line is a prediction,
    # printed and not sealed (0181), and it runs no gate (ST0011), so it seals
    # no GATES pair either.
    #
    # ONE ERREXIT STATE FOR BOTH (issue 0304): run_gate runs the cut's cut_run
    # on its pipeline's left side, a subshell, with errexit off, and a dry run
    # runs it the same way. So a failing command stops both at its own check,
    # FAILED at its step, and a dry run predicts the cut that publishes: with
    # errexit on, an unchecked failure ended a dry run with no row, where the
    # cut went on past it.
    if [ "$dry_run" = 1 ]; then
      (
        set +e
        cut_run
      )
    else
      run_gate --label release --suffix RELEASE --grammar generic \
        --out-dir "$(gate_out_dir release)" \
        --source "devbin's own release sequence -- cut_run in this process, not a command line" \
        -- cut_run
    fi
    ;;
  gates)
    # Validated first, as every verb is: a malformed block would name another
    # list of gates.
    cfg_validate || die "release gates: $DEVBIN_DIR/config.yaml does not validate (above)"
    gates_verb || exit 1
    ;;
esac
