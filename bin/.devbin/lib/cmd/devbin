#!/usr/bin/env bash
#
# The built-in `devbin` -- help about the FRAMEWORK, not about this project.
#
# `<name> help` answers "what can this project do". This answers "what is the
# thing under bin/ and how do I work on it": the seam, the templates `new`
# scaffolds from, the annotated reference config, and where upgrades come
# from. install/upgrade/doctor/new are its siblings in the Devbin group; this
# row is the one that explains them.
#
# Printing IS the job, so the bare form exits 0 -- same contract as doctor and
# help, not the bare-gate rule (nothing here can false-green a pipeline).
#
set -euo pipefail

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
# shellcheck source=lib/install
. "$DEVBIN_LIB/install"

cd "${PROJECT_ROOT:?}" || die "cannot enter $PROJECT_ROOT"

usage() {
  printf 'usage: %s devbin [templates|--version]\n' "${DEVBIN_INVOKE:-bin/devbin}"
}

# The vendored runtime's own version: stamped into the manifest at install.
#
# THE ABSENCE OF A MANIFEST AND AN INCOMPLETE MANIFEST ARE DIFFERENT FACTS AND
# THIS USED TO CONFLATE THEM. No manifest at all means the dogfood checkout,
# which runs lib/ in place and where the project's own version file IS devbin's --
# the fallback is correct there and nowhere else. A manifest that EXISTS but
# carries no `# devbin_version:` is a broken install, and falling back there
# printed the CONSUMER's version wearing devbin's label: a consumer project would
# have answered `devbin 0.6.2` off its own mix.exs, which is not a near-miss but
# a confident false statement about a different piece of software.
#
# So the fallback is now reachable only from the no-manifest case, and the
# broken-manifest case refuses. No Silent Errors: devbin does not guess its own
# version out of a file that belongs to someone else.
#
# Read through manifest_version, manifest_field's reading of the header, the one
# reader of a manifest's fields (issue 0283): this function's own awk read past
# the header and kept the spacing manifest_field trims, so the two could read
# one manifest two ways. The root is the one DEVBIN_DIR names.
runtime_version() {
  local root="" mf="" v=""
  if [ -n "${DEVBIN_DIR:-}" ]; then
    root="$(dirname "$(dirname "$DEVBIN_DIR")")"
    mf="$(manifest_path "$root")"
  fi
  if [ -n "$mf" ] && [ -f "$mf" ]; then
    v="$(manifest_version "$root")" || v=""
    [ -n "$v" ] ||
      die "manifest at $mf names no devbin_version -- this project's version file is NOT devbin's; re-run upgrade"
    printf '%s' "$v"
    return 0
  fi
  # No manifest: the dogfood checkout. The bare call selects the
  # version-file role on purpose.
  # shellcheck disable=SC2119
  read_version
}

# `<name> devbin --version` answers for the FRAMEWORK. Reported from a consumer
# project, where it printed a usage line and exited 1 -- the datum was already
# here and the dispatcher simply had no arm for it. Asking a tool its version is
# not a usage error, and the answer is devbin's rather than the project's, which
# `<name> --version` already covers.
# runtime_identity -- WHICH devbin bytes these are, as a line.
#
# Mirrors runtime_version's two cases for the same reason. In a consumer the
# answer is the manifest's recorded `source_commit`, which is the commit the
# vendored bytes were taken FROM -- not this repository's HEAD, which belongs to
# the consumer and would name a completely unrelated piece of software.
#
# THE RECORDED LINE IS PRINTED WHOLE. `source_commit_of` writes
# `<sha> +dirty -- THESE BYTES MATCH NO COMMIT` when devbin's own half was
# uncommitted at install, and words rather than a sha when the source was not a
# checkout at all. Issue 0043 was a reader that kept the sha and threw the
# sentence away, so provenance that said "no commit matches this" rendered as an
# ordinary clean row. manifest_field already returns the line intact; this must
# not helpfully trim it.
#
# WHERE IT DIVERGES FROM runtime_version, DELIBERATELY: a manifest that exists
# but records no version DIES there, because there is no honest placeholder for
# a version number -- it is either right or it is a false claim about different
# software. Provenance HAS an honest placeholder. `unrecorded` is a true
# statement, and it beats both dying on `--version` and substituting the
# consumer's own HEAD, which would be 0043's defect wearing a different hat.
runtime_identity() {
  local rec=""
  if [ -n "${DEVBIN_DIR:-}" ] && [ -f "${DEVBIN_DIR}/manifest.sha256" ]; then
    rec="$(manifest_source_commit "${PROJECT_ROOT:-.}" 2>/dev/null || true)"
    [ -n "$rec" ] || rec="provenance unrecorded -- re-run upgrade"
    printf '%s' "$rec"
    return 0
  fi
  # No manifest: the dogfood checkout, where devbin's own tree IS the
  # source and its HEAD is the honest answer.
  git_head_identity "${PROJECT_ROOT:-.}"
}

show_version() {
  local ver ident
  ver="$(runtime_version)" || exit 1
  ident="$(runtime_identity)"
  printf 'devbin %s (%s)\n' "$ver" "$ident"
}

show_templates() {
  # The backticks are prose -- markdown quoting -- and %s expands via its argument.
  # shellcheck disable=SC2016
  printf 'Templates -- what `%s new <cmd>` scaffolds from, at %s/tmpl/:\n\n' \
    "${DEVBIN_INVOKE:-bin/devbin}" "$(lib_rel)"
  printf '  handler      the command script: header block, usage, and an exit-3 placeholder\n'
  printf '               (resolving-but-unbuilt must never read as success)\n'
  printf '  help.md      the authored help topic, keyed on the command name\n'
  printf '  test.bats    a first test asserting the command resolves\n'
  printf '\nScaffolded copies are YOURS -- cmd/<name>, help/<name>.md, tests/<name>.bats --\n'
  # Prose backticks again, as above.
  # shellcheck disable=SC2016
  printf 'and `%s upgrade` never touches them.\n' "${DEVBIN_INVOKE:-bin/devbin}"
}

# show_guides -- where devbin's long-form guides are, for the tree this runs
# in, as devbin_docs_place answers (issue 0254): in a keg, its docs/, beside
# the README Homebrew installs; in the checkout, its own docs/; in a project,
# those of the install its upgrades read. The line said "in docs/ of the devbin
# source checkout; an install carries none", which named nothing a brew user
# has. Where there is no place, the line says why.
show_guides() {
  local docs
  printf 'The long-form guides (authoring-commands, configuration, migration, releasing)\n'
  if docs="$(devbin_docs_place "$PROJECT_ROOT")"; then
    printf 'are in %s/\n' "$docs"
  else
    printf 'are not here: %s.\n' "$docs"
  fi
}

# show_install_overview -- the overview from a machine install (issue 0251),
# which has no project to describe: what the tree is, how a project is seeded
# from it and upgraded from it, and where the reference config and the guides
# are. The remedies are the install refusal's own block (install_remedies), so
# the two cannot differ, and the runtime's path is lib_rel's, never spelled.
show_install_overview() {
  local ver named
  ver="$(runtime_version)" || exit 1
  named="$(install_named_root "$PROJECT_ROOT")"
  printf 'devbin %s -- a machine install, not a project\n\n' "$ver"
  printf 'Projects vendor devbin from this install, at:\n  %s\n' "$named"
  printf "It runs no project's commands itself: a project runs them, as bin/devbin <command>.\n\n"
  install_remedies "$PROJECT_ROOT"
  printf '\nReference config, every key annotated: %s/%s/config.reference.yaml\n' "$named" "$(lib_rel)"
  show_guides
}

show_overview() {
  local src ver vendored=""
  # AN INSTALL IS NO PROJECT, and the overview below describes one: its config,
  # its seam, where its upgrades come from (issue 0251). Whether it is one is
  # is_install_tree's answer, as it is for the dispatcher's guard (issue 0262),
  # a manifest that is not there reading as no install.
  if is_install_tree "$PROJECT_ROOT"; then
    show_install_overview
    return 0
  fi
  # Captured rather than inlined: a refusal inside a command substitution does
  # not abort the printf that holds it, so an unanswerable version would have
  # printed as a blank and read as an answer.
  ver="$(runtime_version)" || exit 1
  # VENDORED OR THE CHECKOUT IS THE TREE'S OWN FACT, NEVER THE RECORDED SOURCE'S
  # (issue 0153). A manifest records the kind of source it came from and this
  # machine says where that is, so a project whose source cannot be placed here
  # is still a vendored project: asked of manifest_source, it was told it was
  # the devbin checkout.
  is_devbin_installed "$PROJECT_ROOT" && vendored=1
  printf 'devbin %s -- the framework under bin/\n\n' "$ver"
  printf 'This launcher is devbin, vendored at bin/.devbin/ and driven by\n'
  printf "bin/.devbin/config.yaml. Identity comes from config: this install\n"
  printf "answers as '%s'.\n\n" "${DEVBIN_NAME:-devbin}"
  printf 'The seam:\n'
  if [ -n "$vendored" ]; then
    printf "  bin/devbin, %s/   devbin's -- replaced wholesale by upgrade\n" "$(lib_rel)"
  else
    # The checkout has no vendored copy to replace: lib/ IS the source, and
    # upgrade here replaces the machine install instead.
    printf "  bin/devbin, %s/               devbin's source -- this tree; nothing vendored\n" "$(lib_rel)"
  fi
  printf '  config.yaml, cmd/, help/       yours -- never written by install or upgrade\n\n'
  printf 'The framework surface here: %s install | upgrade | vendor | doctor | new | shell-init\n' "${DEVBIN_INVOKE:-bin/devbin}"
  printf 'Reference config, every key annotated: %s/config.reference.yaml\n' "$(lib_rel)"
  printf 'Scaffold templates: %s devbin templates\n' "${DEVBIN_INVOKE:-bin/devbin}"
  if [ -n "$vendored" ]; then
    if src="$(manifest_source "$PROJECT_ROOT" 2>/dev/null)" && [ -n "$src" ]; then
      printf '\nUpgrades come from: %s\n' "$src"
    else
      printf '\nUpgrades come from: nowhere this machine can place -- %s\n' "$(source_unplaced_why "$PROJECT_ROOT")"
    fi
  else
    printf '\nThis IS the devbin checkout, which runs devbin on itself.\n'
  fi
  show_guides
}

case "${1:-}" in
  "" | help) show_overview ;;
  -h | --help)
    usage
    exit 0
    ;;
  templates) show_templates ;;
  --version | -v | version) show_version ;;
  *)
    usage >&2
    exit 1
    ;;
esac
