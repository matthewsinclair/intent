#!/usr/bin/env bash
#
# The built-in `install` -- vendor this runtime into a project (design D5).
#
# The source is whatever devbin is RUNNING, not a hard-coded checkout: a devbin
# installed in project A can seed project B by the same path a fresh clone
# does. That falls out of lib/install taking a root and asking it where its
# runtime is, rather than knowing where devbin lives.
#
# What it writes is exactly the vendored set plus the scaffolding a project
# needs to be a project. What it must never write is anything a person authored
# -- see THE SEAM at the top of lib/install.
#
set -euo pipefail

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
# shellcheck source=lib/config
. "$DEVBIN_LIB/config"
# shellcheck source=lib/install
. "$DEVBIN_LIB/install"

usage() {
  cat <<EOF
usage: $DEVBIN_INVOKE install [--into <dir>] [--name <n>] [--alias <a>] [--lang <l>] [--force]
       $DEVBIN_INVOKE install [--prefix <dir>]          (inside devbin's own tree)

  --into <dir>   the project to install into (default: the current directory)
  --prefix <dir> PUBLISH mode only: where to publish the machine install
                 (default: install.prefix in devbin's own config. There is no
                 built-in default -- the location is configuration, D32)
  --name <n>     the project name (default: the target directory's name)
  --alias <a>    a short name this project may keep, eg 'cf' for conflab.
                 RECORDED ONLY -- devbin creates no symlink for it
  --lang <l>     a language the project declares; repeatable, or comma-separated
  --force        re-vendor over an existing install

Writes bin/devbin and bin/.devbin/lib/, scaffolds bin/.devbin/{cmd,help}, and
writes a starter config.yaml IF THERE IS NONE. Your config, handlers and
authored help are never overwritten, with or without --force.

TWO MODES, chosen by the tree you are standing in (ST0005, D26):

  PUBLISH   run inside devbin's own source tree with no --into. Publishes this
            runtime to the install prefix, which is what every consumer then
            vendors from. Refuses on a dirty tree, and refuses to overwrite an
            existing install -- use \`upgrade\` for that.
  VENDOR    everywhere else, and unchanged: install devbin into a project.

The mode is printed before anything is written.
EOF
}

# starter_config <name> <alias> <langs> <version> -- the config a fresh install
# gets, on stdout.
#
# `languages:` is OMITTED rather than left empty when none was given. An empty
# mapping is out of the config subset (D7) and `project.languages` with no index
# is not a schema path, so the tidier-looking empty key would make the very
# first `devbin doctor` fail validation on a file devbin wrote itself.
starter_config() {
  local name="$1" alias="$2" langs="$3" version="$4" l
  printf '# %s -- devbin configuration.\n' "$name"
  printf '#\n'
  printf '# Written by: devbin install. Every key, annotated, is vendored beside this\n'
  printf '# file at bin/.devbin/lib/config.reference.yaml.\n'
  printf '\n'
  printf 'project:\n'
  printf '  name: %s\n' "$name"
  [ -n "$alias" ] && printf '  alias: %s\n' "$alias"
  if [ -n "$langs" ]; then
    printf '  languages:\n'
    for l in $langs; do printf '    - %s\n' "$l"; done
  else
    printf '  # languages:            # elixir, rust, swift, lua, shell -- this is what\n'
    printf '  #   - elixir            # activates the built-in gates (design D11)\n'
  fi
  printf '\n'
  printf '# The devbin this project expects. Enforced by: devbin doctor\n'
  printf 'devbin_version: "^%s"\n' "$version"
  return 0
}

# THE PER-PROJECT LAUNCHER SYMLINK IS RETIRED (2026-08-27, superseding D6).
#
# `link_alias` lived here and made `bin/<project>` and `bin/<alias>` point at
# `bin/devbin`, so you typed `bin/lamplight test`. That convention collided with
# the binaries these projects now BUILD: Lamplight ships a `lamplight`, Intent
# ships an `intent`, and Intent had already routed around it by calling its shim
# `int`. A launcher that shadows the product is the wrong default.
#
# `bin/devbin` was always the real dispatcher and the symlinks were always
# aliases to it, so the retirement is a DELETION rather than a new convention --
# and the symlinks were never in devbin's vendored half, so no manifest,
# checksum or doctor baseline moves with them.
#
# `--alias` is still accepted and still recorded in config: it names the project
# for `intent` and for a human, and nothing about that needed the symlink.

main() {
  local into="" name="" alias="" langs="" force="" prefix="" srcroot dstroot version
  local rel src count=0 config mode dirty

  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help)
        usage
        return 0
        ;;
      --into)
        into="${2:-}"
        shift 2 || die "--into needs a directory"
        ;;
      --name)
        name="${2:-}"
        case "$name" in
          *[A-Z]*) die "project name must be lower case: --name $name
       It is the identity in help, die/warn output and doctor, and a capitalised
       one reads as a directory name leaking into a command surface." ;;
        esac
        shift 2 || die "--name needs a value"
        ;;
      --alias)
        alias="${2:-}"
        case "$alias" in
          *[A-Z]*) die "alias must be lower case: --alias $alias
       Recorded only -- devbin installs nothing for it -- but if the project
       hand-makes bin/$alias, a capital is not a conforming command name." ;;
        esac
        shift 2 || die "--alias needs a value"
        ;;
      --lang)
        langs="$langs $(printf '%s' "${2:-}" | tr ',' ' ')"
        shift 2 || die "--lang needs a value"
        ;;
      --prefix)
        prefix="${2:-}"
        shift 2 || die "--prefix needs a directory"
        ;;
      --force)
        force=yes
        shift
        ;;
      -*) die "unknown option '$1' (try: $DEVBIN_INVOKE install --help)" ;;
      *) die "unexpected argument '$1' (the target goes after --into)" ;;
    esac
  done

  srcroot="${PROJECT_ROOT:?}"

  is_devbin_source "$srcroot" ||
    die "this devbin cannot be a source: no dispatcher or runtime at $srcroot"

  # --- WHICH MODE (ST0005, D26) ----------------------------------------------
  #
  # PUBLISH when standing in devbin's own source tree with no --into; VENDOR
  # everywhere else. An explicit --into is always VENDOR, because naming a target
  # is unambiguous about what you meant and seeding a consumer from the dev tree
  # has to stay possible.
  #
  # `is_devbin_dev_tree` asks whether this tree can be vendored FROM while
  # carrying no vendored runtime of its OWN -- derived from the two predicates
  # that already exist rather than from a path or a project name, neither of
  # which is a fact about what the tree IS. The install tree reads as a consumer
  # here, which is correct: it is consumer-shaped by D33.
  if [ -z "$into" ] && is_devbin_dev_tree "$srcroot"; then
    mode=publish
  else
    mode=vendor
  fi

  # A flag that is meaningless in the mode you are actually in is a usage error,
  # not something to ignore. Silently discarding --prefix would publish to the
  # configured location while the operator believed they had redirected it.
  if [ -n "$prefix" ] && [ "$mode" != publish ]; then
    die "--prefix applies only when publishing from devbin's own source tree
       you are in VENDOR mode$([ -n "$into" ] && printf ' (--into was given)')
       to publish:  cd <the devbin source tree> && bin/devbin install"
  fi

  if [ "$mode" = publish ]; then
    # The devbin config the dispatcher loaded lives in ITS process; handlers are
    # reached by `exec` (lib/resolve:173) so nothing survives into this one.
    # Loaded HERE and read HERE, before the target's config is loaded further
    # down over the top of it.
    cfg_load "$DEVBIN_DIR/config.yaml" >/dev/null 2>&1 ||
      die "cannot read devbin's own config at $DEVBIN_DIR/config.yaml"
    # `|| die_...` rather than a bare assignment, so the refusal happens HERE
    # rather than as an unexplained errexit death at the assignment. There is no
    # baked default any more: an unconfigured prefix is a configuration error,
    # not a location to guess at (D32).
    if [ -z "$prefix" ]; then
      prefix="$(install_prefix_configured)" || die_install_prefix_unset '--prefix <dir>'
    fi
    dstroot="$prefix"
  else
    dstroot="$(cd "${into:-.}" 2>/dev/null && pwd)" ||
      die "no such directory: ${into:-.}"
  fi

  # ANNOUNCED BEFORE ANYTHING IS WRITTEN (D26). A discriminator that is merely
  # correct is not enough: a misdetection has to land in the output rather than
  # be discovered later in the filesystem.
  if [ "$mode" = publish ]; then
    printf 'mode: PUBLISH -- %s is devbin'"'"'s own source tree\n' "$srcroot"
    printf '  publishing to: %s\n\n' "$dstroot"
  else
    printf 'mode: VENDOR -- installing devbin INTO a project\n\n'
  fi

  # --- the dirty gate (D28) ---------------------------------------------------
  #
  # WHOLE TREE, not just the vendored set. The manifest's claim is "these bytes
  # are commit X", and that is only true when nothing in the tree is uncommitted.
  #
  # NO --force. This gate is the entire reason the install tree exists: an
  # install cut from a dirty checkout launders the same bytes through one more
  # hop and gives them the LOOK of provenance, which is worse than today, since
  # today's manifest at least says THESE BYTES MATCH NO COMMIT out loud.
  if [ "$mode" = publish ]; then
    if ! dirty="$(tree_dirty_paths "$srcroot")"; then
      die "cannot publish: $srcroot is not a git repository, so the commit this
       install would claim cannot be established"
    fi
    if [ -n "$dirty" ]; then
      warn "refusing to publish: the source tree is dirty"
      printf '%s\n' "$dirty" | while IFS= read -r line; do warn "  $line"; done
      die "commit or stash, then publish -- an install cut from a dirty tree
       records a commit that does not describe the bytes in it"
    fi
  fi

  # Refusing to install into the source is not fussiness. Devbin runs itself out
  # of its own lib/ (D12); vendoring into bin/.devbin/lib/ would put a frozen
  # copy AHEAD of the working tree in the dispatcher's own search order, so every
  # edit to lib/ would stop taking effect and the test suite would go on passing
  # against the copy.
  # ANY dev tree, not just THIS one. The comparison was `dstroot = srcroot`,
  # which only catches installing a tree into itself -- and the harm above has
  # nothing to do with the two being the same. Installing from the machine
  # install into devbin's source tree has a different source and an identical
  # consequence, and on 2026-09-07 it happened: bin/.devbin/lib/ and a manifest
  # landed in the dev tree, past a guard that could not see them because the
  # source was somewhere else.
  if is_devbin_dev_tree "$dstroot"; then
    die "cannot install devbin into a devbin SOURCE tree ($dstroot)
       It runs lib/ in place (D12); a vendored copy would sit ahead of the
       working tree in the search order and every edit to lib/ would stop
       taking effect, with the suite still green against the copy."
  fi

  # PUBLISH refuses an existing install and names `upgrade`; VENDOR refuses and
  # names `--force`. Same shape, different remedy -- and the shape is not new:
  # this refusal already existed for consumers and is only being told which verb
  # to point at (hv, 2026-09-06).
  if is_devbin_installed "$dstroot" && [ "$mode" = publish ]; then
    warn "devbin is already installed at $dstroot"
    warn "  to update it:  $DEVBIN_INVOKE upgrade"
    warn ""
    warn "  \`install\` publishes a NEW install and will not overwrite one, so that"
    warn "  replacing what the whole estate vendors from is always a verb you typed."
    return 1
  fi
  if is_devbin_installed "$dstroot" && [ -z "$force" ]; then
    warn "devbin is already installed at $dstroot/bin/.devbin/lib"
    warn "  to re-vendor the runtime:   $DEVBIN_INVOKE install --into $dstroot --force"
    warn "  to update it in place:      cd $dstroot && bin/devbin upgrade"
    return 1
  fi

  # A project that already has a config has already declared who it is, and that
  # beats both the flags' default and the directory name. Re-installing must not
  # rename a project or drop the alias its people type. Neither value creates a
  # symlink any more -- `link_alias` is retired, see above -- but `project.name`
  # is the identity every command prints and `project.alias` is the short name a
  # project may choose to maintain BY HAND, so guessing either still rewrites a
  # decision the project already made.
  #
  # The dispatcher loaded the SOURCE's config in its own process; this is a
  # separate one, so loading the TARGET's here collides with nothing.
  config="$dstroot/bin/.devbin/config.yaml"
  if [ -f "$config" ] && cfg_load "$config" >/dev/null 2>&1; then
    [ -n "$name" ] || name="$(cfg_get project.name)"
    [ -n "$alias" ] || alias="$(cfg_get project.alias)"
  fi

  # LOWER-CASED. This no longer names a symlink -- devbin creates none -- but it
  # is still the identity in help, die/warn output and doctor, and a capitalised
  # one reads as a directory name leaking into a command surface.
  # Project DIRECTORIES routinely are capitalised -- Conflab, Laksa, Baize,
  # Lamplight, MicroGPTEx, Prolix, Riffle -- so taking the basename verbatim is
  # wrong more often than it is right.
  #
  # It took nine installs to find that out, because the derivation had never
  # once run on a capitalised directory: all six capitalised projects happened
  # to pass an explicit `--name`, and the two that took the default (arca_config,
  # arca_cli) already had lowercase directories, so the default was accidentally
  # correct. Riffle was the first install to take the default on a capitalised
  # directory and it produced `bin/Riffle`.
  #
  # An EXPLICIT `--name` is validated at parse time instead of being lowered
  # here: a derivation devbin performs is devbin's to get right silently, but a
  # value a person typed is an instruction, and quietly changing it would hide
  # the fact that the name they asked for is not one they can have.
  [ -n "$name" ] || name="$(printf '%s' "${dstroot##*/}" | tr '[:upper:]' '[:lower:]')"
  version="$(devbin_runtime_version)"
  langs="${langs# }"

  if [ "$mode" = publish ]; then
    printf 'Publishing devbin %s to %s\n\n' "$version" "$dstroot"
  else
    printf 'Installing devbin %s into %s\n\n' "$version" "$dstroot"
  fi

  # PUBLISH goes through `publish_install` -- the single writer shared with
  # `upgrade`'s dev-tree mode -- so the two verbs cannot drift about what an
  # install tree contains. VENDOR keeps its own loop because it writes a project
  # half that an install never gets.
  if [ "$mode" = publish ]; then
    count="$(publish_install "$srcroot" "$dstroot" "$version")" ||
      die "failed to publish the install to $dstroot"
    printf '  vendored   %d files (bin/devbin, bin/.devbin/lib/)\n' "$count"
  else
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      src="$(vendor_source_path "$srcroot" "$rel")" ||
        die "cannot locate '$rel' in the source at $srcroot"
      copy_vendored "$src" "$dstroot/$rel" || die "failed to write $dstroot/$rel"
      count=$((count + 1))
    done <<EOF
$(vendored_paths "$srcroot")
EOF
    printf '  vendored   %d files (bin/devbin, bin/.devbin/lib/)\n' "$count"
  fi

  # THE PROJECT HALF IS EXACTLY WHAT AN INSTALL DOES NOT GET (D27, D33).
  #
  # No config.yaml, no cmd/, no help/ -- and that absence is not tidiness, it is
  # the mechanism. `bin/devbin` dies without a config.yaml, so an install tree
  # cannot be run FROM; it can only be vendored from. D27's "always a --from,
  # never a cwd" therefore needs no check of its own and has no flag that turns
  # it off, which is the only kind of rule this project trusts.
  if [ "$mode" = publish ]; then
    printf '  omitted    the project half (no config.yaml, cmd/ or help/)\n'
    printf '             -- which is what makes this an install and not a project\n'
  else
    # Created, never populated: an empty cmd/ is the invitation, and anything
    # already in it is left exactly as it is.
    mkdir -p "$dstroot/bin/.devbin/cmd" "$dstroot/bin/.devbin/help"

    if [ -f "$config" ]; then
      printf '  kept       bin/.devbin/config.yaml (yours -- not touched)\n'
    else
      starter_config "$name" "$alias" "$langs" "$version" >"$config"
      printf '  wrote      bin/.devbin/config.yaml (starter)\n'
    fi
  fi

  # In PUBLISH mode `publish_install` already wrote it, as part of being the one
  # writer. Writing it a second time here would work and would mean the manifest
  # has two authors again, which is the thing that function exists to prevent.
  if [ "$mode" != publish ]; then
    manifest_write "$dstroot" "$srcroot" "$version" ||
      die "failed to write the manifest"
  fi
  printf '  wrote      %s\n' "$DEVBIN_MANIFEST_REL"

  if [ "$mode" = publish ]; then
    printf '\nPublished. Consumers vendor from here:\n'
    printf '  cd <a project> && bin/devbin upgrade --from %s\n' "$dstroot"
    printf '  bin/devbin fleet upgrade --dry-run     (from this tree, to see the estate)\n'
    return 0
  fi

  printf '\nNext:\n'
  printf '  cd %s\n' "$dstroot"
  printf '  bin/devbin doctor      check the install\n'
  printf '  bin/devbin help        the command surface you have\n'
  return 0
}

main "$@"
