#!/usr/bin/env bash
#
# The built-in `clean`. Removes build artefacts the project can regenerate:
# cargo `target/` trees, Elixir `_build/`, Swift `.build/`. Not Xcode's DerivedData,
# which this summary claimed until issue 0035's review found nothing removes it.
#
# IT TAKES `release/` BY DEFAULT, AND THAT IS WHAT MAKES IT A RELEASE VERB
# RATHER THAN A CACHE SWEEPER. hv runs this before a release so the shipped
# surface is provably new. `int cache --clean` in the Intent tree is a different
# concern with a near-disjoint scope -- it analyses path-move residue in
# `debug/deps` that cargo reports FRESH, and never touches `release/` at all.
# Neither is a policy over the other's engine; they answer different questions.
#
# WHY A VERB AND NOT A SCHEDULE. hv ruled out launchd and cron explicitly. The
# failure this exists for was ~2.9M files and ~82 GB across the fleet's cargo
# target dirs, and a scheduled sweep of a destructive action is the shape that
# removes a live binary at 3am with nobody to answer the prompt.
#
# EVERY REFUSAL BELOW WAS PAID FOR BY A REAL FAILURE. They are refusals rather
# than warnings because this command's mistake is not recoverable by re-running
# it: usage-rules puts a false green above a failure, and the destructive
# analogue is that a clean which cannot prove it is safe must not proceed.
#
set -euo pipefail

# shellcheck source=lib/gatecmd
. "${DEVBIN_LIB:?run me through bin/devbin}/gatecmd"

# The marker Spotlight honours. Placed on the same walk that finds a tree, so
# the thirteenth target dir nobody remembers stops being indexed even when this
# run does not remove it.
_CLEAN_NEVER_INDEX=".metadata_never_index"

# ---------------------------------------------------------------------------
# The PATH scan, and the control that makes its emptiness mean something
# ---------------------------------------------------------------------------

# _clean_path_elements -- print one PATH element per line. NO REFUSALS HERE.
#
# The validation lives in _clean_validate_path below and is deliberately NOT in
# this function, because this one is consumed through `< <(...)`. A `die` inside
# a process substitution exits only the subshell: the parent's read loop simply
# receives no input and carries on, so the run reports NO LIVE BINARIES and
# proceeds to delete. The refusal fires, is swallowed, and produces exactly the
# false clean it was written to prevent.
#
# Found by breaking the splitter and watching the test NOT go red -- which is
# the whole argument for asking whether a control COULD fail rather than
# whether it would.
_clean_path_elements() {
  local -a split=()
  local e
  IFS=: read -r -a split <<<"$PATH"
  for e in "${split[@]}"; do
    [ -n "$e" ] && printf '%s\n' "$e"
  done
  return 0
}

# _clean_validate_path -- refuse unless the PATH scan can be trusted.
#
# CALLED IN THE CURRENT SHELL, ONCE, BEFORE ANY SCANNING. That placement is the
# fix for the swallow described above and is not incidental.
#
# THIS EXISTS FOR ITS CONTROL, NOT FOR ITS SPLIT. A PATH scan that cannot parse
# its input and one that finds nothing are indistinguishable by their output,
# and the broken version passes review: intent-dc shipped exactly this check and
# it returned nothing while `command -v conflab` resolved into a target dir one
# line later, because `${PATH//:/$'\n'}` does not expand under zsh and the loop
# ran zero times.
#
# The specific zsh mechanism cannot reach here -- the dispatcher refuses below
# bash 5 and this file is `#!/usr/bin/env bash`. A control written against that
# mechanism would be a predicate narrower than the defect, which is the class
# this project has produced three times. So it is written against the GENERAL
# failure: the scan yields nothing for any reason whatever.
#
# Two independent instruments, compared. `tr` counts separators; the array split
# counts fields. They can only agree by both being right.
_clean_validate_path() {
  local -a split=()
  local n_split n_count e found=0

  IFS=: read -r -a split <<<"$PATH"
  n_split="${#split[@]}"
  n_count="$(printf '%s' "$PATH" | tr ':' '\n' | grep -c '' || true)"

  [ "$n_split" = "$n_count" ] ||
    die "PATH scan is unreliable: field split says $n_split element(s), separator count says $n_count.
       Refusing rather than reporting a clean scan -- an instrument that cannot
       parse its input reads exactly like one that found nothing."

  # POSITIVE CONTROL. Two parses of a broken or empty PATH agree with each other
  # and are both wrong, so agreement alone is not evidence. At least one element
  # must be a directory that exists.
  #
  # NO TEST REACHES THIS BRANCH and the suite says so: setting such a PATH kills
  # awk, env and the rest of the runtime long before the scan runs.
  for e in "${split[@]}"; do
    [ -n "$e" ] && [ -d "$e" ] && found=1
  done
  [ "$found" = 1 ] ||
    die "PATH scan found no existing directory among $n_split element(s) -- the scan is blind, not clean."
  return 0
}

# _clean_live_binaries <dir> -- print every PATH-reachable name that resolves
# INSIDE <dir>, one `name -> resolved` per line. Empty output means none.
#
# Conflab's `conflab` and `conflabd` resolved through `target/debug` on the
# morning this command was specified; Intent's resolve through `target/release`,
# which this verb takes BY DEFAULT. A comprehensive clean would have removed the
# live binary every node in the estate was running, machine-wide, both copies.
#
# TWO WAYS IN, AND THE SEARCH IS INVERTED FOR THE SECOND. The obvious shape --
# walk every PATH entry, resolve every symlink in it, test each against the tree
# -- is correct and unusably slow: it is O(PATH entries x files per entry) with
# a fork per test, and on a real machine that is tens of thousands of forks per
# candidate directory. The first version of this file did exactly that and hung
# the suite past two minutes.
#
# So the expensive half is inverted. The set of executables IN a build tree is
# small -- tens, at the top level of debug/ and release/ -- and `command -v` is
# a shell builtin that forks nothing. Asking "does PATH resolve THIS name, and
# does it land back inside the tree" answers the same question in O(binaries).
#
# `deps/` is excluded from the scan deliberately: nothing on a real PATH
# resolves into it, and it is where the thousands of files are.
_clean_live_binaries() {
  local dir="$1" real p pr f base found sub

  real_path "$dir" real

  # THE OUTPUT IS DEDUPED, AND THE DUPLICATE WAS A MISCOUNT RATHER THAN NOISE.
  # Branch (b) walks debug/, release/ and the tree root, takes each executable's
  # BASENAME, and resolves that name through PATH. A cargo tree ordinarily holds
  # the same binary in BOTH debug/ and release/, so one PATH entry was printed
  # once per location carrying its name -- Intent listed `intent` and `intentd`
  # twice each and reported two at-risk binaries as four.
  #
  # It matters because of what the line CLAIMS. The refusal above says "removing
  # these trees would darken the binaries listed above", so each line is one
  # binary that goes dark; the loop was counting places the name appears in the
  # tree, which is a different population and always the larger one. An operator
  # deciding whether to pass --force reads that list, and a doubled list argues
  # for caution by overstating -- the direction that erodes trust in the guard.
  #
  # Deduped in ORDER rather than sorted: the two branches emit different line
  # shapes and the order is the story (PATH entries inside the tree, then
  # binaries the tree provides).
  {

  # (a) A PATH ENTRY THAT IS ITSELF INSIDE THE TREE. Few elements, so the
  # straightforward test is affordable here.
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -d "$p" ] || continue
    real_path "$p" pr
    case "$pr/" in "$real"/*) printf '%s (PATH entry) -> %s\n' "$(_clean_shown "$p")" "$(_clean_shown "$pr")" ;; esac
  done < <(_clean_path_elements)

  # (b) A BINARY IN THE TREE THAT PATH RESOLVES TO. This is the shape that
  # actually happened, via a symlink from an ordinary bin directory.
  #
  # EVERY debug/ AND release/ WITHIN TWO LEVELS OF THE TOP (the critic's sixth
  # pass): the tree's own, a per-node directory's such as target/cc's or a
  # target triple's, and a triple's inside a per-node directory. A target whose
  # only output is per-node is a tree (issue 0131), and a link into
  # target/cc/debug went dark under --force unsaid; a triple's was missed
  # before 0131 too.
  #
  # AN ANSWER THAT IS A PATH IS READ, RELATIVE OR NOT: a command found through
  # a relative PATH entry, the Rails ./bin idiom, is answered relative, and
  # every such answer was skipped. It is read from the current directory,
  # which _clean_run makes the project root, as the lookup was. An answer that
  # names no path, a builtin's or a function's, names nothing in the tree.
  for sub in "$dir"/debug "$dir"/release "$dir"/*/debug "$dir"/*/release \
    "$dir"/*/*/debug "$dir"/*/*/release "$dir"; do
    [ -d "$sub" ] || continue
    for f in "$sub"/*; do
      [ -f "$f" ] || continue
      [ -x "$f" ] || continue
      base="${f##*/}"
      found="$(command -v "$base" 2>/dev/null)" || continue
      [ -n "$found" ] || continue
      case "$found" in */*) ;; *) continue ;; esac
      real_path "$found" pr
      case "$pr/" in "$real"/*) printf '%s -> %s\n' "$(_clean_shown "$found")" "$(_clean_shown "$pr")" ;; esac
    done
  done
  } | awk '!seen[$0]++'
  return 0
}

# ---------------------------------------------------------------------------
# Enumeration and classification
# ---------------------------------------------------------------------------

# _clean_roots <name> <markers> <manifest> <roots-var> <inplace-var> -- every
# candidate build-tree root under PROJECT_ROOT, deduplicated, with nested ones
# dropped, appended to the array named <roots-var>; and to <inplace-var>, every
# candidate that is a crate itself (below). Found BY MARKER AS WELL AS BY NAME.
# Returns 3, having set what it did find, when the scan is partial -- find exited
# non-zero, which says only that it could not do all it was asked, or the walk
# met a directory it could read but not search, or grep could not read a tag --
# and 1 on a failure of this function's own, a candidate outside the root or a
# sort that failed, which is a devbin defect.
#
# NO -maxdepth. A depth-limited sweep missed 22.6 GB on the day this was
# specified, including a 10 GB tree inside a git worktree -- and devbin's own
# fleet enumeration reproduced the same defect twice, at depth 3 and again at
# depth 4, both times silently returning a plausible number.
#
# NAME ALONE IS NOT ENOUGH, and this is devbin-cc's correction to the first
# version of this file. `CARGO_TARGET_DIR` points a build tree anywhere, under
# any name -- the largest single item on this estate was one of them, 33 GB and
# 534,337 files, created because a guard's own refusal message tells the caller
# to set it. A name-keyed scan does not merely mis-sort such a tree, it never
# enumerates it, so the run reports success over a set it never saw. In a
# sweeper THAT is the worse direction: a false positive is loud and refusable,
# a false negative is a 10 GB tree that appears in no output at all.
#
# So the markers are searched directly and unioned with the name match.
#
# ONE find, AND IT PRUNES AT EVERY CANDIDATE FOUND BY NAME (the critic's reviews
# of 0131). There were three passes, one by name and one per marker, and the
# marker passes walked inside every target tree -- where a cargo build running
# beside this one creates and deletes incremental/ directories as it goes, and
# find exits non-zero on an entry that vanished between listing and reading it:
# 156 of 161 dry runs over a build in progress read as PARTIAL (driven). A tree
# inside a tree found by name is part of it (_clean_drop_nested would drop it),
# so nothing is lost by not walking there, and one unreadable directory is
# named once rather than once per pass. A tree found by its MARKER has no name
# to prune on and is walked in full, so an unreadable directory inside one does
# make the scan partial. -ignore_readdir_race covers the race everywhere: GNU
# find and BSD find both take it, and a directory that cannot be read still
# fails the walk. -mindepth 1 keeps the name test off the project root itself,
# which a project checked out as `target` had pruned whole, examining nothing
# beneath it (the critic's third review of 0131).
#
# CARGO'S MARKERS, SEARCHED FOR CARGO'S ARM ONLY, AND ONLY CARGO'S (issue 0131).
# CACHEDIR.TAG is a cross-tool convention, and pytest, mypy and others write the
# same signature line, so a tag counts only when it names cargo as its writer
# (_clean_cargo_tag). The union ran for every arm, which listed each cargo tree
# as a name-alike under `clean elixir` and `clean swift`; `_build` and `.build`
# carry no marker of their own, so their arms are found by name alone. The arm
# says which it is, in <markers>: `cargo`, or `none`.
#
# A DIRECTORY find CANNOT READ MAKES THE SCAN PARTIAL, AND THE CALLER IS TOLD
# (issue 0131). find ran with its errors sent to /dev/null, in a pipeline its
# caller read through a process substitution, so a tree beneath a directory it
# could not read was never listed and nothing could know. find's output is now
# taken whole with its status, as issue 0127 does for the vendored set, and its
# own error stays on stderr to name the path. So does grep's, for a tag it
# cannot read, since that tag might have been the tree's only marker -- unless a
# .rustc_info.json beside it already makes the tree cargo's, and then the tag is
# not read at all, so one tree gets one verdict however it was found (the
# critic's third review of 0131: found by its tag it read as PARTIAL, found by
# its name it passed with grep's error printed over the result).
#
# EVERY PATH IS CARRIED WHOLE, NUL-DELIMITED, AND NEVER LEAVES AN ARRAY (issue
# 0141). find's output was read a line at a time and the scan's result carried
# as TAB-joined text, so a directory whose name held a newline became two paths
# -- the second, spelled by the subtree beneath it, a real build tree OUTSIDE
# the project -- and a name ending in a TAB lost it, so the tree classified was
# out<TAB> and the tree listed was the source directory out/. Both were listed
# for removal (driven). find's status is read by `wait` on the process
# substitution that carries its output, which bash has allowed since 4.4.
#
# NOTHING OUTSIDE PROJECT_ROOT IS EVER A CANDIDATE, AND THAT DOES NOT REST ON
# PARSING ALONE (issue 0141). A path not strictly beneath PROJECT_ROOT, as find
# printed it, is a devbin defect: the run stops before acting on a list that
# produced one. -H follows PROJECT_ROOT itself when it is a link -- under find's
# default -P a linked root was not descended at all, and the scan examined
# nothing at exit 0 (the critic's fourth pass; the dispatcher's `cd -P` makes a
# root physical, a caller setting PROJECT_ROOT directly may not) -- and below it
# find follows no link, so every path it prints is the physical one.
#
# A DIRECTORY NAMED LIKE A TREE THAT HOLDS ITS OWN MANIFEST IS A CRATE, AND IS
# WALKED, NOT PRUNED (the critic's fourth pass). The name test pruned at it, so
# a crate whose directory is named target hid its own build tree, and was then
# set aside as built in place with no build output in it at all. The prune now
# asks for the manifest first (-exec test), so such a crate is walked like any
# other directory, and "built in place" below is only ever a candidate found by
# a marker.
#
# A DIRECTORY HOLDING ITS OWN MANIFEST IS NEVER A BUILD TREE (issue 0141).
# `cargo build --target-dir .` writes .rustc_info.json and cargo's tag into the
# crate itself, so the crate became a candidate: a workspace member was listed
# for removal, sources and all, because its parent's Cargo.toml sat beside it;
# and at the project root, every real tree beneath was dropped as nested and
# never listed. Such a directory, and the project root itself, goes to
# <inplace-var> BEFORE the nesting test, so the trees beneath it are still found.
#
# THE LIMIT, STATED RATHER THAN LEFT TO BE DISCOVERED: a build tree redirected
# OUTSIDE PROJECT_ROOT is not reachable from here and is not reported. This
# command walks one project; it is not a machine sweep.
_clean_roots() {
  local name="$1" markers="$2" manifest="$3" root="${PROJECT_ROOT%/}" line t d rc=0
  # The arrays behind <roots-var> and <inplace-var> are the caller's, reached by
  # NAME through bash's dynamic scope, so no local here may share a name with
  # one a caller passes: it would shadow the caller's array, and the appends
  # below would land in it instead.
  local -n _cr_roots="$4" _cr_inplace="$5"
  local -a marks=() cands=() keep=() sorted=() crates=()
  # WHAT THE WALK RUNS IS /bin/sh, NAMED WHOLE, AND NOTHING FOUND THROUGH PATH
  # (the critic's fifth and sixth passes). find looks -exec's utility up
  # through PATH, and a project's own bin/test first on PATH -- direnv's
  # `PATH_add bin` puts it there -- was run by the dry run that promises to
  # change nothing, once per directory named like the tree: exiting 1 it
  # stopped every prune by name, exiting 0 it pruned crates again, and find
  # exited 0 either way. The `[` is /bin/sh's own; /bin/test would serve as
  # well, and is absent where /bin holds only sh, as on NixOS.
  #
  # AND A DIRECTORY THE WALK CAN READ BUT NOT SEARCH MAKES THE SCAN PARTIAL:
  # macOS's find passes over one, mode r--, printing nothing beneath it, no
  # error, and exiting 0, so a tree beneath it went unseen and unsaid (the
  # critic's sixth pass on 0131). This walk carried its own clause for it until
  # issue 0145 gave every walk that descends one detector, find_walk, which
  # names such a directory and fails; its status is this walk's, below.
  [ "$markers" != cargo ] || marks=(-o -type f \( -name CACHEDIR.TAG -o -name .rustc_info.json \) -print0)
  # shellcheck disable=SC2016 # the $1 and $2 in the -exec programs are /bin/sh's own
  while IFS= read -r -d '' line; do
    case "${line##*/}" in
      CACHEDIR.TAG)
        # A marker that needs no read makes the tree cargo's without the tag, so
        # the candidate is added here and the tag is not read: reading it could
        # add only an error (_clean_marked_without_read).
        if _clean_marked_without_read "${line%/*}"; then
          cands+=("${line%/*}")
          continue
        fi
        t=0
        _clean_cargo_tag "$line" || t=$?
        # 0 is cargo's and 1 another tool's; 3 is grep unable to read it, which
        # says neither.
        [ "$t" -le 1 ] || rc=3
        [ "$t" -eq 0 ] || continue
        cands+=("${line%/*}")
        ;;
      .rustc_info.json) cands+=("${line%/*}") ;;
      *) cands+=("$line") ;;
    esac
    # find-status: read by `wait "$!"` below, on this process substitution (issue 0139's scan)
  done < <(find_walk -H "$PROJECT_ROOT" -mindepth 1 -ignore_readdir_race \
    \( -name .git -o -name node_modules -o -name .direnv \) -prune -o \
    -type d -name "$name" -exec /bin/sh -c '[ ! -f "$1/$2" ]' sh {} "$manifest" \; -prune -print0 ${marks[@]+"${marks[@]}"})
  # find's status, read here because the loop above holds the only process
  # substitution in this function and runs nothing in the background: any `&`
  # job or process substitution added to the loop's body, or to anything it
  # calls, replaces $! and loses find's status, and the scan then reads as
  # complete (the critic's fourth pass). Any non-zero from find_walk is a
  # partial scan, since its status says only that it could not do all it was
  # asked -- a directory it could not read or could not search, each named; a
  # find refusing its own arguments reads the same, and its error names why.
  wait "$!" || rc=3
  for d in "${cands[@]}"; do
    if [ "$d" = "$root" ] || [ -f "$d/$manifest" ]; then
      crates+=("$d")
      continue
    fi
    case "$d" in
      "$root"/?*) keep+=("$d") ;;
      *)
        warn "clean: $(_clean_shown "$d") is not beneath $(_clean_shown "$root") -- a devbin defect, so nothing from this scan is acted on"
        return 1
        ;;
    esac
  done
  if [ "${#keep[@]}" -gt 0 ]; then
    mapfile -d '' -t sorted < <(printf '%s\0' "${keep[@]}" | LC_ALL=C sort -z -u)
    wait "$!" || return 1
  fi
  _clean_drop_nested sorted _cr_roots
  if [ "${#crates[@]}" -gt 0 ]; then
    mapfile -d '' -t sorted < <(printf '%s\0' "${crates[@]}" | LC_ALL=C sort -z -u)
    wait "$!" || return 1
    _cr_inplace+=("${sorted[@]}")
  fi
  return "$rc"
}

# _clean_drop_nested <in-var> <out-var> -- of the paths in the array <in-var>,
# sorted in the C locale, append only the outermost to the array <out-var>.
# Arrays in and out (issue 0141): the paths are never joined into text, so no
# character a name can hold can split one.
#
# A PATH IS NESTED WHEN IT LIES UNDER ANY ROOT ALREADY KEPT, NOT ONLY THE LAST
# (issue 0137). A parent sorts before its own children, and this compared each
# path with the last root it kept as if nothing could sort between the two. But
# `.` and `-` sort below `/`, so `target.bak` and `target-old` sort between
# `target` and `target/cc`: `target/cc` was then tested against the sibling,
# kept, and reported as a tree of its own -- skipped and marked, and then
# removed with `target` all the same.
#
# Without this a marker inside an already-matched tree reports a second root
# inside the first, and the removal loop would then try to delete a directory
# its predecessor has already taken.
_clean_drop_nested() {
  local -n _cdn_in="$1" _cdn_out="$2"
  local d k
  for d in "${_cdn_in[@]}"; do
    [ -n "$d" ] || continue
    for k in "${_cdn_out[@]}"; do
      case "$d/" in "$k"/*) continue 2 ;; esac
    done
    _cdn_out+=("$d")
  done
  return 0
}

# _clean_scan <name> <manifest> <markers> <removable> <nomanifest> <notbuild>
# <unread> <inplace> -- classify every root into the caller's arrays, named by
# the last five arguments:
#
#   removable    markers present AND a sibling manifest to rebuild from
#   nomanifest   built here, but nothing beside it can regenerate it
#   notbuild     named like a build tree and carrying no build markers
#   unread       a candidate that could not be read, so it is not classified
#   inplace      a crate holding a build's markers in itself (_clean_roots)
#
# Returns 3, having classified all it could, when the scan was partial: find
# could not read a directory, or grep a tag, or a candidate could not be read
# (issue 0131); and 1, at once, when _clean_roots failed some other way.
#
# IN THIS SHELL, INTO ARRAYS (issue 0141). The result was TAB-joined text, read
# back with `IFS=$'\t' read`, which strips a TAB that ends a name.
#
# EVERY REJECTION IS EMITTED, WHICH IS THE WHOLE POINT OF THE THREE STATUSES.
# A skipped tree that prints nothing is indistinguishable from a tree that was
# never there, and that is the empty-denominator shape this project keeps
# finding: the caller reads a clean run as coverage. Rejections are printed with
# their size so a human can look at the number and decide.
#
# CLASSIFIED BY REBUILDABILITY, NOT BY SHAPE. Markers say "something built
# here"; they do not say "this can be rebuilt", and those are different claims.
# A tree whose manifest is gone -- a half-deleted checkout, a worktree whose
# branch was removed -- is not a cache, it is the last copy. The manifest test
# is what separates them, and it retires the Xcode `*.noindex` PIF caches by
# MECHANISM rather than by a name test, which would be a predicate narrower
# than the defect all over again.
_clean_scan() {
  local name="$1" manifest="$2" markers="$3" d m rc=0 rrc=0
  local -n _cs_rm="$4" _cs_nm="$5" _cs_nb="$6" _cs_ur="$7" _cs_ip="$8"
  local -a roots=()
  _clean_roots "$name" "$markers" "$manifest" roots _cs_ip || rrc=$?
  case "$rrc" in
    0) ;;
    3) rc=3 ;;
    *) return 1 ;;
  esac
  for d in "${roots[@]}"; do
    # A candidate that vanished since the walk -- another session's clean, or
    # cargo's -- is not there to classify, and is no partial scan (the critic's
    # fourth pass), as the walk itself ignores an entry that vanishes.
    [ -e "$d" ] || continue
    m=0
    _clean_has_markers "$d" "$name" "$markers" || m=$?
    case "$m" in
      0)
        if [ -f "${d%/*}/$manifest" ]; then
          _cs_rm+=("$d")
        else
          _cs_nm+=("$d")
        fi
        ;;
      3)
        # Not read, so neither a tree nor not one: listed as unread, and the
        # scan is partial.
        _cs_ur+=("$d")
        rc=3
        ;;
      *) _cs_nb+=("$d") ;;
    esac
  done
  return "$rc"
}

# ---------------------------------------------------------------------------
# Peer discipline, marking, confirmation, removal
# ---------------------------------------------------------------------------

# _clean_mark <dir> <dry> -- place the Spotlight marker if it is missing, or
# with <dry> 1, say that a real run would.
#
# On the same walk, deliberately. A separate marking pass is a second
# enumeration that can disagree with the first.
#
# A DRY RUN WRITES NOTHING HERE (issue 0131). It placed the marker like a real
# run, so the preview that promises to change nothing created a file in every
# skipped tree. The decision lives here, beside the write, and <dry> is
# REQUIRED, so no caller -- a new one written the old way included -- can reach
# the write without passing through it.
#
# A MARKER THAT CANNOT BE WRITTEN IS SAID. The write was `2>/dev/null ||
# return 0`, so a skipped tree on a read-only mount, or owned by someone else,
# was left for Spotlight to index while the dry run had said it would be
# marked. The shell's error names the file; the line after it says what was
# not done. It is not a failure of the clean, which removed nothing wrongly.
_clean_mark() {
  local dir="$1" dry="${2:?_clean_mark: <dry> is required -- a devbin defect}"
  [ -d "$dir" ] || return 0
  [ -e "$dir/$_CLEAN_NEVER_INDEX" ] && return 0
  if [ "$dry" = 1 ]; then
    # THE PREVIEW SAYS WHAT THE REAL RUN WILL DO, not what it would try (the
    # critic's review of 0131): a tree the real run cannot mark is said here.
    if [ -w "$dir" ]; then
      printf '    would mark %s/%s\n' "$(_clean_shown "$dir")" "$_CLEAN_NEVER_INDEX"
    else
      printf '    could not mark %s -- it is not writable, so a real run will not either\n' "$(_clean_shown "$dir")"
    fi
    return 0
  fi
  if ! : >"$dir/$_CLEAN_NEVER_INDEX"; then
    warn "could not mark $(_clean_shown "$dir") -- Spotlight may go on indexing it"
    return 0
  fi
  printf '    marked   %s/%s\n' "$(_clean_shown "$dir")" "$_CLEAN_NEVER_INDEX"
  return 0
}

# _clean_size <dir> -- human size, or `?` when du cannot answer.
_clean_size() {
  local s
  s="$(du -sh "$1" 2>/dev/null | awk '{print $1; exit}')" || s=""
  printf '%s\n' "${s:-?}"
  return 0
}

# _clean_confirm <n> <what> -- ask on the TTY, or refuse. The question is asked
# through ask_person (lib/helpers), the one home for "is a person here" and for
# reading the answer from /dev/tty (issue 0089).
#
# NO TTY IS A REFUSAL, following `intent organize --force`, which refuses
# without one rather than prompting. The alternative was measured in the command
# this verb was compared against: `read -r reply` under `set -euo pipefail`
# aborts at EOF, so run non-interactively it neither removes nor prints its own
# "left alone" message. That is fail-safe by ACCIDENT, and an accident is not a
# contract.
_clean_confirm() {
  local n="$1" what="$2" rc=0
  ask_person "  proceed?" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1)
      printf 'left alone.\n'
      return 1
      ;;
    *)
      die "no tty: refusing to remove $n $what without confirmation.
       Pass --force to proceed non-interactively; it names what it removes."
      ;;
  esac
}

# _clean_partial <partial> -- when <partial> is 1, say that the scan could not
# read everything. Prints nothing otherwise, and always returns 0: the caller
# returns <partial> itself, so a partial run exits 1.
#
# IT SAYS NOTHING OF WHAT HAPPENS NEXT, only that the run exits 1. It said "what
# was found is handled as asked", which printed directly above a refusal said
# the opposite of the line under it (the critic's third review of 0131), and a
# `refusing` mode kept out of three of the refusals still reached the fourth,
# the no-tty one (its fourth). A line true of every outcome has no mode to
# forget.
#
# A PARTIAL CLEAN IS NOT A CLEAN (issue 0131, vc's ruling). What the scan found
# is still acted on as asked, since removing what it saw is the safe direction,
# but a zero would let `clean && build` build on trees nobody looked at: 0056's
# rule, that a scan which could not read everything exits non-zero. find's and
# grep's own errors, above, name each path. install and upgrade refuse outright
# over a partial vendored list (issue 0127), because vendoring or retiring from
# half a list is not safe; this acts first, because removing half is.
_clean_partial() {
  [ "$1" = 1 ] || return 0
  warn "THE SCAN WAS PARTIAL: something under $(_clean_shown "$PROJECT_ROOT") could not be read (the errors above name it), so a build tree beneath it may not have been seen."
  warn "  Make that path readable, or move it out of the project, and run again. This run exits 1, whatever it does with what it found."
  return 0
}

# _clean_verdict <nblocked> <force_blocked> <force> -- what a real run does with
# the trees it would remove, as one word: refuse-path, ask or remove. Pure.
#
# ONE DECISION, READ BY BOTH RUNS (the critic's fourth pass on 0131). "A real run
# would refuse over PATH" was tested at three sites -- the blocked branch, the
# choice of partial note, and the dry run's last line -- and fullcycle's own
# header warns against exactly that shape: one predicate in two places, failing
# in opposite directions. A partial scan under --refuse-partial is decided at
# the scan, before anything is listed, and never reaches here.
_clean_verdict() {
  if [ "$1" -gt 0 ] && [ "$2" = 0 ]; then
    printf 'refuse-path\n'
  elif [ "$3" = 0 ]; then
    printf 'ask\n'
  else
    printf 'remove\n'
  fi
}

# _clean_run <label> <name> <manifest> <markers> [args...] -- the whole body of
# one arm.
#
# One body for all three languages. They differ in the directory name, the
# manifest that proves rebuildability, and whether the toolchain marks its own
# trees: <markers> is `cargo` for the one that does, whose markers are searched
# for and whose release/ note is printed, and `none` for the two that do not.
# Each arm says which, once, where the body used to ask three times whether its
# directory was named `target` (the critic's review of 0131). Writing the body
# three times is the duplication this project exists to remove.
_clean_run() {
  local label="$1" name="$2" manifest="$3" markers="$4"
  # A POLICY THAT IS NOT ONE IS A DEVBIN DEFECT, said before `shift 4` takes the
  # user's first flag for it: an arm written the old way, with three words, had
  # its --force read as the policy and run (the critic's review of 0131).
  case "$markers" in
    cargo | none) ;;
    *) die "clean $label: _clean_run's <markers> must be cargo or none, not '$markers' -- a devbin defect" ;;
  esac
  shift 4

  # TWO CONSENTS, TWO FLAGS (issue 0047, hv's ruling: option 3, the split).
  #
  # `--force` used to be the only way past EITHER refusal, and they are not the
  # same question. The blocked-binaries refusal asks "do you accept these
  # binaries going dark". The removal prompt asks "do you accept deleting these
  # trees at all". An operator who needed the first was silently made to give
  # the second as well, and `fullcycle` is the caller that made this bite: its
  # contract INCLUDES the rebuild, so it can answer the first honestly and has
  # no business answering the second on anybody's behalf.
  #
  # `--force` still implies both, unchanged, because it is what every existing
  # caller and every piece of documentation says.
  #
  # AND A THIRD FLAG THAT GIVES NEITHER CONSENT (issue 0042, hv's ruling).
  # `clean` could tell you what it would remove, or remove it, but not the
  # first without a terminal: in CI, a script, or any non-interactive context
  # the only two reachable states were REFUSE and DELETE. The scan is the
  # valuable half and it was gated entirely behind a prompt.
  #
  # The spelling follows `fullcycle --dry-run`, which is in this tree already.
  # A second word for one idea in one runtime is how a reader learns to guess.
  local force=0 force_blocked=0 dry=0 refuse_partial=0 arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry=1 ;;
      --force) force=1 ; force_blocked=1 ;;
      --force-blocked) force_blocked=1 ;;
      --refuse-partial) refuse_partial=1 ;;
      *) die "clean $label: unknown argument '$arg' (only --dry-run, --force, --force-blocked and --refuse-partial are accepted)" ;;
    esac
  done

  cd "$PROJECT_ROOT" || die "cannot enter $PROJECT_ROOT"

  # BEFORE ANY SCANNING, AND IN THIS SHELL. See _clean_path_elements for why
  # a refusal raised inside the scan itself cannot stop the run.
  _clean_validate_path

  # ONE SCAN, FIVE OUTCOMES, ALL OF THEM PRINTED. The rejected sets are the
  # denominator: a skipped tree that prints nothing cannot be told from a tree
  # that was never there, and the caller reads the silence as coverage.
  #
  # IN THIS SHELL, INTO ARRAYS, WITH ITS STATUS (issues 0131 and 0141). Read
  # through a process substitution, a scan that could not read everything was
  # indistinguishable from one that read it all; carried as TAB-joined text, a
  # name ending in a TAB was listed, and would have been removed, as another
  # directory.
  #
  # 3 IS A PARTIAL SCAN AND ANYTHING ELSE IS A DEFECT (the critic's review of
  # 0131), and a defect stops the run before it acts on any of the scan.
  local -a dirs=() nomanifest=() notbuild=() unread=() inplace=()
  local d scan_rc=0 partial=0
  _clean_scan "$name" "$manifest" "$markers" dirs nomanifest notbuild unread inplace || scan_rc=$?
  case "$scan_rc" in
    0) ;;
    3) partial=1 ;;
    *) die "clean $label: the scan failed (status $scan_rc) -- a devbin defect; nothing was removed" ;;
  esac

  # --refuse-partial: A PARTIAL SCAN IS REFUSED BEFORE ANYTHING IS DONE, the
  # marks included (the critic's review of 0131). fullcycle passes it. Its clean
  # phase used to read a partial clean's exit 1 as a failed clean and stop before
  # the rebuild, having removed the trees -- a PATH binary resolving into one
  # went dark, where the clean before 0131 exited 0 and the cycle rebuilt. So the
  # cycle's clean refuses a partial scan outright, as issue 0127 has install and
  # upgrade do.
  #
  # A DRY RUN SAYS SO HERE, AT ONCE, AND STOPS, as the real run does (the
  # critic's third review of 0131). It went on to print the marks it would place,
  # and that what was found is handled as asked, and only then said that a real
  # run would refuse: one decision, made in one place, for both runs.
  if [ "$partial" = 1 ] && [ "$refuse_partial" = 1 ]; then
    _clean_partial 1
    if [ "$dry" = 1 ]; then
      printf '  --dry-run: nothing was removed or marked.\n'
      printf '  A real run would REFUSE: the scan is partial, and --refuse-partial was given.\n'
      return 1
    fi
    die "refusing, as --refuse-partial asks: the scan is partial, and nothing was removed or marked"
  fi

  # BUILT HERE, NOTHING BESIDE IT TO REBUILD FROM. Never removed -- a tree whose
  # manifest is gone is not a cache, it may be the only copy. Reported with its
  # size, because the commonest cause is a redirected CARGO_TARGET_DIR and the
  # commonest one on this estate was 33 GB.
  if [ "${#nomanifest[@]}" -gt 0 ]; then
    warn "${#nomanifest[@]} build tree(s) with NO $manifest beside them -- SKIPPED, not removed:"
    for d in "${nomanifest[@]}"; do
      printf '    skipped  %-8s %s (no sibling %s)\n' "$(_clean_size "$d")" "$(_clean_shown "$d")" "$manifest"
      _clean_mark "$d" "$dry"
    done
    printf '    A build tree whose manifest is gone cannot be regenerated, and a\n'
    printf '    redirected build dir has no manifest beside it either. Look before\n'
    printf '    removing these by hand.\n\n'
  fi

  # A CRATE HOLDING A BUILD'S MARKERS IN ITSELF (issue 0141): built with
  # `--target-dir .` or `CARGO_TARGET_DIR=.`, or the project root. It is the
  # crate, sources and all, so it is never removed or marked; the trees beneath
  # it are still scanned (_clean_roots). No size: it would be the whole crate's.
  if [ "${#inplace[@]}" -gt 0 ]; then
    local inoun=directories why
    [ "${#inplace[@]}" -eq 1 ] && inoun=directory
    warn "${#inplace[@]} $inoun holding a build's markers in itself -- built in place, not removed:"
    for d in "${inplace[@]}"; do
      why="holds its own $manifest"
      [ "$d" != "${PROJECT_ROOT%/}" ] || why="the project root"
      printf '    in place %s (%s)\n' "$(_clean_shown "$d")" "$why"
    done
    printf '    A build that wrote into the directory it builds mixed its output with\n'
    printf '    the sources, so there is no tree to remove. Remove that output by hand.\n\n'
  fi

  # NAMED LIKE A BUILD TREE, CARRYING NO BUILD OUTPUT. Xcode's PIF caches under
  # *.noindex are the measured case. Reported so the rejection is visible rather
  # than being a silent name test.
  if [ "${#notbuild[@]}" -gt 0 ]; then
    local noun=directories
    [ "${#notbuild[@]}" -eq 1 ] && noun=directory
    printf '    %s %s named like a build tree with no build markers -- not touched:\n' "${#notbuild[@]}" "$noun"
    for d in "${notbuild[@]}"; do
      printf '    ignored  %-8s %s\n' "$(_clean_size "$d")" "$(_clean_shown "$d")"
    done
    printf '\n'
  fi

  # A CANDIDATE THAT COULD NOT BE READ (the critic's third review of 0131): not a
  # tree, and not one, so listed apart and never touched, and the scan is
  # partial. _clean_has_markers has named what it could not read.
  if [ "${#unread[@]}" -gt 0 ]; then
    local unoun=directories
    [ "${#unread[@]}" -eq 1 ] && unoun=directory
    printf '    %s candidate %s could not be read -- not classified, not touched:\n' "${#unread[@]}" "$unoun"
    for d in "${unread[@]}"; do
      printf '    unread   %-8s %s\n' "$(_clean_size "$d")" "$(_clean_shown "$d")"
    done
    printf '\n'
  fi

  # A DETERMINATE ZERO REPORTS AND PASSES. Nothing to remove is a fact about the
  # project, not a run that went wrong -- the same rule check format follows.
  # A zero over a partial scan is not determinate, and exits 1.
  if [ "${#dirs[@]}" -eq 0 ]; then
    printf '    no removable %s/ trees (%s alongside a %s)\n' "$name" "$name" "$manifest"
    _clean_partial "$partial"
    return "$partial"
  fi

  # THE LIVE-PATH REFUSAL, BEFORE ANYTHING IS REMOVED AND BEFORE THE PROMPT.
  local -a blocked=()
  local live
  for d in "${dirs[@]}"; do
    live="$(_clean_live_binaries "$d")"
    [ -n "$live" ] && blocked+=("$(_clean_shown "$d")"$'\n'"$live")
  done

  local verdict
  verdict="$(_clean_verdict "${#blocked[@]}" "$force_blocked" "$force")"
  # KNOWN BEFORE ANYTHING READS IT (the critic's sixth pass): the PATH
  # refusal below reads it two ways, and an unknown word printed "a real run
  # would PROCEED" there before a later reader died.
  case "$verdict" in
    refuse-path | ask | remove) ;;
    *) die "clean $label: an unknown verdict '$verdict' -- a devbin defect; nothing was removed" ;;
  esac

  if [ "${#blocked[@]}" -gt 0 ]; then
    local b
    for b in "${blocked[@]}"; do
      warn "PATH resolves into ${b%%$'\n'*}:"
      printf '%s\n' "${b#*$'\n'}" | sed 's/^/      /'
    done
    if [ "$verdict" = refuse-path ]; then
      # A DRY RUN REPORTS THE REFUSAL RATHER THAN PERFORMING IT. Dying here
      # would make `--dry-run` unable to answer the one question it exists for
      # on exactly the trees where the answer matters most -- and it would exit
      # non-zero, which a caller reads as "the scan failed".
      if [ "$dry" = 1 ]; then
        warn "a real run would REFUSE here: these binaries would go dark, machine-wide."
        warn "  --force-blocked accepts THAT risk alone and still asks before removing."
        warn "  --force accepts it and skips the asking."
      else
        _clean_partial "$partial"
        die "refusing: removing these trees would darken the binaries listed above, machine-wide.
       Rebuild and re-point them first, or pass --force to proceed knowing what goes dark.
       --force-blocked accepts THIS risk alone and still asks before removing."
      fi
    elif [ "$dry" = 1 ]; then
      warn "a real run would PROCEED. THE BINARIES LISTED ABOVE WOULD STOP RESOLVING until rebuilt."
    else
      warn "proceeding anyway. THE BINARIES LISTED ABOVE WILL STOP RESOLVING until rebuilt."
    fi
  fi

  printf '  %s: %s %s tree(s)\n\n' "$label" "${#dirs[@]}" "$name"
  local peer total_note=""
  local -a peers=()
  for d in "${dirs[@]}"; do
    printf '    %-8s %s\n' "$(_clean_size "$d")" "$(_clean_shown "$d")"
    peers=()
    _clean_peer_dirs "$d" peers
    if [ "${#peers[@]}" -gt 0 ]; then
      # NAME THE PEERS AND WHOSE THEY ARE. Removing the parent takes every
      # node's cache with it, and a moniker in a list is what lets someone
      # mid-build recognise their own.
      for peer in "${peers[@]}"; do
        printf '             per-node: %s (%s)\n' "$(_clean_shown "$d/$peer")" "$(_clean_size "$d/$peer")"
      done
      total_note="yes"
    fi
  done

  if [ -n "$total_note" ]; then
    printf '\n'
    warn "THIS TREE IS SHARED. The per-node directories above are target dirs of their own --"
    warn "another session's CARGO_TARGET_DIR, or a tool's -- and removing the parent costs"
    warn "each of them a full rebuild. Announce it first."
  fi

  # CARGO'S ARM ONLY (issue 0131). `_build` and `.build` have no release/, and
  # the elixir and swift arms printed this about trees that do not have one.
  if [ "$markers" = cargo ]; then
    printf '\n  This takes release/ as well as debug/ -- that is what makes it a release\n'
    printf '  verb rather than a cache sweep. The next build is cold.\n\n'
  else
    printf '\n'
  fi

  # SAID BEFORE ANYTHING IS ASKED OR REMOVED, so the consent is given knowing
  # the list is partial.
  _clean_partial "$partial"

  # THE PREVIEW STOPS HERE, HAVING PRINTED EVERYTHING AND CHANGED NOTHING OUTSIDE
  # tmp/clean/, where the gate keeps every run's log, and it names which of the
  # three states a real run would reach. A dry run that said only "nothing was
  # removed" would answer the easy half of the question and leave the asked half
  # -- would this have worked? -- unanswered. A partial scan under
  # --refuse-partial never reaches here: it stopped at the scan, above.
  if [ "$dry" = 1 ]; then
    printf '  --dry-run: nothing was removed.\n'
    case "$verdict" in
      refuse-path) printf '  A real run would REFUSE: PATH resolves into the tree(s) above.\n' ;;
      ask)
        printf '  A real run would ask on the tty before removing %s tree(s), and refuse without one.\n' \
          "${#dirs[@]}"
        ;;
      remove) printf '  A real run would remove %s tree(s) without asking.\n' "${#dirs[@]}" ;;
    esac
    return "$partial"
  fi

  # ONLY ask AND remove GO ON TO THE REMOVAL (the critic's fifth pass). This
  # keyed on --force; keyed on the verdict with an else, any word but `ask`
  # would remove without asking, so the PATH refusal's die would have had
  # nothing behind it. Any other verdict here, the refusal included, is a
  # devbin defect and removes nothing -- and so is a reader missing an arm,
  # which without this default fell through to the removal (mutant M9).
  case "$verdict" in
    ask) _clean_confirm "${#dirs[@]}" "$name tree(s)" || return "$partial" ;;
    remove) printf '  --force: no confirmation asked.\n' ;;
    *) die "clean $label: verdict '$verdict' reached the removal -- a devbin defect; nothing was removed" ;;
  esac

  local removed=0
  for d in "${dirs[@]}"; do
    rm -rf "$d" || die "could not remove $(_clean_shown "$d")"
    printf '    removed  %s\n' "$(_clean_shown "$d")"
    removed=$((removed + 1))
  done
  printf '\n  %s %s tree(s) removed.\n' "$removed" "$name"
  [ "$partial" = 0 ] || printf '  The scan was partial (above), so this run exits 1.\n'
  return "$partial"
}

# ---------------------------------------------------------------------------
# The arms
# ---------------------------------------------------------------------------

builtin_clean_rust() { _clean_run rust target Cargo.toml cargo "$@"; }

# THE SOURCES UNDER `deps/` ARE LEFT ALONE, DELIBERATELY. They are a download,
# not a build product: removing them costs a network fetch rather than a
# recompile, and a fetch is the one part of a rebuild that can fail while
# offline. A dependency's own `_build`, beside its mix.exs under deps/, IS
# removed, as a build product like any other; this comment and the catalogue
# said "deps/ is left alone" until issue 0131.
builtin_clean_elixir() { _clean_run elixir _build mix.exs none "$@"; }

builtin_clean_swift() { _clean_run swift .build Package.swift none "$@"; }

run_builtin_gate clean "$@"
