#!/usr/bin/env bash
#
#
# `infra profiles` -- ONE DOMAIN, ONE PROFILE, ACROSS A DIRECTORY OF THEM.
#
# THE GAP THIS CLOSES, reported by a consumer on 2026-09-07 from the first real
# multi-profile estate. `infra_validate_profile` enforces one-entry-per-domain
# WITHIN a file, for a stated reason: two handles on one FQDN can carry
# contradictory expectations that `check` evaluates against the same live
# records, so one goes green and one goes red on the same domain and ordering
# decides which the operator reads.
#
# THAT REASON DOES NOT STOP AT THE FILE BOUNDARY. An estate laid out as
# `profiles/<name>/infra.yaml` can have two profiles claiming one domain, with
# exactly the same consequence and nothing at all reporting it -- the drift
# class this whole thread exists to detect, newly reachable and unowned. It
# lives here rather than as a script in the estate repo, because a checker
# written beside the data it checks is a second implementation of the rule.
#
# AN EMPTY POPULATION IS AN ERROR, NOT A PASS. A directory with no profiles in
# it produces "0 profiles, no collisions", which is the shape of every false
# green this repository has a name for. Finding nothing means the argument was
# wrong, not that the estate is clean.
#
set -euo pipefail

: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
# shellcheck source=lib/helpers
. "$DEVBIN_LIB/helpers"
# shellcheck source=lib/config
. "$DEVBIN_LIB/config"
# shellcheck source=lib/infra
. "$DEVBIN_LIB/infra"

usage() {
  cat <<USAGE
usage: ${DEVBIN_INVOKE:-bin/devbin} infra profiles <dir>

Validate every infra.yaml under <dir> and refuse a domain claimed by more than
one profile. Searches three levels down, so profiles/<name>/infra.yaml is found.

A directory holding no profiles is an ERROR: nothing found means the path was
wrong, and reporting it as "no collisions" would be a green over an empty set.
USAGE
}

# ASKING FOR HELP AND FORGETTING THE ARGUMENT ARE DIFFERENT EVENTS, and
# collapsing them is why this exited 0 on a missing directory until 2026-09-07.
# This verb's whole argument is that an empty population is an ERROR -- "0
# profiles, no collisions" is the shape of every false green this repository has
# a name for -- and a caller who omitted the argument got usage text and a
# success code, which is that same false green one level up, in the command
# written to refuse it. Reported by lamplight-dc.
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  '')
    usage >&2
    die "infra profiles: no directory given. Nothing was compared."
    ;;
esac

dir="$1"
[ -d "$dir" ] || die "infra profiles: not a directory: $dir"

# READ WHOLE, WITH ITS STATUS, AND REFUSED WHEN FIND COULD NOT READ EVERYTHING
# (issue 0139). The listing sat in the loop's heredoc with find's errors sent to
# /dev/null, so a profile beneath a directory find could not read was never
# compared, and the run said no domain was claimed twice -- the one verdict this
# verb exists to give, given over part of the estate. find's own error names
# the directory.
listing="$(find_walk "$dir" -maxdepth 3 -name 'infra.yaml' -type f -print)" ||
  die "infra profiles: could not read all of $dir (the error above names it) -- a profile it could not see was compared with nothing, so there is no verdict"

# A SUBSHELL PER PROFILE. `cfg_load` populates process-global state, so reading
# two profiles in one shell risks the second inheriting keys from the first --
# and a domain leaking between profiles is precisely the fault being looked for,
# which would make the instrument manufacture its own positives.
pairs=""
count=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  count=$((count + 1))
  # AND EACH IS VALIDATED, as the usage has always said (issue 0121: it only
  # loaded them). A profile `show` would refuse is no basis for a comparison, so
  # its own errors print, the file is named, and the run stops. `check`'s gate
  # on `unreviewed:` is not validation and is not applied: a deviation awaiting
  # review changes no domain's claim.
  # What validation says is printed UNDER the file it is about -- a warning as
  # well as an error, since a directory of profiles otherwise gets advice naming
  # a handle and no file.
  out="$(
    cfg_load "$f" >/dev/null ||
      die "infra profiles: $f does not load (above) -- fix it before comparing it to anything"
    _DEVBIN_INFRA_FILE="$f"
    vrc=0
    said="$(infra_validate_profile 2>&1)" || vrc=$?
    [ -z "$said" ] || printf '%s:\n%s\n' "$f" "$said" >&2
    [ "$vrc" -eq 0 ] ||
      die "infra profiles: $f does not validate (above) -- fix it before comparing it to anything"
    infra_domain_pairs
  )" || exit 1
  while IFS="$(printf '\t')" read -r handle fqdn; do
    [ -n "${fqdn:-}" ] || continue
    pairs="$pairs$fqdn	$f	$handle
"
  done <<<"$out"
done <<EOF
$(printf '%s\n' "$listing" | LC_ALL=C sort)
EOF

[ "$count" -gt 0 ] ||
  die "infra profiles: no infra.yaml found under $dir
       Nothing found is a wrong path, not a clean estate."

# THE INPUT IS SORTED, NOT THE OUTPUT. Sorting awk's output re-orders LINES,
# and each record here is several lines -- which put the "claimed by 2 profiles"
# header BELOW the profiles it introduces. Caught on the first red drive.
dupes="$(printf '%s' "$pairs" | LC_ALL=C sort | awk -F'\t' '
  NF >= 3 { seen[$1] = seen[$1] "\n    " $2 " (as " $3 ")"; if (!($1 in n)) order[++k] = $1; n[$1]++ }
  END { for (i = 1; i <= k; i++) { d = order[i]; if (n[d] > 1) printf "  %s claimed by %d profiles:%s\n", d, n[d], seen[d] } }
')"

if [ -n "$dupes" ]; then
  # SC2016 disabled for the block, matching lib/infra and the release renderers:
  # the message names a COMMAND, and the delimiter this project writes one in is
  # the backtick. Single quotes are correct precisely because it must not expand.
  # shellcheck disable=SC2016
  {
    printf 'infra profiles: a domain is claimed by more than one profile.\n\n'
    printf '%s\n' "$dupes"
    printf '\nTwo profiles on one FQDN can carry contradictory expectations that\n'
    printf '`check` evaluates against the same live records, so one goes green and\n'
    printf 'one goes red on the same domain and ordering decides which you read.\n'
  } >&2
  exit 1
fi

printf 'infra profiles: %s profile(s) under %s, no domain claimed twice.\n' "$count" "$dir"
