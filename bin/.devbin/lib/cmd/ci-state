#!/usr/bin/env bash
#
# The built-in `ci-state` (ST0011 WP-03): CI's verdict on one commit, read
# through gh, as ONE line on stdout, `<verdict><TAB><detail>`, the verdict one
# of green, failed, pending, none or unknown.
#
#   ci-state <sha>   the verdict of the runs of the project's CI workflow on <sha>
#
# IT IS A ci.query AS IT STANDS (lib/release.steps, release_ci_verdict): the
# release core runs `<query> <sha>` with no stdin, with a cut's candidate
# branch in DEVBIN_RELEASE_TAG, and reads the first line, whose first word is
# one of these five. It exits 0 whenever
# it answered, whatever the verdict, and 1 on a usage error or a config it
# cannot read, which the core reads as unknown. The sha is a full one, as the
# core always passes: gh matches a run's commit by its whole sha, so a short
# one or a branch name would read as no run. It replaces the readers projects
# kept as their own ci.query, which disagreed about which runs count and whose
# verdict a run's is.
#
# THE SETTINGS ARE FACTS IN CONFIG, read once (cistate_settings):
#
#   release.repo         the repository, OWNER/NAME; read off the remote a
#                        release pushes to first when not declared (release_repo)
#   release.ci.workflow  the workflow file, under .github/workflows/, whose runs
#                        are the verdict; default tests.yml
#   release.ci.summary   the job whose verdict is its run's; default none, and
#                        then the run's own conclusion is
#
# WITH A REF, ONLY THAT REF'S RUNS COUNT, `none` until one exists (issue 0149).
# DEVBIN_RELEASE_TAG names it, and is matched against each run's head branch,
# which for a tag's push is the tag and for a branch's push the branch: so the
# release tag counts the tag's runs alone, and the candidate a release pushes,
# candidate/<tag>, its own (issue 0240). A branch push of main on the same sha
# carries fewer legs than either, so its green is no verdict on the release.
#
# WITHOUT ONE, a sha with no run of its own is read on the commit before it,
# while each commit between changes only what the workflow's push trigger
# ignores (cistate_walk). A push that moves only coordination state starts no
# run (issue 0110), so a release's base is often a board commit, and CI's run on
# the commit before it read exactly the files that commit holds. The push
# trigger's paths-ignore is read from the workflow AS COMMITTED at the asked sha,
# never the working tree's copy, and an entry that is not a directory's whole
# tree (`<dir>/**`), or a list written inline, is unknown rather than read as
# something else. A run on the coordination commit itself, from a push that
# carried code with it, is that commit's verdict, and the walk stops there.
#
# A RUN'S VERDICT, with release.ci.summary, is that job's, found by its name,
# not the run's conclusion: a workflow whose summary does not wait for a leg
# that blocks nothing (devbin's WSL leg) reads green when that leg alone is red.
# A summary absent, skipped, cancelled or still going is not green: a finished
# run with none is failed, naming that. With no summary declared, the run's own
# status and conclusion are its verdict. AMONG SEVERAL RUNS ON ONE SHA the
# worst decides (cistate_rank): failed (any conclusion but success, a cancelled
# one included) over one still going over green.
#
# IT NEVER GUESSES. Every gh call goes through release_gh, the core's one door
# to gh. A gh that is not installed, a call that fails, a list as long as the
# limit it was given, and a git that cannot answer about a commit the walk
# reached are each unknown, carrying the words of what failed: a verdict nobody
# could read, recorded as anything else, is a pass nobody measured. A commit
# this repository does not hold, as a publish's snapshot is not, is none: CI
# may yet run there, and no commit before it is read. No call is bounded here:
# the core bounds the whole query (release_wait), as it bounds every reader it
# asks.
#
# A FAILED VERDICT NAMES ITS FAILED JOBS, inside its parenthesis:
# `run <id> (<conclusion>; failed jobs: <name>, <name>)`, naming each job that
# finished in anything but success, skipped or neutral; `no job ran` when none
# ran; `no job failed` when jobs ran and none failed, as when the run failed
# around them. The jobs are those the summary was found among, or with no
# summary declared the deciding run's, read once. A job list gh cannot give is
# said in the same place, and the verdict stays failed, which the run's own
# record already is.
#
# THE TRIGGER, `ci-state --fires <ref> <sha> [<path>...]`: whether a push of
# the branch <ref> starts the workflow, read from release.ci.workflow as
# committed at <sha>, as one line `<word><TAB><reason>`, exit 0 whenever it
# answered. <path>... are the files the push's commit changes, which a push
# trigger's paths and paths-ignore filters are read against. It answers for the
# release core whether the candidate ref a cut will push starts the workflow,
# before the cut starts. The words:
#
#   fires    a push of <ref> starts the workflow
#   quiet    it does not: no push trigger, a branches list nothing of which
#            matches <ref>, a branches-ignore entry that does, tags alone, or,
#            with <path>... given, a paths list matching none of them or a
#            paths-ignore leaving none of them out
#   missing  the tree at <sha> holds no such workflow file
#   unknown  a trigger written in a form this does not read, a push trigger
#            filtering by paths: with no <path> given, a release.ci.query
#            that is not this built-in, `-` among them, or a git that cannot
#            answer
#
# The push trigger is read once, by cistate_push_read, for the walk and for
# --fires alike, and its patterns are matched as GitHub matches them there. A
# shape it does not read in the on: and push: structure, or in paths-ignore,
# stops both; one under another filter is unknown for --fires, and the walk
# reads on. With no <path> given, a paths-ignore is read as the walk reads it,
# whole directories (<dir>/**) leaving the answer to the branch filter, and a
# fires answer names the premise it rests on: the release commit's files sit
# outside the ignored trees.
#
# WHAT fires DOES NOT READ, declared: a pushed commit whose message carries a
# skip marker such as [skip ci] starts no run whatever the trigger says, which
# config refuses where a release writes the message (release.tag, filled, and
# release.snapshot.message, filled with project.name), and the workflow file
# can be disabled on GitHub.
# In a publish the candidate holds the snapshot, which another repository
# builds: its caller asks at the release commit, once it has checked that the
# snapshot carries that commit's workflow unchanged, with the files the
# snapshot commit changes. A candidate that starts no run all the same ends the
# cut's wait with no verdict and nothing public.
#
set -euo pipefail

: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
# shellcheck source=lib/helpers
. "$DEVBIN_LIB/helpers"
# shellcheck source=lib/config
# The release: block: the dispatcher's config cache does not cross into a
# handler's process.
. "$DEVBIN_LIB/config"
# shellcheck source=lib/release.notes
. "$DEVBIN_LIB/release.notes"
# shellcheck source=lib/release.steps
# release_repo, the repository gh is told about, and release_gh, every gh call.
. "$DEVBIN_LIB/release.steps"

# The settings, read once by cistate_settings, and the file gh's and git's
# words land in, a global so the exit trap can read it from wherever the script
# exits.
CS_REPO="" CS_WORKFLOW="" CS_SUMMARY="" CS_ERR=""

# How many runs on one commit gh is asked for: release_read_assets_run's limit,
# and a list as long as it is refused, since the worst run could be one left
# out.
CS_LIMIT=200

usage() {
  cat <<EOF
usage: $DEVBIN_INVOKE ci-state <sha>
       $DEVBIN_INVOKE ci-state --fires <ref> <sha> [<path>...]

  <sha>          the full sha of the commit CI's verdict is read for: one line,
                 <verdict><TAB><detail>, the verdict green, failed, pending,
                 none or unknown. With DEVBIN_RELEASE_TAG set, only the runs of
                 that tag, or of that branch, count. The runs are
                 release.ci.workflow's (default tests.yml), and a run's verdict
                 is release.ci.summary's job, or the run's own conclusion when
                 none is declared; a failed one names its failed jobs
  --fires <ref>  whether a push of the branch <ref> starts release.ci.workflow,
                 as committed at <sha>: one line, <word><TAB><reason>, the word
                 fires, quiet, missing or unknown; <path>... are the files the
                 pushed commit changes, read against paths and paths-ignore
EOF
}

# cistate_say <verdict> <detail> -- the answer line, the detail on one line.
cistate_say() {
  printf '%s\t%s\n' "$1" "${2//$'\n'/ }"
}

# cistate_err -- the first line gh or git wrote to CS_ERR, for an answer's detail.
cistate_err() {
  local line=""
  # read returns 1 at the end of the file with what it read kept in line, when
  # the words end with no newline or there are none; either is an answer here.
  IFS= read -r line <"$CS_ERR" || true
  printf '%s' "${line:-it said nothing}"
}

# cistate_workflow_path -- the workflow file, from the project root.
cistate_workflow_path() {
  printf '.github/workflows/%s\n' "$CS_WORKFLOW"
}

# cistate_runs <sha> -- the workflow's runs gh lists on <sha>, one
# `<id><TAB><headBranch><TAB><status><TAB><conclusion>` a line. The conclusion
# is last because it is empty while a run is going, and read splits a run of
# tabs as one. A head branch GitHub's record holds as null is `-`, which the
# reader makes empty again (dash_to_empty): @tsv writes null as an empty field,
# and read would have shifted the status into its place.
cistate_runs() {
  release_gh "$CS_REPO" run list --workflow "$CS_WORKFLOW" --commit "$1" --limit "$CS_LIMIT" \
    --json databaseId,headBranch,status,conclusion \
    --jq '.[] | [(.databaseId | tostring), (.headBranch // "-"), .status, .conclusion] | @tsv'
}

# cistate_jobs <id> -- each job of run <id>, one
# `<name><TAB><status><TAB><conclusion>` a line, the conclusion empty while a
# job is going. Returns 1, gh's words on stderr, when they cannot be read.
cistate_jobs() {
  release_gh "$CS_REPO" run view "$1" --json jobs \
    --jq '.jobs[] | [.name, .status, .conclusion] | @tsv'
}

# cistate_summary_in <jobs> -- `<status><TAB><conclusion>` of the job named
# release.ci.summary in <jobs> (cistate_jobs), the first of that name; nothing
# when it has none. The name is matched here, never written into gh's jq
# program, so a name holding a quote is compared as text rather than run as
# jq. Pure.
cistate_summary_in() {
  local name st con
  while IFS=$'\t' read -r name st con; do
    if [ "$name" = "$CS_SUMMARY" ]; then
      printf '%s\t%s\n' "$st" "$con"
      return 0
    fi
  done <<<"$1"
  return 0
}

# cistate_rows <runs> <ref> -- each run of <runs> that counts, <ref>'s alone
# when <ref> is given, as
# `<id><TAB><status><TAB><kind><TAB><jobs><TAB><conclusion>`, the conclusion
# last since it can be empty and read splits a run of tabs as one: <kind> is
# `summary` when the status and conclusion are the summary job's, `run` when
# they are the run's own, and `nosummary` for a finished run with no summary
# job; <jobs> is what a failed verdict would say of the run's jobs
# (cistate_failed_jobs), read from the one job list the summary was found in,
# or `-` when no job list was read. Returns 1, gh's words on stderr, when a
# run's jobs cannot be read.
cistate_rows() {
  local ref="$2" id head st con jobs job fj jst jcon
  while IFS=$'\t' read -r id head st con; do
    [ -n "$id" ] || continue
    dash_to_empty head
    [ -z "$ref" ] || [ "$head" = "$ref" ] || continue
    if [ -z "$CS_SUMMARY" ]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$st" run - "$con"
      continue
    fi
    jobs="$(cistate_jobs "$id")" || return 1
    job="$(cistate_summary_in "$jobs")"
    fj="$(cistate_failed_jobs <<<"$jobs")"
    if [ -n "$job" ]; then
      IFS=$'\t' read -r jst jcon <<<"$job"
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$jst" summary "$fj" "$jcon"
    elif [ "$st" = completed ]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$st" nosummary "$fj" ""
    else
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$st" run "$fj" "$con"
    fi
  done <<<"$1"
  return 0
}

# cistate_rank <summary> -- the worst of the rows on stdin (cistate_rows) as
# `<id><TAB><jobs><TAB><verdict><TAB><detail>`: the answer line after the id
# and the jobs field of the run that decides it, <summary> naming the job a
# `summary` row's state is; nothing for no rows. Failed over pending over
# green, the first of a rank kept. Pure.
cistate_rank() {
  local id st kind fj con by r v rank=0 best=""
  while IFS=$'\t' read -r id st kind fj con; do
    [ -n "$id" ] || continue
    by=""
    [ "$kind" != summary ] || by="$1: "
    if [ "$kind" = nosummary ]; then
      r=3
      v="$(printf 'failed\trun %s (no %s job)' "$id" "$1")"
    elif [ "$st" != completed ]; then
      r=2
      v="$(printf 'pending\trun %s (%s%s)' "$id" "$by" "$st")"
    elif [ "$con" = success ]; then
      r=1
      v="$(printf 'green\trun %s' "$id")"
    else
      r=3
      v="$(printf 'failed\trun %s (%s%s)' "$id" "$by" "${con:-no conclusion}")"
    fi
    if [ "$r" -gt "$rank" ]; then
      rank="$r"
      best="$id"$'\t'"$fj"$'\t'"$v"
    fi
  done
  printf '%s' "$best"
}

# cistate_failed_jobs -- what a failed run's detail says of its jobs, given on
# stdin as cistate_jobs lists them: `failed jobs: <name>, <name>` naming each
# that finished in anything but success, skipped or neutral; `no job ran` when
# none ran, none being listed or each skipped; `no job failed` when jobs ran and
# none failed, as when the run failed around them. Pure.
cistate_failed_jobs() {
  local name st con failed="" ran=no
  while IFS=$'\t' read -r name st con; do
    [ -n "$name" ] || continue
    [ "$con" != skipped ] || continue
    ran=yes
    [ "$st" = completed ] || continue
    case "$con" in
      success | neutral) ;;
      *) failed+="${failed:+, }$name" ;;
    esac
  done
  if [ -n "$failed" ]; then
    printf 'failed jobs: %s' "$failed"
  elif [ "$ran" = yes ]; then
    printf 'no job failed'
  else
    printf 'no job ran'
  fi
}

# cistate_verdict_on <sha> <ref> -- the answer line for the runs on <sha>, or
# nothing when no run counts; a failed one's detail names the deciding run's
# failed jobs (cistate_failed_jobs) inside its parenthesis, from the job list
# cistate_rows read when a summary is declared, else read here, once. Returns
# 1, the answer line `unknown` printed, when the runs cannot be read whole.
cistate_verdict_on() {
  local out rows n best id fj v jobs
  if ! out="$(cistate_runs "$1" 2>"$CS_ERR")"; then
    cistate_say unknown "gh run list failed for ${1:0:12}: $(cistate_err)"
    return 1
  fi
  n="$(grep -c . <<<"$out")" || n=0
  if [ "$n" -ge "$CS_LIMIT" ]; then
    cistate_say unknown "gh lists $n runs of $CS_WORKFLOW on ${1:0:12}, as many as it was asked for, so the worst of them cannot be told"
    return 1
  fi
  if ! rows="$(cistate_rows "$out" "$2" 2>"$CS_ERR")"; then
    cistate_say unknown "gh run view failed for ${1:0:12}: $(cistate_err)"
    return 1
  fi
  best="$(cistate_rank "$CS_SUMMARY" <<<"$rows")"
  [ -n "$best" ] || return 0
  id="${best%%$'\t'*}"
  best="${best#*$'\t'}"
  fj="${best%%$'\t'*}"
  v="${best#*$'\t'}"
  if [ "${v%%$'\t'*}" = failed ]; then
    dash_to_empty fj
    if [ -z "$fj" ]; then
      if jobs="$(cistate_jobs "$id" 2>"$CS_ERR")"; then
        fj="$(cistate_failed_jobs <<<"$jobs")"
      else
        fj="its jobs could not be read: $(cistate_err)"
      fi
    fi
    # A failed detail ends in its parenthesis; the jobs go inside it, so a
    # clause the walk adds after it reads apart from the list.
    v="${v%)}; $fj)"
  fi
  printf '%s' "$v"
}

# cistate_ignored_prefixes <entries> -- each entry as the directory it ignores,
# `intent/whiteboard/` for `intent/whiteboard/**`, one a line; returns 1 naming
# an entry of any other shape, a directory named by a pattern among them. Pure.
cistate_ignored_prefixes() {
  local e d found=""
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    case "$e" in
      '<inline>')
        printf "%s's push paths-ignore is written inline, which this query does not read -- write it as a block list, one entry a line" "$(cistate_workflow_path)"
        return 1
        ;;
      */\*\*)
        d="${e%\*\*}"
        case "$d" in
          *[\*\?\[+!\\]*) ;;
          *)
            found+="$d"$'\n'
            continue
            ;;
        esac
        ;;
    esac
    printf "%s's paths-ignore entry '%s' is not a directory's whole tree (<dir>/**), which is all this query reads" "$(cistate_workflow_path)" "$e"
    return 1
  done <<<"$1"
  printf '%s' "$found"
  return 0
}

# cistate_push_read <ref> [<path>...] -- the push trigger of the workflow on
# stdin, read once, as lines: `ignore<TAB><entry>` for each paths-ignore entry
# in order (`ignore<TAB><inline>` for a list written on its key's line), then
# one last line, `answer<TAB><word><TAB><reason>`, whether a push of the branch
# <ref> changing the files <path>... starts the workflow (fires, quiet or
# unknown), or `unread<TAB><reason>` when the trigger is written in a shape
# this does not read. The walk reads its paths-ignore here and --fires its
# answer, so the two never read the push block apart.
#
# It reads the top-level on: key as one word, a list on its line, a block list
# or a map; under the map, the events at one indent, and under push: its
# branches, branches-ignore, tags, tags-ignore, paths and paths-ignore keys,
# each a list on its line, a block list or one word. At the events' and the
# filters' indent only a `- ` item or a plain key line is read, and an item is
# read only plain or simply quoted. Anything else -- an anchor, alias, tag or
# explicit key, a map written on one line, a list running past its line, a
# quoted item holding an escape, an indent it cannot place -- is unread,
# naming it, and never read as anything else.
#
# A pattern is turned into an ERE as GitHub reads it (glob, below): * within a
# path segment, ** across them, **/ as any number of directories, none
# included, ? and + after the character they repeat, a [] of letters, digits
# and ascending ranges of them, any other character literal; the entries are
# matched in order, a ! entry excluding what an entry before it matched and
# the last match deciding. A pattern it cannot turn is unknown. The branches
# decide a branch push; with <path>... given, paths: must match one of them
# and paths-ignore must leave one of them out, or the push starts no run; with
# none given, paths: is unknown and paths-ignore is left to the caller. The
# awk program holds no single quote, since the shell's quoting ends at one.
# Pure.
cistate_push_read() {
  local ref="$1" paths=""
  shift
  [ "$#" -eq 0 ] || paths="$(printf '%s\n' "$@")"
  CS_PUSH_PATHS="$paths" LC_ALL=C awk -v ref="$ref" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function nocomment(s) { sub(/[ \t]+#.*$/, "", s); return s }
    function unq(s) {
      if (length(s) >= 2 && (s ~ /^".*"$/ || s ~ /^\047.*\047$/)) s = substr(s, 2, length(s) - 2)
      return s
    }
    function valueof(s) { s = nocomment(s); sub(/^[^:]*:[ \t]*/, "", s); return trim(s) }
    function keyof(s) { sub(/[ \t]*:.*$/, "", s); return unq(trim(s)) }
    function plainkey(s) { return s ~ /^["\047]?[A-Za-z][A-Za-z_-]*["\047]?[ \t]*:([ \t]|$)/ }
    function cannot(why) { if (bad == "") bad = why }
    function vaguely(why) { if (vague == "") vague = why }
    function fail(k, why) { if (k == "on" || k == "push" || k == "paths-ignore") cannot(why); else vaguely(why) }
    function add(k, e) {
      if (k == "on") { if (e == "push") haspush = 1 }
      else if (k == "branches") br[++nbr] = e
      else if (k == "branches-ignore") bi[++nbi] = e
      else if (k == "paths") pa[++npa] = e
      else if (k == "paths-ignore") pi[++npi] = e
    }
    function item(k, raw,   inner) {
      raw = trim(raw)
      if (raw ~ /^[[&*!|>{%@`]/) { fail(k, "its " k " entry " raw " is written in a form this does not read"); return }
      if (raw ~ /^\047/ || raw ~ /^"/) {
        inner = substr(raw, 2, length(raw) - 2)
        if (length(raw) < 2 || substr(raw, length(raw), 1) != substr(raw, 1, 1) || index(inner, "\047") > 0 || index(inner, "\"") > 0 || index(inner, "\\") > 0) {
          fail(k, "its " k " entry " raw " is quoted in a form this does not read")
          return
        }
      }
      add(k, unq(raw))
    }
    function flow(k, v,   inner, n, parts, i) {
      if (v !~ /\]$/) { fail(k, "its " k " list runs past its line, which this does not read"); return }
      inner = substr(v, 2, length(v) - 2)
      n = split(inner, parts, ",")
      for (i = 1; i <= n; i++) if (trim(parts[i]) != "") item(k, parts[i])
    }
    function brackets(b,   k, n, c1, c2) {
      n = length(b)
      if (n == 0) return 0
      for (k = 1; k <= n; k++) {
        c1 = substr(b, k, 1)
        if (c1 !~ /^[A-Za-z0-9]$/) return 0
        if (substr(b, k + 1, 1) == "-" && k + 2 <= n) {
          c2 = substr(b, k + 2, 1)
          if (!((c1 ~ /^[a-z]$/ && c2 ~ /^[a-z]$/) || (c1 ~ /^[A-Z]$/ && c2 ~ /^[A-Z]$/) || (c1 ~ /^[0-9]$/ && c2 ~ /^[0-9]$/))) return 0
          if (c1 > c2) return 0
          k += 2
        }
      }
      return 1
    }
    function glob(p,   re, i, n, c, j, prev, body) {
      re = "^"; n = length(p); prev = ""
      for (i = 1; i <= n; i++) {
        c = substr(p, i, 1)
        if (c == "*") {
          if (substr(p, i + 1, 1) == "*") {
            if (substr(p, i + 2, 1) == "/") { re = re "(.+/)?"; i += 2 } else { re = re ".*"; i++ }
          } else re = re "[^/]*"
          prev = "*"
        } else if (c == "?" || c == "+") {
          if (prev == "" || prev == "*" || prev == "?" || prev == "+") return ""
          re = re c; prev = c
        } else if (c == "[") {
          j = index(substr(p, i + 1), "]")
          if (j == 0) return ""
          body = substr(p, i + 1, j - 1)
          if (!brackets(body)) return ""
          re = re "[" body "]"; i += j; prev = "]"
        } else if (c ~ /^[A-Za-z0-9_-]$/ || c == "/") {
          re = re c; prev = c
        } else if (c == "\\" || c == "^" || c == "]") {
          return ""
        } else {
          re = re "[" c "]"; prev = c
        }
      }
      return re "$"
    }
    function joined(a, n,   s, i) { s = ""; for (i = 1; i <= n; i++) s = s (i > 1 ? ", " : "") a[i]; return s }
    function say(word, why) { printf "answer\t%s\t%s\n", word, why }
    { sub(/\r$/, "") }
    /^[ \t]*(#.*)?$/ { next }
    /^(---|\.\.\.)/ { next }
    {
      match($0, /^ */); ind = RLENGTH
      line = substr($0, ind + 1)
      if (ind == 0) {
        # A list at the column of on: itself is on: list, as YAML reads it.
        if (line ~ /^- / && inon && (evind < 0 || onseq)) { onseq = 1; item("on", nocomment(substr(line, 3))); next }
        inon = 0; inpush = 0; open = 0
        if (line ~ /^["\047]?on["\047]?[ \t]*:/) {
          if (seenon) cannot("it names on: twice")
          seenon = 1
          v = valueof(line)
          if (v == "") { inon = 1; evind = -1 }
          else if (v ~ /^\[/) flow("on", v)
          else item("on", v)
        }
        next
      }
      if (!inon) next
      if (evind < 0) evind = ind
      if (ind < evind) { cannot("its on: block holds a line at an indent this cannot place (" trim(line) ")"); next }
      if (ind == evind) {
        inpush = 0; open = 0
        if (line ~ /^- /) { item("on", nocomment(substr(line, 3))); next }
        if (!plainkey(line)) { cannot("its on: block holds a line this does not read (" trim(line) ")"); next }
        if (keyof(line) != "push") next
        if (pushkey) cannot("its on: block names push twice")
        pushkey = 1
        haspush = 1
        v = valueof(line)
        if (v == "") { inpush = 1; filind = -1 }
        else if (v !~ /^(null|~|\{\})$/) cannot("its push: is written on one line (" v "), which this does not read")
        next
      }
      if (!inpush) next
      if (filind < 0) filind = ind
      if (ind < filind) { cannot("its push trigger holds a line at an indent this cannot place (" trim(line) ")"); next }
      if (ind == filind && line !~ /^- /) {
        if (!plainkey(line)) { cannot("its push trigger holds a line this does not read (" trim(line) ")"); next }
        cur = keyof(line); open = 0
        if (seenkey[cur]++) fail(cur, "its push trigger gives " cur " twice")
        if (cur == "branches") hasbr = 1
        else if (cur == "branches-ignore") hasbi = 1
        else if (cur == "tags" || cur == "tags-ignore") hastags = 1
        else if (cur == "paths") haspaths = 1
        else if (cur == "paths-ignore") haspi = 1
        else vaguely("its push trigger holds " cur ":, which is none of the filters GitHub reads there")
        v = valueof(line)
        if (v == "") open = 1
        else if (cur == "paths-ignore") pi[++npi] = "<inline>"
        else if (v ~ /^\[/) flow(cur, v)
        else item(cur, v)
        next
      }
      if (open && line ~ /^- /) { item(cur, nocomment(substr(line, 3))); next }
      fail(cur, "its push " cur " holds a line this does not read (" trim(line) ")")
    }
    END {
      for (i = 1; i <= npi; i++) printf "ignore\t%s\n", pi[i]
      if (bad != "") { printf "unread\t%s\n", bad; exit }
      # A filter read no further than this answers for --fires alone: the walk
      # reads on, with the paths-ignore above.
      if (vague != "") { say("unknown", vague); exit }
      if (!seenon) { say("unknown", "it has no on: key, so no trigger can be read"); exit }
      if (!haspush) { say("quiet", "it has no push trigger, so no push starts it"); exit }
      npaths = split(ENVIRON["CS_PUSH_PATHS"], P, "\n")
      sugg = ref
      if (index(ref, "/") > 0) sugg = substr(ref, 1, index(ref, "/")) "**"
      if (hasbr && hasbi) { say("unknown", "its push trigger gives both branches and branches-ignore, which GitHub refuses"); exit }
      if (haspaths && haspi) { say("unknown", "its push trigger gives both paths and paths-ignore, which GitHub refuses"); exit }
      if (hasbr) {
        if (nbr == 0) { say("quiet", "its push branches list is empty, so no branch push starts it -- add \047" sugg "\047 to it"); exit }
        m = 0; who = ""; pos = 0
        for (i = 1; i <= nbr; i++) {
          p = br[i]; neg = (substr(p, 1, 1) == "!")
          re = glob(neg ? substr(p, 2) : p)
          if (re == "") { say("unknown", "its push branches entry \047" p "\047 is a pattern this does not read"); exit }
          if (!neg) pos++
          if (ref ~ re) { m = !neg; who = p }
        }
        if (pos == 0) { say("unknown", "its push branches entries are all ! entries, which exclude from nothing"); exit }
        if (m) { word = "fires"; why = "its push branches entry \047" who "\047 matches " ref }
        else if (who != "") { word = "quiet"; why = "its push branches entry \047" who "\047 excludes " ref }
        else { word = "quiet"; why = "its push branches (" joined(br, nbr) ") match no " ref " -- add \047" sugg "\047 to them" }
      } else if (hasbi) {
        word = "fires"; why = "no push branches-ignore entry matches " ref
        for (i = 1; i <= nbi; i++) {
          p = bi[i]
          if (substr(p, 1, 1) == "!") { say("unknown", "its push branches-ignore entry \047" p "\047 is a ! entry, which this does not read"); exit }
          re = glob(p)
          if (re == "") { say("unknown", "its push branches-ignore entry \047" p "\047 is a pattern this does not read"); exit }
          if (ref ~ re) { word = "quiet"; why = "its push branches-ignore entry \047" p "\047 matches " ref; break }
        }
      } else if (hastags) {
        word = "quiet"; why = "its push trigger filters tags alone, so no branch push starts it -- add \047" sugg "\047 as a branches entry"
      } else {
        word = "fires"; why = "its push trigger filters no branch"
      }
      # GitHub reads the path filters of a push against its first 300 changed files
      # alone, so past that it cannot be told which files decide.
      limit = 300
      if (word == "fires" && (haspaths || npi > 0) && npaths > limit) {
        say("unknown", "it is given " npaths " files the release commit changes, and GitHub reads a push path filter against the first " limit " alone, so which of them decide cannot be told")
        exit
      }
      if (word == "fires" && haspaths) {
        if (npaths == 0) { say("unknown", "its push trigger filters by paths:, so whether a push of " ref " starts it turns on the files the release commit changes, which were not given -- pass them, or drop paths: from the push trigger"); exit }
        hit = ""
        for (q = 1; q <= npaths && hit == ""; q++) {
          m = 0; who = ""; pos = 0
          for (i = 1; i <= npa; i++) {
            p = pa[i]; neg = (substr(p, 1, 1) == "!")
            re = glob(neg ? substr(p, 2) : p)
            if (re == "") { say("unknown", "its push paths entry \047" p "\047 is a pattern this does not read"); exit }
            if (!neg) pos++
            if (P[q] ~ re) { m = !neg; who = p }
          }
          if (pos == 0) { say("unknown", "its push paths list holds no entry that is not a ! entry, which matches nothing"); exit }
          if (m) hit = P[q] " by \047" who "\047"
        }
        if (hit == "") { say("quiet", "its push paths (" joined(pa, npa) ") match none of the files the release commit changes (" joined(P, npaths) "), so its push starts no run"); exit }
        why = why "; its push paths match " hit
      }
      if (word == "fires" && npi > 0 && npaths > 0) {
        out = ""; ign = ""
        for (q = 1; q <= npaths && out == ""; q++) {
          who = ""
          for (i = 1; i <= npi; i++) {
            p = pi[i]
            if (p == "<inline>") { say("unknown", "its push paths-ignore is written inline, which this does not read -- write it as a block list, one entry a line"); exit }
            if (substr(p, 1, 1) == "!") { say("unknown", "its push paths-ignore entry \047" p "\047 is a ! entry, which this does not read"); exit }
            re = glob(p)
            if (re == "") { say("unknown", "its push paths-ignore entry \047" p "\047 is a pattern this does not read"); exit }
            if (P[q] ~ re) { who = p; break }
          }
          if (who == "") out = P[q]
          else ign = ign (ign == "" ? "" : ", ") P[q] " by \047" who "\047"
        }
        if (out == "") { say("quiet", "its push paths-ignore ignores every file the release commit changes (" ign "), so its push starts no run"); exit }
        why = why "; " out " is outside its paths-ignore"
      }
      say(word, why)
    }
  '
}

# cistate_push_answer <read> -- the last line of a cistate_push_read answer as
# `<word><TAB><reason>`: fires, quiet or unknown for an answer, and unread for
# a shape the reader did not read or a last line in no form this reads, so the
# walk and --fires classify it alike. Pure.
cistate_push_answer() {
  local last="${1##*$'\n'}"
  case "$last" in
    answer$'\t'fires$'\t'* | answer$'\t'quiet$'\t'* | answer$'\t'unknown$'\t'*) printf '%s' "${last#answer$'\t'}" ;;
    unread$'\t'*) printf 'unread\t%s' "${last#unread$'\t'}" ;;
    *) printf 'unread\tthe reader gave no answer this reads' ;;
  esac
}

# cistate_ignore_entries <read> -- the paths-ignore entries of a
# cistate_push_read answer, one a line. Pure.
cistate_ignore_entries() {
  local l
  while IFS= read -r l; do
    case "$l" in
      ignore$'\t'*) printf '%s\n' "${l#ignore$'\t'}" ;;
    esac
  done <<<"$1"
}

# cistate_workflow_at <sha> -- release.ci.workflow's text as committed at
# <sha>, on stdout, once git_readonly is primed. Returns 0 with the text, 3
# when this repository does not hold <sha>, 4 when the tree at <sha> holds no
# such file, and 1 when git failed, its words in CS_ERR. The walk and --fires
# read the workflow here alike, each saying each outcome in its own words.
cistate_workflow_at() {
  local wf rc=0 listed
  wf="$(cistate_workflow_path)"
  # cat-file -e answers 1 for an object this repository does not hold and 128
  # when git itself failed, so the two are told apart; peeled with ^{commit} it
  # answers 128 for both.
  git_readonly -C "$PROJECT_ROOT" cat-file -e "$1" 2>"$CS_ERR" || rc=$?
  case "$rc" in
    0) ;;
    1) return 3 ;;
    *) return 1 ;;
  esac
  # ls-tree lists nothing, at status 0, for a path the tree does not hold, where
  # show and cat-file answer 128 as they do when git fails.
  listed="$(git_readonly -C "$PROJECT_ROOT" ls-tree "$1" -- "$wf" 2>"$CS_ERR")" || return 1
  [ -n "$listed" ] || return 4
  git_readonly -C "$PROJECT_ROOT" show "$1:$wf" 2>"$CS_ERR" || return 1
}

# cistate_fires <ref> <sha> [<path>...] -- the trigger line for a push of the
# branch <ref>, read from release.ci.workflow as committed at <sha>, never the
# working tree's copy: fires, quiet, missing or unknown, the reason naming the
# file. <path>... are the files the release commit changes, which decide a
# push trigger's paths and paths-ignore (cistate_push_read). With none given,
# a paths-ignore is read as the walk reads it, and a fires answer beside it
# names the premise it rests on. A git that cannot answer is unknown, carrying
# its words.
cistate_fires() {
  local ref="$1" sha="$2" wf text rc got last word why prefixes
  shift 2
  wf="$(cistate_workflow_path)"
  rc=0
  text="$(cistate_workflow_at "$sha")" || rc=$?
  case "$rc" in
    0) ;;
    3)
      cistate_say unknown "this repository does not hold ${sha:0:12}, so $wf there cannot be read"
      return 0
      ;;
    4)
      if cfg_release_declared ci.workflow; then
        cistate_say missing "release.ci.workflow names $CS_WORKFLOW, and the tree at ${sha:0:12} holds no $wf"
      else
        cistate_say missing "release.ci.workflow is not declared, so its default $CS_WORKFLOW is read, and the tree at ${sha:0:12} holds no $wf"
      fi
      return 0
      ;;
    *)
      cistate_say unknown "git could not read $wf at ${sha:0:12}: $(cistate_err)"
      return 0
      ;;
  esac
  if ! got="$(cistate_push_read "$ref" "$@" <<<"$text")"; then
    cistate_say unknown "$wf at ${sha:0:12} could not be read for its push trigger"
    return 0
  fi
  last="$(cistate_push_answer "$got")"
  word="${last%%$'\t'*}"
  why="${last#*$'\t'}"
  if [ "$word" = unread ]; then
    cistate_say unknown "$wf at ${sha:0:12}: $why"
    return 0
  fi
  if [ "$word" = fires ] && [ "$#" -eq 0 ]; then
    if ! prefixes="$(cistate_ignored_prefixes "$(cistate_ignore_entries "$got")")"; then
      cistate_say unknown "$prefixes"
      return 0
    fi
    [ -z "$prefixes" ] ||
      why="$why; its paths-ignore (${prefixes//$'\n'/, }) is taken to leave the files the release commit changes, which were not given, outside it"
  fi
  cistate_say "$word" "$wf at ${sha:0:12}: $why"
}

# cistate_change <commit> <parent> <prefixes> -- what <commit> changes from
# <parent>, one word: `ignored` when every path it changes is under one of
# <prefixes>, `changes` when one is not or it changes nothing. Returns 1, git's
# words in CS_ERR, when the change cannot be read.
cistate_change() {
  local p q hit changed
  changed="$(git_readonly -C "$PROJECT_ROOT" diff --name-only --no-renames "$2" "$1" 2>"$CS_ERR")" || return 1
  # An empty commit changes nothing, and stops the walk as a change would: the
  # safe side, none, though the answer's detail then reads it as a change.
  if [ -z "$changed" ]; then
    printf 'changes\n'
    return 0
  fi
  while IFS= read -r p; do
    hit=no
    while IFS= read -r q; do
      [ -n "$q" ] || continue
      case "$p" in "$q"*) hit=yes ;; esac
    done <<<"$3"
    if [ "$hit" = no ]; then
      printf 'changes\n'
      return 0
    fi
  done <<<"$changed"
  printf 'ignored\n'
  return 0
}

# cistate_walk <sha> -- with no ref and no run on <sha>, the answer line: the
# verdict of the first commit before <sha> that has a run, while every commit
# between changes only what the push trigger ignores; else none, saying where
# and why the walk stopped. A git that cannot answer is unknown.
cistate_walk() {
  local sha="$1" wf text got last prefixes c parent v rc shallow change
  wf="$(cistate_workflow_path)"
  if ! git_readonly_prime; then
    cistate_say unknown "git could not list its environment, so the commits before ${sha:0:12} cannot be read"
    return 0
  fi
  rc=0
  text="$(cistate_workflow_at "$sha")" || rc=$?
  case "$rc" in
    0) ;;
    3)
      cistate_say none "no $CS_WORKFLOW run on ${sha:0:12}, which this repository does not hold, so no commit before it is read"
      return 0
      ;;
    4)
      cistate_say none "no $CS_WORKFLOW run on ${sha:0:12}, whose tree holds no $wf"
      return 0
      ;;
    *)
      cistate_say unknown "git could not read $wf at ${sha:0:12}: $(cistate_err)"
      return 0
      ;;
  esac
  if ! got="$(cistate_push_read "" <<<"$text")"; then
    cistate_say unknown "$wf at ${sha:0:12} could not be read for its paths-ignore"
    return 0
  fi
  last="$(cistate_push_answer "$got")"
  if [ "${last%%$'\t'*}" = unread ]; then
    cistate_say unknown "$wf at ${sha:0:12} could not be read for its paths-ignore: ${last#*$'\t'}"
    return 0
  fi
  if ! prefixes="$(cistate_ignored_prefixes "$(cistate_ignore_entries "$got")")"; then
    cistate_say unknown "$prefixes"
    return 0
  fi
  c="$sha"
  while :; do
    rc=0
    parent="$(git_readonly -C "$PROJECT_ROOT" rev-parse -q --verify "$c^1" 2>"$CS_ERR")" || rc=$?
    if [ "$rc" -eq 1 ]; then
      if ! shallow="$(git_readonly -C "$PROJECT_ROOT" rev-parse --is-shallow-repository 2>"$CS_ERR")"; then
        cistate_say unknown "git could not say whether ${c:0:12} is the first commit: $(cistate_err)"
        return 0
      fi
      if [ "$shallow" = true ]; then
        cistate_say unknown "no $CS_WORKFLOW run on ${sha:0:12}, and this shallow clone holds no commit before ${c:0:12}, where the walk back stopped"
      elif [ "$c" = "$sha" ]; then
        cistate_say none "no $CS_WORKFLOW run on ${sha:0:12}, the first commit"
      else
        cistate_say none "no $CS_WORKFLOW run on ${sha:0:12}, nor on the commits before it to ${c:0:12}, the first commit"
      fi
      return 0
    elif [ "$rc" -ne 0 ]; then
      cistate_say unknown "git could not name the commit before ${c:0:12}: $(cistate_err)"
      return 0
    fi
    if ! change="$(cistate_change "$c" "$parent" "$prefixes")"; then
      cistate_say unknown "git could not read what ${c:0:12} changes from ${parent:0:12}: $(cistate_err)"
      return 0
    fi
    if [ "$change" = changes ]; then
      if [ "$c" = "$sha" ]; then
        cistate_say none "no $CS_WORKFLOW run on ${sha:0:12}"
      else
        cistate_say none "no $CS_WORKFLOW run on ${sha:0:12}, nor on the commits before it to ${c:0:12}, the last that changes what the workflow reads"
      fi
      return 0
    fi
    c="$parent"
    if ! v="$(cistate_verdict_on "$c" "")"; then
      printf '%s\n' "$v"
      return 0
    fi
    if [ -n "$v" ]; then
      printf '%s, on %s: the commits after it to %s change only %s, which %s ignores\n' \
        "$v" "${c:0:12}" "${sha:0:12}" "${prefixes//$'\n'/, }" "$CS_WORKFLOW"
      return 0
    fi
  done
}

# cistate_settings -- read the workflow and the summary into the CS_ globals.
cistate_settings() {
  cfg_load "$DEVBIN_DIR/config.yaml" >/dev/null ||
    die "cannot read the config at $DEVBIN_DIR/config.yaml (above)"
  # Validation holds release.ci.workflow to a file name in .github/workflows/,
  # which gh names a workflow by and the paths-ignore read opens.
  cfg_validate || die "ci-state: $DEVBIN_DIR/config.yaml does not validate (above)"
  CS_WORKFLOW="$(cfg_release_get ci.workflow)" || exit 1
  CS_SUMMARY="$(cfg_release_get ci.summary)" || exit 1
}

# cistate_repo -- read the repository gh is told about into CS_REPO, after
# cistate_settings. A repository that cannot be named is no verdict: unknown,
# naming the key, and exit 0. The trigger reads no repository, so --fires never
# asks for one.
cistate_repo() {
  local repo remote why
  repo="$(cfg_release_get repo)" || exit 1
  remote="$(cfg_release_first_remote)" || exit 1
  if ! why="$(release_repo "$repo" "$remote" 2>&1)"; then
    why="${why#"$DEVBIN_NAME: "}"
    cistate_say unknown "${why#release: }"
    exit 0
  fi
  CS_REPO="$why"
}

# cistate_scratch -- CS_ERR, the file gh's and git's words land in, removed when
# the script exits.
cistate_scratch() {
  CS_ERR="$(mktemp "${TMPDIR:-/tmp}/ci-state.XXXXXX")"
  trap 'rm -f "${CS_ERR:-}"' EXIT
}

# cistate_fires_main <ref> <sha> [<path>...] -- `ci-state --fires`: its
# arguments checked as main checks its one, then the trigger line, exit 0
# whenever it answered. The ref is held to git's own rule for a branch name;
# each path is one the release commit changes, given whole. A git that cannot
# list its environment, or cannot check the ref (is_branch_name), is unknown
# at exit 0, and a release.ci.query that is not the built-in is unknown,
# naming it: release.ci.workflow is the built-in's alone, so the file such a
# query's runs come from is not known here, and `-`, the opt-out, reads no CI
# (ST0011 WP-02c).
cistate_fires_main() {
  local p q rc=0
  if [ "$#" -lt 2 ]; then
    usage >&2
    exit 1
  fi
  for p in "${@:3}"; do
    # git's own name for a file: relative to the root, no empty, . or .. part,
    # no leading or trailing slash, one line. GitHub reads the push's changed
    # files by those names, so another spelling would match its filters apart.
    case "/$p/" in
      // | *//* | */./* | */../* | *$'\n'*)
        printf "%s: ci-state: '%s' is not a file's path as git names it, relative to the root with no empty, . or .. part, which --fires reads against the push's path filters\n" "$DEVBIN_NAME" "$p" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
  if ! is_commit_sha "$2" full; then
    printf "%s: ci-state: '%s' is not a full commit sha, and --fires reads the workflow as committed there\n" "$DEVBIN_NAME" "$2" >&2
    usage >&2
    exit 1
  fi
  cistate_scratch
  if ! git_readonly_prime; then
    cistate_say unknown "git could not list its environment, so no workflow can be read"
    exit 0
  fi
  is_branch_name "$1" 2>"$CS_ERR" || rc=$?
  case "$rc" in
    0) ;;
    1)
      printf "%s: ci-state: '%s' is not a branch name git takes, and --fires reads whether a push of that branch starts the workflow\n" "$DEVBIN_NAME" "$1" >&2
      usage >&2
      exit 1
      ;;
    *)
      cistate_say unknown "git could not check '$1' as a branch name: $(cistate_err)"
      exit 0
      ;;
  esac
  cistate_settings
  q="$(cfg_release_get ci.query)" || exit 1
  if is_no_default "$q"; then
    cistate_say unknown "release.ci.query is -, the opt-out: this project's cut has no candidate, so no trigger is read for one"
    exit 0
  elif ! cfg_ci_query_is_builtin "$q"; then
    cistate_say unknown "release.ci.query is '$q', not the built-in $_DEVBIN_CI_BUILTIN_QUERY, so the workflow its runs come from is not release.ci.workflow, and no trigger is read"
    exit 0
  fi
  cistate_fires "$@"
  exit 0
}

main() {
  local sha ref v
  case "${1:-}" in
    -h | --help)
      usage
      exit 0
      ;;
    --fires)
      shift
      cistate_fires_main "$@"
      ;;
  esac
  if [ "$#" -ne 1 ]; then
    usage >&2
    exit 1
  fi
  if ! is_commit_sha "$1" full; then
    printf "%s: ci-state: '%s' is not a full commit sha, and gh matches a run's commit by its whole sha\n" "$DEVBIN_NAME" "$1" >&2
    usage >&2
    exit 1
  fi
  sha="$1"
  ref="${DEVBIN_RELEASE_TAG:-}"
  cistate_settings
  cistate_repo
  if ! command -v gh >/dev/null 2>&1; then
    cistate_say unknown "gh is not installed, so no run on ${sha:0:12} can be read"
    exit 0
  fi
  cistate_scratch
  if ! v="$(cistate_verdict_on "$sha" "$ref")"; then
    printf '%s\n' "$v"
    exit 0
  fi
  if [ -n "$v" ]; then
    printf '%s\n' "$v"
  elif [ -n "$ref" ]; then
    cistate_say none "no $CS_WORKFLOW run for $ref on ${sha:0:12} yet"
  else
    cistate_walk "$sha"
  fi
  exit 0
}

main "$@"
