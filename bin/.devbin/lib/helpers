#!/usr/bin/env bash
#
# lib/helpers -- shared output and guard primitives.
#
# Sourced, not executed: defines functions, and sets exactly ONE shell option,
# `inherit_errexit`, below. The rest (errexit, nounset, pipefail) stay the
# caller's. This file said it set none until issue 0060: handlers are separate
# processes that source this file and nothing else from the dispatcher, so this
# is the one place a line reaches every one of them.
#
# THIS FILE HAS NO DEPENDENCIES, and that is a load-bearing rule rather than a
# happy accident. Command handlers are separate processes that source this file
# ALONE (see bin/.devbin/cmd/check). The moment a primitive here needs config,
# every handler in every project has to load the config reader to print a
# warning. So the rule is: needs config, belongs in lib/resolve; needs nothing,
# belongs here. `is_command` and `parse_common_opts` live in lib/resolve for
# exactly this reason, despite reading as helpers.
#
# WP-05 folds the universal functions out of the source projects. The run-log
# subsystem -- open_run_log, write_errors_file, note_promotion, the purge
# family, print_run_verdict -- is deliberately NOT here: it is one cohesive
# subsystem and WP-06 ports it whole into lib/runlog. Splitting it across two
# files to satisfy a function count would be the worse trade.
#
# The project name in the die/warn prefix comes from config rather than being
# baked in, which is the whole point of the fold: every project printing
# its own `<name>:` from its own copy of the same two lines becomes one line
# reading a value.
#
# bash_floor_refuse <version> <path> [<how it was reached>] -- the ONE refusal
# for a bash below devbin's floor, and it exits.
#
# THE FLOOR (issue 0022, reversing the earlier bash 3.2 support). devbin
# requires bash >= 5 and REFUSES older: macOS ships /bin/bash 3.2.57 permanently
# (GPLv3), the projects devbin runs in use a Homebrew bash 5.x, and the
# guarantee points at what actually runs. EVERYTHING FROM HERE TO THE LOAD GUARD
# MUST STAY PARSEABLE BY BASH 3.2 -- the refusal cannot be allowed to arrive as
# a syntax error that explains nothing.
#
# A BASH 5 THAT IS ON THE MACHINE BUT NOT AHEAD ON THIS PATH IS NAMED (issue
# 0253). cron and a hook a GUI app launched run with the system's PATH, where
# /bin/bash 3.2 answers though Homebrew's bash is installed, and "install a
# current one" sent that reader to install what they had. So Homebrew's bash is
# looked for, and the first that meets the floor is named with the PATH that
# finds it: its directory ahead of the refusing bash's, which is /bin in the
# cron case. Only where none meets it is the reader told to install one.
#
# HOMEBREW_PREFIX'S BASH ALONE WHEN THE PREFIX IS SET AND ABSOLUTE, and the
# places Homebrew installs by default only when it is not, which is where
# devbin_brew_root would not look: for it, an environment with no
# HOMEBREW_PREFIX has no Homebrew default, because it picks the install a
# project upgrades from, so a guess there would change what runs, and the
# suite would find a real install. Here a guess only names a bash inside a
# refusal that refuses either way, and an unset prefix is this refusal's own
# case, cron or a GUI hook, where brew shellenv never ran. A relative prefix
# counts as unset, as it does there and in path_hit.
#
# THE DEFAULTS ARE THE TWO MACOS PREFIXES ALONE. Homebrew's default Linux
# prefix sits under /home, and every file devbin vendors must pass a
# consumer's guard that refuses a home-shaped path (install.bats, issue
# 0109), so this file cannot name it: Linuxbrew's bash is found through
# HOMEBREW_PREFIX, which brew shellenv sets, and a Linux system bash meets
# the floor on its own.
bash_floor_refuse() {
  local d=/bin
  printf '%s: bash >= %s is required; this is bash %s (%s)\n' \
    "${DEVBIN_NAME:-devbin}" "$_DEVBIN_BASH_FLOOR" "${1:-unknown}" "${2:-unknown}" >&2
  [ -z "${3:-}" ] || printf '  %s\n' "$3" >&2
  case "${2:-}" in */*) d="${2%/*}" ;; esac
  case "${HOMEBREW_PREFIX:-}" in
    /*) _bash_floor_found "$d" "$HOMEBREW_PREFIX/bin/bash" ;;
    *) _bash_floor_found "$d" /opt/homebrew/bin/bash /usr/local/bin/bash ;;
  esac ||
    printf '  macOS ships bash 3.2 permanently -- install a current one:  brew install bash, or apt-get install bash\n' >&2
  exit 1
}

# _bash_floor_found <dir> <bash>... -- name, on stderr, the first <bash> that
# meets the floor, with the PATH that finds it: its directory ahead of <dir>.
# Non-zero when none does.
_bash_floor_found() {
  local d="$1" b v
  shift
  for b in "$@"; do
    [ -x "$b" ] || continue
    # Single-quoted on purpose: the CHILD bash expands this, not this one.
    # shellcheck disable=SC2016
    v="$("$b" -c 'printf %s "${BASH_VERSINFO[0]}"' 2>/dev/null)" || continue
    bash_meets_floor "$v" || continue
    printf '  a bash >= %s is at %s -- put %s ahead of %s on PATH (for cron or a hook, in the job'"'"'s own PATH)\n' "$_DEVBIN_BASH_FLOOR" "$b" "${b%/bash}" "$d" >&2
    return 0
  done
  return 1
}

# _DEVBIN_BASH_FLOOR -- devbin's floor, the major version of bash it runs on
# (issue 0022). THE ONE SPELLING OF IT: bash_meets_floor compares against it,
# and every message that states the floor prints it, so raising the floor is
# this one line.
_DEVBIN_BASH_FLOOR=5

# bash_meets_floor <major> -- rc 0 when <major>, a bash's BASH_VERSINFO[0], is
# at devbin's floor or above; non-zero for anything else, a word that is not a
# number included. The one comparison with the floor: the load guard below,
# the refusal's search, require_path_bash_floor and doctor's bash row all ask
# it.
bash_meets_floor() {
  case "${1:-}" in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge "$_DEVBIN_BASH_FLOOR" ]
}

# THE FLOOR IS CHECKED WHERE EVERY PROCESS PASSES (issue 0076). It lived in the
# dispatcher alone, and handlers are separate processes: one run directly, or
# exec'd under a PATH that finds 3.2, ran on 3.2 with nothing refusing. Every
# built-in handler and the dispatcher source this file, so the check sits here,
# ahead of the load guard, and a handler below the floor stops at load.
if ! bash_meets_floor "${BASH_VERSINFO[0]:-0}"; then
  bash_floor_refuse "${BASH_VERSION:-}" "${BASH:-}"
fi

[ -n "${_DEVBIN_HELPERS_LOADED:-}" ] && return 0
_DEVBIN_HELPERS_LOADED=1

# ERREXIT REACHES EVERY DEPTH (issue 0060). Command
# substitution does not inherit errexit without this, so a `die` two `$( )`
# deep kills only its own subshell: the middle function carries on and the
# outer caller reads its output as success. Measured live at `release notes`,
# which wrote both views and exited 0 over a refusal it had printed twice.
# Unguarded, because the floor above has already refused every bash without it.
shopt -s inherit_errexit

# require_path_bash_floor -- refuse when the bash PATH resolves is below the
# floor, since every `#!/usr/bin/env bash` handler runs on THAT bash and not on
# the dispatcher's own (issue 0076).
#
# Measured before this existed: `env PATH=/usr/bin:/bin /opt/homebrew/bin/bash
# bin/devbin probe` passed the dispatcher's own check on 5.3 and ran the handler
# on 3.2.57 at rc 0. The ordinary case costs one PATH lookup: the same file as
# the running bash needs no second process.
require_path_bash_floor() {
  local path_bash answer
  # No bash on PATH at all is not a floor question: every `env bash` handler
  # then fails at exec, loudly, naming bash.
  path_bash="$(type -P bash)" || return 0
  [ "$path_bash" -ef "${BASH:-}" ] && return 0
  # Single-quoted on purpose: the CHILD bash expands these, not this one.
  # shellcheck disable=SC2016
  answer="$("$path_bash" -c 'printf "%s %s" "${BASH_VERSINFO[0]}" "$BASH_VERSION"')" ||
    die "could not ask $path_bash its version, and handlers run on the bash PATH resolves"
  case "${answer%% *}" in
    '' | *[!0-9]*) die "$path_bash answered its version as '$answer', which is not a bash version" ;;
  esac
  bash_meets_floor "${answer%% *}" && return 0
  bash_floor_refuse "${answer#* }" "$path_bash" \
    "PATH resolves bash to it, and every handler runs on the bash PATH resolves (this dispatcher is on $BASH_VERSION)"
}

# The prefix on diagnostics. Set by the dispatcher once config is loaded;
# defaults to `devbin` so a failure BEFORE config load still says something
# sensible rather than printing a bare colon.
DEVBIN_NAME="${DEVBIN_NAME:-devbin}"

# DEVBIN_INVOKE -- HOW YOU TYPE IT, which is now a CONSTANT rather than the
# project's name.
#
# These were once one field, because the launcher was symlinked to
# the project's own name and `bin/demo` was both the thing you typed and
# the thing the project was called. That convention collided with the binaries
# these projects now BUILD -- a project named `demo` ships a `demo` binary --
# and one project had already routed around it by renaming its shim.
# So the per-project symlink is retired and `bin/devbin` is the invocation
# everywhere.
#
# IT WAS A CONSTANT, AND THE PREMISE FOR THAT WAS FALSE (ST0005).
#
# This read: "The invocation no longer varies, so a variable would be a field
# that must be kept in sync with a fact that cannot change." That reasoning was
# about the retired per-project symlink and it was right about THAT. What it
# missed is that `bin/devbin` is a RELATIVE path, so what varies is not the name
# but whether it RESOLVES from where the reader is standing.
#
# The operator drives devbin through `dvb`, a shell function that walks UP from
# $PWD to find `bin/devbin` and runs it without changing directory -- so its
# whole purpose is being used from a SUBDIRECTORY. Measured there, every
# remediation devbin prints was a command that does not exist:
#
#     run: bin/devbin upgrade
#     $ bin/devbin upgrade
#     no such file or directory: bin/devbin
#
# That is the defect this file already records one form of -- "the
# remediation names a command that EXISTS" -- recurring in the one direction the
# earlier fix did not cover. It exists at the project root, and not where the
# reader is.
#
# So it is the SHORTEST FORM THAT WORKS FROM THE CALLER'S CWD, and the dispatcher
# computes it once from the ORIGINAL cwd before any handler cds to the project
# root. `:-` rather than a bare assignment so a re-source inside an exec'd
# handler inherits that answer instead of recomputing a wrong one.
DEVBIN_INVOKE="${DEVBIN_INVOKE:-bin/devbin}"

die() {
  printf '%s: %s\n' "$DEVBIN_NAME" "$*" >&2
  exit 1
}

warn() {
  printf '%s: %s\n' "$DEVBIN_NAME" "$*" >&2
}

step() { printf '\n==> %s\n' "$*"; }
ok() { printf '    done.\n'; }

# report_not_yet <what> <gate> -- print the STUB refusal and return 3.
#
# The non-exiting half of not_yet, for callers running inside a loop over
# several options: `all` must not stop at the first breach, so a function it
# calls in the same process cannot exit. One message, two exit behaviours.
report_not_yet() {
  printf '%s: %s is not built yet.\n' "$DEVBIN_NAME" "$1" >&2
  printf '       gated on: %s\n' "$2" >&2
  return 3
}

# not_yet <what> <gate> -- the STUB refusal, ported from the corpus.
#
# A surface that is not built yet exits NON-ZERO with the reason and what
# unblocks it, never a quiet no-op. An unbuilt gate that exits 0 is
# indistinguishable from a passing one, which is the exact failure the sealed
# gates exist to prevent.
not_yet() {
  report_not_yet "$1" "$2" || true
  exit 3
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found. ${2:-}"
}

# cpu_count -- how many CPUs this machine has online, a whole number of at
# least 1: nproc where GNU coreutils provides it, getconf where it does not
# (macOS ships no nproc), and 4 when neither answers, so a caller sizing a pool
# of workers always gets a usable number. Taking 4 is said on stderr, since a
# caller may print the number as this machine's.
#
# ONE HOME FOR THE PROBE (issue 0190). Devbin's lint gate sizes its shellcheck
# pool from it and devbin's own test handler its parallel lane; the probe was
# written inline in the lint gate until the second caller came.
cpu_count() {
  local n=""
  n="$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null)" || n=""
  if ! [[ "$n" =~ ^[1-9][0-9]*$ ]]; then
    warn "could not count this machine's CPUs (neither nproc nor getconf answered with a number), so taking 4"
    n=4
  fi
  printf '%s\n' "$n"
}

# init_colors [auto|off] -- set green/red/dim/reset. All empty when off, when
# NO_COLOR is set, or when stdout is not a TTY.
#
# SC2034 (appears unused) is expected here and suppressed: these are globals for
# the whole runtime, and shellcheck only sees this file. Exporting them to
# satisfy the linter would push its colour variables into the environment of
# every command devbin runs, which is a worse trade than one directive.
# shellcheck disable=SC2034
init_colors() {
  green="" red="" dim="" reset=""
  if [ "${1:-auto}" = auto ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    green=$'\033[32m' red=$'\033[31m' dim=$'\033[2m' reset=$'\033[0m'
  fi
}

# log_awk <awk args...> -- awk over a captured log or a tool's output, read as
# bytes.
#
# A log holds whatever bytes the tools and the tests wrote, and that need not be
# valid UTF-8 (a latin1 byte from a tool, or from a test's own output). Under a
# UTF-8 locale, macOS awk exits 2 at the first such byte on any regex, with
# `towc: multibyte conversion failure`, and prints nothing more, so a counter
# read an empty run as an uncounted one and it passed green (issue 0231).
# Under LC_ALL=C every byte is a character, and the byte-literal rules (the
# swift-testing glyphs and U+200B, spliced in as bytes) match byte for byte.
#
# LC_ALL is set on the awk command alone. It is never exported, so the gate's
# tools still run in the person's locale. A grep over a log needs the same
# `LC_ALL=C` on its command, as write_errors_file's has: GNU grep drops a line
# holding such a byte and says only "binary file matches".
log_awk() {
  LC_ALL=C awk "$@"
}

# strip_ansi -- filter: remove CSI escape sequences from stdin.
#
# Byte-identical in every project it was folded from. Reads stdin, writes
# stdout, so it composes in a pipeline: `... | strip_ansi > "$errors"`.
#
# The escape byte is passed in as an awk variable rather than written into the
# pattern, because a literal ESC in source survives neither editors nor patches
# reliably. It reads through log_awk, because what it strips is a log's bytes:
# under a UTF-8 locale a latin1 byte stopped it short (issue 0231).
strip_ansi() {
  log_awk -v esc="$(printf '\033')" '{ gsub(esc "\\[[0-9;?]*[A-Za-z]", ""); print }'
}

# upper_snake <string> -- the environment-variable spelling of a name.
#
# `demo` -> DEMO, `my-proj` -> MY_PROJ. Devbin derives variable names
# from the project name in several places -- <NAME>_ROOT, <NAME>_REPL_HISTORY,
# DEVBIN_OPT_<NAME>, the run-log suffix -- and each did the same `tr` inline.
# Four copies of one transformation is four chances to disagree about whether a
# hyphen becomes an underscore.
upper_snake() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'
}

# is_true_word <value> -- `true`, `yes` or `1`.
# is_false_word <value> -- `false`, `no` or `0`.
# is_no_default <value> -- the catalogue's `-`: "devbin ships no default here".
#
# ONE PREDICATE PER VOCABULARY (issue 0066). These were written out at thirteen
# sites across lib/resolve, lib/runlog and lib/builtins. Every copy agreed, and
# nothing would have said so on the day one learned a word the others did not
# -- which is how 0065 happened: `-` was honoured for `log:` on the catalogue's
# value alone, and a project writing `log: "-"` sealed a gate named `-`. The
# words are exact and case-sensitive, as every copy was; `off` is not false.
#
# THE WORDS ARE DATA, AND THE PREDICATES READ THEM. docs/configuration.md and
# lib/config.reference.yaml both state the `log:` decline spellings, and
# tests/unit/helpers.bats holds each statement to these lists. It first read the
# words back out of the function's source, which a second `return 0` line or an
# `OFF)` arm slipped past; a list has no layout to parse around.
_DEVBIN_TRUE_WORDS="true yes 1"
_DEVBIN_FALSE_WORDS="false no 0"
_DEVBIN_NO_DEFAULT="-"

# _word_in <value> <words> -- <value> is exactly one of the space-separated
# <words>. Split with `read -a`, which never globs, so a word is only ever a
# literal.
#
# IFS IS PINNED HERE, because `read -a` splits on the CALLER'S. Under the common
# strict-mode `IFS=$'\n\t'`, or `IFS=`, the list stayed one word and `true`,
# `yes`, `1` and `no` all read as not-a-word -- so `log: false` stopped declining,
# 0065 again, in any project handler that sources lib/helpers under strict mode.
# The case statements this replaced never read IFS.
_word_in() {
  local w IFS=' '
  local -a words
  read -r -a words <<<"$2"
  for w in "${words[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

is_true_word() { _word_in "$1" "$_DEVBIN_TRUE_WORDS"; }
is_false_word() { _word_in "$1" "$_DEVBIN_FALSE_WORDS"; }
is_no_default() { _word_in "$1" "$_DEVBIN_NO_DEFAULT"; }

# dash_to_empty <name>... -- each named variable holding `-`, the placeholder a
# tab-separated line carries for an empty field, made empty. A tab is IFS
# whitespace, so `read` would collapse an empty field and shift the rest.
dash_to_empty() {
  local n
  for n in "$@"; do
    [ "${!n}" != - ] || printf -v "$n" '%s' ''
  done
}

# has_words <value> -- true when <value> holds a character bash would not split
# on, which is the same question as "run_words would find at least one word".
#
# SEPARATE FROM run_words BECAUSE VALIDATION MAY NOT GLOB: cfg_validate reads
# every declared command line wherever `doctor` happens to be standing, and
# matching a pattern there would say nothing about the directory the command
# will run in. This asks the only half validation can answer.
#
# The characters are the three run_words splits on, not `[[:space:]]`: a value
# of one carriage return is a word to bash and is not a space to that class, and
# a refusal that disagreed with the split would refuse a line that runs.
has_words() {
  case "$1" in
    *[!$' \t\n']*) return 0 ;;
  esac
  return 1
}

# nonempty_lines <text> -- how many lines of <text> hold anything (issue 0159).
#
# A COUNT WITH NO STATUS TO SWALLOW. The idiom was `grep -c . || true`: grep
# exits 1 on a count of 0, so every caller had to throw a status away, and the
# same `|| true` throws away the 2 of a grep that could not read. A read loop
# over a string it was handed has no status to lose.
nonempty_lines() {
  local line n=0
  while IFS= read -r line; do
    if [ -n "$line" ]; then n=$((n + 1)); fi
  done <<<"$1"
  printf '%s\n' "$n"
  return 0
}

# run_words <array> <key> <value> -- fill <array> with the words <value> runs
# as, or refuse, naming <key>, a value with no words in it.
#
# THE ONE READING OF A DECLARED COMMAND LINE (issue 0082). Every place devbin
# runs one asks this: an option's `run:` bare
# and under a gate, a command's `run:` exec'd and under a gate,
# `commands.fullcycle.restore`, `release.notes.run`, and the catalogue's own
# command lines, which follow the same rule because two halves of one surface
# differing would be worse than either behaviour on its own.
#
# - SPLIT ON SPACE, TAB AND NEWLINE, never on the caller's IFS. Under the
#   common strict-mode `IFS=$'\n\t'` a whole command line stays one word and
#   resolves to nothing, and that class has been measured twice in this tree in
#   two days (`_word_in`, `cfg_release_list`).
# - EVERY WORD IS A GLOB PATTERN, matched in the directory the caller stands in,
#   which each site makes the directory the command runs from: the project root,
#   or for `notes.run` the root it answers for. A word matching nothing is
#   passed as written, a word matching several becomes several words, and a
#   dotfile is matched only by a pattern that names the dot. The globbing was
#   KEPT and documented, because a project's
#   `bats opt/*/test` relies on it.
# - THE READING IS DEVBIN'S, NOT THE PROCESS'S. `set -f` and the glob options
#   are pinned here for the split alone and put back before this returns, so an
#   inherited `SHELLOPTS=noglob` or `BASHOPTS=nullglob:dotglob` cannot quietly
#   change what a declared line runs -- both measured on bash 5.3, turning
#   globbing off entirely and dropping a word that matches nothing.
#   **NOT pinned, deliberately: `GLOBIGNORE` and `GLOBSORT`.** Both are inert
#   when they arrive in the environment, measured the same day, and `local
#   GLOBIGNORE` would ACTIVATE the inherited value for the rest of the process
#   as the local goes out of scope. devbin assigns neither, and a test holds it.
#   **AND NOT PINNING IS THE ONLY CORRECT ANSWER, NOT THE CONVENIENT ONE**, which
#   is stronger than this note said until it was measured: bash runs
#   these hooks on ASSIGNMENT, so once the variable is touched at all the inert
#   state cannot be restored by any assignment -- saving it, unsetting it and
#   writing the same bytes back leaves it ACTIVE. A pin here would therefore be
#   a one-way door for the whole process, which is why the rule is "never touch"
#   rather than "save and restore" as it is for the shopts above.
# - NEVER EVAL'D. Quotes, `$`, `;` and redirections in the value are
#   literal characters, so a declared line cannot carry an argument with a space
#   in it; a command line that needs real quoting needs a handler.
# - A VALUE WITH NO WORDS IS REFUSED, NAMING <key>. A `run:` of only spaces is
#   not empty to `[ -n "$run" ]` and splits into nothing, after which `$run "$@"`
#   ran the arguments typed after the command AS the command, at exit 0.
run_words() {
  # A NAMEREF CANNOT BE HONOURED IF THE NAME IS ONE OF OURS, AND FAILING THAT
  # QUIETLY WOULD REBUILD THE DEFECT THIS HELPER EXISTS TO KILL. `local -n
  # _rw_out="$1"` binds first and the `local` on the next line then SHADOWS the
  # caller's variable when the name matches, so the words land in the local, the
  # local dies at return, and run_words hands back 0 with the caller's array
  # never set -- after which `"${words[@]}" "$@"` is an empty command line that
  # runs the arguments typed after the command, at exit 0. That is 0082 exactly.
  # Measured on bash 5.3: `_rw_o`, `_rw_on` and `IFS` each do it silently, and
  # `_rw_on` additionally hands the split words to `shopt -s`. No caller can
  # reach it -- no caller passes one of run_words's own names -- so this is a
  # trap for the next caller rather than a live bug, and status 2 marks it as a
  # programming error rather than the config error 1 means.
  # A NAME CHECK AND A BLACKLIST, BECAUSE A BLACKLIST ALONE LEAVES 0082'S OWN
  # SHAPE NEXT TO IT.
  # The first cut listed the colliding names and stopped, which left a hole:
  # `run_words 2bad ...` makes `local -n` fail with bash's own `invalid
  # variable name for name reference`, execution FALLS THROUGH, and run_words
  # returns 0 with the caller's array never set -- which is the empty command
  # line again. Measured on bash 5.3, all at rc=0: `2bad`, `a b`, `a-b`, `-x`,
  # `a;b`. `arr[0]` got as far as the copy and returned 1, reporting a valid
  # name as "the config's line held no words". A name that IS a name is the
  # question, so it is asked positively, through the one definition of it.
  if ! is_identifier "$1"; then
    warn "run_words: '$1' is not a shell variable name, so there is no array to fill"
    return 2
  fi
  case "$1" in
    _rw_out | _rw_o | _rw_on | _rw_split | IFS)
      warn "run_words: cannot fill an array named '$1' -- it is one of run_words's own names"
      return 2
      ;;
  esac
  local -n _rw_out="$1"
  local IFS=$' \t\n' _rw_o _rw_on=""
  # The split lands in a local and is copied to the caller AFTER the shopts are
  # put back, so a target bash refuses to assign -- a readonly one -- cannot
  # leave the glob options it turned off unset in the caller's shell.
  # Unreachable from every site, which all pass a plain indexed array.
  #
  # **AN INTEGER TARGET IS NOT REFUSED AND THE GUARD ABOVE CANNOT REFUSE IT**,
  # because `declare -ia w` carries a name that IS a name: the defect is the
  # attribute, not the spelling. This comment claimed a `declare -ia` target
  # refuses, and that was wrong in both directions, measured on bash 5.3 --
  # under `set +u` the word `abc` COERCES, silently, to `(0)`, so the caller
  # runs the command `0`; under devbin's own `set -euo pipefail` the arithmetic
  # on an unset name kills the shell outright. Loud in devbin, silent in a
  # caller that relaxed `set -u`. It is declared rather than closed: no site
  # passes an integer array, and a check on the target's attributes would be
  # reading `declare -p` output as a string.
  local -a _rw_split=()
  # `set` options are restored on return; the shopt ones are put back below,
  # which is why the split and the restore sit between no other statements.
  local -
  set +f
  for _rw_o in nullglob failglob dotglob nocaseglob globstar extglob; do
    shopt -q "$_rw_o" || continue
    _rw_on="$_rw_on $_rw_o"
    shopt -u "$_rw_o"
  done
  if has_words "$3"; then
    # shellcheck disable=SC2206  # split and globbed on purpose -- see above
    _rw_split=($3)
  fi
  # shellcheck disable=SC2086  # a list of option names, split on purpose
  [ -z "$_rw_on" ] || shopt -s $_rw_on
  _rw_out=(${_rw_split[@]+"${_rw_split[@]}"})
  if [ "${#_rw_out[@]}" -eq 0 ]; then
    warn_no_words "$2"
    return 1
  fi
}

# warn_no_words <key> -- the ONE sentence devbin says when a declared command
# line holds no words. run_words says it at the site, where the words are about
# to be run; a caller that may not glob says it through has_words and this. Two
# readers of a command line and one sentence, rather than the same sentence
# written out wherever it happens to be needed (issue 0082).
warn_no_words() { warn "$1 holds no words, so there is no command to run"; }

# link_step <link> -- print the path <link> names, one step: its content, and a
# relative content joined to the link's directory as written. Returns 1 when
# the content cannot be read back exactly, so a walk of links never takes a
# step to a name the link does not hold; find's own error, if it has one, is
# left on stderr. THE ONE STEP OF EVERY WALK OF A CHAIN OF LINKS: follow_links'
# and fullcycle's _fullcycle_tree_gone (issue 0139: a second walk, without this,
# split a content holding a newline and looked up the wrong name). Its two
# refusals before the size check, a readlink that fails and an empty content,
# are each held by the other and by the check; a caller reaches it only through
# a name that is a link (-L), so neither is reachable alone, and neither has an
# arm of its own.
#
# - PLAIN `readlink`, NO FLAGS. `readlink -f` and `realpath` also resolve every
#   directory on the way, and they are not the same program on BSD and GNU.
#   Plain readlink printed the same bytes on both for an absolute target, a
#   relative one, `..`, a space, a leading dash, a dangling link and a loop
#   (measured: macOS's readlink and GNU coreutils 9.12).
# - A CONTENT IT CANNOT READ BACK EXACTLY IS REFUSED: one ending in a newline.
#   The command substitution strips every trailing newline, whichever readlink
#   printed it -- BSD's prints one fewer than GNU's (measured) -- and
#   the length left, in bytes, is checked against the link's own size, which
#   find -size reads without following the link. A sentinel that kept the
#   newlines GNU's readlink prints let such a content through whole, and every
#   caller's own command substitution then stripped it: a tree read as gone at
#   rc 0 (issue 0139). A newline inside a content is read exactly, and is kept.
# - A PATH NOT OPENING WITH / IS GIVEN TO find AS ./path, so find never reads a
#   link named -x, ! or ( as an option or an expression.
# - A RELATIVE CONTENT IS JOINED TO ITS LINK'S DIRECTORY AS WRITTEN, and never
#   tidied: when `a` is itself a link, the kernel reads the `..` in `a/../t`
#   after following `a`, so a tidied `t` can name a different file.
link_step() {
  local p="$1" t n s
  t="$(readlink -- "$p")" || return 1
  [ -n "$t" ] || return 1
  n="$(LC_ALL=C && printf '%s' "${#t}")"
  case "$p" in /*) ;; *) p="./$p" ;; esac
  # find-walk: -prune at the start point -- it asks of one link and enters nothing
  s="$(find "$p" -prune -size "${n}c" -print)" || return 1
  [ -n "$s" ] || return 1
  case "$t" in
    /*) ;;
    *) case "$1" in */*) t="${1%/*}/$t" ;; esac ;;
  esac
  printf '%s\n' "$t"
}

# _DEVBIN_LINK_HOPS -- the most links a walk of a chain follows: follow_links
# and link_chain_reaches each stop there (issue 0247). Linux documents 40 and
# macOS follows 32 (measured), so the kernel cannot resolve a chain longer
# than this either: no lookup runs or writes through it. Reaching the bound is
# therefore silent in link_chain_reaches, a chain that reaches nothing, and is
# follow_links's refusal of a link it cannot follow, never a message of its
# own.
readonly _DEVBIN_LINK_HOPS=40

# follow_links <path> -- print the path of the file <path> names: <path> itself
# when it is not a symbolic link, otherwise the end of its chain of links.
# Refuses, naming <path>, a link that leads to no file and a link it cannot
# follow exactly.
#
# THE ONE WALK OF A CHAIN OF LINKS: stage_beside's, so that every writer that
# replaces a file writes through a link to it (issue 0084), and clean's real
# path. bin/devbin keeps a walk of its own, because it runs before this file can
# be found and must parse under bash 3.2. fullcycle's _fullcycle_tree_gone walks
# a path that may not resolve, a name at a time, to say whether it is gone, and
# its _fullcycle_link_in_tree follows a dangling link as far as its links go,
# to place it; each takes each step of a link through link_step, as this does.
#
# - A LINK THAT LEADS TO NO FILE IS REFUSED, dangling or in a loop alike. Writing
#   through it would create a file nobody put there, and replacing it would
#   throw the link away.
# - EACH STEP IS link_step's, which refuses a link whose content it cannot read
#   back exactly. The end of the walk must still be the file the kernel reaches
#   (`-ef`), and the walk is bounded by _DEVBIN_LINK_HOPS. A correct walk never
#   meets the bound, because the link was reachable.
follow_links() {
  local path="$1" p="$1" t n=0
  if [ -L "$p" ] && [ ! -e "$p" ]; then
    warn "$path is a symbolic link that leads to no file"
    return 1
  fi
  while [ -L "$p" ]; do
    n=$((n + 1))
    if [ "$n" -gt "$_DEVBIN_LINK_HOPS" ] || ! t="$(link_step "$p")"; then
      warn "cannot tell which file $path is a symbolic link to"
      return 1
    fi
    p="$t"
  done
  if [ "$n" -gt 0 ] && ! [ "$path" -ef "$p" ]; then
    warn "cannot tell which file $path is a symbolic link to"
    return 1
  fi
  printf '%s\n' "$p"
}

# real_path <path> <out-var> [getcwd] -- <path>, absolute and with symlinks
# resolved, into the variable <out-var>. A relative <path> is read from the
# current directory, which each caller makes the project root. With `getcwd`
# each directory is read in physical_dir's getcwd mode, spelled in the case the
# disk stores, for a caller comparing two paths as strings (issue 0284).
#
# ONE HOME FOR WHERE A PATH RESOLVES (issue 0134): clean's scan for PATH
# binaries in a tree it is about to remove, and fullcycle's PATH watch, which
# compared a link's text with the project's path and so never watched a
# relative link, or one spelled through /tmp while the root is /private/tmp.
# It was clean's own until then.
#
# The chain of links is walked by follow_links, the one walk (issue 0084), which
# this function used to carry a copy of; what it adds is the directory's
# physical spelling. A link follow_links cannot follow exactly, one
# whose target's name ends in a newline, it names on stderr, and the path is then
# compared as given.
#
# THE ANSWER IS SET, NOT PRINTED, AND pwd -P's IS READ PAST A SENTINEL (issue
# 0141). Read back through $(...), a path whose name
# ended in a newline lost it: a tree named out<LF> was compared as out/, its
# neighbour, so its own PATH links went unlisted and unrefused, and a PATH entry
# in out/bin was blamed on it.
real_path() {
  local p="$1" f d fd
  local -n _crp_out="$2"
  if [ ! -e "$p" ]; then
    _crp_out="$p"
    return 0
  fi
  if [ -d "$p" ]; then
    physical_dir "$p" _crp_out "${3-}" || _crp_out="$p"
    return 0
  fi
  f="$(follow_links "$p")" || f="$p"
  case "$f" in
    */*) fd="${f%/*}" ;;
    *) fd=. ;;
  esac
  [ -n "$fd" ] || fd=/
  physical_dir "$fd" d "${3-}" || d="$fd"
  _crp_out="$d/${f##*/}"
  return 0
}

# physical_dir <dir> <out-var> [getcwd] -- the physical path of <dir>, or 1 when
# it cannot be entered. With `getcwd` it is spelled as the kernel's getcwd
# spells it, as git spells its own working directory: on a disk that folds case
# that is the case the directory is stored in, where bash's own `pwd -P` keeps
# the case it was typed in (issue 0185).
#
# PHYSICAL, AND FROM WHERE THE PATH SAYS. bash's plain cd is logical: it tidies
# a/../b as text, where the kernel reads the `..` only after following a --
# follow_links keeps a/../t untidied for exactly that reason, and a logical cd
# undid it, so a PATH link through lnk/.. into the tree went unlisted beside a
# directory of the tidied name. And cd reads a bare relative operand through an
# exported CDPATH before the current directory, and a lone `-` as the directory
# it last left, printing either: a relative PATH entry was read as a directory
# it does not name. So a relative path is spelled from ./, and cd reads it from
# the current directory, which each caller makes the project root, as a lookup
# made there would, and prints nothing. pwd -P's answer is read past a sentinel,
# so a name ending in a newline keeps it (issue 0141).
#
# AND A LEADING // IS SPELLED /: pwd -P keeps it, as POSIX lets it, and it
# names / on the systems devbin runs on. Trees and PATH entries are compared as
# prefixes, so a root entered as //... missed every link into its trees, and a
# PATH entry spelled from // was never the tree's.
#
# Its logical twin, logical_dir, keeps a path as the user's shell reads it
# (issue 0267).
#
# Its locals carry its own prefix, since <out-var> is a caller's name reached
# through bash's dynamic scope, and a local of the same name would take it.
physical_dir() {
  local _cpd_dir="$1" _cpd_d
  local -n _cpd_res="$2"
  case "$_cpd_dir" in
    /*) ;;
    *) _cpd_dir="./$_cpd_dir" ;;
  esac
  if [ "${3-}" = getcwd ]; then
    _cpd_d="$(cd -P -- "$_cpd_dir" 2>/dev/null && env pwd -P && printf .)" || return 1
  else
    _cpd_d="$(cd -P -- "$_cpd_dir" 2>/dev/null && pwd -P && printf .)" || return 1
  fi
  _cpd_d="${_cpd_d%$'\n.'}"
  case "$_cpd_d" in //*) _cpd_d="${_cpd_d#/}" ;; esac
  _cpd_res="$_cpd_d"
}

# logical_dir <dir> <out-var> -- the absolute logical path of <dir>, as the
# user's shell reads it from the current directory, or 1 when it cannot be
# entered: physical_dir's logical twin. Links are kept as typed and a/../b is
# tidied as text, as `cd && pwd` does, because a project's name is derived from
# the path's last part, and the physical one would rename it under a linked
# directory. cd's own reason for a directory it cannot enter is left on stderr,
# for the caller to keep or silence.
#
# FROM WHERE THE PATH SAYS, AND NOTHING cd PRINTS (issue 0267). install's
# --into and upgrade's and vendor's --from each captured a bare `cd <dir> &&
# pwd`, and a logical cd reads a relative operand through an exported CDPATH
# and a lone `-` as $OLDPWD, printing the directory it changed to: the capture
# held that line above pwd's, and install wrote a project under a path holding
# a newline, at exit 0. So a relative path is spelled from ./, which cd reads
# from the current directory alone and never prints, and pwd's answer is read
# past a sentinel, so a name ending in a newline keeps it, as physical_dir's
# is (issues 0131, 0141, 0162). A leading // is spelled /, as there.
#
# Its locals carry its own prefix, as physical_dir's do.
logical_dir() {
  local _cld_dir="$1" _cld_d
  local -n _cld_res="$2"
  case "$_cld_dir" in
    /*) ;;
    *) _cld_dir="./$_cld_dir" ;;
  esac
  _cld_d="$(cd -L -- "$_cld_dir" && pwd -L && printf .)" || return 1
  _cld_d="${_cld_d%$'\n.'}"
  case "$_cld_d" in //*) _cld_d="${_cld_d#/}" ;; esac
  _cld_res="$_cld_d"
}

# colon_split <list> <out-array> -- the entries of a colon-separated list, PATH
# or GIT_CEILING_DIRECTORIES, into the array <out-array> names: one more entry
# than <list> has colons, so an empty entry, a trailing one and the one entry of
# an empty <list> are each kept, and a newline stays inside the entry it is in.
# What an empty or a relative entry means is each caller's own reading.
#
# THE ONE COLON SPLIT (issue 0248). Each site wrote out a `read -r -a` with IFS
# a colon, which reads one line and drops a trailing empty field: an entry
# holding a newline ended the list there, so use brew read Homebrew's bin after
# it as off PATH, git_ceiling and fullcycle's watch read nothing past it, and
# clean refused such a PATH as unreliable; and path_without handed back a PATH
# less its trailing empty entry, which a shell reads as the current directory.
#
# Its locals carry its own prefix, since <out-array> is a caller's name reached
# through bash's dynamic scope, and a local of the same name would take it. So
# an empty <out-array>, or one named with that prefix, is refused at rc 1 with a
# line on stderr, and nothing is set.
colon_split() {
  case "${2-}" in
    '' | _csp_*)
      printf "colon_split: cannot split into '%s': name an array outside its _csp_ prefix\n" "${2-}" >&2
      return 1
      ;;
  esac
  local _csp_rest="$1"
  local -n _csp_res="$2"
  _csp_res=()
  while [[ "$_csp_rest" == *:* ]]; do
    _csp_res+=("${_csp_rest%%:*}")
    _csp_rest="${_csp_rest#*:}"
  done
  _csp_res+=("$_csp_rest")
}

# is_wsl -- rc 0 when this session runs under WSL (ST0008), rc 1 otherwise,
# asked of _wsl_probe against /proc.
#
# FOR REPORTING ONLY. WSL is Linux, so no command behaves differently under it
# (ST0008); doctor asks this to say where a project sits, and
# nothing else may branch on it.
#
# DEVBIN_WSL overrides the probe, 1 for WSL and 0 for not, so an arm drives it
# on any machine. Any other value is refused rather than read as either.
is_wsl() {
  case "${DEVBIN_WSL-}" in
    1) return 0 ;;
    0) return 1 ;;
    '') _wsl_probe /proc ;;
    *) die "DEVBIN_WSL must be 1 or 0, not '$DEVBIN_WSL'" ;;
  esac
}

# _wsl_probe <proc-root> -- rc 0 when <proc-root> carries WSL's own marks: its
# interop handler registered under sys/fs/binfmt_misc, as WSLInterop or, where
# systemd runs, WSLInterop-late; or `microsoft` in sys/kernel/osrelease. rc 1
# otherwise. The root is an argument so an arm reads a fixture's.
#
# THE STATED LIMIT: a Linux container on a WSL 2 kernel, Docker Desktop's
# among them, carries the kernel's release and reads as WSL.
_wsl_probe() {
  local rel=""
  [ -e "$1/sys/fs/binfmt_misc/WSLInterop" ] && return 0
  [ -e "$1/sys/fs/binfmt_misc/WSLInterop-late" ] && return 0
  if [ -r "$1/sys/kernel/osrelease" ]; then
    # A release with no final newline still sets rel, and a read that fails
    # leaves it empty, which reads as not WSL: this only ever reports.
    read -r rel <"$1/sys/kernel/osrelease" || true
  fi
  case "$rel" in *[Mm]icrosoft*) return 0 ;; esac
  return 1
}

# windows_drive_of <path> <mount-root> <out-var> -- rc 0, with the drive's
# mount point (eg /mnt/c) in <out-var>, when <path> is a Windows drive WSL
# mounts under <mount-root> or anything under one: <mount-root>/<one letter>,
# then / or nothing. rc 1 otherwise. Pure: the caller resolves <path> and
# <mount-root>, so a link onto a drive, or to the mount root, is read as what
# it reaches. Trailing slashes on <mount-root> are dropped, so / is a root.
#
# WSL mounts each drive at /mnt/<letter> unless /etc/wsl.conf moves the
# automount root, so the root is the caller's to pass rather than written here.
windows_drive_of() {
  local _wdo_root="$2" _wdo_rest
  local -n _wdo_out="$3"
  while [ "${_wdo_root%/}" != "$_wdo_root" ]; do _wdo_root="${_wdo_root%/}"; done
  case "$1" in
    "$_wdo_root"/[A-Za-z] | "$_wdo_root"/[A-Za-z]/*) ;;
    *) return 1 ;;
  esac
  _wdo_rest="${1#"$_wdo_root"/}"
  _wdo_out="$_wdo_root/${_wdo_rest:0:1}"
}

# stage_beside <file> <command> [args...] -- write what <command> prints into a
# temporary that will REPLACE <file>, and print the temporary's name.
# rename_staged <temporary> -- rename a temporary stage_beside printed over the
# file it will replace; on a failure, remove it.
# replace_file <file> <command> [args...] -- replace <file> with what <command>
# prints: staged beside it, then renamed over it.
#
# THE ONE HOME FOR "write a temporary, then rename it over the file" -- the
# temporary, the write into it, its mode, the rename and the cleanup, each of
# which every writer that replaced a file once had its own copy of:
#
# - THE TEMPORARY IS BESIDE THE FILE, NOT IN TMPDIR. A rename is atomic only
#   within one filesystem; across two, `mv` quietly copies, and a kill mid-copy
#   leaves the truncated file this pattern exists to rule out (issue 0002).
# - THROUGH A LINK, THE FILE IT NAMES IS REPLACED AND THE LINK SURVIVES. The
#   temporary is staged beside the file at the end of the link (follow_links),
#   so the rename stays on that file's filesystem, and rename_staged renames it
#   over that file, which the temporary's name records. Renamed over the link's
#   own path, it turned the link into a regular file holding the edit, while the
#   file the link named kept its old content and the writer exited 0 (issue
#   0084). So a caller renaming a staged temporary itself renames it with
#   rename_staged, never over the path it staged.
# - IT HAS THE FILE'S MODE. mktemp creates 0600, and the rename carries that
#   onto the file, so every writer that renamed a temporary into place left a
#   0644 file 0600 -- CHANGELOG.md and RELEASES.md were, on the machine that
#   generated them, with nothing to show it, since git records only the
#   executable bit. `cp -p` gives the temporary the file's mode before the
#   write; a file that does not exist yet gets the mode the umask gives a new
#   file.
# - A READ-ONLY FILE IS STILL REPLACED, AND KEEPS ITS MODE. Copied first, a 0444
#   file's mode made its temporary 0444 too, and the write into it was refused
#   (ST0007 WP-02). So the owner's write bit is added for the write when the
#   copied mode lacks it, and taken away again after. The mode is never READ,
#   which keeps this off stat, whose flags differ between BSD and GNU.
# - ON A FAILURE IT RETURNS, THE FILE IS UNTOUCHED AND THE TEMPORARY REMOVED,
#   and a failure of the mechanics is named here, so a caller adds only what it
#   was doing. A failing <command> names its own failure. These still leave a
#   temporary beside the file: a process killed before the rename, and a file
#   flag that `cp -p` copies onto the temporary -- BSD's uchg refuses the write
#   and the removal alike, so the helper returns 1 and rm's own error names the
#   temporary (measured, ST0007 WP-02).
stage_beside() {
  local file tmp restore=""
  # The x keeps a name that ends in a newline, which a bare capture strips, and
  # the temporary would then be staged for a different file.
  file="$(follow_links "$1" && printf x)" || return 1
  file="${file%$'\n'x}"
  shift
  if ! tmp="$(mktemp "${file}.XXXXXX")"; then
    warn "could not create a temporary file beside $file"
    return 1
  fi
  if [ -e "$file" ]; then
    if ! cp -p "$file" "$tmp"; then
      rm -f "$tmp"
      warn "could not give the temporary file $file's mode"
      return 1
    fi
    if [ ! -w "$tmp" ]; then
      if ! chmod u+w "$tmp"; then
        rm -f "$tmp"
        warn "could not make the temporary file for $file writable"
        return 1
      fi
      restore=u-w
    fi
  elif ! chmod "$(printf '%o' "$((0666 & ~$(umask)))")" "$tmp"; then
    rm -f "$tmp"
    warn "could not give the temporary file for $file a new file's mode"
    return 1
  fi
  if ! "$@" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [ -n "$restore" ] && ! chmod "$restore" "$tmp"; then
    rm -f "$tmp"
    warn "could not give the temporary file $file's mode back"
    return 1
  fi
  printf '%s\n' "$tmp"
}

# The file is the temporary's name without mktemp's six characters, which is
# where stage_beside staged it: through a link, not the link's path.
#
# `-f` IS NOT DEFENSIVE, IT IS WHAT STOPS THIS BLOCKING FOREVER ON A TERMINAL.
# POSIX mv prompts when the destination exists, permissions do not allow writing
# it, and stdin is a tty -- and a replace of a READ-ONLY file is exactly that
# case, which is the one stage_beside goes to the most trouble to support. With
# no tty the prompt never appears, so every unattended and CI run of the suite
# passed while `bin/devbin test all` from a human's terminal stopped dead at
# `replace_file replaces a read-only file` and stayed quiet for eight hours.
# A false green that is green for everyone who can see it.
# lib/install:379 already wrote `mv -f` for its own rename; this one had not.
rename_staged() {
  local file="${1%.??????}"
  if ! mv -f "$1" "$file"; then
    rm -f "$1"
    warn "could not rename the temporary file over $file"
    return 1
  fi
}

replace_file() {
  local tmp
  tmp="$(stage_beside "$@")" || return 1
  rename_staged "$tmp"
}

# file_immutable <file> -- rc 0 when <file> carries the immutable flag, which no
# write, rename or removal gets past while it is set: `uchg` or `schg` on
# macOS, `i` on Linux. rc 1 when it does not, or its filesystem keeps no such
# flag; rc 2 when this machine has no reader for it (no lsattr), so that a
# caller says so rather than passing it (issue 0279).
#
# EACH PLATFORM IS ASKED IN ITS OWN SPELLING. macOS's flags are read with its
# own /usr/bin/stat, by path, since GNU's `stat -f` on PATH is a filesystem's
# status and no file's flags; only hex digits are an answer, UF_IMMUTABLE
# (0x2) and SF_IMMUTABLE (0x20000) the bits asked. Linux's are lsattr's
# first field.
file_immutable() {
  local out
  case "$(uname -s 2>/dev/null)" in
    Darwin | *BSD)
      out="$(/usr/bin/stat -f %Xf -- "$1" 2>/dev/null)" || return 2
      [[ "$out" =~ ^[0-9A-Fa-f]+$ ]] || return 2
      (((16#$out & 16#20002) != 0)) && return 0
      return 1
      ;;
    *)
      command -v lsattr >/dev/null 2>&1 || return 2
      # A filesystem lsattr cannot ask, tmpfs or overlayfs ("Inappropriate
      # ioctl"), keeps no flag lsattr sets, so the file is not immutable there;
      # saying it could not be checked would put a warning in every write.
      out="$(lsattr -d -- "$1" 2>/dev/null)" || return 1
      [[ "${out%% *}" == *i* ]] && return 0
      return 1
      ;;
  esac
}

# replace_problem <why|fix> <file> -- when replace_file could not replace
# <file>: rc 0 with why, as one clause, or what to do about it; rc 1, printing
# nothing, when it could (issue 0260).
#
# IT ASKS WHAT stage_beside NEEDS, AND NOTHING ELSE: a link it can follow to
# the file, that file readable where it exists, since it is copied and read,
# and the file's directory one that takes a new file and a rename. The file's
# own write bit is not asked: a read-only file is still replaced, and keeps its
# mode (above).
#
# AND THAT THE FILE CAN BE REPLACED AT ALL (issue 0279). An immutable file
# cannot be, and `-w` cannot tell it from a read-only one, which can: one
# listed after a bare sidecar passed the preflight, and the write pass
# half-wrote the set, leaving an immutable temporary beside it under BSD.
# Where the flag cannot be read, that is said, on stderr, and the file is not
# refused for it.
replace_problem() {
  local file dir why fix imm=1
  if ! file="$(follow_links "$2" 2>/dev/null && printf x)"; then
    why="is a link devbin cannot follow to its file"
    fix="point the link at the file"
  else
    file="${file%$'\n'x}"
    dir="$(dirname -- "$file")"
    if [ -e "$file" ] && [ -r "$file" ]; then
      file_immutable "$file" && imm=0 || imm=$?
      [ "$imm" -ne 2 ] || [ "$1" != why ] ||
        warn "cannot tell whether $file is immutable, so it was not checked for that"
    fi
    if [ -e "$file" ] && [ ! -r "$file" ]; then
      why="cannot be read"
      fix="let devbin read it"
    elif [ "$imm" -eq 0 ]; then
      why="is immutable, so no write can replace it"
      fix="clear its immutable flag"
    elif [ ! -w "$dir" ] || [ ! -x "$dir" ]; then
      why="is in $dir, where devbin cannot make the copy it writes and renames over the file"
      fix="let devbin write in $dir"
    else
      return 1
    fi
  fi
  case "$1" in
    why) printf '%s\n' "$why" ;;
    fix) printf '%s\n' "$fix" ;;
  esac
}

# sed_inplace <expression> <file> -- edit a file in place, portably.
#
# `sed -i` is not portable: BSD sed (macOS) requires an argument to -i and GNU
# sed (Linux CI) refuses one. The corpus wrote `sed -i ''`, which is correct on
# a Mac and fails on Ubuntu. Writing through replace_file sidesteps the
# divergence and is atomic besides, which matters when the file being rewritten
# is the project's version.
sed_inplace() {
  replace_file "$2" sed "$1" "$2"
}

# bump_semver <current> <major|minor|patch> -- print the next version.
#
# Byte-identical in every project it was folded from. Bumping a part zeroes
# everything to its right, which is semver's rule rather than a preference.
bump_semver() {
  local current="$1" part="$2" major minor patch
  assert_semver "$current"
  IFS='.' read -r major minor patch <<EOF
$current
EOF
  case "$part" in
    major) printf '%d.0.0\n' "$((major + 1))" ;;
    minor) printf '%d.%d.0\n' "$major" "$((minor + 1))" ;;
    patch) printf '%d.%d.%d\n' "$major" "$minor" "$((patch + 1))" ;;
    *) die "invalid bump part '$part' (use major, minor or patch)" ;;
  esac
}

# semver_gt <a> <b> -- true when X.Y.Z <a> is greater than <b>, part by part,
# numerically (base 10, so a leading zero is not octal). 1 when it is not, and
# 2 when either is not X.Y.Z: "not greater" and "not a version" are different
# answers, and an ordering guessed from text would put 1.10.0 below 1.9.0.
semver_gt() {
  local a1 a2 a3 b1 b2 b3
  is_semver "${1:-}" && is_semver "${2:-}" || return 2
  IFS=. read -r a1 a2 a3 <<<"$1"
  IFS=. read -r b1 b2 b3 <<<"$2"
  if ((10#$a1 != 10#$b1)); then ((10#$a1 > 10#$b1)); return; fi
  if ((10#$a2 != 10#$b2)); then ((10#$a2 > 10#$b2)); return; fi
  ((10#$a3 > 10#$b3))
}

# abs_path <path> -- absolutise against the project root, leaving absolutes be.
#
# Present in only some projects and PROMOTED by the WP-05 fold: it is four
# lines, has no dependencies, and the projects that lacked it were simply the
# ones that had not needed it yet. A verdict line printing a relative path is
# not clickable in a terminal, which is the whole reason it exists.
abs_path() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "${PROJECT_ROOT:-.}" "$1" ;;
  esac
}

# cargo_root_problem <project-root> <value> -- why `project.cargo_root` cannot
# be <value>, printed, true when there is a problem; false, printing nothing,
# when <value> names a directory below <project-root> holding a Cargo.toml.
#
# ONE RULE FOR BOTH PLACES THAT JUDGE THE VALUE (issue 0225): cfg_validate
# refuses it for `doctor` and `release`, and cargo_root refuses it at the run, so
# the two cannot accept different values. The path is named, since the value is
# what the project typed and the path is where devbin looked.
cargo_root_problem() {
  local root="$1" value="$2"
  case "$value" in
    '')
      printf 'is empty -- name the directory holding the workspace Cargo.toml, relative to the project root\n'
      return 0
      ;;
    /*)
      printf 'is absolute -- name the directory relative to the project root\n'
      return 0
      ;;
  esac
  if [ ! -d "$root/$value" ]; then
    printf 'names %s, which is not a directory\n' "$root/$value"
    return 0
  fi
  if [ ! -f "$root/$value/Cargo.toml" ]; then
    printf 'names %s, which holds no Cargo.toml\n' "$root/$value"
    return 0
  fi
  return 1
}

# cargo_root -- the directory devbin runs its catalogue's cargo lines in: the
# project root, or the one `project.cargo_root` names below it (issue 0225).
#
# THE ONE OWNER OF THAT DIRECTORY. The run path (catalogue_line_root, below),
# dormancy, and check targetdir's shared tree ask this function, and none of
# them reads the setting. The dispatcher exports DEVBIN_CARGO_ROOT, the value as
# written, only when config declares it, since lib/helpers reads no config and
# a handler is a separate process. Unset is the setting absent, and the answer
# is then the project root exactly as it was before the setting existed. Set,
# the value is judged by cargo_root_problem on every call, so a Cargo.toml moved
# away since the config was validated is refused here rather than handed to
# cargo as a directory with no manifest.
cargo_root() {
  local why
  if [ -z "${DEVBIN_CARGO_ROOT+set}" ]; then
    printf '%s\n' "$PROJECT_ROOT"
    return 0
  fi
  if why="$(cargo_root_problem "$PROJECT_ROOT" "$DEVBIN_CARGO_ROOT")"; then
    warn "project.cargo_root '$DEVBIN_CARGO_ROOT' $why"
    return 1
  fi
  printf '%s/%s\n' "$PROJECT_ROOT" "${DEVBIN_CARGO_ROOT%/}"
}

# catalogue_line_root <language> -- the directory a catalogue command line of
# <language> runs in: cargo_root for rust, whose every catalogue line is a cargo
# line (fmt rust, check clippy, test rust, and check format's rust arm derived
# from fmt rust's), and the project root for every other language. Asked by the
# catalogue's runner (run_builtin_gate), check format and dormancy, each with the
# row's language, so no list of the cargo lines exists to fall behind the
# catalogue. A project's own `run:` is never asked about: it runs at the project
# root, as it always has.
catalogue_line_root() {
  case "$1" in
    rust) cargo_root ;;
    *) printf '%s\n' "$PROJECT_ROOT" ;;
  esac
}

# version_line <file> -- where read_version reads <file>'s version, for the
# kinds whose recipe rewrites one line: the line's number, a tab, and the
# version it holds, and for npm a tab and which `"version": "..."` pair on the
# line it is, counted as the recipe's sed counts them; nothing, and rc 1, where
# there is none (issue 0263).
#
# THE ONE ANSWER TO WHICH LINE. read_version reads the version from that line,
# and version set's recipe rewrites that line and no other, so a reader and a
# writer cannot mean different lines: the recipes rewrote every line that
# looked like a version, a dependency table's included, at exit 0, while the
# reader read the first.
#
#   cargo  the first `version = "..."` line, and only in the [package] or
#          [workspace.package] table, where cargo writes it. A manifest whose
#          first version line is elsewhere, a dependency's say, holds no
#          version devbin reads, and nor does one that gives the version
#          otherwise: a dotted `package.version` key, an inline table, or
#          `version.workspace = true`, which inherits the workspace's. A
#          table header is read only outside an array: a line inside a
#          multi-line array value opening with `[` is an element (issue
#          0281), so the brackets of each value outside its strings and
#          comment are counted until the array closes.
#   mix    the first `version: "..."` line, as `def project` writes it.
#   npm    the `"version"` key of the top-level object, wherever it sits on
#          its line (issue 0280): the file is read token by token, its
#          strings skipped, and the object's depth counted, so a nested
#          `"version"` is never read and a one-line package.json is.
version_line() {
  local prog line
  # Single-quoted on purpose: awk expands these programs' fields, not the shell.
  # shellcheck disable=SC2016
  case "$(version_kind "$1")" in
    cargo)
      prog='function brackets(s,   i, c, q, d) {
  d = 0; q = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (q != "") {
      if (c == "\\" && q == "\"") { i++; continue }
      if (c == q) q = ""
      continue
    }
    if (c == "\"" || c == sq) { q = c; continue }
    if (c == "#") break
    if (c == "[") d++
    else if (c == "]") d--
  }
  return d
}
BEGIN { sq = sprintf("%c", 39) }
depth > 0 { depth += brackets($0); if (depth < 0) depth = 0; next }
/^[[:space:]]*\[/ { t = $0; sub(/^[[:space:]]*\[+[[:space:]]*/, "", t); sub(/[[:space:]]*\].*$/, "", t); next }
/^version *= *"/ { if (t == "package" || t == "workspace.package") print NR "\t" $2; exit }
/=/ { v = $0; sub(/^[^=]*=/, "", v); depth += brackets(v); if (depth < 0) depth = 0 }'
      ;;
    mix) prog='/^ *version: *"/ { print NR "\t" $2; exit }' ;;
    npm)
      prog='{
  s = $0; n = length(s); occ = 0
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (instr) {
      if (c == "\\") { i++; continue }
      if (c != "\"") continue
      instr = 0
      if (substr(s, start, i - start) != "version") continue
      rest = substr(s, i + 1)
      if (!match(rest, /^[[:space:]]*:[[:space:]]*"/)) continue
      occ++
      if (depth != 1) continue
      rest = substr(rest, RLENGTH + 1)
      match(rest, /^[^"]*/)
      print NR "\t" substr(rest, 1, RLENGTH) "\t" occ
      exit
    }
    if (c == "\"") { instr = 1; start = i + 1 }
    else if (c == "{" || c == "[") depth++
    else if (c == "}" || c == "]") depth--
  }
}'
      ;;
    *) return 1 ;;
  esac
  line="$(awk -F'"' "$prog" "$1" 2>/dev/null)" || return 1
  [ -n "$line" ] || return 1
  printf '%s\n' "$line"
}

# read_version [file] [role] -- the project version, or `unknown`.
#
# THE DRIFT: most projects read a VERSION file; one reads the version out of
# mix.exs. Neither is wrong -- an Elixir project's version genuinely lives in
# mix.exs, and duplicating it into a VERSION file would be two sources of truth.
#
# So the answer is not "pick one" but "the file is config, the extraction is
# library". `project.version_from` names the file; the case below knows how to
# read each kind. That keeps the YAML declarative (a name, not a recipe)
# while the knowledge of how a mix.exs states its version lives in code, where
# it can be tested.
#
# The roles mirror write_version_into's, and they scope the issue-0002 guard:
# with no arguments this reads the file `version_from` names, whose whole
# content IS the version by declaration -- second-guessing it turned a
# hand-authored `v1.2.3` into `unknown`. An explicit <file> is a SIDECAR read
# unless <role> says `version-file`, and there the bare-version fallback is
# devbin GUESSING about a file kind it has no recipe for, which is exactly where
# the guard belongs.
#
# No newline, matching the corpus: callers interpolate it into their own format.
#
# shellcheck disable=SC2120  # the bare call IS the point: it selects the
# version-file role, which is the documented default above and not an omission.
# Callers that pass a <file> are reading a SIDECAR; both forms are real and
# in-file analysis cannot see the sidecar callers, which live in lib/cmd/version.
read_version() {
  local file="${1:-${DEVBIN_VERSION_FILE:-VERSION}}" role path v="" pb
  if [ $# -ge 1 ]; then role="${2:-sidecar}"; else role=version-file; fi
  path="$(version_path "$file")"
  if [ -f "$path" ]; then
    case "$(version_kind "$path")" in
      # The line version_line names, and its version (issue 0263). cargo is
      # named last, before the parenthesis: as a word after `| ` it reads as a
      # cargo command to fullcycle.bats' scan of what lib/helpers runs (0165).
      mix | npm | cargo)
        v="$(version_line "$path")" || v=""
        v="${v#*$'\t'}"
        v="${v%%$'\t'*}"
        ;;
      # Added by WP-17 so this stays the ONE reader. `version check` needs to
      # read a plist sidecar, and giving it its own extractor would put two
      # patterns on one file kind -- which is how a reader and a writer come to
      # disagree about which line they mean.
      plist)
        if pb="$(plistbuddy_path)"; then
          v="$("$pb" -c "Print :CFBundleShortVersionString" "$path" 2>/dev/null)" || v=""
        fi
        ;;
      # The bare-version default reads the WHOLE file, so a file devbin has no
      # recipe for yields its entire contents as the "version" -- a Cargo.lock
      # read back as `#Thisfileis@generatedbyCargo.version=3[[package]]...`,
      # which `version check` then reported as drift against every real version
      # forever (issue 0002). `unknown` is the honest answer and the one every
      # caller here already handles. SIDECAR reads only -- see the role note in
      # the header for why the version file itself reads raw.
      *)
        # stderr goes away before the file is opened: redirects are made in
        # order, so a file that cannot be opened would print bash's own error.
        v="$(tr -d '[:space:]' 2>/dev/null <"$path")" || v=""
        if [ "$role" = sidecar ]; then
          is_bare_version "$v" || v=""
        fi
        ;;
    esac
  fi
  [ -n "$v" ] || v=unknown
  printf '%s' "$v"
}

# version_kind <file> -- the kind of version file <file> is, by its name: cargo
# (Cargo.toml), mix (mix.exs), npm (package.json), plist (*.plist), or bare, a
# file holding the version and nothing else. Pure.
#
# THE ONE TABLE OF KINDS (issue 0259). read_version reads by it, version set
# writes by it (write_version_into), and version_unread fits its remedy to it,
# so a reader, a writer and the advice between them cannot disagree about what
# a file is.
version_kind() {
  case "${1##*/}" in
    Cargo.toml) printf 'cargo\n' ;;
    mix.exs) printf 'mix\n' ;;
    package.json) printf 'npm\n' ;;
    *.plist) printf 'plist\n' ;;
    *) printf 'bare\n' ;;
  esac
}

# version_path <file> -- where read_version reads <file>: as given when it is
# absolute, under the project root otherwise. One spelling, for read_version
# and for version_file_state, so the reason a version cannot be read is always
# about the file the reader read.
version_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "${PROJECT_ROOT:-.}/$1" ;;
  esac
}

# plistbuddy_path -- the PlistBuddy devbin runs, which reads and writes a
# plist's version: the first on PATH, as every other tool devbin runs is found,
# else macOS's own at /usr/libexec, which no PATH names; rc 1, printing
# nothing, where there is neither, off macOS (issue 0264). THE ONE SPELLING of
# where it is, for the reader, the writer, the drift report and the version
# file's state, so they cannot disagree about whether a plist can be handled.
plistbuddy_path() {
  command -v PlistBuddy 2>/dev/null && return 0
  [ -x /usr/libexec/PlistBuddy ] || return 1
  printf '%s\n' /usr/libexec/PlistBuddy
}

# version_file_state [file] [role] -- what stands at a version file, as one
# word: the one project.version_from names, or <file>, in <role>,
# `version-file` (the default) or `sidecar`, a file project.version_sidecars
# declares (issue 0259, 0265). It writes nothing.
#
#   reads      read_version reads a version from it
#   start      version file: nothing is there, it is of the bare kind, and
#              its directory takes a new file, so `version set` starts it
#   nodir      version file: nothing is there, it is of the bare kind, and its
#              directory is not there or cannot be written in
#   absent     version file: nothing is there, and it is of a structured kind,
#              which holds more than the version, so devbin never starts one
#   missing    sidecar: nothing is there
#   dangling   a link to no file
#   notfile    something there that is not a regular file, a directory say
#   noread     a file devbin may not read
#   notool     a plist where PlistBuddy, which reads one, is not: off macOS
#   noversion  a file its kind reads no version from: an empty VERSION, or a
#              structured file with no version devbin reads
#   empty      sidecar: a file of the bare kind holding nothing, which a
#              write fills, so `version sync` heals it
#   norecipe   sidecar: a file of the bare kind holding more than a version,
#              which devbin has no recipe for: the bare version written over
#              it would destroy what it holds
#
# ONE ANSWER FOR EVERY READER AND THE WRITER, IN EITHER ROLE (issue 0265).
# version show, version check, doctor and version set ask it, and say what it
# answers through version_unread, so no reader decides a state for itself and
# one state has one wording wherever it is reported. A failed read is never an
# empty file: noread is asked first.
version_file_state() {
  local file="${1:-${DEVBIN_VERSION_FILE:-VERSION}}" role="${2:-version-file}" path dir
  path="$(version_path "$file")"
  if [ -L "$path" ] && [ ! -e "$path" ]; then
    printf 'dangling\n'
  elif [ ! -e "$path" ]; then
    dir="$(dirname "$path")"
    if [ "$role" = sidecar ]; then
      printf 'missing\n'
    elif [ "$(version_kind "$file")" != bare ]; then
      printf 'absent\n'
    elif [ -d "$dir" ] && [ -w "$dir" ]; then
      printf 'start\n'
    else
      printf 'nodir\n'
    fi
  elif [ ! -f "$path" ]; then
    printf 'notfile\n'
  elif [ ! -r "$path" ]; then
    printf 'noread\n'
  elif [ "$(version_kind "$file")" = plist ] && ! plistbuddy_path >/dev/null; then
    printf 'notool\n'
  elif [ "$(read_version "$file" "$role")" != unknown ]; then
    printf 'reads\n'
  elif [ "$role" != sidecar ] || [ "$(version_kind "$file")" != bare ]; then
    printf 'noversion\n'
  elif [ -z "$(tr -d '[:space:]' 2>/dev/null <"$path")" ]; then
    printf 'empty\n'
  else
    printf 'norecipe\n'
  fi
}

# version_unwritten <why|fix> [file] -- when version set's write could not
# change the version file, the one project.version_from names or <file>, as it
# stands: rc 0 with why, as one clause, or what to do about it; rc 1, printing
# nothing, when it could (issue 0260). A file that is not there yet is
# version_file_state's question, not this one's.
#
# ASKED BY KIND, BECAUSE THE WRITES DIFFER. A bare file is written over by
# printf and a plist edited in place by PlistBuddy, so each must be writable.
# Cargo.toml, mix.exs and package.json are rewritten through replace_file, which
# asks replace_problem's question: a read-only one is still rewritten and keeps
# its mode, and one whose directory takes no new file is not.
version_unwritten() {
  local file="${2:-${DEVBIN_VERSION_FILE:-VERSION}}" path said
  path="$(version_path "$file")"
  [ -e "$path" ] || return 1
  case "$(version_kind "$file")" in
    bare | plist)
      [ ! -w "$path" ] || return 1
      case "$1" in
        why) printf 'cannot be written\n' ;;
        fix) printf 'let devbin write it\n' ;;
      esac
      ;;
    *)
      # A directory under the project is named from its root, as the file is.
      said="$(replace_problem "$1" "$path")" || return 1
      printf '%s\n' "${said//"${PROJECT_ROOT:-.}/"/}"
      ;;
  esac
}

# version_unread <why|fix|clause> [file] [role] [write] -- when a version file,
# the one project.version_from names or <file>, in <role> (version_file_state's
# roles), gives no version: rc 0 with why it does not, as one sentence naming
# the file and the key that names it (why), what to do about it (fix), or the
# reason alone (clause); rc 1, printing nothing, when it gives one (issue 0259).
#
# THE ONE WORDING, fitted to what stands at the file (version_file_state), to
# its kind and to its role (issue 0265). version show, version check, doctor
# and version set print it, so no two of them say different things about one
# file. The remedy names `version set` only where set would start or fill the
# file: a structured file holds more than the version, and set never writes one
# that holds only the number. read_version's `unknown` is for a line that shows
# the version as it stands; these readers never pass it on as a version.
#
# THE WRITER ASKS ONE THING MORE, AND LAST (issue 0260). With `write`, the
# writer's question, which set, bump and sync ask through apply_version and
# check asks of a sidecar it would tell sync to heal, it also answers for a
# file its write could not change (version_unwritten), after every other
# answer, so that remedy is never moot. A file set starts or fills is no
# refusal of its own there.
version_unread() {
  local file="${2:-${DEVBIN_VERSION_FILE:-VERSION}}" role="${3:-version-file}"
  local state ask=no set_it why fix dir elsewhere noun
  if [ "$role" = sidecar ]; then
    elsewhere="drop it from project.version_sidecars"
    noun=sidecar
  else
    elsewhere="point project.version_from at the file that holds the version"
    noun="version file"
  fi
  set_it="${DEVBIN_INVOKE:-bin/devbin} version set 0.1.0"
  state="$(version_file_state "$file" "$role")"
  if [ "${4:-}" = write ]; then
    case "$state" in
      reads | start | empty) ask=yes ;;
      noversion) [ "$role" = sidecar ] || [ "$(version_kind "$file")" != bare ] || ask=yes ;;
    esac
    if [ "$ask" = yes ]; then
      version_unwritten why "$file" >/dev/null || return 1
      state=nowrite
    fi
  fi
  case "$state" in
    reads) return 1 ;;
    start)
      why="does not exist"
      fix="start it with: $set_it"
      ;;
    nodir)
      dir="$(dirname "$file")"
      why="does not exist, and devbin cannot make a file in $dir"
      fix="make $dir, or $elsewhere"
      ;;
    absent)
      why="does not exist, and devbin never starts a $(basename "$file"), which holds more than the version"
      fix="create it with the project's version in it, or $elsewhere"
      ;;
    missing)
      why="does not exist"
      fix="fix the path, or $elsewhere: a sidecar silently skipped is how a tree drifts"
      ;;
    dangling)
      why="is a link to no file"
      if [ "$role" != sidecar ] && [ "$(version_kind "$file")" = bare ]; then
        fix="point the link at the $noun, or remove it and start one with: $set_it"
      else
        fix="point the link at the $noun, or $elsewhere"
      fi
      ;;
    notfile)
      why="is not a regular file"
      fix="move it aside, or $elsewhere"
      ;;
    noread)
      why="cannot be read"
      fix="let devbin read it, or $elsewhere"
      ;;
    notool)
      why="is a plist, and PlistBuddy, which reads one, is macOS-only"
      fix="do this on macOS, or $elsewhere"
      ;;
    noversion)
      if [ "$(version_kind "$file")" = bare ]; then
        why="holds no version"
        fix="set one with: $set_it"
      else
        why="holds no version devbin reads"
        fix="add the project's version to it, or $elsewhere"
      fi
      ;;
    empty)
      why="holds nothing"
      fix="fill it with: ${DEVBIN_INVOKE:-bin/devbin} version sync"
      ;;
    norecipe)
      why="holds more than a version, and devbin has no recipe for this kind of file"
      fix="have the project's own command sync it, or $elsewhere"
      ;;
    nowrite)
      why="$(version_unwritten why "$file")"
      fix="$(version_unwritten fix "$file"), or $elsewhere"
      ;;
  esac
  case "$1" in
    why)
      if [ "$role" = sidecar ]; then
        printf '%s, declared in project.version_sidecars, %s\n' "$file" "$why"
      else
        printf '%s, the file project.version_from names, %s\n' "$file" "$why"
      fi
      ;;
    fix) printf '%s\n' "$fix" ;;
    clause) printf '%s\n' "$why" ;;
  esac
}

# sha256_files <file>... -- `<sum>  <path>` per file, in ONE process.
#
# The tool is spelled differently on the two platforms this ships to and neither
# name is universal: macOS has `shasum` and no `sha256sum`, a minimal Linux
# image usually has `sha256sum` and no perl to back `shasum`. Both accept many
# paths and both print `<sum>  <path>`, which is also the manifest's own line
# format -- so the batch form needs no reshaping at all.
#
# MANY files rather than one, because the caller is always checksumming a whole
# manifest. Per-file it was 26 forks per install and half the wall clock of the
# test suite, which runs an install per fixture.
# sha256_run [file]... -- THE one place that knows how this tool is spelled.
#
# EXTRACTED BECAUSE A SECOND COPY HAD ALREADY DIVERGED. A copy of the
# digest elsewhere called `shasum -a 256` directly, and `shasum` is the name
# that does NOT exist on a minimal Linux image -- the exact case the comment
# below was written to cover. The knowledge was documented in one place and
# re-implemented in another: the Highlander failure in its ordinary form, not
# two algorithms but two copies of one DECISION, only one carrying the fix.
#
# Both tools read stdin when given no operands, which is what makes one dispatch
# serve the file case and the stream case.
sha256_run() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$@"
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  else
    die "no sha256 tool found (looked for shasum and sha256sum)"
  fi
}

sha256_files() {
  [ $# -gt 0 ] || return 0
  sha256_run "$@"
}

# sha256_stdin -- SHA256 of stdin, bare hex, no trailing path field.
#
# `sha256_files` deliberately refuses an empty argument list rather than falling
# through to this behaviour, and the two are separate names for that reason: a
# checksum of nothing is a valid-looking hex string that no downstream reader
# can distinguish from a checksum of something.
sha256_stdin() {
  sha256_run | cut -d' ' -f1
}

# ---------------------------------------------------------------------------
# What makes a directory a cargo build tree, as clean classifies one (moved here
# unchanged from lib/cmd/clean, issue 0148: fullcycle asks the same question of
# a tree that kept its release artefacts, and a second answer to it drifted).
# The names keep clean's prefix, since the bodies moved byte for byte, and so do
# their comments: "this command" in them is clean, and the "no literal 2" is
# clean's rule for its handler's statuses, which the scan in contract.bats no
# longer reaches here (clean.bats' own arms still go red on it).
# ---------------------------------------------------------------------------

# _clean_shown <path> -- a path as this command prints it: as it is, or quoted
# for the shell when it holds any byte that is not printable ASCII (issue 0141).
# A newline in a listed name printed as two lines, the second looking like a
# tree of its own, in the very list a person reads before answering y; and a
# format character such as U+202E, which [[:cntrl:]] does not match, can make
# one name display as another. The class is read in the C locale, so every byte
# of a multibyte character counts.
_clean_shown() {
  local LC_ALL=C
  case "$1" in
    *[![:print:]]*) printf '%q' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# _clean_marked_without_read <dir> -- does <dir> carry a cargo marker that needs
# no read: a .rustc_info.json that is a regular file and no link, as find's
# -type f takes it, or a .fingerprint directory under debug/ or release/?
#
# ONE HOME FOR THE QUESTION (issue 0131). The walk and the classification each
# decided it, and disagreed: the walk skipped a tag only beside .rustc_info.json
# and classification beside a .fingerprint too, so a tree with an unreadable tag
# and a .fingerprint was a tree when found by name and PARTIAL when found by its
# tag; and the walk's [ -f ] followed a link that find's -type f does not, so a
# tag beside a symlinked .rustc_info.json was skipped for a candidate no other
# line would add.
_clean_marked_without_read() {
  { [ -f "$1/.rustc_info.json" ] && [ ! -L "$1/.rustc_info.json" ]; } ||
    [ -d "$1/debug/.fingerprint" ] || [ -d "$1/release/.fingerprint" ]
}

# _clean_cargo_tag <file> -- is this CACHEDIR.TAG cargo's? 0 yes; 1 no, or no
# such file; 3 when grep could not read it, which says neither, so the caller
# counts the scan as partial and grep's own error names the file (issue 0131).
# 3 and not grep's own 2: 3 is this file's code for a read it could not make,
# and 2 is the dispatcher's.
#
# Cargo's second line names it, and the WHOLE LINE is matched: "# This file is a
# cache directory tag created by cargo." Read off cargo 1.98.1's own output, and
# off real projects' target trees -- pytest's says "created by pytest" on the
# same line. So a line carrying cargo's sentence inside other text is not
# cargo's, and nor is one naming another tool.
#
# A SYMLINK IS NO TAG, as find's -type f already says in _clean_roots: were it
# followed here, a tag the scan never read would be read, and one that could not
# be would make no partial scan (issue 0131).
_clean_cargo_tag() {
  local rc=0
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  grep -qxF -- '# This file is a cache directory tag created by cargo.' "$1" || rc=$?
  if [ "$rc" -gt 1 ]; then
    # One that vanished between the test and the read is no tag, not an
    # unreadable one.
    [ -e "$1" ] || return 1
    return 3
  fi
  return "$rc"
}

# _clean_has_markers <dir> <name> <markers> -- does this directory carry build
# output? 0 yes; 1 no; 3 when it could not be read -- the directory itself, or
# the one tag that could have said yes -- which says neither. 3 and not 2: 2 is
# the dispatcher's code, and a handler under lib/cmd answers no literal 2.
#
# For cargo the markers are written by the tool itself and are reliable in a
# redirected target dir too. For _build and .build the toolchain writes no
# comparable tag, so the directory NAME carries that half and the manifest test
# carries the rest.
#
# A TREE FOUND BY NAME IS READ HERE AND NOWHERE ELSE, since the walk prunes at
# it (_clean_roots), so a directory or a tag that cannot be read is this
# function's to report: 3, and the scan counts as partial. The marker tests
# are file tests, false on "permission denied", so a mode-000 target/ holding
# every marker cargo writes was listed as unmarked at exit 0 with no word at all
# (issue 0131).
#
# THE MARKERS THAT NEED NO READ COME FIRST. Beside .rustc_info.json or a
# .fingerprint directory, a tag grep cannot read says nothing more, and reading
# it anyway printed grep's error over a passing result.
#
# A TREE HOLDING ONLY PER-NODE TARGET DIRS IS A BUILD TREE (issue 0131, with
# cargo 1.98.1). After `CARGO_TARGET_DIR=target/n1 cargo build`, target/ holds
# n1/ and nothing of cargo's at its own root, so it was listed as unmarked -- on
# a project where every builder builds that way -- and the trees inside it went
# unlisted, since the walk does not look inside a tree found by name. Its
# per-node directories are what mark it (_clean_peer_dirs).
_clean_has_markers() {
  local d="$1" name="$2" markers="$3" t=0 sub
  local -a peers=()
  # EVERY ARM, NOT CARGO'S ALONE: a mode-000 _build/ was listed as removable at
  # size ?, and --force then died on it, after removing whatever sorted before
  # it.
  if [ ! -r "$d" ] || [ ! -x "$d" ]; then
    warn "cannot read $(_clean_shown "$d"): it may be a build tree, and it is not classified"
    return 3
  fi
  if [ "$markers" = cargo ]; then
    _clean_marked_without_read "$d" && return 0
    _clean_cargo_tag "$d/CACHEDIR.TAG" || t=$?
    [ "$t" -ne 0 ] || return 0
    _clean_peer_dirs "$d" peers
    [ "${#peers[@]}" -eq 0 ] || return 0
    [ "$t" -ne 3 ] || return 3
    # NOTHING MARKS IT -- UNLESS A DIRECTORY THAT COULD HOLD A MARKER COULD NOT
    # BE SEARCHED. Each test above is false on "permission denied", so a target/
    # whose only marker is debug/.fingerprint, with debug/ unsearchable, read as
    # unmarked at exit 0: that is "could not tell", said as such. SEARCH
    # permission, not read: every marker test inside a directory needs only
    # that, so a search-only directory is looked in, and one that cannot be
    # searched is not.
    for sub in "$d"/*/; do
      [ -d "$sub" ] || continue
      if [ ! -x "$sub" ]; then
        warn "cannot search $(_clean_shown "${sub%/}"): a marker in it could not be looked for, so $(_clean_shown "$d") is not classified"
        return 3
      fi
    done
    return 1
  fi
  [ "${d##*/}" = "$name" ]
}

# _clean_peer_dirs <dir> -- per-node subdirectories inside a build tree.
#
# Several builders share one working tree and therefore one target/. Where they
# use CARGO_TARGET_DIR=target/<node> they each own a subdirectory, and one
# node's cache was 33 GB on the day this was specified. Removing the
# parent takes all of them, so they are NAMED before the prompt: whoever is
# mid-build deserves to see their own name in the list.
#
# A PER-NODE DIRECTORY IS A CARGO TARGET DIR OF ITS OWN, AND .rustc_info.json IS
# WHAT SAYS SO (issue 0131). This listed every lower-case subdirectory, so the
# SHARED warning fired on Mix's _build/dev, SwiftPM's .build/<triple> and
# cargo's own target/<triple> -- on nearly every project, which teaches a reader
# to skip the one case it exists for. Measured with cargo 1.98.1:
# a nested CARGO_TARGET_DIR carries CACHEDIR.TAG, .rustc_info.json and
# debug/.fingerprint; a --target triple directory carries the first and last
# and NOT .rustc_info.json, which cargo writes at a target dir's root only. So
# the test is that file. Mix's and SwiftPM's layouts never carry it, so the
# same test answers for their arms without naming them. A nested target dir
# need not be a builder's: any tool that points CARGO_TARGET_DIR inside target/
# makes one, and removing the parent costs it a rebuild all the same.
#
# THE LIMIT, MEASURED THE SAME DAY: a nested target dir built with
# CARGO_CACHE_RUSTC_INFO=0 has no .rustc_info.json, and its root then reads
# exactly as a triple directory's does, CACHEDIR.TAG and debug/ and nothing
# else. It is not named here and the SHARED warning does not fire for it;
# nothing on disk tells the two apart.
#
# The names go into the array <out-var>, whole (issue 0141): printed one per
# line and read back, a name holding a newline was two names.
_clean_peer_dirs() {
  local dir="$1" sub
  local -n _cpd_out="$2"
  for sub in "$dir"/*/; do
    cargo_target_root "${sub%/}" || continue
    sub="${sub%/}"
    _cpd_out+=("${sub##*/}")
  done
  return 0
}

# cargo_target_root <dir> -- true when <dir> is a cargo target dir's root by
# the file cargo writes there and nowhere else, .rustc_info.json (issue 0131,
# measured on cargo 1.98.1). The one test that tells a per-node target dir
# inside a tree (_clean_peer_dirs) from a target triple's (build_triple_dirs).
cargo_target_root() {
  [ -f "$1/.rustc_info.json" ]
}

# build_triple_dirs <dir> <out-var> -- the target-triple directories inside a
# cargo build tree, as `cargo build --target <triple>` makes them: a directory
# directly inside it, not a link and not the tree's own debug/ or release/,
# holding cargo's lock file, .cargo-lock, in its debug/ or release/, and not a
# target dir's root (cargo_target_root). The artefact check reads a profile in
# each beside the tree's own (issue 0168): a release built only under a triple
# read as missing, and one lost there read as fine. The lock file keeps out a
# directory of another shape, such as a test's executable under
# target/tmp/release; it is cargo's .fingerprint no longer, which cargo writes
# into build.build-dir when one is set, leaving a triple's profile with the lock
# file and its binaries (measured on cargo 1.99.0). A per-node directory built
# with CARGO_CACHE_RUSTC_INFO=0, or under a build.build-dir set to another
# directory, carries no .rustc_info.json and reads as a triple, the limit
# _clean_peer_dirs states.
# Names go into the array <out-var>, whole. Over a tree it cannot list, or a
# directory whose profiles it cannot search, it names nothing; the artefact
# check names those (_fullcycle_tree_listed).
build_triple_dirs() {
  local dir="$1" sub
  local -n _btd_out="$2"
  for sub in "$dir"/*/; do
    sub="${sub%/}"
    case "${sub##*/}" in debug | release) continue ;; esac
    [ ! -L "$sub" ] || continue
    ! cargo_target_root "$sub" || continue
    [ -e "$sub/debug/.cargo-lock" ] || [ -e "$sub/release/.cargo-lock" ] || continue
    _btd_out+=("${sub##*/}")
  done
  return 0
}

# cargo_target_dir_why <value> -- why the artefact check cannot examine a
# CARGO_TARGET_DIR of <value>, as one line; nothing when it can (issue 0148).
# cargo reads a relative value from the directory it runs in, which a caller
# cannot know, `./target` included; a value holding a newline is read a line at
# a time, as two paths; cargo refuses an empty one; and `/`, or any run of
# slashes alone, names no tree the check can read. Only an absolute value below
# the root can be examined. check targetdir refuses an empty value in these
# words too. Pure: fullcycle refuses on its answer before anything is removed,
# and asks cargo_tree_outside_why next. It judges a value, whichever carrier it
# came from: fullcycle asks it of CARGO_TARGET_DIR, of CARGO_BUILD_TARGET_DIR,
# and of each tree cargo names for a config (issue 0150).
cargo_target_dir_why() {
  case "$1" in
    '') printf '%s\n' "is empty, and cargo refuses an empty target directory" ;;
    *$'\n'*) printf '%s\n' "holds a newline, and the artefact check reads build trees a line at a time" ;;
    /*[!/]*) ;;
    /*) printf '%s\n' "is the filesystem root, which the artefact check cannot examine as a build tree" ;;
    *) printf '%s\n' "is relative, and cargo reads it from the directory it runs in, which fullcycle cannot know" ;;
  esac
}

# cargo_tree_outside_why <tree> <root> -- why a build tree at <tree> cannot be
# read as this cycle's: nothing when it lies beneath <root> (issue 0148). Reads
# the filesystem and writes nothing.
#
# THE VALUE IS JUDGED FIRST, BY cargo_target_dir_why, so one value has one
# verdict wherever it is asked (issue 0166). This held a guard of its own that
# knew only "not absolute", and tidied `/` to an empty string, which
# cargo_place answered with a 3 that nothing here read: the filesystem root,
# under any number of slashes, came out "outside the project". No caller met
# it, since each asks cargo_target_dir_why first; a direct question did.
#
# A TREE OUTSIDE THE PROJECT IS NOT REMOVED BY THE CLEAN, which is
# project-scoped, so the artefact check read the last cycle's release
# artefacts in it as this cycle's: a debug-only build passed at rc 0, the very
# signature the check exists for. That is older than 0148 -- cargo_target_dirs
# has returned CARGO_TARGET_DIR since 0139. Judging artefacts newer than the
# cycle's start does not replace it: cargo leaves a fresh release binary's
# mtime as it was (measured, cargo 1.98.1), so a no-op build would read as lost.
#
# OUTSIDE IS NEVER SWEPT; INSIDE IS NOT PROMISED. This refuses only what the
# clean can never remove. Whether it removed a tree inside the project is read
# after it has run, from the tree itself (_fullcycle_kept_release), since the
# clean removes a tree only beside a Cargo.toml and outside .git, node_modules
# and .direnv, and a prediction of that here was a second model of the clean,
# and wrong.
#
# PLACED AS IT RESOLVES, by identity. The tree need not exist before the
# build, so its longest existing ancestor is resolved by physical_dir and the
# rest appended; a link inside the project to a directory outside it is not
# followed by the clean's find, so a tree beneath one is outside. Containment
# is asked with -ef up the resolved ancestor, not by comparing text: /var and
# /private/var name one directory on macOS, and APFS ignores case, so a value
# spelled either way was refused though it is the project's. The rest may hold
# no `.` or `..`, since where those land beneath a directory that does not
# exist yet cannot be read. <root> itself is no tree the clean removes either.
cargo_tree_outside_why() {
  local t="$1" root="$2" pa x shown why rc=0
  # THE VALUE FIRST, in cargo_target_dir_why's words: empty, holding a newline,
  # the root, or relative, which the walk up below never ends on (a relative
  # value spun it for 11 minutes). What passes is absolute and below the root.
  why="$(cargo_target_dir_why "$t")"
  if [ -n "$why" ]; then
    printf '%s\n' "$why"
    return 0
  fi
  while [[ "$t" == *//* ]]; do t="${t//\/\//\/}"; done
  t="${t%/}"
  cargo_place "$t" pa || rc=$?
  # ONLY 0 GOES ON TO THE WALK (issue 0166): a status read by no branch here
  # walked an empty path to "outside", as the root's 3 did. A 3, a path that is
  # not absolute, cannot follow the value check above; it, and any status
  # cargo_place may come to return, is named by its number and never walked.
  case "$rc" in
    0) ;;
    2)
      printf '%s\n' "names . or .. beneath a directory that does not exist yet, so where it lands cannot be known"
      return 0
      ;;
    1)
      printf -v shown '%q' "$pa"
      printf '%s\n' "cannot be placed: $shown cannot be entered, so where it resolves cannot be known"
      return 0
      ;;
    *)
      printf -v shown '%q' "$t"
      printf '%s\n' "cannot be placed: cargo_place answered $rc for $shown, a status this does not read"
      return 0
      ;;
  esac
  if [ "$pa" -ef "$root" ]; then
    printf '%s\n' "is the project root, which the clean does not remove, and the release artefacts left there would read as this cycle's"
    return 0
  fi
  x="$pa"
  while :; do
    [ "$x" -ef "$root" ] && return 0
    _path_parent x || break
  done
  if [ "$pa" = "$t" ]; then
    printf '%s\n' "is outside the project, which the clean does not reach, and the release artefacts left there would read as this cycle's"
  else
    printf -v shown '%q' "$pa"
    printf '%s\n' "resolves to $shown, outside the project, which the clean does not reach, and the release artefacts left there would read as this cycle's"
  fi
}

# cargo_place <path> <out-var> -- <path>, absolute, placed as it resolves, into
# <out-var>: its longest existing ancestor resolved by physical_dir, the rest
# appended as written (issue 0150; cargo_tree_outside_why's until then). The
# one statement of where a tree devbin did not make lands: the path need not
# exist, as a build tree before its build does not. 1 when the ancestor cannot
# be entered, <out-var> then holding it; 3, at once, when <path> is not
# absolute; 2 when the rest names . or ..,
# since where those land beneath a directory that does not exist yet cannot be
# read. A `..` in the existing part is the kernel's, and is resolved with it,
# so cargo's `native/cli/../../target` is placed at the project's target.
#
# GETCWD, an optional third argument, places the existing part as the
# filesystem spells it (physical_dir's getcwd), not as it was typed: on a
# case-insensitive volume the two differ, and a caller comparing against a path
# another tool recorded, as macos does against Launch Services' records (issue
# 0243), needs the filesystem's.
cargo_place() {
  local _cp_t="$1" _cp_a _cp_rest="" _cp_pa
  local -n _cp_out="$2"
  # An absolute path only, returning 3 at once for any other: the walk up
  # below never ends on one with no leading /.
  case "$_cp_t" in
    /*) ;;
    *)
      _cp_out="$_cp_t"
      return 3
      ;;
  esac
  _cp_a="$_cp_t"
  while [ -n "$_cp_a" ] && [ ! -e "$_cp_a" ] && [ ! -L "$_cp_a" ]; do
    _cp_rest="${_cp_a##*/}${_cp_rest:+/$_cp_rest}"
    _cp_a="${_cp_a%/*}"
  done
  [ -n "$_cp_a" ] || _cp_a=/
  case "/$_cp_rest/" in
    */./* | */../*)
      _cp_out="$_cp_t"
      return 2
      ;;
  esac
  if ! physical_dir "$_cp_a" _cp_pa "${3-}"; then
    _cp_out="$_cp_a"
    return 1
  fi
  _cp_out="${_cp_pa%/}${_cp_rest:+/$_cp_rest}"
  [ -n "$_cp_out" ] || _cp_out=/
}

# _path_parent <var> -- the directory above the absolute path in <var>, into
# it; 1 at /. The one step every walk up a path takes (issue 0150).
_path_parent() {
  local -n _pp_p="$1"
  [ "$_pp_p" != / ] || return 1
  _pp_p="${_pp_p%/*}"
  [ -n "$_pp_p" ] || _pp_p=/
}

# build_tree_rebuildable <tree> <manifest> -- 0 when <manifest> sits beside
# <tree>, on the path as given: clean's own test of a tree it can rebuild, and
# so of one it removes (issue 0167). One test for clean, which removes such a
# tree, fullcycle, which reads one it cannot as kept, and check targetdir,
# whose shared tree is <root>/target only where clean removes it: check named
# it shared without one, and passed a nested crate's CARGO_TARGET_DIR that
# clean never removes and fullcycle then failed.
build_tree_rebuildable() {
  local t="${1%/}"
  [ -f "${t%/*}/$2" ]
}

# cargo_tree_same <a> <b> -- true when two build trees are one: the same text,
# or the same directory where both exist. Compare trees as cargo_place placed
# them, since cargo does not tidy a `..`. check targetdir's until issue 0164,
# which put fullcycle's question about the machine's config to it too.
cargo_tree_same() {
  [ "$1" = "$2" ] || { [ -e "$1" ] && [ "$1" -ef "$2" ]; }
}

# cargo_tree_cause <tree> <project-tree> <machine-tree> -- which config sends a
# crate's build tree to <tree>, all three placed: `project` when it is the tree
# the project root's config names (cargo_project_tree), else `machine` when it
# is where the machine's config alone sends every crate (cargo_home_build_dir),
# else nothing, a config this does not read. The project's first, as cargo puts
# it before the machine's. The one attribution, check targetdir's until issue
# 0164: fullcycle's refusal asked only for the machine's, so a tree both
# configs name was "the machine's" there while check targetdir failed it as
# the project's.
cargo_tree_cause() {
  if [ -n "$2" ] && cargo_tree_same "$1" "$2"; then
    printf 'project\n'
  elif [ -n "$3" ] && cargo_tree_same "$1" "$3"; then
    printf 'machine\n'
  fi
  return 0
}

# cargo_home_dir -- CARGO_HOME, or cargo's default, ~/.cargo, with no trailing
# slash: the one statement of where the machine's cargo config lives (issue
# 0150).
cargo_home_dir() {
  local h="${CARGO_HOME:-$HOME/.cargo}"
  printf '%s\n' "${h%/}"
}

# cargo_config_file <dir> -- the config file cargo reads in the config
# directory <dir>, a .cargo or CARGO_HOME, or nothing when it reads none:
# `config` where it can be opened, else `config.toml` where it is there at all.
# Measured on cargo 1.99.0, in CARGO_HOME and in a project's .cargo alike: with
# both there it reads `config`, warning, even a `config` that names nothing; a
# `config` it cannot open, or a dangling link, it passes over in silence; and a
# config.toml it cannot read, it fails on. The one statement of which file
# that is (issue 0164): check targetdir read config.toml first, so it named,
# and took the value of, a file cargo ignores.
cargo_config_file() {
  if [ -r "${1%/}/config" ]; then
    printf '%s\n' "${1%/}/config"
  elif [ -e "${1%/}/config.toml" ]; then
    printf '%s\n' "${1%/}/config.toml"
  fi
  return 0
}

# cargo_config_target_dir <file> -- the build.target-dir a cargo config file
# sets, as its text reads, or nothing; the first such line. It names a cause and
# decides nothing: cargo's answer is the verdict (issue 0150). It reads the
# plain spelling only, `target-dir = "..."`; the machine's config is placed by
# asking cargo (cargo_home_build_dir), whatever its spelling. check targetdir's
# own until issue 0164, which puts the project's config to fullcycle too, under
# errexit: sed quits at the first match rather than feeding `head -1`, which
# could end it on a SIGPIPE with a value already read.
cargo_config_target_dir() {
  sed -n '/^[[:space:]]*target-dir[[:space:]]*=[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/{s//\1/p;q;}' "$1"
}

# cargo_project_tree <file-var> <value-var> <tree-var> -- the project root's
# cargo config, the file cargo reads there (cargo_config_file), when it names
# build.target-dir; the value it sets (as cargo_config_target_dir reads it); and
# the tree that value places, from the project root as cargo reads a relative
# one: into the three, each empty when it names none. One reading for check
# targetdir, which fails a fork this config makes, and fullcycle, whose refusal
# names it (issue 0164). It took the first of config.toml and config to name a
# value, so with both there it named, and placed, a file cargo ignores (issue
# 0176). A file that cannot be read names nothing here; cargo, asked, names why.
cargo_project_tree() {
  local -n _cpt_f="$1" _cpt_v="$2" _cpt_t="$3"
  local _cpt_c _cpt_x="" _cpt_p
  _cpt_f="" _cpt_v="" _cpt_t=""
  _cpt_c="$(cargo_config_file "$PROJECT_ROOT/.cargo")"
  if [ -n "$_cpt_c" ] && [ -f "$_cpt_c" ] && [ -r "$_cpt_c" ]; then
    _cpt_x="$(cargo_config_target_dir "$_cpt_c")" || _cpt_x=""
  fi
  [ -n "$_cpt_x" ] || return 0
  _cpt_f="$_cpt_c" _cpt_v="$_cpt_x"
  case "$_cpt_v" in /*) _cpt_p="${_cpt_v%/}" ;; *) _cpt_p="$PROJECT_ROOT/${_cpt_v%/}" ;; esac
  cargo_place "$_cpt_p" _cpt_t || _cpt_t="$_cpt_p"
}

# cargo_env_carrier -- the name of the environment variable that decides
# cargo's build tree, set at all, empty included: CARGO_TARGET_DIR, which cargo
# puts first, or else CARGO_BUILD_TARGET_DIR; nothing when neither is set
# (measured, cargo 1.98.1). The one statement of their precedence (issue 0150).
cargo_env_carrier() {
  if [ -n "${CARGO_TARGET_DIR+x}" ]; then
    printf 'CARGO_TARGET_DIR\n'
  elif [ -n "${CARGO_BUILD_TARGET_DIR+x}" ]; then
    printf 'CARGO_BUILD_TARGET_DIR\n'
  fi
}

# cargo_walk <find expression> -- find_walk over this project with the prunes
# every cargo walk shares: somebody else's crates and trees, never this
# project's (issue 0150; cargo_target_dirs' walk until then). find_walk's
# status.
cargo_walk() {
  # find-status: returned to the caller, and each caller reads it.
  find_walk "${PROJECT_ROOT:-.}" -ignore_readdir_race \
    \( -name .git -o -name node_modules -o -name .direnv \
       -o -name deps -o -name _build -o -name .venv \) -prune -o "$@"
}

# cargo_carrier_present <dir> -- 0 when a cargo config that could move the
# build tree of the crate in <dir> is present: a .cargo/config.toml or
# .cargo/config naming target-dir in <dir> or any directory above it, or a
# config.toml or config naming it in CARGO_HOME (issue 0150).
#
# PRESENCE ONLY: it asks whether a file names the key, never what the key
# sets, so cargo stays the one resolver (cargo_build_dir): it decides WHETHER
# cargo is asked, never WHERE the tree is. The match is safe
# because every spelling of the key holds the literal `target-dir`: dotted as
# build.target-dir, under a [build] table, or quoted. It fails open: a file
# that cannot be read is present, for cargo to answer, and a comment naming
# the key only asks cargo, which then answers the default. A file naming
# `include` opens it too, since the file it includes may name the key. With
# none present, cargo builds a crate into its workspace's own target, which
# the walk finds, and nothing asks cargo: a project with no carrier is
# untouched by 0150, and needs no cargo. The environment's two carriers are the caller's to read, since
# either decides the tree over any config.
cargo_carrier_present() {
  cargo_config_above "$1" && return 0
  cargo_config_in_home && return 0
  return 1
}

# cargo_config_above <dir> [--not-home] -- 0 when a .cargo/config.toml or
# .cargo/config naming target-dir or include sits in <dir> or any directory
# above it: the gate's walk up, CARGO_HOME aside. With --not-home, CARGO_HOME's
# own config files are passed over where the walk meets them, as ~/.cargo is met
# from beneath $HOME: cargo reads that file once, as the machine's (issue 0150:
# with TMPDIR under $HOME the probe gave up, and a machine-wide fork failed). A
# directory that cannot be placed is 0, failing open.
cargo_config_above() {
  local d f h
  physical_dir "$1" d || return 0
  h="$(cargo_home_dir)"
  while :; do
    for f in "${d%/}/.cargo/config.toml" "${d%/}/.cargo/config"; do
      if [ "${2:-}" = --not-home ] && { [ "$f" -ef "$h/config.toml" ] || [ "$f" -ef "$h/config" ]; }; then
        continue
      fi
      _cargo_names_target_dir "$f" && return 0
    done
    _path_parent d || break
  done
  return 1
}

# cargo_config_in_home -- 0 when the config cargo reads in CARGO_HOME
# (cargo_config_file) names target-dir or include. Either file named it until
# issue 0164, the one cargo ignores included.
cargo_config_in_home() {
  local f
  f="$(cargo_config_file "$(cargo_home_dir)")"
  [ -n "$f" ] && _cargo_names_target_dir "$f"
}

# _cargo_names_target_dir <file> -- 0 when <file> exists and names target-dir,
# or includes another config, which may (cargo's stable `include`, issue 0150:
# an included file built into /tmp while the gate stayed shut), or cannot be
# read.
_cargo_names_target_dir() {
  local rc=0
  [ -e "$1" ] || [ -L "$1" ] || return 1
  grep -q -e 'target-dir' -e 'include' -- "$1" 2>/dev/null || rc=$?
  # 1 is a file read whole without the key; anything else is not read whole,
  # and cargo, asked, names why in its own words, so grep's are not shown.
  [ "$rc" -ne 1 ]
}

# cargo_build_dir <dir> <tree-var> <root-var> [<from-dir>] -- where cargo builds
# the crate in <dir>, into <tree-var>, and its workspace's root, whose own
# target is the tree when nothing moves it, into <root-var>; asked of cargo run
# in <dir>, where `cd <dir> && cargo build` runs it, the config found from there
# included (issue 0150). Each path comes back as cargo wrote it, byte for byte:
# jq writes the two NUL-terminated and they are read with `read -d ''`, where
# @tsv escaped a backslash, a tab and a newline, and a crate at `a\b` was read
# at `a\\b`. CARGO_TARGET_DIR and CARGO_BUILD_TARGET_DIR are removed from
# cargo's environment, so the answer is the configs' alone: either variable is
# its caller's to judge, as a value. Given <from-dir>, cargo runs there with
# --manifest-path naming <dir>, and so reads the configs found from <from-dir>,
# as it finds them from where it runs (measured, cargo 1.99.0; issue 0163).
# `--offline --no-deps` reads no network and resolves no dependency, and leaves
# Cargo.lock as it was (measured); colour is off, so the error line quoted is
# plain. Fails naming cargo's own first error line, or jq's absence. Its scratch
# directory is removed on every return; an interrupt while cargo runs leaves it
# in TMPDIR, named devbin-cargo.*.
cargo_build_dir() {
  local _cbd_d="$1" _cbd_s _cbd_rc=0 _cbd_line _cbd_from="${4:-}"
  local -n _cbd_tree="$2" _cbd_root="$3"
  _cbd_tree="" _cbd_root=""
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq is not on PATH, so cargo's answer for where $_cbd_d builds cannot be read"
    return 1
  fi
  _cbd_s="$(mktemp -d "${TMPDIR:-/tmp}/devbin-cargo.XXXXXX")" || {
    warn "cannot ask cargo where $_cbd_d builds: no scratch directory"
    return 1
  }
  (
    unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR
    if [ -n "$_cbd_from" ]; then
      cd -- "$_cbd_from" && CARGO_TERM_COLOR=never cargo metadata --offline --no-deps --format-version 1 --manifest-path "$_cbd_d/Cargo.toml"
    else
      cd -- "$_cbd_d" && CARGO_TERM_COLOR=never cargo metadata --offline --no-deps --format-version 1
    fi
  ) >"$_cbd_s/out" 2>"$_cbd_s/err" || _cbd_rc=$?
  if [ "$_cbd_rc" -ne 0 ]; then
    _cbd_line="$(grep -m 1 '^error' "$_cbd_s/err")" || _cbd_line="$(grep -m 1 . "$_cbd_s/err")" || _cbd_line="it exited $_cbd_rc"
    rm -rf "$_cbd_s"
    warn "cargo cannot say where $_cbd_d builds: $_cbd_line"
    return 1
  fi
  if ! jq -j '(.target_directory // ""), "\u0000", (.workspace_root // ""), "\u0000"' "$_cbd_s/out" >"$_cbd_s/fields"; then
    rm -rf "$_cbd_s"
    warn "jq could not read cargo's answer for where $_cbd_d builds (its error is above)"
    return 1
  fi
  { IFS= read -r -d '' _cbd_tree && IFS= read -r -d '' _cbd_root; } <"$_cbd_s/fields" || _cbd_rc=1
  rm -rf "$_cbd_s"
  if [ "$_cbd_rc" -ne 0 ] || [ -z "$_cbd_tree" ] || [ -z "$_cbd_root" ]; then
    warn "cargo named no build directory for $_cbd_d"
    return 1
  fi
}

# cargo_build_dirs <crates> <trees> [<roots> [<configs> [<holes>]]] -- into the arrays, one
# entry each per crate under this project with a carrier present
# (cargo_carrier_present): its directory, the tree cargo_build_dir names, and
# its workspace's root; nothing for a crate with none. Parallel arrays, never
# one delimited string, since a path may hold any byte but NUL. The roots are
# a caller's to ask for: named as nothing, or as an empty name, they are filled
# into a local and dropped, as fullcycle, which judges trees and never roots,
# asks (issue 0169: a third name was required, and a call naming two died on
# an unbound $3). 1 when cargo is
# not on PATH or cannot answer, named on stderr: where a crate's tree is cannot
# then be known. 2 when the walk could not read everything, having asked about
# every crate it did find: a crate beneath the hole is unseen, which is the
# hole's to answer for, not a carrier's -- the walks after it fail a cycle over
# it (issue 0139) -- so a project with no carrier anywhere is not refused
# for it.
# Each crate with a carrier is asked, a template's included: one cargo cannot
# read is refused in cargo's words, declared (issue 0150). With a fourth array
# named, each .cargo/config.toml or .cargo/config the walk met that names
# target-dir or include is put in it, so a caller can tell a config beneath the
# project whose crates the walk never reached. With a fifth named, each
# directory the walk could not search is put in it, as find_walk records it, and
# one empty entry where the walk failed somewhere it could not place, so a
# caller can ask whether a hole lies beneath a config (issue 0163). Every name
# past the second is optional.
cargo_build_dirs() {
  local -a _cbds_noroots=()
  local -n _cbds_c="$1" _cbds_t="$2" _cbds_r="${3:-_cbds_noroots}"
  local _cbds_m _cbds_d _cbds_tree _cbds_root _cbds_rc=0 _cbds_cfgname="${4:-}" _cbds_hname="${5:-}" _cbds_hf=""
  local -a _cbds_list=() _cbds_met=()
  _cbds_c=() _cbds_t=() _cbds_r=()
  # NUL-separated, read whole with its status (issue 0150: read a line at a
  # time, a crate directory whose name ends in a newline split, its config
  # unseen, and the cycle read INCONCLUSIVE at rc 0).
  # find-status: read by `wait "$!"` below, on this process substitution.
  # A config is one directly in a .cargo directory, never one beneath it, as a
  # project-local CARGO_HOME's .cargo/git/db/<repo>/config is not; a manifest or
  # a config may be a link, which cargo follows.
  if [ -n "$_cbds_hname" ]; then
    # mktemp names its own failure; with no file the holes cannot be read
    # back, and the empty entry below counts one beneath every config.
    _cbds_hf="$(mktemp "${TMPDIR:-/tmp}/devbin-holes.XXXXXX")" || _cbds_hf=""
  fi
  mapfile -d '' -t _cbds_list < <(FIND_WALK_HOLES="$_cbds_hf" cargo_walk -name target \( -type d -o -type l \) -prune -o \
    \( -name Cargo.toml \( -type f -o -type l \) -print0 \) -o \
    \( \( -path '*/.cargo/config.toml' -o -path '*/.cargo/config' \) \( -type f -o -type l \) -print0 \))
  if ! wait "$!"; then
    warn "could not read the whole project for its crates (the error above names it), so a crate beneath what it could not read was not asked about"
    _cbds_rc=2
  fi
  if [ -n "$_cbds_hname" ]; then
    local -n _cbds_h="$_cbds_hname"
    _cbds_h=()
    if [ -n "$_cbds_hf" ]; then
      mapfile -d '' -t _cbds_h <"$_cbds_hf"
      rm -f "$_cbds_hf"
    fi
    # A hole none was read back for lies, for all a caller can tell, beneath
    # everything: one empty entry says so.
    [ "$_cbds_rc" -ne 2 ] || [ "${#_cbds_h[@]}" -gt 0 ] || _cbds_h=("")
  fi
  for _cbds_m in ${_cbds_list[@]+"${_cbds_list[@]}"}; do
    [ -n "$_cbds_m" ] || continue
    case "$_cbds_m" in
      */.cargo/config.toml | */.cargo/config)
        ! _cargo_names_target_dir "$_cbds_m" || _cbds_met+=("$_cbds_m")
        continue
        ;;
    esac
    _cbds_d="${_cbds_m%/*}"
    cargo_carrier_present "$_cbds_d" || continue
    if ! command -v cargo >/dev/null 2>&1; then
      warn "cargo is not on PATH, so where $_cbds_d builds cannot be known: a cargo config there names target-dir or include"
      return 1
    fi
    cargo_build_dir "$_cbds_d" _cbds_tree _cbds_root || return 1
    _cbds_c+=("$_cbds_d")
    _cbds_t+=("$_cbds_tree")
    _cbds_r+=("$_cbds_root")
  done
  if [ -n "$_cbds_cfgname" ]; then
    local -n _cbds_cfgs="$_cbds_cfgname"
    _cbds_cfgs=(${_cbds_met[@]+"${_cbds_met[@]}"})
  fi
  return "$_cbds_rc"
}

# cargo_probe_build_dir <tree-var> [<from-dir>] -- where cargo sends a crate's
# build tree from <from-dir>, placed (cargo_place), into <tree-var>; empty when
# nothing moves it from the crate's own target. A throwaway crate in a scratch
# directory is asked of cargo run in <from-dir> (cargo_build_dir), which reads
# the configs found from there, so the answer is what a config there or above
# pins for any crate beneath it, whatever its spelling: the one probe (issue
# 0163), which check targetdir asks of a config over a hole beneath it. With no
# <from-dir> it is asked from the scratch directory itself: the machine's
# reading, cargo_home_build_dir. Statuses as below.
#
# cargo_home_build_dir <tree-var> -- where the machine's cargo config alone
# sends a crate's build tree, placed as it resolves (cargo_place), into
# <tree-var>; empty when it moves nothing (issue 0150). The one reading of the
# machine's config: check targetdir attributes a fork to it, and fullcycle names
# its file, by this answer, compared with cargo_tree_same (issue 0164). Asked of
# cargo in an empty scratch directory holding a throwaway crate, where no config
# but CARGO_HOME's applies, so the answer is the home config's, in whatever
# spelling it takes: sed read only `target-dir = "..."` and passed over a dotted
# key, a comment and the legacy file name. 1, named, when cargo cannot say, or
# is not on PATH. 2, unnamed, when a config at or above the scratch directory,
# or one the walk up cannot read, may apply too, so the machine's alone cannot
# be told: nothing is said to be the machine's, and a caller reporting the
# machine's config says it could not be measured, never that it moves nothing
# (issue 0164).
cargo_probe_build_dir() {
  local -n _chb_out="$1"
  local _chb_s _chb_p _chb_tree _chb_root _chb_rc=0 _chb_from="${2:-}"
  local _chb_what="the machine's cargo config"
  _chb_out=""
  [ -z "$_chb_from" ] || _chb_what="the cargo config found from $_chb_from"
  # Asked with no crate here too, so cargo may not be there at all: said once,
  # plainly, not as cargo's failure in a scratch directory already gone.
  if ! command -v cargo >/dev/null 2>&1; then
    warn "cargo is not on PATH, so where $_chb_what sends a build cannot be measured"
    return 1
  fi
  _chb_s="$(mktemp -d "${TMPDIR:-/tmp}/devbin-cargohome.XXXXXX")" || {
    warn "cannot ask cargo about $_chb_what: no scratch directory"
    return 1
  }
  if ! { mkdir -p "$_chb_s/probe/src" &&
    printf '[package]\nname = "probe"\nversion = "0.0.0"\nedition = "2021"\n\n[workspace]\n' >"$_chb_s/probe/Cargo.toml" &&
    : >"$_chb_s/probe/src/main.rs"; }; then
    rm -rf "$_chb_s"
    warn "cannot ask cargo about $_chb_what: the probe crate could not be written in $_chb_s"
    return 1
  fi
  # THE PROBE HEARS EVERY CONFIG ABOVE IT, not CARGO_HOME's alone, so one above
  # the scratch directory makes its answer no measure of the machine's (issue
  # 0150: with TMPDIR inside the project, the project's own fork was reported as
  # the machine's and not failed). Then nothing is said to be the machine's.
  # Asked from <from-dir>, cargo reads what is found from there, never what
  # sits above the scratch directory, so only the machine's reading is clouded.
  # The probe declares its own [workspace]: beneath a project's workspace, as
  # under a TMPDIR inside it, cargo refused a package that workspace does not
  # list, and a correct project failed (issue 0163).
  if [ -z "$_chb_from" ] && cargo_config_above "$_chb_s/probe" --not-home; then
    rm -rf "$_chb_s"
    return 2
  fi
  cargo_build_dir "$_chb_s/probe" _chb_tree _chb_root "$_chb_from" || _chb_rc=1
  if [ "$_chb_rc" -eq 0 ] && ! physical_dir "$_chb_s/probe" _chb_p; then
    warn "cannot place the probe crate in $_chb_s, so where $_chb_what sends a build cannot be measured"
    _chb_rc=1
  fi
  if [ "$_chb_rc" -eq 0 ] && [ "$_chb_tree" != "$_chb_p/target" ] &&
    [ "$_chb_tree" != "$_chb_root/target" ]; then
    cargo_place "$_chb_tree" _chb_out || _chb_out="$_chb_tree"
  fi
  rm -rf "$_chb_s"
  return "$_chb_rc"
}

cargo_home_build_dir() {
  cargo_probe_build_dir "$1"
}

# cargo_target_dirs [<tree>...] -- every cargo build tree under this project,
# discovered, and each <tree> named (issue 0150: what cargo said it builds into).
#
# NOT `$PROJECT_ROOT/target`, WHICH IS THE ASSUMPTION THIS FUNCTION EXISTS TO
# REPLACE. A cargo tree sits at the WORKSPACE root, and a workspace is very
# often nested: one project builds into `native/cli/target`, another into
# `native/rust/target`. A checker that looks only at the project root finds
# nothing in those projects, concludes nothing is wrong, and reports a clean
# result -- which is the same shape as the defect it was written to catch, and
# was the first draft of exactly that check.
#
# DELIBERATELY NOT SHARED WITH `_clean_roots`, and the reason is what each one
# is FOR rather than what each one does. Clean discovers trees it is about to
# DELETE, so it demands cargo's own markers (CACHEDIR.TAG, .rustc_info.json, a
# profile .fingerprint) before touching a directory that merely has the right
# name -- the cost of being wrong there is removing somebody's source tree. This
# only READS, across several languages' worth of layouts, and a directory named
# `target` holding an executable is the thing being asked about whether or not
# cargo has stamped it yet. Sharing one function would force one of those two
# risk postures onto the other.
#
# The variable cargo_env_carrier names wins outright when set: cargo writes
# there and nowhere else, so a discovered tree would be a stale one.
#
# DEPENDENCY TREES ARE PRUNED, AND THE POPULATION IS THE POINT.
# A project can carry five Cargo.toml files of which exactly one is its own:
# the other four are Elixir NIF crates under `deps/`, built through mix by
# Rustler rather than by cargo in place. A caller asking "did MY build restore
# MY artefacts" must not be answered about somebody else's crate. If a dep ever
# does grow a `target/` -- somebody runs a bare `cargo build` in one for their
# own reasons -- the populated-debug-empty-release signature appears there with
# no cycle having caused it, and the check goes red on a tree the project's
# build never touches.
#
# A CHECK THAT CRIES WOLF ON FOUR TREES OUT OF FIVE GETS ITS OUTPUT IGNORED,
# which is the same end state as the vacuity it replaces, arrived at from the
# other direction. Same argument that killed the >1-test-target rule.
#
# Note what does NOT need pruning: a crate with no `target/` at all -- which is
# all four NIF crates above -- is invisible here by construction, because this
# discovers BUILD TREES and never crates. There is nothing to skip.
#
# A WALK THAT CANNOT READ EVERYTHING RETURNS 1, having printed what it did find,
# with find's own error left on stderr to name the path (issue 0139). It sent
# that error to /dev/null in a pipeline ending `; return 0`: under errexit the
# failed pipeline ended its caller with no word, and read through a process
# substitution it was simply a shorter list, so a tree beneath an unreadable
# directory was never checked for its release binaries and nothing said so.
cargo_target_dirs() {
  local found sorted t k kept="" rc=0
  local -a dirs=()
  # A SET CARGO_TARGET_DIR, OR ELSE CARGO_BUILD_TARGET_DIR, IS RETURNED AS IT
  # IS, UNCHECKED: either decides cargo's tree over any config (measured, cargo
  # 1.98.1: CARGO_TARGET_DIR over CARGO_BUILD_TARGET_DIR over build.target-dir).
  # cargo_target_dir_why and cargo_tree_outside_why say which values can be
  # examined, and fullcycle, the one caller, refuses the rest before this is
  # reached. A new caller asks them first.
  t="$(cargo_env_carrier)"
  if [ -n "$t" ]; then
    printf '%s\n' "${!t%/}"
    return 0
  fi
  # -ignore_readdir_race: a build running beside the cycle creates and deletes
  # as it goes, and an entry that vanished mid-walk failed it -- 1 in 6 cycles
  # read ARTEFACT CHECK INCOMPLETE with a writer beside it (issue 0139).
  #
  # A target THAT IS A LINK IS A TREE TOO (issue 0139): under find's default -P
  # a link is -type l and never -type d, so a target/ reached through one was
  # never listed, and the cycle read "NO cargo build tree" and INCONCLUSIVE at
  # rc 0 over a debug/ with no release/ beside it. Links are listed with the
  # directories. A link naming a file is no tree and is dropped; one naming
  # nothing, or naming what cannot be reached, is kept, so the check names it as
  # gone or as out of reach rather than passing over it unsaid. A directory
  # named by two paths -- a link beside the tree it names -- is one tree, kept
  # once under the first path in the C locale's order, so it is not examined and
  # reported twice. What this walk does NOT do, declared: it never enters a
  # directory that is itself a link (find's default -P), so a tree beneath one
  # is not seen, since following such links risks loops and walks outside the
  # project; and it reads paths a line at a time, so a path holding a newline is
  # not one path.
  found="$(cargo_walk -name target \( -type d -o -type l \) -prune -print)" || rc=1
  # AND THE TREES CARGO NAMED (issue 0150): a crate whose config moves its tree
  # builds where the walk may not look, as `out` rather than `target`.
  [ "$#" -eq 0 ] || found="${found:+$found$'\n'}$(printf '%s\n' "$@")"
  [ -z "$found" ] || sorted="$(printf '%s\n' "$found" | LC_ALL=C sort)" || rc=1
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    if [ -d "$t" ]; then
      for k in "${dirs[@]}"; do
        [ "$t" -ef "$k" ] && continue 2
      done
      dirs+=("$t")
    elif [ -e "$t" ]; then
      continue
    fi
    kept+="$t"$'\n'
  done <<<"${sorted:-}"
  printf '%s' "$kept"
  return "$rc"
}

# FIND_WALK_HOLES is cargo_build_dirs' to set for one walk, and FIND_WALK_QUIET
# find_walk's own, never the environment's: one inherited would have every walk
# append to it, or print nothing.
unset FIND_WALK_HOLES FIND_WALK_QUIET

# find_walk [-H|-L|-P] <path>... [global options] <expression> -- find, with a
# directory it can list but not search named and pruned, and its status raised
# (issue 0145). Prints what find prints, on stdout, untouched. Returns find's
# status, or 1 when any such directory was met, each named on stderr:
#
#   cannot search <dir> -- nothing beneath it was looked at
#
# THE CLASS. macOS's find passes over a directory it can list but not search,
# mode 0444 or 0644, below its start point: it prints nothing beneath it, says
# nothing, and exits 0, so every walk that descends read the tree beneath one
# as absent at rc 0. GNU find lists the names beneath it and cannot open what
# they name, so a walk that goes on to read them fails later and less clearly.
# One clause, asked of the running user as clean asked it, prunes such a
# directory under both finds and records it, so the two give one verdict.
# A directory find cannot read at all keeps find's own error and
# status, and is not named twice.
#
# - THE CLAUSE comes after the start paths and any leading global options
#   (-maxdepth, -mindepth, -ignore_readdir_race, -xdev, -mount), before the
#   caller's expression, which it wraps in parentheses. It is false either way,
#   so the caller's expression still sees that directory itself (a walk for
#   directories named target still finds one at 0644); it only never looks
#   beneath it.
# - THE CALLER'S OWN PRUNE IS ASKED FIRST (issue 0145): an expression opening
#   `\( ... \) -prune -o`, the idiom every caller uses, has that group lifted
#   ahead of the clause, as clean's own clause sat after its prune, so a
#   directory the caller never meant to enter is never examined: a .git at 0644
#   failed clean's walk, and with it fullcycle's clean. A prune spelled any
#   other way is evaluated after the clause. The group is found by counting the
#   `(` and `)` words, so one given as a value, as in `-name '('`, leaves it
#   unlifted: the walk then examines what it prunes, and says so.
# - THE EXEC IS NARROWED to a directory missing an x bit that the running user
#   does not own with u+x set, read from $EUID and never from an `id` found
#   through PATH: only the owner bits apply to the owner, so the
#   0700 and 0750 directories of an ordinary tree run none. Without the owner
#   test every such directory cost one /bin/sh, and a census walk over a
#   machine's roots ran 3.3 times as long (measured).
# - WHAT IT RUNS IS /bin/sh, NAMED WHOLE, and nothing found through PATH, as
#   clean's walk named it (0131): a project's own bin/test first on PATH was
#   run by a walk that promised to change nothing. Where /bin/sh cannot be run
#   the walk refuses at status 2, naming it, before find starts: BSD find
#   reports each failed exec and still exits 0, with the hole silent beneath.
# - A GLOBAL -mindepth ABOVE 1 IS REFUSED at status 2: find does not evaluate
#   the clause above that depth, so a directory there would be entered
#   unexamined. -mindepth 1 leaves out only the start paths, and find reports
#   a start path it cannot search itself.
# - A DECLARED LIMIT: the clause reads mode bits, so a directory
#   whose ACL denies the running user search, its mode bits allowing it, is not
#   asked about, and BSD find passes over what is beneath it silently, as
#   before. clean's page says so. Probing each directory's ACL would cost a
#   process per directory, which the owner pre-filter exists to avoid.
# - THE RECORDS reach this function on fd 3, NUL-terminated, through a process
#   substitution read by mapfile, and find's status by `wait "$!"`, the idiom
#   find_list and clean's walk use; `$(...)` drops NUL bytes and ran two
#   records together. find's own stdout goes to the caller through a saved
#   descriptor.
# - A WALK BOUNDED BY -maxdepth never enters a directory at that depth, so what
#   one hides is nothing it asked for: such a record is dropped when every
#   start path it lies under puts it at or beyond -maxdepth, and kept when any
#   would have entered it. Each directory is named once, however many start
#   paths reached it or however many slashes spell it.
# - EVERY HOLE IS RECORDED, as a path and its kind, on fd 3: S for a directory
#   it can list but not search, which this prunes and names, and U for one it
#   cannot read at all, which find names. The clause also runs for a directory
#   missing a read bit the running user does not own u+r on, so a 0711 or 0311
#   one is recorded too. With FIND_WALK_HOLES naming a file, each hole's path is
#   appended to it, NUL-terminated, and one empty record when find failed with
#   none recorded, so a caller can ask where the walk's holes are (issue 0163:
#   check targetdir asks what a crate beneath one would build into). Each is
#   filtered by -maxdepth, as a named one is. Where find failed with a U
#   recorded, the walk is run again, quietly, with every hole pruned, so a
#   failure the records do not place, as an ACL denying a listing the mode bits
#   allow, still gets its empty record (issue 0163: one 000 directory hid it).
#   The re-walk is find_walk itself with FIND_WALK_QUIET=1, which prunes every
#   hole, prints and records nothing, and returns find's status. Its cost is a
#   second walk whenever find failed with a U recorded, whether or not the
#   caller then reads the holes: measured at about 1.8 times one walk on a tree
#   of 7,200 directories. The expression then runs twice, so with FIND_WALK_HOLES
#   set one with an action beyond printing, in the expression or a lifted prune
#   group, is refused at status 2. An ACL denying only search is still unseen,
#   as the limit above says.
# - FIND'S STATUS IS READ WITHOUT ERREXIT'S ABORT, so a find that failed on one
#   directory still has every unsearchable one named after it.
# - The expression must carry -print or -print0, since the clause's -exec
#   suppresses find's implicit -print; otherwise status 2, naming it.
#
# find_list is built on this: find_walk, sorted, read into an array. The locals
# carry their own prefix, as find_list's do.
find_walk() {
  local -a _fw_pre=() _fw_paths=() _fw_glob=() _fw_expr=() _fw_marks=() _fw_prune=() _fw_sel=() _fw_args=("$@")
  local _fw_rc _fw_d _fw_p _fw_rel _fw_max="" _fw_fd _fw_efd _fw_act=0 _fw_a _fw_in _fw_dn _fw_pn _fw_prog
  local _fw_i _fw_n _fw_k _fw_kind _fw_frc _fw_u=0
  local -A _fw_said=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -H | -L | -P)
        _fw_pre+=("$1")
        shift
        ;;
      *) break ;;
    esac
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -* | '(' | '!') break ;;
      *)
        _fw_paths+=("$1")
        shift
        ;;
    esac
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -maxdepth | -mindepth)
        if [ "$#" -lt 2 ]; then
          warn "find_walk: $1 names no depth"
          return 2
        fi
        ;;&
      -maxdepth)
        _fw_max="$2"
        _fw_glob+=("$1" "$2")
        shift 2
        ;;
      -mindepth)
        # A value that is not a number is find's to refuse.
        if [[ "${2:-}" =~ ^[0-9]+$ ]] && [ "$((10#$2))" -gt 1 ]; then
          warn "find_walk: -mindepth $2 leaves the directories above depth $2 unexamined, so a hole there would go unseen"
          return 2
        fi
        _fw_glob+=("$1" "$2")
        shift 2
        ;;
      -ignore_readdir_race | -noignore_readdir_race | -xdev | -mount)
        _fw_glob+=("$1")
        shift
        ;;
      *) break ;;
    esac
  done
  _fw_expr=("$@")
  # The caller's leading `\( ... \) -prune -o`, lifted ahead of the clause.
  if [ "${_fw_expr[0]:-}" = "(" ]; then
    _fw_n=0
    for ((_fw_i = 0; _fw_i < ${#_fw_expr[@]}; _fw_i++)); do
      case "${_fw_expr[_fw_i]}" in
        "(") _fw_n=$((_fw_n + 1)) ;;
        ")") _fw_n=$((_fw_n - 1)) ;;
      esac
      [ "$_fw_n" -gt 0 ] || break
    done
    if [ "${_fw_expr[_fw_i + 1]:-}" = -prune ] && [ "${_fw_expr[_fw_i + 2]:-}" = -o ]; then
      _fw_prune=("${_fw_expr[@]:0:_fw_i+3}")
      _fw_expr=("${_fw_expr[@]:_fw_i+3}")
    fi
  fi
  for _fw_a in "${_fw_expr[@]}"; do
    case "$_fw_a" in -print | -print0) _fw_act=1 ;; esac
  done
  if [ "$_fw_act" = 0 ]; then
    warn "find_walk: the find expression names no -print or -print0, so nothing it finds would be printed"
    return 2
  fi
  if [ -n "${FIND_WALK_HOLES:-}" ]; then
    for _fw_a in ${_fw_prune[@]+"${_fw_prune[@]}"} "${_fw_expr[@]}"; do
      case "$_fw_a" in
        -exec | -execdir | -ok | -okdir | -delete | -fprint | -fprint0 | -fprintf | -fls)
          warn "find_walk: with FIND_WALK_HOLES set the expression may run twice, and $_fw_a would act twice"
          return 2
          ;;
      esac
    done
  fi
  if [ ! -x /bin/sh ]; then
    warn "find_walk: /bin/sh cannot be run, and a directory that can be listed but not searched is found by running it -- nothing was walked"
    return 2
  fi
  # The directories the clause asks about, one selection for both walks.
  _fw_sel=(-type d \( ! -perm -111 ! \( -user "$EUID" -perm -u+x \) -o ! -perm -444 ! \( -user "$EUID" -perm -u+r \) \))
  # shellcheck disable=SC2016 # the $1 in each -exec program is /bin/sh's own
  if [ "${FIND_WALK_QUIET:-}" = 1 ]; then
    # Every hole pruned, a selected directory it can read and search entered.
    _fw_prog='if [ -r "$1" ]; then [ ! -x "$1" ]; fi'
    exec {_fw_fd}>/dev/null {_fw_efd}>/dev/null
  else
    _fw_prog='if [ -r "$1" ]; then [ ! -x "$1" ] && printf "%s\0S\0" "$1" >&3; else printf "%s\0U\0" "$1" >&3; exit 1; fi'
    exec {_fw_fd}>&1 {_fw_efd}>&2
  fi
  mapfile -d '' -t _fw_marks < <(
    # find-walk: this is find_walk, the one find that carries the clause itself
    # find-status: read by `wait "$!"` below, on this process substitution
    find ${_fw_pre[@]+"${_fw_pre[@]}"} "${_fw_paths[@]}" ${_fw_glob[@]+"${_fw_glob[@]}"} \
      ${_fw_prune[@]+"${_fw_prune[@]}"} \
      \( "${_fw_sel[@]}" -exec /bin/sh -c "$_fw_prog" sh {} \; -prune -false \) -o \
      \( "${_fw_expr[@]}" \) 3>&1 >&"$_fw_fd" 2>&"$_fw_efd"
  )
  _fw_rc=0
  wait "$!" || _fw_rc=$?
  exec {_fw_fd}>&- {_fw_efd}>&-
  if [ "${FIND_WALK_QUIET:-}" = 1 ]; then
    return "$_fw_rc"
  fi
  _fw_frc="$_fw_rc"
  for ((_fw_k = 0; _fw_k + 1 < ${#_fw_marks[@]}; _fw_k += 2)); do
    _fw_d="${_fw_marks[_fw_k]}" _fw_kind="${_fw_marks[_fw_k + 1]}"
    # Named once, however many start paths or spellings reached it.
    _fw_dn="$_fw_d"
    _find_walk_tidy _fw_dn
    [ -z "${_fw_said[$_fw_dn]:-}" ] || continue
    if [ -n "$_fw_max" ]; then
      # A HOLE WHEN ANY START PATH IT LIES UNDER WOULD HAVE ENTERED IT: under
      # one start it may sit at -maxdepth, never entered, and under another
      # above it, a walk that meant to look beneath it.
      #
      # DEPTH IS READ FROM THE PATHS AS SPELLED, SO BOTH ARE READ ONE WAY:
      # every run of / as one, and a trailing / dropped. Both finds
      # print `a/x` under a start spelled `a/` and `a//x` under `a//`
      # (measured on Darwin 27 and GNU findutils), and a start `.` prints `./x`.
      _fw_in=0
      for _fw_p in "${_fw_paths[@]}"; do
        _fw_pn="$_fw_p"
        _find_walk_tidy _fw_pn
        if [ "$_fw_dn" = "$_fw_pn" ]; then
          _fw_rel=""
        else
          case "$_fw_dn" in
            "${_fw_pn%/}"/*) _fw_rel="${_fw_dn#"${_fw_pn%/}"}" ;;
            *) continue ;;
          esac
        fi
        _fw_rel="${_fw_rel//[!\/]/}"
        [ "${#_fw_rel}" -ge "$_fw_max" ] || _fw_in=1
      done
      [ "$_fw_in" = 1 ] || continue
    fi
    _fw_said[$_fw_dn]=1
    [ -z "${FIND_WALK_HOLES:-}" ] || printf '%s\0' "$_fw_d" >>"$FIND_WALK_HOLES"
    # One find cannot read at all keeps find's own error and status.
    if [ "$_fw_kind" = U ]; then
      _fw_u=1
      continue
    fi
    case "$_fw_d" in
      *[![:print:]]*) printf -v _fw_d '%q' "$_fw_d" ;;
    esac
    warn "cannot search $_fw_d -- nothing beneath it was looked at"
    _fw_rc=1
  done
  # A failed find failed somewhere this cannot place unless every failure was
  # a U it recorded: the same walk with every hole pruned says which, and one
  # empty record says so, which a caller reads as a hole beneath everything
  # (issue 0163).
  if [ -n "${FIND_WALK_HOLES:-}" ] && [ "$_fw_frc" -ne 0 ]; then
    # find-status: the quiet re-walk's, read by the `if`, and only whether it is 0
    if [ "$_fw_u" = 0 ] || ! FIND_WALK_HOLES="" FIND_WALK_QUIET=1 find_walk "${_fw_args[@]}"; then
      printf '\0' >>"$FIND_WALK_HOLES"
    fi
  fi
  return "$_fw_rc"
}

# _find_walk_tidy <var> -- the path in <var> with every run of / as one and a
# trailing / dropped, / itself kept: how find_walk reads a depth, and the one
# place its paths are tidied. It is spelling only, by design: real_path and
# physical_dir resolve a path through the filesystem, need it to exist and
# follow its links, which a depth count must not; and link_step keeps a link's
# text untidied on purpose, since the kernel reads a `..` after the name
# before it.
_find_walk_tidy() {
  local -n _fwt_p="$1"
  while [[ "$_fwt_p" == *//* ]]; do
    _fwt_p="${_fwt_p//\/\//\/}"
  done
  [ "$_fwt_p" = / ] || _fwt_p="${_fwt_p%/}"
}

# find_list <array> <find operands and expression> -- find_walk, sorted, read
# into an array (issue 0145): every path find prints, read whole into the
# named array in the C locale's order, and find_walk's status
# (issue 0139): 0 when find read everything, and its failure otherwise, with
# find's own error on stderr naming what it could not read. The expression ends
# in -print0, so a name holding a newline is one path; a name it cannot fill,
# bar an integer array, or an expression ending otherwise, is refused at status
# 2. The array holds what find did list either way: a caller that acts may act
# on it and say the list was partial, where a gate refuses.
#
# ONE IDIOM FOR A LIST READ WHOLE (issue 0139). 0139's first version
# wrote the list through a temporary file twice, in check's Swift gate and in
# dmarc parse. Here the status is taken by `wait` on the process substitution,
# as release_dirt and clean's walk take theirs, and there is no file to remove.
# The locals are prefixed because the caller names the array: a local of the
# same name would shadow it.
find_list() {
  # THE NAME AND THE EXPRESSION ARE ASKED BEFORE ANYTHING IS BOUND, as run_words
  # asks (issue 0082): a name that is not a name makes `local -n` fail and
  # execution fall through, and this function's own binds to itself, so either
  # way the caller's array stays empty and a gate passes over nothing; an
  # expression that does not end in -print0 hands back every path as one
  # element. Each is a programming error, so the status is 2. The expression
  # test reads its LAST WORD only: one ending in -print0 passes whatever its
  # other actions, and one ending otherwise is refused, sound or not. It catches
  # the caller who forgot -print0; it does not parse find's grammar.
  if ! is_identifier "${1:-}"; then
    warn "find_list: '${1:-}' is not a shell variable name, so there is no array to fill"
    return 2
  fi
  if [ "$1" = _fl_out ]; then
    warn "find_list: cannot fill an array named '$1' -- it is find_list's own name"
    return 2
  fi
  if [ "${!#}" != -print0 ]; then
    warn "find_list: the find expression must end in -print0, or its paths cannot be told apart"
    return 2
  fi
  local -n _fl_out="$1"
  # MAPFILE'S OWN FAILURE IS NOT FIND'S: a target it cannot fill, an associative
  # array, was refused only by the writer's SIGPIPE, a status this function
  # never read. The writer is reaped and the caller told, at 2. An integer array
  # is declared rather than closed, as run_words declares it: bash's arithmetic
  # on a path abandons the caller.
  # find-status: read by `wait "$!"` below, on this process substitution
  if ! mapfile -d '' -t _fl_out < <(set -o pipefail; find_walk "${@:2}" | LC_ALL=C sort -z); then
    wait "$!"
    warn "find_list: could not fill '$1' with the paths find printed"
    return 2
  fi
  wait "$!"
}

# dir_has_binary <dir> -- true when <dir> holds at least one executable FILE at
# its top level, which is where cargo puts the binaries it builds.
#
# `-type f` and not `-e`: a cargo profile directory always exists once cargo has
# run in it, carrying `.fingerprint/`, `build/`, `deps/` and `incremental/`
# whether or not a single binary was produced. So "the directory is there" and
# "the artefacts are there" are different facts, and the first one is the
# reading that made a dev-profile cycle look complete.
dir_has_binary() {
  local d="$1" f
  [ -d "$d" ] || return 1
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    [ -x "$f" ] || continue
    return 0
  done
  return 1
}

# utc_from_epoch <epoch> -- an epoch second rendered `YYYY-MM-DD HH:MMZ`.
#
# THE TWO PLATFORMS SPELL THIS INCOMPATIBLY AND ONE OF THE SPELLINGS FAILS
# QUIETLY. BSD `date -r <epoch>` takes a NUMBER; GNU `date -r <file>` takes a
# FILE and wants `-d @<epoch>` for a number. Hand GNU an epoch and it errors to
# stderr and prints nothing, so the field goes EMPTY rather than wrong -- which
# is the safe direction and is still a column that silently stops existing on
# one platform.
#
# Reading order matters: BSD is tried first because GNU's `-r` would ACCEPT the
# argument as a filename and fail on it, while BSD's rejection of `-d @...` is
# clean. Both arms are guarded, so an unparseable value returns 1 rather than
# emitting a plausible-looking wrong time: a fabricated timestamp is
# indistinguishable from a real one.
utc_from_epoch() {
  local e="$1" out
  [ -n "$e" ] || return 1
  out="$(date -u -r "$e" +'%Y-%m-%d %H:%MZ' 2>/dev/null)" ||
    out="$(date -u -d "@$e" +'%Y-%m-%d %H:%MZ' 2>/dev/null)" || return 1
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# mtime_epoch <file> -- <file>'s last write, in seconds since the epoch, by
# BSD's `stat -f %m` or GNU's `stat -c %Y`, or 1 when neither answers.
#
# EACH ARM IS CAPTURED, AND ONLY A NUMBER IS AN ANSWER. GNU's `stat -f` is a
# FILESYSTEM's status: it prints that block to stdout and returns 1, and an
# uncaptured `||` then appended the GNU arm's epoch after it, so every Linux
# run read the time as unreadable while macOS never saw it. Nothing here
# formats a time: utc_from_epoch does, with both of its arms. The one copy for
# every reader, worktrees's index time among them (issue 0245).
mtime_epoch() {
  local out
  out="$(stat -f %m "$1" 2>/dev/null)" || out="$(stat -c %Y "$1" 2>/dev/null)" || return 1
  case "$out" in
    '' | *[!0-9]*) return 1 ;;
  esac
  printf '%s' "$out"
}

# scratch_outside <who> <root> <name> -- make and print a scratch directory,
# <name>.XXXXXX under $TMPDIR, refusing when $TMPDIR is <root> or inside it.
# <who> opens each refusal, said on stderr.
#
# OUTSIDE THE PROJECT IS THE CONTRACT, NOT A PREFERENCE. A scratch under the
# project root is untracked, non-ignored dirt, or a directory beside the
# worktrees a report lists, so a read made there would change the fact it
# reports. The check is made BEFORE anything is created, on physical paths, so
# a symlinked $TMPDIR cannot hide inside, through physical_dir, the one turn of
# a directory into one: a copy of its own kept a leading //, so a root spelled
# that way walked past the check (issue 0162). `release` and `worktrees` both
# make their scratch here (issue 0245).
scratch_outside() {
  local who="$1" root base dir
  if ! physical_dir "$2" root; then
    warn "$who: cannot resolve the project root $2"
    return 1
  fi
  if ! physical_dir "${TMPDIR:-/tmp}" base; then
    warn "$who: TMPDIR (${TMPDIR:-/tmp}) is not a directory, so there is nowhere to make a scratch directory"
    return 1
  fi
  case "$base/" in
    "$root"/*)
      warn "$who: TMPDIR ($base) is inside the project ($root), and a scratch made there is dirt this run would then report -- point TMPDIR outside the project"
      return 1
      ;;
  esac
  if ! dir="$(mktemp -d "$base/$3.XXXXXX")"; then
    warn "$who: cannot make a scratch directory under $base"
    return 1
  fi
  printf '%s\n' "$dir"
}

# sha256_of <file> -- one file's SHA256, bare hex, or return 1.
#
# Built on sha256_files so the knowledge of which tool exists lives in exactly
# one place (IN-AG-HIGHLANDER-001).
sha256_of() {
  [ -f "$1" ] || return 1
  sha256_files "$1" | awk '{print $1}'
}

# --- the build's git identity (issue 0014) -------------------------------------
#
# Devbin owns the version-number axis completely -- `version_from`, the sidecars,
# `version sync` -- and owned nothing of the git one, so every project resolved
# "what commit is this build" for itself. So devbin owns
# the half that is genuinely SHARED and gets independently wrong, and declares
# nothing about how a build system consumes it.
#
# THE READ IS THE HALF NOBODY GETS WRONG. One project's six sites all agreed on
# `git rev-parse --short HEAD` with `unknown` on failure. The INVALIDATION is
# where four of four went wrong, each by naming git's internals literally:
#
#     ../../.git/HEAD          ../../.git/refs/heads/
#
# In a linked worktree neither exists -- `.git` is a FILE reading `gitdir: ...`.
# The same unresolved path produced OPPOSITE symptoms, decided entirely by
# whether the toolchain fails open or closed on a path it cannot find: Elixir's
# `@external_resource` over an empty list registered no dependency and served a
# frozen sha for a working day; cargo could not stat its `rerun-if-changed` and
# treated the target as permanently dirty, rebuilding forever. The version that
# silently freezes and the version that silently rebuilds are the same bug, and
# only one of them ever gets reported -- which is why it is worth one home.
#
# These emit FACTS -- a string and a list of file paths -- and declare nothing.
# Each build system states its own dependency in its own vocabulary: cargo's
# `rerun-if-changed`, Elixir's `@external_resource`, a make prerequisite, a
# Dockerfile COPY. That is what makes one function serve every toolchain.

# git_readonly <args...> -- git, asked about a repository this process only reads.
#
# `--no-optional-locks` because a plain `git status` may refresh the index and
# take its lock: a caller reading many trees could fail a concurrent commit with
# `index.lock exists`, and leave a write in a repository it only meant to read.
#
# EVERY ONE OF GIT'S LOCAL ENVIRONMENT VARIABLES IS CLEARED, IN A SUBSHELL, and
# the list is asked of git rather than written here. A value inherited from the
# caller -- GIT_DIR, GIT_COMMON_DIR, GIT_CONFIG_PARAMETERS from a `git -c` --
# would point every repository's question at one repository or one setting and
# answer it confidently for all of them. If git cannot list them, this refuses
# rather than asking with the environment it could not clear.
#
# THE LIST IS CACHED IN THE SHELL THAT ASKS, AND A COMMAND SUBSTITUTION IS A
# DIFFERENT SHELL. Every caller runs git_readonly inside `$(...)`, so a cache
# filled there is gone before the next call -- the first cut claimed "once per
# process" and asked three times per tree (measured with a counting git on
# PATH). git_readonly_prime fills it in the CURRENT shell, so a
# caller that primes before its first substitution pays once for everything
# beneath it. A scan over many trees primes once for all of them;
# source_commit_of and tree_dirty_paths prime through their first, direct call.
#
# THE REPOSITORY'S OWN SETTINGS ARE NOT TRUSTED EITHER WHERE THEY CAN HIDE A
# CHANGE OR RUN SOMETHING. `core.fsmonitor` names a hook the repository chose,
# which would run here and could answer "nothing changed"; `core.untrackedCache`
# is a cache of that same answer. Both are forced off for the one call. (Moved
# to lib/install in issue 0056, and from there to lib/helpers, issue 0094: the
# dispatcher, `release` and `fullcycle` do not source lib/install, and each has
# a read that must not write.)
_DEVBIN_GIT_LOCAL_VARS=""
git_readonly_prime() {
  [ -z "$_DEVBIN_GIT_LOCAL_VARS" ] || return 0
  if ! _DEVBIN_GIT_LOCAL_VARS="$(git rev-parse --local-env-vars 2>/dev/null)"; then
    _DEVBIN_GIT_LOCAL_VARS=""
    return 1
  fi
  [ -n "$_DEVBIN_GIT_LOCAL_VARS" ]
}

git_readonly() {
  git_readonly_prime || return 1
  (
    git_local_env_clear || exit 1
    _git_readonly_exec "$@"
  )
}

# _git_readonly_exec <args...> -- exec git under the read-only flags, in the
# subshell its caller opened: the one statement of the flags, for git_readonly
# and git_readonly_index.
_git_readonly_exec() {
  exec git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false "$@"
}

# git_readonly_index <index> <args...> -- git_readonly, asking against the
# scratch index <index> in place of a worktree's own (issue 0245).
#
# git_readonly clears GIT_INDEX_FILE with the rest of git's local variables, so
# a read that needs an index of its own -- `read-tree` of a branch into a
# scratch, then `apply --cached --check` against it -- cannot go through it.
# This clears the same variables, then points GIT_INDEX_FILE at <index>, under
# the same flags. <index> is an absolute path the caller made outside every
# repository it reads, and the only file a call through here may write, so
# core.splitIndex is off for the call: a split index would write its shared
# half beside the repository's own index.
git_readonly_index() {
  local index="$1"
  shift
  case "$index" in
    /*) ;;
    *)
      warn "git_readonly_index: the scratch index '$index' is not an absolute path -- a devbin defect"
      return 1
      ;;
  esac
  git_readonly_prime || return 1
  (
    git_local_env_clear || exit 1
    export GIT_INDEX_FILE="$index"
    _git_readonly_exec -c core.splitIndex=false "$@"
  )
}

# git_local_env_clear -- clear git's repository-local variables (GIT_DIR,
# GIT_INDEX_FILE and the rest, as `git rev-parse --local-env-vars` lists them)
# from the CURRENT shell, so every `git -C <dir>` it runs after, a read or a
# write, acts on <dir>'s own repository. A hook exports them, and a linked
# worktree's hooks export an absolute GIT_DIR, which outranks -C: a push made
# from a hook would otherwise land in the hook's repository. For a project's own
# command that runs git in other repositories from a hook; git_readonly runs it
# in its subshell for each read. It reads git_readonly_prime's list, so a
# command that also reads through git_readonly asks git once. Fails when git
# cannot list the variables, or lists none, since then nothing was cleared.
git_local_env_clear() {
  local v
  git_readonly_prime || return 1
  while IFS= read -r v; do
    [ -z "$v" ] || unset "$v"
  done <<VARS
$_DEVBIN_GIT_LOCAL_VARS
VARS
}

# pathlist_specs <text> -- the pathspecs of a path list such as
# tests/shipped.paths, one a line: every line of <text> as written, but a blank
# one or one whose first non-space character is `#`.
# pathspec_excludes <spec> -- rc 0 for a pathspec that leaves paths out, in
# every spelling git accepts: short magic holding `!` or `^`, in any order with
# `/` (`:!x`, `:^x`, `:/!x`, `:!/x`, `:!:x`), or long magic naming exclude
# (`:(exclude)x`, `:(top,exclude)x`).
# pathspec_kept_out <spec> -- an exclude <spec> with its exclude magic taken
# off and the rest kept, so `git ls-files -- <it>` lists what <spec> keeps out.
# The magic is always written, empty when nothing is left of it (`::x`,
# `:()x`), so a path that opens with `:`, or an empty one, stays the path.
#
# THE ONE READER OF A PATH LIST (issue 0261). The snapshot builder and the
# workroom scan both read tests/shipped.paths through these, so what ships and
# what is scanned come from one reading of one list; until 0261 each read it
# its own way, and the scan knew `:(exclude)` alone. Pure.
pathlist_specs() {
  local line t
  while IFS= read -r line; do
    t="${line#"${line%%[![:space:]]*}"}"
    case "$t" in '' | '#'*) continue ;; esac
    printf '%s\n' "$line"
  done <<<"$1"
}

pathspec_excludes() {
  local magic
  case "$1" in
    ':('*')'*)
      magic="${1#:(}"
      magic=",${magic%%)*},"
      [[ "$magic" == *,exclude,* ]]
      return
      ;;
    ':'*)
      magic="${1#:}"
      magic="${magic%%[!/!^]*}"
      [[ "$magic" == *'!'* || "$magic" == *'^'* ]]
      return
      ;;
  esac
  return 1
}

pathspec_kept_out() {
  local magic rest kept="" m
  case "$1" in
    ':('*')'*)
      magic="${1#:(}"
      rest="${magic#*)}"
      magic="${magic%%)*}"
      while IFS= read -r -d , m; do
        [ "$m" = exclude ] || kept="${kept:+$kept,}$m"
      done <<<"$magic,"
      printf ':(%s)%s\n' "$kept" "$rest"
      ;;
    ':'*)
      magic="${1#:}"
      rest="${magic#"${magic%%[!/!^]*}"}"
      rest="${rest#:}"
      magic="${magic%%[!/!^]*}"
      kept="${magic//!/}"
      kept="${kept//^/}"
      printf ':%s:%s\n' "$kept" "$rest"
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# git_remote <git-args>... -- run git against a remote so it cannot ask for
# anything: it fails with git's own words where it would have asked (issue
# 0217). Every devbin call that reaches a remote runs through here, and a
# project's own commands can call it the same way; stdout and stderr pass
# through, and the status is git's.
#
# git asks for a credential on /dev/tty, not on stdin, so capturing a call's
# output does not stop it (issue 0088). Each way it can ask is shut for the call:
#   - its own prompt: GIT_TERMINAL_PROMPT=0;
#   - an askpass program, which git asks BEFORE it reads GIT_TERMINAL_PROMPT:
#     GIT_ASKPASS, else core.askPass, else SSH_ASKPASS, the first one set
#     winning. GIT_ASKPASS and SSH_ASKPASS are set empty and core.askPass is
#     given empty on the command line, which outranks every config file, so
#     whichever git reads first names no program;
#   - a credential helper that asks by its own means (Git Credential
#     Manager's dialog): credential.interactive=never and GCM_INTERACTIVE=never,
#     which a git or a helper that does not know them ignores;
#   - ssh, which asks on /dev/tty too (a passphrase, an unknown host key):
#     BatchMode=yes, APPENDED to the person's own ssh command --
#     GIT_SSH_COMMAND, else core.sshCommand, else `ssh`, git's own order --
#     never in place of it, and SSH_ASKPASS_REQUIRE=never;
#   - stdin, from /dev/null.
#
# THE LIMIT, DECLARED: under GIT_SSH (a program, not a command line) with no
# GIT_SSH_COMMAND, ssh is left as the person set it, because setting
# GIT_SSH_COMMAND would override their program; and an ssh command whose first
# word is not OpenSSH (plink) is handed an OpenSSH option.
git_remote() {
  local ssh="${GIT_SSH_COMMAND:-}"
  if [ -z "$ssh" ] && [ -z "${GIT_SSH:-}" ]; then
    ssh="$(git config --get core.sshCommand 2>/dev/null)" || ssh=""
    ssh="${ssh:-ssh}"
  fi
  # Assignments on the command, never `env`: a caller's `git` that is a shell
  # function still answers, as it did before this runner existed.
  if [ -n "$ssh" ]; then
    GIT_TERMINAL_PROMPT=0 GIT_ASKPASS='' SSH_ASKPASS='' SSH_ASKPASS_REQUIRE=never GCM_INTERACTIVE=never \
      GIT_SSH_COMMAND="$ssh -o BatchMode=yes" \
      git -c core.askPass= -c credential.interactive=never "$@" </dev/null
  else
    GIT_TERMINAL_PROMPT=0 GIT_ASKPASS='' SSH_ASKPASS='' SSH_ASKPASS_REQUIRE=never GCM_INTERACTIVE=never \
      git -c core.askPass= -c credential.interactive=never "$@" </dev/null
  fi
}

# url_host_path <url> -- a remote url read as HOST<TAB>OWNER/NAME, a trailing
# `/` and `.git` dropped, for a project's own command that needs whose a remote
# is; release_repo reads its remote through it. The userinfo is dropped to its
# FIRST @, as git reads one. A url with a scheme has its host in its authority,
# after `://` and before the first `/`, its userinfo and port dropped, so an @
# in the path is the path's. One with no scheme is git's scp-like form whenever no
# `/` comes before its first `:`: its host is what stands before that `:`, a
# user and its @ dropped, and its path is all after it, an @ there included, so
# `host:owner/name` is read with or without a user, as git reads it to push;
# anything else is a local path. Fails, with
# nothing printed, at
#   2  a url that names no host: a local path, a file:// url;
#   3  a host still holding an @: the url held more than one ahead of its
#      host, so where its userinfo ended cannot be told (an @ in a userinfo is
#      %40), and no url is read two ways;
#   4  a path that is not OWNER/NAME.
url_host_path() {
  local url="$1" rest host path
  case "$url" in
    *://*)
      # The userinfo is the authority's alone: an @ after the first / is in
      # the path, and never moves the host.
      rest="${url#*://}"
      host="${rest%%/*}"
      path="${rest#*/}"
      [ "$path" != "$rest" ] || path=""
      host="${host#*@}"
      host="${host%%:*}"
      ;;
    *:*)
      host="${url%%:*}"
      case "$host" in */*) return 2 ;; esac
      host="${host#*@}"
      path="${url#*:}"
      ;;
    *) return 2 ;;
  esac
  case "$host" in
    "") return 2 ;;
    *@*) return 3 ;;
  esac
  path="${path%/}"
  path="${path%.git}"
  [[ "$path" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || return 4
  printf '%s\t%s\n' "$host" "$path"
}

# text_shown <text> -- <text> as a message may print it, the userinfo of every
# url in it left out, for a project's own command that prints what git says
# about a remote: a url can carry a token, and a message reaches the terminal
# and every log. After a `://` the userinfo runs to the LAST @ ahead of the
# host's `/` or a blank, so a password holding a raw @ goes whole. With no
# scheme, a `user:password@` ahead of a host goes, the form ssh prints
# (`user:tok@host: Permission denied`); a user alone (`git@host`) is no
# credential and stays. Each line is kept as a line. sed runs in the C locale,
# so a byte that is not UTF-8 passes through where a UTF-8 locale's sed would
# die on it. release_text_shown runs every message through here after its own
# passes for each remote's url. THE LIMIT, DECLARED: a password holding a raw
# `/` (a malformed url, which git does not read as one either) ends the search
# at that `/`, so the userinfo is printed; so is a secret elsewhere in a url,
# such as its query, which is not looked for.
text_shown() {
  printf '%s\n' "$1" |
    LC_ALL=C sed -E -e 's#://[^/[:space:]]*@#://#g' \
      -e 's#(^|[^[:alnum:]._~%+-])[[:alnum:]._~%+-]+:[^@/[:space:]]*@#\1#g'
}

# git_marker_above <dir> [<ceiling>] -- whether the absolute, physical <dir>, as
# physical_dir gives it, or a directory above it holds a `.git`: a directory, a
# gitfile, or a link, dangling included. rc 0 when one does, rc 1 when none
# does, rc 2 when <dir> is not absolute, so the question has no answer. Given a
# <ceiling>, a proper ancestor of <dir> as git_ceiling gives it, the walk looks
# in no directory at or above it, as git's own discovery does not.
#
# READ FROM THE FILESYSTEM, NEVER ASKED OF GIT, for a caller whose git did not
# answer (issue 0179). A repository git refuses to read -- one owned by another
# user, unless safe.directory names it -- fails with the status a tree with no
# repository fails with, and only git's words, which a locale translates, tell
# the two apart. The walk is textual and does not stop at a filesystem
# boundary, where git's discovery does, so a marker beyond one still counts;
# and a directory that is itself a bare repository holds no `.git`, so it
# counts as none.
git_marker_above() {
  local d="$1" ceiling="${2-}" floor up
  case "$d" in
    /*) ;;
    *) return 2 ;;
  esac
  # Stripped here, not in the pattern: bash 5.3 matches nothing against a
  # quoted "${ceiling%/}"/?* when the strip leaves it empty, as it does for `/`.
  floor="${ceiling%/}"
  until [ -e "$d/.git" ] || [ -L "$d/.git" ]; do
    up="${d%/*}"
    [ "$up" != "$d" ] || return 1
    if [ -n "$ceiling" ]; then
      case "$up/" in
        "$floor"/?*) ;;
        *) return 1 ;;
      esac
    fi
    d="$up"
  done
  return 0
}

# git_ceiling <dir> <out-var> -- the GIT_CEILING_DIRECTORIES entry git's own
# discovery stops below when it starts in the physical <dir>: the longest entry
# that is a proper ancestor of <dir>, or empty when none is. The list is read
# as git reads it: entries part at `:` alone (colon_split), so a newline is part
# of the entry it is in; a relative one is ignored, one before an empty entry
# is resolved by physical_dir and dropped when it cannot be, one after it is
# compared as written, and one trailing `/` is dropped, so `/` keeps the walk
# out of the root alone. An entry equal to <dir> is no ceiling,
# since git always looks in the directory it starts in. An entry keeps the case
# it is typed in, as git's does, and <dir> is to be spelled through getcwd
# (physical_dir's getcwd form), as git's working directory is, so on a disk that
# folds case a ceiling typed in another case than <dir> is stored in hides
# nothing, from git or here.
#
# Measured on git 2.56.0 (issue 0185): with a repository at r, a ceiling of r
# hides it from r/a/b and not from r; r/, r/a and a link to r hide it too; the
# link written after an empty entry does not, and a relative r does not.
#
# Its locals carry its own prefix, since <out-var> is a caller's name reached
# through bash's dynamic scope, and a local of the same name would take it.
git_ceiling() {
  local _gcl_e _gcl_c _gcl_raw="" _gcl_len=-1 _gcl_list=()
  local -n _gcl_res="$2"
  _gcl_res=""
  colon_split "${GIT_CEILING_DIRECTORIES-}" _gcl_list
  for _gcl_e in "${_gcl_list[@]}"; do
    case "$_gcl_e" in
      "")
        _gcl_raw=1
        continue
        ;;
      /*) ;;
      *) continue ;;
    esac
    if [ -n "$_gcl_raw" ]; then
      _gcl_c="$_gcl_e"
    else
      physical_dir "$_gcl_e" _gcl_c || continue
    fi
    _gcl_c="${_gcl_c%/}"
    case "$1" in
      "$_gcl_c"/?*) ;;
      *) continue ;;
    esac
    if [ "${#_gcl_c}" -gt "$_gcl_len" ]; then
      _gcl_len="${#_gcl_c}"
      _gcl_res="${_gcl_c:-/}"
    fi
  done
}

# git_repo_absent <dir> -- whether a git call that failed in <dir> failed for
# want of a repository: true only when no `.git` sits at <dir>, resolved and
# spelled as git spells it (physical_dir's getcwd form), or above it, up to where
# git's own discovery stops at GIT_CEILING_DIRECTORIES (git_ceiling) --
# git_marker_above's plain no.
# Anything else is not known to be absent: a `.git` within that reach, or a
# <dir> that cannot be resolved. Most often that is a repository another user
# owns, which git refuses unless safe.directory names it; it may be one whose
# marker git cannot read, or a checkout with no git on PATH to read it.
#
# THE ONE READING OF A FAILED GIT CALL (issue 0185). Readers took the failure
# for no repository, so a project vendored from a checkout git refused to read
# recorded `source: checkout` above "not a git checkout". Every reader of a
# failed call asks this, and says which in its own words; the readers whose answer
# is right either way, git_head_watch_paths and commit_direction, say why not.
#
# NOT A COPY OF GIT'S DISCOVERY. It walks further than git in these places, and
# there it errs towards could-not-read: it does not stop at a filesystem
# boundary (GIT_DISCOVERY_ACROSS_FILESYSTEM), and it does not pass over a `.git`
# git passes over as no repository (a dangling link, an empty directory). It
# errs the other way inside a bare repository: a directory there holds no
# `.git`, so it reads as absent where git would refuse that repository or read
# it.
git_repo_absent() {
  local d c rc=0
  physical_dir "$1" d getcwd || return 1
  git_ceiling "$d" c
  git_marker_above "$d" "$c" || rc=$?
  [ "$rc" -eq 1 ]
}

# git_failure_line [--plain] <dir> <git-args...> -- the first line git writes
# to stderr for `git -C <dir> <git-args...>`, run through git_readonly in the C
# locale, or nothing, as with no git on PATH. For a caller whose call has
# already failed and that has only to say why, so the status is not read here;
# the words are git's, untranslated, so a message carries what git said rather
# than a guess at it (issue 0185).
#
# --plain asks a plain git, in the caller's environment, for a caller whose own
# call was one (issue 0186). git_readonly clears GIT_INDEX_FILE, so a reason
# asked through it comes from the repository's own index, not the one a commit
# hook names, which is the one that failed.
git_failure_line() {
  local dir out plain=no
  if [ "${1-}" = --plain ]; then
    plain=yes
    shift
  fi
  dir="$1"
  shift
  if [ "$plain" = yes ]; then
    out="$(LC_ALL=C git -C "$dir" "$@" 2>&1 >/dev/null)" || true
  else
    out="$(LC_ALL=C git_readonly -C "$dir" "$@" 2>&1 >/dev/null)" || true
  fi
  printf '%s\n' "${out%%$'\n'*}"
}

# git_head_sha [root] [short|full] -- the commit sha, or `unknown`.
#
# `unknown` rather than empty or a failure, because every caller in the corpus
# already handles that string and a build stamped with an empty version is worse
# than one stamped honestly as unresolved.
#
# The form is a PARAMETER rather than a second function, which is the whole
# point of this being issue 0014's one home: `git_head_sha_full` beside it would
# be two readers of one fact, free to disagree about the failure string the
# moment either is touched. `short` stays the default so every existing caller
# is unchanged.
git_head_sha() {
  # THROUGH git_readonly for the reason at git_head_identity (issue 0094): an
  # inherited GIT_DIR outranks `-C`, and the identity's two halves must read one
  # repository. rev-parse takes no lock, so the lock is not the reason.
  local root="${1:-${PROJECT_ROOT:-.}}" form="${2:-short}" sha
  case "$form" in
    full) sha="$(git_readonly -C "$root" rev-parse HEAD 2>/dev/null)" || sha="" ;;
    *) sha="$(git_readonly -C "$root" rev-parse --short HEAD 2>/dev/null)" || sha="" ;;
  esac
  [ -n "$sha" ] || sha=unknown
  printf '%s\n' "$sha"
  return 0
}

# git_head_identity [root] -- `<full sha>`, `<full sha> +dirty`,
# `<full sha> +unreadable`, or `unknown`.
#
# What a `--version` line should say about WHICH bytes are running. A bare sha
# on a dirty tree is a confident false statement: the binary in front of you is
# not that commit.
#
# `+unreadable` IS A TREE WHOSE STATE GIT COULD NOT READ (issue 0186). Over an
# index git cannot read, rev-parse names the commit and status fails, and the
# failure, read as an empty status, printed the bare sha. The commit is known;
# whether these bytes are that commit is not, and the mark says so.
#
# IT SAYS `+dirty` AND NOT `THESE BYTES MATCH NO COMMIT`, AND THE DIFFERENT
# WORDING IS DELIBERATE RATHER THAN A DRIFTED COPY. `source_commit_of` in
# lib/install stamps that sentence, and it is making a narrower and stronger
# claim: the VENDORED FILE SET does not correspond to any commit, which is a
# statement about bytes somebody else will later read out of a manifest (issue
# 0033). This function answers a looser question -- the working tree it is
# standing in has uncommitted changes -- and borrowing the stronger sentence for
# it would put a provenance claim on a checkout that never made one. Two claims,
# two vocabularies, one producer each.
# platform_identity -- WHICH MACHINE produced this, as one line.
#
# THE NARROWING THAT COST THE FIRST TAGGED RELEASE (issue 0052), which names
# the version -- this file may not, and the guard that says so is right even
# here: a version literal in a source file is a hazard whether it is a claim or
# a citation. A local `test all`
# runs on one machine. Its seal is a true record of a macOS run, and nothing in
# the `.out`, the `.errors` or the summary named a platform -- so
# `824 tests, 0 failures` read as a fact about devbin when it was a fact about
# one OS. CI had been red on Ubuntu for six days and three pushes, one of them
# the release, and the release note's Verified section was assembled from those
# local seals. The instrument was sound and aimed one unit wide, and the output
# said nothing about which unit.
#
# BASH IS IN IT ALONGSIDE uname, and not for symmetry: bash >= 5 is this
# project's floor (issue 0022) and macOS ships 3.2.57 at /bin/bash, so "which
# bash" is a real axis on which two runs of the same code differ. The two
# together are what distinguishes a green anyone can rely on from a green about
# one machine.
#
# It says nothing about the analyser versions that were 0052's OTHER narrowing.
# Those are a property of a gate's TOOL rather than of the run, and pinning
# them is the analyser's own job -- .github/install-shellcheck.sh does it by
# asserting the version it installed. Claiming them here would be devbin
# reporting a fact it did not establish.
platform_identity() {
  printf '%s / bash %s' "$(uname -srm 2>/dev/null || printf 'unknown')" \
    "${BASH_VERSION:-unknown}"
}

# runtime_digest <launcher> <libdir> -- SHA256 of the RUNTIME BYTES, 12 hex.
#
# THE ONE HOME FOR "WHICH BYTES ARE THESE", and it has more than one reader: the
# `--version` line here, and a caller that reports a digest per tree, which had
# this computation written out inside it. Two copies of a fingerprint is the
# worst duplication available -- when they drift, the two surfaces report
# different identities for one tree and neither says which is authoritative.
#
# A STAMP IS NOT AN IDENTITY. `git_head_identity` below answers "which commit
# was this checkout on", which is a different question and can be `<sha> +dirty`
# -- a value that names no bytes at all. This answers the one a reader comparing
# installs actually has: are these the same runtime.
#
# PATHS ARE FOLDED IN RELATIVE TO THE LIB DIRECTORY, not to a project root, and
# the choice is load-bearing. It makes a source checkout (`lib/helpers`) and an
# install of it (`bin/.devbin/lib/helpers`) digest IDENTICALLY when the bytes
# match, which is the comparison anyone re-vendoring actually wants. Folding
# against a root would have made every install differ from its own source by
# construction, and the difference would have looked like divergence.
#
# The paths go in ALONGSIDE the contents so a moved or missing file changes the
# digest rather than hiding inside a concatenation.
#
# A RUNTIME IT CANNOT READ WHOLE HAS NO DIGEST: it returns 1, printing
# nothing, and says what it could not read (issue 0139). The listing's errors
# went to /dev/null, so a directory find could not read left its files out, and
# a file cat could not read, the launcher's error discarded too, went in as its
# path alone: either way the value named a different runtime, and nothing said
# why. find's own error names a directory, and a file is named here.
#
# THE ORDER IS C COLLATION'S, WHATEVER THE READER'S LOCALE (issue 0204). Each
# path goes into the stream, so the order is part of the identity, and a bare
# sort ordered by the reader's collation (LC_ALL, else LC_COLLATE, else LANG):
# C puts LICENSE.md ahead of the lowercase names and an en_* UTF-8 locale puts
# it among the l's, so one runtime read as one digest to a C reader and another
# to a reader whose locale collates otherwise. Pinned, every reader gets the
# order a C reader always had: a C reader's digest does not move, and any
# other reader's moves once, to the C reader's.
#
# -H FOLLOWS A LIB DIRECTORY THAT IS A SYMLINK, AT THE START POINT ONLY
# (issue 0139). find's default -P read such a libdir as the link
# itself, listed nothing, and the runtime digested as its launcher alone
# (measured) at rc 0; a caller's `[ -d ]` guard lets that libdir through. A
# trailing slash on the operand would follow it as well, and would move every
# install's digest, since the strip below is spelled against $libdir.
runtime_digest() {
  local launcher="$1" libdir="$2" f files digest
  # A LIB THAT IS NOT A DIRECTORY IS NO RUNTIME: a link naming nothing was
  # followed by -H to nothing, listed nothing, and digested as the launcher
  # alone, at rc 0.
  [ -d "$libdir" ] || {
    warn "runtime digest: $libdir is not a directory"
    return 1
  }
  files="$(find_walk -H "$libdir" -type f -print)" || return 1
  [ -r "$launcher" ] || {
    warn "runtime digest: cannot read $launcher"
    return 1
  }
  while IFS= read -r f; do
    [ -z "$f" ] || [ -r "$f" ] || {
      warn "runtime digest: cannot read $f"
      return 1
    }
  done <<<"$files"
  # EVERY READ READS ITS OWN STATUS, AND THE DIGEST IS PRINTED ONLY WHOLE. The
  # test above is a moment before the reads, so a file removed or locked between
  # the two was digested as absent: rc 0 and the digest of a runtime that is not
  # the one on disk, or, at the last file, rc 1 with a digest printed anyway.
  # The bytes digested are unchanged, so no install's digest moves. A link
  # inside lib is neither followed nor digested -- -H follows the start point
  # only -- and none is ever vendored, since vendored_paths lists regular files:
  # declared, not closed.
  digest="$(
    set -o pipefail
    {
      cat "$launcher" || exit 1
      printf '%s\n' "$files" | LC_ALL=C sort | while IFS= read -r f; do
        [ -n "$f" ] || continue
        printf '%s\n' "${f#"$libdir"/}"
        cat "$f" || exit 1
      done
    } | sha256_stdin | cut -c1-12
  )" || {
    warn "runtime digest: the runtime could not be digested whole (any error above names what failed)"
    return 1
  }
  printf '%s\n' "$digest"
}

# version_identity [root] -- the ONE renderer for `<name> <version> (<tree>)`.
#
# TWO CALL SITES ASK THE SAME QUESTION AND ONCE ANSWERED IT DIFFERENTLY.
# `bin/devbin --version` printed the name, the version and the tree's commit;
# `bin/devbin version` printed the name and the version alone. Same question,
# one tree, two answers, and nothing in either output said which one was the
# whole story -- found by running both in devbin's own checkout, where the
# project IS devbin so the disagreement had nowhere left to hide.
#
# It is a Highlander violation of the ordinary kind: not duplicated logic, but
# duplicated RENDERING, which is the copy that drifts without anyone noticing
# because each site reads correct on its own. The fix is this function and the
# rule that no third site prints this line itself.
#
# `version show` deliberately does NOT come through here. It is the machine
# arm -- a bare number for scripting -- and giving it provenance would break
# every line-oriented reader that consumes it.
version_identity() {
  local root="${1:-${PROJECT_ROOT:-.}}"
  # DEVBIN'S OWN DEV TREE ANSWERS WITH THE TREE LINE (issue 0213): there the
  # project is devbin, so its version is the one T4 of docs/dev-opt-brew.md
  # fixes for every devbin tree. A consumer keeps its own line below.
  if [ "$(devbin_tree "$root")" = dev ]; then
    devbin_tree_line "$root"
    return 0
  fi
  # A runtime find could not read whole reads UNREADABLE (issue 0139), never an
  # empty digest a reader would take for a value.
  local digest
  digest="$(runtime_digest "$root/bin/devbin" "${DEVBIN_LIB:-$root/lib}")" || digest=UNREADABLE
  # shellcheck disable=SC2119  # the bare call IS the point: version-file role.
  # This directive travelled here WITH the call. It used to sit in bin/devbin
  # above the printf that moved into this function, and leaving it behind is
  # what reddened lint on the first run of this change -- a suppression is
  # part of its call site, not of the file it was written in.
  # TWO FIELDS BECAUSE THEY ANSWER TWO QUESTIONS AND ONE OF THEM CAN BE EMPTY
  # OF MEANING. The commit says where this checkout stood; on a dirty tree it
  # says `+dirty`, which names no bytes at all and is exactly when a reader most
  # needs an identity. `runtime` is that identity: the same twelve hex
  # runtime_digest gives every caller, so `--version` here and another caller's
  # report can be compared directly without either side deriving anything.
  #
  # NOT CALLED `tree`. The first draft used that word and it is the wrong one for
  # this value: `tree` is a git object, a reader meeting it would go looking for
  # one, and would not find it -- a wrong mechanism in a provenance line is
  # actionable in the wrong direction. Rename it if the git object was meant.
  printf '%s %s (%s, runtime %s)\n' "${DEVBIN_NAME:-devbin}" "$(read_version)" \
    "$(git_head_identity "$root")" "$digest"
}

git_head_identity() {
  local root="${1:-${PROJECT_ROOT:-.}}" sha state
  sha="$(git_head_sha "$root" full)"
  if [ "$sha" = unknown ]; then
    printf 'unknown\n'
    return 0
  fi
  # THROUGH git_readonly, BOTH HALVES (issue 0094). A plain `git status` takes
  # the optional index lock and rewrites a stale index, so `--version` wrote
  # into the repository it describes. The sha goes the same way for a different
  # reason: an inherited GIT_DIR outranks `-C`, and with only one half cleared
  # the line would pair one repository's commit with another tree's `+dirty`.
  # A status git could not give is no clean tree (issue 0186).
  if ! state="$(git_readonly -C "$root" status --porcelain 2>/dev/null)"; then
    printf '%s +unreadable\n' "$sha"
  elif [ -n "$state" ]; then
    printf '%s +dirty\n' "$sha"
  else
    printf '%s\n' "$sha"
  fi
  return 0
}

# _git_path <root> <name> -- `git rev-parse --git-path <name>`, made ABSOLUTE,
# printed only when it names a file that exists. Returns 1 otherwise.
#
# THE ABSOLUTISING IS NOT TIDINESS, AND A TEST FOUND IT. `--git-path` answers
# RELATIVE in a normal checkout (`.git/HEAD`) and ABSOLUTE in a linked worktree,
# where the gitdir is somewhere else entirely. So a caller doing `[ -f "$p" ]`
# from any other directory -- which a build script always is -- resolves
# everything in the worktree case and NOTHING in the ordinary one. That is the
# exact inverse of the bug this whole function exists to fix, and it would have
# shipped looking right: every hard test passed and the easy one failed.
_git_path() {
  local root="$1" p
  p="$(git -C "$root" rev-parse --git-path "$2" 2>/dev/null)" || return 1
  [ -n "$p" ] || return 1
  case "$p" in
    /*) ;;
    *) p="$root/$p" ;;
  esac
  [ -f "$p" ] || return 1
  printf '%s\n' "$p"
  return 0
}

# git_head_watch_paths [root] -- every EXISTING file whose mtime tracks HEAD,
# one absolute path per line. Returns 1, loudly, when it resolves none.
#
# `git rev-parse --git-path` is the whole trick: git already knows about worktree
# indirection, the common directory and the loose/packed question, and answers
# with a real path. Three separate layout rules that a hand-rolled implementation
# has to get right independently, and did not.
#
# THREE PATHS, EACH FOR A DIFFERENT EVENT:
#
#   HEAD          changes on checkout, and on every commit when detached
#   the branch    what actually moves on a commit -- and it lives in the COMMON
#                 directory, not the worktree's gitdir, because a worktree's own
#                 HEAD holds `ref: refs/heads/<x>` and that string never changes
#   packed-refs   `git pack-refs` DELETES the loose ref file, so a branch living
#                 only here drops out of any watch set built from loose paths
#
# THE EMPTY LIST IS THE FAILURE THAT MATTERS, AND IT IS CREATED BY THIS FIX.
# Before it, a broken watch meant "always rebuild" -- a cost, not a visible
# defect. Restoring a working watch restores CACHING, so an enumeration that
# quietly returned nothing would turn a slow-but-correct build into a fast and
# possibly wrong one. Same rule as a gate that examines nothing: empty-and-
# successful is the one answer that must not be available.
#
# A FAILED GIT CALL GIVES NO WATCH PATHS, whether there is no repository or one
# git will not read: there is no HEAD this run can read either way, so this
# does not ask git_repo_absent which (issue 0185).
git_head_watch_paths() {
  local root="${1:-${PROJECT_ROOT:-.}}" ref n=0
  if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    _git_path "$root" HEAD && n=$((n + 1))
    ref="$(git -C "$root" symbolic-ref -q HEAD 2>/dev/null)" || ref=""
    if [ -n "$ref" ]; then
      _git_path "$root" "$ref" && n=$((n + 1))
    fi
    _git_path "$root" packed-refs && n=$((n + 1))
  fi
  if [ "$n" -eq 0 ]; then
    warn "git_head_watch_paths: resolved NO files to watch under $root"
    warn "  a build baking the sha would never refresh it -- do not cache on an empty watch set"
    return 1
  fi
  return 0
}

# assert_identifier <value> <what> -- refuse a value that cannot be a shell
# variable name, or that would clobber one the shell needs.
#
# Devbin turns CONFIG VALUES into variable names: `project.root_var`,
# `options.<name>.export`, and `<NAME>_ROOT` derived from `project.name`. The
# config KEY charset is validated by the parser; these values were not, and the
# failure was raw and unlocated -- a space in any of them produced bash's own
# `export: not a valid identifier`, with no `config:` prefix and no file, which
# is well below the bar every other malformed-config message meets.
#
# The reserved list is short and only holds names whose loss breaks the run
# itself. `root_var: PATH` was the worst case found: the export succeeds, the
# handler exec then fails with `env: bash: No such file or directory` and exit
# 127, and nothing in that message points anywhere near the config that caused
# it. Refusing beats diagnosing.
# is_identifier <value> -- true when <value> is a shell variable name: a letter
# or underscore, then letters, digits and underscores. THE ONE DEFINITION, and
# it is a predicate rather than a refusal because its callers refuse
# differently: assert_identifier dies with a message naming which rule the value
# broke, and run_words and find_list warn and return, since nothing in the
# release library may die. The charset lived only inside assert_identifier
# until run_words needed the same question (issue 0082), and a second spelling
# of "is a name" is exactly the divergence Highlander is about.
is_identifier() {
  case "${1:-}" in
    '' | [!A-Za-z_]* | *[!A-Za-z0-9_]*) return 1 ;;
  esac
  return 0
}

assert_identifier() {
  local value="${1:-}" what="${2:-value}"
  # is_identifier gives the VERDICT; the case below only chooses the sentence,
  # which is why it no longer has a rule the predicate does not have.
  if ! is_identifier "$value"; then
    case "$value" in
      '') die "$what is empty -- it has to be a shell variable name" ;;
      [!A-Za-z_]*) die "$what must start with a letter or underscore, got '$value'" ;;
      *) die "$what may contain only letters, digits and underscore, got '$value'" ;;
    esac
  fi
  case "$value" in
    PATH | IFS | HOME | PWD | OLDPWD | SHELL | BASH_ENV | ENV | LD_PRELOAD | LD_LIBRARY_PATH)
      die "$what must not be '$value' -- overwriting it breaks the commands devbin runs"
      ;;
    # devbin's OWN environment, enumerated rather than matched as `DEVBIN_*`.
    # The wildcard was the first thing tried and it broke Devbin itself inside a
    # minute: this project is called `devbin`, so its derived root variable is
    # `DEVBIN_ROOT` -- a legitimate name devbin does not use, refused by a
    # pattern aimed at names it does. Devbin uses devbin, so the guard's
    # own overreach failed here before it could reach a live project.
    #
    # EVERY NAME THE DISPATCHER EXPORTS TO A HANDLER, and a pattern only for the
    # families whose names it composes. The list is a copy of exports that
    # live in bin/devbin and lib/resolve, so it drifts each time one is added: it
    # fell six names and DEVBIN_ACTIVE_* behind, and root_var overwrote the run
    # id, the stamp, the referent and the cli task with the project root, rc 0
    # (issue 0081). tests/unit/review.bats now holds it to the names a handler
    # receives. DEVBIN_TREEINDEX_DIRS left it when its export did (issue 0032).
    DEVBIN_NAME | DEVBIN_INVOKE | DEVBIN_LIB | DEVBIN_DIR | DEVBIN_ROOT_VAR | DEVBIN_COMMAND | DEVBIN_ARGS | \
      DEVBIN_SEAL_LEDGER | DEVBIN_SEAL_LEDGER_RUN | DEVBIN_RUN_ID | DEVBIN_RUN_STAMP | DEVBIN_RUN_WITNESS | \
      DEVBIN_RUN_REFERENT | DEVBIN_CLI_TASK | DEVBIN_VERSION_FILE | DEVBIN_VERSION_SIDECARS | DEVBIN_LANGUAGES | \
      DEVBIN_CARGO_ROOT | DEVBIN_FMT_ARMS | DEVBIN_ACTIVE_* | DEVBIN_OPT_* | PROJECT_ROOT | BIN_DIR)
      die "$what must not be '$value' -- that name belongs to devbin's own environment"
      ;;
  esac
  return 0
}

# is_semver <value> -- true for MAJOR.MINOR.PATCH, digits only. The one test;
# assert_semver dies on it, and release reads a target through it.
is_semver() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# assert_semver <version> -- refuse anything that is not X.Y.Z.
#
# The corpus put each project's own current version in the error message, which
# is why four copies existed at all. The example is generic here; the value the
# caller passed is what the reader actually needs to see.
assert_semver() {
  is_semver "${1:-}" ||
    die "version must be semver (eg 1.2.3), got '${1:-}'"
}

# is_handler <path> -- true when <path> is a runnable handler: a REGULAR file
# carrying the execute bit.
#
# `-x` ALONE IS TRUE FOR A DIRECTORY, and the corpus keeps directories exactly
# where handlers live. One project's `demo_macos.d/pkg` is a directory of
# packaging resources sitting beside the real sub-handlers, so `macos pkg`
# descended into it and exec'd it: a raw bash "Is a directory" naming an
# internal library path, exit 126, and the handler never reached (issue 0005).
#
# One predicate for every site that asks "can I run this", so a second place
# cannot keep the old answer. Lives here because the question has no
# dependencies, which is what the layering rule at the top of this file
# requires.
is_handler() {
  [ -f "$1" ] && [ -x "$1" ]
}

# is_bare_version <string> -- true when <string> is a lone version and nothing
# else: it starts with a digit and carries only characters a version carries.
#
# DELIBERATELY LOOSER THAN assert_semver, and not a substitute for it. This
# guards the bare-version DEFAULT -- the branch that reads or writes a whole
# file as though the file were nothing but a version. Its question is "is this
# a version string at all", not "is this project's numbering well-formed", so
# `0.6.0-rc1`, `1.4` and `20260808` all pass. assert_semver still polices what a
# caller may SET.
#
# Both the reader and the writer ask this one predicate, which is the point: a
# reader and a writer that disagree about which files they mean is the exact
# mechanism `lib/cmd/version`'s own comment was written to prevent, and issue
# 0002 was the two of them agreeing on the wrong answer.
is_bare_version() {
  case "${1:-}" in
    [0-9]*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[!0-9A-Za-z.+-]*) return 1 ;;
  esac
  return 0
}

# rlwrap_exec <completions> <history> [--] <cmd> [args...] -- exec under rlwrap.
#
# Byte-identical in every project it was folded from. Missing rlwrap degrades to
# a plain exec with a warning rather than failing: losing history is an
# inconvenience, refusing to start a REPL is an outage.
#
# `opts` is a plain indexed array, which bash 3.2 has (the old bash 3.2
# support, since reversed by issue 0022, excluded only the ASSOCIATIVE arrays
# of bash 4). It is never empty at expansion, so it needs none of the
# `${a[@]+...}` guarding parse_common_opts does.
rlwrap_exec() {
  local completions="$1" history="$2"
  shift 2
  [ "${1:-}" = "--" ] && shift
  if command -v rlwrap >/dev/null 2>&1; then
    local opts
    opts=(-r -c -H "$history" -s 2000)
    if [ -n "$completions" ] && [ -f "$completions" ]; then
      opts=(-f "$completions" "${opts[@]}")
    fi
    exec rlwrap "${opts[@]}" "$@"
  fi
  warn "rlwrap not found -- no history or tab completion (try: brew install rlwrap, or apt-get install rlwrap)"
  exec "$@"
}

# ============================================================================
# GENERATED DOCUMENTATION, AND THE REFUSALS THAT MAKE IT SAFE
# ============================================================================
#
# generated_doc_write --target FILE --begin MARKER --end MARKER \
#   [--deny-env VAR]... [--expect-lines N] [--expect-contains STR]... \
#   -- <producer> [args...]
#
# Replace the region between two markers in FILE with what <producer> writes to
# stdout, or refuse and leave FILE untouched.
#
# WHY THIS IS HERE AND NOT IN A COMMAND. Projects independently needed to
# generate the factual half of a database runbook from live probes. The obvious
# read is that the PROVIDER CODE is the shared thing, which would put a fly.io
# opinion inside devbin and break the rule at lib/cmd/db:16. That read is wrong.
# The fly verbs are ninety lines, cheap to write and trivial to verify because
# you can just run them; what actually cost a measured incident is the
# DISCIPLINE of writing a generated file safely. So devbin owns the discipline
# and every project keeps its own producer. A Neon project writes a Neon
# producer and none of this changes (issue 0028).
#
# It is a HELPER rather than a command, which is what keeps the surface honest:
# no catalogue row, no opt-in cell, no `@builtin`, and no config schema key --
# so it costs devbin no new mechanism at all. The layering rule decides the
# home: needs config, belongs in resolve; needs nothing, belongs here.
#
# WHAT DEVBIN MUST NOT LEARN, and does not: what a cluster is, what a connection
# pooler is, that `--json` exists on anything, or that the output is Markdown.
# The markers are opaque delimiters and are REQUIRED rather than defaulted --
# any default would encode a comment syntax, and a framework that ships
# `<!-- ... -->` has quietly decided its consumers write HTML.
#
# It WARNS and RETURNS rather than dying, because a caller generating several
# documents must not lose the rest of them to the first refusal.
generated_doc_write() {
  local target="" begin="" end="" expect_lines=0
  local block nb ne bl el v s n
  local -a deny=() expect_contains=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --target) shift; target="${1:-}" ;;
      --target=*) target="${1#*=}" ;;
      --begin) shift; begin="${1:-}" ;;
      --begin=*) begin="${1#*=}" ;;
      --end) shift; end="${1:-}" ;;
      --end=*) end="${1#*=}" ;;
      --deny-env) shift; deny+=("${1:-}") ;;
      --deny-env=*) deny+=("${1#*=}") ;;
      --expect-lines) shift; expect_lines="${1:-0}" ;;
      --expect-lines=*) expect_lines="${1#*=}" ;;
      --expect-contains) shift; expect_contains+=("${1:-}") ;;
      --expect-contains=*) expect_contains+=("${1#*=}") ;;
      --) shift; break ;;
      *) die "generated_doc_write: unknown option '$1' (the producer goes after --)" ;;
    esac
    shift
  done

  # Usage errors DIE: they are the caller's bug and no run of this is correct.
  # The refusals below WARN, because they are facts about the world.
  [ -n "$target" ] || die "generated_doc_write: --target is required"
  [ -n "$begin" ] || die "generated_doc_write: --begin marker is required"
  [ -n "$end" ] || die "generated_doc_write: --end marker is required"
  [ $# -gt 0 ] || die "generated_doc_write: no producer given (put it after --)"

  if [ ! -f "$target" ]; then
    warn "generated_doc_write: $target does not exist -- this regenerates a region of a hand-authored file, it does not create one"
    return 1
  fi

  # R4 -- THE HAND-AUTHORED HALF SURVIVES. Everything outside the markers is
  # copied through untouched, including both marker lines. Regeneration must
  # never eat judgement: a probe can report a pooler's port and cannot report
  # that changing it needs the owner's say-so.
  #
  # Exactly one of each marker, in order, or refuse. Two begins is ambiguous
  # about which region is generated, and guessing is how a generator eats the
  # wrong half of a file.
  nb="$(grep -c -F -- "$begin" "$target" 2>/dev/null || true)"
  ne="$(grep -c -F -- "$end" "$target" 2>/dev/null || true)"
  if [ "${nb:-0}" -ne 1 ] || [ "${ne:-0}" -ne 1 ]; then
    warn "generated_doc_write: $target must contain each marker exactly once (found begin=${nb:-0} end=${ne:-0}) -- untouched"
    return 1
  fi
  bl="$(awk -v m="$begin" 'index($0, m) { print NR; exit }' "$target")"
  el="$(awk -v m="$end" 'index($0, m) { print NR; exit }' "$target")"
  if [ "$bl" -ge "$el" ]; then
    warn "generated_doc_write: $target has its end marker at line $el, before or at the begin marker at line $bl -- untouched"
    return 1
  fi

  # R2 -- NEVER WRITE FROM A FAILED MEASUREMENT. A producer that could not
  # measure exits non-zero and the target is left alone. This is the
  # determinate-zero doctrine in prose: a document assembled from failed probes
  # is worse than a stale one, because it looks freshly generated. Measured --
  # a project captured psql ERROR TEXT into a runbook and then reported counts
  # off it, which is a refuted inference wearing the format of a measurement.
  if ! block="$("$@")"; then
    warn "generated_doc_write: the producer exited non-zero -- $target left untouched"
    return 1
  fi
  if [ -z "$block" ]; then
    warn "generated_doc_write: the producer wrote nothing -- $target left untouched"
    return 1
  fi

  # R1 -- NEVER INLINE A SECRET, ENFORCED MECHANICALLY rather than by review.
  # Exact value matching, no entropy heuristics. Measured twice: a hand-edit
  # replaced a username in six places and left the old password beside it, which
  # authenticates as a rotation failure and reads like a platform problem; and a
  # cleanup step was about to fold a live credential into a runbook.
  for v in ${deny[@]+"${deny[@]}"}; do
    # UNSET OR EMPTY IS ITSELF A REFUSAL, and the message must say so. An unset
    # variable makes the check below compare against the empty string, which
    # every block contains -- so the naive version refuses, correctly, and
    # reports a leak. There was none. That is a wrong recorded reason, which is
    # worse than no reason: it sends the reader hunting a credential leak in a
    # file that is fine, and the real fault (a guard pointed at a variable that
    # is not there) goes unread. Driven red before this branch existed.
    if [ -z "${!v:-}" ]; then
      warn "generated_doc_write: --deny-env $v is unset or empty, so there is no value to search for -- $target left untouched. A secret guard that cannot see its secret must not pass, and has not."
      return 1
    fi
    # THE ADVICE NAMES THE VARIABLE, NEVER AN EXAMPLE URI (issue 0187). A
    # connection URI with the variable where its password goes is what a secret
    # scanner reads as a credential -- in this file, in every project that
    # vendors it, and in every log that captures the warning -- and the scanner
    # cannot tell the indirection from a value.
    case "$block" in
      *"${!v}"*)
        warn "generated_doc_write: \$$v's value appears in the generated block -- $target left untouched. Use env indirection in the producer's output -- write the literal text \$$v where the value would go -- rather than the value."
        return 1
        ;;
    esac
  done

  # R5 -- VALIDATE THE ARTEFACT, NOT THE EXIT PATH. A producer exiting 0 says it
  # ran; it does not say it produced the document. The expectation is the
  # producer's own declaration of what sufficient output looks like, which is
  # why there is no built-in threshold here to guess wrong.
  if [ "$expect_lines" -gt 0 ]; then
    n="$(printf '%s\n' "$block" | wc -l | tr -d ' ')"
    if [ "$n" -lt "$expect_lines" ]; then
      warn "generated_doc_write: the block is $n line(s), fewer than the $expect_lines declared -- $target left untouched"
      return 1
    fi
  fi
  for s in ${expect_contains[@]+"${expect_contains[@]}"}; do
    case "$block" in
      *"$s"*) ;;
      *)
        warn "generated_doc_write: the block does not contain the declared '$s' -- $target left untouched"
        return 1
        ;;
    esac
  done

  # R3 -- ATOMIC REPLACE, through replace_file above: the temporary beside the
  # target (a temp under /tmp renaming onto a project path can fail
  # cross-device), the target's mode, the rename, and the temporary removed on
  # a failure it returns -- the comment above stage_beside names the ways
  # one can still be left.
  #
  # What this gives and does NOT give: the reader sees the old file or the new
  # one and never a half-written one. It is not a durability guarantee -- shell
  # has no portable fsync, so a machine losing power at the wrong moment may
  # have neither. Atomicity is the property that matters here, and claiming the
  # other one would be the wrong kind of confident.
  if ! replace_file "$target" _generated_doc_assemble "$target" "$bl" "$el" "$block"; then
    warn "generated_doc_write: $target left untouched"
    return 1
  fi
  return 0
}

# _generated_doc_assemble <target> <begin-line> <end-line> <block> -- the new
# document on stdout: the target through its begin marker, the block, and the
# target from its end marker on.
_generated_doc_assemble() {
  awk -v n="$2" 'NR <= n' "$1" && printf '%s\n' "$4" && awk -v n="$3" 'NR >= n' "$1"
}

# MOVED HERE FROM lib/install WITH devbin_tree (issue 0213), for the reason the
# manifest readers below moved: the dispatcher answers `--version` from the tree
# it runs in and does not source lib/install. lib/install sources this file and
# calls them unchanged.

# devbin_lib_dir <root> -- where <root> keeps a devbin runtime, or return 1.
#
# The same two-place test the dispatcher makes on itself: the vendored copy
# first, the checkout's own lib/ as the fallback that lets Devbin run itself.
# The dispatcher has its own inline copy because it runs BEFORE any library is
# sourced -- it is the code that finds this file -- which is a real bootstrap
# exception rather than a licence to have two of these. Everything else asks
# here.
devbin_lib_dir() {
  local root="$1"
  if [ -d "$root/bin/.devbin/lib" ]; then
    printf '%s\n' "$root/bin/.devbin/lib"
    return 0
  fi
  if [ -d "$root/lib" ]; then
    printf '%s\n' "$root/lib"
    return 0
  fi
  return 1
}

# is_devbin_source <root> -- true when <root> can be vendored FROM.
#
# The dispatcher and lib/helpers, because those are the files whose absence
# makes every other check meaningless. Checked before upgrade writes anything
# (AC-09.9): a half-replaced runtime leaves a project that cannot run at all,
# which is strictly worse than the stale one it was replacing.
is_devbin_source() {
  local root="$1" lib
  [ -f "$root/bin/devbin" ] || return 1
  lib="$(devbin_lib_dir "$root")" || return 1
  [ -f "$lib/helpers" ] || return 1
  return 0
}

# is_devbin_installed <root> -- true when <root> carries a VENDORED runtime.
#
# Deliberately not `devbin_lib_dir` succeeding: a devbin CHECKOUT answers that
# too, via the source-checkout fallback, and calling the source tree "installed"
# would have `upgrade` try to re-vendor Devbin into itself.
is_devbin_installed() {
  [ -d "$1/bin/.devbin/lib" ]
}

# is_devbin_dev_tree <root> -- true when <root> is devbin's own SOURCE checkout.
#
# Derived from the two predicates that already exist rather than from a name or
# a path: a tree that can be vendored FROM but carries no VENDORED runtime of
# its own is a source checkout, because a consumer always has `bin/.devbin/lib`.
# The install tree has one too, so it reads as a consumer here -- which is
# correct: an install is project-shaped by design.
is_devbin_dev_tree() {
  is_devbin_source "$1" || return 1
  ! is_devbin_installed "$1"
}

# MOVED HERE FROM lib/install AT THE UPDATE-NOTICE CHANGE. The dispatcher
# needs to read manifest header lines on every invocation, and it does
# NOT source lib/install -- deliberately, because the install machinery has
# no business on the hot path of a launcher that runs on every command. The
# alternative was a second manifest reader in the dispatcher, which is the
# Highlander breach this project names first. lib/install sources this file
# and calls them unchanged.
DEVBIN_MANIFEST_REL="bin/.devbin/manifest.sha256"

manifest_path() { printf '%s\n' "$1/$DEVBIN_MANIFEST_REL"; }

# manifest_field <root> <field> -- read one `# <field>: <value>` header line.
manifest_field() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 1
  awk -v f="$2" '
    $0 !~ /^#/ { exit }
    {
      line = $0
      sub(/^#[[:space:]]*/, "", line)
      if (line ~ ("^" f ":")) {
        sub("^" f ":[[:space:]]*", "", line)
        sub(/[[:space:]]+$/, "", line)
        print line
        exit
      }
    }
  ' "$path"
}

# is_install_tree <root> -- rc 0 when the manifest at <root> records a machine
# install (`kind: install`), rc 1 otherwise, a manifest that is not there or
# cannot be read included (issue 0262). THE ONE READING OF A TREE'S KIND AS AN
# INSTALL: every reader that asks whether a tree is one asks this, so none
# compares the kind itself, and none spells the read's failure its own way, as
# the dispatcher's own guard once did.
is_install_tree() {
  [ "$(manifest_field "$1" kind 2>/dev/null || true)" = install ]
}

manifest_version() { manifest_field "$1" devbin_version; }
manifest_source_commit() { manifest_field "$1" source_commit; }

# devbin_tree <root> -- which of devbin's trees <root> is, one word, read in
# this order (docs/dev-opt-brew.md, T4):
#
#   brew       an install whose manifest says `managed_by: brew`
#   opt        an install whose manifest says `tool: devbin`
#   dev        devbin's own source checkout, a git checkout (a .git entry,
#              directory or file) with no install manifest
#   unknown    anything else, an opt install in the older manifest form among
#              them (devbin_install_old names it)
#
# A KEG IN THE OLDER FORM IS STILL brew: devbin's older keg manifest carries
# `managed_by: brew`, which is read first, so `use`, upgrade and the shadow
# check keep working on it, and only doctor's line about its manifest is a
# note (T3). So is a keg with NO manifest, recognised by its root resolving to
# Homebrew's opt link for devbin (_devbin_unmanifested_keg); an opt prefix with
# no manifest is no install of devbin's at all, and answers unknown.
#
# THE ONE ANSWER TO "WHICH TREE IS THIS". The version line, doctor and every
# verb that runs only in one tree ask it, so none of them can read a tree its
# own way. A vendored project is none of these: its manifest is a project's
# record, and it answers unknown.
devbin_tree() {
  local root="$1"
  if is_install_tree "$root"; then
    if [ "$(manifest_field "$root" managed_by 2>/dev/null || true)" = brew ]; then
      printf 'brew\n'
    elif [ "$(manifest_field "$root" tool 2>/dev/null || true)" = devbin ]; then
      printf 'opt\n'
    else
      printf 'unknown\n'
    fi
  elif _devbin_unmanifested_keg "$root"; then
    printf 'brew\n'
  elif is_devbin_dev_tree "$root" && { [ -e "$root/.git" ] || [ -L "$root/.git" ]; }; then
    # BY ITS .git, NOT BY ASKING GIT: a checkout git refuses to read (an unsafe
    # directory, a broken repository) is still the dev tree, and its line says
    # `unknown` for the commit rather than calling the tree unknown (T4).
    printf 'dev\n'
  else
    printf 'unknown\n'
  fi
}

# devbin_install_old <root> -- rc 0 when <root> is an install in the manifest
# form written before the contract: `kind: install` with no `tool:` line (T3).
# It is never read as a second format: doctor fails on it and names its remedy,
# `install --force` from the dev checkout for opt, `brew upgrade devbin` for
# brew.
devbin_install_old() {
  _devbin_unmanifested_keg "$1" && return 0
  is_install_tree "$1" || return 1
  [ -z "$(manifest_field "$1" tool 2>/dev/null || true)" ]
}

# _devbin_unmanifested_keg <root> -- rc 0 when <root> has no manifest and
# resolves to the same directory as Homebrew's opt link for devbin
# (devbin_brew_root): a keg from before kegs carried one, which T3 reads as an
# old brew manifest. Compared physically, so the keg under Cellar/ and its opt
# link are one tree.
_devbin_unmanifested_keg() {
  local brew a b
  [ ! -e "$(manifest_path "$1")" ] || return 1
  brew="$(devbin_brew_root)" || return 1
  physical_dir "$1" a || return 1
  physical_dir "$brew" b || return 1
  [ "$a" = "$b" ]
}

# devbin_tree_line <root> -- the one line that says which devbin is running:
# `devbin <version> (<tree>, <sha12>[+dirty])` (T4). In brew and opt the
# version and the commit are the manifest's; in dev they are the checkout's
# VERSION and HEAD, and `+dirty` follows while the runtime set, bin/devbin and
# lib/, has changes git has not committed. A dev tree whose git cannot be read
# keeps the line's shape with `unknown` for the commit, and doctor fails on it.
# The line names no path (issue 0230): where the running copy lives is
# `command -v devbin`'s answer, so no caller adds one back.
#
# THE FIELD IS BUILT FROM ITS PARTS (issue 0244): the commit's first twelve hex
# digits, then `+dirty`, never a slice of a longer string, so a 64-digit
# commit prints twelve. A recorded commit of fewer than twelve digits prints
# `unknown`, the line's one shape for a commit it cannot name in full.
#
# A RECORDED +dirty IS KEPT (issue 0277). An install's manifest records a dirty
# source as `<sha> +dirty -- THESE BYTES MATCH NO COMMIT`; the mark is read
# before the value is cut to its commit, so the line says `<sha12>+dirty` as T4
# has it, never the bare commit a clean tree at that commit prints.
devbin_tree_line() {
  local root="$1" tree ver sha dirty="" state
  tree="$(devbin_tree "$root")"
  case "$tree" in
    dev)
      ver="$(read_version "$root/VERSION" 2>/dev/null || true)"
      sha="$(git_head_sha "$root" full)"
      if [ "$sha" != unknown ]; then
        if ! state="$(git_readonly -C "$root" status --porcelain -- bin/devbin lib 2>/dev/null)"; then
          sha=unknown
        elif [ -n "$state" ]; then
          dirty=+dirty
        fi
      fi
      ;;
    *)
      ver="$(manifest_version "$root" 2>/dev/null || true)"
      sha="$(manifest_source_commit "$root" 2>/dev/null || true)"
      case "$sha" in *" +dirty"*) dirty=+dirty ;; esac
      sha="${sha%% *}"
      is_commit_sha "$sha" || sha=unknown
      ;;
  esac
  case "$sha" in
    unknown) ;;
    *) if [ "${#sha}" -ge 12 ]; then sha="${sha:0:12}$dirty"; else sha=unknown; fi ;;
  esac
  printf 'devbin %s (%s, %s)\n' "${ver:-unknown}" "$tree" "$sha"
}

# tree_line_head <line> -- a version line as T4's reader rule reads it: up to
# and including its first closing parenthesis, the rest ignored. So a line in
# the shape before issue 0230, with ` at <root>` after the parenthesis, or one
# with a compiled tool's provenance word there, reads as the same identity,
# and no reader carries a second format. A line with no parenthesis is read
# whole.
tree_line_head() {
  case "$1" in
    *")"*) printf '%s)\n' "${1%%")"*}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# machine_names_install <install root> -- rc 0 when this machine's install
# (machine_install_root) is the install at <root>, rc 1 otherwise, a machine
# whose install cannot be read included.
#
# COMPARED AS THE INSTALL IS NAMED, AND PHYSICALLY (issue 0251): a keg the opt
# link has moved past counts as the machine's once the opt link is what both
# name (install_named_root). A relative DEVBIN_INSTALL_PREFIX counts for
# nothing: a project's upgrade reads it from the project root, so the install it
# names there is not the one it names here.
machine_names_install() {
  local named machine m n
  named="$(install_named_root "$1")"
  machine="$(machine_install_root 2>/dev/null)" || return 1
  case "$machine" in
    /*) ;;
    *) return 1 ;;
  esac
  physical_dir "$machine" m && physical_dir "$named" n && [ "$m" = "$n" ]
}

# vendor_from_hint <install root> -- the line that tells an operator how a
# project vendors from an install: printed by publish and publish-upgrade, by
# the dispatcher's refusal to run from an install and by the install's own
# overview (install_remedies), which is why it lives here rather than in
# lib/install. One home keeps its callers from differing; what catches a WRONG
# line is the test, which runs the printed line in a consumer. A keg is named by
# its opt link (install_named_root), so a line copied from a brew install still
# runs after `brew upgrade`.
#
# NO --from WHERE THE MACHINE NAMES THAT INSTALL ALREADY (issue 0251): a
# project's upgrade reads the machine's install when it is given none
# (manifest_source), for every project whose manifest records the kind of its
# source, so the line it needs is the plain one. A project recording none is
# told by upgrade to name one with --from. A machine whose install cannot be
# read keeps --from, which works either way, and doctor names its fault.
vendor_from_hint() {
  if machine_names_install "$1"; then
    printf '  cd <your project> && bin/devbin upgrade\n'
    return 0
  fi
  printf '  cd <your project> && bin/devbin upgrade --from %s\n' "$(install_named_root "$1")"
}

# seed_hint <install root> -- the line that tells a reader how a project with no
# devbin yet is seeded from the install at <root>, by its launcher as the reader
# types it (launcher_shown, issue 0252).
seed_hint() {
  printf '  %s install --into <your project>\n' "$(launcher_shown "$1")"
}

# install_remedies <install root> -- what a reader does with the install at
# <root>: seed a project from it (seed_hint), or upgrade one that has devbin
# already (vendor_from_hint), each under its heading. THE ONE BLOCK for the
# dispatcher's refusal to run from an install and the install's own overview
# (issue 0251), so the two cannot word it differently.
install_remedies() {
  printf 'To SEED a project that has no devbin yet:\n'
  seed_hint "$1"
  printf '\nTo UPGRADE a project that already has one:\n'
  vendor_from_hint "$1"
}

# lib_rel -- where devbin's runtime lives, relative to the project root.
#
# DERIVED FROM DEVBIN_LIB, NEVER SPELLED (issue 0112). The overview and the
# templates listing named bin/.devbin/lib/ outright, which is right in every
# project and wrong in the devbin checkout, which runs lib/ in place -- so in
# the one tree that explains devbin, `devbin devbin` pointed at two paths that
# did not exist, beneath a line announcing that this was the checkout.
#
# MOVED HERE FROM lib/cmd/devbin (issue 0121), when `infra --help` turned out to
# spell the same path outright for its reference file. More than one handler
# needs it, and a second copy of a one-line derivation is how the first defect
# comes back.
lib_rel() {
  printf '%s' "${DEVBIN_LIB#"$PROJECT_ROOT"/}"
}

# home_relative <path> -- <path> with a leading $HOME written as `~`.
# home_expand <value> -- the inverse: `~` and `~/<rest>` expanded against $HOME.
#
# ONE DEFINITION OF THE `~` FORM, IN BOTH DIRECTIONS, WHERE THERE WERE FOUR
# (issue 0069). `install_prefix_configured` expanded a config value, a document
# generator wrote its paste line one way and its roots another, and the
# manifest's source needed both directions -- each with its own copy. They
# disagreed about exactly the two edges below, and the roots were written into a
# tracked document with no conversion at all.
#
# AN EMPTY HOME ENCODES NOTHING AND EXPANDS NOTHING. With HOME empty, "$HOME/"
# is "/", which every absolute path starts with: the writer would record a `~`
# followed by the whole absolute path, and the reader would expand `~/opt` to
# `/opt`, a real directory that is not the one meant -- and a publish would
# write into it. Verbatim is refused downstream BY NAME; a wrong absolute path
# is not. A HOME of `/` trims to empty and is treated the same way. That example
# is described rather than written out: a consumer's guard refuses any tracked
# file carrying a home-shaped path, and no pattern can tell prose from a path
# (issue 0109).
#
# THE PREFIX TEST IS "$home"/ AND NEVER "$home" ALONE. `/x/Devbi` is a string
# prefix of `/x/Devbin` and not its parent, and stripping it would write `~n`.
#
# SC2088 IS WRONG FOR BOTH, and each directive sits where it applies. The `~` is
# a CHARACTER in a value -- a config scalar, a manifest line, a line of a
# document someone pastes into their own shell -- and the whole point is that it
# did not expand. In `home_expand` the directive sits on the `case` and not on a
# branch: SC1124 refuses one in front of an individual case item, and putting it
# there does not merely fail to suppress -- it makes the whole expression
# unparseable, so every later check in the file is silently skipped. Measured,
# not assumed (moved here from `install_prefix_configured` with the code).
home_relative() {
  local path="$1" home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ]; then
    case "$path" in
      "$home")
        printf '%s\n' '~'
        return 0
        ;;
      "$home"/*)
        # shellcheck disable=SC2088
        printf '%s\n' "~/${path#"$home"/}"
        return 0
        ;;
    esac
  fi
  printf '%s\n' "$path"
}

home_expand() {
  local v="$1" home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ]; then
    # shellcheck disable=SC2088
    case "$v" in
      '~') v="$home" ;;
      '~/'*) v="$home/${v#'~/'}" ;;
    esac
  fi
  printf '%s\n' "$v"
}

# xdg_dir <state|data|config|cache> -- the XDG base directory: XDG_STATE_HOME,
# XDG_DATA_HOME, XDG_CONFIG_HOME or XDG_CACHE_HOME when it is absolute, as the
# XDG spec reads one, else its default under an absolute HOME: ~/.local/state,
# ~/.local/share, ~/.config or ~/.cache. rc 1, printing nothing, when neither
# is absolute (a HOME of `/` trims to empty, as home_expand reads it); rc 2 for
# another word. THE ONE STATEMENT OF THE XDG DEFAULTS (issue 0243): path_expand
# and the built-in macos's stage read them here. devbin_home_pointer keeps its
# own reading of XDG_DATA_HOME, retired with it (issue 0213). lib/infra reads
# its machine profile's directory here too (issue 0272).
xdg_dir() {
  local v d home="${HOME:-}"
  case "$1" in
    state) v="${XDG_STATE_HOME:-}" d=.local/state ;;
    data) v="${XDG_DATA_HOME:-}" d=.local/share ;;
    config) v="${XDG_CONFIG_HOME:-}" d=.config ;;
    cache) v="${XDG_CACHE_HOME:-}" d=.cache ;;
    *) return 2 ;;
  esac
  case "$v" in
    /*)
      [ "$v" = / ] || v="${v%/}"
      printf '%s\n' "$v"
      return 0
      ;;
  esac
  home="${home%/}"
  case "$home" in
    /*) printf '%s/%s\n' "$home" "$d" ;;
    *) return 1 ;;
  esac
}

# path_expand <path> -- <path> with a leading `~` or `~/` (home_expand), `$HOME`
# or `${HOME}`, or a leading XDG base-directory variable, `$XDG_STATE_HOME`,
# `$XDG_DATA_HOME`, `$XDG_CONFIG_HOME` or `$XDG_CACHE_HOME` as `$X` or `${X}`,
# expanded, and nothing else in it: so a config value names a directory
# outside the project without one machine's own path (issue 0243). An XDG
# variable reads as xdg_dir reads it, so `${XDG_STATE_HOME}/x` holds with the
# variable unset, as it usually is on macOS. A variable is a whole leading
# component, ending at a `/` or the path's end. A path that opens with neither
# `~` nor `$` is printed as it is. rc 1, printing HOME, when a `~`, `$HOME` or
# an XDG variable's default needs HOME and it is not an absolute path below /.
# rc 2, printing what the path opens with, for any other leading `~` or `$`:
# `~user`, `$FOO`, `${FOO}`, `${X:-...}`, `$1`, which a caller refuses by name
# rather than read as a path in the project. Pure but for the environment it
# reads.
path_expand() {
  local p="$1" name rest base head tail home="${HOME:-}"
  home="${home%/}"
  # shellcheck disable=SC2088
  case "$p" in
    '~' | '~/'*)
      case "$home" in
        /*)
          home_expand "$p"
          return 0
          ;;
      esac
      printf 'HOME\n'
      return 1
      ;;
    '~'*)
      printf '%s\n' "${p%%/*}"
      return 2
      ;;
    '$'*) ;;
    *)
      printf '%s\n' "$p"
      return 0
      ;;
  esac
  # The name, `${NAME}` to its first `}` or `$NAME` to its first `/`, is a name
  # only as is_identifier reads one, and what follows it is nothing or a `/`.
  # shellcheck disable=SC2016 # a literal ${, matched, not expanded
  case "$p" in
    '${'*'}'*)
      name="${p:2}"
      name="${name%%\}*}"
      rest="${p:${#name}+3}"
      ;;
    *)
      name="${p:1}"
      name="${name%%/*}"
      rest="${p:${#name}+1}"
      ;;
  esac
  if ! is_identifier "$name" || { [ -n "$rest" ] && [ "${rest:0:1}" != / ]; }; then
    # What it opens with: a `${...}` to its first `}` and on to the next `/`,
    # or any other form to its first `/`.
    # shellcheck disable=SC2016 # a literal ${, matched, not expanded
    case "$p" in
      '${'*'}'*)
        head="${p%%\}*}}"
        tail="${p#"$head"}"
        printf '%s\n' "$head${tail%%/*}"
        ;;
      *) printf '%s\n' "${p%%/*}" ;;
    esac
    return 2
  fi
  case "$name" in
    HOME)
      base="$home"
      case "$base" in /*) ;; *) base="" ;; esac
      ;;
    XDG_STATE_HOME) base="$(xdg_dir state)" || base="" ;;
    XDG_DATA_HOME) base="$(xdg_dir data)" || base="" ;;
    XDG_CONFIG_HOME) base="$(xdg_dir config)" || base="" ;;
    XDG_CACHE_HOME) base="$(xdg_dir cache)" || base="" ;;
    *)
      printf '%s\n' "${p%%/*}"
      return 2
      ;;
  esac
  if [ -z "$base" ]; then
    printf 'HOME\n'
    return 1
  fi
  printf '%s%s\n' "$base" "$rest"
}

# devbin_home_pointer -- where the machine pointer was kept: one line, an
# install's absolute root (issue 0153), in the XDG data directory, where
# XDG_DATA_HOME counts only when it is absolute; otherwise ~/.local/share. An
# empty HOME locates nothing.
#
# RETIRED (issue 0213). The link `devbin use` writes is the one record of which
# install this machine reads (devbin_link_path), and nothing reads this file.
# Doctor asks where it is only to name one still on a machine, with its remedy.
devbin_home_pointer() {
  local d="${XDG_DATA_HOME:-}" home="${HOME:-}"
  case "$d" in
    /*) ;;
    *)
      home="${home%/}"
      [ -n "$home" ] || return 1
      d="$home/.local/share"
      ;;
  esac
  printf '%s\n' "${d%/}/devbin/home"
}

# brew_opt_link <homebrew prefix> -- Homebrew's opt link for devbin under
# <prefix>, <prefix>/opt/devbin, which leads to the current keg. Its bin/devbin
# is the keg's own launcher: the formula's env script on macOS, which puts the
# formula's bash first on PATH, and a link to libexec's launcher on Linux
# (issue 0266). Pure.
# brew_opt_root <homebrew prefix> -- where Homebrew keeps devbin under <prefix>
# across upgrades, <prefix>/opt/devbin/libexec. Pure.
# brew_keg_root <libexec root> -- the keg a formula's libexec root sits in,
# its parent, where Homebrew puts the README and the formula the guides
# (issue 0254). Pure.
# brew_keg_prefix <root> -- the Homebrew prefix whose keg <root> is, when <root>
# is one, <prefix>/Cellar/devbin/<version>/libexec: rc 0 with the prefix, rc 1
# otherwise. Pure.
# brew_bin_link <homebrew prefix> -- the link `brew link` makes for devbin in
# Homebrew's bin, <prefix>/bin/devbin, which answers on PATH once devbin's own
# link is gone (0235). Pure.
#
# THE ONE SPELLING OF THE FORMULA'S LAYOUT (issue 0195). Discovery,
# the sentence that says where it looked, and the opt link shell-init and the
# hints name a keg by each spelled it, so a formula that moved the runtime would
# have been followed by one and missed by the others.
brew_opt_link() {
  printf '%s/opt/devbin\n' "${1%/}"
}
brew_opt_root() {
  printf '%s/libexec\n' "$(brew_opt_link "$1")"
}
brew_keg_root() {
  printf '%s\n' "${1%/libexec}"
}
brew_keg_prefix() {
  case "$1" in
    /*/Cellar/devbin/*/libexec) printf '%s\n' "${1%%/Cellar/devbin/*}" ;;
    *) return 1 ;;
  esac
}
brew_bin_link() {
  printf '%s/bin/devbin\n' "${1%/}"
}

# install_named_root <root> -- the path to name the install at <root> by: when
# <root> is a Homebrew keg, its prefix's opt link; <root> otherwise.
#
# A KEG IS NAMED BY ITS OPT LINK (issue 0195). The launcher resolves its own
# links, so an install Homebrew placed runs from Cellar/devbin/<version>, which
# `brew upgrade` and its cleanup delete: a path written into `dvb`, or copied
# from a hint, would name a keg that is gone. opt/devbin follows each upgrade.
#
# WHICHEVER KEG THE OPT LINK LEADS TO (issue 0252). It is taken even while it
# leads to another keg, as while brew builds the next, or when an old keg is
# kept and run by its Cellar path: a hint is used later, a failed build's keg is
# removed, and a keg left behind goes at cleanup, so the opt link is the one
# name that still runs. It is named whether or not it is there yet: during
# brew's first install it is the link brew is about to make, and a tree that
# only sits at a keg's path is named by a link that may never exist.
install_named_root() {
  local brew
  if brew="$(brew_keg_prefix "$1")"; then
    brew_opt_root "$brew"
    return 0
  fi
  printf '%s\n' "$1"
}

# install_launcher_root <root> -- the tree whose bin/devbin is the launcher to
# name for the install at <root>: for a Homebrew keg (brew_keg_prefix), its
# prefix's opt link itself (brew_opt_link); <root> otherwise (issue 0266). A
# keg run through its opt link arrives by its Cellar path, since PROJECT_ROOT
# is read physically, and only that path says Homebrew placed the tree: an
# install published at a path that merely ends opt/devbin/libexec is named as
# it is, since the tree above it need hold no bin/devbin at all.
#
# A KEG'S LAUNCHER IS ITS OWN bin/devbin, NEVER libexec's. On macOS that is
# the formula's env script, which runs under the formula's bash whatever PATH
# holds; libexec's launcher, a `#!/usr/bin/env bash` script, is refused at the
# floor from a PATH without Homebrew's bin, cron's and a GUI hook's, so a line
# naming it led back to the refusal. The install itself, which --from and the
# upgrade remedy name, is still install_named_root's libexec.
install_launcher_root() {
  local brew
  if brew="$(brew_keg_prefix "$1")"; then
    brew_opt_link "$brew"
    return 0
  fi
  printf '%s\n' "$1"
}

# is_install_launcher <file> <root> -- rc 0 when <file> is the launcher of the
# install at <root>, rc 1 otherwise.
#
# ONE ANSWER FOR BOTH OF A KEG'S LAYOUTS (issue 0252). A tree's launcher is
# <root>/bin/devbin, and a file that resolves (real_path) to it is that
# launcher: Homebrew's bin link does, through the keg's bin/devbin, when the
# formula links that into libexec. A formula can instead write the keg's
# bin/devbin as a script of its own (write_env_script), which resolves to
# itself and runs libexec's launcher; a plain file at <keg>/bin/devbin, beside
# <keg>/libexec, is then the launcher too. That second spelling counts only for
# a root that is a keg's libexec (brew_keg_prefix), so no other tree's
# neighbour passes for one.
#
# IN THE CASE THE DISK STORES (issue 0284). Both sides are compared as
# strings, so each is read in physical_dir's getcwd mode: on a disk that folds
# case, a PATH entry naming Homebrew's bin in another case resolved, in bash's
# `pwd -P`, to a string that differed from the keg's, and use brew named
# Homebrew's own link as another copy to move aside.
#
# NO LAUNCHER, NO MATCH. real_path hands back a path it cannot follow as it was
# given, so two spellings of a file that is not there would compare equal: the
# launcher is asked to exist first.
is_install_launcher() {
  local got want root
  real_path "$2/bin/devbin" want getcwd
  [ -f "$want" ] || return 1
  real_path "$1" got getcwd
  [ "$got" = "$want" ] && return 0
  physical_dir "$2" root getcwd || return 1
  brew_keg_prefix "$root" >/dev/null || return 1
  [ "$got" = "${root%/libexec}/bin/devbin" ] && [ -f "$got" ] && [ ! -L "$got" ]
}

# path_absolute_entries <out-array> -- PATH's absolute entries, in order, into
# the array <out-array> names: colon_split's entries less every empty and
# relative one, which answers for no machine (path_hit says why). THE ONE READER
# of the entries path_hit searches and path_searches compares (issue 0248), so
# the two cannot come to read different lists.
#
# Its locals carry its own prefix, as colon_split's do, so an empty
# <out-array>, or one named with that prefix, is refused at rc 1 with a line on
# stderr, and nothing is set.
path_absolute_entries() {
  case "${1-}" in
    '' | _pae_*)
      printf "path_absolute_entries: cannot read into '%s': name an array outside its _pae_ prefix\n" "${1-}" >&2
      return 1
      ;;
  esac
  local -n _pae_res="$1"
  local -a _pae_all
  local _pae_e
  colon_split "$PATH" _pae_all || return 1
  _pae_res=()
  for _pae_e in "${_pae_all[@]}"; do
    case "$_pae_e" in
      /*) _pae_res+=("$_pae_e") ;;
    esac
  done
}

# path_hit <command> [<dir>] -- the first <command> on PATH that would run,
# searched over its absolute entries alone (path_absolute_entries), as a shell
# finds it once <dir>/<command> is gone: rc 0 with its path, rc 1 when none
# answers.
#
# AN EMPTY OR RELATIVE ENTRY ANSWERS FOR NO MACHINE. Each answers from the
# directory a command is typed in, so none says what the machine runs: with
# ./bin on PATH the checkout's own launcher would read as another copy, and a
# hint naming `devbin` because ./bin held one would fail from every other
# directory. bash's own search reads the rest, in order.
#
# ONCE <dir>/<command> IS GONE (issue 0247). An entry is left out when its
# <command> is that file, or a link whose chain passes through it
# (link_chain_reaches): once it is removed, the one is not there and the other
# dangles, and a shell passes over both. Every directory is read in
# physical_dir's getcwd mode, so an entry naming <dir> in another case, on a
# disk that folds case, is <dir>, as the kernel reads it; bash's `pwd -P` keeps
# the case an entry was typed in, and read so, the file about to be removed
# answered for what would remain.
#
# A HIT COUNTS ONLY WHEN IT WOULD RUN (issue 0249). bash's search, finding no
# executable <command>, prints one that is not and returns 0, and running that
# fails with "Permission denied": a launcher without its execute bit read as
# the devbin that answers. So the hit is asked to be executable, which -x reads
# of the file it resolves to.
path_hit() {
  local e hit gone=""
  local -a entries kept=()
  if [ -n "${2:-}" ]; then
    physical_dir "$2" gone getcwd || gone="$2"
    gone="${gone%/}/$1"
  fi
  path_absolute_entries entries || return 1
  for e in "${entries[@]}"; do
    if [ -n "$gone" ] && link_chain_reaches "${e%/}/$1" "$gone"; then
      continue
    fi
    kept+=("$e")
  done
  [ "${#kept[@]}" -gt 0 ] || return 1
  hit="$(PATH="$(IFS=:; printf '%s' "${kept[*]}")" type -P "$1")" || return 1
  [ -x "$hit" ] || return 1
  printf '%s\n' "$hit"
}

# path_searches <dir> -- rc 0 when an absolute PATH entry, one path_hit
# searches, is <dir>, rc 1 otherwise (issue 0249). Each is read in
# physical_dir's getcwd mode, so an entry naming <dir> by a link, or in another
# case on a disk that folds case, is <dir>; a <dir> that cannot be entered is
# searched by no entry.
path_searches() {
  local e d want
  local -a entries
  physical_dir "$1" want getcwd || return 1
  path_absolute_entries entries || return 1
  for e in "${entries[@]}"; do
    if physical_dir "$e" d getcwd && [ "$d" = "$want" ]; then
      return 0
    fi
  done
  return 1
}

# link_chain_reaches <path> <file> -- rc 0 when <path> is <file>, or a link
# whose chain of links passes through it, rc 1 otherwise (issue 0247). <file>
# is spelled as physical_dir's getcwd mode spells its directory, and each step
# of the chain is read so before it is compared: its directory physically, in
# the case the kernel stores, and its own name as written, so a name that
# differs from <file>'s only in case is not <file>. Each step is link_step's,
# and the walk stops at _DEVBIN_LINK_HOPS, as follow_links's does; a step it
# cannot read exactly, or one past the bound, ends the chain there, unreached,
# as a link that goes no further.
link_chain_reaches() {
  local p="$1" d n=0
  while :; do
    case "$p" in
      */*) d="${p%/*}" ;;
      *) d=. ;;
    esac
    [ -n "$d" ] || d=/
    if physical_dir "$d" d getcwd && [ "${d%/}/${p##*/}" = "$2" ]; then
      return 0
    fi
    [ -L "$p" ] || return 1
    n=$((n + 1))
    [ "$n" -le "$_DEVBIN_LINK_HOPS" ] || return 1
    p="$(link_step "$p")" || return 1
  done
}

# launcher_shown <root> -- the launcher of the install at <root>, as a hint
# names it for a reader to type (issue 0252): `devbin` when the devbin on PATH
# that would run (path_hit) is that launcher (is_install_launcher), else the
# launcher
# install_launcher_root names: for a keg, its own bin/devbin by the opt link
# (issue 0266).
#
# NEVER THE VERSIONED KEG. The launcher resolves its own links, so an install
# Homebrew placed runs from Cellar/devbin/<version>, and a line copied from a
# hint that named it, an rc line among them, stops working at the next brew
# upgrade.
launcher_shown() {
  local hit
  if hit="$(path_hit devbin)" && is_install_launcher "$hit" "$1"; then
    printf 'devbin\n'
    return 0
  fi
  printf '%s/bin/devbin\n' "$(install_launcher_root "$1")"
}

# devbin_brew_root -- the root of the devbin Homebrew installed, at the path
# Homebrew keeps for it across upgrades, $HOMEBREW_PREFIX/opt/devbin/libexec:
# rc 0 with that root when it is there, rc 1 otherwise (issue 0195).
#
# OPT, NEVER CELLAR. The keg is Cellar/devbin/<version>, and `brew upgrade`
# deletes it; opt/devbin is the link Homebrew moves to each new keg, so a project
# that found its install here finds it again after an upgrade (Intent measured
# the same of its own keg, its issue 0527).
#
# HOMEBREW_PREFIX ALONE, which `brew shellenv` exports, and only when absolute,
# as XDG_DATA_HOME counts. No `brew` is run and none is looked for on PATH:
# running it would cost every lookup a Ruby start, and a PATH search cannot be
# held off in the suite, whose scrubbed `env -i` calls keep PATH and would find
# a real install on the machine running them. An environment with no
# HOMEBREW_PREFIX has no Homebrew default.
devbin_brew_root() {
  local p="${HOMEBREW_PREFIX:-}"
  case "$p" in
    /*) ;;
    *) return 1 ;;
  esac
  p="$(brew_opt_root "$p")"
  [ -e "$p" ] || return 1
  printf '%s\n' "$p"
}

# brew_unplaced_why -- why devbin_brew_root found nothing, as one clause, for the
# sentence that says where a machine install was looked for (issue 0195). A
# process started without the login profile -- cron, a hook a GUI app launched, a
# bare ssh command -- has no HOMEBREW_PREFIX, and there the default is off, so
# the clause names the variable rather than leaving a bare "no install". Pure.
brew_unplaced_why() {
  case "$(_brew_unplaced_cause)" in
    unset) printf 'HOMEBREW_PREFIX is not set' ;;
    empty) printf 'no devbin at %s, under HOMEBREW_PREFIX' "$(brew_opt_root "$HOMEBREW_PREFIX")" ;;
    *) printf "HOMEBREW_PREFIX, '%s', is not an absolute path" "$HOMEBREW_PREFIX" ;;
  esac
}

# devbin_docs_place <root> -- where devbin's long-form guides are for the tree
# at <root> (issue 0254): rc 0 with the directory, a path the reader can open
# on this machine; rc 1 with why there is none, one clause, on stdout.
#
#   dev       the checkout's own docs/, a checkout without a .git included
#   brew      the keg's docs/, which the formula installs beside the README
#             Homebrew puts in the keg: the parent of libexec, the install root
#             devbin knows (brew_keg_root), of the keg install_named_root names,
#             the opt link's, since brew upgrade deletes the versioned one; the
#             directory checked is the one printed, whichever keg opt leads to
#   opt       none: a publish copies the runtime, and the guides stay in the
#             checkout it was published from
#   project   the guides of the install its upgrades read (manifest_source),
#             or, where that source is not there, a clause saying so
#
# THE ONE ANSWER TO "WHERE ARE THE GUIDES". The release usage and devbin devbin
# named docs/ as a path under whatever directory the reader stood in, and a brew
# user has no checkout to stand in: every message naming a guide asks here, so
# none spells the place its own way. A docs/ that is not there is no place, as
# in a keg an older formula built, so a line never names a directory the reader
# cannot open.
devbin_docs_place() {
  local root="$1" keg
  # THE CHECKOUT IS ASKED ITS OWN QUESTION. devbin_tree's dev is a checkout
  # with a .git, since the tree line it feeds reports the commit; the guides
  # need only the checkout's docs/, so an unpacked tree with no .git still has
  # them, and is_devbin_dev_tree answers here, where devbin_tree says unknown.
  if ! is_devbin_dev_tree "$root" && ! is_install_tree "$root" && [ "$(devbin_tree "$root")" = unknown ]; then
    # A project. STDERR IS DROPPED ON PURPOSE: manifest_source's only stderr
    # is machine_install_root's reason the link cannot be trusted, and
    # source_unplaced_why words that reason again as this answer's clause.
    if ! root="$(manifest_source "$1" 2>/dev/null)" || [ -z "$root" ]; then
      source_unplaced_why "$1"
      return 1
    fi
    # A recorded path from an older manifest can name a tree that is gone.
    if [ ! -d "$root" ]; then
      printf 'the devbin source this project records, %s, is not there' "$root"
      return 1
    fi
  fi
  if is_devbin_dev_tree "$root"; then
    if [ -d "$root/docs" ]; then
      printf '%s/docs\n' "$root"
      return 0
    fi
    printf 'the devbin checkout at %s has no docs/' "$root"
    return 1
  fi
  case "$(devbin_tree "$root")" in
    brew)
      keg="$(brew_keg_root "$(install_named_root "$root")")"
      if [ -d "$keg/docs" ]; then
        printf '%s/docs\n' "$keg"
        return 0
      fi
      printf "Homebrew's devbin at %s carries none, and a formula that installs them comes with brew upgrade devbin" "$keg"
      ;;
    opt) printf 'an opt install carries none, and they are in docs/ of the devbin checkout it was published from' ;;
    *) printf 'the devbin install at %s carries none' "$root" ;;
  esac
  return 1
}

# _brew_unplaced_cause -- which of brew_unplaced_why's causes holds, one word:
# unset (HOMEBREW_PREFIX empty or not set), relative (not an absolute path) or
# empty (absolute, with no devbin under it). The one branch, so the reason
# brew_unplaced_why gives and the remedy brew_unplaced_fix gives cannot
# disagree (issue 0250), as _source_unplaced_cause is for the source pair.
_brew_unplaced_cause() {
  case "${HOMEBREW_PREFIX:-}" in
    '') printf 'unset\n' ;;
    /*) printf 'empty\n' ;;
    *) printf 'relative\n' ;;
  esac
}

# brew_none_why -- the one sentence for no Homebrew devbin here, with
# brew_unplaced_why's clause: a bare `use` says it, and so do use brew's
# refusal and doctor's switch row. Pure.
brew_none_why() {
  printf 'Homebrew has no devbin here (%s)' "$(brew_unplaced_why)"
}

# brew_unplaced_fix <running root> [<trees>] -- the remedy for the cause
# brew_unplaced_why names, as one clause (issue 0250): with HOMEBREW_PREFIX
# unset or relative, export it as `brew shellenv` exports it, since devbin may
# well be installed and only this process cannot see it; under an absolute
# prefix with no devbin, install devbin with Homebrew. Keyed by
# _brew_unplaced_cause, as the reason is, so the remedy and the cause cannot
# part. devbin_checkout_clause adds dev or opt, for the maintainer alone.
brew_unplaced_fix() {
  local fix
  case "$(_brew_unplaced_cause)" in
    empty) fix='install devbin with Homebrew' ;;
    *) fix='export HOMEBREW_PREFIX in the profile this process reads, as brew shellenv exports it' ;;
  esac
  printf '%s%s' "$fix" "$(devbin_checkout_clause "${1:-}" "${2:-}")"
}

# devbin_checkout_clause <running root> [<trees>] -- ", or run bin/devbin use
# <trees> in your devbin checkout" when the devbin running, at <running root>,
# is a dev or opt tree, and nothing otherwise, for the end of a remedy (issue
# 0250). <trees> defaults to "dev or opt"; a reader that takes only an install
# names "opt".
#
# dev AND opt ARE THE MAINTAINER'S (issue 0250). The clause names the
# checkout's own bin/devbin, the one launcher `use dev` and `use opt` run from
# (_use_in_checkout), never the running launcher or the devbin on PATH. From a
# keg or a project, whose reader may be any user, it is nothing, and so it is
# with no <running root>, for a caller that names dev and opt itself.
devbin_checkout_clause() {
  [ -n "${1:-}" ] || return 0
  case "$(devbin_tree "$1")" in
    dev | opt) printf ', or run bin/devbin use %s in your devbin checkout' "${2:-dev or opt}" ;;
  esac
  return 0
}

# devbin_link_path -- the link that records which devbin install this machine
# reads: $HOME/.local/bin/devbin, the one link `devbin use` writes and removes
# (docs/dev-opt-brew.md, T5). Every reader asks here for its place. An empty
# HOME locates nothing.
devbin_link_path() {
  local home="${HOME:-}"
  home="${home%/}"
  [ -n "$home" ] || return 1
  printf '%s\n' "$home/.local/bin/devbin"
}

# machine_install_chooser -- which place chose this machine's devbin install, one
# word: `prefix` while DEVBIN_INSTALL_PREFIX is set, `link` while the link
# devbin_link_path names is there, a link that cannot be followed included, and
# `brew` when neither is and Homebrew's install is there (issue 0195). Read in
# that order (T9), so no link means brew, and a broken link is said to be
# broken rather than passed over.
#
# THE ONE DECISION. machine_named_state places the install by it, and the
# sentences that say what chose one read it, so the two cannot disagree.
machine_install_chooser() {
  if [ -n "${DEVBIN_INSTALL_PREFIX:-}" ]; then
    printf 'prefix\n'
  elif [ "$(machine_link_state)" = none ] && devbin_brew_root >/dev/null; then
    printf 'brew\n'
  else
    printf 'link\n'
  fi
}

# machine_named_state -- what this machine NAMES as its devbin install, before
# anything asks whether the tree there is one. On stdout, one word first:
#
#   at <root>       DEVBIN_INSTALL_PREFIX as given, the tree the link leads to,
#                   or Homebrew's install (devbin_brew_root)
#   none            nothing names one: no override, no link, no Homebrew
#                   install
#   bad <reason>    the link is there and cannot be followed to a devbin tree
#
# machine_install_state adds the check this leaves out, that the tree named is
# an install or devbin's checkout; a caller that lists installs asks this
# alone, so that the machine's own install is still known as one when it has
# lost the manifest that would say so (issue 0153).
machine_named_state() {
  case "$(machine_install_chooser)" in
    prefix) printf 'at %s\n' "$(home_expand "$DEVBIN_INSTALL_PREFIX")" ;;
    brew) printf 'at %s\n' "$(devbin_brew_root)" ;;
    *) machine_link_state ;;
  esac
}

# machine_link_state -- what the link alone names, in machine_named_state's
# states: the half of it that never asks DEVBIN_INSTALL_PREFIX.
#
# READ BY THE LINK'S OWN PATH, NEVER THROUGH PATH (T9). A process started
# without the login PATH -- cron, a hook a GUI app launched -- has no
# ~/.local/bin on it, and it still finds the install the switch chose. The
# chain is walked by follow_links, the one walk, and the tree is the directory
# above the bin/devbin it ends at.
#
# A KEG IS NAMED BY ITS OPT LINK (issue 0287), through install_named_root, as
# every other reader names one. The walk ends in Cellar/devbin/<version>, which
# the next `brew upgrade devbin` removes, so doctor's switch row named a path a
# user copied from it and found gone.
#
# `bad` for a link that leads to no file, one that cannot be followed exactly, a
# file standing where the link belongs (no choice `devbin use` made), and a link
# to a file that is no tree's bin/devbin.
#
# A LINK TO NO FILE IS REMOVED BY HAND (issue 0250), and no link then means
# brew: `use brew` leaves a link into no devbin tree, so it is not offered.
# dev or opt, which replace the link, are offered only from a dev or opt tree
# (devbin_checkout_clause, issue 0250), since this reaches every reader of
# the switch, keg users included.
machine_link_state() {
  local p f d
  if ! p="$(devbin_link_path)" || { [ ! -e "$p" ] && [ ! -L "$p" ]; }; then
    printf 'none\n'
    return 0
  fi
  if [ ! -L "$p" ]; then
    printf 'bad %s is not a link, so it is no choice devbin use made -- remove it, or run devbin use brew\n' "$p"
    return 0
  fi
  if ! f="$(follow_links "$p" 2>/dev/null)"; then
    printf 'bad the link %s leads to no file it can follow -- remove it, so no link means brew%s\n' "$p" "$(devbin_checkout_clause "${PROJECT_ROOT:-}")"
    return 0
  fi
  case "$f" in
    ?*/bin/devbin) ;;
    *)
      printf 'bad the link %s leads to %s, which is no devbin tree'"'"'s bin/devbin\n' "$p" "$f"
      return 0
      ;;
  esac
  if ! physical_dir "${f%/bin/devbin}" d; then
    printf 'bad cannot resolve the tree the link %s leads to\n' "$p"
    return 0
  fi
  printf 'at %s\n' "$(install_named_root "$d")"
}

# devbin_link_shadow -- why the link is not the devbin a login shell runs, as
# one line, or nothing when it is (T5's shadow check, asked by doctor and by a
# bare `devbin use`).
#
# BY RESOLVED DIRECTORY, NEVER BY PATH STRING. The link's directory and the
# directory of the first `devbin` on PATH are each read physically, so a ~/bin
# that is a link to ~/.local/bin is the same directory and passes, and an entry
# spelled another way is not mistaken for a different one. A first hit in
# another directory shadows the link, and is named; so is a PATH with no
# devbin on it at all. Each is read in physical_dir's getcwd mode (issue 0247),
# so an entry naming ~/.local/bin in another case, on a disk that folds case,
# is the link's own directory: bash's `pwd -P` keeps the case it was typed in,
# and doctor failed on the link shadowing itself.
#
# A DEVBIN LINKED THROUGH THE LINK IS THE LINK, AND ONLY ABSOLUTE ENTRIES ARE
# SEARCHED (issue 0285). A first hit whose chain of links passes through the
# link (link_chain_reaches), eg a ~/bin/devbin made by hand to
# ../.local/bin/devbin, runs the link's tree, so it passes, as a hit in a
# directory that resolves to the link's does; doctor failed the switch on it.
# The search reads the entries path_hit reads (path_absolute_entries): an empty
# or relative entry answers from wherever a command is typed, so a ./bin
# holding a devbin was a shadow from one directory and not from another.
#
# NO LINK MEANS BREW, AND BREW IS CHECKED TOO (issue 0273). T5 reports brew
# when no link is left and the first devbin on PATH resolves into the keg, so
# with no link this asks brew_answer_state, the one lookup of what answers on
# PATH and of whether that is the keg's launcher: another copy first is named,
# so is a keg's launcher that would not run (0249), and so is a PATH with no
# devbin on it, each with use brew's remedy for the same cause (brew_path_why).
# With no Homebrew devbin at all it says nothing, since that is no shadow: the
# report says what is missing. A file standing where the link belongs says
# nothing here either: the link's own state names it.
devbin_link_shadow() {
  local p first ld state why
  local -a entries
  p="$(devbin_link_path)" || return 0
  if [ ! -e "$p" ] && [ ! -L "$p" ]; then
    state="$(brew_answer_state)"
    case "$state" in
      absent | "brew "*) ;;
      "other "* | "noexec "*)
        why="$(brew_path_why "$state")"
        printf 'no link means brew, but %s -- %s\n' "${why%%$'\n'*}" "${why#*$'\n'}"
        ;;
      "offpath "* | "unlinked "*)
        why="$(brew_path_why "$state")"
        printf 'no link means brew, but no devbin is on PATH (%s) -- %s\n' "${why%%$'\n'*}" "${why#*$'\n'}"
        ;;
      *) printf 'no link means brew, but what answers devbin on PATH cannot be told: %s\n' "$state" ;;
    esac
    return 0
  fi
  [ -L "$p" ] || return 0
  if ! path_absolute_entries entries; then
    printf 'cannot read PATH, so whether a login shell runs the link %s cannot be told\n' "$p"
    return 0
  fi
  first=""
  if [ "${#entries[@]}" -gt 0 ]; then
    first="$(PATH="$(IFS=:; printf '%s' "${entries[*]}")" type -P devbin 2>/dev/null || true)"
  fi
  if [ -z "$first" ]; then
    printf '%s is not on PATH, so a login shell runs no devbin through the link -- put it on PATH ahead of Homebrew'"'"'s bin\n' "${p%/*}"
    return 0
  fi
  physical_dir "${p%/*}" ld getcwd || ld="${p%/*}"
  link_chain_reaches "$first" "${ld%/}/${p##*/}" && return 0
  printf 'the link %s is shadowed: the first devbin on PATH is %s -- put %s ahead of %s on PATH\n' "$p" "$first" "${p%/*}" "${first%/*}"
}

# brew_answer_state -- what would answer `devbin` on PATH once the link
# devbin_link_path names is gone, asked by `use brew` before it removes the
# link (docs/dev-opt-brew.md T5; issue 0235). One line on stdout, one word
# first:
#
#   brew <root>       the first devbin on PATH outside the link's directory is
#                     the bin/devbin of Homebrew's keg, at <root>
#   absent            Homebrew has no devbin here (devbin_brew_root finds none)
#   other <path>      the first devbin on PATH outside the link's directory is
#                     <path>, which is not Homebrew's
#   noexec <file>     the devbin that would answer is Homebrew's, and <file>,
#                     the keg's devbin or the libexec launcher it runs, is not
#                     executable (brew_launcher_inert)
#   offpath <bin>     none is on PATH outside it, though Homebrew's bin link
#                     <bin> leads into the keg: Homebrew's bin is not among the
#                     entries searched
#   unlinked <root>   none is on PATH outside it, and no devbin in Homebrew's
#                     bin leads into the keg at <root>
#   vialink <bin>     none is on PATH outside it, and Homebrew's bin, which is
#                     searched, holds <bin>, leading into the keg only through
#                     the link itself, so it goes with the link
#
# BY THE LOOKUP A SHELL MAKES ONCE THE LINK IS GONE: path_hit, passing over the
# link itself, through an entry naming its directory in any case a disk that
# folds case reads as it, and any devbin whose chain of links passes through
# it, which would dangle (issue 0247), as well as the empty and relative
# entries it never reads. Whether the hit, or Homebrew's bin link, is the keg's
# devbin is is_install_launcher's answer, the one for both of a keg's layouts
# (issue 0253): a link into libexec, and the script the formula writes at the
# keg's bin/devbin on macOS (write_env_script), which resolves to itself.
# Compared by resolved path, that script read as `other`, and `use brew`
# refused on every macOS brew machine.
#
# WHAT HOMEBREW'S BIN HOLDS IS READ ONLY ONCE THE LOOKUP FINDS NOTHING THAT
# RUNS (issue 0249), and offpath is answered only when that bin is not among
# the entries searched (path_searches), never inferred from no hit: a keg's
# launcher without its execute bit, in a bin on PATH, is noexec, which removing
# the link would leave as the devbin that fails. A bin link into the keg that
# is searched and would run, and still is no hit, was passed over because it
# reaches the keg through the link, and is vialink, never unlinked: it is
# linked, and leads nowhere once the link is gone.
brew_answer_state() {
  local root p ld first bin file
  if ! root="$(devbin_brew_root)"; then
    printf 'absent\n'
    return 0
  fi
  ld=""
  if p="$(devbin_link_path)"; then
    ld="${p%/*}"
  fi
  first="$(path_hit devbin "$ld")" || first=""
  if [ -n "$first" ]; then
    if ! is_install_launcher "$first" "$root"; then
      printf 'other %s\n' "$first"
    elif file="$(brew_launcher_inert "$first" "$root")"; then
      printf 'noexec %s\n' "$file"
    else
      printf 'brew %s\n' "$root"
    fi
    return 0
  fi
  bin="$(brew_bin_link "$HOMEBREW_PREFIX")"
  if [ -e "$bin" ] && is_install_launcher "$bin" "$root"; then
    if ! path_searches "${bin%/*}"; then
      printf 'offpath %s\n' "$bin"
    elif file="$(brew_launcher_inert "$bin" "$root")"; then
      printf 'noexec %s\n' "$file"
    else
      printf 'vialink %s\n' "$bin"
    fi
    return 0
  fi
  printf 'unlinked %s\n' "$root"
}

# brew_launcher_inert <file> <root> -- the first of <file>, a devbin that is
# the keg's launcher (is_install_launcher), and the launcher of the keg at
# <root> itself, <root>/bin/devbin, that is not executable, resolved
# (real_path), on stdout: rc 0 with it, rc 1 when both are (issue 0249).
#
# BOTH HOPS. On macOS the keg's bin/devbin is the formula's env script, which
# execs libexec's launcher, so an executable script in front of a launcher
# without its execute bit still fails with "Permission denied". On Linux the
# keg's bin/devbin is a link to that launcher, and the two are one file.
brew_launcher_inert() {
  local hop inert
  for hop in "$1" "$2/bin/devbin"; do
    [ -x "$hop" ] && continue
    real_path "$hop" inert
    printf '%s\n' "$inert"
    return 0
  done
  return 1
}

# brew_path_why <brew_answer_state> [<link>] -- for a state in which Homebrew
# has a devbin and the devbin a shell would run is not it, or would not run
# (other, noexec, offpath, unlinked, vialink), two lines on stdout: why no
# Homebrew devbin answers, and that cause's remedy (T5; issue 0235). rc 1,
# printing nothing, for any other state, and for vialink with no <link>, which
# names it. With <link>, the link `use brew` would remove, the reason reads
# PATH with that link gone, as the shell will, and Homebrew's bin is to come
# after its directory.
#
# ONE WORDING FOR EACH CAUSE (issue 0273). `use brew`'s refusal says it, and so
# does the shadow check with no link, for a bare `use` and doctor's switch row,
# so the remedy and the cause it answers cannot part.
brew_path_why() {
  local b
  case "$1" in
    "other "*)
      if [ -n "${2:-}" ]; then
        printf 'with %s left out, the first devbin on PATH would be %s' "${2%/*}" "${1#other }"
      else
        printf 'the first devbin on PATH is %s' "${1#other }"
      fi
      # Every state here is brew_answer_state's after devbin_brew_root found
      # the keg, so it finds it again; `|| true` only keeps a keg removed in
      # between from ending the sentence half said.
      printf ', which is not Homebrew'"'"'s devbin at %s\n' "$(devbin_brew_root || true)"
      printf 'move %s aside\n' "${1#other }"
      ;;
    "noexec "*)
      printf 'Homebrew'"'"'s devbin would not run: %s is not executable\n' "${1#noexec }"
      printf 'reinstall devbin with Homebrew (brew reinstall devbin)\n'
      ;;
    "offpath "*)
      b="${1#offpath }"
      printf 'Homebrew'"'"'s devbin is linked at %s, and %s is not on PATH\n' "$b" "${b%/*}"
      printf 'put %s on PATH%s\n' "${b%/*}" "${2:+, after ${2%/*}}"
      ;;
    "unlinked "*)
      b="$(brew_bin_link "${HOMEBREW_PREFIX:-}")"
      printf 'Homebrew'"'"'s devbin at %s is not linked: no devbin in %s leads into it\n' "${1#unlinked }" "${b%/*}"
      printf 'link it (brew link devbin)\n'
      ;;
    "vialink "*)
      [ -n "${2:-}" ] || return 1
      b="${1#vialink }"
      printf 'Homebrew'"'"'s devbin is linked at %s, and it reaches the keg only through the link %s, so it goes with it\n' "$b" "$2"
      printf 'point %s at the keg itself (brew link --overwrite devbin)\n' "$b"
      ;;
    *) return 1 ;;
  esac
}

# machine_install_state -- its states, on stdout, one word first:
#
#   at <root>       the machine names an install, or devbin's checkout, and
#                   this is its root
#   none            nothing names one: no override, no link, no Homebrew install
#   bad <reason>    the link is there and cannot be trusted
#
# DEVBIN_INSTALL_PREFIX FIRST, AS GIVEN, then the link, then Homebrew's: a
# default with an override, the variable `dvb` already reads. A link that cannot
# be followed, or names a tree that is neither an install nor devbin's checkout,
# is `bad`, never `none`: a reader told nothing is recorded would say so, and be
# wrong about why. THE CHECKOUT IS A SOURCE because `devbin use dev` chose it
# (issue 0213): a project then vendors from it, and records `checkout`. One
# reading, machine_named_state's, so machine_install_root, devbin_source_state
# and any other caller cannot come to disagree about what the link says.
machine_install_state() {
  local s m by
  s="$(machine_named_state)"
  if [ -z "${DEVBIN_INSTALL_PREFIX:-}" ] && [ "${s%% *}" = at ]; then
    by="$(machine_install_by)"
    # A manifest that is there and cannot be read says nothing about the tree,
    # so it is named as that, never as a tree that is no install.
    m="$(manifest_path "${s#at }")"
    if [ -e "$m" ] && [ ! -r "$m" ]; then
      printf 'bad %s names %s, whose manifest cannot be read\n' "$by" "${s#at }"
      return 0
    fi
    if ! is_install_tree "${s#at }" &&
      [ "$(devbin_tree "${s#at }")" != dev ]; then
      printf 'bad %s names %s, which is not a devbin install or checkout\n' "$by" "${s#at }"
      return 0
    fi
  fi
  printf '%s\n' "$s"
}

# machine_install_namer -- what names this machine's install, as the subject of a
# sentence: DEVBIN_INSTALL_PREFIX while it is set, since it is read first; this
# machine's devbin link; and HOMEBREW_PREFIX when Homebrew's install is what
# chose it (issue 0195). A message that said "this machine names" while the
# variable did sent the reader to a pointer that had no say (issue 0153).
machine_install_namer() {
  case "$(machine_install_chooser)" in
    prefix) printf 'DEVBIN_INSTALL_PREFIX' ;;
    brew) printf 'HOMEBREW_PREFIX' ;;
    *) printf "this machine's devbin link" ;;
  esac
}

# machine_install_by -- what chose this machine's install, by name, for a
# sentence that has to say where to look: DEVBIN_INSTALL_PREFIX, the link by its
# path, or HOMEBREW_PREFIX's opt/devbin (issue 0195). Doctor gives it beside the
# install a project resolves to.
machine_install_by() {
  case "$(machine_install_chooser)" in
    prefix) printf 'DEVBIN_INSTALL_PREFIX' ;;
    brew) printf "HOMEBREW_PREFIX's opt/devbin" ;;
    *) printf 'the link %s' "$(devbin_link_path 2>/dev/null || printf '(no home directory to keep it in)')" ;;
  esac
}

# source_override_note <root> [<from>] -- one warning line, when <root>'s
# recorded source is an install, DEVBIN_INSTALL_PREFIX is what placed it and no
# --from named another, saying so; nothing otherwise. For a refusal of the
# source it placed: the variable is taken as given, so the tree it names is
# never checked before that refusal. A <from> names the source on the command
# line, so the variable placed nothing (issue 0178); the rule lives here, so a
# refusal that calls this cannot forget it.
source_override_note() {
  [ -z "${2:-}" ] || return 0
  [ -n "${DEVBIN_INSTALL_PREFIX:-}" ] || return 0
  [ -n "$(manifest_field "$1" source 2>/dev/null || true)" ] || return 0
  warn "  DEVBIN_INSTALL_PREFIX names it as this machine's devbin install"
}

# machine_install_root -- the root of this machine's devbin install: rc 0 with
# the root; rc 1, having printed nothing, when nothing names one; rc 2, the
# reason on stderr, when the link cannot be trusted.
machine_install_root() {
  local s
  s="$(machine_install_state)"
  case "$s" in
    "at "*) printf '%s\n' "${s#at }" ;;
    none) return 1 ;;
    *)
      warn "${s#bad }"
      return 2
      ;;
  esac
}

# source_unplaced_why <root> -- why <root>'s recorded source cannot be placed
# on this machine, as one clause, for every reader that has to say so: the
# notice and doctor through devbin_source_state, and upgrade and vendor when
# no --from is given. One wording, so they cannot disagree about the cause.
#
# THE SWITCH PLACES EVERY KIND (issue 0213). A project records the kind of
# source its bytes came from, and this machine's switch says where the next
# upgrade reads (manifest_source), so an unplaced source is said as what is
# missing HERE: no override, no link and no Homebrew install. Only a project
# that records no source at all has nothing for the switch to answer.
source_unplaced_why() {
  local m
  case "$(_source_unplaced_cause "$1")" in
    none) printf 'this project records no source' ;;
    bad)
      m="$(machine_install_state)"
      printf '%s' "${m#bad }"
      ;;
    machine)
      printf 'this machine names no devbin install: no link at %s, DEVBIN_INSTALL_PREFIX is not set, and %s' \
        "$(devbin_link_path 2>/dev/null || printf '(no home directory to keep it in)')" "$(brew_unplaced_why)"
      ;;
    *) printf 'the source this project records cannot be read' ;;
  esac
  return 0
}

# source_unplaced_fix <root> [<running root>] -- what to do about the cause
# source_unplaced_why names, as one clause, for a refusal that asks for --from
# (issue 0250): where the machine names nothing, brew_unplaced_fix's remedy
# for its cause, then --from; otherwise --from alone, since the cause names its
# own (a link that cannot be followed) or has none here. <running root> is
# brew_unplaced_fix's, for its dev or opt clause.
source_unplaced_fix() {
  case "$(_source_unplaced_cause "$1")" in
    machine) printf '%s, or name one with --from <dir>' "$(brew_unplaced_fix "${2:-}")" ;;
    *) printf 'name one with --from <dir>' ;;
  esac
  return 0
}

# _source_unplaced_cause <root> -- which of source_unplaced_why's causes holds
# for <root>, one word: none (no source recorded), bad (the machine's link or
# install cannot be trusted), machine (the machine names no install) or
# unreadable. The one branch, so the reason and the remedy cannot disagree.
_source_unplaced_cause() {
  case "$(manifest_field "$1" source 2>/dev/null || true)" in
    "") printf 'none\n' ;;
    install | checkout | project)
      case "$(machine_install_state)" in
        "bad "*) printf 'bad\n' ;;
        *) printf 'machine\n' ;;
      esac
      ;;
    *) printf 'unreadable\n' ;;
  esac
}

# manifest_source <root> -- the recorded source, as the absolute path it names.
#
# WHAT IS RECORDED IS A KIND, NEVER A PLACE (issue 0153): `install`, `checkout`
# or `project`, as `manifest_source_token` in lib/install writes them. THE KIND
# SAYS WHERE THE BYTES CAME FROM, NEVER WHERE THE NEXT UPGRADE GOES (issue
# 0213): every kind is placed by this machine's switch, machine_install_root --
# DEVBIN_INSTALL_PREFIX, else the tree the link names, else Homebrew's install
# (docs/dev-opt-brew.md, T9). DEVBIN_SOURCE places nothing here any more; it is
# `dvb`'s fallback alone. A project that records no source has none, so its
# caller asks for --from. Every reader comes through here, so none of them
# knows the difference.
#
# A RECORDED PATH STILL READS (issue 0069): a manifest written before 0153
# carries `~/...`, or before 0069 an absolute path, and either resolves as it
# always did until an upgrade this runtime runs writes the kind in its place.
# Not the next upgrade (issue 0178): an upgrade is run by the project's own
# vendored runtime, so the one that brings this runtime in is run by the older
# one, which records the path again.
#
# rc 1 when nothing resolves; rc 2, with machine_install_root's reason on
# stderr, when the link cannot be trusted.
manifest_source() {
  local v
  v="$(manifest_field "$1" source)" || return 1
  case "$v" in
    install | checkout | project) machine_install_root ;;
    *) home_expand "$v" ;;
  esac
}

# _devbin_source_head <srcroot> -- the commit the SOURCE currently holds.
#
# rc 0 with a bare sha, or rc 2 when it cannot be told. NO THIRD ANSWER: an
# empty success would be read as "level" by every caller, and "cannot tell" and
# "no change" are the two things this file exists to keep apart.
#
# TWO KINDS OF SOURCE, TWO INSTRUMENTS (ST0005). Until the machine install
# existed a source was always a git checkout, so `git rev-parse HEAD` was the
# only question worth asking. An INSTALL is not a checkout -- it has no .git at
# all -- and asking git returns nothing, which this function's caller correctly
# treated as "say nothing".
#
# MEASURED, NOT ANTICIPATED. The same consumer, at the same staleness, with one
# field changed: pointed at the dev tree the notice SPOKE, pointed at the
# install it went SILENT. So repointing the projects at the install -- which is
# the entire job of ST0005 WP-03 -- would have turned off the update notice on
# every project at once, and the failure is invisible because silence is this
# notice's ordinary state.
#
# An install's own manifest already records the commit it was cut from, under
# the dirty gate, so it is the authority for what that install holds. `kind:`
# is READ rather than the shape being inferred, which is why that header exists.
_devbin_source_head() {
  local src="${1:-}" sha
  [ -n "$src" ] || return 2
  [ -d "$src" ] || return 2

  if is_install_tree "$src"; then
    sha="$(manifest_field "$src" source_commit 2>/dev/null || true)"
  else
    sha="$(git -C "$src" rev-parse HEAD 2>/dev/null)" || return 2
  fi

  # Same normalisation as the recorded side, and for the same reason: the field
  # can carry `<sha> +dirty -- ...` or words instead of a sha. Compared whole,
  # those can never be equal to anything, so the notice would fire forever.
  sha="${sha%% *}"
  is_commit_sha "$sha" || return 2
  printf '%s\n' "$sha"
  return 0
}

# --- which way the source moved -------------------------------------------------
#
# MOVED HERE FROM lib/install (issue 0079). upgrade and vendor asked this and
# the update notice, the offer and doctor did not: they compared two shas for
# equality and called any difference "behind", so a source BEHIND the project
# was offered as an update. The dispatcher loads lib/helpers and not lib/install
# before it offers, so the one direction reader has to live where every asker
# can reach it. install_ancestry, the PUBLISH half that writes the table, stays
# in lib/install.

# source_direction <dstroot> <srcroot> -- which way the source has moved since
# these bytes were vendored:
#
#   same       the source is exactly the commit that was vendored
#   forward    the recorded commit is an ancestor of the source's HEAD
#   backward   the source's HEAD is an ancestor of the recorded commit
#   unrelated  neither contains the other -- a different history
#   unknown    the question cannot be answered from what is on disk
#
# UNKNOWN IS A REAL ANSWER AND MUST NEVER BE READ AS `forward`. There are
# several ways to reach it and none of them is exotic: the field is ABSENT on a
# manifest that predates the field, it is PROSE when the source was not a
# checkout, it carries `+dirty` when the bytes matched no commit, and a fresh
# clone may simply not HAVE the recorded commit. Collapsing any of those into
# "fine" is the direction that costs something -- upgrade syncs from source
# unconditionally, so a downgrade prints `updated` per file and leaves doctor
# green (issue 0021, measured at 11 files).
#
# Reads git in the SOURCE only. The target may not be a checkout at all, and
# whether it is has no bearing on which devbin it received.
#
# AN INSTALL SOURCE IS ANSWERED FROM ITS ANCESTRY TABLE (issue 0059). An install
# is not a git repository, so asking git there answered `unknown` for every
# project vendoring from one, and `unknown` was silent. The history the question
# needs was in the checkout the install was PUBLISHED from, so that is where it
# is asked; see install_ancestry.
#
# `+dirty` IS `unknown`, AS "UNKNOWN IS A REAL ANSWER" SAYS -- and until issue
# 0059 the code did not do it. It took the first word and compared the sha, so
# bytes vendored from `C` plus uncommitted work read `same` against a source
# holding `C`, and upgrade dropped the work with no direction line. The sha
# names where the bytes STARTED, not what they are, so no direction follows from
# it.
#
# WHERE THE COMMITS SAY `unknown`, THE VERSIONS ANSWER (issue 0276). An install
# source's table was written when it was published, so it cannot name a later
# commit a project records, and a project vendored from a newer install then
# upgraded from an older one read `unknown` while both manifests' versions
# said which way it moved. The commits stay the first witness; version_direction
# is asked only where they cannot answer, and equal versions stay `unknown`.
source_direction() {
  local dir
  dir="$(_commit_source_direction "$1" "$2")"
  [ "$dir" = unknown ] && dir="$(version_direction "$1" "$2")"
  printf '%s\n' "$dir"
}

_commit_source_direction() {
  local dstroot="$1" srcroot="$2" rec
  rec="$(manifest_source_commit "$dstroot" 2>/dev/null || true)"
  case "$rec" in *' +dirty'*) printf 'unknown\n'; return 0 ;; esac
  # The recorded value is a LINE, not a field: `<sha>` or a whole sentence.
  # Taking the first word reduces both to something that either is a sha or
  # visibly is not.
  rec="${rec%% *}"
  is_commit_sha "$rec" || { printf 'unknown\n'; return 0; }

  if is_install_tree "$srcroot"; then
    install_direction "$srcroot" "$rec"
    return 0
  fi
  commit_direction "$srcroot" "$rec"
}

# source_version <srcroot> -- the devbin version a source would vendor: an
# install's manifest's, or a checkout's VERSION; nothing, and rc 1, where it
# reads none.
source_version() {
  local v
  if is_install_tree "$1"; then
    v="$(manifest_version "$1" 2>/dev/null)" || v=""
  else
    v="$(read_version "$1/VERSION" version-file 2>/dev/null)" || v=""
  fi
  is_semver "$v" || return 1
  printf '%s\n' "$v"
}

# version_direction <dstroot> <srcroot> -- `forward` when the source's version
# (source_version) is higher than the one vendored at <dstroot>, `backward` when
# it is lower, `unknown` when they are equal or either does not read: a dev
# tree's version is not bumped per commit, so equal versions say nothing.
version_direction() {
  local here there
  here="$(manifest_version "$1" 2>/dev/null)" || here=""
  there="$(source_version "$2")" || there=""
  if semver_gt "$there" "$here"; then
    printf 'forward\n'
  elif semver_gt "$here" "$there"; then
    printf 'backward\n'
  else
    printf 'unknown\n'
  fi
}

# is_commit_sha <word> -- true when <word> can name a commit: lowercase hex, at
# least seven characters.
#
# ONE CHECK, because three copies of it had already drifted by the time issue
# 0059 read them: one dropped the length test. The length test is not
# redundant with the charset one -- `a checkout with no HEAD` reduces to `a` by
# first word, and `a` is valid hex.
is_commit_sha() {
  case "$1" in '' | *[!0-9a-f]*) return 1 ;; esac
  [ "${#1}" -ge 7 ]
}

# commit_direction <checkout> <sha> [<to>] -- which way <to> (default: the
# checkout's HEAD) has moved from <sha>: `same`, `forward`, `backward`,
# `unrelated` or `unknown`.
#
# The git half of source_direction, separate because a PUBLISH asks the same
# question of every commit an install has held (install_ancestry), and the
# release core asks it of a remote's branch head (release_read_remote, which is
# why <to> exists). Two copies of the ancestry rules would be two answers to
# one question -- updatenotice.bats holds this as the only place ancestry is
# asked.
#
# `unknown` FOR A CHECKOUT GIT CANNOT READ, whether no repository or one git will
# not read: no direction can be read either way, so this does not ask
# git_repo_absent which (issue 0185).
commit_direction() {
  local srcroot="$1" rec="$2" head
  git -C "$srcroot" rev-parse --git-dir >/dev/null 2>&1 ||
    { printf 'unknown\n'; return 0; }
  head="$(git -C "$srcroot" rev-parse -q --verify "${3:-HEAD}^{commit}" 2>/dev/null)" || head=""
  [ -n "$head" ] || { printf 'unknown\n'; return 0; }
  # ASKED BEFORE THE ANCESTRY TESTS, because `merge-base --is-ancestor` returns
  # 1 both for "not an ancestor" and for a commit this repository has never
  # heard of, and those are `unrelated` and `unknown` respectively.
  git -C "$srcroot" cat-file -e "$rec^{commit}" 2>/dev/null ||
    { printf 'unknown\n'; return 0; }

  case "$head" in "$rec"*) printf 'same\n'; return 0 ;; esac
  if git -C "$srcroot" merge-base --is-ancestor "$rec" "$head" 2>/dev/null; then
    printf 'forward\n'
  elif git -C "$srcroot" merge-base --is-ancestor "$head" "$rec" 2>/dev/null; then
    printf 'backward\n'
  else
    printf 'unrelated\n'
  fi
  return 0
}

# commit_ancestors <checkout> -- every commit <checkout>'s HEAD contains but HEAD
# itself, one full sha per line, from one `git rev-list` (issue 0195).
#
# commit_direction's question, asked of all of them at once: each line is a
# commit it would call `forward`, so the answer lives beside it. A publish
# places a whole history this way, where asking per commit would run git three
# times for each of them. Nothing for a checkout git cannot read, as
# commit_direction answers `unknown` there, and nothing for a shallow one that
# holds HEAD alone.
commit_ancestors() {
  local all
  all="$(git -C "$1" rev-list HEAD 2>/dev/null)" || return 0
  printf '%s\n' "$all" | awk 'NR > 1'
}

# manifest_ancestry <root> [<sha>] -- the ancestry table as `<sha><TAB><direction>`
# lines; given <sha>, only the first row for it, or nothing.
#
# Read by its own reader rather than manifest_field, which returns ONE value per
# key and this key repeats. Header lines only: the table ends where the header
# does, exactly as manifest_field's does.
#
# THE LOOKUP STOPS AT ITS ROW, IN ONE awk (issue 0195). A publish now writes a
# row for every commit its checkout's HEAD contains, so the table grows with
# every commit, and a lookup that handed every row to a shell loop took about
# 10 us a row, 32 ms at 1544 rows. The sha travels in the environment, never
# through -v, which would read a backslash in it as an escape.
manifest_ancestry() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 0
  DEVBIN_ANCESTRY_SHA="${2:-}" awk '
    BEGIN { want = ENVIRON["DEVBIN_ANCESTRY_SHA"] }
    $0 !~ /^#/ { exit }
    /^#[[:space:]]*ancestry:[[:space:]]/ {
      line = $0
      sub(/^#[[:space:]]*ancestry:[[:space:]]*/, "", line)
      if (split(line, f, /[[:space:]]+/) != 2) next
      # Compared as strings: a sha of digits and one e reads to awk as a number.
      if (want == "") printf "%s\t%s\n", f[1], f[2]
      else if ((f[1] "") == (want "")) { printf "%s\t%s\n", f[1], f[2]; exit }
    }
  ' "$path"
}

# install_direction <install> <sha> -- source_direction's answer when the source
# is an install: looked up, never computed, because nothing here has history.
#
# `same` when <sha> is the commit the install holds; the recorded direction when
# the table has it; `unknown` otherwise. NOT FOUND IS UNKNOWN, never `forward`:
# a commit the install never held is exactly the case nobody can vouch for.
install_direction() {
  local install="$1" rec="$2" head line
  # The install's commit through the one reader of "which commit does this
  # source hold", not a second parse of the same header.
  head="$(_devbin_source_head "$install" 2>/dev/null)" || head=""
  is_commit_sha "$head" || { printf 'unknown\n'; return 0; }
  # EXACT MATCHES ONLY. Every writer records full shas; a short recorded value
  # comes from a hand edit, and a prefix could match a row it does not name.
  [ "$head" = "$rec" ] && { printf 'same\n'; return 0; }
  # A table that cannot be read places nothing, so it answers as a row not
  # found does: `unknown`, which every caller says out loud.
  line="$(manifest_ancestry "$install" "$rec")" || line=""
  [ -n "$line" ] || { printf 'unknown\n'; return 0; }
  case "${line#*	}" in
    forward | backward | unrelated) printf '%s\n' "${line#*	}" ;;
    *) printf 'unknown\n' ;;
  esac
  return 0
}

# is_yes_answer <reply> -- true when <reply> is a yes: y or yes, in any case.
#
# THE ONE ANSWER SET FOR EVERY QUESTION devbin ASKS A PERSON (issue 0134).
# ask_person took y or Y and devbin_offer_upgrade took y, Y, yes and YES, so a
# person who answered yes to fullcycle was told the cycle was declined, and one
# who answered Yes to the upgrade offer was told the same.
is_yes_answer() {
  case "${1,,}" in
    y | yes) return 0 ;;
    *) return 1 ;;
  esac
}

# stdin_tty_flag -- `1` when this process's stdin is a terminal, else `0`: the
# rule DEVBIN_GATE_TTY is read by in a devbin process (issue 0088). gate_exec
# reads the flag this way for the command it runs, so a stale inherited value
# cannot stand -- a tool it runs keeps the flag only inside the gate, and
# bin/devbin drops that mark -- and a caller that must ask a person BEFORE its
# gate opens -- fullcycle (0096) -- reads the same rule here.
stdin_tty_flag() {
  if [ -t 0 ]; then printf '1\n'; else printf '0\n'; fi
}

# gate_exec <command> [args...] -- run <command> as a gated tool runs, and
# return its status: stdin from /dev/null, so a tool that would prompt reads
# EOF instead of waiting on a terminal nobody may be watching, and
# DEVBIN_GATE_TTY saying whether a person IS at one, so devbin's own code can
# still ask through /dev/tty (issue 0088).
#
# THE ONE DEFINITION OF THAT RULE (issue 0158). run_gate wrote it inline, so a
# project's own handler that runs a gate tool directly got neither half: a
# prompting tool blocked at a terminal while an unattended caller read EOF, and
# each handler would have had to copy the redirect at every tool line.
#
# IT LIVES IN lib/helpers, NOT lib/runlog, AND THAT IS THE POINT: a scaffolded
# handler sources helpers alone (lib/tmpl/handler), and a project's handler is
# exactly the caller this exists for. Do not tidy it back into runlog.
#
# THE FLAG DESCRIBES THE PERSON, SO INSIDE A GATE IT IS KEPT (issue 0158). A
# command run under this one is told it is inside a gate (DEVBIN_IN_GATE=1), and
# there the gate's own stdin is /dev/null, so asking it again would say no
# person is there while the gate around it knew one was: release's `version set`
# and `after:` lines, which inherited the flag before, would have lost it.
# Outside a gate the flag is read from this stdin, whatever the environment
# carries, so a stale one still cannot stand (issue 0088).
#
# AN EMPTY COMMAND IS REFUSED: with no word to run, the assignments in front
# of it would be made in the caller's own shell, and nothing would run at rc 0.
#
# The local carries its own prefix: <command> may be a shell function, which
# sees this function's locals by dynamic scope.
gate_exec() {
  local _ge_tty
  if [ "$#" -eq 0 ]; then
    warn "gate_exec: no command to run"
    return 2
  fi
  _ge_tty="$(gate_tty_flag)"
  DEVBIN_IN_GATE=1 DEVBIN_GATE_TTY="$_ge_tty" "$@" </dev/null
}

# gate_tty_flag -- `1` when a person is at a terminal for this process, else
# `0`, by gate_exec's rule: inside a gate the gate's own DEVBIN_GATE_TTY, which
# it read from its stdin, and outside one this process's stdin (stdin_tty_flag).
# THE ONE READING (issue 0158): gate_exec hands it on, and a command that asks a
# person before or without a gate of its own (formula publish) reads it here, so
# neither spells the flag's words.
gate_tty_flag() {
  case "${DEVBIN_IN_GATE:-}:${DEVBIN_GATE_TTY:-}" in
    1:0 | 1:1) printf '%s\n' "$DEVBIN_GATE_TTY" ;;
    *) stdin_tty_flag ;;
  esac
}

# ask_person <question> -- ask a person at the terminal a yes/no question, from
# inside a gate. Prints `<question> [y/N] ` and reads the answer from /dev/tty.
#   0  the answer was a yes: y or yes, in any case (is_yes_answer)
#   1  any other answer, end of input included
#   2  nobody to ask: no readable /dev/tty, or the gate's stdin was not a terminal
# The caller says what each means for it; 2 is never folded into 1, because
# "declined" and "could not ask" are different answers. Every caller now exits
# 1 for both and says which in its message: release exited 2 for the second,
# as ST0007 AC-5.3 asked, until issue 0130 gave 2 back to the dispatcher.
#
# THE ONE HOME FOR THE QUESTION (issue 0089, option B): clean, fullcycle
# and the release core's first-push confirmation all ask through here, so the
# rule for "is a person here" is written once.
#
# READS /dev/tty, NEVER STDIN. run_gate hands every gated tool </dev/null
# (issue 0088, row 2), so a gated function's stdin is empty and its stdout is a
# pipe; an answer cannot come through that plumbing at all.
#
# "IS A PERSON HERE" IS THE GATE'S DEVBIN_GATE_TTY, NOT `-t 0`. Under a gate
# stdin is never the terminal, and run_gate always sets the flag from its OWN
# stdin, so the flag alone answers it. `-r /dev/tty` alone is not enough, which
# is issue 0058: it holds for any process with a controlling terminal -- a test
# suite, a script with its stdin redirected -- and the suite once printed a
# prompt into bats's captured output and blocked on a keystroke nobody knew was
# being asked for. The `:-0` default answers "nobody" for a caller outside a
# gate; every caller today is inside one, so no arm holds it.
#
# FOR A GATED CALLER ONLY. devbin_offer_upgrade, below, asks from OUTSIDE any
# gate, where the flag is either unset or inherited from a parent gate and so
# says nothing about this process; it keeps its own `-t 0` test for that reason.
ask_person() {
  local reply
  if [ ! -r /dev/tty ] || [ "${DEVBIN_GATE_TTY:-0}" != 1 ]; then
    return 2
  fi
  printf '%s [y/N] ' "$1"
  IFS= read -r reply </dev/tty || reply=""
  is_yes_answer "$reply" || return 1
}

# devbin_offer_upgrade <projroot> -- ask, on a real terminal, whether to
# upgrade now. Returns 0 whether or not anything was done.
#
# WHY THIS IS NARROW, AND IT IS A DELIBERATE NARROWING OF WHAT WAS ASKED FOR.
# The request was an offer "when it is next used". This offers on the BARE
# invocation and on `doctor`, not on every command, because there is no way for
# the dispatcher to know whether the command it is about to run is a gate --
# gate-ness is decided inside the handler, after dispatch, and the catalogue
# does not record it. `devbin test all` typed at a terminal would reach this
# code with stderr still a terminal, and stopping to ask about upgrades before
# running somebody's tests is the same defect as issue 0058 wearing a friendlier
# face. Bare and `doctor` are never gates by construction rather than by a check
# that could drift, and they are where a person is looking at devbin itself.
#
# THE TERMINAL TEST IS 0058's, BOTH ARMS. `read </dev/tty` ignores stdin, so
# `-t 0` alone would not stop it blocking; `-r /dev/tty` alone passes on any
# machine with a tty device node, which is every CI runner. Neither half works
# on its own -- that is what cost 6m30s of a hung suite.
#
# `-t 2` as well, matching the notice: a sealed gate's stderr is a pipe, so this
# cannot speak from inside one even if it were ever reached there.
devbin_offer_upgrade() {
  local root="${1:-}" state word rec cur reply
  [ -n "$root" ] || return 0
  [ -n "${DEVBIN_NO_UPDATE_NOTICE:-}" ] && return 0
  # A DEVBIN LAUNCHED BY THIS OFFER NEVER OFFERS AGAIN.
  #
  # The yes branch runs `bin/devbin upgrade`, which re-enters the dispatcher --
  # and while that upgrade is still running the project is STILL behind, so a
  # second offer is made, which launches a third upgrade. Found by mutation:
  # widening the offer to every command turned this into a live recursion that
  # hung the suite rather than failing an assertion.
  #
  # Today the command scoping happens to prevent it, because `upgrade` is not in
  # the offered set. THAT IS INCIDENTAL PROTECTION, not a guard: it holds only
  # while nobody widens the set, and the mutation is exactly what widening looks
  # like. The sentinel makes it intrinsic.
  [ -n "${DEVBIN_OFFER_IN_PROGRESS:-}" ] && return 0
  [ -t 2 ] || return 0
  [ -t 0 ] || return 0
  [ -r /dev/tty ] || return 0

  # ONLY `behind` -- the source moved FORWARD -- is an update (issue 0079). This
  # matched on any difference, so a consumer AHEAD of a rewound install was told
  # "An update to devbin is available", and a yes ran the upgrade that reverts
  # it. upgrade's own BEHIND warning came after the person had already chosen.
  state="$(devbin_source_state "$root")"
  IFS=' ' read -r word rec cur _ <<<"$state"
  [ "$word" = behind ] || return 0

  {
    printf 'An update to devbin is available.\n'
    printf '  this project has: %s\n' "${rec:0:12}"
    printf '  the source has:   %s\n' "${cur:0:12}"
    printf '  from:             %s\n' "$(manifest_source "$root" 2>/dev/null || printf 'unrecorded')"
    printf '\nUpgrading rewrites the vendored runtime in your working tree.\n'
  } >&2
  printf 'Upgrade now? [y/N] ' >&2
  # Read from the terminal, not stdin: the caller may have redirected stdin for
  # its own reasons and this question is for the person, not the pipeline.
  # EOF DECLINES, it does not vanish -- the shape `_clean_confirm` uses. An
  # early `return 0` here made the no-answer case indistinguishable from the
  # offer never having been made, which is the state a pty-at-EOF test sees.
  IFS= read -r reply </dev/tty || reply=""
  if ! is_yes_answer "$reply"; then
    printf 'Left as it is. Run: %s upgrade\n' \
      "${DEVBIN_INVOKE:-bin/devbin}" >&2
    return 0
  fi
  printf '\n' >&2
  # Runs the real verb rather than reimplementing it: upgrade owns what an
  # upgrade is, including every refusal it makes about edited files.
  ( cd "$root" && DEVBIN_OFFER_IN_PROGRESS=1 ./bin/devbin upgrade ) || true
  return 0
}

# _devbin_seam_is_level <projroot> <srcroot> -- seam_is_level, asked from
# here (issue 0224).
#
# lib/install OWNS THE BYTE ANSWER and is loaded only when this is asked. The
# dispatcher does not source lib/install, so the install machinery stays off
# the hot path of every command: devbin_source_state reaches this only on a
# forward move, and the notice asks that at most once a day.
#
# Its stderr is dropped ON PURPOSE. A comparison that cannot be made is not
# level, so the answer stays `behind`, the verdict there was before the bytes
# were asked; the reason (a manifest that vouches for nothing, a file nobody
# can read) is what `bin/devbin vendor` reports, and printed here it would land
# inside the notice or in the middle of doctor's rows.
_devbin_seam_is_level() {
  if [ -z "${_DEVBIN_INSTALL_LOADED:-}" ]; then
    # NOT FOLLOWED BY SHELLCHECK. lib/install is checked on its own, and
    # followed from here it would carry its names into every file that sources
    # lib/helpers: its `seen` array read as SC2178 in lib/cmd/check, a lint
    # finding in files that never load it.
    # shellcheck source=/dev/null
    . "${DEVBIN_LIB:?devbin_source_state needs DEVBIN_LIB set}/install" || return 1
  fi
  seam_is_level "$1" "$2" 2>/dev/null
}

# devbin_source_state <projroot> -- its states, on stdout, one word first.
#
#   level                           the vendored runtime is what the source holds
#   behind <recorded> <now>         the source has moved FORWARD past this project
#   moved <recorded> <now>          FORWARD in commits, with no vendored byte changed
#   ahead <recorded> <now>          the source is BEHIND this project
#   differs <recorded> <now> <why>  they differ, and in no direction anyone knows
#   unknown <reason>                it could not be established
#
# ONLY `behind` IS AN UPDATE (issue 0079). This had three states and compared
# two shas for equality, so every difference was `behind` -- and the notice, the
# offer and doctor all told a project AHEAD of a rewound source to upgrade,
# which is issue 0021's silent revert, measured at 11 files. The direction now
# comes from source_direction, the answer upgrade and vendor already read, so
# nothing here can call a move "an update" that upgrade would call a revert.
#
# `differs` IS NOT `unknown`. A record the source cannot place, or a source on
# another history, is a REAL difference, and staying quiet about it hides one;
# but nothing vouches the source is newer, so it is never called an update.
# `unknown` is for when there was no difference to report: nothing to compare,
# or the same commit on both sides with no direction established for it.
#
# `ahead` IS A CLAIM ABOUT HISTORY, NOT BYTES. The source holds an older commit
# than the one this project vendored; whether any vendored FILE would change is
# upgrade's question (seam_is_level, lib/install), and a source that moved only
# outside the seam changes none. So the readers say which way the commits lie
# and never that an upgrade would revert the runtime.
#
# `moved` IS THE MIRROR, AND IT IS NOT AN UPDATE (issue 0224). A forward move
# was `behind` whatever it touched, so a devbin commit that moved only
# coordination state told every project linked to the checkout to upgrade for
# no change to any file it vendored. A forward move now asks seam_is_level, the
# byte answer upgrade already reads, and one that changes no vendored byte is
# `moved`: the commits still differ, so it is kept apart from `level`, and only
# `behind` is offered as an update. The comparison FAILS CLOSED, as
# seam_is_level does: when the bytes cannot be read the move stays `behind`.
#
# WHY THIS EXISTS SEPARATELY FROM THE NOTICE. `_devbin_update_line` prints or
# stays quiet, and quiet is its answer for BOTH "level" and "cannot tell". That
# is right for a notice -- it asserts nothing and must never nag -- and it is
# exactly wrong for a CHECK, where the two must not collapse. Absent is not
# clean; a check that cannot reach the source and reports nothing is read as
# reporting currency it never established.
#
# The notice, the offer and `doctor` all read this, and it asks
# `_devbin_source_head` and source_direction, so there is one answer to "what
# does the source hold" and one to "which way did it move".
devbin_source_state() {
  local root="${1:-}" src rec cur
  [ -n "$root" ] || { printf 'unknown no project root given\n'; return 0; }

  src="$(manifest_source "$root" 2>/dev/null || true)"
  if [ -z "$src" ]; then
    printf 'unknown %s\n' "$(source_unplaced_why "$root")"
    return 0
  fi
  rec="$(manifest_source_commit "$root" 2>/dev/null || true)"
  [ -n "$rec" ] || { printf 'unknown this project records no source commit\n'; return 0; }
  [ -d "$src" ] || { printf 'unknown the source is not on this machine: %s\n' "$src"; return 0; }

  rec="${rec%% *}"
  is_commit_sha "$rec" ||
    { printf 'unknown this project records bytes that name no commit\n'; return 0; }
  if ! cur="$(_devbin_source_head "$src")"; then
    printf 'unknown the source names no commit: %s\n' "$src"
    return 0
  fi

  case "$(source_direction "$root" "$src")" in
    same) printf 'level\n' ;;
    forward)
      if _devbin_seam_is_level "$root" "$src"; then
        printf 'moved %s %s\n' "$rec" "$cur"
      else
        printf 'behind %s %s\n' "$rec" "$cur"
      fi
      ;;
    backward) printf 'ahead %s %s\n' "$rec" "$cur" ;;
    unrelated) printf 'differs %s %s the source is on a different history\n' "$rec" "$cur" ;;
    *)
      # EQUAL SHAS WITH NO DIRECTION. Today that is a `+dirty` record at the
      # source's own commit: the bytes started there and are not it, and it read
      # `level` until 0079 because the sha was stripped of its mark and then
      # compared. The reason names what is known rather than inferring the mark.
      if [ "$rec" = "$cur" ]; then
        printf 'unknown this project records the commit the source holds, but no direction could be established for it (a +dirty record reads this way)\n'
      else
        printf 'differs %s %s which way the source moved cannot be told from what is on disk\n' "$rec" "$cur"
      fi
      ;;
  esac
  return 0
}

# _devbin_update_line <projroot> -- print the notice body, or nothing.
#
# SEPARATED FROM DELIVERY SO IT CAN BE TESTED. The comparison is the part with
# the logic in it and the guards are the part with the policy; keeping them in
# one function made the whole thing reachable only through a real terminal.
#
# THE TERMINAL PROBLEM IS SOLVED AND THIS PARAGRAPH USED TO SAY OTHERWISE. It
# read, in the present tense, that "the only way to give a test one is `script`,
# which fails outright when stdin is a socket", and recorded that two tests
# asserting the notice stayed SILENT had passed vacuously -- no pty, no output,
# refutation satisfied. That was true when written and has not been true since
# `run_tty_eof` (tests/lib/test_helper.bash) landed: `script` starts when its
# OWN stdin is `/dev/null`, and the child still gets the allocated pty. The
# delivery half is exercised for real today -- `ON A TERMINAL the notice
# actually SPEAKS` is green, not skipped.
#
# The correction is kept rather than the paragraph deleted, because the stale
# version cost something measurable: a reader took it for a live gap, re-derived
# the `</dev/null` trick from scratch, and offered it as a fix that was already
# in the tree. A comment describing a solved problem in the present tense is a
# claim with an expiry date, and this file is where that class gets recorded.
#
# Prints to stdout; the caller decides where it goes. Empty output means there
# is nothing to say.
_devbin_update_line() {
  local root="${1:-}" state word rec cur why
  [ -n "$root" ] || return 0

  # ONE READER OF THE STATE, NOT A SECOND COMPARISON (issue 0079). This kept its
  # own sha check and its own equality test beside devbin_source_state's, so the
  # two could disagree and both called any difference "moved on".
  state="$(devbin_source_state "$root")"
  IFS=' ' read -r word rec cur why <<<"$state"

  # Twelve characters, and only ever printed when the full shas differ. The
  # first version truncated BEFORE comparing like with like, so it printed two
  # identical-looking values as its evidence that they differed -- the
  # truncation did not merely fail to help, it hid the cause.
  case "$word" in
    behind)
      printf 'UPDATE: devbin has moved on since this project vendored it.\n'
      printf '        vendored %s, source now %s\n' "${rec:0:12}" "${cur:0:12}"
      printf '        run: %s upgrade      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
    ahead)
      printf 'NOTE: the devbin this project came from is BEHIND this project.\n'
      printf '      vendored %s, source now %s -- an older commit\n' "${rec:0:12}" "${cur:0:12}"
      printf '      run: %s vendor, before any upgrade      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
    differs)
      printf 'NOTE: the devbin this project came from differs from what it vendored: %s.\n' "$why"
      printf '      vendored %s, source now %s\n' "${rec:0:12}" "${cur:0:12}"
      printf '      it is not known to be newer; run: %s vendor      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
  esac
  return 0
}

# devbin_update_notice <projroot> -- tell the user, ONCE A DAY AND ONLY ON A
# TERMINAL, that the devbin this project vendored has moved on, is behind it, or
# differs from it in no known direction (issue 0079).
#
# THE POINT IS THAT A CONSUMING PROJECT LEARNS WITHOUT BEING ASKED. `vendor`
# already answers "is this tree level with its SOURCE" -- the comparison is not
# new, only the moment it is made. What is new is that the answer reaches
# someone who was not investigating.
#
# THE CONSTRAINTS, AND THE FIRST IS NOT OBVIOUS.
#
#   STDERR, NEVER STDOUT. devbin seals gate output and its extraction grammars
#   parse it; some print on unanchored patterns. A version notice on stdout
#   lands INSIDE a run log and is read as tool output -- issue 0025's class
#   exactly.
#
#   A TERMINAL, OR NOTHING. `[ -t 2 ]` keeps it out of CI logs and out of sealed
#   gates, whose stderr is a pipe. Load-bearing, not a nicety.
#
#   ONCE A DAY. A git call on every invocation would put a fork on the hot path
#   of a launcher that runs on every command.
#
#   NEVER FATAL, AND NEVER NOISY ABOUT ITS OWN FAILURE. A consumer usually does
#   not have devbin's source on disk at all. That is the ordinary case, so every
#   failure path is a silent `return 0`. This is the one place in devbin where
#   swallowing is correct: the function asserts nothing, and IN-AG-NO-SILENT-001
#   is about failures that reach a verdict.
#
# THE STAMP IS WRITTEN BEFORE THE COMPARISON, DELIBERATELY: the rate limit is on
# the CHECK, not on the message, so a source that moves on five minutes after a
# check is reported at the next day's check rather than on the next command.
devbin_update_notice() {
  local root="${1:-}" stamp msg dir base
  [ -n "$root" ] || return 0
  [ -n "${DEVBIN_NO_UPDATE_NOTICE:-}" ] && return 0
  [ -t 2 ] || return 0

  # The stamp lives in TMPDIR rather than the project, so it needs no .gitignore
  # entry and can never appear in a consumer's git status.
  base=".devbin-update-$(printf '%s' "$root" | tr -c 'a-zA-Z0-9' '-')"
  dir="${TMPDIR:-/tmp}"
  stamp="$dir/$base"
  # -mtime is POSIX; -newermt is GNU-only, and devbin runs on macOS too.
  #
  # find's errors go to /dev/null HERE ON PURPOSE, one of the finds in lib/ that
  # may (issue 0139); another is lib/install's seam check, which reads find's
  # status and answers UNREADABLE. This one asks only whether today's notice was
  # already shown, and a find that fails answers "not shown", which re-runs a
  # check that prints at most one line: the failure costs a repeat, never a
  # wrong verdict, and an error printed before every command would cost more
  # than the notice is worth.
  # find-walk: -maxdepth 1 -- one stamp file in one directory; it never enters one
  # find-status: dropped -- a failure here only repeats the daily update check.
  if [ -f "$stamp" ] && [ -n "$(find "$dir" -maxdepth 1 -name "$base" -mtime -1 2>/dev/null)" ]; then
    return 0
  fi
  : >"$stamp" 2>/dev/null || true

  msg="$(_devbin_update_line "$root")"
  [ -n "$msg" ] && printf '%s\n' "$msg" >&2
  return 0
}
