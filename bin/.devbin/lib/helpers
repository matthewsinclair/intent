#!/usr/bin/env bash
#
# lib/helpers -- shared output and guard primitives.
#
# Sourced, not executed: defines functions, and sets exactly ONE shell option,
# `inherit_errexit`, below. The rest (errexit, nounset, pipefail) stay the
# caller's. This file said it set none until issue 0060: handlers are separate
# processes that source this file and nothing else from the dispatcher, so this
# is the one place a line reaches every one of them.
#
# THIS FILE HAS NO DEPENDENCIES, and that is a load-bearing rule rather than a
# happy accident. Command handlers are separate processes that source this file
# ALONE (see bin/.devbin/cmd/check). The moment a primitive here needs config,
# every handler in every project has to load the config reader to print a
# warning. So the rule is: needs config, belongs in lib/resolve; needs nothing,
# belongs here. `is_command` and `parse_common_opts` live in lib/resolve for
# exactly this reason, despite reading as helpers.
#
# WP-05 folds the universal functions out of the four source projects. The
# run-log subsystem -- open_run_log, write_errors_file, note_promotion, the
# purge family, print_run_verdict -- is deliberately NOT here: it is one
# cohesive subsystem and WP-06 ports it whole into lib/runlog. Splitting it
# across two files to satisfy a function count would be the worse trade.
#
# The project name in the die/warn prefix comes from config rather than being
# baked in, which is the whole point of the fold: four projects printing
# `conflab:` / `laksa:` / `baize:` / `lamplight:` from four copies of the same
# two lines becomes one line reading a value.
#
# bash_floor_refuse <version> <path> [<how it was reached>] -- the ONE refusal
# for a bash below devbin's floor, and it exits.
#
# THE FLOOR (issue 0022, reversing design D9). devbin requires bash >= 5 and
# REFUSES older: macOS ships /bin/bash 3.2.57 permanently (GPLv3), the fleet
# runs a Homebrew bash 5.x everywhere, and the guarantee points at what actually
# runs. EVERYTHING FROM HERE TO THE LOAD GUARD MUST STAY PARSEABLE BY BASH 3.2 --
# the refusal cannot be allowed to arrive as a syntax error that explains
# nothing.
bash_floor_refuse() {
  printf '%s: bash >= 5 is required; this is bash %s (%s)\n' \
    "${DEVBIN_NAME:-devbin}" "${1:-unknown}" "${2:-unknown}" >&2
  [ -z "${3:-}" ] || printf '  %s\n' "$3" >&2
  printf '  macOS ships bash 3.2 permanently -- install a current one:  brew install bash\n' >&2
  printf '  (issue 0022, reversing design D9, 2026-08-24)\n' >&2
  exit 1
}

# THE FLOOR IS CHECKED WHERE EVERY PROCESS PASSES (issue 0076). It lived in the
# dispatcher alone, and handlers are separate processes: one run directly, or
# exec'd under a PATH that finds 3.2, ran on 3.2 with nothing refusing. Every
# built-in handler and the dispatcher source this file, so the check sits here,
# ahead of the load guard, and a handler below the floor stops at load.
if [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  bash_floor_refuse "${BASH_VERSION:-}" "${BASH:-}"
fi

[ -n "${_DEVBIN_HELPERS_LOADED:-}" ] && return 0
_DEVBIN_HELPERS_LOADED=1

# ERREXIT REACHES EVERY DEPTH (issue 0060, ruled option A 2026-09-16). Command
# substitution does not inherit errexit without this, so a `die` two `$( )`
# deep kills only its own subshell: the middle function carries on and the
# outer caller reads its output as success. Measured live at `release notes`,
# which wrote both views and exited 0 over a refusal it had printed twice.
# Unguarded, because the floor above has already refused every bash without it.
shopt -s inherit_errexit

# require_path_bash_floor -- refuse when the bash PATH resolves is below the
# floor, since every `#!/usr/bin/env bash` handler runs on THAT bash and not on
# the dispatcher's own (issue 0076).
#
# Measured before this existed: `env PATH=/usr/bin:/bin /opt/homebrew/bin/bash
# bin/devbin probe` passed the dispatcher's own check on 5.3 and ran the handler
# on 3.2.57 at rc 0. The ordinary case costs one PATH lookup: the same file as
# the running bash needs no second process.
require_path_bash_floor() {
  local path_bash answer
  # No bash on PATH at all is not a floor question: every `env bash` handler
  # then fails at exec, loudly, naming bash.
  path_bash="$(type -P bash)" || return 0
  [ "$path_bash" -ef "${BASH:-}" ] && return 0
  # Single-quoted on purpose: the CHILD bash expands these, not this one.
  # shellcheck disable=SC2016
  answer="$("$path_bash" -c 'printf "%s %s" "${BASH_VERSINFO[0]}" "$BASH_VERSION"')" ||
    die "could not ask $path_bash its version, and handlers run on the bash PATH resolves"
  case "${answer%% *}" in
    '' | *[!0-9]*) die "$path_bash answered its version as '$answer', which is not a bash version" ;;
  esac
  [ "${answer%% *}" -ge 5 ] && return 0
  bash_floor_refuse "${answer#* }" "$path_bash" \
    "PATH resolves bash to it, and every handler runs on the bash PATH resolves (this dispatcher is on $BASH_VERSION)"
}

# The prefix on diagnostics. Set by the dispatcher once config is loaded;
# defaults to `devbin` so a failure BEFORE config load still says something
# sensible rather than printing a bare colon.
DEVBIN_NAME="${DEVBIN_NAME:-devbin}"

# DEVBIN_INVOKE -- HOW YOU TYPE IT, which is now a CONSTANT rather than the
# project's name.
#
# These were one field until 2026-08-27, because the launcher was symlinked to
# the project's own name and `bin/lamplight` was both the thing you typed and
# the thing the project was called. That convention collided with the binaries
# these projects now BUILD -- Lamplight ships a `lamplight`, Intent ships an
# `intent` -- and Intent had already routed around it by naming its shim `int`.
# So the per-project symlink is retired and `bin/devbin` is the invocation
# everywhere.
#
# IT WAS A CONSTANT, AND THE PREMISE FOR THAT WAS FALSE (ST0005, 2026-09-06).
#
# This read: "The invocation no longer varies, so a variable would be a field
# that must be kept in sync with a fact that cannot change." That reasoning was
# about the retired per-project symlink and it was right about THAT. What it
# missed is that `bin/devbin` is a RELATIVE path, so what varies is not the name
# but whether it RESOLVES from where the reader is standing.
#
# The operator drives devbin through `dvb`, a shell function that walks UP from
# $PWD to find `bin/devbin` and runs it without changing directory -- so its
# whole purpose is being used from a SUBDIRECTORY. Measured there, every
# remediation devbin prints was a command that does not exist:
#
#     run: bin/devbin upgrade
#     $ bin/devbin upgrade
#     no such file or directory: bin/devbin
#
# That is the Lamplight defect this file already records one form of -- "the
# remediation names a command that EXISTS" -- recurring in the one direction the
# earlier fix did not cover. It exists at the project root, and not where the
# reader is.
#
# So it is the SHORTEST FORM THAT WORKS FROM THE CALLER'S CWD, and the dispatcher
# computes it once from the ORIGINAL cwd before any handler cds to the project
# root. `:-` rather than a bare assignment so a re-source inside an exec'd
# handler inherits that answer instead of recomputing a wrong one.
DEVBIN_INVOKE="${DEVBIN_INVOKE:-bin/devbin}"

die() {
  printf '%s: %s\n' "$DEVBIN_NAME" "$*" >&2
  exit 1
}

warn() {
  printf '%s: %s\n' "$DEVBIN_NAME" "$*" >&2
}

step() { printf '\n==> %s\n' "$*"; }
ok() { printf '    done.\n'; }

# report_not_yet <what> <gate> -- print the STUB refusal and return 3.
#
# The non-exiting half of not_yet, for callers running inside a loop over
# several options: `all` must not stop at the first breach, so a function it
# calls in the same process cannot exit. One message, two exit behaviours.
report_not_yet() {
  printf '%s: %s is not built yet.\n' "$DEVBIN_NAME" "$1" >&2
  printf '       gated on: %s\n' "$2" >&2
  return 3
}

# not_yet <what> <gate> -- the STUB refusal, ported from the corpus.
#
# A surface that is not built yet exits NON-ZERO with the reason and what
# unblocks it, never a quiet no-op. An unbuilt gate that exits 0 is
# indistinguishable from a passing one, which is the exact failure the sealed
# gates exist to prevent.
not_yet() {
  report_not_yet "$1" "$2" || true
  exit 3
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found. ${2:-}"
}

# init_colors [auto|off] -- set green/red/dim/reset. All empty when off, when
# NO_COLOR is set, or when stdout is not a TTY.
#
# SC2034 (appears unused) is expected here and suppressed: these are globals for
# the whole runtime, and shellcheck only sees this file. Exporting them to
# satisfy the linter would push four colour variables into the environment of
# every command devbin runs, which is a worse trade than one directive.
# shellcheck disable=SC2034
init_colors() {
  green="" red="" dim="" reset=""
  if [ "${1:-auto}" = auto ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    green=$'\033[32m' red=$'\033[31m' dim=$'\033[2m' reset=$'\033[0m'
  fi
}

# strip_ansi -- filter: remove CSI escape sequences from stdin.
#
# Byte-identical in all four projects. Reads stdin, writes stdout, so it
# composes in a pipeline: `... | strip_ansi > "$errors"`.
#
# The escape byte is passed in as an awk variable rather than written into the
# pattern, because a literal ESC in source survives neither editors nor patches
# reliably.
strip_ansi() {
  awk -v esc="$(printf '\033')" '{ gsub(esc "\\[[0-9;?]*[A-Za-z]", ""); print }'
}

# upper_snake <string> -- the environment-variable spelling of a name.
#
# `lamplight` -> LAMPLIGHT, `my-proj` -> MY_PROJ. Devbin derives variable names
# from the project name in several places -- <NAME>_ROOT, <NAME>_REPL_HISTORY,
# DEVBIN_OPT_<NAME>, the run-log suffix -- and each did the same `tr` inline.
# Four copies of one transformation is four chances to disagree about whether a
# hyphen becomes an underscore.
upper_snake() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'
}

# is_true_word <value> -- `true`, `yes` or `1`.
# is_false_word <value> -- `false`, `no` or `0`.
# is_no_default <value> -- the catalogue's `-`: "devbin ships no default here".
#
# ONE PREDICATE PER VOCABULARY (issue 0066). These were written out at thirteen
# sites across lib/resolve, lib/runlog and lib/builtins. Every copy agreed, and
# nothing would have said so on the day one learned a word the others did not
# -- which is how 0065 happened: `-` was honoured for `log:` on the catalogue's
# value alone, and a project writing `log: "-"` sealed a gate named `-`. The
# words are exact and case-sensitive, as every copy was; `off` is not false.
#
# THE WORDS ARE DATA, AND THE PREDICATES READ THEM. docs/configuration.md and
# lib/config.reference.yaml both state the `log:` decline spellings, and
# tests/unit/helpers.bats holds each statement to these lists. It first read the
# words back out of the function's source, which a second `return 0` line or an
# `OFF)` arm slipped past (critic-shell, 2026-09-16); a list has no layout to
# parse around.
_DEVBIN_TRUE_WORDS="true yes 1"
_DEVBIN_FALSE_WORDS="false no 0"
_DEVBIN_NO_DEFAULT="-"

# _word_in <value> <words> -- <value> is exactly one of the space-separated
# <words>. Split with `read -a`, which never globs, so a word is only ever a
# literal.
#
# IFS IS PINNED HERE, because `read -a` splits on the CALLER'S. Under the common
# strict-mode `IFS=$'\n\t'`, or `IFS=`, the list stayed one word and `true`,
# `yes`, `1` and `no` all read as not-a-word -- so `log: false` stopped declining,
# 0065 again, in any estate handler that sources lib/helpers under strict mode
# (vc, 2026-09-16). The case statements this replaced never read IFS.
_word_in() {
  local w IFS=' '
  local -a words
  read -r -a words <<<"$2"
  for w in "${words[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

is_true_word() { _word_in "$1" "$_DEVBIN_TRUE_WORDS"; }
is_false_word() { _word_in "$1" "$_DEVBIN_FALSE_WORDS"; }
is_no_default() { _word_in "$1" "$_DEVBIN_NO_DEFAULT"; }

# has_words <value> -- true when <value> holds a character bash would not split
# on, which is the same question as "run_words would find at least one word".
#
# SEPARATE FROM run_words BECAUSE VALIDATION MAY NOT GLOB: cfg_validate reads
# every declared command line wherever `doctor` happens to be standing, and
# matching a pattern there would say nothing about the directory the command
# will run in. This asks the only half validation can answer.
#
# The characters are the three run_words splits on, not `[[:space:]]`: a value
# of one carriage return is a word to bash and is not a space to that class, and
# a refusal that disagreed with the split would refuse a line that runs.
has_words() {
  case "$1" in
    *[!$' \t\n']*) return 0 ;;
  esac
  return 1
}

# run_words <array> <key> <value> -- fill <array> with the words <value> runs
# as, or refuse, naming <key>, a value with no words in it.
#
# THE ONE READING OF A DECLARED COMMAND LINE (issue 0082, hv's ruling of
# 2026-09-17). Every place devbin runs one asks this: an option's `run:` bare
# and under a gate, a command's `run:` exec'd and under a gate,
# `commands.fullcycle.restore`, `release.notes.run`, and the catalogue's own
# command lines, which follow the same rule because two halves of one surface
# differing would be worse than either behaviour on its own.
#
# - SPLIT ON SPACE, TAB AND NEWLINE, never on the caller's IFS. Under the
#   common strict-mode `IFS=$'\n\t'` a whole command line stays one word and
#   resolves to nothing, and that class has been measured twice in this tree in
#   two days (`_word_in`, `cfg_release_list`).
# - EVERY WORD IS A GLOB PATTERN, matched in the directory the caller stands in,
#   which each site makes the directory the command runs from: the project root,
#   or for `notes.run` the root it answers for. A word matching nothing is
#   passed as written, a word matching several becomes several words, and a
#   dotfile is matched only by a pattern that names the dot. hv ruled the
#   globbing KEPT and documented after the census of 2026-09-17: one word in the
#   fleet relies on it, Utilz's `bats opt/*/test`, and it matches 16 directories.
# - THE READING IS DEVBIN'S, NOT THE PROCESS'S. `set -f` and the glob options
#   are pinned here for the split alone and put back before this returns, so an
#   inherited `SHELLOPTS=noglob` or `BASHOPTS=nullglob:dotglob` cannot quietly
#   change what a declared line runs -- both measured on bash 5.3, 2026-09-17,
#   turning globbing off entirely and dropping a word that matches nothing.
#   **NOT pinned, deliberately: `GLOBIGNORE` and `GLOBSORT`.** Both are inert
#   when they arrive in the environment, measured the same day, and `local
#   GLOBIGNORE` would ACTIVATE the inherited value for the rest of the process
#   as the local goes out of scope. devbin assigns neither, and a test holds it.
#   **AND NOT PINNING IS THE ONLY CORRECT ANSWER, NOT THE CONVENIENT ONE**, which
#   is stronger than this note said until dc drove it on 2026-09-17: bash runs
#   these hooks on ASSIGNMENT, so once the variable is touched at all the inert
#   state cannot be restored by any assignment -- saving it, unsetting it and
#   writing the same bytes back leaves it ACTIVE. A pin here would therefore be
#   a one-way door for the whole process, which is why the rule is "never touch"
#   rather than "save and restore" as it is for the shopts above.
# - NEVER EVAL'D (D1). Quotes, `$`, `;` and redirections in the value are
#   literal characters, so a declared line cannot carry an argument with a space
#   in it; a command line that needs real quoting needs a handler.
# - A VALUE WITH NO WORDS IS REFUSED, NAMING <key>. A `run:` of only spaces is
#   not empty to `[ -n "$run" ]` and splits into nothing, after which `$run "$@"`
#   ran the arguments typed after the command AS the command, at exit 0.
run_words() {
  # A NAMEREF CANNOT BE HONOURED IF THE NAME IS ONE OF OURS, AND FAILING THAT
  # QUIETLY WOULD REBUILD THE DEFECT THIS HELPER EXISTS TO KILL. `local -n
  # _rw_out="$1"` binds first and the `local` on the next line then SHADOWS the
  # caller's variable when the name matches, so the words land in the local, the
  # local dies at return, and run_words hands back 0 with the caller's array
  # never set -- after which `"${words[@]}" "$@"` is an empty command line that
  # runs the arguments typed after the command, at exit 0. That is 0082 exactly.
  # Measured on bash 5.3: `_rw_o`, `_rw_on` and `IFS` each do it silently, and
  # `_rw_on` additionally hands the split words to `shopt -s`. No caller can
  # reach it -- every site passes `words` or `restore_words` -- so this is a
  # trap for the next caller rather than a live bug, and status 2 marks it as a
  # programming error rather than the config error 1 means.
  # TWO CHECKS, BECAUSE A BLACKLIST ALONE LEAVES 0082'S OWN SHAPE NEXT TO IT.
  # The first cut here listed the colliding names and stopped, and dc drove the
  # hole: `run_words 2bad ...` makes `local -n` fail with bash's own `invalid
  # variable name for name reference`, execution FALLS THROUGH, and run_words
  # returns 0 with the caller's array never set -- which is the empty command
  # line again. Measured on bash 5.3, all at rc=0: `2bad`, `a b`, `a-b`, `-x`,
  # `a;b`. `arr[0]` got as far as the copy and returned 1, reporting a valid
  # name as "the config's line held no words". A name that IS a name is the
  # question, so it is asked positively, through the one definition of it.
  if ! is_identifier "$1"; then
    warn "run_words: '$1' is not a shell variable name, so there is no array to fill"
    return 2
  fi
  case "$1" in
    _rw_out | _rw_o | _rw_on | _rw_split | IFS)
      warn "run_words: cannot fill an array named '$1' -- it is one of run_words's own names"
      return 2
      ;;
  esac
  local -n _rw_out="$1"
  local IFS=$' \t\n' _rw_o _rw_on=""
  # The split lands in a local and is copied to the caller AFTER the shopts are
  # put back, so a target bash refuses to assign -- a readonly one -- cannot
  # leave the six options unset in the caller's shell. dc's finding; unreachable
  # from the eight sites, which all pass a plain indexed array.
  #
  # **AN INTEGER TARGET IS NOT REFUSED AND THE GUARD ABOVE CANNOT REFUSE IT**,
  # because `declare -ia w` carries a name that IS a name: the defect is the
  # attribute, not the spelling. This comment claimed a `declare -ia` target
  # refuses, and that was wrong in both directions, measured on bash 5.3 --
  # under `set +u` the word `abc` COERCES, silently, to `(0)`, so the caller
  # runs the command `0`; under devbin's own `set -euo pipefail` the arithmetic
  # on an unset name kills the shell outright. Loud in devbin, silent in a
  # caller that relaxed `set -u`. It is declared rather than closed: no site
  # passes an integer array, and a check on the target's attributes would be
  # reading `declare -p` output as a string.
  local -a _rw_split=()
  # `set` options are restored on return; the shopt ones are put back below,
  # which is why the split and the restore sit between no other statements.
  local -
  set +f
  for _rw_o in nullglob failglob dotglob nocaseglob globstar extglob; do
    shopt -q "$_rw_o" || continue
    _rw_on="$_rw_on $_rw_o"
    shopt -u "$_rw_o"
  done
  if has_words "$3"; then
    # shellcheck disable=SC2206  # split and globbed on purpose -- see above
    _rw_split=($3)
  fi
  # shellcheck disable=SC2086  # a list of option names, split on purpose
  [ -z "$_rw_on" ] || shopt -s $_rw_on
  _rw_out=(${_rw_split[@]+"${_rw_split[@]}"})
  if [ "${#_rw_out[@]}" -eq 0 ]; then
    warn_no_words "$2"
    return 1
  fi
}

# warn_no_words <key> -- the ONE sentence devbin says when a declared command
# line holds no words. run_words says it at the site, where the words are about
# to be run; a caller that may not glob says it through has_words and this. Two
# readers of a command line and one sentence, rather than the same sentence
# written out wherever it happens to be needed (issue 0082).
warn_no_words() { warn "$1 holds no words, so there is no command to run"; }

# follow_links <path> -- print the path of the file <path> names: <path> itself
# when it is not a symbolic link, otherwise the end of its chain of links.
# Refuses, naming <path>, a link that leads to no file and a link it cannot
# follow exactly.
#
# THE ONE WALK OF A CHAIN OF LINKS: stage_beside's, so that every writer that
# replaces a file writes through a link to it (issue 0084), and clean's real
# path. bin/devbin keeps a walk of its own, because it runs before this file can
# be found and must parse under bash 3.2.
#
# - PLAIN `readlink`, NO FLAGS. `readlink -f` and `realpath` also resolve every
#   directory on the way, and they are not the same program on BSD and GNU.
#   Plain readlink printed the same bytes on both for an absolute target, a
#   relative one, `..`, a space, a leading dash, a dangling link and a loop
#   (measured 2026-09-17: macOS's readlink and GNU coreutils 9.12).
# - A RELATIVE TARGET IS JOINED TO ITS LINK'S DIRECTORY AS WRITTEN, and never
#   tidied: when `a` is itself a link, the kernel reads the `..` in `a/../t`
#   after following `a`, so a tidied `t` can name a different file.
# - A LINK THAT LEADS TO NO FILE IS REFUSED, dangling or in a loop alike. Writing
#   through it would create a file nobody put there, and replacing it would
#   throw the link away.
# - ONE TARGET CANNOT BE READ BACK EXACTLY: a name ending in a newline, which
#   BSD's readlink prints with one newline fewer than GNU's, and whose remaining
#   newlines a command substitution strips. So the end of the walk must be the
#   file the kernel reaches (`-ef`), and the walk is bounded, since a misread
#   name can lead back into the chain. A correct walk never meets the bound,
#   because the link was reachable: macOS follows 32 links (measured) and Linux
#   documents 40.
follow_links() {
  local path="$1" p="$1" t n=0
  if [ -L "$p" ] && [ ! -e "$p" ]; then
    warn "$path is a symbolic link that leads to no file"
    return 1
  fi
  while [ -L "$p" ]; do
    n=$((n + 1))
    if [ "$n" -gt 40 ] || ! t="$(readlink -- "$p")"; then
      warn "cannot tell which file $path is a symbolic link to"
      return 1
    fi
    case "$t" in
      /*) ;;
      *) case "$p" in */*) t="${p%/*}/$t" ;; esac ;;
    esac
    p="$t"
  done
  if [ "$n" -gt 0 ] && ! [ "$path" -ef "$p" ]; then
    warn "cannot tell which file $path is a symbolic link to"
    return 1
  fi
  printf '%s\n' "$p"
}

# stage_beside <file> <command> [args...] -- write what <command> prints into a
# temporary that will REPLACE <file>, and print the temporary's name.
# rename_staged <temporary> -- rename a temporary stage_beside printed over the
# file it will replace; on a failure, remove it.
# replace_file <file> <command> [args...] -- replace <file> with what <command>
# prints: staged beside it, then renamed over it.
#
# THE ONE HOME FOR "write a temporary, then rename it over the file" -- the
# temporary, the write into it, its mode, the rename and the cleanup, each of
# which every writer that replaced a file once had its own copy of:
#
# - THE TEMPORARY IS BESIDE THE FILE, NOT IN TMPDIR. A rename is atomic only
#   within one filesystem; across two, `mv` quietly copies, and a kill mid-copy
#   leaves the truncated file this pattern exists to rule out (issue 0002).
# - THROUGH A LINK, THE FILE IT NAMES IS REPLACED AND THE LINK SURVIVES. The
#   temporary is staged beside the file at the end of the link (follow_links),
#   so the rename stays on that file's filesystem, and rename_staged renames it
#   over that file, which the temporary's name records. Renamed over the link's
#   own path, it turned the link into a regular file holding the edit, while the
#   file the link named kept its old content and the writer exited 0 (issue
#   0084). So a caller renaming a staged temporary itself renames it with
#   rename_staged, never over the path it staged.
# - IT HAS THE FILE'S MODE. mktemp creates 0600, and the rename carries that
#   onto the file, so every writer that renamed a temporary into place left a
#   0644 file 0600 -- CHANGELOG.md and RELEASES.md were, on the machine that
#   generated them, with nothing to show it, since git records only the
#   executable bit. `cp -p` gives the temporary the file's mode before the
#   write; a file that does not exist yet gets the mode the umask gives a new
#   file.
# - A READ-ONLY FILE IS STILL REPLACED, AND KEEPS ITS MODE. Copied first, a 0444
#   file's mode made its temporary 0444 too, and the write into it was refused
#   (ST0007 WP-02 review, K3). So the owner's write bit is added for the write
#   when the copied mode lacks it, and taken away again after. The mode is never
#   READ, which keeps this off stat, whose flags differ between BSD and GNU.
# - ON A FAILURE IT RETURNS, THE FILE IS UNTOUCHED AND THE TEMPORARY REMOVED,
#   and a failure of the mechanics is named here, so a caller adds only what it
#   was doing. A failing <command> names its own failure. Two ways still leave a
#   temporary beside the file: a process killed before the rename, and a file
#   flag that `cp -p` copies onto the temporary -- BSD's uchg refuses the write
#   and the removal alike, so the helper returns 1 and rm's own error names the
#   temporary (measured by vc, ST0007 WP-02 review).
stage_beside() {
  local file tmp restore=""
  # The x keeps a name that ends in a newline, which a bare capture strips, and
  # the temporary would then be staged for a different file.
  file="$(follow_links "$1" && printf x)" || return 1
  file="${file%$'\n'x}"
  shift
  if ! tmp="$(mktemp "${file}.XXXXXX")"; then
    warn "could not create a temporary file beside $file"
    return 1
  fi
  if [ -e "$file" ]; then
    if ! cp -p "$file" "$tmp"; then
      rm -f "$tmp"
      warn "could not give the temporary file $file's mode"
      return 1
    fi
    if [ ! -w "$tmp" ]; then
      if ! chmod u+w "$tmp"; then
        rm -f "$tmp"
        warn "could not make the temporary file for $file writable"
        return 1
      fi
      restore=u-w
    fi
  elif ! chmod "$(printf '%o' "$((0666 & ~$(umask)))")" "$tmp"; then
    rm -f "$tmp"
    warn "could not give the temporary file for $file a new file's mode"
    return 1
  fi
  if ! "$@" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [ -n "$restore" ] && ! chmod "$restore" "$tmp"; then
    rm -f "$tmp"
    warn "could not give the temporary file $file's mode back"
    return 1
  fi
  printf '%s\n' "$tmp"
}

# The file is the temporary's name without mktemp's six characters, which is
# where stage_beside staged it: through a link, not the link's path.
#
# `-f` IS NOT DEFENSIVE, IT IS WHAT STOPS THIS BLOCKING FOREVER ON A TERMINAL.
# POSIX mv prompts when the destination exists, permissions do not allow writing
# it, and stdin is a tty -- and a replace of a READ-ONLY file is exactly that
# case, which is the one stage_beside goes to the most trouble to support. With
# no tty the prompt never appears, so every agent-run and CI run of the suite
# passed while `bin/devbin test all` from a human's terminal stopped dead at
# `replace_file replaces a read-only file` and stayed quiet for eight hours
# (2026-09-17, hv). A false green that is green for everyone who can see it.
# lib/install:379 already wrote `mv -f` for its own rename; this is the second
# of the two mv calls in the runtime and it had not.
rename_staged() {
  local file="${1%.??????}"
  if ! mv -f "$1" "$file"; then
    rm -f "$1"
    warn "could not rename the temporary file over $file"
    return 1
  fi
}

replace_file() {
  local tmp
  tmp="$(stage_beside "$@")" || return 1
  rename_staged "$tmp"
}

# sed_inplace <expression> <file> -- edit a file in place, portably.
#
# `sed -i` is not portable: BSD sed (macOS) requires an argument to -i and GNU
# sed (Linux CI) refuses one. The corpus wrote `sed -i ''`, which is correct on
# a Mac and fails on Ubuntu. Writing through replace_file sidesteps the
# divergence and is atomic besides, which matters when the file being rewritten
# is the project's version.
sed_inplace() {
  replace_file "$2" sed "$1" "$2"
}

# bump_semver <current> <major|minor|patch> -- print the next version.
#
# Byte-identical in all four projects. Bumping a part zeroes everything to its
# right, which is semver's rule rather than a preference.
bump_semver() {
  local current="$1" part="$2" major minor patch
  assert_semver "$current"
  IFS='.' read -r major minor patch <<EOF
$current
EOF
  case "$part" in
    major) printf '%d.0.0\n' "$((major + 1))" ;;
    minor) printf '%d.%d.0\n' "$major" "$((minor + 1))" ;;
    patch) printf '%d.%d.%d\n' "$major" "$minor" "$((patch + 1))" ;;
    *) die "invalid bump part '$part' (use major, minor or patch)" ;;
  esac
}

# semver_gt <a> <b> -- true when X.Y.Z <a> is greater than <b>, part by part,
# numerically (base 10, so a leading zero is not octal). 1 when it is not, and
# 2 when either is not X.Y.Z: "not greater" and "not a version" are different
# answers, and an ordering guessed from text would put 1.10.0 below 1.9.0.
semver_gt() {
  local a1 a2 a3 b1 b2 b3
  is_semver "${1:-}" && is_semver "${2:-}" || return 2
  IFS=. read -r a1 a2 a3 <<<"$1"
  IFS=. read -r b1 b2 b3 <<<"$2"
  if ((10#$a1 != 10#$b1)); then ((10#$a1 > 10#$b1)); return; fi
  if ((10#$a2 != 10#$b2)); then ((10#$a2 > 10#$b2)); return; fi
  ((10#$a3 > 10#$b3))
}

# abs_path <path> -- absolutise against the project root, leaving absolutes be.
#
# Present in two of four (Baize, Conflab) and PROMOTED by the WP-05 fold: it is
# four lines, has no dependencies, and the two projects that lacked it were
# simply the ones that had not needed it yet. A verdict line printing a relative
# path is not clickable in a terminal, which is the whole reason it exists.
abs_path() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "${PROJECT_ROOT:-.}" "$1" ;;
  esac
}

# read_version [file] [role] -- the project version, or `unknown`.
#
# THE DRIFT: three projects read a VERSION file; Laksa reads the version out of
# mix.exs. Neither is wrong -- an Elixir project's version genuinely lives in
# mix.exs, and duplicating it into a VERSION file would be two sources of truth.
#
# So the ruling is not "pick one" but "the file is config, the extraction is
# library". `project.version_from` names the file; the case below knows how to
# read each kind. That keeps the YAML declarative (D1: a name, not a recipe)
# while the knowledge of how a mix.exs states its version lives in code, where
# it can be tested.
#
# The roles mirror write_version_into's, and they scope the issue-0002 guard:
# with no arguments this reads the file `version_from` names, whose whole
# content IS the version by declaration -- second-guessing it turned a
# hand-authored `v1.2.3` into `unknown` (delta review, finding 9). An explicit
# <file> is a SIDECAR read unless <role> says `version-file`, and there the
# bare-version fallback is devbin GUESSING about a file kind it has no recipe
# for, which is exactly where the guard belongs.
#
# No newline, matching the corpus: callers interpolate it into their own format.
#
# shellcheck disable=SC2120  # the bare call IS the point: it selects the
# version-file role, which is the documented default above and not an omission.
# Callers that pass a <file> are reading a SIDECAR; both forms are real and
# in-file analysis cannot see the sidecar callers, which live in lib/cmd/version.
read_version() {
  local file="${1:-${DEVBIN_VERSION_FILE:-VERSION}}" role path v=""
  if [ $# -ge 1 ]; then role="${2:-sidecar}"; else role=version-file; fi
  case "$file" in
    /*) path="$file" ;;
    *) path="${PROJECT_ROOT:-.}/$file" ;;
  esac
  if [ -f "$path" ]; then
    case "${path##*/}" in
      mix.exs) v="$(awk -F'"' '/^ *version: *"/ { print $2; exit }' "$path" 2>/dev/null)" || v="" ;;
      Cargo.toml) v="$(awk -F'"' '/^version *= *"/ { print $2; exit }' "$path" 2>/dev/null)" || v="" ;;
      package.json) v="$(awk -F'"' '/"version" *:/ { print $4; exit }' "$path" 2>/dev/null)" || v="" ;;
      # Added by WP-17 so this stays the ONE reader. `version check` needs to
      # read a plist sidecar, and giving it its own extractor would put two
      # patterns on one file kind -- which is how a reader and a writer come to
      # disagree about which line they mean.
      *.plist)
        if [ -x /usr/libexec/PlistBuddy ]; then
          v="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$path" 2>/dev/null)" || v=""
        fi
        ;;
      # The bare-version default reads the WHOLE file, so a file devbin has no
      # recipe for yields its entire contents as the "version" -- a Cargo.lock
      # read back as `#Thisfileis@generatedbyCargo.version=3[[package]]...`,
      # which `version check` then reported as drift against every real version
      # forever (issue 0002). `unknown` is the honest answer and the one every
      # caller here already handles. SIDECAR reads only -- see the role note in
      # the header for why the version file itself reads raw.
      *)
        v="$(tr -d '[:space:]' <"$path" 2>/dev/null)" || v=""
        if [ "$role" = sidecar ]; then
          is_bare_version "$v" || v=""
        fi
        ;;
    esac
  fi
  [ -n "$v" ] || v=unknown
  printf '%s' "$v"
}

# sha256_files <file>... -- `<sum>  <path>` per file, in ONE process.
#
# The tool is spelled differently on the two platforms this ships to and neither
# name is universal: macOS has `shasum` and no `sha256sum`, a minimal Linux
# image usually has `sha256sum` and no perl to back `shasum`. Both accept many
# paths and both print `<sum>  <path>`, which is also the manifest's own line
# format -- so the batch form needs no reshaping at all.
#
# MANY files rather than one, because the caller is always checksumming a whole
# manifest. Per-file it was 26 forks per install and half the wall clock of the
# test suite, which runs an install per fixture.
# sha256_run [file]... -- THE one place that knows how this tool is spelled.
#
# EXTRACTED 2026-09-02 BECAUSE A SECOND COPY HAD ALREADY DIVERGED. `seam_digest`
# in the fleet command called `shasum -a 256` directly, and `shasum` is the name
# that does NOT exist on a minimal Linux image -- the exact case the comment
# below was written to cover. The knowledge was documented in one place and
# re-implemented in another: the Highlander failure in its ordinary form, not
# two algorithms but two copies of one DECISION, only one carrying the fix.
#
# Both tools read stdin when given no operands, which is what makes one dispatch
# serve the file case and the stream case.
sha256_run() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$@"
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  else
    die "no sha256 tool found (looked for shasum and sha256sum)"
  fi
}

sha256_files() {
  [ $# -gt 0 ] || return 0
  sha256_run "$@"
}

# sha256_stdin -- SHA256 of stdin, bare hex, no trailing path field.
#
# `sha256_files` deliberately refuses an empty argument list rather than falling
# through to this behaviour, and the two are separate names for that reason: a
# checksum of nothing is a valid-looking hex string that no downstream reader
# can distinguish from a checksum of something.
sha256_stdin() {
  sha256_run | cut -d' ' -f1
}

# cargo_target_dirs -- every cargo build tree under this project, discovered.
#
# NOT `$PROJECT_ROOT/target`, WHICH IS THE ASSUMPTION THIS FUNCTION EXISTS TO
# REPLACE. A cargo tree sits at the WORKSPACE root, and a workspace is very
# often nested: Laksa builds into `native/cli/target`, Intent into
# `native/rust/target`. A checker that looks only at the project root finds
# nothing on those estates, concludes nothing is wrong, and reports a clean
# result -- which is the same shape as the defect it was written to catch, and
# was the first draft of exactly that check.
#
# DELIBERATELY NOT SHARED WITH `_clean_roots`, and the reason is what each one
# is FOR rather than what each one does. Clean discovers trees it is about to
# DELETE, so it demands cargo's own markers (CACHEDIR.TAG, .rustc_info.json, a
# profile .fingerprint) before touching a directory that merely has the right
# name -- the cost of being wrong there is removing somebody's source tree. This
# only READS, across several languages' worth of layouts, and a directory named
# `target` holding an executable is the thing being asked about whether or not
# cargo has stamped it yet. Sharing one function would force one of those two
# risk postures onto the other.
#
# CARGO_TARGET_DIR wins outright when set: cargo writes there and nowhere else,
# so a discovered tree would be a stale one.
#
# DEPENDENCY TREES ARE PRUNED, AND THE POPULATION IS THE POINT (laksa/dc,
# 2026-09-02). Laksa carries five Cargo.toml files and exactly one is its own:
# the other four are Elixir NIF crates under `deps/`, built through mix by
# Rustler rather than by cargo in place. A caller asking "did MY build restore
# MY artefacts" must not be answered about somebody else's crate. If a dep ever
# does grow a `target/` -- somebody runs a bare `cargo build` in one for their
# own reasons -- the populated-debug-empty-release signature appears there with
# no cycle having caused it, and the check goes red on a tree the project's
# build never touches.
#
# A CHECK THAT CRIES WOLF ON FOUR TREES OUT OF FIVE GETS ITS OUTPUT IGNORED,
# which is the same end state as the vacuity it replaces, arrived at from the
# other direction. Same argument that killed the >1-test-target rule.
#
# Note what does NOT need pruning: a crate with no `target/` at all -- which is
# all four of Laksa's -- is invisible here by construction, because this
# discovers BUILD TREES and never crates. There is nothing to skip.
cargo_target_dirs() {
  if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    printf '%s\n' "${CARGO_TARGET_DIR%/}"
    return 0
  fi
  find "${PROJECT_ROOT:-.}" \
    \( -name .git -o -name node_modules -o -name .direnv \
       -o -name deps -o -name _build -o -name .venv \) -prune -o \
    -type d -name target -prune -print 2>/dev/null | sort
  return 0
}

# dir_has_binary <dir> -- true when <dir> holds at least one executable FILE at
# its top level, which is where cargo puts the binaries it builds.
#
# `-type f` and not `-e`: a cargo profile directory always exists once cargo has
# run in it, carrying `.fingerprint/`, `build/`, `deps/` and `incremental/`
# whether or not a single binary was produced. So "the directory is there" and
# "the artefacts are there" are different facts, and the first one is the
# reading that made a dev-profile cycle look complete.
dir_has_binary() {
  local d="$1" f
  [ -d "$d" ] || return 1
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    [ -x "$f" ] || continue
    return 0
  done
  return 1
}

# utc_from_epoch <epoch> -- an epoch second rendered `YYYY-MM-DD HH:MMZ`.
#
# THE TWO PLATFORMS SPELL THIS INCOMPATIBLY AND ONE OF THE SPELLINGS FAILS
# QUIETLY. BSD `date -r <epoch>` takes a NUMBER; GNU `date -r <file>` takes a
# FILE and wants `-d @<epoch>` for a number. Hand GNU an epoch and it errors to
# stderr and prints nothing, so the field goes EMPTY rather than wrong -- which
# is the safe direction and is still a column that silently stops existing on
# one platform.
#
# Reading order matters: BSD is tried first because GNU's `-r` would ACCEPT the
# argument as a filename and fail on it, while BSD's rejection of `-d @...` is
# clean. Both arms are guarded, so an unparseable value returns 1 rather than
# emitting a plausible-looking wrong time -- see the clock discipline in
# `/in-whiteboard`: a fabricated timestamp is indistinguishable from a real one.
utc_from_epoch() {
  local e="$1" out
  [ -n "$e" ] || return 1
  out="$(date -u -r "$e" +'%Y-%m-%d %H:%MZ' 2>/dev/null)" ||
    out="$(date -u -d "@$e" +'%Y-%m-%d %H:%MZ' 2>/dev/null)" || return 1
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# sha256_of <file> -- one file's SHA256, bare hex, or return 1.
#
# Built on sha256_files so the knowledge of which tool exists lives in exactly
# one place (IN-AG-HIGHLANDER-001).
sha256_of() {
  [ -f "$1" ] || return 1
  sha256_files "$1" | awk '{print $1}'
}

# --- the build's git identity (issue 0014) -------------------------------------
#
# Devbin owns the version-number axis completely -- `version_from`, the sidecars,
# `version sync` -- and owned nothing of the git one, so every project resolved
# "what commit is this build" for itself. hv ruled option B: devbin owns the half
# that is genuinely SHARED and gets independently wrong, and declares nothing
# about how a build system consumes it.
#
# THE READ IS THE HALF NOBODY GETS WRONG. All six Lamplight sites agreed on
# `git rev-parse --short HEAD` with `unknown` on failure. The INVALIDATION is
# where four of four went wrong, each by naming git's internals literally:
#
#     ../../.git/HEAD          ../../.git/refs/heads/
#
# In a linked worktree neither exists -- `.git` is a FILE reading `gitdir: ...`.
# The same unresolved path produced OPPOSITE symptoms, decided entirely by
# whether the toolchain fails open or closed on a path it cannot find: Elixir's
# `@external_resource` over an empty list registered no dependency and served a
# frozen sha for a working day; cargo could not stat its `rerun-if-changed` and
# treated the target as permanently dirty, rebuilding forever. The version that
# silently freezes and the version that silently rebuilds are the same bug, and
# only one of them ever gets reported -- which is why it is worth one home.
#
# These emit FACTS -- a string and a list of file paths -- and declare nothing.
# Each build system states its own dependency in its own vocabulary: cargo's
# `rerun-if-changed`, Elixir's `@external_resource`, a make prerequisite, a
# Dockerfile COPY. That is what makes one function serve four toolchains.

# git_head_sha [root] [short|full] -- the commit sha, or `unknown`.
#
# `unknown` rather than empty or a failure, because every caller in the corpus
# already handles that string and a build stamped with an empty version is worse
# than one stamped honestly as unresolved.
#
# The form is a PARAMETER rather than a second function, which is the whole
# point of this being issue 0014's one home: `git_head_sha_full` beside it would
# be two readers of one fact, free to disagree about the failure string the
# moment either is touched. `short` stays the default so every existing caller
# is unchanged.
git_head_sha() {
  local root="${1:-${PROJECT_ROOT:-.}}" form="${2:-short}" sha
  case "$form" in
    full) sha="$(git -C "$root" rev-parse HEAD 2>/dev/null)" || sha="" ;;
    *) sha="$(git -C "$root" rev-parse --short HEAD 2>/dev/null)" || sha="" ;;
  esac
  [ -n "$sha" ] || sha=unknown
  printf '%s\n' "$sha"
  return 0
}

# git_head_identity [root] -- `<full sha>`, `<full sha> +dirty`, or `unknown`.
#
# What a `--version` line should say about WHICH bytes are running. A bare sha
# on a dirty tree is a confident false statement: the binary in front of you is
# not that commit.
#
# IT SAYS `+dirty` AND NOT `THESE BYTES MATCH NO COMMIT`, AND THE DIFFERENT
# WORDING IS DELIBERATE RATHER THAN A DRIFTED COPY. `source_commit_of` in
# lib/install stamps that sentence, and it is making a narrower and stronger
# claim: the VENDORED FILE SET does not correspond to any commit, which is a
# statement about bytes somebody else will later read out of a manifest (issue
# 0033). This function answers a looser question -- the working tree it is
# standing in has uncommitted changes -- and borrowing the stronger sentence for
# it would put a provenance claim on a checkout that never made one. Two claims,
# two vocabularies, one producer each.
# platform_identity -- WHICH MACHINE produced this, as one line.
#
# THE NARROWING THAT COST THE FIRST TAGGED RELEASE (issue 0052), which names
# the version -- this file may not, and the guard that says so is right even
# here: a version literal in a source file is a hazard whether it is a claim or
# a citation. A local `test all`
# runs on one machine. Its seal is a true record of a macOS run, and nothing in
# the `.out`, the `.errors` or the summary named a platform -- so
# `824 tests, 0 failures` read as a fact about devbin when it was a fact about
# one OS. CI had been red on Ubuntu for six days and three pushes, one of them
# the release, and the release note's Verified section was assembled from those
# local seals. The instrument was sound and aimed one unit wide, and the output
# said nothing about which unit.
#
# BASH IS IN IT ALONGSIDE uname, and not for symmetry: bash >= 5 is this
# project's floor (issue 0022) and macOS ships 3.2.57 at /bin/bash, so "which
# bash" is a real axis on which two runs of the same code differ. The two
# together are what distinguishes a green anyone can rely on from a green about
# one machine.
#
# It says nothing about the analyser versions that were 0052's OTHER narrowing.
# Those are a property of a gate's TOOL rather than of the run, and pinning
# them is the analyser's own job -- .github/install-shellcheck.sh does it by
# asserting the version it installed. Claiming them here would be devbin
# reporting a fact it did not establish.
platform_identity() {
  printf '%s / bash %s' "$(uname -srm 2>/dev/null || printf 'unknown')" \
    "${BASH_VERSION:-unknown}"
}

# runtime_digest <launcher> <libdir> -- SHA256 of the RUNTIME BYTES, 12 hex.
#
# THE ONE HOME FOR "WHICH BYTES ARE THESE", and it now has two readers: the
# `--version` line here, and `fleet`'s per-estate seam digest, which had this
# computation written out inside it. Two copies of a fingerprint is the worst
# duplication available -- when they drift, the two surfaces report different
# identities for one tree and neither says which is authoritative.
#
# A STAMP IS NOT AN IDENTITY. `git_head_identity` below answers "which commit
# was this checkout on", which is a different question and can be `<sha> +dirty`
# -- a value that names no bytes at all. This answers the one a reader comparing
# two installs actually has: are these the same runtime.
#
# PATHS ARE FOLDED IN RELATIVE TO THE LIB DIRECTORY, not to a project root, and
# the choice is load-bearing. It makes a source checkout (`lib/helpers`) and an
# install of it (`bin/.devbin/lib/helpers`) digest IDENTICALLY when the bytes
# match, which is the comparison anyone re-vendoring actually wants. Folding
# against a root would have made every install differ from its own source by
# construction, and the difference would have looked like divergence.
#
# The paths go in ALONGSIDE the contents so a moved or missing file changes the
# digest rather than hiding inside a concatenation.
runtime_digest() {
  local launcher="$1" libdir="$2" f
  {
    cat "$launcher" 2>/dev/null
    find "$libdir" -type f 2>/dev/null | sort | while IFS= read -r f; do
      printf '%s\n' "${f#"$libdir"/}"
      cat "$f"
    done
  } | sha256_stdin | cut -c1-12
}

# version_identity [root] -- the ONE renderer for `<name> <version> (<tree>)`.
#
# TWO CALL SITES ASK THE SAME QUESTION AND BEFORE 2026-09-01 THEY ANSWERED IT
# DIFFERENTLY. `bin/devbin --version` printed the name, the version and the
# tree's commit; `bin/devbin version` printed the name and the version alone.
# Same question, one tree, two answers, and nothing in either output said which
# one was the whole story -- found by hv running both in devbin's own checkout,
# where the project IS devbin so the disagreement had nowhere left to hide.
#
# It is a Highlander violation of the ordinary kind: not duplicated logic, but
# duplicated RENDERING, which is the copy that drifts without anyone noticing
# because each site reads correct on its own. The fix is this function and the
# rule that no third site prints this line itself.
#
# `version show` deliberately does NOT come through here. It is the machine
# arm -- a bare number for scripting -- and giving it provenance would break
# every line-oriented reader that consumes it.
version_identity() {
  local root="${1:-${PROJECT_ROOT:-.}}"
  # shellcheck disable=SC2119  # the bare call IS the point: version-file role.
  # This directive travelled here WITH the call. It used to sit in bin/devbin
  # above the printf that moved into this function, and leaving it behind is
  # what reddened lint on the first run of this change -- a suppression is
  # part of its call site, not of the file it was written in.
  # TWO FIELDS BECAUSE THEY ANSWER TWO QUESTIONS AND ONE OF THEM CAN BE EMPTY
  # OF MEANING. The commit says where this checkout stood; on a dirty tree it
  # says `+dirty`, which names no bytes at all and is exactly when a reader most
  # needs an identity. `runtime` is that identity: the same twelve hex `fleet`
  # reports per estate, so `--version` here and a row in the fleet table can be
  # compared directly without either side deriving anything.
  #
  # NOT CALLED `tree`. hv's ruling used that word and it is the wrong one for
  # this value: `tree` is a git object, a reader meeting it would go looking for
  # one, and would not find it -- a wrong mechanism in a provenance line is
  # actionable in the wrong direction. Rename it if the git object was meant.
  printf '%s %s (%s, runtime %s)\n' "${DEVBIN_NAME:-devbin}" "$(read_version)" \
    "$(git_head_identity "$root")" \
    "$(runtime_digest "$root/bin/devbin" "${DEVBIN_LIB:-$root/lib}")"
}

git_head_identity() {
  local root="${1:-${PROJECT_ROOT:-.}}" sha
  sha="$(git_head_sha "$root" full)"
  if [ "$sha" = unknown ]; then
    printf 'unknown\n'
    return 0
  fi
  if [ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]; then
    printf '%s +dirty\n' "$sha"
  else
    printf '%s\n' "$sha"
  fi
  return 0
}

# _git_path <root> <name> -- `git rev-parse --git-path <name>`, made ABSOLUTE,
# printed only when it names a file that exists. Returns 1 otherwise.
#
# THE ABSOLUTISING IS NOT TIDINESS, AND A TEST FOUND IT. `--git-path` answers
# RELATIVE in a normal checkout (`.git/HEAD`) and ABSOLUTE in a linked worktree,
# where the gitdir is somewhere else entirely. So a caller doing `[ -f "$p" ]`
# from any other directory -- which a build script always is -- resolves
# everything in the worktree case and NOTHING in the ordinary one. That is the
# exact inverse of the bug this whole function exists to fix, and it would have
# shipped looking right: every hard test passed and the easy one failed.
_git_path() {
  local root="$1" p
  p="$(git -C "$root" rev-parse --git-path "$2" 2>/dev/null)" || return 1
  [ -n "$p" ] || return 1
  case "$p" in
    /*) ;;
    *) p="$root/$p" ;;
  esac
  [ -f "$p" ] || return 1
  printf '%s\n' "$p"
  return 0
}

# git_head_watch_paths [root] -- every EXISTING file whose mtime tracks HEAD,
# one absolute path per line. Returns 1, loudly, when it resolves none.
#
# `git rev-parse --git-path` is the whole trick: git already knows about worktree
# indirection, the common directory and the loose/packed question, and answers
# with a real path. Three separate layout rules that a hand-rolled implementation
# has to get right independently, and did not.
#
# THREE PATHS, EACH FOR A DIFFERENT EVENT:
#
#   HEAD          changes on checkout, and on every commit when detached
#   the branch    what actually moves on a commit -- and it lives in the COMMON
#                 directory, not the worktree's gitdir, because a worktree's own
#                 HEAD holds `ref: refs/heads/<x>` and that string never changes
#   packed-refs   `git pack-refs` DELETES the loose ref file, so a branch living
#                 only here drops out of any watch set built from loose paths
#
# THE EMPTY LIST IS THE FAILURE THAT MATTERS, AND IT IS CREATED BY THIS FIX.
# Before it, a broken watch meant "always rebuild" -- a cost, not a visible
# defect. Restoring a working watch restores CACHING, so an enumeration that
# quietly returned nothing would turn a slow-but-correct build into a fast and
# possibly wrong one. Same rule as a gate that examines nothing: empty-and-
# successful is the one answer that must not be available.
git_head_watch_paths() {
  local root="${1:-${PROJECT_ROOT:-.}}" ref n=0
  if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    _git_path "$root" HEAD && n=$((n + 1))
    ref="$(git -C "$root" symbolic-ref -q HEAD 2>/dev/null)" || ref=""
    if [ -n "$ref" ]; then
      _git_path "$root" "$ref" && n=$((n + 1))
    fi
    _git_path "$root" packed-refs && n=$((n + 1))
  fi
  if [ "$n" -eq 0 ]; then
    warn "git_head_watch_paths: resolved NO files to watch under $root"
    warn "  a build baking the sha would never refresh it -- do not cache on an empty watch set"
    return 1
  fi
  return 0
}

# assert_identifier <value> <what> -- refuse a value that cannot be a shell
# variable name, or that would clobber one the shell needs.
#
# Devbin turns three CONFIG VALUES into variable names: `project.root_var`,
# `options.<name>.export`, and `<NAME>_ROOT` derived from `project.name`. The
# config KEY charset is validated by the parser; these values were not, and the
# failure was raw and unlocated -- a space in any of them produced bash's own
# `export: not a valid identifier`, with no `config:` prefix and no file, which
# is well below the bar D7 sets for every other malformed-config message.
#
# The reserved list is short and only holds names whose loss breaks the run
# itself. `root_var: PATH` was the worst case found: the export succeeds, the
# handler exec then fails with `env: bash: No such file or directory` and exit
# 127, and nothing in that message points anywhere near the config that caused
# it. Refusing beats diagnosing.
# is_identifier <value> -- true when <value> is a shell variable name: a letter
# or underscore, then letters, digits and underscores. THE ONE DEFINITION, and
# it is a predicate rather than a refusal because its two callers refuse
# differently: assert_identifier dies with a message naming which rule the value
# broke, and run_words warns and returns, since nothing in the release library
# may die. The charset lived only inside assert_identifier until run_words
# needed the same question (issue 0082), and a second spelling of "is a name"
# is exactly the divergence Highlander is about.
is_identifier() {
  case "${1:-}" in
    '' | [!A-Za-z_]* | *[!A-Za-z0-9_]*) return 1 ;;
  esac
  return 0
}

assert_identifier() {
  local value="${1:-}" what="${2:-value}"
  # is_identifier gives the VERDICT; the case below only chooses the sentence,
  # which is why it no longer has a rule the predicate does not have.
  if ! is_identifier "$value"; then
    case "$value" in
      '') die "$what is empty -- it has to be a shell variable name" ;;
      [!A-Za-z_]*) die "$what must start with a letter or underscore, got '$value'" ;;
      *) die "$what may contain only letters, digits and underscore, got '$value'" ;;
    esac
  fi
  case "$value" in
    PATH | IFS | HOME | PWD | OLDPWD | SHELL | BASH_ENV | ENV | LD_PRELOAD | LD_LIBRARY_PATH)
      die "$what must not be '$value' -- overwriting it breaks the commands devbin runs"
      ;;
    # devbin's OWN environment, enumerated rather than matched as `DEVBIN_*`.
    # The wildcard was the first thing tried and it broke Devbin itself inside a
    # minute: this project is called `devbin`, so its derived root variable is
    # `DEVBIN_ROOT` -- a legitimate name devbin does not use, refused by a
    # pattern aimed at names it does. Devbin uses devbin (D12), so the guard's
    # own overreach failed here before it could reach a live project.
    #
    # EVERY NAME THE DISPATCHER EXPORTS TO A HANDLER, and a pattern only for the
    # two families whose names it composes. The list is a copy of exports that
    # live in bin/devbin and lib/resolve, so it drifts each time one is added: it
    # fell six names and DEVBIN_ACTIVE_* behind, and root_var overwrote the run
    # id, the stamp, the referent and the cli task with the project root, rc 0
    # (issue 0081). tests/unit/review.bats now holds it to the names a handler
    # receives. DEVBIN_TREEINDEX_DIRS left it when its export did (issue 0032).
    DEVBIN_NAME | DEVBIN_INVOKE | DEVBIN_LIB | DEVBIN_DIR | DEVBIN_ROOT_VAR | DEVBIN_COMMAND | DEVBIN_ARGS | \
      DEVBIN_SEAL_LEDGER | DEVBIN_SEAL_LEDGER_RUN | DEVBIN_RUN_ID | DEVBIN_RUN_STAMP | DEVBIN_RUN_WITNESS | \
      DEVBIN_RUN_REFERENT | DEVBIN_CLI_TASK | DEVBIN_VERSION_FILE | DEVBIN_VERSION_SIDECARS | DEVBIN_LANGUAGES | \
      DEVBIN_FMT_ARMS | DEVBIN_ACTIVE_* | DEVBIN_OPT_* | PROJECT_ROOT | BIN_DIR)
      die "$what must not be '$value' -- that name belongs to devbin's own environment"
      ;;
  esac
  return 0
}

# is_semver <value> -- true for MAJOR.MINOR.PATCH, digits only. The one test;
# assert_semver dies on it, and release reads a target through it.
is_semver() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# assert_semver <version> -- refuse anything that is not X.Y.Z.
#
# The corpus put each project's own current version in the error message, which
# is why four copies existed at all. The example is generic here; the value the
# caller passed is what the reader actually needs to see.
assert_semver() {
  is_semver "${1:-}" ||
    die "version must be semver (eg 1.2.3), got '${1:-}'"
}

# is_handler <path> -- true when <path> is a runnable handler: a REGULAR file
# carrying the execute bit.
#
# `-x` ALONE IS TRUE FOR A DIRECTORY, and the corpus keeps directories exactly
# where handlers live. Lamplight's `lamplight_macos.d/pkg` is a directory of
# packaging resources sitting beside the real sub-handlers, so `macos pkg`
# descended into it and exec'd it: a raw bash "Is a directory" naming an
# internal library path, exit 126, and the handler never reached (issue 0005).
#
# One predicate for every site that asks "can I run this", so a second place
# cannot keep the old answer. Lives here because the question has no
# dependencies, which is what D15 requires of this file.
is_handler() {
  [ -f "$1" ] && [ -x "$1" ]
}

# is_bare_version <string> -- true when <string> is a lone version and nothing
# else: it starts with a digit and carries only characters a version carries.
#
# DELIBERATELY LOOSER THAN assert_semver, and not a substitute for it. This
# guards the bare-version DEFAULT -- the branch that reads or writes a whole
# file as though the file were nothing but a version. Its question is "is this
# a version string at all", not "is this project's numbering well-formed", so
# `0.6.0-rc1`, `1.4` and `20260808` all pass. assert_semver still polices what a
# caller may SET.
#
# Both the reader and the writer ask this one predicate, which is the point: a
# reader and a writer that disagree about which files they mean is the exact
# mechanism `lib/cmd/version`'s own comment was written to prevent, and issue
# 0002 was the two of them agreeing on the wrong answer.
is_bare_version() {
  case "${1:-}" in
    [0-9]*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[!0-9A-Za-z.+-]*) return 1 ;;
  esac
  return 0
}

# rlwrap_exec <completions> <history> [--] <cmd> [args...] -- exec under rlwrap.
#
# Byte-identical in all four projects. Missing rlwrap degrades to a plain exec
# with a warning rather than failing: losing history is an inconvenience,
# refusing to start a REPL is an outage.
#
# `opts` is a plain indexed array, which bash 3.2 has (design D9 -- since
# reversed by issue 0022 -- ruled out only
# the ASSOCIATIVE arrays of bash 4). It is never empty at expansion, so it needs
# none of the `${a[@]+...}` guarding parse_common_opts does.
rlwrap_exec() {
  local completions="$1" history="$2"
  shift 2
  [ "${1:-}" = "--" ] && shift
  if command -v rlwrap >/dev/null 2>&1; then
    local opts
    opts=(-r -c -H "$history" -s 2000)
    if [ -n "$completions" ] && [ -f "$completions" ]; then
      opts=(-f "$completions" "${opts[@]}")
    fi
    exec rlwrap "${opts[@]}" "$@"
  fi
  warn "rlwrap not found -- no history or tab completion (try: brew install rlwrap)"
  exec "$@"
}

# ============================================================================
# GENERATED DOCUMENTATION, AND THE FIVE REFUSALS THAT MAKE IT SAFE
# ============================================================================
#
# generated_doc_write --target FILE --begin MARKER --end MARKER \
#   [--deny-env VAR]... [--expect-lines N] [--expect-contains STR]... \
#   -- <producer> [args...]
#
# Replace the region between two markers in FILE with what <producer> writes to
# stdout, or refuse and leave FILE untouched.
#
# WHY THIS IS HERE AND NOT IN A COMMAND. Four estates independently needed to
# generate the factual half of a database runbook from live probes. The obvious
# read is that the PROVIDER CODE is the shared thing, which would put a fly.io
# opinion inside devbin and break the rule at lib/cmd/db:16. That read is wrong.
# The fly verbs are ninety lines, cheap to write and trivial to verify because
# you can just run them; what actually cost a measured incident is the
# DISCIPLINE of writing a generated file safely. So devbin owns the discipline
# and every project keeps its own producer. A Neon estate writes a Neon producer
# and none of this changes (issue 0028; conflab/vc, relayed by lamplight/vc).
#
# It is a HELPER rather than a command, which is what keeps the surface honest:
# no catalogue row, no opt-in cell, no `@builtin`, and no config schema key --
# so it costs devbin no new mechanism at all. The layering rule decides the
# home: needs config, belongs in resolve; needs nothing, belongs here (D15).
#
# WHAT DEVBIN MUST NOT LEARN, and does not: what a cluster is, what a connection
# pooler is, that `--json` exists on anything, or that the output is Markdown.
# The markers are opaque delimiters and are REQUIRED rather than defaulted --
# any default would encode a comment syntax, and a framework that ships
# `<!-- ... -->` has quietly decided its consumers write HTML.
#
# It WARNS and RETURNS rather than dying, because a caller generating several
# documents must not lose the rest of them to the first refusal.
generated_doc_write() {
  local target="" begin="" end="" expect_lines=0
  local block nb ne bl el v s n
  local -a deny=() expect_contains=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --target) shift; target="${1:-}" ;;
      --target=*) target="${1#*=}" ;;
      --begin) shift; begin="${1:-}" ;;
      --begin=*) begin="${1#*=}" ;;
      --end) shift; end="${1:-}" ;;
      --end=*) end="${1#*=}" ;;
      --deny-env) shift; deny+=("${1:-}") ;;
      --deny-env=*) deny+=("${1#*=}") ;;
      --expect-lines) shift; expect_lines="${1:-0}" ;;
      --expect-lines=*) expect_lines="${1#*=}" ;;
      --expect-contains) shift; expect_contains+=("${1:-}") ;;
      --expect-contains=*) expect_contains+=("${1#*=}") ;;
      --) shift; break ;;
      *) die "generated_doc_write: unknown option '$1' (the producer goes after --)" ;;
    esac
    shift
  done

  # Usage errors DIE: they are the caller's bug and no run of this is correct.
  # The five refusals below WARN, because they are facts about the world.
  [ -n "$target" ] || die "generated_doc_write: --target is required"
  [ -n "$begin" ] || die "generated_doc_write: --begin marker is required"
  [ -n "$end" ] || die "generated_doc_write: --end marker is required"
  [ $# -gt 0 ] || die "generated_doc_write: no producer given (put it after --)"

  if [ ! -f "$target" ]; then
    warn "generated_doc_write: $target does not exist -- this regenerates a region of a hand-authored file, it does not create one"
    return 1
  fi

  # R4 -- THE HAND-AUTHORED HALF SURVIVES. Everything outside the markers is
  # copied through untouched, including both marker lines. Regeneration must
  # never eat judgement: a probe can report a pooler's port and cannot report
  # that changing it needs the owner's say-so.
  #
  # Exactly one of each marker, in order, or refuse. Two begins is ambiguous
  # about which region is generated, and guessing is how a generator eats the
  # wrong half of a file.
  nb="$(grep -c -F -- "$begin" "$target" 2>/dev/null || true)"
  ne="$(grep -c -F -- "$end" "$target" 2>/dev/null || true)"
  if [ "${nb:-0}" -ne 1 ] || [ "${ne:-0}" -ne 1 ]; then
    warn "generated_doc_write: $target must contain each marker exactly once (found begin=${nb:-0} end=${ne:-0}) -- untouched"
    return 1
  fi
  bl="$(awk -v m="$begin" 'index($0, m) { print NR; exit }' "$target")"
  el="$(awk -v m="$end" 'index($0, m) { print NR; exit }' "$target")"
  if [ "$bl" -ge "$el" ]; then
    warn "generated_doc_write: $target has its end marker at line $el, before or at the begin marker at line $bl -- untouched"
    return 1
  fi

  # R2 -- NEVER WRITE FROM A FAILED MEASUREMENT. A producer that could not
  # measure exits non-zero and the target is left alone. This is the
  # determinate-zero doctrine in prose: a document assembled from failed probes
  # is worse than a stale one, because it looks freshly generated. Measured --
  # an estate captured psql ERROR TEXT into a runbook and then reported counts
  # off it, which is a refuted inference wearing the format of a measurement.
  if ! block="$("$@")"; then
    warn "generated_doc_write: the producer exited non-zero -- $target left untouched"
    return 1
  fi
  if [ -z "$block" ]; then
    warn "generated_doc_write: the producer wrote nothing -- $target left untouched"
    return 1
  fi

  # R1 -- NEVER INLINE A SECRET, ENFORCED MECHANICALLY rather than by review.
  # Exact value matching, no entropy heuristics. Measured twice: a hand-edit
  # replaced a username in six places and left the old password beside it, which
  # authenticates as a rotation failure and reads like a platform problem; and a
  # cleanup step was about to fold a live credential into a runbook.
  for v in ${deny[@]+"${deny[@]}"}; do
    # UNSET OR EMPTY IS ITSELF A REFUSAL, and the message must say so. An unset
    # variable makes the check below compare against the empty string, which
    # every block contains -- so the naive version refuses, correctly, and
    # reports a leak. There was none. That is a wrong recorded reason, which is
    # worse than no reason: it sends the reader hunting a credential leak in a
    # file that is fine, and the real fault (a guard pointed at a variable that
    # is not there) goes unread. Driven red before this branch existed.
    if [ -z "${!v:-}" ]; then
      warn "generated_doc_write: --deny-env $v is unset or empty, so there is no value to search for -- $target left untouched. A secret guard that cannot see its secret must not pass, and has not."
      return 1
    fi
    case "$block" in
      *"${!v}"*)
        warn "generated_doc_write: \$$v's value appears in the generated block -- $target left untouched. Use env indirection in the producer's output (postgresql://user:\$$v@host) rather than the value."
        return 1
        ;;
    esac
  done

  # R5 -- VALIDATE THE ARTEFACT, NOT THE EXIT PATH. A producer exiting 0 says it
  # ran; it does not say it produced the document. The expectation is the
  # producer's own declaration of what sufficient output looks like, which is
  # why there is no built-in threshold here to guess wrong.
  if [ "$expect_lines" -gt 0 ]; then
    n="$(printf '%s\n' "$block" | wc -l | tr -d ' ')"
    if [ "$n" -lt "$expect_lines" ]; then
      warn "generated_doc_write: the block is $n line(s), fewer than the $expect_lines declared -- $target left untouched"
      return 1
    fi
  fi
  for s in ${expect_contains[@]+"${expect_contains[@]}"}; do
    case "$block" in
      *"$s"*) ;;
      *)
        warn "generated_doc_write: the block does not contain the declared '$s' -- $target left untouched"
        return 1
        ;;
    esac
  done

  # R3 -- ATOMIC REPLACE, through replace_file above: the temporary beside the
  # target (a temp under /tmp renaming onto a project path can fail
  # cross-device), the target's mode, the rename, and the temporary removed on
  # a failure it returns -- the comment above stage_beside names the two ways
  # one can still be left.
  #
  # What this gives and does NOT give: the reader sees the old file or the new
  # one and never a half-written one. It is not a durability guarantee -- shell
  # has no portable fsync, so a machine losing power at the wrong moment may
  # have neither. Atomicity is the property that matters here, and claiming the
  # other one would be the wrong kind of confident.
  if ! replace_file "$target" _generated_doc_assemble "$target" "$bl" "$el" "$block"; then
    warn "generated_doc_write: $target left untouched"
    return 1
  fi
  return 0
}

# _generated_doc_assemble <target> <begin-line> <end-line> <block> -- the new
# document on stdout: the target through its begin marker, the block, and the
# target from its end marker on.
_generated_doc_assemble() {
  awk -v n="$2" 'NR <= n' "$1" && printf '%s\n' "$4" && awk -v n="$3" 'NR >= n' "$1"
}

# MOVED HERE FROM lib/install AT THE UPDATE-NOTICE CHANGE. The dispatcher
# needs to read two manifest header lines on every invocation, and it does
# NOT source lib/install -- deliberately, because the install machinery has
# no business on the hot path of a launcher that runs on every command. The
# alternative was a second manifest reader in the dispatcher, which is the
# Highlander breach this project names first. lib/install sources this file
# and calls them unchanged.
DEVBIN_MANIFEST_REL="bin/.devbin/manifest.sha256"

manifest_path() { printf '%s\n' "$1/$DEVBIN_MANIFEST_REL"; }

# manifest_field <root> <field> -- read one `# <field>: <value>` header line.
manifest_field() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 1
  awk -v f="$2" '
    $0 !~ /^#/ { exit }
    {
      line = $0
      sub(/^#[[:space:]]*/, "", line)
      if (line ~ ("^" f ":")) {
        sub("^" f ":[[:space:]]*", "", line)
        sub(/[[:space:]]+$/, "", line)
        print line
        exit
      }
    }
  ' "$path"
}

manifest_version() { manifest_field "$1" devbin_version; }
manifest_source_commit() { manifest_field "$1" source_commit; }

# home_relative <path> -- <path> with a leading $HOME written as `~`.
# home_expand <value> -- the inverse: `~` and `~/<rest>` expanded against $HOME.
#
# ONE DEFINITION OF THE `~` FORM, IN BOTH DIRECTIONS, WHERE THERE WERE FOUR
# (issue 0069). `install_prefix_configured` expanded a config value, `fleet doc`
# wrote its paste line one way and its roots another, and the manifest's source
# needed both directions -- each with its own copy. They disagreed about exactly
# the two edges below, and the roots were written into a tracked document with
# no conversion at all.
#
# AN EMPTY HOME ENCODES NOTHING AND EXPANDS NOTHING. With HOME empty, "$HOME/"
# is "/", which every absolute path starts with: the writer would record
# `~/Users/...` and the reader would expand `~/opt` to `/opt`, a real directory
# that is not the one meant -- and a publish would write into it. Verbatim is
# refused downstream BY NAME; a wrong absolute path is not. A HOME of `/` trims
# to empty and is treated the same way.
#
# THE PREFIX TEST IS "$home"/ AND NEVER "$home" ALONE. `/x/Devbi` is a string
# prefix of `/x/Devbin` and not its parent, and stripping it would write `~n`.
#
# SC2088 IS WRONG FOR BOTH, and each directive sits where it applies. The `~` is
# a CHARACTER in a value -- a config scalar, a manifest line, a line of a
# document someone pastes into their own shell -- and the whole point is that it
# did not expand. In `home_expand` the directive sits on the `case` and not on a
# branch: SC1124 refuses one in front of an individual case item, and putting it
# there does not merely fail to suppress -- it makes the whole expression
# unparseable, so every later check in the file is silently skipped. Measured,
# not assumed (moved here from `install_prefix_configured` with the code).
home_relative() {
  local path="$1" home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ]; then
    case "$path" in
      "$home")
        printf '%s\n' '~'
        return 0
        ;;
      "$home"/*)
        # shellcheck disable=SC2088
        printf '%s\n' "~/${path#"$home"/}"
        return 0
        ;;
    esac
  fi
  printf '%s\n' "$path"
}

home_expand() {
  local v="$1" home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ]; then
    # shellcheck disable=SC2088
    case "$v" in
      '~') v="$home" ;;
      '~/'*) v="$home/${v#'~/'}" ;;
    esac
  fi
  printf '%s\n' "$v"
}

# manifest_source <root> -- the recorded source, as the absolute path it names.
#
# RECORDED THROUGH home_relative, READ THROUGH home_expand (issue 0069). The
# manifest is tracked in the estates that vendor devbin, several of them public,
# and an absolute source put the operator's home directory -- and with it their
# login name -- into every one, rewritten on every upgrade so no scrub survived.
# Every reader comes through here and still gets the absolute path it always
# got. A manifest written before the change carries an absolute value, which
# reads back as it is until that estate's next upgrade.
manifest_source() {
  local v
  v="$(manifest_field "$1" source)" || return 1
  home_expand "$v"
}

# _devbin_source_head <srcroot> -- the commit the SOURCE currently holds.
#
# rc 0 with a bare sha, or rc 2 when it cannot be told. NO THIRD ANSWER: an
# empty success would be read as "level" by every caller, and "cannot tell" and
# "no change" are the two things this file exists to keep apart.
#
# TWO KINDS OF SOURCE, TWO INSTRUMENTS (ST0005). Until the machine install
# existed a source was always a git checkout, so `git rev-parse HEAD` was the
# only question worth asking. An INSTALL is not a checkout -- it has no .git at
# all -- and asking git returns nothing, which this function's caller correctly
# treated as "say nothing".
#
# MEASURED, NOT ANTICIPATED. The same consumer, at the same staleness, with one
# field changed: pointed at the dev tree the notice SPOKE, pointed at the install
# it went SILENT. So repointing the estate at the install -- which is the entire
# job of ST0005 WP-03 -- would have turned off the update notice on every
# project at once, and the failure is invisible because silence is this notice's
# ordinary state.
#
# An install's own manifest already records the commit it was cut from, under
# the dirty gate, so it is the authority for what that install holds. `kind:`
# is READ rather than the shape being inferred, which is why that header exists.
_devbin_source_head() {
  local src="${1:-}" kind sha
  [ -n "$src" ] || return 2
  [ -d "$src" ] || return 2

  kind="$(manifest_field "$src" kind 2>/dev/null || true)"
  if [ "$kind" = install ]; then
    sha="$(manifest_field "$src" source_commit 2>/dev/null || true)"
  else
    sha="$(git -C "$src" rev-parse HEAD 2>/dev/null)" || return 2
  fi

  # Same normalisation as the recorded side, and for the same reason: the field
  # can carry `<sha> +dirty -- ...` or words instead of a sha. Compared whole,
  # those can never be equal to anything, so the notice would fire forever.
  sha="${sha%% *}"
  is_commit_sha "$sha" || return 2
  printf '%s\n' "$sha"
  return 0
}

# --- which way the source moved -------------------------------------------------
#
# MOVED HERE FROM lib/install (issue 0079). upgrade and vendor asked this and
# the update notice, the offer and doctor did not: they compared two shas for
# equality and called any difference "behind", so a source BEHIND the project
# was offered as an update. The dispatcher loads lib/helpers and not lib/install
# before it offers, so the one direction reader has to live where every asker
# can reach it. install_ancestry, the PUBLISH half that writes the table, stays
# in lib/install.

# source_direction <dstroot> <srcroot> -- which way the source has moved since
# these bytes were vendored:
#
#   same       the source is exactly the commit that was vendored
#   forward    the recorded commit is an ancestor of the source's HEAD
#   backward   the source's HEAD is an ancestor of the recorded commit
#   unrelated  neither contains the other -- a different history
#   unknown    the question cannot be answered from what is on disk
#
# UNKNOWN IS A REAL ANSWER AND MUST NEVER BE READ AS `forward`. There are four
# ways to reach it and none of them is exotic: the field is ABSENT on a manifest
# written before b433988, it is PROSE when the source was not a checkout, it
# carries `+dirty` when the bytes matched no commit, and a fresh clone may
# simply not HAVE the recorded commit. Collapsing any of those into "fine" is
# the direction that costs something -- upgrade syncs from source
# unconditionally, so a downgrade prints `updated` per file and leaves doctor
# green (issue 0021, measured at 11 files).
#
# Reads git in the SOURCE only. The target may not be a checkout at all, and
# whether it is has no bearing on which devbin it received.
#
# AN INSTALL SOURCE IS ANSWERED FROM ITS ANCESTRY TABLE (issue 0059). An install
# is not a git repository, so asking git there answered `unknown` for every
# project vendoring from one -- the whole estate -- and `unknown` was silent. The
# history the question needs was in the checkout the install was PUBLISHED
# from, so that is where it is asked; see install_ancestry.
#
# `+dirty` IS `unknown`, AS THE FIRST PARAGRAPH SAYS -- and until 0059's review
# the code did not do it. It took the first word and compared the sha, so bytes
# vendored from `C` plus uncommitted work read `same` against a source holding
# `C`, and upgrade dropped the work with no direction line. Measured by
# critic-shell on 2026-09-16. The sha names where the bytes STARTED, not what
# they are, so no direction follows from it.
source_direction() {
  local dstroot="$1" srcroot="$2" rec
  rec="$(manifest_source_commit "$dstroot" 2>/dev/null || true)"
  case "$rec" in *' +dirty'*) printf 'unknown\n'; return 0 ;; esac
  # The recorded value is a LINE, not a field: `<sha>` or a whole sentence.
  # Taking the first word reduces both to something that either is a sha or
  # visibly is not.
  rec="${rec%% *}"
  is_commit_sha "$rec" || { printf 'unknown\n'; return 0; }

  if [ "$(manifest_field "$srcroot" kind 2>/dev/null || true)" = install ]; then
    install_direction "$srcroot" "$rec"
    return 0
  fi
  commit_direction "$srcroot" "$rec"
}

# is_commit_sha <word> -- true when <word> can name a commit: lowercase hex, at
# least seven characters.
#
# ONE CHECK, because three copies of it had already drifted by the time 0059's
# review read them: one dropped the length test. The length test is not
# redundant with the charset one -- `a checkout with no HEAD` reduces to `a` by
# first word, and `a` is valid hex.
is_commit_sha() {
  case "$1" in '' | *[!0-9a-f]*) return 1 ;; esac
  [ "${#1}" -ge 7 ]
}

# commit_direction <checkout> <sha> [<to>] -- which way <to> (default: the
# checkout's HEAD) has moved from <sha>: `same`, `forward`, `backward`,
# `unrelated` or `unknown`.
#
# The git half of source_direction, separate because a PUBLISH asks the same
# question of every commit an install has held (install_ancestry), and the
# release core asks it of a remote's branch head (release_read_remote, which is
# why <to> exists). Two copies of the ancestry rules would be two answers to
# one question -- updatenotice.bats holds this as the only place ancestry is
# asked.
commit_direction() {
  local srcroot="$1" rec="$2" head
  git -C "$srcroot" rev-parse --git-dir >/dev/null 2>&1 ||
    { printf 'unknown\n'; return 0; }
  head="$(git -C "$srcroot" rev-parse -q --verify "${3:-HEAD}^{commit}" 2>/dev/null)" || head=""
  [ -n "$head" ] || { printf 'unknown\n'; return 0; }
  # ASKED BEFORE THE ANCESTRY TESTS, because `merge-base --is-ancestor` returns
  # 1 both for "not an ancestor" and for a commit this repository has never
  # heard of, and those are `unrelated` and `unknown` respectively.
  git -C "$srcroot" cat-file -e "$rec^{commit}" 2>/dev/null ||
    { printf 'unknown\n'; return 0; }

  case "$head" in "$rec"*) printf 'same\n'; return 0 ;; esac
  if git -C "$srcroot" merge-base --is-ancestor "$rec" "$head" 2>/dev/null; then
    printf 'forward\n'
  elif git -C "$srcroot" merge-base --is-ancestor "$head" "$rec" 2>/dev/null; then
    printf 'backward\n'
  else
    printf 'unrelated\n'
  fi
  return 0
}

# manifest_ancestry <root> -- the ancestry table as `<sha><TAB><direction>` lines.
#
# Read by its own reader rather than manifest_field, which returns ONE value per
# key and this key repeats. Header lines only: the table ends where the header
# does, exactly as manifest_field's does.
manifest_ancestry() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 0
  awk '
    $0 !~ /^#/ { exit }
    /^#[[:space:]]*ancestry:[[:space:]]/ {
      line = $0
      sub(/^#[[:space:]]*ancestry:[[:space:]]*/, "", line)
      if (split(line, f, /[[:space:]]+/) == 2) printf "%s\t%s\n", f[1], f[2]
    }
  ' "$path"
}

# install_direction <install> <sha> -- source_direction's answer when the source
# is an install: looked up, never computed, because nothing here has history.
#
# `same` when <sha> is the commit the install holds; the recorded direction when
# the table has it; `unknown` otherwise. NOT FOUND IS UNKNOWN, never `forward`:
# a commit the install never held is exactly the case nobody can vouch for.
install_direction() {
  local install="$1" rec="$2" head line sha dir
  # The install's commit through the one reader of "which commit does this
  # source hold", not a second parse of the same header.
  head="$(_devbin_source_head "$install" 2>/dev/null)" || head=""
  is_commit_sha "$head" || { printf 'unknown\n'; return 0; }
  # EXACT MATCHES ONLY. Every writer records full shas; a short recorded value
  # comes from a hand edit, and a prefix could match a row it does not name.
  [ "$head" = "$rec" ] && { printf 'same\n'; return 0; }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    sha="${line%%	*}"
    dir="${line#*	}"
    [ "$sha" = "$rec" ] || continue
    case "$dir" in
      forward | backward | unrelated) printf '%s\n' "$dir" ;;
      *) printf 'unknown\n' ;;
    esac
    return 0
  done <<EOF
$(manifest_ancestry "$install")
EOF
  printf 'unknown\n'
  return 0
}

# ask_person <question> -- ask a person at the terminal a yes/no question, from
# inside a gate. Prints `<question> [y/N] ` and reads the answer from /dev/tty.
#   0  the answer was y
#   1  any other answer, end of input included
#   2  nobody to ask: no readable /dev/tty, or the gate's stdin was not a terminal
# The caller says what each means for it; 2 is never folded into 1, because
# "declined" and "could not ask" are different answers (ST0007 AC-5.3 exits 2).
#
# THE ONE HOME FOR THE QUESTION (issue 0089; hv, option B): clean, fullcycle
# and the release core's first-push confirmation all ask through here, so the
# rule for "is a person here" is written once.
#
# READS /dev/tty, NEVER STDIN. run_gate hands every gated tool </dev/null
# (issue 0088, row 2), so a gated function's stdin is empty and its stdout is a
# pipe; an answer cannot come through that plumbing at all.
#
# "IS A PERSON HERE" IS THE GATE'S DEVBIN_GATE_TTY, NOT `-t 0`. Under a gate
# stdin is never the terminal, and run_gate always sets the flag from its OWN
# stdin, so the flag alone answers it. `-r /dev/tty` alone is not enough, which
# is issue 0058: it holds for any process with a controlling terminal -- a test
# suite, a script with its stdin redirected -- and the suite once printed a
# prompt into bats's captured output and blocked on a keystroke nobody knew was
# being asked for (2026-09-06). The `:-0` default answers "nobody" for a caller
# outside a gate; every caller today is inside one, so no arm holds it.
#
# FOR A GATED CALLER ONLY. devbin_offer_upgrade, below, asks from OUTSIDE any
# gate, where the flag is either unset or inherited from a parent gate and so
# says nothing about this process; it keeps its own `-t 0` test for that reason.
ask_person() {
  local reply
  if [ ! -r /dev/tty ] || [ "${DEVBIN_GATE_TTY:-0}" != 1 ]; then
    return 2
  fi
  printf '%s [y/N] ' "$1"
  IFS= read -r reply </dev/tty || reply=""
  case "$reply" in
    y | Y) return 0 ;;
    *) return 1 ;;
  esac
}

# devbin_offer_upgrade <projroot> -- ask, on a real terminal, whether to
# upgrade now. Returns 0 whether or not anything was done.
#
# WHY THIS IS NARROW, AND IT IS A DELIBERATE NARROWING OF WHAT WAS ASKED FOR.
# The request was an offer "when it is next used". This offers on the BARE
# invocation and on `doctor`, not on every command, because there is no way for
# the dispatcher to know whether the command it is about to run is a gate --
# gate-ness is decided inside the handler, after dispatch, and the catalogue
# does not record it. `devbin test all` typed at a terminal would reach this
# code with stderr still a terminal, and stopping to ask about upgrades before
# running somebody's tests is the same defect as issue 0058 wearing a friendlier
# face. Bare and `doctor` are never gates by construction rather than by a check
# that could drift, and they are where a person is looking at devbin itself.
#
# THE TERMINAL TEST IS 0058's, BOTH ARMS. `read </dev/tty` ignores stdin, so
# `-t 0` alone would not stop it blocking; `-r /dev/tty` alone passes on any
# machine with a tty device node, which is every CI runner. Neither half works
# on its own -- that is what cost 6m30s of a hung suite on 2026-09-06.
#
# `-t 2` as well, matching the notice: a sealed gate's stderr is a pipe, so this
# cannot speak from inside one even if it were ever reached there.
devbin_offer_upgrade() {
  local root="${1:-}" state word rec cur reply
  [ -n "$root" ] || return 0
  [ -n "${DEVBIN_NO_UPDATE_NOTICE:-}" ] && return 0
  # A DEVBIN LAUNCHED BY THIS OFFER NEVER OFFERS AGAIN.
  #
  # The yes branch runs `bin/devbin upgrade`, which re-enters the dispatcher --
  # and while that upgrade is still running the project is STILL behind, so a
  # second offer is made, which launches a third upgrade. Found by mutation on
  # 2026-09-06: widening the offer to every command turned this into a live
  # recursion that hung the suite rather than failing an assertion.
  #
  # Today the command scoping happens to prevent it, because `upgrade` is not in
  # the offered set. THAT IS INCIDENTAL PROTECTION, not a guard: it holds only
  # while nobody widens the set, and the mutation is exactly what widening looks
  # like. The sentinel makes it intrinsic.
  [ -n "${DEVBIN_OFFER_IN_PROGRESS:-}" ] && return 0
  [ -t 2 ] || return 0
  [ -t 0 ] || return 0
  [ -r /dev/tty ] || return 0

  # ONLY `behind` -- the source moved FORWARD -- is an update (issue 0079). This
  # matched on any difference, so a consumer AHEAD of a rewound install was told
  # "An update to devbin is available", and a yes ran the upgrade that reverts
  # it. upgrade's own BEHIND warning came after the person had already chosen.
  state="$(devbin_source_state "$root")"
  IFS=' ' read -r word rec cur _ <<<"$state"
  [ "$word" = behind ] || return 0

  {
    printf 'An update to devbin is available.\n'
    printf '  this project has: %s\n' "${rec:0:12}"
    printf '  the source has:   %s\n' "${cur:0:12}"
    printf '  from:             %s\n' "$(manifest_source "$root" 2>/dev/null || printf 'unrecorded')"
    printf '\nUpgrading rewrites the vendored runtime in your working tree.\n'
  } >&2
  printf 'Upgrade now? [y/N] ' >&2
  # Read from the terminal, not stdin: the caller may have redirected stdin for
  # its own reasons and this question is for the person, not the pipeline.
  # EOF DECLINES, it does not vanish -- the shape `_clean_confirm` uses. An
  # early `return 0` here made the no-answer case indistinguishable from the
  # offer never having been made, which is the state a pty-at-EOF test sees.
  IFS= read -r reply </dev/tty || reply=""
  case "$reply" in
    y | Y | yes | YES) ;;
    *)
      printf 'Left as it is. Run: %s upgrade\n' \
        "${DEVBIN_INVOKE:-bin/devbin}" >&2
      return 0
      ;;
  esac
  printf '\n' >&2
  # Runs the real verb rather than reimplementing it: upgrade owns what an
  # upgrade is, including every refusal it makes about edited files.
  ( cd "$root" && DEVBIN_OFFER_IN_PROGRESS=1 ./bin/devbin upgrade ) || true
  return 0
}

# devbin_source_state <projroot> -- FIVE states, on stdout, one word first.
#
#   level                           the vendored runtime is what the source holds
#   behind <recorded> <now>         the source has moved FORWARD past this project
#   ahead <recorded> <now>          the source is BEHIND this project
#   differs <recorded> <now> <why>  they differ, and in no direction anyone knows
#   unknown <reason>                it could not be established
#
# ONLY `behind` IS AN UPDATE (issue 0079). This had three states and compared
# two shas for equality, so every difference was `behind` -- and the notice, the
# offer and doctor all told a project AHEAD of a rewound source to upgrade,
# which is issue 0021's silent revert, measured at 11 files. The direction now
# comes from source_direction, the answer upgrade and vendor already read, so
# nothing here can call a move "an update" that upgrade would call a revert.
#
# `differs` IS NOT `unknown`. A record the source cannot place, or a source on
# another history, is a REAL difference, and staying quiet about it hides one;
# but nothing vouches the source is newer, so it is never called an update.
# `unknown` is for when there was no difference to report: nothing to compare,
# or the same commit on both sides with no direction established for it.
#
# `ahead` IS A CLAIM ABOUT HISTORY, NOT BYTES. The source holds an older commit
# than the one this project vendored; whether any vendored FILE would change is
# upgrade's question (seam_is_level, lib/install), and a source that moved only
# outside the seam changes none. So the readers say which way the commits lie
# and never that an upgrade would revert the runtime. `behind` has the mirror
# limit, and has always had it: a forward move outside the seam is still
# offered as an update.
#
# WHY THIS EXISTS SEPARATELY FROM THE NOTICE. `_devbin_update_line` prints or
# stays quiet, and quiet is its answer for BOTH "level" and "cannot tell". That
# is right for a notice -- it asserts nothing and must never nag -- and it is
# exactly wrong for a CHECK, where the two must not collapse. Absent is not
# clean; a check that cannot reach the source and reports nothing is read as
# reporting currency it never established.
#
# The notice, the offer and `doctor` all read this, and it asks
# `_devbin_source_head` and source_direction, so there is one answer to "what
# does the source hold" and one to "which way did it move".
devbin_source_state() {
  local root="${1:-}" src rec cur
  [ -n "$root" ] || { printf 'unknown no project root given\n'; return 0; }

  src="$(manifest_source "$root" 2>/dev/null || true)"
  rec="$(manifest_source_commit "$root" 2>/dev/null || true)"
  [ -n "$src" ] || { printf 'unknown this project records no source\n'; return 0; }
  [ -n "$rec" ] || { printf 'unknown this project records no source commit\n'; return 0; }
  [ -d "$src" ] || { printf 'unknown the source is not on this machine: %s\n' "$src"; return 0; }

  rec="${rec%% *}"
  is_commit_sha "$rec" ||
    { printf 'unknown this project records bytes that name no commit\n'; return 0; }
  if ! cur="$(_devbin_source_head "$src")"; then
    printf 'unknown the source names no commit: %s\n' "$src"
    return 0
  fi

  case "$(source_direction "$root" "$src")" in
    same) printf 'level\n' ;;
    forward) printf 'behind %s %s\n' "$rec" "$cur" ;;
    backward) printf 'ahead %s %s\n' "$rec" "$cur" ;;
    unrelated) printf 'differs %s %s the source is on a different history\n' "$rec" "$cur" ;;
    *)
      # EQUAL SHAS WITH NO DIRECTION. Today that is a `+dirty` record at the
      # source's own commit: the bytes started there and are not it, and it read
      # `level` until 0079 because the sha was stripped of its mark and then
      # compared. The reason names what is known rather than inferring the mark.
      if [ "$rec" = "$cur" ]; then
        printf 'unknown this project records the commit the source holds, but no direction could be established for it (a +dirty record reads this way)\n'
      else
        printf 'differs %s %s which way the source moved cannot be told from what is on disk\n' "$rec" "$cur"
      fi
      ;;
  esac
  return 0
}

# _devbin_update_line <projroot> -- print the notice body, or nothing.
#
# SEPARATED FROM DELIVERY SO IT CAN BE TESTED. The comparison is the part with
# the logic in it and the guards are the part with the policy; keeping them in
# one function made the whole thing reachable only through a real terminal.
#
# THE TERMINAL PROBLEM IS SOLVED AND THIS PARAGRAPH USED TO SAY OTHERWISE. It
# read, in the present tense, that "the only way to give a test one is `script`,
# which fails outright when stdin is a socket", and recorded that two tests
# asserting the notice stayed SILENT had passed vacuously -- no pty, no output,
# refutation satisfied. That was true when written and has not been true since
# `run_tty_eof` (tests/lib/test_helper.bash) landed: `script` starts when its
# OWN stdin is `/dev/null`, and the child still gets the allocated pty. The
# delivery half is exercised for real today -- `ON A TERMINAL the notice
# actually SPEAKS` is green, not skipped.
#
# The correction is kept rather than the paragraph deleted, because the stale
# version cost something measurable: a node read it as a live gap, re-derived
# the `</dev/null` trick from scratch, and offered it as a fix that was already
# in the tree. A comment describing a solved problem in the present tense is a
# claim with an expiry date, and this file is where that class gets recorded.
#
# Prints to stdout; the caller decides where it goes. Empty output means there
# is nothing to say.
_devbin_update_line() {
  local root="${1:-}" state word rec cur why
  [ -n "$root" ] || return 0

  # ONE READER OF THE STATE, NOT A SECOND COMPARISON (issue 0079). This kept its
  # own sha check and its own equality test beside devbin_source_state's, so the
  # two could disagree and both called any difference "moved on".
  state="$(devbin_source_state "$root")"
  IFS=' ' read -r word rec cur why <<<"$state"

  # Twelve characters, and only ever printed when the full shas differ. The
  # first version truncated BEFORE comparing like with like, so it printed two
  # identical-looking values as its evidence that they differed -- the
  # truncation did not merely fail to help, it hid the cause.
  case "$word" in
    behind)
      printf 'UPDATE: devbin has moved on since this project vendored it.\n'
      printf '        vendored %s, source now %s\n' "${rec:0:12}" "${cur:0:12}"
      printf '        run: %s upgrade      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
    ahead)
      printf 'NOTE: the devbin this project came from is BEHIND this project.\n'
      printf '      vendored %s, source now %s -- an older commit\n' "${rec:0:12}" "${cur:0:12}"
      printf '      run: %s vendor, before any upgrade      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
    differs)
      printf 'NOTE: the devbin this project came from differs from what it vendored: %s.\n' "$why"
      printf '      vendored %s, source now %s\n' "${rec:0:12}" "${cur:0:12}"
      printf '      it is not known to be newer; run: %s vendor      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
  esac
  return 0
}

# devbin_update_notice <projroot> -- tell the user, ONCE A DAY AND ONLY ON A
# TERMINAL, that the devbin this project vendored has moved on, is behind it, or
# differs from it in no known direction (issue 0079).
#
# THE POINT IS THAT A CONSUMING PROJECT LEARNS WITHOUT BEING ASKED. `vendor`
# already answers "is this tree level with its SOURCE" -- the comparison is not
# new, only the moment it is made. What is new is that the answer reaches
# someone who was not investigating.
#
# FOUR CONSTRAINTS, AND THE FIRST IS NOT OBVIOUS.
#
#   STDERR, NEVER STDOUT. devbin seals gate output and six extraction grammars
#   parse it; two print on unanchored patterns. A version notice on stdout lands
#   INSIDE a run log and is read as tool output -- issue 0025's class exactly.
#
#   A TERMINAL, OR NOTHING. `[ -t 2 ]` keeps it out of CI logs and out of sealed
#   gates, whose stderr is a pipe. Load-bearing, not a nicety.
#
#   ONCE A DAY. A git call on every invocation would put a fork on the hot path
#   of a launcher that runs on every command.
#
#   NEVER FATAL, AND NEVER NOISY ABOUT ITS OWN FAILURE. A consumer usually does
#   not have devbin's source on disk at all. That is the ordinary case, so every
#   failure path is a silent `return 0`. This is the one place in devbin where
#   swallowing is correct: the function asserts nothing, and IN-AG-NO-SILENT-001
#   is about failures that reach a verdict.
#
# THE STAMP IS WRITTEN BEFORE THE COMPARISON, DELIBERATELY: the rate limit is on
# the CHECK, not on the message, so a source that moves on five minutes after a
# check is reported at the next day's check rather than on the next command.
devbin_update_notice() {
  local root="${1:-}" stamp msg dir base
  [ -n "$root" ] || return 0
  [ -n "${DEVBIN_NO_UPDATE_NOTICE:-}" ] && return 0
  [ -t 2 ] || return 0

  # The stamp lives in TMPDIR rather than the project, so it needs no .gitignore
  # entry and can never appear in a consumer's git status.
  base=".devbin-update-$(printf '%s' "$root" | tr -c 'a-zA-Z0-9' '-')"
  dir="${TMPDIR:-/tmp}"
  stamp="$dir/$base"
  # -mtime is POSIX; -newermt is GNU-only and this fleet runs on macOS.
  if [ -f "$stamp" ] && [ -n "$(find "$dir" -maxdepth 1 -name "$base" -mtime -1 2>/dev/null)" ]; then
    return 0
  fi
  : >"$stamp" 2>/dev/null || true

  msg="$(_devbin_update_line "$root")"
  [ -n "$msg" ] && printf '%s\n' "$msg" >&2
  return 0
}
