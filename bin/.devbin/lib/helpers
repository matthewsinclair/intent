#!/usr/bin/env bash
#
# lib/helpers -- shared output and guard primitives.
#
# Sourced, not executed: defines functions, and sets exactly ONE shell option,
# `inherit_errexit`, below. The rest (errexit, nounset, pipefail) stay the
# caller's. This file said it set none until issue 0060: handlers are separate
# processes that source this file and nothing else from the dispatcher, so this
# is the one place a line reaches every one of them.
#
# THIS FILE HAS NO DEPENDENCIES, and that is a load-bearing rule rather than a
# happy accident. Command handlers are separate processes that source this file
# ALONE (see bin/.devbin/cmd/check). The moment a primitive here needs config,
# every handler in every project has to load the config reader to print a
# warning. So the rule is: needs config, belongs in lib/resolve; needs nothing,
# belongs here. `is_command` and `parse_common_opts` live in lib/resolve for
# exactly this reason, despite reading as helpers.
#
# WP-05 folds the universal functions out of the source projects. The run-log
# subsystem -- open_run_log, write_errors_file, note_promotion, the purge
# family, print_run_verdict -- is deliberately NOT here: it is one cohesive
# subsystem and WP-06 ports it whole into lib/runlog. Splitting it across two
# files to satisfy a function count would be the worse trade.
#
# The project name in the die/warn prefix comes from config rather than being
# baked in, which is the whole point of the fold: every project printing
# its own `<name>:` from its own copy of the same two lines becomes one line
# reading a value.
#
# bash_floor_refuse <version> <path> [<how it was reached>] -- the ONE refusal
# for a bash below devbin's floor, and it exits.
#
# THE FLOOR (issue 0022, reversing design D9). devbin requires bash >= 5 and
# REFUSES older: macOS ships /bin/bash 3.2.57 permanently (GPLv3), the estates
# devbin runs in use a Homebrew bash 5.x, and the guarantee points at what
# actually runs. EVERYTHING FROM HERE TO THE LOAD GUARD MUST STAY PARSEABLE BY
# BASH 3.2 -- the refusal cannot be allowed to arrive as a syntax error that
# explains nothing.
bash_floor_refuse() {
  printf '%s: bash >= 5 is required; this is bash %s (%s)\n' \
    "${DEVBIN_NAME:-devbin}" "${1:-unknown}" "${2:-unknown}" >&2
  [ -z "${3:-}" ] || printf '  %s\n' "$3" >&2
  printf '  macOS ships bash 3.2 permanently -- install a current one:  brew install bash\n' >&2
  exit 1
}

# THE FLOOR IS CHECKED WHERE EVERY PROCESS PASSES (issue 0076). It lived in the
# dispatcher alone, and handlers are separate processes: one run directly, or
# exec'd under a PATH that finds 3.2, ran on 3.2 with nothing refusing. Every
# built-in handler and the dispatcher source this file, so the check sits here,
# ahead of the load guard, and a handler below the floor stops at load.
if [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  bash_floor_refuse "${BASH_VERSION:-}" "${BASH:-}"
fi

[ -n "${_DEVBIN_HELPERS_LOADED:-}" ] && return 0
_DEVBIN_HELPERS_LOADED=1

# ERREXIT REACHES EVERY DEPTH (issue 0060, ruled option A 2026-09-16). Command
# substitution does not inherit errexit without this, so a `die` two `$( )`
# deep kills only its own subshell: the middle function carries on and the
# outer caller reads its output as success. Measured live at `release notes`,
# which wrote both views and exited 0 over a refusal it had printed twice.
# Unguarded, because the floor above has already refused every bash without it.
shopt -s inherit_errexit

# require_path_bash_floor -- refuse when the bash PATH resolves is below the
# floor, since every `#!/usr/bin/env bash` handler runs on THAT bash and not on
# the dispatcher's own (issue 0076).
#
# Measured before this existed: `env PATH=/usr/bin:/bin /opt/homebrew/bin/bash
# bin/devbin probe` passed the dispatcher's own check on 5.3 and ran the handler
# on 3.2.57 at rc 0. The ordinary case costs one PATH lookup: the same file as
# the running bash needs no second process.
require_path_bash_floor() {
  local path_bash answer
  # No bash on PATH at all is not a floor question: every `env bash` handler
  # then fails at exec, loudly, naming bash.
  path_bash="$(type -P bash)" || return 0
  [ "$path_bash" -ef "${BASH:-}" ] && return 0
  # Single-quoted on purpose: the CHILD bash expands these, not this one.
  # shellcheck disable=SC2016
  answer="$("$path_bash" -c 'printf "%s %s" "${BASH_VERSINFO[0]}" "$BASH_VERSION"')" ||
    die "could not ask $path_bash its version, and handlers run on the bash PATH resolves"
  case "${answer%% *}" in
    '' | *[!0-9]*) die "$path_bash answered its version as '$answer', which is not a bash version" ;;
  esac
  [ "${answer%% *}" -ge 5 ] && return 0
  bash_floor_refuse "${answer#* }" "$path_bash" \
    "PATH resolves bash to it, and every handler runs on the bash PATH resolves (this dispatcher is on $BASH_VERSION)"
}

# The prefix on diagnostics. Set by the dispatcher once config is loaded;
# defaults to `devbin` so a failure BEFORE config load still says something
# sensible rather than printing a bare colon.
DEVBIN_NAME="${DEVBIN_NAME:-devbin}"

# DEVBIN_INVOKE -- HOW YOU TYPE IT, which is now a CONSTANT rather than the
# project's name.
#
# These were one field until 2026-08-27, because the launcher was symlinked to
# the project's own name and `bin/demo` was both the thing you typed and
# the thing the project was called. That convention collided with the binaries
# these projects now BUILD -- a project named `demo` ships a `demo` binary --
# and one project had already routed around it by renaming its shim.
# So the per-project symlink is retired and `bin/devbin` is the invocation
# everywhere.
#
# IT WAS A CONSTANT, AND THE PREMISE FOR THAT WAS FALSE (ST0005, 2026-09-06).
#
# This read: "The invocation no longer varies, so a variable would be a field
# that must be kept in sync with a fact that cannot change." That reasoning was
# about the retired per-project symlink and it was right about THAT. What it
# missed is that `bin/devbin` is a RELATIVE path, so what varies is not the name
# but whether it RESOLVES from where the reader is standing.
#
# The operator drives devbin through `dvb`, a shell function that walks UP from
# $PWD to find `bin/devbin` and runs it without changing directory -- so its
# whole purpose is being used from a SUBDIRECTORY. Measured there, every
# remediation devbin prints was a command that does not exist:
#
#     run: bin/devbin upgrade
#     $ bin/devbin upgrade
#     no such file or directory: bin/devbin
#
# That is the defect this file already records one form of -- "the
# remediation names a command that EXISTS" -- recurring in the one direction the
# earlier fix did not cover. It exists at the project root, and not where the
# reader is.
#
# So it is the SHORTEST FORM THAT WORKS FROM THE CALLER'S CWD, and the dispatcher
# computes it once from the ORIGINAL cwd before any handler cds to the project
# root. `:-` rather than a bare assignment so a re-source inside an exec'd
# handler inherits that answer instead of recomputing a wrong one.
DEVBIN_INVOKE="${DEVBIN_INVOKE:-bin/devbin}"

die() {
  printf '%s: %s\n' "$DEVBIN_NAME" "$*" >&2
  exit 1
}

warn() {
  printf '%s: %s\n' "$DEVBIN_NAME" "$*" >&2
}

step() { printf '\n==> %s\n' "$*"; }
ok() { printf '    done.\n'; }

# report_not_yet <what> <gate> -- print the STUB refusal and return 3.
#
# The non-exiting half of not_yet, for callers running inside a loop over
# several options: `all` must not stop at the first breach, so a function it
# calls in the same process cannot exit. One message, two exit behaviours.
report_not_yet() {
  printf '%s: %s is not built yet.\n' "$DEVBIN_NAME" "$1" >&2
  printf '       gated on: %s\n' "$2" >&2
  return 3
}

# not_yet <what> <gate> -- the STUB refusal, ported from the corpus.
#
# A surface that is not built yet exits NON-ZERO with the reason and what
# unblocks it, never a quiet no-op. An unbuilt gate that exits 0 is
# indistinguishable from a passing one, which is the exact failure the sealed
# gates exist to prevent.
not_yet() {
  report_not_yet "$1" "$2" || true
  exit 3
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found. ${2:-}"
}

# init_colors [auto|off] -- set green/red/dim/reset. All empty when off, when
# NO_COLOR is set, or when stdout is not a TTY.
#
# SC2034 (appears unused) is expected here and suppressed: these are globals for
# the whole runtime, and shellcheck only sees this file. Exporting them to
# satisfy the linter would push four colour variables into the environment of
# every command devbin runs, which is a worse trade than one directive.
# shellcheck disable=SC2034
init_colors() {
  green="" red="" dim="" reset=""
  if [ "${1:-auto}" = auto ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    green=$'\033[32m' red=$'\033[31m' dim=$'\033[2m' reset=$'\033[0m'
  fi
}

# strip_ansi -- filter: remove CSI escape sequences from stdin.
#
# Byte-identical in every project it was folded from. Reads stdin, writes
# stdout, so it composes in a pipeline: `... | strip_ansi > "$errors"`.
#
# The escape byte is passed in as an awk variable rather than written into the
# pattern, because a literal ESC in source survives neither editors nor patches
# reliably.
strip_ansi() {
  awk -v esc="$(printf '\033')" '{ gsub(esc "\\[[0-9;?]*[A-Za-z]", ""); print }'
}

# upper_snake <string> -- the environment-variable spelling of a name.
#
# `demo` -> DEMO, `my-proj` -> MY_PROJ. Devbin derives variable names
# from the project name in several places -- <NAME>_ROOT, <NAME>_REPL_HISTORY,
# DEVBIN_OPT_<NAME>, the run-log suffix -- and each did the same `tr` inline.
# Four copies of one transformation is four chances to disagree about whether a
# hyphen becomes an underscore.
upper_snake() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'
}

# is_true_word <value> -- `true`, `yes` or `1`.
# is_false_word <value> -- `false`, `no` or `0`.
# is_no_default <value> -- the catalogue's `-`: "devbin ships no default here".
#
# ONE PREDICATE PER VOCABULARY (issue 0066). These were written out at thirteen
# sites across lib/resolve, lib/runlog and lib/builtins. Every copy agreed, and
# nothing would have said so on the day one learned a word the others did not
# -- which is how 0065 happened: `-` was honoured for `log:` on the catalogue's
# value alone, and a project writing `log: "-"` sealed a gate named `-`. The
# words are exact and case-sensitive, as every copy was; `off` is not false.
#
# THE WORDS ARE DATA, AND THE PREDICATES READ THEM. docs/configuration.md and
# lib/config.reference.yaml both state the `log:` decline spellings, and
# tests/unit/helpers.bats holds each statement to these lists. It first read the
# words back out of the function's source, which a second `return 0` line or an
# `OFF)` arm slipped past (critic-shell, 2026-09-16); a list has no layout to
# parse around.
_DEVBIN_TRUE_WORDS="true yes 1"
_DEVBIN_FALSE_WORDS="false no 0"
_DEVBIN_NO_DEFAULT="-"

# _word_in <value> <words> -- <value> is exactly one of the space-separated
# <words>. Split with `read -a`, which never globs, so a word is only ever a
# literal.
#
# IFS IS PINNED HERE, because `read -a` splits on the CALLER'S. Under the common
# strict-mode `IFS=$'\n\t'`, or `IFS=`, the list stayed one word and `true`,
# `yes`, `1` and `no` all read as not-a-word -- so `log: false` stopped declining,
# 0065 again, in any estate handler that sources lib/helpers under strict mode.
# The case statements this replaced never read IFS.
_word_in() {
  local w IFS=' '
  local -a words
  read -r -a words <<<"$2"
  for w in "${words[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

is_true_word() { _word_in "$1" "$_DEVBIN_TRUE_WORDS"; }
is_false_word() { _word_in "$1" "$_DEVBIN_FALSE_WORDS"; }
is_no_default() { _word_in "$1" "$_DEVBIN_NO_DEFAULT"; }

# has_words <value> -- true when <value> holds a character bash would not split
# on, which is the same question as "run_words would find at least one word".
#
# SEPARATE FROM run_words BECAUSE VALIDATION MAY NOT GLOB: cfg_validate reads
# every declared command line wherever `doctor` happens to be standing, and
# matching a pattern there would say nothing about the directory the command
# will run in. This asks the only half validation can answer.
#
# The characters are the three run_words splits on, not `[[:space:]]`: a value
# of one carriage return is a word to bash and is not a space to that class, and
# a refusal that disagreed with the split would refuse a line that runs.
has_words() {
  case "$1" in
    *[!$' \t\n']*) return 0 ;;
  esac
  return 1
}

# nonempty_lines <text> -- how many lines of <text> hold anything (issue 0159).
#
# A COUNT WITH NO STATUS TO SWALLOW. The idiom was `grep -c . || true`: grep
# exits 1 on a count of 0, so every caller had to throw a status away, and the
# same `|| true` throws away the 2 of a grep that could not read. A read loop
# over a string it was handed has no status to lose.
nonempty_lines() {
  local line n=0
  while IFS= read -r line; do
    if [ -n "$line" ]; then n=$((n + 1)); fi
  done <<<"$1"
  printf '%s\n' "$n"
  return 0
}

# run_words <array> <key> <value> -- fill <array> with the words <value> runs
# as, or refuse, naming <key>, a value with no words in it.
#
# THE ONE READING OF A DECLARED COMMAND LINE (issue 0082). Every place devbin
# runs one asks this: an option's `run:` bare
# and under a gate, a command's `run:` exec'd and under a gate,
# `commands.fullcycle.restore`, `release.notes.run`, and the catalogue's own
# command lines, which follow the same rule because two halves of one surface
# differing would be worse than either behaviour on its own.
#
# - SPLIT ON SPACE, TAB AND NEWLINE, never on the caller's IFS. Under the
#   common strict-mode `IFS=$'\n\t'` a whole command line stays one word and
#   resolves to nothing, and that class has been measured twice in this tree in
#   two days (`_word_in`, `cfg_release_list`).
# - EVERY WORD IS A GLOB PATTERN, matched in the directory the caller stands in,
#   which each site makes the directory the command runs from: the project root,
#   or for `notes.run` the root it answers for. A word matching nothing is
#   passed as written, a word matching several becomes several words, and a
#   dotfile is matched only by a pattern that names the dot. The globbing was
#   ruled KEPT and documented after the census of 2026-09-17: a project's
#   `bats opt/*/test` relies on it.
# - THE READING IS DEVBIN'S, NOT THE PROCESS'S. `set -f` and the glob options
#   are pinned here for the split alone and put back before this returns, so an
#   inherited `SHELLOPTS=noglob` or `BASHOPTS=nullglob:dotglob` cannot quietly
#   change what a declared line runs -- both measured on bash 5.3, 2026-09-17,
#   turning globbing off entirely and dropping a word that matches nothing.
#   **NOT pinned, deliberately: `GLOBIGNORE` and `GLOBSORT`.** Both are inert
#   when they arrive in the environment, measured the same day, and `local
#   GLOBIGNORE` would ACTIVATE the inherited value for the rest of the process
#   as the local goes out of scope. devbin assigns neither, and a test holds it.
#   **AND NOT PINNING IS THE ONLY CORRECT ANSWER, NOT THE CONVENIENT ONE**, which
#   is stronger than this note said until it was measured: bash runs
#   these hooks on ASSIGNMENT, so once the variable is touched at all the inert
#   state cannot be restored by any assignment -- saving it, unsetting it and
#   writing the same bytes back leaves it ACTIVE. A pin here would therefore be
#   a one-way door for the whole process, which is why the rule is "never touch"
#   rather than "save and restore" as it is for the shopts above.
# - NEVER EVAL'D (D1). Quotes, `$`, `;` and redirections in the value are
#   literal characters, so a declared line cannot carry an argument with a space
#   in it; a command line that needs real quoting needs a handler.
# - A VALUE WITH NO WORDS IS REFUSED, NAMING <key>. A `run:` of only spaces is
#   not empty to `[ -n "$run" ]` and splits into nothing, after which `$run "$@"`
#   ran the arguments typed after the command AS the command, at exit 0.
run_words() {
  # A NAMEREF CANNOT BE HONOURED IF THE NAME IS ONE OF OURS, AND FAILING THAT
  # QUIETLY WOULD REBUILD THE DEFECT THIS HELPER EXISTS TO KILL. `local -n
  # _rw_out="$1"` binds first and the `local` on the next line then SHADOWS the
  # caller's variable when the name matches, so the words land in the local, the
  # local dies at return, and run_words hands back 0 with the caller's array
  # never set -- after which `"${words[@]}" "$@"` is an empty command line that
  # runs the arguments typed after the command, at exit 0. That is 0082 exactly.
  # Measured on bash 5.3: `_rw_o`, `_rw_on` and `IFS` each do it silently, and
  # `_rw_on` additionally hands the split words to `shopt -s`. No caller can
  # reach it -- every site passes `words` or `restore_words` -- so this is a
  # trap for the next caller rather than a live bug, and status 2 marks it as a
  # programming error rather than the config error 1 means.
  # TWO CHECKS, BECAUSE A BLACKLIST ALONE LEAVES 0082'S OWN SHAPE NEXT TO IT.
  # The first cut listed the colliding names and stopped, and a review drove the
  # hole: `run_words 2bad ...` makes `local -n` fail with bash's own `invalid
  # variable name for name reference`, execution FALLS THROUGH, and run_words
  # returns 0 with the caller's array never set -- which is the empty command
  # line again. Measured on bash 5.3, all at rc=0: `2bad`, `a b`, `a-b`, `-x`,
  # `a;b`. `arr[0]` got as far as the copy and returned 1, reporting a valid
  # name as "the config's line held no words". A name that IS a name is the
  # question, so it is asked positively, through the one definition of it.
  if ! is_identifier "$1"; then
    warn "run_words: '$1' is not a shell variable name, so there is no array to fill"
    return 2
  fi
  case "$1" in
    _rw_out | _rw_o | _rw_on | _rw_split | IFS)
      warn "run_words: cannot fill an array named '$1' -- it is one of run_words's own names"
      return 2
      ;;
  esac
  local -n _rw_out="$1"
  local IFS=$' \t\n' _rw_o _rw_on=""
  # The split lands in a local and is copied to the caller AFTER the shopts are
  # put back, so a target bash refuses to assign -- a readonly one -- cannot
  # leave the six options unset in the caller's shell. Unreachable
  # from the eight sites, which all pass a plain indexed array.
  #
  # **AN INTEGER TARGET IS NOT REFUSED AND THE GUARD ABOVE CANNOT REFUSE IT**,
  # because `declare -ia w` carries a name that IS a name: the defect is the
  # attribute, not the spelling. This comment claimed a `declare -ia` target
  # refuses, and that was wrong in both directions, measured on bash 5.3 --
  # under `set +u` the word `abc` COERCES, silently, to `(0)`, so the caller
  # runs the command `0`; under devbin's own `set -euo pipefail` the arithmetic
  # on an unset name kills the shell outright. Loud in devbin, silent in a
  # caller that relaxed `set -u`. It is declared rather than closed: no site
  # passes an integer array, and a check on the target's attributes would be
  # reading `declare -p` output as a string.
  local -a _rw_split=()
  # `set` options are restored on return; the shopt ones are put back below,
  # which is why the split and the restore sit between no other statements.
  local -
  set +f
  for _rw_o in nullglob failglob dotglob nocaseglob globstar extglob; do
    shopt -q "$_rw_o" || continue
    _rw_on="$_rw_on $_rw_o"
    shopt -u "$_rw_o"
  done
  if has_words "$3"; then
    # shellcheck disable=SC2206  # split and globbed on purpose -- see above
    _rw_split=($3)
  fi
  # shellcheck disable=SC2086  # a list of option names, split on purpose
  [ -z "$_rw_on" ] || shopt -s $_rw_on
  _rw_out=(${_rw_split[@]+"${_rw_split[@]}"})
  if [ "${#_rw_out[@]}" -eq 0 ]; then
    warn_no_words "$2"
    return 1
  fi
}

# warn_no_words <key> -- the ONE sentence devbin says when a declared command
# line holds no words. run_words says it at the site, where the words are about
# to be run; a caller that may not glob says it through has_words and this. Two
# readers of a command line and one sentence, rather than the same sentence
# written out wherever it happens to be needed (issue 0082).
warn_no_words() { warn "$1 holds no words, so there is no command to run"; }

# link_step <link> -- print the path <link> names, one step: its content, and a
# relative content joined to the link's directory as written. Returns 1 when
# the content cannot be read back exactly, so a walk of links never takes a
# step to a name the link does not hold; find's own error, if it has one, is
# left on stderr. THE ONE STEP OF EVERY WALK OF A CHAIN OF LINKS: follow_links'
# and fullcycle's _fullcycle_tree_gone (critic-shell on 0139, its fifth pass: a
# second walk, without this, split a content holding a newline and looked up
# the wrong name). Its two refusals before the size check, a readlink that
# fails and an empty content, are each held by the other and by the check; a
# caller reaches it only through a name that is a link (-L), so neither is
# reachable alone, and neither has an arm of its own.
#
# - PLAIN `readlink`, NO FLAGS. `readlink -f` and `realpath` also resolve every
#   directory on the way, and they are not the same program on BSD and GNU.
#   Plain readlink printed the same bytes on both for an absolute target, a
#   relative one, `..`, a space, a leading dash, a dangling link and a loop
#   (measured 2026-09-17: macOS's readlink and GNU coreutils 9.12).
# - A CONTENT IT CANNOT READ BACK EXACTLY IS REFUSED: one ending in a newline.
#   The command substitution strips every trailing newline, whichever readlink
#   printed it -- BSD's prints one fewer than GNU's (measured 2026-09-25) -- and
#   the length left, in bytes, is checked against the link's own size, which
#   find -size reads without following the link. A sentinel that kept the
#   newlines GNU's readlink prints let such a content through whole, and every
#   caller's own command substitution then stripped it: a tree read as gone at
#   rc 0 (critic-shell on 0139, its sixth pass). A newline inside a content is
#   read exactly, and is kept.
# - A PATH NOT OPENING WITH / IS GIVEN TO find AS ./path, so find never reads a
#   link named -x, ! or ( as an option or an expression.
# - A RELATIVE CONTENT IS JOINED TO ITS LINK'S DIRECTORY AS WRITTEN, and never
#   tidied: when `a` is itself a link, the kernel reads the `..` in `a/../t`
#   after following `a`, so a tidied `t` can name a different file.
link_step() {
  local p="$1" t n s
  t="$(readlink -- "$p")" || return 1
  [ -n "$t" ] || return 1
  n="$(LC_ALL=C && printf '%s' "${#t}")"
  case "$p" in /*) ;; *) p="./$p" ;; esac
  # find-walk: -prune at the start point -- it asks of one link and enters nothing
  s="$(find "$p" -prune -size "${n}c" -print)" || return 1
  [ -n "$s" ] || return 1
  case "$t" in
    /*) ;;
    *) case "$1" in */*) t="${1%/*}/$t" ;; esac ;;
  esac
  printf '%s\n' "$t"
}

# follow_links <path> -- print the path of the file <path> names: <path> itself
# when it is not a symbolic link, otherwise the end of its chain of links.
# Refuses, naming <path>, a link that leads to no file and a link it cannot
# follow exactly.
#
# THE ONE WALK OF A CHAIN OF LINKS: stage_beside's, so that every writer that
# replaces a file writes through a link to it (issue 0084), and clean's real
# path. bin/devbin keeps a walk of its own, because it runs before this file can
# be found and must parse under bash 3.2. fullcycle's _fullcycle_tree_gone walks
# a path that may not resolve, a name at a time, to say whether it is gone, and
# its _fullcycle_link_in_tree follows a dangling link as far as its links go,
# to place it; each takes each step of a link through link_step, as this does.
#
# - A LINK THAT LEADS TO NO FILE IS REFUSED, dangling or in a loop alike. Writing
#   through it would create a file nobody put there, and replacing it would
#   throw the link away.
# - EACH STEP IS link_step's, which refuses a link whose content it cannot read
#   back exactly. The end of the walk must still be the file the kernel reaches
#   (`-ef`), and the walk is bounded. A correct walk never meets the bound,
#   because the link was reachable: macOS follows 32 links (measured) and Linux
#   documents 40.
follow_links() {
  local path="$1" p="$1" t n=0
  if [ -L "$p" ] && [ ! -e "$p" ]; then
    warn "$path is a symbolic link that leads to no file"
    return 1
  fi
  while [ -L "$p" ]; do
    n=$((n + 1))
    if [ "$n" -gt 40 ] || ! t="$(link_step "$p")"; then
      warn "cannot tell which file $path is a symbolic link to"
      return 1
    fi
    p="$t"
  done
  if [ "$n" -gt 0 ] && ! [ "$path" -ef "$p" ]; then
    warn "cannot tell which file $path is a symbolic link to"
    return 1
  fi
  printf '%s\n' "$p"
}

# real_path <path> <out-var> -- <path>, absolute and with symlinks resolved,
# into the variable <out-var>. A relative <path> is read from the current
# directory, which each caller makes the project root.
#
# ONE HOME FOR WHERE A PATH RESOLVES (issue 0134): clean's scan for PATH
# binaries in a tree it is about to remove, and fullcycle's PATH watch, which
# compared a link's text with the project's path and so never watched a
# relative link, or one spelled through /tmp while the root is /private/tmp.
# It was clean's own until then.
#
# The chain of links is walked by follow_links, the one walk (issue 0084), which
# this function used to carry a copy of; what it adds is the directory's
# physical spelling. A link follow_links cannot follow exactly, one
# whose target's name ends in a newline, it names on stderr, and the path is then
# compared as given.
#
# THE ANSWER IS SET, NOT PRINTED, AND pwd -P's IS READ PAST A SENTINEL (issue
# 0141, the critic's fourth pass). Read back through $(...), a path whose name
# ended in a newline lost it: a tree named out<LF> was compared as out/, its
# neighbour, so its own PATH links went unlisted and unrefused, and a PATH entry
# in out/bin was blamed on it.
real_path() {
  local p="$1" f d fd
  local -n _crp_out="$2"
  if [ ! -e "$p" ]; then
    _crp_out="$p"
    return 0
  fi
  if [ -d "$p" ]; then
    physical_dir "$p" _crp_out || _crp_out="$p"
    return 0
  fi
  f="$(follow_links "$p")" || f="$p"
  case "$f" in
    */*) fd="${f%/*}" ;;
    *) fd=. ;;
  esac
  [ -n "$fd" ] || fd=/
  physical_dir "$fd" d || d="$fd"
  _crp_out="$d/${f##*/}"
  return 0
}

# physical_dir <dir> <out-var> -- the physical path of <dir>, or 1 when it
# cannot be entered.
#
# PHYSICAL, AND FROM WHERE THE PATH SAYS (the critic's fifth pass). bash's plain
# cd is logical: it tidies a/../b as text, where the kernel reads the `..` only
# after following a -- follow_links keeps a/../t untidied for exactly that
# reason, and a logical cd undid it, so a PATH link through lnk/.. into the
# tree went unlisted beside a directory of the tidied name. And cd reads a bare
# relative operand through an exported CDPATH before the current directory,
# and a lone `-` as the directory it last left, printing either: a relative
# PATH entry was read as a directory it does not name. So a relative path is
# spelled from ./, and cd reads it from the current directory, which each
# caller makes the project root, as a lookup made there would, and prints
# nothing. pwd -P's answer is read past a sentinel, so a name ending in a
# newline keeps it (issue 0141).
#
# AND A LEADING // IS SPELLED /: pwd -P keeps it, as POSIX lets it, and it
# names / on the systems devbin runs on. Trees and PATH entries are compared as
# prefixes, so a root entered as //... missed every link into its trees, and a
# PATH entry spelled from // was never the tree's (the critic's sixth pass).
#
# Its locals carry its own prefix, since <out-var> is a caller's name reached
# through bash's dynamic scope, and a local of the same name would take it.
physical_dir() {
  local _cpd_dir="$1" _cpd_d
  local -n _cpd_res="$2"
  case "$_cpd_dir" in
    /*) ;;
    *) _cpd_dir="./$_cpd_dir" ;;
  esac
  _cpd_d="$(cd -P -- "$_cpd_dir" 2>/dev/null && pwd -P && printf .)" || return 1
  _cpd_d="${_cpd_d%$'\n.'}"
  case "$_cpd_d" in //*) _cpd_d="${_cpd_d#/}" ;; esac
  _cpd_res="$_cpd_d"
}

# stage_beside <file> <command> [args...] -- write what <command> prints into a
# temporary that will REPLACE <file>, and print the temporary's name.
# rename_staged <temporary> -- rename a temporary stage_beside printed over the
# file it will replace; on a failure, remove it.
# replace_file <file> <command> [args...] -- replace <file> with what <command>
# prints: staged beside it, then renamed over it.
#
# THE ONE HOME FOR "write a temporary, then rename it over the file" -- the
# temporary, the write into it, its mode, the rename and the cleanup, each of
# which every writer that replaced a file once had its own copy of:
#
# - THE TEMPORARY IS BESIDE THE FILE, NOT IN TMPDIR. A rename is atomic only
#   within one filesystem; across two, `mv` quietly copies, and a kill mid-copy
#   leaves the truncated file this pattern exists to rule out (issue 0002).
# - THROUGH A LINK, THE FILE IT NAMES IS REPLACED AND THE LINK SURVIVES. The
#   temporary is staged beside the file at the end of the link (follow_links),
#   so the rename stays on that file's filesystem, and rename_staged renames it
#   over that file, which the temporary's name records. Renamed over the link's
#   own path, it turned the link into a regular file holding the edit, while the
#   file the link named kept its old content and the writer exited 0 (issue
#   0084). So a caller renaming a staged temporary itself renames it with
#   rename_staged, never over the path it staged.
# - IT HAS THE FILE'S MODE. mktemp creates 0600, and the rename carries that
#   onto the file, so every writer that renamed a temporary into place left a
#   0644 file 0600 -- CHANGELOG.md and RELEASES.md were, on the machine that
#   generated them, with nothing to show it, since git records only the
#   executable bit. `cp -p` gives the temporary the file's mode before the
#   write; a file that does not exist yet gets the mode the umask gives a new
#   file.
# - A READ-ONLY FILE IS STILL REPLACED, AND KEEPS ITS MODE. Copied first, a 0444
#   file's mode made its temporary 0444 too, and the write into it was refused
#   (ST0007 WP-02 review, K3). So the owner's write bit is added for the write
#   when the copied mode lacks it, and taken away again after. The mode is never
#   READ, which keeps this off stat, whose flags differ between BSD and GNU.
# - ON A FAILURE IT RETURNS, THE FILE IS UNTOUCHED AND THE TEMPORARY REMOVED,
#   and a failure of the mechanics is named here, so a caller adds only what it
#   was doing. A failing <command> names its own failure. Two ways still leave a
#   temporary beside the file: a process killed before the rename, and a file
#   flag that `cp -p` copies onto the temporary -- BSD's uchg refuses the write
#   and the removal alike, so the helper returns 1 and rm's own error names the
#   temporary (measured, ST0007 WP-02 review).
stage_beside() {
  local file tmp restore=""
  # The x keeps a name that ends in a newline, which a bare capture strips, and
  # the temporary would then be staged for a different file.
  file="$(follow_links "$1" && printf x)" || return 1
  file="${file%$'\n'x}"
  shift
  if ! tmp="$(mktemp "${file}.XXXXXX")"; then
    warn "could not create a temporary file beside $file"
    return 1
  fi
  if [ -e "$file" ]; then
    if ! cp -p "$file" "$tmp"; then
      rm -f "$tmp"
      warn "could not give the temporary file $file's mode"
      return 1
    fi
    if [ ! -w "$tmp" ]; then
      if ! chmod u+w "$tmp"; then
        rm -f "$tmp"
        warn "could not make the temporary file for $file writable"
        return 1
      fi
      restore=u-w
    fi
  elif ! chmod "$(printf '%o' "$((0666 & ~$(umask)))")" "$tmp"; then
    rm -f "$tmp"
    warn "could not give the temporary file for $file a new file's mode"
    return 1
  fi
  if ! "$@" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [ -n "$restore" ] && ! chmod "$restore" "$tmp"; then
    rm -f "$tmp"
    warn "could not give the temporary file $file's mode back"
    return 1
  fi
  printf '%s\n' "$tmp"
}

# The file is the temporary's name without mktemp's six characters, which is
# where stage_beside staged it: through a link, not the link's path.
#
# `-f` IS NOT DEFENSIVE, IT IS WHAT STOPS THIS BLOCKING FOREVER ON A TERMINAL.
# POSIX mv prompts when the destination exists, permissions do not allow writing
# it, and stdin is a tty -- and a replace of a READ-ONLY file is exactly that
# case, which is the one stage_beside goes to the most trouble to support. With
# no tty the prompt never appears, so every agent-run and CI run of the suite
# passed while `bin/devbin test all` from a human's terminal stopped dead at
# `replace_file replaces a read-only file` and stayed quiet for eight hours.
# A false green that is green for everyone who can see it.
# lib/install:379 already wrote `mv -f` for its own rename; this is the second
# of the two mv calls in the runtime and it had not.
rename_staged() {
  local file="${1%.??????}"
  if ! mv -f "$1" "$file"; then
    rm -f "$1"
    warn "could not rename the temporary file over $file"
    return 1
  fi
}

replace_file() {
  local tmp
  tmp="$(stage_beside "$@")" || return 1
  rename_staged "$tmp"
}

# sed_inplace <expression> <file> -- edit a file in place, portably.
#
# `sed -i` is not portable: BSD sed (macOS) requires an argument to -i and GNU
# sed (Linux CI) refuses one. The corpus wrote `sed -i ''`, which is correct on
# a Mac and fails on Ubuntu. Writing through replace_file sidesteps the
# divergence and is atomic besides, which matters when the file being rewritten
# is the project's version.
sed_inplace() {
  replace_file "$2" sed "$1" "$2"
}

# bump_semver <current> <major|minor|patch> -- print the next version.
#
# Byte-identical in every project it was folded from. Bumping a part zeroes
# everything to its right, which is semver's rule rather than a preference.
bump_semver() {
  local current="$1" part="$2" major minor patch
  assert_semver "$current"
  IFS='.' read -r major minor patch <<EOF
$current
EOF
  case "$part" in
    major) printf '%d.0.0\n' "$((major + 1))" ;;
    minor) printf '%d.%d.0\n' "$major" "$((minor + 1))" ;;
    patch) printf '%d.%d.%d\n' "$major" "$minor" "$((patch + 1))" ;;
    *) die "invalid bump part '$part' (use major, minor or patch)" ;;
  esac
}

# semver_gt <a> <b> -- true when X.Y.Z <a> is greater than <b>, part by part,
# numerically (base 10, so a leading zero is not octal). 1 when it is not, and
# 2 when either is not X.Y.Z: "not greater" and "not a version" are different
# answers, and an ordering guessed from text would put 1.10.0 below 1.9.0.
semver_gt() {
  local a1 a2 a3 b1 b2 b3
  is_semver "${1:-}" && is_semver "${2:-}" || return 2
  IFS=. read -r a1 a2 a3 <<<"$1"
  IFS=. read -r b1 b2 b3 <<<"$2"
  if ((10#$a1 != 10#$b1)); then ((10#$a1 > 10#$b1)); return; fi
  if ((10#$a2 != 10#$b2)); then ((10#$a2 > 10#$b2)); return; fi
  ((10#$a3 > 10#$b3))
}

# abs_path <path> -- absolutise against the project root, leaving absolutes be.
#
# Present in only some projects and PROMOTED by the WP-05 fold: it is four
# lines, has no dependencies, and the projects that lacked it were simply the
# ones that had not needed it yet. A verdict line printing a relative path is
# not clickable in a terminal, which is the whole reason it exists.
abs_path() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "${PROJECT_ROOT:-.}" "$1" ;;
  esac
}

# read_version [file] [role] -- the project version, or `unknown`.
#
# THE DRIFT: most projects read a VERSION file; one reads the version out of
# mix.exs. Neither is wrong -- an Elixir project's version genuinely lives in
# mix.exs, and duplicating it into a VERSION file would be two sources of truth.
#
# So the ruling is not "pick one" but "the file is config, the extraction is
# library". `project.version_from` names the file; the case below knows how to
# read each kind. That keeps the YAML declarative (D1: a name, not a recipe)
# while the knowledge of how a mix.exs states its version lives in code, where
# it can be tested.
#
# The roles mirror write_version_into's, and they scope the issue-0002 guard:
# with no arguments this reads the file `version_from` names, whose whole
# content IS the version by declaration -- second-guessing it turned a
# hand-authored `v1.2.3` into `unknown` (delta review, finding 9). An explicit
# <file> is a SIDECAR read unless <role> says `version-file`, and there the
# bare-version fallback is devbin GUESSING about a file kind it has no recipe
# for, which is exactly where the guard belongs.
#
# No newline, matching the corpus: callers interpolate it into their own format.
#
# shellcheck disable=SC2120  # the bare call IS the point: it selects the
# version-file role, which is the documented default above and not an omission.
# Callers that pass a <file> are reading a SIDECAR; both forms are real and
# in-file analysis cannot see the sidecar callers, which live in lib/cmd/version.
read_version() {
  local file="${1:-${DEVBIN_VERSION_FILE:-VERSION}}" role path v=""
  if [ $# -ge 1 ]; then role="${2:-sidecar}"; else role=version-file; fi
  case "$file" in
    /*) path="$file" ;;
    *) path="${PROJECT_ROOT:-.}/$file" ;;
  esac
  if [ -f "$path" ]; then
    case "${path##*/}" in
      mix.exs) v="$(awk -F'"' '/^ *version: *"/ { print $2; exit }' "$path" 2>/dev/null)" || v="" ;;
      Cargo.toml) v="$(awk -F'"' '/^version *= *"/ { print $2; exit }' "$path" 2>/dev/null)" || v="" ;;
      package.json) v="$(awk -F'"' '/"version" *:/ { print $4; exit }' "$path" 2>/dev/null)" || v="" ;;
      # Added by WP-17 so this stays the ONE reader. `version check` needs to
      # read a plist sidecar, and giving it its own extractor would put two
      # patterns on one file kind -- which is how a reader and a writer come to
      # disagree about which line they mean.
      *.plist)
        if [ -x /usr/libexec/PlistBuddy ]; then
          v="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$path" 2>/dev/null)" || v=""
        fi
        ;;
      # The bare-version default reads the WHOLE file, so a file devbin has no
      # recipe for yields its entire contents as the "version" -- a Cargo.lock
      # read back as `#Thisfileis@generatedbyCargo.version=3[[package]]...`,
      # which `version check` then reported as drift against every real version
      # forever (issue 0002). `unknown` is the honest answer and the one every
      # caller here already handles. SIDECAR reads only -- see the role note in
      # the header for why the version file itself reads raw.
      *)
        v="$(tr -d '[:space:]' <"$path" 2>/dev/null)" || v=""
        if [ "$role" = sidecar ]; then
          is_bare_version "$v" || v=""
        fi
        ;;
    esac
  fi
  [ -n "$v" ] || v=unknown
  printf '%s' "$v"
}

# sha256_files <file>... -- `<sum>  <path>` per file, in ONE process.
#
# The tool is spelled differently on the two platforms this ships to and neither
# name is universal: macOS has `shasum` and no `sha256sum`, a minimal Linux
# image usually has `sha256sum` and no perl to back `shasum`. Both accept many
# paths and both print `<sum>  <path>`, which is also the manifest's own line
# format -- so the batch form needs no reshaping at all.
#
# MANY files rather than one, because the caller is always checksumming a whole
# manifest. Per-file it was 26 forks per install and half the wall clock of the
# test suite, which runs an install per fixture.
# sha256_run [file]... -- THE one place that knows how this tool is spelled.
#
# EXTRACTED 2026-09-02 BECAUSE A SECOND COPY HAD ALREADY DIVERGED. A copy of the
# digest elsewhere called `shasum -a 256` directly, and `shasum` is the name
# that does NOT exist on a minimal Linux image -- the exact case the comment
# below was written to cover. The knowledge was documented in one place and
# re-implemented in another: the Highlander failure in its ordinary form, not
# two algorithms but two copies of one DECISION, only one carrying the fix.
#
# Both tools read stdin when given no operands, which is what makes one dispatch
# serve the file case and the stream case.
sha256_run() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$@"
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  else
    die "no sha256 tool found (looked for shasum and sha256sum)"
  fi
}

sha256_files() {
  [ $# -gt 0 ] || return 0
  sha256_run "$@"
}

# sha256_stdin -- SHA256 of stdin, bare hex, no trailing path field.
#
# `sha256_files` deliberately refuses an empty argument list rather than falling
# through to this behaviour, and the two are separate names for that reason: a
# checksum of nothing is a valid-looking hex string that no downstream reader
# can distinguish from a checksum of something.
sha256_stdin() {
  sha256_run | cut -d' ' -f1
}

# ---------------------------------------------------------------------------
# What makes a directory a cargo build tree, as clean classifies one (moved
# here unchanged from lib/cmd/clean, issue 0148: fullcycle asks the same
# question of a tree that kept its release artefacts, and a second answer to
# it drifted -- critic-shell on 0148 v2f). The names keep clean's prefix,
# since the bodies moved byte for byte, and so do their comments: "this
# command" in them is clean, and the "no literal 2" is clean's rule for its
# handler's statuses, which the scan in contract.bats no longer reaches here
# (clean.bats' own arms still go red on it).
# ---------------------------------------------------------------------------

# _clean_shown <path> -- a path as this command prints it: as it is, or quoted
# for the shell when it holds any byte that is not printable ASCII (issue 0141).
# A newline in a listed name printed as two lines, the second looking like a
# tree of its own, in the very list a person reads before answering y; and a
# format character such as U+202E, which [[:cntrl:]] does not match, can make
# one name display as another (the critic's fourth pass). The class is read in
# the C locale, so every byte of a multibyte character counts.
_clean_shown() {
  local LC_ALL=C
  case "$1" in
    *[![:print:]]*) printf '%q' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# _clean_marked_without_read <dir> -- does <dir> carry a cargo marker that needs
# no read: a .rustc_info.json that is a regular file and no link, as find's
# -type f takes it, or a .fingerprint directory under debug/ or release/?
#
# ONE HOME FOR THE QUESTION (the critic's fourth pass on 0131). The walk and the
# classification each decided it, and disagreed: the walk skipped a tag only
# beside .rustc_info.json and classification beside a .fingerprint too, so a
# tree with an unreadable tag and a .fingerprint was a tree when found by name
# and PARTIAL when found by its tag; and the walk's [ -f ] followed a link that
# find's -type f does not, so a tag beside a symlinked .rustc_info.json was
# skipped for a candidate no other line would add.
_clean_marked_without_read() {
  { [ -f "$1/.rustc_info.json" ] && [ ! -L "$1/.rustc_info.json" ]; } ||
    [ -d "$1/debug/.fingerprint" ] || [ -d "$1/release/.fingerprint" ]
}

# _clean_cargo_tag <file> -- is this CACHEDIR.TAG cargo's? 0 yes; 1 no, or no
# such file; 3 when grep could not read it, which says neither, so the caller
# counts the scan as partial and grep's own error names the file (issue 0131).
# 3 and not grep's own 2: 3 is this file's code for a read it could not make,
# and 2 is the dispatcher's.
#
# Cargo's second line names it, and the WHOLE LINE is matched: "# This file is a
# cache directory tag created by cargo." Read off cargo 1.98.1's own output, and
# off estates' target trees, on 2026-09-23 -- pytest's says "created by pytest"
# on the same line. So a line carrying cargo's sentence inside other text is not
# cargo's, and nor is one naming another tool.
#
# A SYMLINK IS NO TAG, as find's -type f already says in _clean_roots: were it
# followed here, a tag the scan never read would be read, and one that could not
# be would make no partial scan (the critic's review of 0131).
_clean_cargo_tag() {
  local rc=0
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  grep -qxF -- '# This file is a cache directory tag created by cargo.' "$1" || rc=$?
  if [ "$rc" -gt 1 ]; then
    # One that vanished between the test and the read is no tag, not an
    # unreadable one (the critic's fourth pass).
    [ -e "$1" ] || return 1
    return 3
  fi
  return "$rc"
}

# _clean_has_markers <dir> <name> <markers> -- does this directory carry build
# output? 0 yes; 1 no; 3 when it could not be read -- the directory itself, or
# the one tag that could have said yes -- which says neither. 3 and not 2: 2 is
# the dispatcher's code, and a handler under lib/cmd answers no literal 2.
#
# For cargo the markers are written by the tool itself and are reliable in a
# redirected target dir too. For _build and .build the toolchain writes no
# comparable tag, so the directory NAME carries that half and the manifest test
# carries the rest.
#
# A TREE FOUND BY NAME IS READ HERE AND NOWHERE ELSE, since the walk prunes at it
# (_clean_roots), so a directory or a tag that cannot be read is this function's
# to report: 3, and the scan counts as partial. The four marker tests are file
# tests, false on "permission denied", so a mode-000 target/ holding every marker
# cargo writes was listed as unmarked at exit 0 with no word at all (the
# critic's third review of 0131).
#
# THE MARKERS THAT NEED NO READ COME FIRST. Beside .rustc_info.json or a
# .fingerprint directory, a tag grep cannot read says nothing more, and reading
# it anyway printed grep's error over a passing result.
#
# A TREE HOLDING ONLY PER-NODE TARGET DIRS IS A BUILD TREE (the critic's third
# review of 0131, with cargo 1.98.1). After `CARGO_TARGET_DIR=target/session-a
# cargo build`, target/ holds session-a/ and nothing of cargo's at its own root,
# so it was listed as unmarked -- on an estate where every session builds that
# way -- and the trees inside it went unlisted, since the walk does not look
# inside a tree found by name. Its per-node directories are what mark it
# (_clean_peer_dirs).
_clean_has_markers() {
  local d="$1" name="$2" markers="$3" t=0 sub
  local -a peers=()
  # EVERY ARM, NOT CARGO'S ALONE (the critic's fourth pass): a mode-000 _build/
  # was listed as removable at size ?, and --force then died on it, after
  # removing whatever sorted before it.
  if [ ! -r "$d" ] || [ ! -x "$d" ]; then
    warn "cannot read $(_clean_shown "$d"): it may be a build tree, and it is not classified"
    return 3
  fi
  if [ "$markers" = cargo ]; then
    _clean_marked_without_read "$d" && return 0
    _clean_cargo_tag "$d/CACHEDIR.TAG" || t=$?
    [ "$t" -ne 0 ] || return 0
    _clean_peer_dirs "$d" peers
    [ "${#peers[@]}" -eq 0 ] || return 0
    [ "$t" -ne 3 ] || return 3
    # NOTHING MARKS IT -- UNLESS A DIRECTORY THAT COULD HOLD A MARKER COULD NOT
    # BE SEARCHED (the critic's fourth pass). Each test above is false on
    # "permission denied", so a target/ whose only marker is debug/.fingerprint,
    # with debug/ unsearchable, read as unmarked at exit 0: that is "could not
    # tell", said as such. SEARCH permission, not read: every marker test inside
    # a directory needs only that (the critic's fifth pass), so a search-only
    # directory is looked in, and one that cannot be searched is not.
    for sub in "$d"/*/; do
      [ -d "$sub" ] || continue
      if [ ! -x "$sub" ]; then
        warn "cannot search $(_clean_shown "${sub%/}"): a marker in it could not be looked for, so $(_clean_shown "$d") is not classified"
        return 3
      fi
    done
    return 1
  fi
  [ "${d##*/}" = "$name" ]
}

# _clean_peer_dirs <dir> -- per-node subdirectories inside a build tree.
#
# Several sessions share one working tree and therefore one target/. Where they
# use CARGO_TARGET_DIR=target/<node> they each own a subdirectory, and one
# node's cache was 33 GB on the day this was specified. Removing the
# parent takes all of them, so they are NAMED before the prompt: whoever is
# mid-build deserves to see their own moniker in the list.
#
# A PER-NODE DIRECTORY IS A CARGO TARGET DIR OF ITS OWN, AND .rustc_info.json IS
# WHAT SAYS SO (issue 0131). This listed every lower-case subdirectory, so the
# SHARED warning fired on Mix's _build/dev, SwiftPM's .build/<triple> and
# cargo's own target/<triple> -- on nearly every project, which teaches a reader
# to skip the one case it exists for. Measured with cargo 1.98.1 on 2026-09-23:
# a nested CARGO_TARGET_DIR carries CACHEDIR.TAG, .rustc_info.json and
# debug/.fingerprint; a --target triple directory carries the first and last
# and NOT .rustc_info.json, which cargo writes at a target dir's root only. So
# the test is that file. Mix's and SwiftPM's layouts never carry it, so the
# same test answers for their arms without naming them. A nested target dir
# need not be a session's: any tool that points CARGO_TARGET_DIR inside target/
# makes one, and removing the parent costs it a rebuild all the same.
#
# THE LIMIT, MEASURED THE SAME DAY: a nested target dir built with
# CARGO_CACHE_RUSTC_INFO=0 has no .rustc_info.json, and its root then reads
# exactly as a triple directory's does, CACHEDIR.TAG and debug/ and nothing
# else. It is not named here and the SHARED warning does not fire for it;
# nothing on disk tells the two apart.
#
# The names go into the array <out-var>, whole (issue 0141): printed one per
# line and read back, a name holding a newline was two names.
_clean_peer_dirs() {
  local dir="$1" sub
  local -n _cpd_out="$2"
  for sub in "$dir"/*/; do
    cargo_target_root "${sub%/}" || continue
    sub="${sub%/}"
    _cpd_out+=("${sub##*/}")
  done
  return 0
}

# cargo_target_root <dir> -- true when <dir> is a cargo target dir's root by
# the file cargo writes there and nowhere else, .rustc_info.json (issue 0131,
# measured on cargo 1.98.1). The one test that tells a per-node target dir
# inside a tree (_clean_peer_dirs) from a target triple's (build_triple_dirs).
cargo_target_root() {
  [ -f "$1/.rustc_info.json" ]
}

# build_triple_dirs <dir> <out-var> -- the target-triple directories inside a
# cargo build tree, as `cargo build --target <triple>` makes them: a directory
# directly inside it, not a link and not the tree's own debug/ or release/,
# holding cargo's lock file, .cargo-lock, in its debug/ or release/, and not a
# target dir's root (cargo_target_root). The artefact check reads a profile in
# each beside the tree's own (issue 0168): a release built only under a triple
# read as missing, and one lost there read as fine. The lock file keeps out a
# directory of another shape, such as a test's executable under
# target/tmp/release (critic-shell on 0168 v1); it is cargo's .fingerprint no
# longer, which cargo writes into build.build-dir when one is set, leaving a
# triple's profile with the lock file and its binaries (critic-shell on 0168
# v2, measured on cargo 1.99.0). A per-node directory built with
# CARGO_CACHE_RUSTC_INFO=0, or under a build.build-dir set to another
# directory, carries no .rustc_info.json and reads as a triple, the limit
# _clean_peer_dirs states.
# Names go into the array <out-var>, whole. Over a tree it cannot list, or a
# directory whose profiles it cannot search, it names nothing; the artefact
# check names those (_fullcycle_tree_listed).
build_triple_dirs() {
  local dir="$1" sub
  local -n _btd_out="$2"
  for sub in "$dir"/*/; do
    sub="${sub%/}"
    case "${sub##*/}" in debug | release) continue ;; esac
    [ ! -L "$sub" ] || continue
    ! cargo_target_root "$sub" || continue
    [ -e "$sub/debug/.cargo-lock" ] || [ -e "$sub/release/.cargo-lock" ] || continue
    _btd_out+=("${sub##*/}")
  done
  return 0
}

# cargo_target_dir_why <value> -- why the artefact check cannot examine a
# CARGO_TARGET_DIR of <value>, as one line; nothing when it can (issue 0148).
# cargo reads a relative value from the directory it runs in, which a caller
# cannot know, `./target` included; a value holding a newline is read a line at
# a time, as two paths; cargo refuses an empty one; and `/`, or any run of
# slashes alone, names no tree the check can read (critic-shell on 0148 v2).
# Only an absolute value below the root can be examined. check targetdir
# refuses an empty value in these words too. Pure: fullcycle refuses on its
# answer before anything is removed, and asks cargo_tree_outside_why next.
# It judges a value, whichever carrier it came from: fullcycle asks it of
# CARGO_TARGET_DIR, of CARGO_BUILD_TARGET_DIR, and of each tree cargo names
# for a config (issue 0150).
cargo_target_dir_why() {
  case "$1" in
    '') printf '%s\n' "is empty, and cargo refuses an empty target directory" ;;
    *$'\n'*) printf '%s\n' "holds a newline, and the artefact check reads build trees a line at a time" ;;
    /*[!/]*) ;;
    /*) printf '%s\n' "is the filesystem root, which the artefact check cannot examine as a build tree" ;;
    *) printf '%s\n' "is relative, and cargo reads it from the directory it runs in, which fullcycle cannot know" ;;
  esac
}

# cargo_tree_outside_why <tree> <root> -- why a build tree at <tree> cannot be
# read as this cycle's: nothing when it lies beneath <root> (issue 0148). Reads
# the filesystem and writes nothing.
#
# THE VALUE IS JUDGED FIRST, BY cargo_target_dir_why, so one value has one
# verdict wherever it is asked (issue 0166). This held a guard of its own that
# knew only "not absolute", and tidied `/` to an empty string, which
# cargo_place answered with a 3 that nothing here read: the filesystem root,
# under any number of slashes, came out "outside the project". No caller met
# it, since each asks cargo_target_dir_why first; a direct question did.
#
# A TREE OUTSIDE THE PROJECT IS NOT REMOVED BY THE CLEAN, which is
# project-scoped, so the artefact check read the last cycle's release
# artefacts in it as this cycle's: a debug-only build passed at rc 0, the very
# signature the check exists for. That is older than 0148 -- cargo_target_dirs
# has returned CARGO_TARGET_DIR since 0139. Judging artefacts newer than the
# cycle's start does not replace it: cargo leaves a fresh release binary's
# mtime as it was (measured, cargo 1.98.1), so a no-op build would read as lost.
#
# OUTSIDE IS NEVER SWEPT; INSIDE IS NOT PROMISED. This refuses only what the
# clean can never remove. Whether it removed a tree inside the project is read
# after it has run, from the tree itself (_fullcycle_kept_release), since the
# clean removes a tree only beside a Cargo.toml and outside .git, node_modules
# and .direnv, and a prediction of that here was a second model of the clean,
# and wrong (critic-shell on 0148 v2d).
#
# PLACED AS IT RESOLVES, by identity. The tree need not exist before the
# build, so its longest existing ancestor is resolved by physical_dir and the
# rest appended; a link inside the project to a directory outside it is not
# followed by the clean's find, so a tree beneath one is outside. Containment
# is asked with -ef up the resolved ancestor, not by comparing text: /var and
# /private/var name one directory on macOS, and APFS ignores case, so a value
# spelled either way was refused though it is the project's. The rest may hold
# no `.` or `..`, since where those land beneath a directory that does not
# exist yet cannot be read. <root> itself is no tree the clean removes either.
cargo_tree_outside_why() {
  local t="$1" root="$2" pa x shown why rc=0
  # THE VALUE FIRST, in cargo_target_dir_why's words: empty, holding a newline,
  # the root, or relative, which the walk up below never ends on (mutant T1 on
  # 0148 v2h, spinning 11 minutes). What passes is absolute and below the root.
  why="$(cargo_target_dir_why "$t")"
  if [ -n "$why" ]; then
    printf '%s\n' "$why"
    return 0
  fi
  while [[ "$t" == *//* ]]; do t="${t//\/\//\/}"; done
  t="${t%/}"
  cargo_place "$t" pa || rc=$?
  # ONLY 0 GOES ON TO THE WALK (issue 0166): a status read by no branch here
  # walked an empty path to "outside", as the root's 3 did. A 3, a path that is
  # not absolute, cannot follow the value check above; it, and any status
  # cargo_place may come to return, is named by its number and never walked.
  case "$rc" in
    0) ;;
    2)
      printf '%s\n' "names . or .. beneath a directory that does not exist yet, so where it lands cannot be known"
      return 0
      ;;
    1)
      printf -v shown '%q' "$pa"
      printf '%s\n' "cannot be placed: $shown cannot be entered, so where it resolves cannot be known"
      return 0
      ;;
    *)
      printf -v shown '%q' "$t"
      printf '%s\n' "cannot be placed: cargo_place answered $rc for $shown, a status this does not read"
      return 0
      ;;
  esac
  if [ "$pa" -ef "$root" ]; then
    printf '%s\n' "is the project root, which the clean does not remove, and the release artefacts left there would read as this cycle's"
    return 0
  fi
  x="$pa"
  while :; do
    [ "$x" -ef "$root" ] && return 0
    _path_parent x || break
  done
  if [ "$pa" = "$t" ]; then
    printf '%s\n' "is outside the project, which the clean does not reach, and the release artefacts left there would read as this cycle's"
  else
    printf -v shown '%q' "$pa"
    printf '%s\n' "resolves to $shown, outside the project, which the clean does not reach, and the release artefacts left there would read as this cycle's"
  fi
}

# cargo_place <path> <out-var> -- <path>, absolute, placed as it resolves, into
# <out-var>: its longest existing ancestor resolved by physical_dir, the rest
# appended as written (issue 0150; cargo_tree_outside_why's until then). The
# one statement of where a tree devbin did not make lands: the path need not
# exist, as a build tree before its build does not. 1 when the ancestor cannot
# be entered, <out-var> then holding it; 3, at once, when <path> is not
# absolute; 2 when the rest names . or ..,
# since where those land beneath a directory that does not exist yet cannot be
# read. A `..` in the existing part is the kernel's, and is resolved with it,
# so cargo's `native/cli/../../target` is placed at the project's target.
cargo_place() {
  local _cp_t="$1" _cp_a _cp_rest="" _cp_pa
  local -n _cp_out="$2"
  # An absolute path only, returning 3 at once for any other: the walk up
  # below never ends on one with no leading / (mutant T1 on 0148 v2h).
  case "$_cp_t" in
    /*) ;;
    *)
      _cp_out="$_cp_t"
      return 3
      ;;
  esac
  _cp_a="$_cp_t"
  while [ -n "$_cp_a" ] && [ ! -e "$_cp_a" ] && [ ! -L "$_cp_a" ]; do
    _cp_rest="${_cp_a##*/}${_cp_rest:+/$_cp_rest}"
    _cp_a="${_cp_a%/*}"
  done
  [ -n "$_cp_a" ] || _cp_a=/
  case "/$_cp_rest/" in
    */./* | */../*)
      _cp_out="$_cp_t"
      return 2
      ;;
  esac
  if ! physical_dir "$_cp_a" _cp_pa; then
    _cp_out="$_cp_a"
    return 1
  fi
  _cp_out="${_cp_pa%/}${_cp_rest:+/$_cp_rest}"
  [ -n "$_cp_out" ] || _cp_out=/
}

# _path_parent <var> -- the directory above the absolute path in <var>, into
# it; 1 at /. The one step every walk up a path takes (issue 0150).
_path_parent() {
  local -n _pp_p="$1"
  [ "$_pp_p" != / ] || return 1
  _pp_p="${_pp_p%/*}"
  [ -n "$_pp_p" ] || _pp_p=/
}

# build_tree_rebuildable <tree> <manifest> -- 0 when <manifest> sits beside
# <tree>, on the path as given: clean's own test of a tree it can rebuild, and
# so of one it removes (issue 0167). One test for clean, which removes such a
# tree, fullcycle, which reads one it cannot as kept, and check targetdir,
# whose shared tree is <root>/target only where clean removes it: check named
# it shared without one, and passed a nested crate's CARGO_TARGET_DIR that
# clean never removes and fullcycle then failed.
build_tree_rebuildable() {
  local t="${1%/}"
  [ -f "${t%/*}/$2" ]
}

# cargo_tree_same <a> <b> -- true when two build trees are one: the same text,
# or the same directory where both exist. Compare trees as cargo_place placed
# them, since cargo does not tidy a `..`. check targetdir's until issue 0164,
# which put fullcycle's question about the machine's config to it too.
cargo_tree_same() {
  [ "$1" = "$2" ] || { [ -e "$1" ] && [ "$1" -ef "$2" ]; }
}

# cargo_tree_cause <tree> <project-tree> <machine-tree> -- which config sends a
# crate's build tree to <tree>, all three placed: `project` when it is the tree
# the project root's config names (cargo_project_tree), else `machine` when it
# is where the machine's config alone sends every crate (cargo_home_build_dir),
# else nothing, a config this does not read. The project's first, as cargo puts
# it before the machine's. The one attribution, check targetdir's until issue
# 0164: fullcycle's refusal asked only for the machine's, so a tree both
# configs name was "the machine's" there while check targetdir failed it as
# the project's.
cargo_tree_cause() {
  if [ -n "$2" ] && cargo_tree_same "$1" "$2"; then
    printf 'project\n'
  elif [ -n "$3" ] && cargo_tree_same "$1" "$3"; then
    printf 'machine\n'
  fi
  return 0
}

# cargo_home_dir -- CARGO_HOME, or cargo's default, ~/.cargo, with no trailing
# slash: the one statement of where the machine's cargo config lives (issue
# 0150).
cargo_home_dir() {
  local h="${CARGO_HOME:-$HOME/.cargo}"
  printf '%s\n' "${h%/}"
}

# cargo_config_file <dir> -- the config file cargo reads in the config
# directory <dir>, a .cargo or CARGO_HOME, or nothing when it reads none:
# `config` where it can be opened, else `config.toml` where it is there at all.
# Measured on cargo 1.99.0, in CARGO_HOME and in a project's .cargo alike: with
# both there it reads `config`, warning, even a `config` that names nothing; a
# `config` it cannot open, or a dangling link, it passes over in silence; and a
# config.toml it cannot read, it fails on. The one statement of which file
# that is (issue 0164): check targetdir read config.toml first, so it named,
# and took the value of, a file cargo ignores.
cargo_config_file() {
  if [ -r "${1%/}/config" ]; then
    printf '%s\n' "${1%/}/config"
  elif [ -e "${1%/}/config.toml" ]; then
    printf '%s\n' "${1%/}/config.toml"
  fi
  return 0
}

# cargo_config_target_dir <file> -- the build.target-dir a cargo config file
# sets, as its text reads, or nothing; the first such line. It names a cause and
# decides nothing: cargo's answer is the verdict (issue 0150). It reads the
# plain spelling only, `target-dir = "..."`; the machine's config is placed by
# asking cargo (cargo_home_build_dir), whatever its spelling. check targetdir's
# own until issue 0164, which puts the project's config to fullcycle too, under
# errexit: sed quits at the first match rather than feeding `head -1`, which
# could end it on a SIGPIPE with a value already read.
cargo_config_target_dir() {
  sed -n '/^[[:space:]]*target-dir[[:space:]]*=[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/{s//\1/p;q;}' "$1"
}

# cargo_project_tree <file-var> <value-var> <tree-var> -- the project root's
# cargo config, the file cargo reads there (cargo_config_file), when it names
# build.target-dir; the value it sets (as cargo_config_target_dir reads it); and
# the tree that value places, from the project root as cargo reads a relative
# one: into the three, each empty when it names none. One reading for check
# targetdir, which fails a fork this config makes, and fullcycle, whose refusal
# names it (issue 0164). It took the first of config.toml and config to name a
# value, so with both there it named, and placed, a file cargo ignores (issue
# 0176). A file that cannot be read names nothing here; cargo, asked, names why.
cargo_project_tree() {
  local -n _cpt_f="$1" _cpt_v="$2" _cpt_t="$3"
  local _cpt_c _cpt_x="" _cpt_p
  _cpt_f="" _cpt_v="" _cpt_t=""
  _cpt_c="$(cargo_config_file "$PROJECT_ROOT/.cargo")"
  if [ -n "$_cpt_c" ] && [ -f "$_cpt_c" ] && [ -r "$_cpt_c" ]; then
    _cpt_x="$(cargo_config_target_dir "$_cpt_c")" || _cpt_x=""
  fi
  [ -n "$_cpt_x" ] || return 0
  _cpt_f="$_cpt_c" _cpt_v="$_cpt_x"
  case "$_cpt_v" in /*) _cpt_p="${_cpt_v%/}" ;; *) _cpt_p="$PROJECT_ROOT/${_cpt_v%/}" ;; esac
  cargo_place "$_cpt_p" _cpt_t || _cpt_t="$_cpt_p"
}

# cargo_env_carrier -- the name of the environment variable that decides
# cargo's build tree, set at all, empty included: CARGO_TARGET_DIR, which cargo
# puts first, or else CARGO_BUILD_TARGET_DIR; nothing when neither is set
# (measured, cargo 1.98.1). The one statement of their precedence (issue 0150).
cargo_env_carrier() {
  if [ -n "${CARGO_TARGET_DIR+x}" ]; then
    printf 'CARGO_TARGET_DIR\n'
  elif [ -n "${CARGO_BUILD_TARGET_DIR+x}" ]; then
    printf 'CARGO_BUILD_TARGET_DIR\n'
  fi
}

# cargo_walk <find expression> -- find_walk over this project with the prunes
# every cargo walk shares: somebody else's crates and trees, never this
# project's (issue 0150; cargo_target_dirs' walk until then). find_walk's
# status.
cargo_walk() {
  # find-status: returned to the caller, and each caller reads it.
  find_walk "${PROJECT_ROOT:-.}" -ignore_readdir_race \
    \( -name .git -o -name node_modules -o -name .direnv \
       -o -name deps -o -name _build -o -name .venv \) -prune -o "$@"
}

# cargo_carrier_present <dir> -- 0 when a cargo config that could move the
# build tree of the crate in <dir> is present: a .cargo/config.toml or
# .cargo/config naming target-dir in <dir> or any directory above it, or a
# config.toml or config naming it in CARGO_HOME (issue 0150).
#
# PRESENCE ONLY: it asks whether a file names the key, never what the key
# sets, so cargo stays the one resolver (cargo_build_dir): it decides WHETHER
# cargo is asked, never WHERE the tree is. The match is safe
# because every spelling of the key holds the literal `target-dir`: dotted as
# build.target-dir, under a [build] table, or quoted. It fails open: a file
# that cannot be read is present, for cargo to answer, and a comment naming
# the key only asks cargo, which then answers the default. A file naming
# `include` opens it too, since the file it includes may name the key. With
# none present, cargo builds a crate into its workspace's own target, which
# the walk finds, and nothing asks cargo: a project with no carrier is
# untouched by 0150, and needs no cargo. The environment's two carriers are the caller's to read, since
# either decides the tree over any config.
cargo_carrier_present() {
  cargo_config_above "$1" && return 0
  cargo_config_in_home && return 0
  return 1
}

# cargo_config_above <dir> [--not-home] -- 0 when a .cargo/config.toml or
# .cargo/config naming target-dir or include sits in <dir> or any directory
# above it: the gate's walk up, CARGO_HOME aside. With --not-home, CARGO_HOME's
# own config files are passed over where the walk meets them, as ~/.cargo is
# met from beneath $HOME: cargo reads that file once, as the machine's
# (critic-shell on 0150 v2c: with TMPDIR under $HOME the probe gave up, and a
# machine-wide fork failed). A directory that cannot be placed is 0, failing
# open.
cargo_config_above() {
  local d f h
  physical_dir "$1" d || return 0
  h="$(cargo_home_dir)"
  while :; do
    for f in "${d%/}/.cargo/config.toml" "${d%/}/.cargo/config"; do
      if [ "${2:-}" = --not-home ] && { [ "$f" -ef "$h/config.toml" ] || [ "$f" -ef "$h/config" ]; }; then
        continue
      fi
      _cargo_names_target_dir "$f" && return 0
    done
    _path_parent d || break
  done
  return 1
}

# cargo_config_in_home -- 0 when the config cargo reads in CARGO_HOME
# (cargo_config_file) names target-dir or include. Either file named it until
# issue 0164, the one cargo ignores included.
cargo_config_in_home() {
  local f
  f="$(cargo_config_file "$(cargo_home_dir)")"
  [ -n "$f" ] && _cargo_names_target_dir "$f"
}

# _cargo_names_target_dir <file> -- 0 when <file> exists and names target-dir,
# or includes another config, which may (cargo's stable `include`, critic-shell
# on 0150 v1: an included file built into /tmp while the gate stayed shut), or
# cannot be read.
_cargo_names_target_dir() {
  local rc=0
  [ -e "$1" ] || [ -L "$1" ] || return 1
  grep -q -e 'target-dir' -e 'include' -- "$1" 2>/dev/null || rc=$?
  # 1 is a file read whole without the key; anything else is not read whole,
  # and cargo, asked, names why in its own words, so grep's are not shown.
  [ "$rc" -ne 1 ]
}

# cargo_build_dir <dir> <tree-var> <root-var> [<from-dir>] -- where cargo builds
# the crate in <dir>, into <tree-var>, and its workspace's root, whose own
# target is the tree when nothing moves it, into <root-var>; asked of cargo run
# in <dir>, where `cd <dir> && cargo build` runs it, the config found from there
# included (issue 0150). Each path comes back as cargo wrote it, byte for byte:
# jq writes the two NUL-terminated and they are read with `read -d ''`, where
# @tsv escaped a backslash, a tab and a newline, and a crate at `a\b` was read
# at `a\\b` (critic-shell on 0150 v1). CARGO_TARGET_DIR and
# CARGO_BUILD_TARGET_DIR are removed from cargo's environment, so the answer is
# the configs' alone: either variable is its caller's to judge, as a value.
# Given <from-dir>, cargo runs there with --manifest-path naming <dir>, and so
# reads the configs found from <from-dir>, as it finds them from where it runs
# (measured, cargo 1.99.0; issue 0163). `--offline --no-deps` reads no network
# and resolves no dependency, and leaves Cargo.lock as it was (measured); colour
# is off, so the error line quoted is plain. Fails naming cargo's own first
# error line, or jq's absence. Its scratch directory is removed on every return;
# an interrupt while cargo runs leaves it in TMPDIR, named devbin-cargo.*.
cargo_build_dir() {
  local _cbd_d="$1" _cbd_s _cbd_rc=0 _cbd_line _cbd_from="${4:-}"
  local -n _cbd_tree="$2" _cbd_root="$3"
  _cbd_tree="" _cbd_root=""
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq is not on PATH, so cargo's answer for where $_cbd_d builds cannot be read"
    return 1
  fi
  _cbd_s="$(mktemp -d "${TMPDIR:-/tmp}/devbin-cargo.XXXXXX")" || {
    warn "cannot ask cargo where $_cbd_d builds: no scratch directory"
    return 1
  }
  (
    unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR
    if [ -n "$_cbd_from" ]; then
      cd -- "$_cbd_from" && CARGO_TERM_COLOR=never cargo metadata --offline --no-deps --format-version 1 --manifest-path "$_cbd_d/Cargo.toml"
    else
      cd -- "$_cbd_d" && CARGO_TERM_COLOR=never cargo metadata --offline --no-deps --format-version 1
    fi
  ) >"$_cbd_s/out" 2>"$_cbd_s/err" || _cbd_rc=$?
  if [ "$_cbd_rc" -ne 0 ]; then
    _cbd_line="$(grep -m 1 '^error' "$_cbd_s/err")" || _cbd_line="$(grep -m 1 . "$_cbd_s/err")" || _cbd_line="it exited $_cbd_rc"
    rm -rf "$_cbd_s"
    warn "cargo cannot say where $_cbd_d builds: $_cbd_line"
    return 1
  fi
  if ! jq -j '(.target_directory // ""), "\u0000", (.workspace_root // ""), "\u0000"' "$_cbd_s/out" >"$_cbd_s/fields"; then
    rm -rf "$_cbd_s"
    warn "jq could not read cargo's answer for where $_cbd_d builds (its error is above)"
    return 1
  fi
  { IFS= read -r -d '' _cbd_tree && IFS= read -r -d '' _cbd_root; } <"$_cbd_s/fields" || _cbd_rc=1
  rm -rf "$_cbd_s"
  if [ "$_cbd_rc" -ne 0 ] || [ -z "$_cbd_tree" ] || [ -z "$_cbd_root" ]; then
    warn "cargo named no build directory for $_cbd_d"
    return 1
  fi
}

# cargo_build_dirs <crates> <trees> [<roots> [<configs> [<holes>]]] -- into the arrays, one
# entry each per crate under this project with a carrier present
# (cargo_carrier_present): its directory, the tree cargo_build_dir names, and
# its workspace's root; nothing for a crate with none. Parallel arrays, never
# one delimited string, since a path may hold any byte but NUL. The roots are
# a caller's to ask for: named as nothing, or as an empty name, they are filled
# into a local and dropped, as fullcycle, which judges trees and never roots,
# asks (issue 0169: a third name was required, and a call naming two died on
# an unbound $3). 1 when cargo is
# not on PATH or cannot answer, named on stderr: where a crate's tree is cannot
# then be known. 2 when the walk could not read everything, having asked about
# every crate it did find: a crate beneath the hole is unseen, which is the
# hole's to answer for, not a carrier's -- the walks after it fail a cycle over
# it (issue 0139) -- so a project with no carrier anywhere is not refused
# for it.
# Each crate with a carrier is asked, a template's included: one cargo cannot
# read is refused in cargo's words, declared (issue 0150). With a
# fourth array named, each .cargo/config.toml or .cargo/config the walk met
# that names target-dir or include is put in it, so a caller can tell a
# config beneath the project whose crates the walk never reached (critic-shell
# on 0150 v2c). With a fifth named, each directory the walk could not search is
# put in it, as find_walk records it, and one empty entry where the walk failed
# somewhere it could not place, so a caller can ask whether a hole lies beneath
# a config (issue 0163). Every name past the second is optional.
cargo_build_dirs() {
  local -a _cbds_noroots=()
  local -n _cbds_c="$1" _cbds_t="$2" _cbds_r="${3:-_cbds_noroots}"
  local _cbds_m _cbds_d _cbds_tree _cbds_root _cbds_rc=0 _cbds_cfgname="${4:-}" _cbds_hname="${5:-}" _cbds_hf=""
  local -a _cbds_list=() _cbds_met=()
  _cbds_c=() _cbds_t=() _cbds_r=()
  # NUL-separated, read whole with its status (critic-shell on 0150 v2: read
  # a line at a time, a crate directory whose name ends in a newline split,
  # its config unseen, and the cycle read INCONCLUSIVE at rc 0).
  # find-status: read by `wait "$!"` below, on this process substitution.
  # A config is one directly in a .cargo directory, never one beneath it, as
  # a project-local CARGO_HOME's .cargo/git/db/<repo>/config is not; a manifest
  # or a config may be a link, which cargo follows (critic-shell on 0150 v2d).
  if [ -n "$_cbds_hname" ]; then
    # mktemp names its own failure; with no file the holes cannot be read
    # back, and the empty entry below counts one beneath every config.
    _cbds_hf="$(mktemp "${TMPDIR:-/tmp}/devbin-holes.XXXXXX")" || _cbds_hf=""
  fi
  mapfile -d '' -t _cbds_list < <(FIND_WALK_HOLES="$_cbds_hf" cargo_walk -name target \( -type d -o -type l \) -prune -o \
    \( -name Cargo.toml \( -type f -o -type l \) -print0 \) -o \
    \( \( -path '*/.cargo/config.toml' -o -path '*/.cargo/config' \) \( -type f -o -type l \) -print0 \))
  if ! wait "$!"; then
    warn "could not read the whole project for its crates (the error above names it), so a crate beneath what it could not read was not asked about"
    _cbds_rc=2
  fi
  if [ -n "$_cbds_hname" ]; then
    local -n _cbds_h="$_cbds_hname"
    _cbds_h=()
    if [ -n "$_cbds_hf" ]; then
      mapfile -d '' -t _cbds_h <"$_cbds_hf"
      rm -f "$_cbds_hf"
    fi
    # A hole none was read back for lies, for all a caller can tell, beneath
    # everything: one empty entry says so.
    [ "$_cbds_rc" -ne 2 ] || [ "${#_cbds_h[@]}" -gt 0 ] || _cbds_h=("")
  fi
  for _cbds_m in ${_cbds_list[@]+"${_cbds_list[@]}"}; do
    [ -n "$_cbds_m" ] || continue
    case "$_cbds_m" in
      */.cargo/config.toml | */.cargo/config)
        ! _cargo_names_target_dir "$_cbds_m" || _cbds_met+=("$_cbds_m")
        continue
        ;;
    esac
    _cbds_d="${_cbds_m%/*}"
    cargo_carrier_present "$_cbds_d" || continue
    if ! command -v cargo >/dev/null 2>&1; then
      warn "cargo is not on PATH, so where $_cbds_d builds cannot be known: a cargo config there names target-dir or include"
      return 1
    fi
    cargo_build_dir "$_cbds_d" _cbds_tree _cbds_root || return 1
    _cbds_c+=("$_cbds_d")
    _cbds_t+=("$_cbds_tree")
    _cbds_r+=("$_cbds_root")
  done
  if [ -n "$_cbds_cfgname" ]; then
    local -n _cbds_cfgs="$_cbds_cfgname"
    _cbds_cfgs=(${_cbds_met[@]+"${_cbds_met[@]}"})
  fi
  return "$_cbds_rc"
}

# cargo_probe_build_dir <tree-var> [<from-dir>] -- where cargo sends a crate's
# build tree from <from-dir>, placed (cargo_place), into <tree-var>; empty when
# nothing moves it from the crate's own target. A throwaway crate in a scratch
# directory is asked of cargo run in <from-dir> (cargo_build_dir), which reads
# the configs found from there, so the answer is what a config there or above
# pins for any crate beneath it, whatever its spelling: the one probe (issue
# 0163), which check targetdir asks of a config over a hole beneath it. With no
# <from-dir> it is asked from the scratch directory itself: the machine's
# reading, cargo_home_build_dir. Statuses as below.
#
# cargo_home_build_dir <tree-var> -- where the machine's cargo config alone
# sends a crate's build tree, placed as it resolves (cargo_place), into
# <tree-var>; empty when it moves nothing (issue 0150). The one reading of the
# machine's config: check targetdir attributes a fork to it, and fullcycle
# names its file, by this answer, compared with cargo_tree_same (issue 0164).
# Asked of cargo in an empty scratch directory
# holding a throwaway crate, where no config but CARGO_HOME's applies, so the
# answer is the home config's, in whatever spelling it takes: sed read only
# `target-dir = "..."` and passed over a dotted key, a comment and the legacy
# file name (critic-shell on 0150 v1). 1, named, when cargo cannot say, or is
# not on PATH. 2, unnamed, when a config at or above the scratch directory, or
# one the walk up cannot read, may apply too, so the
# machine's alone cannot be told: nothing is said to be the machine's, and a
# caller reporting the machine's config says it could not be measured, never
# that it moves nothing (issue 0164).
cargo_probe_build_dir() {
  local -n _chb_out="$1"
  local _chb_s _chb_p _chb_tree _chb_root _chb_rc=0 _chb_from="${2:-}"
  local _chb_what="the machine's cargo config"
  _chb_out=""
  [ -z "$_chb_from" ] || _chb_what="the cargo config found from $_chb_from"
  # Asked with no crate here too, so cargo may not be there at all: said once,
  # plainly, not as cargo's failure in a scratch directory already gone.
  if ! command -v cargo >/dev/null 2>&1; then
    warn "cargo is not on PATH, so where $_chb_what sends a build cannot be measured"
    return 1
  fi
  _chb_s="$(mktemp -d "${TMPDIR:-/tmp}/devbin-cargohome.XXXXXX")" || {
    warn "cannot ask cargo about $_chb_what: no scratch directory"
    return 1
  }
  if ! { mkdir -p "$_chb_s/probe/src" &&
    printf '[package]\nname = "probe"\nversion = "0.0.0"\nedition = "2021"\n\n[workspace]\n' >"$_chb_s/probe/Cargo.toml" &&
    : >"$_chb_s/probe/src/main.rs"; }; then
    rm -rf "$_chb_s"
    warn "cannot ask cargo about $_chb_what: the probe crate could not be written in $_chb_s"
    return 1
  fi
  # THE PROBE HEARS EVERY CONFIG ABOVE IT, not CARGO_HOME's alone, so one
  # above the scratch directory makes its answer no measure of the machine's
  # (critic-shell on 0150 v2: with TMPDIR inside the project, the project's own
  # fork was reported as the machine's and not failed). Then nothing is said
  # to be the machine's.
  # Asked from <from-dir>, cargo reads what is found from there, never what
  # sits above the scratch directory, so only the machine's reading is clouded.
  # The probe declares its own [workspace]: beneath a project's workspace, as
  # under a TMPDIR inside it, cargo refused a package that workspace does not
  # list, and a correct project failed (critic-shell on 0163 v3).
  if [ -z "$_chb_from" ] && cargo_config_above "$_chb_s/probe" --not-home; then
    rm -rf "$_chb_s"
    return 2
  fi
  cargo_build_dir "$_chb_s/probe" _chb_tree _chb_root "$_chb_from" || _chb_rc=1
  if [ "$_chb_rc" -eq 0 ] && ! physical_dir "$_chb_s/probe" _chb_p; then
    warn "cannot place the probe crate in $_chb_s, so where $_chb_what sends a build cannot be measured"
    _chb_rc=1
  fi
  if [ "$_chb_rc" -eq 0 ] && [ "$_chb_tree" != "$_chb_p/target" ] &&
    [ "$_chb_tree" != "$_chb_root/target" ]; then
    cargo_place "$_chb_tree" _chb_out || _chb_out="$_chb_tree"
  fi
  rm -rf "$_chb_s"
  return "$_chb_rc"
}

cargo_home_build_dir() {
  cargo_probe_build_dir "$1"
}

# cargo_target_dirs [<tree>...] -- every cargo build tree under this project,
# discovered, and each <tree> named (issue 0150: what cargo said it builds into).
#
# NOT `$PROJECT_ROOT/target`, WHICH IS THE ASSUMPTION THIS FUNCTION EXISTS TO
# REPLACE. A cargo tree sits at the WORKSPACE root, and a workspace is very
# often nested: one project builds into `native/cli/target`, another into
# `native/rust/target`. A checker that looks only at the project root finds
# nothing on those estates, concludes nothing is wrong, and reports a clean
# result -- which is the same shape as the defect it was written to catch, and
# was the first draft of exactly that check.
#
# DELIBERATELY NOT SHARED WITH `_clean_roots`, and the reason is what each one
# is FOR rather than what each one does. Clean discovers trees it is about to
# DELETE, so it demands cargo's own markers (CACHEDIR.TAG, .rustc_info.json, a
# profile .fingerprint) before touching a directory that merely has the right
# name -- the cost of being wrong there is removing somebody's source tree. This
# only READS, across several languages' worth of layouts, and a directory named
# `target` holding an executable is the thing being asked about whether or not
# cargo has stamped it yet. Sharing one function would force one of those two
# risk postures onto the other.
#
# The variable cargo_env_carrier names wins outright when set: cargo writes
# there and nowhere else, so a discovered tree would be a stale one.
#
# DEPENDENCY TREES ARE PRUNED, AND THE POPULATION IS THE POINT.
# A project can carry five Cargo.toml files of which exactly one is its own:
# the other four are Elixir NIF crates under `deps/`, built through mix by
# Rustler rather than by cargo in place. A caller asking "did MY build restore
# MY artefacts" must not be answered about somebody else's crate. If a dep ever
# does grow a `target/` -- somebody runs a bare `cargo build` in one for their
# own reasons -- the populated-debug-empty-release signature appears there with
# no cycle having caused it, and the check goes red on a tree the project's
# build never touches.
#
# A CHECK THAT CRIES WOLF ON FOUR TREES OUT OF FIVE GETS ITS OUTPUT IGNORED,
# which is the same end state as the vacuity it replaces, arrived at from the
# other direction. Same argument that killed the >1-test-target rule.
#
# Note what does NOT need pruning: a crate with no `target/` at all -- which is
# all four NIF crates above -- is invisible here by construction, because this
# discovers BUILD TREES and never crates. There is nothing to skip.
#
# A WALK THAT CANNOT READ EVERYTHING RETURNS 1, having printed what it did find,
# with find's own error left on stderr to name the path (issue 0139). It sent
# that error to /dev/null in a pipeline ending `; return 0`: under errexit the
# failed pipeline ended its caller with no word, and read through a process
# substitution it was simply a shorter list, so a tree beneath an unreadable
# directory was never checked for its release binaries and nothing said so.
cargo_target_dirs() {
  local found sorted t k kept="" rc=0
  local -a dirs=()
  # A SET CARGO_TARGET_DIR, OR ELSE CARGO_BUILD_TARGET_DIR, IS RETURNED AS IT
  # IS, UNCHECKED: either decides cargo's tree over any config (measured, cargo
  # 1.98.1: CARGO_TARGET_DIR over CARGO_BUILD_TARGET_DIR over build.target-dir).
  # cargo_target_dir_why and cargo_tree_outside_why say which values can be
  # examined, and fullcycle, the one caller, refuses the rest before this is
  # reached. A new caller asks them first.
  t="$(cargo_env_carrier)"
  if [ -n "$t" ]; then
    printf '%s\n' "${!t%/}"
    return 0
  fi
  # -ignore_readdir_race: a build running beside the cycle creates and deletes
  # as it goes, and an entry that vanished mid-walk failed it -- 1 in 6 cycles
  # read ARTEFACT CHECK INCOMPLETE with a writer beside it (critic-shell on 0139).
  #
  # A target THAT IS A LINK IS A TREE TOO (critic-shell on 0139 v2e): under
  # find's default -P a link is -type l and never -type d, so a target/ reached
  # through one was never listed, and the cycle read "NO cargo build tree" and
  # INCONCLUSIVE at rc 0 over a debug/ with no release/ beside it. Links are
  # listed with the directories. A link naming a file is no tree and is
  # dropped; one naming nothing, or naming what cannot be reached, is kept, so
  # the check names it as gone or as out of reach rather than passing over it
  # unsaid (critic-shell on 0139 v2f). A directory named by two paths -- a link
  # beside the tree it names -- is one tree, kept once under the first path in
  # the C locale's order, so it is not examined and reported twice. What this
  # walk does NOT do, declared: it never enters a directory that is itself a
  # link (find's default -P), so a tree beneath one is not seen, since following
  # such links risks loops and walks outside the project; and it reads paths a
  # line at a time, so a path holding a newline is not one path.
  found="$(cargo_walk -name target \( -type d -o -type l \) -prune -print)" || rc=1
  # AND THE TREES CARGO NAMED (issue 0150): a crate whose config moves its tree
  # builds where the walk may not look, as `out` rather than `target`.
  [ "$#" -eq 0 ] || found="${found:+$found$'\n'}$(printf '%s\n' "$@")"
  [ -z "$found" ] || sorted="$(printf '%s\n' "$found" | LC_ALL=C sort)" || rc=1
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    if [ -d "$t" ]; then
      for k in "${dirs[@]}"; do
        [ "$t" -ef "$k" ] && continue 2
      done
      dirs+=("$t")
    elif [ -e "$t" ]; then
      continue
    fi
    kept+="$t"$'\n'
  done <<<"${sorted:-}"
  printf '%s' "$kept"
  return "$rc"
}

# FIND_WALK_HOLES is cargo_build_dirs' to set for one walk, and FIND_WALK_QUIET
# find_walk's own, never the environment's: one inherited would have every walk
# append to it, or print nothing.
unset FIND_WALK_HOLES FIND_WALK_QUIET

# find_walk [-H|-L|-P] <path>... [global options] <expression> -- find, with a
# directory it can list but not search named and pruned, and its status raised
# (issue 0145). Prints what find prints, on stdout, untouched. Returns find's
# status, or 1 when any such directory was met, each named on stderr:
#
#   cannot search <dir> -- nothing beneath it was looked at
#
# THE CLASS. macOS's find passes over a directory it can list but not search,
# mode 0444 or 0644, below its start point: it prints nothing beneath it, says
# nothing, and exits 0, so every walk that descends read the tree beneath one
# as absent at rc 0. GNU find lists the names beneath it and cannot open what
# they name, so a walk that goes on to read them fails later and less clearly.
# One clause, asked of the running user as clean asked it, prunes such a
# directory under both finds and records it, so the two give one verdict.
# A directory find cannot read at all keeps find's own error and
# status, and is not named twice.
#
# - THE CLAUSE comes after the start paths and any leading global options
#   (-maxdepth, -mindepth, -ignore_readdir_race, -xdev, -mount), before the
#   caller's expression, which it wraps in parentheses. It is false either way,
#   so the caller's expression still sees that directory itself (a walk for
#   directories named target still finds one at 0644); it only never looks
#   beneath it.
# - THE CALLER'S OWN PRUNE IS ASKED FIRST (critic-shell on 0145 v1): an
#   expression opening `\( ... \) -prune -o`, the idiom every caller uses, has
#   that group lifted ahead of the clause, as clean's own clause sat after its
#   prune, so a directory the caller never meant to enter is never examined:
#   a .git at 0644 failed clean's walk, and with it fullcycle's clean. A prune
#   spelled any other way is evaluated after the clause. The group is found by
#   counting the `(` and `)` words, so one given as a value, as in `-name '('`,
#   leaves it unlifted: the walk then examines what it prunes, and says so.
# - THE EXEC IS NARROWED to a directory missing an x bit that the running user
#   does not own with u+x set, read from $EUID and never from an `id` found
#   through PATH: only the owner bits apply to the owner, so the
#   0700 and 0750 directories of an ordinary tree run none. Without the owner
#   test every such directory cost one /bin/sh, and a census walk over a
#   machine's roots ran 3.3 times as long (measured).
# - WHAT IT RUNS IS /bin/sh, NAMED WHOLE, and nothing found through PATH, as
#   clean's walk named it (0131): a project's own bin/test first on PATH was
#   run by a walk that promised to change nothing. Where /bin/sh cannot be run
#   the walk refuses at status 2, naming it, before find starts: BSD find
#   reports each failed exec and still exits 0, with the hole silent beneath.
# - A GLOBAL -mindepth ABOVE 1 IS REFUSED at status 2: find does not evaluate
#   the clause above that depth, so a directory there would be entered
#   unexamined. -mindepth 1 leaves out only the start paths, and find reports
#   a start path it cannot search itself.
# - A DECLARED LIMIT: the clause reads mode bits, so a directory
#   whose ACL denies the running user search, its mode bits allowing it, is not
#   asked about, and BSD find passes over what is beneath it silently, as
#   before. clean's page says so. Probing each directory's ACL would cost a
#   process per directory, which the owner pre-filter exists to avoid.
# - THE RECORDS reach this function on fd 3, NUL-terminated, through a process
#   substitution read by mapfile, and find's status by `wait "$!"`, the idiom
#   find_list and clean's walk use; `$(...)` drops NUL bytes and ran two
#   records together. find's own stdout goes to the caller through a saved
#   descriptor.
# - A WALK BOUNDED BY -maxdepth never enters a directory at that depth, so what
#   one hides is nothing it asked for: such a record is dropped when every
#   start path it lies under puts it at or beyond -maxdepth, and kept when any
#   would have entered it. Each directory is named once, however many start
#   paths reached it or however many slashes spell it.
# - EVERY HOLE IS RECORDED, as a path and its kind, on fd 3: S for a directory
#   it can list but not search, which this prunes and names, and U for one it
#   cannot read at all, which find names. The clause also runs for a directory
#   missing a read bit the running user does not own u+r on, so a 0711 or 0311
#   one is recorded too (critic-shell on 0163 v1). With FIND_WALK_HOLES naming
#   a file, each hole's path is appended to it, NUL-terminated, and one empty
#   record when find failed with none recorded, so a caller can ask where the
#   walk's holes are (issue 0163: check targetdir asks what a crate beneath one
#   would build into). Each is filtered by -maxdepth, as a named one is. Where
#   find failed with a U recorded, the walk is run again, quietly, with every
#   hole pruned, so a failure the records do not place, as an ACL denying a
#   listing the mode bits allow, still gets its empty record (critic-shell on
#   0163 v2: one 000 directory hid it). The re-walk is find_walk itself with
#   FIND_WALK_QUIET=1, which prunes every hole, prints and records nothing,
#   and returns find's status. Its cost is a second walk whenever find failed
#   with a U recorded, whether or not the caller then reads the holes:
#   measured at about 1.8 times one walk on a tree of 7,200 directories
#   (critic-shell on 0163 v3). The expression then runs twice, so with
#   FIND_WALK_HOLES set one with an action beyond printing, in the expression
#   or a lifted prune group, is refused at status 2. An ACL denying only
#   search is still unseen, as the limit above says.
# - FIND'S STATUS IS READ WITHOUT ERREXIT'S ABORT, so a find that failed on one
#   directory still has every unsearchable one named after it.
# - The expression must carry -print or -print0, since the clause's -exec
#   suppresses find's implicit -print; otherwise status 2, naming it.
#
# find_list is built on this: find_walk, sorted, read into an array. The locals
# carry their own prefix, as find_list's do.
find_walk() {
  local -a _fw_pre=() _fw_paths=() _fw_glob=() _fw_expr=() _fw_marks=() _fw_prune=() _fw_sel=() _fw_args=("$@")
  local _fw_rc _fw_d _fw_p _fw_rel _fw_max="" _fw_fd _fw_efd _fw_act=0 _fw_a _fw_in _fw_dn _fw_pn _fw_prog
  local _fw_i _fw_n _fw_k _fw_kind _fw_frc _fw_u=0
  local -A _fw_said=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -H | -L | -P)
        _fw_pre+=("$1")
        shift
        ;;
      *) break ;;
    esac
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -* | '(' | '!') break ;;
      *)
        _fw_paths+=("$1")
        shift
        ;;
    esac
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -maxdepth | -mindepth)
        if [ "$#" -lt 2 ]; then
          warn "find_walk: $1 names no depth"
          return 2
        fi
        ;;&
      -maxdepth)
        _fw_max="$2"
        _fw_glob+=("$1" "$2")
        shift 2
        ;;
      -mindepth)
        # A value that is not a number is find's to refuse.
        if [[ "${2:-}" =~ ^[0-9]+$ ]] && [ "$((10#$2))" -gt 1 ]; then
          warn "find_walk: -mindepth $2 leaves the directories above depth $2 unexamined, so a hole there would go unseen"
          return 2
        fi
        _fw_glob+=("$1" "$2")
        shift 2
        ;;
      -ignore_readdir_race | -noignore_readdir_race | -xdev | -mount)
        _fw_glob+=("$1")
        shift
        ;;
      *) break ;;
    esac
  done
  _fw_expr=("$@")
  # The caller's leading `\( ... \) -prune -o`, lifted ahead of the clause.
  if [ "${_fw_expr[0]:-}" = "(" ]; then
    _fw_n=0
    for ((_fw_i = 0; _fw_i < ${#_fw_expr[@]}; _fw_i++)); do
      case "${_fw_expr[_fw_i]}" in
        "(") _fw_n=$((_fw_n + 1)) ;;
        ")") _fw_n=$((_fw_n - 1)) ;;
      esac
      [ "$_fw_n" -gt 0 ] || break
    done
    if [ "${_fw_expr[_fw_i + 1]:-}" = -prune ] && [ "${_fw_expr[_fw_i + 2]:-}" = -o ]; then
      _fw_prune=("${_fw_expr[@]:0:_fw_i+3}")
      _fw_expr=("${_fw_expr[@]:_fw_i+3}")
    fi
  fi
  for _fw_a in "${_fw_expr[@]}"; do
    case "$_fw_a" in -print | -print0) _fw_act=1 ;; esac
  done
  if [ "$_fw_act" = 0 ]; then
    warn "find_walk: the find expression names no -print or -print0, so nothing it finds would be printed"
    return 2
  fi
  if [ -n "${FIND_WALK_HOLES:-}" ]; then
    for _fw_a in ${_fw_prune[@]+"${_fw_prune[@]}"} "${_fw_expr[@]}"; do
      case "$_fw_a" in
        -exec | -execdir | -ok | -okdir | -delete | -fprint | -fprint0 | -fprintf | -fls)
          warn "find_walk: with FIND_WALK_HOLES set the expression may run twice, and $_fw_a would act twice"
          return 2
          ;;
      esac
    done
  fi
  if [ ! -x /bin/sh ]; then
    warn "find_walk: /bin/sh cannot be run, and a directory that can be listed but not searched is found by running it -- nothing was walked"
    return 2
  fi
  # The directories the clause asks about, one selection for both walks.
  _fw_sel=(-type d \( ! -perm -111 ! \( -user "$EUID" -perm -u+x \) -o ! -perm -444 ! \( -user "$EUID" -perm -u+r \) \))
  # shellcheck disable=SC2016 # the $1 in each -exec program is /bin/sh's own
  if [ "${FIND_WALK_QUIET:-}" = 1 ]; then
    # Every hole pruned, a selected directory it can read and search entered.
    _fw_prog='if [ -r "$1" ]; then [ ! -x "$1" ]; fi'
    exec {_fw_fd}>/dev/null {_fw_efd}>/dev/null
  else
    _fw_prog='if [ -r "$1" ]; then [ ! -x "$1" ] && printf "%s\0S\0" "$1" >&3; else printf "%s\0U\0" "$1" >&3; exit 1; fi'
    exec {_fw_fd}>&1 {_fw_efd}>&2
  fi
  mapfile -d '' -t _fw_marks < <(
    # find-walk: this is find_walk, the one find that carries the clause itself
    # find-status: read by `wait "$!"` below, on this process substitution
    find ${_fw_pre[@]+"${_fw_pre[@]}"} "${_fw_paths[@]}" ${_fw_glob[@]+"${_fw_glob[@]}"} \
      ${_fw_prune[@]+"${_fw_prune[@]}"} \
      \( "${_fw_sel[@]}" -exec /bin/sh -c "$_fw_prog" sh {} \; -prune -false \) -o \
      \( "${_fw_expr[@]}" \) 3>&1 >&"$_fw_fd" 2>&"$_fw_efd"
  )
  _fw_rc=0
  wait "$!" || _fw_rc=$?
  exec {_fw_fd}>&- {_fw_efd}>&-
  if [ "${FIND_WALK_QUIET:-}" = 1 ]; then
    return "$_fw_rc"
  fi
  _fw_frc="$_fw_rc"
  for ((_fw_k = 0; _fw_k + 1 < ${#_fw_marks[@]}; _fw_k += 2)); do
    _fw_d="${_fw_marks[_fw_k]}" _fw_kind="${_fw_marks[_fw_k + 1]}"
    # Named once, however many start paths or spellings reached it.
    _fw_dn="$_fw_d"
    _find_walk_tidy _fw_dn
    [ -z "${_fw_said[$_fw_dn]:-}" ] || continue
    if [ -n "$_fw_max" ]; then
      # A HOLE WHEN ANY START PATH IT LIES UNDER WOULD HAVE ENTERED IT: under
      # one start it may sit at -maxdepth, never entered, and under another
      # above it, a walk that meant to look beneath it.
      #
      # DEPTH IS READ FROM THE PATHS AS SPELLED, SO BOTH ARE READ ONE WAY:
      # every run of / as one, and a trailing / dropped. Both finds
      # print `a/x` under a start spelled `a/` and `a//x` under `a//`
      # (measured on Darwin 27 and GNU findutils), and a start `.` prints `./x`.
      _fw_in=0
      for _fw_p in "${_fw_paths[@]}"; do
        _fw_pn="$_fw_p"
        _find_walk_tidy _fw_pn
        if [ "$_fw_dn" = "$_fw_pn" ]; then
          _fw_rel=""
        else
          case "$_fw_dn" in
            "${_fw_pn%/}"/*) _fw_rel="${_fw_dn#"${_fw_pn%/}"}" ;;
            *) continue ;;
          esac
        fi
        _fw_rel="${_fw_rel//[!\/]/}"
        [ "${#_fw_rel}" -ge "$_fw_max" ] || _fw_in=1
      done
      [ "$_fw_in" = 1 ] || continue
    fi
    _fw_said[$_fw_dn]=1
    [ -z "${FIND_WALK_HOLES:-}" ] || printf '%s\0' "$_fw_d" >>"$FIND_WALK_HOLES"
    # One find cannot read at all keeps find's own error and status.
    if [ "$_fw_kind" = U ]; then
      _fw_u=1
      continue
    fi
    case "$_fw_d" in
      *[![:print:]]*) printf -v _fw_d '%q' "$_fw_d" ;;
    esac
    warn "cannot search $_fw_d -- nothing beneath it was looked at"
    _fw_rc=1
  done
  # A failed find failed somewhere this cannot place unless every failure was
  # a U it recorded: the same walk with every hole pruned says which, and one
  # empty record says so, which a caller reads as a hole beneath everything
  # (issue 0163).
  if [ -n "${FIND_WALK_HOLES:-}" ] && [ "$_fw_frc" -ne 0 ]; then
    # find-status: the quiet re-walk's, read by the `if`, and only whether it is 0
    if [ "$_fw_u" = 0 ] || ! FIND_WALK_HOLES="" FIND_WALK_QUIET=1 find_walk "${_fw_args[@]}"; then
      printf '\0' >>"$FIND_WALK_HOLES"
    fi
  fi
  return "$_fw_rc"
}

# _find_walk_tidy <var> -- the path in <var> with every run of / as one and a
# trailing / dropped, / itself kept: how find_walk reads a depth, and the one
# place its paths are tidied. It is spelling only, by design: real_path and
# physical_dir resolve a path through the filesystem, need it to exist and
# follow its links, which a depth count must not; and link_step keeps a link's
# text untidied on purpose, since the kernel reads a `..` after the name
# before it.
_find_walk_tidy() {
  local -n _fwt_p="$1"
  while [[ "$_fwt_p" == *//* ]]; do
    _fwt_p="${_fwt_p//\/\//\/}"
  done
  [ "$_fwt_p" = / ] || _fwt_p="${_fwt_p%/}"
}

# find_list <array> <find operands and expression> -- find_walk, sorted, read
# into an array (issue 0145): every path find prints, read whole into the
# named array in the C locale's order, and find_walk's status
# (issue 0139): 0 when find read everything, and its failure otherwise, with
# find's own error on stderr naming what it could not read. The expression ends
# in -print0, so a name holding a newline is one path; a name it cannot fill,
# bar an integer array, or an expression ending otherwise, is refused at status
# 2. The array holds what find did list either way: a caller that acts may act
# on it and say the list was partial, where a gate refuses.
#
# ONE IDIOM FOR A LIST READ WHOLE (critic-shell on 0139). 0139's first version
# wrote the list through a temporary file twice, in check's Swift gate and in
# dmarc parse. Here the status is taken by `wait` on the process substitution,
# as release_dirt and clean's walk take theirs, and there is no file to remove.
# The locals are prefixed because the caller names the array: a local of the
# same name would shadow it.
find_list() {
  # THE NAME AND THE EXPRESSION ARE ASKED BEFORE ANYTHING IS BOUND (critic-shell
  # on 0139 v2), as run_words asks (issue 0082): a name that is not a name makes
  # `local -n` fail and execution fall through, and this function's own binds
  # to itself, so either way the caller's array stays empty and a gate passes
  # over nothing; an expression that does not end in -print0 hands back every
  # path as one element. Each is a programming error, so the status is 2. The
  # expression test reads its LAST WORD only (critic-shell on 0139 v2e): one
  # ending in -print0 passes whatever its other actions, and one ending
  # otherwise is refused, sound or not. It catches the caller who forgot
  # -print0; it does not parse find's grammar.
  if ! is_identifier "${1:-}"; then
    warn "find_list: '${1:-}' is not a shell variable name, so there is no array to fill"
    return 2
  fi
  if [ "$1" = _fl_out ]; then
    warn "find_list: cannot fill an array named '$1' -- it is find_list's own name"
    return 2
  fi
  if [ "${!#}" != -print0 ]; then
    warn "find_list: the find expression must end in -print0, or its paths cannot be told apart"
    return 2
  fi
  local -n _fl_out="$1"
  # MAPFILE'S OWN FAILURE IS NOT FIND'S (critic-shell on 0139 v2e): a target it
  # cannot fill, an associative array, was refused only by the writer's
  # SIGPIPE, a status this function never read. The writer is reaped and the
  # caller told, at 2. An integer array is declared rather than closed, as
  # run_words declares it: bash's arithmetic on a path abandons the caller.
  # find-status: read by `wait "$!"` below, on this process substitution
  if ! mapfile -d '' -t _fl_out < <(set -o pipefail; find_walk "${@:2}" | LC_ALL=C sort -z); then
    wait "$!"
    warn "find_list: could not fill '$1' with the paths find printed"
    return 2
  fi
  wait "$!"
}

# dir_has_binary <dir> -- true when <dir> holds at least one executable FILE at
# its top level, which is where cargo puts the binaries it builds.
#
# `-type f` and not `-e`: a cargo profile directory always exists once cargo has
# run in it, carrying `.fingerprint/`, `build/`, `deps/` and `incremental/`
# whether or not a single binary was produced. So "the directory is there" and
# "the artefacts are there" are different facts, and the first one is the
# reading that made a dev-profile cycle look complete.
dir_has_binary() {
  local d="$1" f
  [ -d "$d" ] || return 1
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    [ -x "$f" ] || continue
    return 0
  done
  return 1
}

# utc_from_epoch <epoch> -- an epoch second rendered `YYYY-MM-DD HH:MMZ`.
#
# THE TWO PLATFORMS SPELL THIS INCOMPATIBLY AND ONE OF THE SPELLINGS FAILS
# QUIETLY. BSD `date -r <epoch>` takes a NUMBER; GNU `date -r <file>` takes a
# FILE and wants `-d @<epoch>` for a number. Hand GNU an epoch and it errors to
# stderr and prints nothing, so the field goes EMPTY rather than wrong -- which
# is the safe direction and is still a column that silently stops existing on
# one platform.
#
# Reading order matters: BSD is tried first because GNU's `-r` would ACCEPT the
# argument as a filename and fail on it, while BSD's rejection of `-d @...` is
# clean. Both arms are guarded, so an unparseable value returns 1 rather than
# emitting a plausible-looking wrong time -- see the clock discipline in
# `/in-whiteboard`: a fabricated timestamp is indistinguishable from a real one.
utc_from_epoch() {
  local e="$1" out
  [ -n "$e" ] || return 1
  out="$(date -u -r "$e" +'%Y-%m-%d %H:%MZ' 2>/dev/null)" ||
    out="$(date -u -d "@$e" +'%Y-%m-%d %H:%MZ' 2>/dev/null)" || return 1
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# sha256_of <file> -- one file's SHA256, bare hex, or return 1.
#
# Built on sha256_files so the knowledge of which tool exists lives in exactly
# one place (IN-AG-HIGHLANDER-001).
sha256_of() {
  [ -f "$1" ] || return 1
  sha256_files "$1" | awk '{print $1}'
}

# --- the build's git identity (issue 0014) -------------------------------------
#
# Devbin owns the version-number axis completely -- `version_from`, the sidecars,
# `version sync` -- and owned nothing of the git one, so every project resolved
# "what commit is this build" for itself. The ruling is option B: devbin owns
# the half that is genuinely SHARED and gets independently wrong, and declares
# nothing about how a build system consumes it.
#
# THE READ IS THE HALF NOBODY GETS WRONG. One project's six sites all agreed on
# `git rev-parse --short HEAD` with `unknown` on failure. The INVALIDATION is
# where four of four went wrong, each by naming git's internals literally:
#
#     ../../.git/HEAD          ../../.git/refs/heads/
#
# In a linked worktree neither exists -- `.git` is a FILE reading `gitdir: ...`.
# The same unresolved path produced OPPOSITE symptoms, decided entirely by
# whether the toolchain fails open or closed on a path it cannot find: Elixir's
# `@external_resource` over an empty list registered no dependency and served a
# frozen sha for a working day; cargo could not stat its `rerun-if-changed` and
# treated the target as permanently dirty, rebuilding forever. The version that
# silently freezes and the version that silently rebuilds are the same bug, and
# only one of them ever gets reported -- which is why it is worth one home.
#
# These emit FACTS -- a string and a list of file paths -- and declare nothing.
# Each build system states its own dependency in its own vocabulary: cargo's
# `rerun-if-changed`, Elixir's `@external_resource`, a make prerequisite, a
# Dockerfile COPY. That is what makes one function serve four toolchains.

# git_readonly <args...> -- git, asked about a repository this process only reads.
#
# `--no-optional-locks` because a plain `git status` may refresh the index and
# take its lock: a caller reading many trees could fail a concurrent commit with
# `index.lock exists`, and leave a write in a repository it only meant to read.
#
# EVERY ONE OF GIT'S LOCAL ENVIRONMENT VARIABLES IS CLEARED, IN A SUBSHELL, and
# the list is asked of git rather than written here. A value inherited from the
# caller -- GIT_DIR, GIT_COMMON_DIR, GIT_CONFIG_PARAMETERS from a `git -c` --
# would point every repository's question at one repository or one setting and
# answer it confidently for all of them. If git cannot list them, this refuses
# rather than asking with the environment it could not clear.
#
# THE LIST IS CACHED IN THE SHELL THAT ASKS, AND A COMMAND SUBSTITUTION IS A
# DIFFERENT SHELL. Every caller runs git_readonly inside `$(...)`, so a cache
# filled there is gone before the next call -- the first cut claimed "once per
# process" and asked three times per estate (measured with a counting git on
# PATH). git_readonly_prime fills it in the CURRENT shell, so a
# caller that primes before its first substitution pays once for everything
# beneath it. A scan over many trees primes once for all of them;
# source_commit_of and tree_dirty_paths prime through their first, direct call.
#
# THE REPOSITORY'S OWN SETTINGS ARE NOT TRUSTED EITHER WHERE THEY CAN HIDE A
# CHANGE OR RUN SOMETHING. `core.fsmonitor` names a hook the repository chose,
# which would run here and could answer "nothing changed"; `core.untrackedCache`
# is a cache of that same answer. Both are forced off for the one call. (Moved
# to lib/install in issue 0056, and from there to lib/helpers, issue 0094: the
# dispatcher, `release` and `fullcycle` do not source lib/install, and each has
# a read that must not write.)
_DEVBIN_GIT_LOCAL_VARS=""
git_readonly_prime() {
  [ -z "$_DEVBIN_GIT_LOCAL_VARS" ] || return 0
  if ! _DEVBIN_GIT_LOCAL_VARS="$(git rev-parse --local-env-vars 2>/dev/null)"; then
    _DEVBIN_GIT_LOCAL_VARS=""
    return 1
  fi
  [ -n "$_DEVBIN_GIT_LOCAL_VARS" ]
}

git_readonly() {
  local v
  git_readonly_prime || return 1
  (
    while IFS= read -r v; do
      [ -n "$v" ] && unset "$v"
    done <<VARS
$_DEVBIN_GIT_LOCAL_VARS
VARS
    exec git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false "$@"
  )
}

# git_head_sha [root] [short|full] -- the commit sha, or `unknown`.
#
# `unknown` rather than empty or a failure, because every caller in the corpus
# already handles that string and a build stamped with an empty version is worse
# than one stamped honestly as unresolved.
#
# The form is a PARAMETER rather than a second function, which is the whole
# point of this being issue 0014's one home: `git_head_sha_full` beside it would
# be two readers of one fact, free to disagree about the failure string the
# moment either is touched. `short` stays the default so every existing caller
# is unchanged.
git_head_sha() {
  # THROUGH git_readonly for the reason at git_head_identity (issue 0094): an
  # inherited GIT_DIR outranks `-C`, and the identity's two halves must read one
  # repository. rev-parse takes no lock, so the lock is not the reason.
  local root="${1:-${PROJECT_ROOT:-.}}" form="${2:-short}" sha
  case "$form" in
    full) sha="$(git_readonly -C "$root" rev-parse HEAD 2>/dev/null)" || sha="" ;;
    *) sha="$(git_readonly -C "$root" rev-parse --short HEAD 2>/dev/null)" || sha="" ;;
  esac
  [ -n "$sha" ] || sha=unknown
  printf '%s\n' "$sha"
  return 0
}

# git_head_identity [root] -- `<full sha>`, `<full sha> +dirty`, or `unknown`.
#
# What a `--version` line should say about WHICH bytes are running. A bare sha
# on a dirty tree is a confident false statement: the binary in front of you is
# not that commit.
#
# IT SAYS `+dirty` AND NOT `THESE BYTES MATCH NO COMMIT`, AND THE DIFFERENT
# WORDING IS DELIBERATE RATHER THAN A DRIFTED COPY. `source_commit_of` in
# lib/install stamps that sentence, and it is making a narrower and stronger
# claim: the VENDORED FILE SET does not correspond to any commit, which is a
# statement about bytes somebody else will later read out of a manifest (issue
# 0033). This function answers a looser question -- the working tree it is
# standing in has uncommitted changes -- and borrowing the stronger sentence for
# it would put a provenance claim on a checkout that never made one. Two claims,
# two vocabularies, one producer each.
# platform_identity -- WHICH MACHINE produced this, as one line.
#
# THE NARROWING THAT COST THE FIRST TAGGED RELEASE (issue 0052), which names
# the version -- this file may not, and the guard that says so is right even
# here: a version literal in a source file is a hazard whether it is a claim or
# a citation. A local `test all`
# runs on one machine. Its seal is a true record of a macOS run, and nothing in
# the `.out`, the `.errors` or the summary named a platform -- so
# `824 tests, 0 failures` read as a fact about devbin when it was a fact about
# one OS. CI had been red on Ubuntu for six days and three pushes, one of them
# the release, and the release note's Verified section was assembled from those
# local seals. The instrument was sound and aimed one unit wide, and the output
# said nothing about which unit.
#
# BASH IS IN IT ALONGSIDE uname, and not for symmetry: bash >= 5 is this
# project's floor (issue 0022) and macOS ships 3.2.57 at /bin/bash, so "which
# bash" is a real axis on which two runs of the same code differ. The two
# together are what distinguishes a green anyone can rely on from a green about
# one machine.
#
# It says nothing about the analyser versions that were 0052's OTHER narrowing.
# Those are a property of a gate's TOOL rather than of the run, and pinning
# them is the analyser's own job -- .github/install-shellcheck.sh does it by
# asserting the version it installed. Claiming them here would be devbin
# reporting a fact it did not establish.
platform_identity() {
  printf '%s / bash %s' "$(uname -srm 2>/dev/null || printf 'unknown')" \
    "${BASH_VERSION:-unknown}"
}

# runtime_digest <launcher> <libdir> -- SHA256 of the RUNTIME BYTES, 12 hex.
#
# THE ONE HOME FOR "WHICH BYTES ARE THESE", and it now has two readers: the
# `--version` line here, and a caller that reports a digest per tree, which had
# this computation written out inside it. Two copies of a fingerprint is the
# worst duplication available -- when they drift, the two surfaces report
# different identities for one tree and neither says which is authoritative.
#
# A STAMP IS NOT AN IDENTITY. `git_head_identity` below answers "which commit
# was this checkout on", which is a different question and can be `<sha> +dirty`
# -- a value that names no bytes at all. This answers the one a reader comparing
# installs actually has: are these the same runtime.
#
# PATHS ARE FOLDED IN RELATIVE TO THE LIB DIRECTORY, not to a project root, and
# the choice is load-bearing. It makes a source checkout (`lib/helpers`) and an
# install of it (`bin/.devbin/lib/helpers`) digest IDENTICALLY when the bytes
# match, which is the comparison anyone re-vendoring actually wants. Folding
# against a root would have made every install differ from its own source by
# construction, and the difference would have looked like divergence.
#
# The paths go in ALONGSIDE the contents so a moved or missing file changes the
# digest rather than hiding inside a concatenation.
#
# A RUNTIME IT CANNOT READ WHOLE HAS NO DIGEST: it returns 1, printing
# nothing, and says what it could not read (issue 0139). The listing's errors
# went to /dev/null, so a directory find could not read left its files out, and
# a file cat could not read, the launcher's error discarded too, went in as its
# path alone: either way the value named a different runtime, and nothing said
# why. find's own error names a directory, and a file is named here. The sort
# is left as it was, since a new order would change every install's digest.
#
# -H FOLLOWS A LIB DIRECTORY THAT IS A SYMLINK, AT THE START POINT ONLY
# (critic-shell on 0139). find's default -P read such a libdir as the link
# itself, listed nothing, and the runtime digested as its launcher alone
# (measured) at rc 0; a caller's `[ -d ]` guard lets that libdir through. A
# trailing slash on the operand would follow it as well, and would move every
# install's digest, since the strip below is spelled against $libdir.
runtime_digest() {
  local launcher="$1" libdir="$2" f files digest
  # A LIB THAT IS NOT A DIRECTORY IS NO RUNTIME (critic-shell on 0139 v2): a
  # link naming nothing was followed by -H to nothing, listed nothing, and
  # digested as the launcher alone, at rc 0.
  [ -d "$libdir" ] || {
    warn "runtime digest: $libdir is not a directory"
    return 1
  }
  files="$(find_walk -H "$libdir" -type f -print)" || return 1
  [ -r "$launcher" ] || {
    warn "runtime digest: cannot read $launcher"
    return 1
  }
  while IFS= read -r f; do
    [ -z "$f" ] || [ -r "$f" ] || {
      warn "runtime digest: cannot read $f"
      return 1
    }
  done <<<"$files"
  # EVERY READ READS ITS OWN STATUS, AND THE DIGEST IS PRINTED ONLY WHOLE
  # (critic-shell on 0139 v2). The test above is a moment before the reads, so
  # a file removed or locked between the two was digested as absent: rc 0 and
  # the digest of a runtime that is not the one on disk, or, at the last file,
  # rc 1 with a digest printed anyway. The bytes digested are unchanged, so no
  # install's digest moves. A link inside lib is neither followed nor digested
  # -- -H follows the start point only -- and none is ever vendored, since
  # vendored_paths lists regular files: declared, not closed (critic-shell on
  # 0139 v2e).
  digest="$(
    set -o pipefail
    {
      cat "$launcher" || exit 1
      printf '%s\n' "$files" | sort | while IFS= read -r f; do
        [ -n "$f" ] || continue
        printf '%s\n' "${f#"$libdir"/}"
        cat "$f" || exit 1
      done
    } | sha256_stdin | cut -c1-12
  )" || {
    warn "runtime digest: the runtime could not be digested whole (any error above names what failed)"
    return 1
  }
  printf '%s\n' "$digest"
}

# version_identity [root] -- the ONE renderer for `<name> <version> (<tree>)`.
#
# TWO CALL SITES ASK THE SAME QUESTION AND BEFORE 2026-09-01 THEY ANSWERED IT
# DIFFERENTLY. `bin/devbin --version` printed the name, the version and the
# tree's commit; `bin/devbin version` printed the name and the version alone.
# Same question, one tree, two answers, and nothing in either output said which
# one was the whole story -- found by running both in devbin's own checkout,
# where the project IS devbin so the disagreement had nowhere left to hide.
#
# It is a Highlander violation of the ordinary kind: not duplicated logic, but
# duplicated RENDERING, which is the copy that drifts without anyone noticing
# because each site reads correct on its own. The fix is this function and the
# rule that no third site prints this line itself.
#
# `version show` deliberately does NOT come through here. It is the machine
# arm -- a bare number for scripting -- and giving it provenance would break
# every line-oriented reader that consumes it.
version_identity() {
  local root="${1:-${PROJECT_ROOT:-.}}"
  # A runtime find could not read whole reads UNREADABLE (issue 0139), never an
  # empty digest a reader would take for a value.
  local digest
  digest="$(runtime_digest "$root/bin/devbin" "${DEVBIN_LIB:-$root/lib}")" || digest=UNREADABLE
  # shellcheck disable=SC2119  # the bare call IS the point: version-file role.
  # This directive travelled here WITH the call. It used to sit in bin/devbin
  # above the printf that moved into this function, and leaving it behind is
  # what reddened lint on the first run of this change -- a suppression is
  # part of its call site, not of the file it was written in.
  # TWO FIELDS BECAUSE THEY ANSWER TWO QUESTIONS AND ONE OF THEM CAN BE EMPTY
  # OF MEANING. The commit says where this checkout stood; on a dirty tree it
  # says `+dirty`, which names no bytes at all and is exactly when a reader most
  # needs an identity. `runtime` is that identity: the same twelve hex
  # runtime_digest gives every caller, so `--version` here and another caller's
  # report can be compared directly without either side deriving anything.
  #
  # NOT CALLED `tree`. The ruling used that word and it is the wrong one for
  # this value: `tree` is a git object, a reader meeting it would go looking for
  # one, and would not find it -- a wrong mechanism in a provenance line is
  # actionable in the wrong direction. Rename it if the git object was meant.
  printf '%s %s (%s, runtime %s)\n' "${DEVBIN_NAME:-devbin}" "$(read_version)" \
    "$(git_head_identity "$root")" "$digest"
}

git_head_identity() {
  local root="${1:-${PROJECT_ROOT:-.}}" sha
  sha="$(git_head_sha "$root" full)"
  if [ "$sha" = unknown ]; then
    printf 'unknown\n'
    return 0
  fi
  # THROUGH git_readonly, BOTH HALVES (issue 0094). A plain `git status` takes
  # the optional index lock and rewrites a stale index, so `--version` wrote
  # into the repository it describes. The sha goes the same way for a different
  # reason: an inherited GIT_DIR outranks `-C`, and with only one half cleared
  # the line would pair one repository's commit with another tree's `+dirty`.
  if [ -n "$(git_readonly -C "$root" status --porcelain 2>/dev/null)" ]; then
    printf '%s +dirty\n' "$sha"
  else
    printf '%s\n' "$sha"
  fi
  return 0
}

# _git_path <root> <name> -- `git rev-parse --git-path <name>`, made ABSOLUTE,
# printed only when it names a file that exists. Returns 1 otherwise.
#
# THE ABSOLUTISING IS NOT TIDINESS, AND A TEST FOUND IT. `--git-path` answers
# RELATIVE in a normal checkout (`.git/HEAD`) and ABSOLUTE in a linked worktree,
# where the gitdir is somewhere else entirely. So a caller doing `[ -f "$p" ]`
# from any other directory -- which a build script always is -- resolves
# everything in the worktree case and NOTHING in the ordinary one. That is the
# exact inverse of the bug this whole function exists to fix, and it would have
# shipped looking right: every hard test passed and the easy one failed.
_git_path() {
  local root="$1" p
  p="$(git -C "$root" rev-parse --git-path "$2" 2>/dev/null)" || return 1
  [ -n "$p" ] || return 1
  case "$p" in
    /*) ;;
    *) p="$root/$p" ;;
  esac
  [ -f "$p" ] || return 1
  printf '%s\n' "$p"
  return 0
}

# git_head_watch_paths [root] -- every EXISTING file whose mtime tracks HEAD,
# one absolute path per line. Returns 1, loudly, when it resolves none.
#
# `git rev-parse --git-path` is the whole trick: git already knows about worktree
# indirection, the common directory and the loose/packed question, and answers
# with a real path. Three separate layout rules that a hand-rolled implementation
# has to get right independently, and did not.
#
# THREE PATHS, EACH FOR A DIFFERENT EVENT:
#
#   HEAD          changes on checkout, and on every commit when detached
#   the branch    what actually moves on a commit -- and it lives in the COMMON
#                 directory, not the worktree's gitdir, because a worktree's own
#                 HEAD holds `ref: refs/heads/<x>` and that string never changes
#   packed-refs   `git pack-refs` DELETES the loose ref file, so a branch living
#                 only here drops out of any watch set built from loose paths
#
# THE EMPTY LIST IS THE FAILURE THAT MATTERS, AND IT IS CREATED BY THIS FIX.
# Before it, a broken watch meant "always rebuild" -- a cost, not a visible
# defect. Restoring a working watch restores CACHING, so an enumeration that
# quietly returned nothing would turn a slow-but-correct build into a fast and
# possibly wrong one. Same rule as a gate that examines nothing: empty-and-
# successful is the one answer that must not be available.
git_head_watch_paths() {
  local root="${1:-${PROJECT_ROOT:-.}}" ref n=0
  if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
    _git_path "$root" HEAD && n=$((n + 1))
    ref="$(git -C "$root" symbolic-ref -q HEAD 2>/dev/null)" || ref=""
    if [ -n "$ref" ]; then
      _git_path "$root" "$ref" && n=$((n + 1))
    fi
    _git_path "$root" packed-refs && n=$((n + 1))
  fi
  if [ "$n" -eq 0 ]; then
    warn "git_head_watch_paths: resolved NO files to watch under $root"
    warn "  a build baking the sha would never refresh it -- do not cache on an empty watch set"
    return 1
  fi
  return 0
}

# assert_identifier <value> <what> -- refuse a value that cannot be a shell
# variable name, or that would clobber one the shell needs.
#
# Devbin turns three CONFIG VALUES into variable names: `project.root_var`,
# `options.<name>.export`, and `<NAME>_ROOT` derived from `project.name`. The
# config KEY charset is validated by the parser; these values were not, and the
# failure was raw and unlocated -- a space in any of them produced bash's own
# `export: not a valid identifier`, with no `config:` prefix and no file, which
# is well below the bar D7 sets for every other malformed-config message.
#
# The reserved list is short and only holds names whose loss breaks the run
# itself. `root_var: PATH` was the worst case found: the export succeeds, the
# handler exec then fails with `env: bash: No such file or directory` and exit
# 127, and nothing in that message points anywhere near the config that caused
# it. Refusing beats diagnosing.
# is_identifier <value> -- true when <value> is a shell variable name: a letter
# or underscore, then letters, digits and underscores. THE ONE DEFINITION, and
# it is a predicate rather than a refusal because its two callers refuse
# differently: assert_identifier dies with a message naming which rule the value
# broke, and run_words warns and returns, since nothing in the release library
# may die. The charset lived only inside assert_identifier until run_words
# needed the same question (issue 0082), and a second spelling of "is a name"
# is exactly the divergence Highlander is about.
is_identifier() {
  case "${1:-}" in
    '' | [!A-Za-z_]* | *[!A-Za-z0-9_]*) return 1 ;;
  esac
  return 0
}

assert_identifier() {
  local value="${1:-}" what="${2:-value}"
  # is_identifier gives the VERDICT; the case below only chooses the sentence,
  # which is why it no longer has a rule the predicate does not have.
  if ! is_identifier "$value"; then
    case "$value" in
      '') die "$what is empty -- it has to be a shell variable name" ;;
      [!A-Za-z_]*) die "$what must start with a letter or underscore, got '$value'" ;;
      *) die "$what may contain only letters, digits and underscore, got '$value'" ;;
    esac
  fi
  case "$value" in
    PATH | IFS | HOME | PWD | OLDPWD | SHELL | BASH_ENV | ENV | LD_PRELOAD | LD_LIBRARY_PATH)
      die "$what must not be '$value' -- overwriting it breaks the commands devbin runs"
      ;;
    # devbin's OWN environment, enumerated rather than matched as `DEVBIN_*`.
    # The wildcard was the first thing tried and it broke Devbin itself inside a
    # minute: this project is called `devbin`, so its derived root variable is
    # `DEVBIN_ROOT` -- a legitimate name devbin does not use, refused by a
    # pattern aimed at names it does. Devbin uses devbin (D12), so the guard's
    # own overreach failed here before it could reach a live project.
    #
    # EVERY NAME THE DISPATCHER EXPORTS TO A HANDLER, and a pattern only for the
    # two families whose names it composes. The list is a copy of exports that
    # live in bin/devbin and lib/resolve, so it drifts each time one is added: it
    # fell six names and DEVBIN_ACTIVE_* behind, and root_var overwrote the run
    # id, the stamp, the referent and the cli task with the project root, rc 0
    # (issue 0081). tests/unit/review.bats now holds it to the names a handler
    # receives. DEVBIN_TREEINDEX_DIRS left it when its export did (issue 0032).
    DEVBIN_NAME | DEVBIN_INVOKE | DEVBIN_LIB | DEVBIN_DIR | DEVBIN_ROOT_VAR | DEVBIN_COMMAND | DEVBIN_ARGS | \
      DEVBIN_SEAL_LEDGER | DEVBIN_SEAL_LEDGER_RUN | DEVBIN_RUN_ID | DEVBIN_RUN_STAMP | DEVBIN_RUN_WITNESS | \
      DEVBIN_RUN_REFERENT | DEVBIN_CLI_TASK | DEVBIN_VERSION_FILE | DEVBIN_VERSION_SIDECARS | DEVBIN_LANGUAGES | \
      DEVBIN_FMT_ARMS | DEVBIN_ACTIVE_* | DEVBIN_OPT_* | PROJECT_ROOT | BIN_DIR)
      die "$what must not be '$value' -- that name belongs to devbin's own environment"
      ;;
  esac
  return 0
}

# is_semver <value> -- true for MAJOR.MINOR.PATCH, digits only. The one test;
# assert_semver dies on it, and release reads a target through it.
is_semver() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# assert_semver <version> -- refuse anything that is not X.Y.Z.
#
# The corpus put each project's own current version in the error message, which
# is why four copies existed at all. The example is generic here; the value the
# caller passed is what the reader actually needs to see.
assert_semver() {
  is_semver "${1:-}" ||
    die "version must be semver (eg 1.2.3), got '${1:-}'"
}

# is_handler <path> -- true when <path> is a runnable handler: a REGULAR file
# carrying the execute bit.
#
# `-x` ALONE IS TRUE FOR A DIRECTORY, and the corpus keeps directories exactly
# where handlers live. One project's `demo_macos.d/pkg` is a directory of
# packaging resources sitting beside the real sub-handlers, so `macos pkg`
# descended into it and exec'd it: a raw bash "Is a directory" naming an
# internal library path, exit 126, and the handler never reached (issue 0005).
#
# One predicate for every site that asks "can I run this", so a second place
# cannot keep the old answer. Lives here because the question has no
# dependencies, which is what D15 requires of this file.
is_handler() {
  [ -f "$1" ] && [ -x "$1" ]
}

# is_bare_version <string> -- true when <string> is a lone version and nothing
# else: it starts with a digit and carries only characters a version carries.
#
# DELIBERATELY LOOSER THAN assert_semver, and not a substitute for it. This
# guards the bare-version DEFAULT -- the branch that reads or writes a whole
# file as though the file were nothing but a version. Its question is "is this
# a version string at all", not "is this project's numbering well-formed", so
# `0.6.0-rc1`, `1.4` and `20260808` all pass. assert_semver still polices what a
# caller may SET.
#
# Both the reader and the writer ask this one predicate, which is the point: a
# reader and a writer that disagree about which files they mean is the exact
# mechanism `lib/cmd/version`'s own comment was written to prevent, and issue
# 0002 was the two of them agreeing on the wrong answer.
is_bare_version() {
  case "${1:-}" in
    [0-9]*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[!0-9A-Za-z.+-]*) return 1 ;;
  esac
  return 0
}

# rlwrap_exec <completions> <history> [--] <cmd> [args...] -- exec under rlwrap.
#
# Byte-identical in every project it was folded from. Missing rlwrap degrades to
# a plain exec with a warning rather than failing: losing history is an
# inconvenience, refusing to start a REPL is an outage.
#
# `opts` is a plain indexed array, which bash 3.2 has (design D9 -- since
# reversed by issue 0022 -- ruled out only
# the ASSOCIATIVE arrays of bash 4). It is never empty at expansion, so it needs
# none of the `${a[@]+...}` guarding parse_common_opts does.
rlwrap_exec() {
  local completions="$1" history="$2"
  shift 2
  [ "${1:-}" = "--" ] && shift
  if command -v rlwrap >/dev/null 2>&1; then
    local opts
    opts=(-r -c -H "$history" -s 2000)
    if [ -n "$completions" ] && [ -f "$completions" ]; then
      opts=(-f "$completions" "${opts[@]}")
    fi
    exec rlwrap "${opts[@]}" "$@"
  fi
  warn "rlwrap not found -- no history or tab completion (try: brew install rlwrap)"
  exec "$@"
}

# ============================================================================
# GENERATED DOCUMENTATION, AND THE FIVE REFUSALS THAT MAKE IT SAFE
# ============================================================================
#
# generated_doc_write --target FILE --begin MARKER --end MARKER \
#   [--deny-env VAR]... [--expect-lines N] [--expect-contains STR]... \
#   -- <producer> [args...]
#
# Replace the region between two markers in FILE with what <producer> writes to
# stdout, or refuse and leave FILE untouched.
#
# WHY THIS IS HERE AND NOT IN A COMMAND. Estates independently needed to
# generate the factual half of a database runbook from live probes. The obvious
# read is that the PROVIDER CODE is the shared thing, which would put a fly.io
# opinion inside devbin and break the rule at lib/cmd/db:16. That read is wrong.
# The fly verbs are ninety lines, cheap to write and trivial to verify because
# you can just run them; what actually cost a measured incident is the
# DISCIPLINE of writing a generated file safely. So devbin owns the discipline
# and every project keeps its own producer. A Neon estate writes a Neon producer
# and none of this changes (issue 0028).
#
# It is a HELPER rather than a command, which is what keeps the surface honest:
# no catalogue row, no opt-in cell, no `@builtin`, and no config schema key --
# so it costs devbin no new mechanism at all. The layering rule decides the
# home: needs config, belongs in resolve; needs nothing, belongs here (D15).
#
# WHAT DEVBIN MUST NOT LEARN, and does not: what a cluster is, what a connection
# pooler is, that `--json` exists on anything, or that the output is Markdown.
# The markers are opaque delimiters and are REQUIRED rather than defaulted --
# any default would encode a comment syntax, and a framework that ships
# `<!-- ... -->` has quietly decided its consumers write HTML.
#
# It WARNS and RETURNS rather than dying, because a caller generating several
# documents must not lose the rest of them to the first refusal.
generated_doc_write() {
  local target="" begin="" end="" expect_lines=0
  local block nb ne bl el v s n
  local -a deny=() expect_contains=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --target) shift; target="${1:-}" ;;
      --target=*) target="${1#*=}" ;;
      --begin) shift; begin="${1:-}" ;;
      --begin=*) begin="${1#*=}" ;;
      --end) shift; end="${1:-}" ;;
      --end=*) end="${1#*=}" ;;
      --deny-env) shift; deny+=("${1:-}") ;;
      --deny-env=*) deny+=("${1#*=}") ;;
      --expect-lines) shift; expect_lines="${1:-0}" ;;
      --expect-lines=*) expect_lines="${1#*=}" ;;
      --expect-contains) shift; expect_contains+=("${1:-}") ;;
      --expect-contains=*) expect_contains+=("${1#*=}") ;;
      --) shift; break ;;
      *) die "generated_doc_write: unknown option '$1' (the producer goes after --)" ;;
    esac
    shift
  done

  # Usage errors DIE: they are the caller's bug and no run of this is correct.
  # The five refusals below WARN, because they are facts about the world.
  [ -n "$target" ] || die "generated_doc_write: --target is required"
  [ -n "$begin" ] || die "generated_doc_write: --begin marker is required"
  [ -n "$end" ] || die "generated_doc_write: --end marker is required"
  [ $# -gt 0 ] || die "generated_doc_write: no producer given (put it after --)"

  if [ ! -f "$target" ]; then
    warn "generated_doc_write: $target does not exist -- this regenerates a region of a hand-authored file, it does not create one"
    return 1
  fi

  # R4 -- THE HAND-AUTHORED HALF SURVIVES. Everything outside the markers is
  # copied through untouched, including both marker lines. Regeneration must
  # never eat judgement: a probe can report a pooler's port and cannot report
  # that changing it needs the owner's say-so.
  #
  # Exactly one of each marker, in order, or refuse. Two begins is ambiguous
  # about which region is generated, and guessing is how a generator eats the
  # wrong half of a file.
  nb="$(grep -c -F -- "$begin" "$target" 2>/dev/null || true)"
  ne="$(grep -c -F -- "$end" "$target" 2>/dev/null || true)"
  if [ "${nb:-0}" -ne 1 ] || [ "${ne:-0}" -ne 1 ]; then
    warn "generated_doc_write: $target must contain each marker exactly once (found begin=${nb:-0} end=${ne:-0}) -- untouched"
    return 1
  fi
  bl="$(awk -v m="$begin" 'index($0, m) { print NR; exit }' "$target")"
  el="$(awk -v m="$end" 'index($0, m) { print NR; exit }' "$target")"
  if [ "$bl" -ge "$el" ]; then
    warn "generated_doc_write: $target has its end marker at line $el, before or at the begin marker at line $bl -- untouched"
    return 1
  fi

  # R2 -- NEVER WRITE FROM A FAILED MEASUREMENT. A producer that could not
  # measure exits non-zero and the target is left alone. This is the
  # determinate-zero doctrine in prose: a document assembled from failed probes
  # is worse than a stale one, because it looks freshly generated. Measured --
  # an estate captured psql ERROR TEXT into a runbook and then reported counts
  # off it, which is a refuted inference wearing the format of a measurement.
  if ! block="$("$@")"; then
    warn "generated_doc_write: the producer exited non-zero -- $target left untouched"
    return 1
  fi
  if [ -z "$block" ]; then
    warn "generated_doc_write: the producer wrote nothing -- $target left untouched"
    return 1
  fi

  # R1 -- NEVER INLINE A SECRET, ENFORCED MECHANICALLY rather than by review.
  # Exact value matching, no entropy heuristics. Measured twice: a hand-edit
  # replaced a username in six places and left the old password beside it, which
  # authenticates as a rotation failure and reads like a platform problem; and a
  # cleanup step was about to fold a live credential into a runbook.
  for v in ${deny[@]+"${deny[@]}"}; do
    # UNSET OR EMPTY IS ITSELF A REFUSAL, and the message must say so. An unset
    # variable makes the check below compare against the empty string, which
    # every block contains -- so the naive version refuses, correctly, and
    # reports a leak. There was none. That is a wrong recorded reason, which is
    # worse than no reason: it sends the reader hunting a credential leak in a
    # file that is fine, and the real fault (a guard pointed at a variable that
    # is not there) goes unread. Driven red before this branch existed.
    if [ -z "${!v:-}" ]; then
      warn "generated_doc_write: --deny-env $v is unset or empty, so there is no value to search for -- $target left untouched. A secret guard that cannot see its secret must not pass, and has not."
      return 1
    fi
    case "$block" in
      *"${!v}"*)
        warn "generated_doc_write: \$$v's value appears in the generated block -- $target left untouched. Use env indirection in the producer's output (postgresql://user:\$$v@host) rather than the value."
        return 1
        ;;
    esac
  done

  # R5 -- VALIDATE THE ARTEFACT, NOT THE EXIT PATH. A producer exiting 0 says it
  # ran; it does not say it produced the document. The expectation is the
  # producer's own declaration of what sufficient output looks like, which is
  # why there is no built-in threshold here to guess wrong.
  if [ "$expect_lines" -gt 0 ]; then
    n="$(printf '%s\n' "$block" | wc -l | tr -d ' ')"
    if [ "$n" -lt "$expect_lines" ]; then
      warn "generated_doc_write: the block is $n line(s), fewer than the $expect_lines declared -- $target left untouched"
      return 1
    fi
  fi
  for s in ${expect_contains[@]+"${expect_contains[@]}"}; do
    case "$block" in
      *"$s"*) ;;
      *)
        warn "generated_doc_write: the block does not contain the declared '$s' -- $target left untouched"
        return 1
        ;;
    esac
  done

  # R3 -- ATOMIC REPLACE, through replace_file above: the temporary beside the
  # target (a temp under /tmp renaming onto a project path can fail
  # cross-device), the target's mode, the rename, and the temporary removed on
  # a failure it returns -- the comment above stage_beside names the two ways
  # one can still be left.
  #
  # What this gives and does NOT give: the reader sees the old file or the new
  # one and never a half-written one. It is not a durability guarantee -- shell
  # has no portable fsync, so a machine losing power at the wrong moment may
  # have neither. Atomicity is the property that matters here, and claiming the
  # other one would be the wrong kind of confident.
  if ! replace_file "$target" _generated_doc_assemble "$target" "$bl" "$el" "$block"; then
    warn "generated_doc_write: $target left untouched"
    return 1
  fi
  return 0
}

# _generated_doc_assemble <target> <begin-line> <end-line> <block> -- the new
# document on stdout: the target through its begin marker, the block, and the
# target from its end marker on.
_generated_doc_assemble() {
  awk -v n="$2" 'NR <= n' "$1" && printf '%s\n' "$4" && awk -v n="$3" 'NR >= n' "$1"
}

# MOVED HERE FROM lib/install AT THE UPDATE-NOTICE CHANGE. The dispatcher
# needs to read two manifest header lines on every invocation, and it does
# NOT source lib/install -- deliberately, because the install machinery has
# no business on the hot path of a launcher that runs on every command. The
# alternative was a second manifest reader in the dispatcher, which is the
# Highlander breach this project names first. lib/install sources this file
# and calls them unchanged.
DEVBIN_MANIFEST_REL="bin/.devbin/manifest.sha256"

manifest_path() { printf '%s\n' "$1/$DEVBIN_MANIFEST_REL"; }

# manifest_field <root> <field> -- read one `# <field>: <value>` header line.
manifest_field() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 1
  awk -v f="$2" '
    $0 !~ /^#/ { exit }
    {
      line = $0
      sub(/^#[[:space:]]*/, "", line)
      if (line ~ ("^" f ":")) {
        sub("^" f ":[[:space:]]*", "", line)
        sub(/[[:space:]]+$/, "", line)
        print line
        exit
      }
    }
  ' "$path"
}

manifest_version() { manifest_field "$1" devbin_version; }
manifest_source_commit() { manifest_field "$1" source_commit; }

# vendor_from_hint <install root> -- the line that tells an operator how a
# project vendors from an install: printed by publish and publish-upgrade, and
# by the dispatcher's refusal to run from an install, which is why it lives
# here rather than in lib/install. One home keeps the three from differing;
# what catches a WRONG line is the test, which runs the printed line in a
# consumer.
vendor_from_hint() {
  printf '  cd <your project> && bin/devbin upgrade --from %s\n' "$1"
}

# lib_rel -- where devbin's runtime lives, relative to the project root.
#
# DERIVED FROM DEVBIN_LIB, NEVER SPELLED (issue 0112). The overview and the
# templates listing named bin/.devbin/lib/ outright, which is right in every
# estate and wrong in the devbin checkout, where D12 runs lib/ in place -- so in
# the one tree that explains devbin, `devbin devbin` pointed at two paths that
# did not exist, beneath a line announcing that this was the checkout.
#
# MOVED HERE FROM lib/cmd/devbin (issue 0121), when `infra --help` turned out to
# spell the same path outright for its reference file. Two handlers need it, and
# a second copy of a one-line derivation is how the first defect comes back.
lib_rel() {
  printf '%s' "${DEVBIN_LIB#"$PROJECT_ROOT"/}"
}

# home_relative <path> -- <path> with a leading $HOME written as `~`.
# home_expand <value> -- the inverse: `~` and `~/<rest>` expanded against $HOME.
#
# ONE DEFINITION OF THE `~` FORM, IN BOTH DIRECTIONS, WHERE THERE WERE FOUR
# (issue 0069). `install_prefix_configured` expanded a config value, a document
# generator wrote its paste line one way and its roots another, and the
# manifest's source needed both directions -- each with its own copy. They
# disagreed about exactly the two edges below, and the roots were written into a
# tracked document with no conversion at all.
#
# AN EMPTY HOME ENCODES NOTHING AND EXPANDS NOTHING. With HOME empty, "$HOME/"
# is "/", which every absolute path starts with: the writer would record a `~`
# followed by the whole absolute path, and the reader would expand `~/opt` to
# `/opt`, a real directory that is not the one meant -- and a publish would
# write into it. Verbatim is refused downstream BY NAME; a wrong absolute path
# is not. A HOME of `/` trims to empty and is treated the same way. That example
# is described rather than written out: a consumer's guard refuses any tracked
# file carrying a home-shaped path, and no pattern can tell prose from a path
# (issue 0109).
#
# THE PREFIX TEST IS "$home"/ AND NEVER "$home" ALONE. `/x/Devbi` is a string
# prefix of `/x/Devbin` and not its parent, and stripping it would write `~n`.
#
# SC2088 IS WRONG FOR BOTH, and each directive sits where it applies. The `~` is
# a CHARACTER in a value -- a config scalar, a manifest line, a line of a
# document someone pastes into their own shell -- and the whole point is that it
# did not expand. In `home_expand` the directive sits on the `case` and not on a
# branch: SC1124 refuses one in front of an individual case item, and putting it
# there does not merely fail to suppress -- it makes the whole expression
# unparseable, so every later check in the file is silently skipped. Measured,
# not assumed (moved here from `install_prefix_configured` with the code).
home_relative() {
  local path="$1" home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ]; then
    case "$path" in
      "$home")
        printf '%s\n' '~'
        return 0
        ;;
      "$home"/*)
        # shellcheck disable=SC2088
        printf '%s\n' "~/${path#"$home"/}"
        return 0
        ;;
    esac
  fi
  printf '%s\n' "$path"
}

home_expand() {
  local v="$1" home="${HOME:-}"
  home="${home%/}"
  if [ -n "$home" ]; then
    # shellcheck disable=SC2088
    case "$v" in
      '~') v="$home" ;;
      '~/'*) v="$home/${v#'~/'}" ;;
    esac
  fi
  printf '%s\n' "$v"
}

# devbin_home_pointer -- the file in which this machine records where its devbin
# install is: one line, the install's absolute root (issue 0153).
#
# OUTSIDE EVERY REPOSITORY, BECAUSE WHERE DEVBIN LIVES IS THE MACHINE'S FACT. The
# manifest is tracked in every project that vendors devbin, and the path it
# recorded named the operator's directory layout in each of them, deliveries to
# clients included. So the manifest says WHAT the source was and the machine
# says WHERE, in the XDG data directory, where a tool conventionally keeps the
# pointer to its install. XDG_DATA_HOME counts only when it is absolute, as the
# XDG spec has it; otherwise ~/.local/share. An empty HOME locates nothing.
devbin_home_pointer() {
  local d="${XDG_DATA_HOME:-}" home="${HOME:-}"
  case "$d" in
    /*) ;;
    *)
      home="${home%/}"
      [ -n "$home" ] || return 1
      d="$home/.local/share"
      ;;
  esac
  printf '%s\n' "${d%/}/devbin/home"
}

# machine_named_state -- what this machine NAMES as its devbin install, before
# anything asks whether the tree there is one. On stdout, one word first:
#
#   at <root>       DEVBIN_INSTALL_PREFIX as given, or the pointer's absolute line
#   none            nothing names one: no override, no pointer
#   bad <reason>    the pointer is there and cannot be read: empty, a link to
#                   nothing, unreadable, or relative
#
# THE ONE READER OF THE POINTER. machine_install_state adds the check this
# leaves out, that a tree the pointer names declares itself an install; a
# caller that lists installs asks this alone, so that the machine's own install
# is still known as one when it has lost the manifest that would say so (issue
# 0153).
machine_named_state() {
  if [ -n "${DEVBIN_INSTALL_PREFIX:-}" ]; then
    printf 'at %s\n' "$(home_expand "$DEVBIN_INSTALL_PREFIX")"
    return 0
  fi
  machine_pointer_state
}

# machine_pointer_state -- what the machine pointer alone names, in
# machine_named_state's three states: the half of it that never asks
# DEVBIN_INSTALL_PREFIX, for a reader whose question is the pointer itself (a
# publish saying what it left alone, a sweep run on the variable).
#
# A LINK TO NOTHING IS SAID AS ONE (critic-shell on 0153 v3.2). Read as a file it
# could not open, it was "empty, or cannot be read", and the remedy every reader
# then gave, a publish, fails on it: replace_file will not write through a link
# that leads nowhere (issue 0084).
machine_pointer_state() {
  local p v=""
  if ! p="$(devbin_home_pointer)" || { [ ! -e "$p" ] && [ ! -L "$p" ]; }; then
    printf 'none\n'
    return 0
  fi
  if [ -L "$p" ] && [ ! -e "$p" ]; then
    printf 'bad the machine pointer %s is a link to nothing, which a publish will not write through -- remove the link\n' "$p"
    return 0
  fi
  # The shell's own word on a redirect it cannot open (a link to nothing, a
  # directory, no read permission) is dropped: the reason below says it, once,
  # to every reader, and the daily notice leaves stderr open.
  if ! { IFS= read -r v <"$p" || [ -n "$v" ]; } 2>/dev/null || [ -z "$v" ]; then
    printf 'bad the machine pointer %s is empty, or cannot be read\n' "$p"
    return 0
  fi
  case "$v" in
    /*) ;;
    *)
      printf "bad the machine pointer %s names '%s', which is not an absolute path\n" "$p" "$v"
      return 0
      ;;
  esac
  printf 'at %s\n' "$v"
}

# machine_install_state -- THREE states, on stdout, one word first:
#
#   at <root>       the machine names an install, and this is its root
#   none            nothing names one: no override, no pointer
#   bad <reason>    the pointer is there and cannot be trusted
#
# DEVBIN_INSTALL_PREFIX FIRST, AS GIVEN, then the pointer: a default with an
# override, the variable `dvb` already reads. A pointer that is empty, a link to
# nothing, relative, or names a tree that does not declare itself an install is
# `bad`, never `none`: a reader told nothing is recorded would say so, and be
# wrong about why. One reading, machine_named_state's, so machine_install_root,
# devbin_source_state and any other caller cannot come to disagree about what
# the pointer says.
machine_install_state() {
  local s m
  s="$(machine_named_state)"
  if [ -z "${DEVBIN_INSTALL_PREFIX:-}" ] && [ "${s%% *}" = at ]; then
    # A manifest that is there and cannot be read says nothing about the tree,
    # so it is named as that, never as a tree that is no install.
    m="$(manifest_path "${s#at }")"
    if [ -e "$m" ] && [ ! -r "$m" ]; then
      printf 'bad the machine pointer %s names %s, whose manifest cannot be read\n' "$(devbin_home_pointer)" "${s#at }"
      return 0
    fi
    if [ "$(manifest_field "${s#at }" kind 2>/dev/null || true)" != install ]; then
      printf 'bad the machine pointer %s names %s, which is not a devbin install\n' "$(devbin_home_pointer)" "${s#at }"
      return 0
    fi
  fi
  printf '%s\n' "$s"
}

# machine_install_namer -- what names this machine's install, as the subject of a
# sentence: DEVBIN_INSTALL_PREFIX while it is set, since it is read first, and
# this machine otherwise, through its pointer. A message that said "this
# machine names" while the variable did sent the reader to a pointer that had
# no say (critic-shell on 0153 v3.2).
machine_install_namer() {
  if [ -n "${DEVBIN_INSTALL_PREFIX:-}" ]; then
    printf 'DEVBIN_INSTALL_PREFIX'
  else
    printf 'this machine'
  fi
}

# source_override_note <root> -- one warning line, when <root>'s recorded source
# is an install and DEVBIN_INSTALL_PREFIX is what placed it, saying so; nothing
# otherwise. For a refusal of the source it placed: the variable is taken as
# given, so the tree it names is never checked before that refusal.
source_override_note() {
  [ -n "${DEVBIN_INSTALL_PREFIX:-}" ] || return 0
  [ "$(manifest_field "$1" source 2>/dev/null || true)" = install ] || return 0
  warn "  DEVBIN_INSTALL_PREFIX names it as this machine's devbin install"
}

# machine_install_root -- the root of this machine's devbin install: rc 0 with
# the root; rc 1, having printed nothing, when nothing names one; rc 2, the
# reason on stderr, when the pointer cannot be trusted.
machine_install_root() {
  local s
  s="$(machine_install_state)"
  case "$s" in
    "at "*) printf '%s\n' "${s#at }" ;;
    none) return 1 ;;
    *)
      warn "${s#bad }"
      return 2
      ;;
  esac
}

# source_unplaced_why <root> -- why <root>'s recorded source cannot be placed
# on this machine, as one clause, for every reader that has to say so: the
# notice and doctor through devbin_source_state, and upgrade and vendor when
# no --from is given. One wording, so they cannot disagree about the cause.
#
# THE KIND RECORDED DECIDES WHAT IS MISSING (issue 0153). A project records the
# kind of source it came from and this machine says where that is, so an
# unplaced source is said as what is missing HERE, never as a record the
# project does not have.
source_unplaced_why() {
  local kind m
  kind="$(manifest_field "$1" source 2>/dev/null || true)"
  case "$kind" in
    "") printf 'this project records no source' ;;
    install)
      m="$(machine_install_state)"
      case "$m" in
        "bad "*) printf '%s' "${m#bad }" ;;
        *) printf 'this project came from a devbin install, and this machine names none: no %s, and DEVBIN_INSTALL_PREFIX is not set' \
          "$(devbin_home_pointer 2>/dev/null || printf 'machine pointer')" ;;
      esac
      ;;
    checkout) printf 'this project came from a devbin checkout, and DEVBIN_SOURCE names none here' ;;
    project) printf 'this project came from another project, which nothing on this machine names' ;;
    *) printf 'the source this project records cannot be read' ;;
  esac
  return 0
}

# manifest_source <root> -- the recorded source, as the absolute path it names.
#
# WHAT IS RECORDED IS A KIND, NEVER A PLACE (issue 0153): `install`, `checkout`
# or `project`, as `manifest_source_token` in lib/install writes them. The place
# comes from this machine -- an install from machine_install_root, a checkout
# from DEVBIN_SOURCE, which names one for `dvb` too -- and a project vendored
# from another project has none, so its caller asks for --from, as it does when
# nothing was recorded at all. Every reader comes through here, so none of them
# knows the difference.
#
# A RECORDED PATH STILL READS (issue 0069): a manifest written before 0153
# carries `~/...`, or before 0069 an absolute path, and either resolves as it
# always did until that project's next upgrade writes the kind in its place.
#
# rc 1 when nothing resolves; rc 2, with machine_install_root's reason on
# stderr, when the machine pointer cannot be trusted.
manifest_source() {
  local v
  v="$(manifest_field "$1" source)" || return 1
  case "$v" in
    install) machine_install_root ;;
    checkout)
      v="${DEVBIN_SOURCE:-}"
      [ -n "$v" ] || return 1
      v="$(home_expand "$v")"
      # dvb accepts the root or its bin/devbin, so this does too.
      case "$v" in */bin/devbin) v="${v%/bin/devbin}" ;; esac
      printf '%s\n' "$v"
      ;;
    project) return 1 ;;
    *) home_expand "$v" ;;
  esac
}

# _devbin_source_head <srcroot> -- the commit the SOURCE currently holds.
#
# rc 0 with a bare sha, or rc 2 when it cannot be told. NO THIRD ANSWER: an
# empty success would be read as "level" by every caller, and "cannot tell" and
# "no change" are the two things this file exists to keep apart.
#
# TWO KINDS OF SOURCE, TWO INSTRUMENTS (ST0005). Until the machine install
# existed a source was always a git checkout, so `git rev-parse HEAD` was the
# only question worth asking. An INSTALL is not a checkout -- it has no .git at
# all -- and asking git returns nothing, which this function's caller correctly
# treated as "say nothing".
#
# MEASURED, NOT ANTICIPATED. The same consumer, at the same staleness, with one
# field changed: pointed at the dev tree the notice SPOKE, pointed at the install
# it went SILENT. So repointing the estate at the install -- which is the entire
# job of ST0005 WP-03 -- would have turned off the update notice on every
# project at once, and the failure is invisible because silence is this notice's
# ordinary state.
#
# An install's own manifest already records the commit it was cut from, under
# the dirty gate, so it is the authority for what that install holds. `kind:`
# is READ rather than the shape being inferred, which is why that header exists.
_devbin_source_head() {
  local src="${1:-}" kind sha
  [ -n "$src" ] || return 2
  [ -d "$src" ] || return 2

  kind="$(manifest_field "$src" kind 2>/dev/null || true)"
  if [ "$kind" = install ]; then
    sha="$(manifest_field "$src" source_commit 2>/dev/null || true)"
  else
    sha="$(git -C "$src" rev-parse HEAD 2>/dev/null)" || return 2
  fi

  # Same normalisation as the recorded side, and for the same reason: the field
  # can carry `<sha> +dirty -- ...` or words instead of a sha. Compared whole,
  # those can never be equal to anything, so the notice would fire forever.
  sha="${sha%% *}"
  is_commit_sha "$sha" || return 2
  printf '%s\n' "$sha"
  return 0
}

# --- which way the source moved -------------------------------------------------
#
# MOVED HERE FROM lib/install (issue 0079). upgrade and vendor asked this and
# the update notice, the offer and doctor did not: they compared two shas for
# equality and called any difference "behind", so a source BEHIND the project
# was offered as an update. The dispatcher loads lib/helpers and not lib/install
# before it offers, so the one direction reader has to live where every asker
# can reach it. install_ancestry, the PUBLISH half that writes the table, stays
# in lib/install.

# source_direction <dstroot> <srcroot> -- which way the source has moved since
# these bytes were vendored:
#
#   same       the source is exactly the commit that was vendored
#   forward    the recorded commit is an ancestor of the source's HEAD
#   backward   the source's HEAD is an ancestor of the recorded commit
#   unrelated  neither contains the other -- a different history
#   unknown    the question cannot be answered from what is on disk
#
# UNKNOWN IS A REAL ANSWER AND MUST NEVER BE READ AS `forward`. There are four
# ways to reach it and none of them is exotic: the field is ABSENT on a manifest
# that predates the field, it is PROSE when the source was not a checkout, it
# carries `+dirty` when the bytes matched no commit, and a fresh clone may
# simply not HAVE the recorded commit. Collapsing any of those into "fine" is
# the direction that costs something -- upgrade syncs from source
# unconditionally, so a downgrade prints `updated` per file and leaves doctor
# green (issue 0021, measured at 11 files).
#
# Reads git in the SOURCE only. The target may not be a checkout at all, and
# whether it is has no bearing on which devbin it received.
#
# AN INSTALL SOURCE IS ANSWERED FROM ITS ANCESTRY TABLE (issue 0059). An install
# is not a git repository, so asking git there answered `unknown` for every
# project vendoring from one -- the whole estate -- and `unknown` was silent. The
# history the question needs was in the checkout the install was PUBLISHED
# from, so that is where it is asked; see install_ancestry.
#
# `+dirty` IS `unknown`, AS THE FIRST PARAGRAPH SAYS -- and until 0059's review
# the code did not do it. It took the first word and compared the sha, so bytes
# vendored from `C` plus uncommitted work read `same` against a source holding
# `C`, and upgrade dropped the work with no direction line. Measured by
# critic-shell on 2026-09-16. The sha names where the bytes STARTED, not what
# they are, so no direction follows from it.
source_direction() {
  local dstroot="$1" srcroot="$2" rec
  rec="$(manifest_source_commit "$dstroot" 2>/dev/null || true)"
  case "$rec" in *' +dirty'*) printf 'unknown\n'; return 0 ;; esac
  # The recorded value is a LINE, not a field: `<sha>` or a whole sentence.
  # Taking the first word reduces both to something that either is a sha or
  # visibly is not.
  rec="${rec%% *}"
  is_commit_sha "$rec" || { printf 'unknown\n'; return 0; }

  if [ "$(manifest_field "$srcroot" kind 2>/dev/null || true)" = install ]; then
    install_direction "$srcroot" "$rec"
    return 0
  fi
  commit_direction "$srcroot" "$rec"
}

# is_commit_sha <word> -- true when <word> can name a commit: lowercase hex, at
# least seven characters.
#
# ONE CHECK, because three copies of it had already drifted by the time 0059's
# review read them: one dropped the length test. The length test is not
# redundant with the charset one -- `a checkout with no HEAD` reduces to `a` by
# first word, and `a` is valid hex.
is_commit_sha() {
  case "$1" in '' | *[!0-9a-f]*) return 1 ;; esac
  [ "${#1}" -ge 7 ]
}

# commit_direction <checkout> <sha> [<to>] -- which way <to> (default: the
# checkout's HEAD) has moved from <sha>: `same`, `forward`, `backward`,
# `unrelated` or `unknown`.
#
# The git half of source_direction, separate because a PUBLISH asks the same
# question of every commit an install has held (install_ancestry), and the
# release core asks it of a remote's branch head (release_read_remote, which is
# why <to> exists). Two copies of the ancestry rules would be two answers to
# one question -- updatenotice.bats holds this as the only place ancestry is
# asked.
commit_direction() {
  local srcroot="$1" rec="$2" head
  git -C "$srcroot" rev-parse --git-dir >/dev/null 2>&1 ||
    { printf 'unknown\n'; return 0; }
  head="$(git -C "$srcroot" rev-parse -q --verify "${3:-HEAD}^{commit}" 2>/dev/null)" || head=""
  [ -n "$head" ] || { printf 'unknown\n'; return 0; }
  # ASKED BEFORE THE ANCESTRY TESTS, because `merge-base --is-ancestor` returns
  # 1 both for "not an ancestor" and for a commit this repository has never
  # heard of, and those are `unrelated` and `unknown` respectively.
  git -C "$srcroot" cat-file -e "$rec^{commit}" 2>/dev/null ||
    { printf 'unknown\n'; return 0; }

  case "$head" in "$rec"*) printf 'same\n'; return 0 ;; esac
  if git -C "$srcroot" merge-base --is-ancestor "$rec" "$head" 2>/dev/null; then
    printf 'forward\n'
  elif git -C "$srcroot" merge-base --is-ancestor "$head" "$rec" 2>/dev/null; then
    printf 'backward\n'
  else
    printf 'unrelated\n'
  fi
  return 0
}

# manifest_ancestry <root> -- the ancestry table as `<sha><TAB><direction>` lines.
#
# Read by its own reader rather than manifest_field, which returns ONE value per
# key and this key repeats. Header lines only: the table ends where the header
# does, exactly as manifest_field's does.
manifest_ancestry() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 0
  awk '
    $0 !~ /^#/ { exit }
    /^#[[:space:]]*ancestry:[[:space:]]/ {
      line = $0
      sub(/^#[[:space:]]*ancestry:[[:space:]]*/, "", line)
      if (split(line, f, /[[:space:]]+/) == 2) printf "%s\t%s\n", f[1], f[2]
    }
  ' "$path"
}

# install_direction <install> <sha> -- source_direction's answer when the source
# is an install: looked up, never computed, because nothing here has history.
#
# `same` when <sha> is the commit the install holds; the recorded direction when
# the table has it; `unknown` otherwise. NOT FOUND IS UNKNOWN, never `forward`:
# a commit the install never held is exactly the case nobody can vouch for.
install_direction() {
  local install="$1" rec="$2" head line sha dir
  # The install's commit through the one reader of "which commit does this
  # source hold", not a second parse of the same header.
  head="$(_devbin_source_head "$install" 2>/dev/null)" || head=""
  is_commit_sha "$head" || { printf 'unknown\n'; return 0; }
  # EXACT MATCHES ONLY. Every writer records full shas; a short recorded value
  # comes from a hand edit, and a prefix could match a row it does not name.
  [ "$head" = "$rec" ] && { printf 'same\n'; return 0; }
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    sha="${line%%	*}"
    dir="${line#*	}"
    [ "$sha" = "$rec" ] || continue
    case "$dir" in
      forward | backward | unrelated) printf '%s\n' "$dir" ;;
      *) printf 'unknown\n' ;;
    esac
    return 0
  done <<EOF
$(manifest_ancestry "$install")
EOF
  printf 'unknown\n'
  return 0
}

# is_yes_answer <reply> -- true when <reply> is a yes: y or yes, in any case.
#
# THE ONE ANSWER SET FOR EVERY QUESTION devbin ASKS A PERSON (issue 0134).
# ask_person took y or Y and devbin_offer_upgrade took y, Y, yes and YES, so a
# person who answered yes to fullcycle was told the cycle was declined, and one
# who answered Yes to the upgrade offer was told the same.
is_yes_answer() {
  case "${1,,}" in
    y | yes) return 0 ;;
    *) return 1 ;;
  esac
}

# stdin_tty_flag -- `1` when this process's stdin is a terminal, else `0`: the
# rule DEVBIN_GATE_TTY is read by in a devbin process (issue 0088). gate_exec
# reads the flag this way for the command it runs, so a stale inherited value
# cannot stand -- a tool it runs keeps the flag only inside the gate, and
# bin/devbin drops that mark -- and a caller that must ask a person BEFORE its
# gate opens -- fullcycle (0096) -- reads the same rule here.
stdin_tty_flag() {
  if [ -t 0 ]; then printf '1\n'; else printf '0\n'; fi
}

# gate_exec <command> [args...] -- run <command> as a gated tool runs, and
# return its status: stdin from /dev/null, so a tool that would prompt reads
# EOF instead of waiting on a terminal nobody may be watching, and
# DEVBIN_GATE_TTY saying whether a person IS at one, so devbin's own code can
# still ask through /dev/tty (issue 0088).
#
# THE ONE DEFINITION OF THAT RULE (issue 0158). run_gate wrote it inline, so a
# project's own handler that runs a gate tool directly got neither half: a
# prompting tool blocked at a terminal while an agent read EOF, and each
# handler would have had to copy the redirect at every tool line.
#
# IT LIVES IN lib/helpers, NOT lib/runlog, AND THAT IS THE POINT: a scaffolded
# handler sources helpers alone (lib/tmpl/handler), and a project's handler is
# exactly the caller this exists for. Do not tidy it back into runlog.
#
# THE FLAG DESCRIBES THE PERSON, SO INSIDE A GATE IT IS KEPT (critic-shell on
# 0158 v1). A command run under this one is told it is inside a gate
# (DEVBIN_IN_GATE=1), and there the gate's own stdin is /dev/null, so asking it
# again would say no person is there while the gate around it knew one was:
# release's `version set` and `after:` lines, which inherited the flag before,
# would have lost it. Outside a gate the flag is read from this stdin, whatever
# the environment carries, so a stale one still cannot stand (issue 0088).
#
# AN EMPTY COMMAND IS REFUSED: with no word to run, the assignments in front
# of it would be made in the caller's own shell, and nothing would run at rc 0.
#
# The local carries its own prefix: <command> may be a shell function, which
# sees this function's locals by dynamic scope.
gate_exec() {
  local _ge_tty
  if [ "$#" -eq 0 ]; then
    warn "gate_exec: no command to run"
    return 2
  fi
  case "${DEVBIN_IN_GATE:-}:${DEVBIN_GATE_TTY:-}" in
    1:0 | 1:1) _ge_tty="$DEVBIN_GATE_TTY" ;;
    *) _ge_tty="$(stdin_tty_flag)" ;;
  esac
  DEVBIN_IN_GATE=1 DEVBIN_GATE_TTY="$_ge_tty" "$@" </dev/null
}

# ask_person <question> -- ask a person at the terminal a yes/no question, from
# inside a gate. Prints `<question> [y/N] ` and reads the answer from /dev/tty.
#   0  the answer was a yes: y or yes, in any case (is_yes_answer)
#   1  any other answer, end of input included
#   2  nobody to ask: no readable /dev/tty, or the gate's stdin was not a terminal
# The caller says what each means for it; 2 is never folded into 1, because
# "declined" and "could not ask" are different answers. Every caller now exits
# 1 for both and says which in its message: release exited 2 for the second,
# as ST0007 AC-5.3 asked, until issue 0130 gave 2 back to the dispatcher.
#
# THE ONE HOME FOR THE QUESTION (issue 0089, option B): clean, fullcycle
# and the release core's first-push confirmation all ask through here, so the
# rule for "is a person here" is written once.
#
# READS /dev/tty, NEVER STDIN. run_gate hands every gated tool </dev/null
# (issue 0088, row 2), so a gated function's stdin is empty and its stdout is a
# pipe; an answer cannot come through that plumbing at all.
#
# "IS A PERSON HERE" IS THE GATE'S DEVBIN_GATE_TTY, NOT `-t 0`. Under a gate
# stdin is never the terminal, and run_gate always sets the flag from its OWN
# stdin, so the flag alone answers it. `-r /dev/tty` alone is not enough, which
# is issue 0058: it holds for any process with a controlling terminal -- a test
# suite, a script with its stdin redirected -- and the suite once printed a
# prompt into bats's captured output and blocked on a keystroke nobody knew was
# being asked for (2026-09-06). The `:-0` default answers "nobody" for a caller
# outside a gate; every caller today is inside one, so no arm holds it.
#
# FOR A GATED CALLER ONLY. devbin_offer_upgrade, below, asks from OUTSIDE any
# gate, where the flag is either unset or inherited from a parent gate and so
# says nothing about this process; it keeps its own `-t 0` test for that reason.
ask_person() {
  local reply
  if [ ! -r /dev/tty ] || [ "${DEVBIN_GATE_TTY:-0}" != 1 ]; then
    return 2
  fi
  printf '%s [y/N] ' "$1"
  IFS= read -r reply </dev/tty || reply=""
  is_yes_answer "$reply" || return 1
}

# devbin_offer_upgrade <projroot> -- ask, on a real terminal, whether to
# upgrade now. Returns 0 whether or not anything was done.
#
# WHY THIS IS NARROW, AND IT IS A DELIBERATE NARROWING OF WHAT WAS ASKED FOR.
# The request was an offer "when it is next used". This offers on the BARE
# invocation and on `doctor`, not on every command, because there is no way for
# the dispatcher to know whether the command it is about to run is a gate --
# gate-ness is decided inside the handler, after dispatch, and the catalogue
# does not record it. `devbin test all` typed at a terminal would reach this
# code with stderr still a terminal, and stopping to ask about upgrades before
# running somebody's tests is the same defect as issue 0058 wearing a friendlier
# face. Bare and `doctor` are never gates by construction rather than by a check
# that could drift, and they are where a person is looking at devbin itself.
#
# THE TERMINAL TEST IS 0058's, BOTH ARMS. `read </dev/tty` ignores stdin, so
# `-t 0` alone would not stop it blocking; `-r /dev/tty` alone passes on any
# machine with a tty device node, which is every CI runner. Neither half works
# on its own -- that is what cost 6m30s of a hung suite on 2026-09-06.
#
# `-t 2` as well, matching the notice: a sealed gate's stderr is a pipe, so this
# cannot speak from inside one even if it were ever reached there.
devbin_offer_upgrade() {
  local root="${1:-}" state word rec cur reply
  [ -n "$root" ] || return 0
  [ -n "${DEVBIN_NO_UPDATE_NOTICE:-}" ] && return 0
  # A DEVBIN LAUNCHED BY THIS OFFER NEVER OFFERS AGAIN.
  #
  # The yes branch runs `bin/devbin upgrade`, which re-enters the dispatcher --
  # and while that upgrade is still running the project is STILL behind, so a
  # second offer is made, which launches a third upgrade. Found by mutation on
  # 2026-09-06: widening the offer to every command turned this into a live
  # recursion that hung the suite rather than failing an assertion.
  #
  # Today the command scoping happens to prevent it, because `upgrade` is not in
  # the offered set. THAT IS INCIDENTAL PROTECTION, not a guard: it holds only
  # while nobody widens the set, and the mutation is exactly what widening looks
  # like. The sentinel makes it intrinsic.
  [ -n "${DEVBIN_OFFER_IN_PROGRESS:-}" ] && return 0
  [ -t 2 ] || return 0
  [ -t 0 ] || return 0
  [ -r /dev/tty ] || return 0

  # ONLY `behind` -- the source moved FORWARD -- is an update (issue 0079). This
  # matched on any difference, so a consumer AHEAD of a rewound install was told
  # "An update to devbin is available", and a yes ran the upgrade that reverts
  # it. upgrade's own BEHIND warning came after the person had already chosen.
  state="$(devbin_source_state "$root")"
  IFS=' ' read -r word rec cur _ <<<"$state"
  [ "$word" = behind ] || return 0

  {
    printf 'An update to devbin is available.\n'
    printf '  this project has: %s\n' "${rec:0:12}"
    printf '  the source has:   %s\n' "${cur:0:12}"
    printf '  from:             %s\n' "$(manifest_source "$root" 2>/dev/null || printf 'unrecorded')"
    printf '\nUpgrading rewrites the vendored runtime in your working tree.\n'
  } >&2
  printf 'Upgrade now? [y/N] ' >&2
  # Read from the terminal, not stdin: the caller may have redirected stdin for
  # its own reasons and this question is for the person, not the pipeline.
  # EOF DECLINES, it does not vanish -- the shape `_clean_confirm` uses. An
  # early `return 0` here made the no-answer case indistinguishable from the
  # offer never having been made, which is the state a pty-at-EOF test sees.
  IFS= read -r reply </dev/tty || reply=""
  if ! is_yes_answer "$reply"; then
    printf 'Left as it is. Run: %s upgrade\n' \
      "${DEVBIN_INVOKE:-bin/devbin}" >&2
    return 0
  fi
  printf '\n' >&2
  # Runs the real verb rather than reimplementing it: upgrade owns what an
  # upgrade is, including every refusal it makes about edited files.
  ( cd "$root" && DEVBIN_OFFER_IN_PROGRESS=1 ./bin/devbin upgrade ) || true
  return 0
}

# devbin_source_state <projroot> -- FIVE states, on stdout, one word first.
#
#   level                           the vendored runtime is what the source holds
#   behind <recorded> <now>         the source has moved FORWARD past this project
#   ahead <recorded> <now>          the source is BEHIND this project
#   differs <recorded> <now> <why>  they differ, and in no direction anyone knows
#   unknown <reason>                it could not be established
#
# ONLY `behind` IS AN UPDATE (issue 0079). This had three states and compared
# two shas for equality, so every difference was `behind` -- and the notice, the
# offer and doctor all told a project AHEAD of a rewound source to upgrade,
# which is issue 0021's silent revert, measured at 11 files. The direction now
# comes from source_direction, the answer upgrade and vendor already read, so
# nothing here can call a move "an update" that upgrade would call a revert.
#
# `differs` IS NOT `unknown`. A record the source cannot place, or a source on
# another history, is a REAL difference, and staying quiet about it hides one;
# but nothing vouches the source is newer, so it is never called an update.
# `unknown` is for when there was no difference to report: nothing to compare,
# or the same commit on both sides with no direction established for it.
#
# `ahead` IS A CLAIM ABOUT HISTORY, NOT BYTES. The source holds an older commit
# than the one this project vendored; whether any vendored FILE would change is
# upgrade's question (seam_is_level, lib/install), and a source that moved only
# outside the seam changes none. So the readers say which way the commits lie
# and never that an upgrade would revert the runtime. `behind` has the mirror
# limit, and has always had it: a forward move outside the seam is still
# offered as an update.
#
# WHY THIS EXISTS SEPARATELY FROM THE NOTICE. `_devbin_update_line` prints or
# stays quiet, and quiet is its answer for BOTH "level" and "cannot tell". That
# is right for a notice -- it asserts nothing and must never nag -- and it is
# exactly wrong for a CHECK, where the two must not collapse. Absent is not
# clean; a check that cannot reach the source and reports nothing is read as
# reporting currency it never established.
#
# The notice, the offer and `doctor` all read this, and it asks
# `_devbin_source_head` and source_direction, so there is one answer to "what
# does the source hold" and one to "which way did it move".
devbin_source_state() {
  local root="${1:-}" src rec cur
  [ -n "$root" ] || { printf 'unknown no project root given\n'; return 0; }

  src="$(manifest_source "$root" 2>/dev/null || true)"
  if [ -z "$src" ]; then
    printf 'unknown %s\n' "$(source_unplaced_why "$root")"
    return 0
  fi
  rec="$(manifest_source_commit "$root" 2>/dev/null || true)"
  [ -n "$rec" ] || { printf 'unknown this project records no source commit\n'; return 0; }
  [ -d "$src" ] || { printf 'unknown the source is not on this machine: %s\n' "$src"; return 0; }

  rec="${rec%% *}"
  is_commit_sha "$rec" ||
    { printf 'unknown this project records bytes that name no commit\n'; return 0; }
  if ! cur="$(_devbin_source_head "$src")"; then
    printf 'unknown the source names no commit: %s\n' "$src"
    return 0
  fi

  case "$(source_direction "$root" "$src")" in
    same) printf 'level\n' ;;
    forward) printf 'behind %s %s\n' "$rec" "$cur" ;;
    backward) printf 'ahead %s %s\n' "$rec" "$cur" ;;
    unrelated) printf 'differs %s %s the source is on a different history\n' "$rec" "$cur" ;;
    *)
      # EQUAL SHAS WITH NO DIRECTION. Today that is a `+dirty` record at the
      # source's own commit: the bytes started there and are not it, and it read
      # `level` until 0079 because the sha was stripped of its mark and then
      # compared. The reason names what is known rather than inferring the mark.
      if [ "$rec" = "$cur" ]; then
        printf 'unknown this project records the commit the source holds, but no direction could be established for it (a +dirty record reads this way)\n'
      else
        printf 'differs %s %s which way the source moved cannot be told from what is on disk\n' "$rec" "$cur"
      fi
      ;;
  esac
  return 0
}

# _devbin_update_line <projroot> -- print the notice body, or nothing.
#
# SEPARATED FROM DELIVERY SO IT CAN BE TESTED. The comparison is the part with
# the logic in it and the guards are the part with the policy; keeping them in
# one function made the whole thing reachable only through a real terminal.
#
# THE TERMINAL PROBLEM IS SOLVED AND THIS PARAGRAPH USED TO SAY OTHERWISE. It
# read, in the present tense, that "the only way to give a test one is `script`,
# which fails outright when stdin is a socket", and recorded that two tests
# asserting the notice stayed SILENT had passed vacuously -- no pty, no output,
# refutation satisfied. That was true when written and has not been true since
# `run_tty_eof` (tests/lib/test_helper.bash) landed: `script` starts when its
# OWN stdin is `/dev/null`, and the child still gets the allocated pty. The
# delivery half is exercised for real today -- `ON A TERMINAL the notice
# actually SPEAKS` is green, not skipped.
#
# The correction is kept rather than the paragraph deleted, because the stale
# version cost something measurable: a node read it as a live gap, re-derived
# the `</dev/null` trick from scratch, and offered it as a fix that was already
# in the tree. A comment describing a solved problem in the present tense is a
# claim with an expiry date, and this file is where that class gets recorded.
#
# Prints to stdout; the caller decides where it goes. Empty output means there
# is nothing to say.
_devbin_update_line() {
  local root="${1:-}" state word rec cur why
  [ -n "$root" ] || return 0

  # ONE READER OF THE STATE, NOT A SECOND COMPARISON (issue 0079). This kept its
  # own sha check and its own equality test beside devbin_source_state's, so the
  # two could disagree and both called any difference "moved on".
  state="$(devbin_source_state "$root")"
  IFS=' ' read -r word rec cur why <<<"$state"

  # Twelve characters, and only ever printed when the full shas differ. The
  # first version truncated BEFORE comparing like with like, so it printed two
  # identical-looking values as its evidence that they differed -- the
  # truncation did not merely fail to help, it hid the cause.
  case "$word" in
    behind)
      printf 'UPDATE: devbin has moved on since this project vendored it.\n'
      printf '        vendored %s, source now %s\n' "${rec:0:12}" "${cur:0:12}"
      printf '        run: %s upgrade      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
    ahead)
      printf 'NOTE: the devbin this project came from is BEHIND this project.\n'
      printf '      vendored %s, source now %s -- an older commit\n' "${rec:0:12}" "${cur:0:12}"
      printf '      run: %s vendor, before any upgrade      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
    differs)
      printf 'NOTE: the devbin this project came from differs from what it vendored: %s.\n' "$why"
      printf '      vendored %s, source now %s\n' "${rec:0:12}" "${cur:0:12}"
      printf '      it is not known to be newer; run: %s vendor      (silence: DEVBIN_NO_UPDATE_NOTICE=1)\n' \
        "${DEVBIN_INVOKE:-bin/devbin}"
      ;;
  esac
  return 0
}

# devbin_update_notice <projroot> -- tell the user, ONCE A DAY AND ONLY ON A
# TERMINAL, that the devbin this project vendored has moved on, is behind it, or
# differs from it in no known direction (issue 0079).
#
# THE POINT IS THAT A CONSUMING PROJECT LEARNS WITHOUT BEING ASKED. `vendor`
# already answers "is this tree level with its SOURCE" -- the comparison is not
# new, only the moment it is made. What is new is that the answer reaches
# someone who was not investigating.
#
# FOUR CONSTRAINTS, AND THE FIRST IS NOT OBVIOUS.
#
#   STDERR, NEVER STDOUT. devbin seals gate output and seven extraction grammars
#   parse it; two print on unanchored patterns. A version notice on stdout lands
#   INSIDE a run log and is read as tool output -- issue 0025's class exactly.
#
#   A TERMINAL, OR NOTHING. `[ -t 2 ]` keeps it out of CI logs and out of sealed
#   gates, whose stderr is a pipe. Load-bearing, not a nicety.
#
#   ONCE A DAY. A git call on every invocation would put a fork on the hot path
#   of a launcher that runs on every command.
#
#   NEVER FATAL, AND NEVER NOISY ABOUT ITS OWN FAILURE. A consumer usually does
#   not have devbin's source on disk at all. That is the ordinary case, so every
#   failure path is a silent `return 0`. This is the one place in devbin where
#   swallowing is correct: the function asserts nothing, and IN-AG-NO-SILENT-001
#   is about failures that reach a verdict.
#
# THE STAMP IS WRITTEN BEFORE THE COMPARISON, DELIBERATELY: the rate limit is on
# the CHECK, not on the message, so a source that moves on five minutes after a
# check is reported at the next day's check rather than on the next command.
devbin_update_notice() {
  local root="${1:-}" stamp msg dir base
  [ -n "$root" ] || return 0
  [ -n "${DEVBIN_NO_UPDATE_NOTICE:-}" ] && return 0
  [ -t 2 ] || return 0

  # The stamp lives in TMPDIR rather than the project, so it needs no .gitignore
  # entry and can never appear in a consumer's git status.
  base=".devbin-update-$(printf '%s' "$root" | tr -c 'a-zA-Z0-9' '-')"
  dir="${TMPDIR:-/tmp}"
  stamp="$dir/$base"
  # -mtime is POSIX; -newermt is GNU-only, and devbin runs on macOS too.
  #
  # find's errors go to /dev/null HERE ON PURPOSE, one of two finds in lib/ that
  # may (issue 0139); the other is lib/install's seam check, which reads find's
  # status and answers UNREADABLE. This said "the one" until critic-shell's
  # review of 0139. It asks only whether today's notice was already shown, and
  # a find that fails answers "not shown", which re-runs a check that prints at
  # most one line: the failure costs a repeat, never a wrong verdict, and an
  # error printed before every command would cost more than the notice is worth.
  # find-walk: -maxdepth 1 -- one stamp file in one directory; it never enters one
  # find-status: dropped -- a failure here only repeats the daily update check.
  if [ -f "$stamp" ] && [ -n "$(find "$dir" -maxdepth 1 -name "$base" -mtime -1 2>/dev/null)" ]; then
    return 0
  fi
  : >"$stamp" 2>/dev/null || true

  msg="$(_devbin_update_line "$root")"
  [ -n "$msg" ] && printf '%s\n' "$msg" >&2
  return 0
}
