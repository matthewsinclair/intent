#!/usr/bin/env bash
#
# lib/infra -- the infra PROFILE: resolution, load, and parse-time validation.
#
# Sourced, never executed. It answers three questions and nothing else: which
# profile file applies, does it parse, and is it internally consistent. It makes
# no network call and reads no live state, which is the whole point of the split
# -- a malformed PROFILE and a wrong ESTATE are different problems with
# different fixes, and a run that conflates them produces a red nobody can act
# on. Everything here is catchable before `check` resolves a single record.
#
# ONE YAML READER. This uses `lib/config`'s `cfg_load` and adds no parser of its
# own (design D7: no yq; the Highlander rule does the rest). That constraint is
# tighter than it looks and it SHAPED the schema rather than merely permitting
# it -- see `infra_validate_profile` for the guarantee it cost us.
#
# WHY DOMAINS ARE KEYED BY A HANDLE AND NOT BY THEIR FQDN. The agreed schema
# keyed them by domain name. `lib/config` refuses a key containing a dot, and
# also refuses flow collections and sequences of maps, so neither the map form
# nor the list-of-objects fallback parses. The FQDN therefore moved from the KEY
# to a FIELD -- and YAML keys are unique BY CONSTRUCTION, so "one entry per
# domain" had been enforced by the format, written down nowhere, and it vanished
# silently with the format change. `infra_validate_profile` re-imposes it as an
# explicit rule. A constraint the format was carrying is the kind that
# disappears in a mechanical fix precisely because nobody ever had to state it.
#
# EVERY KEY IS ONE SOMETHING READS (issue 0143). `_INFRA_PROFILE_KEYS`, at the
# foot of this file, is the one statement of the keys a profile may carry, and a
# key it has no row for is refused before anything is checked. Until 0143 no
# such list existed, so a key the schema had no field for parsed, validated and
# was never read: vc drove a profile declaring a DMARC sp=, a sender's second
# DKIM key and a wildcard against a zone carrying none of them, and check said
# "4 assertion(s) held, 0 drift, 0 NOT MEASURED" at rc 0.

[ -n "${_DEVBIN_INFRA_LOADED:-}" ] && return 0
_DEVBIN_INFRA_LOADED=1

# infra_profile_paths -- the search order, one per line, most specific first.
# Printed rather than returned so a failure can name EVERY path it tried: an
# error naming only the last place looked sends the reader to the wrong file.
infra_profile_paths() {
  printf '%s\n' "\$DEVBIN_INFRA_PROFILE${DEVBIN_INFRA_PROFILE:+ ($DEVBIN_INFRA_PROFILE)}"
  printf '%s\n' "${PROJECT_ROOT:-.}/infra.yaml"
  printf '%s\n' "$HOME/.config/devbin/infra.yaml"
}

# infra_resolve_profile [<explicit>] -- echo the profile path, or die naming
# every candidate. A profile NAMED by --profile or $DEVBIN_INFRA_PROFILE that
# does not exist is a DIFFERENT failure from finding none: the caller named a
# file, so the search order is not the answer they need.
#
# BOTH SPELLINGS OF "THIS FILE" GET THE SAME ANSWER (issue 0121). A
# DEVBIN_INFRA_PROFILE naming nothing used to fall through to the search below,
# so a typo in the variable checked a DIFFERENT profile and nothing said so,
# while the same intent spelled as --profile was refused by name.
infra_resolve_profile() {
  local explicit="${1:-}" p
  if [ -n "$explicit" ]; then
    [ -f "$explicit" ] || die "infra: no profile at $explicit (named with --profile)"
    printf '%s\n' "$explicit"
    return 0
  fi
  if [ -n "${DEVBIN_INFRA_PROFILE:-}" ]; then
    [ -f "$DEVBIN_INFRA_PROFILE" ] || die "infra: no profile at $DEVBIN_INFRA_PROFILE (named by DEVBIN_INFRA_PROFILE)"
    printf '%s\n' "$DEVBIN_INFRA_PROFILE"
    return 0
  fi
  for p in "${PROJECT_ROOT:-.}/infra.yaml" "$HOME/.config/devbin/infra.yaml"; do
    [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  {
    printf 'infra: no profile found. Tried, in order:\n'
    infra_profile_paths | sed 's/^/  /'
    printf '\nA profile is never defaulted and never assumed empty -- an infra\n'
    printf 'command that finds no profile and reports nothing wrong is the false\n'
    printf 'green this command exists to refuse.\n'
  } >&2
  return 1
}

# infra_handle_matches_name <handle> <fqdn> -- is the handle a recognisable
# derivation of the FQDN? Deliberately loose: the handle is a label, and
# `prod`/`staging` handles for one FQDN may be wanted later, so a mismatch is
# a WARNING and never an error. Foreclosing that on a guess would cost more
# than the confusion it prevents.
infra_handle_matches_name() {
  local handle="$1" fqdn="$2" label="${2%%.*}"
  [ "$handle" = "$label" ] && return 0
  case "$fqdn" in *"$handle"*) return 0 ;; esac
  return 1
}

# infra_assert_written_keys_visible <file> -- every key WRITTEN in the profile
# must have reached the cache, as a value of its own or as keys under it. One
# that did neither is valueless, and it is refused and named.
#
# WHY THIS EXISTS, AND WHY IT IS NOT A SECOND YAML PARSER. `lib/config`'s reader
# emits a cache row only for a key carrying a SCALAR. A key with no value
# produces no row at all, so `unreviewed: mx_form:` and a profile with no
# `unreviewed:` block are INDISTINGUISHABLE through `cfg_list` -- and so are a
# declared domain with no fields and a domain nobody wrote. Both were measured:
# a profile carrying two authored deviations passed the gate with "valid and
# fully reviewed", and a declared domain vanished from `show` with rc 0.
#
# THAT BLINDNESS POINTS THE WRONG WAY BY CONSTRUCTION. A deviation `init` could
# not confidently propose is PRECISELY the one with nothing to put on the
# right-hand side, so the gate is blind in exactly the direction it was built to
# see. A valueless entry is refused rather than skipped, which also makes the
# artefact better: a deviation with no stated reason is unreviewable anyway.
#
# The scan reads KEYS and their nesting and nothing else -- no values, no types,
# no merging -- to ask "was this written?", the one question the reader cannot
# answer. The file has already been through `cfg_load`, so its indentation is
# known to be well formed. A written key is visible when the cache holds a row
# AT its path or UNDER it: awk reads the cache first and the file second, and
# prints the paths that are neither.
#
# ONE SCAN OF THE WHOLE FILE SINCE ISSUE 0143. It covered the children of
# `domains:` and `unreviewed:` alone, and 0143 added a block of labels exactly
# like `domains:` -- a sender's DKIM records -- where a label written with no
# fields would vanish and its record never be asked for. A rule per block is a
# rule that waits for its next block.
infra_assert_written_keys_visible() {
  local missing
  missing="$(awk '
    NR == FNR {
      p = $0; sub(/\t.*/, "", p)
      if (p == "") next
      have[p] = 1
      while (sub(/\.[^.]*$/, "", p)) have[p] = 1
      next
    }
    /^[[:space:]]*$/ || /^[[:space:]]*#/ || /^---[[:space:]]*$/ { next }
    {
      match($0, /^ */); w = RLENGTH
      body = substr($0, w + 1)
      if (substr(body, 1, 2) == "- ") next
      c = index(body, ":"); if (c == 0) next
      k = substr(body, 1, c - 1); sub(/[[:space:]]+$/, "", k)
      while (depth > 0 && ind[depth] >= w) depth--
      p = ""; for (i = 1; i <= depth; i++) p = p key[i] "."
      p = p k
      if (!(p in have)) printf "%s ", p
      depth++; ind[depth] = w; key[depth] = k
    }' - "$1" <<<"$_DEVBIN_CFG")" || {
    # A scan that could not run found nothing, and "nothing" is the pass.
    printf 'infra: %s: could not be scanned for keys written with no value, so no key in it is known to be visible\n' "$1" >&2
    return 1
  }
  [ -n "$missing" ] || return 0
  {
    printf 'infra: these keys are written but carry no value, so nothing can read them: %s\n' "${missing% }"
    printf '       A key with no value is invisible to the config reader -- it is not\n'
    printf '       an empty entry, it is an absent one. Give each a value.\n'
  } >&2
  return 1
}

# infra_validate_profile -- PARSE-TIME rules only. Errors accumulate so one run
# reports every fault rather than the first; a validator that stops at fault one
# turns a five-minute fix into five runs.
# infra_domain_pairs -- `<handle><TAB><fqdn>` for every domain in the LOADED
# profile, one per line. THE one place that knows how a profile spells its
# domains.
#
# Added 2026-09-07 with the cross-profile check, which needed the same walk.
# Written as a shared function rather than a second loop because the shape it
# encodes -- handle is the key, FQDN is a FIELD -- is exactly what the
# documentation got wrong for the whole of 0.1.0, and two readers of it would be
# two things to correct the next time it moves.
#
# A handle whose `name:` is missing is emitted with an EMPTY fqdn rather than
# skipped: the validator reports that as an error, and a walk that dropped it
# would hand every other caller a profile that looks smaller than it is.
infra_domain_pairs() {
  local h n
  for h in $(cfg_list domains); do
    n="$(cfg_get "domains.$h.name" 2>/dev/null || true)"
    printf '%s\t%s\n' "$h" "$n"
  done
}

# SC2016 is suppressed for THIS function too, with its OWN directive rather
# than sharing the one below. A `disable` comment binds to the NEXT command,
# so dropping a function between that comment and the function it documents
# relocates the suppression silently -- which is exactly what the first draft
# of this change did, leaving `infra_validate_profile` unguarded and five
# pre-existing lines newly red. The comment said `for the function`; it could
# not say WHICH, because position was the only thing binding them.
# shellcheck disable=SC2016
# THE UNIVERSAL SENDER INVARIANT, and it needs no per-vendor table to state:
#
#   A domain declaring a sender must carry a MATCHED SPF include and DKIM
#   selector pair, and the two must be consistent with each other.
#
# "PAIR" WAS AN ASSUMPTION ABOUT VENDORS, NOT THE RULE (issue 0143). MailerSend
# moved on 2026-09-08 from one DKIM record to two, ms1 and ms2, and rotates
# between them, so the rule's arithmetic is: no SPF include without EVERY DKIM
# record that authorises it. A sender declares one record or several
# (infra_sender_dkim_records); this asks for the include and at least one, and
# infra_sender_dkim_shape holds each record's own form, for every sender.
#
# design.md settles that this is what the known-sender library ships -- the
# pair's SHAPE, never its contents. A shipped `mailersend: {spf:
# _spf.mailersend.net}` WOULD HAVE BEEN WRONG for a live domain sitting on
# `_spf.mlsend.com`, and neither node could establish whether that split is
# account-specific or generational. Shipping a value commits to an answer
# nobody has; the invariant is correct either way.
#
# WHAT THIS FIXES IS A MISCLASSIFICATION, measured against a real estate on
# 2026-09-08. Two live domains name `mailersend` in profiles that never define
# it, and `check` reported "names sender `mailersend` which the profile does
# not define -- the matched-pair check CANNOT RUN for it" under COULD NOT
# MEASURE, whose own header reads "gaps in the INSTRUMENT, not verdicts".
#
# THAT IS THE WRONG CHANNEL AND IT UNDERSTATES THE FAULT. Nothing about the
# instrument is missing: the profile is the TARGET STATE, and a target naming a
# sender it never describes is INCOMPLETE. It is a malformed profile, it is
# catchable before any network call, and it belongs with the other parse-time
# refusals -- "your profile is wrong" and "your estate is wrong" are different
# problems with different fixes, and this one was wearing the other's clothes.
infra_sender_pair_complete() {
  local name="$1" inc miss=""
  inc="$(cfg_get "senders.$name.spf_include" 2>/dev/null || true)"
  [ -n "$inc" ] || miss="$miss spf_include"
  [ -n "$(infra_sender_dkim_records "$name")" ] || miss="$miss dkim.name"
  [ -n "$miss" ] || return 0
  {
    printf 'infra: sender `%s` is defined with only HALF A PAIR -- missing:%s
' "$name" "$miss"
    printf '       A sender authorised in SPF with no DKIM selector to match makes
'
    printf '       that mail indistinguishable from a forgery of it. Declaring half
'
    printf '       the pair as the TARGET builds that state on purpose.
'
  } >&2
  return 1
}

#
# SC2016 is suppressed for the function, not line by line, for the same reason
# `lib/release.notes` suppresses it for its renderers: every message below
# names a config KEY, and the delimiter this project writes a key in is the
# backtick. Single quotes are correct here precisely because the contents must
# NOT expand -- which is the thing shellcheck is warning about. Added 2026-09-07
# after `check lint` was found red at HEAD: these two lines landed with WP-01 on
# 2026-09-06 and CI could not have caught them, because CI runs on push and
# nothing had been pushed since 2026-09-03.
# shellcheck disable=SC2016
infra_validate_profile() {
  local rc=0 handle fqdn other sender seen="" warn_out=""
  # Visibility BEFORE content: a key that never reached the cache cannot be
  # validated by any rule below, and the rules below would report it as absent.
  infra_assert_written_keys_visible "$_DEVBIN_INFRA_FILE" || rc=1
  # EVERY KEY IS ONE SOMETHING READS, and a key read for a word holds one of the
  # words it takes (issue 0143).
  infra_profile_keys_known || rc=1
  # THE DKIM RECORD FORMS, FOR EVERY SENDER DEFINED, not only the ones a domain
  # names: a record nothing could ask for is malformed wherever it is written.
  for sender in $(cfg_list senders 2>/dev/null || true); do
    infra_sender_dkim_shape "$sender" || rc=1
  done
  for handle in $(cfg_list domains); do
    fqdn="$(cfg_get "domains.$handle.name" 2>/dev/null || true)"
    if [ -z "$fqdn" ]; then
      printf 'infra: domain `%s` has no `name:` field -- the FQDN is a field, not the key.\n' "$handle" >&2
      rc=1; continue
    fi
    # UNIQUENESS. The guarantee the format used to give for free. Two handles on
    # one FQDN can carry contradictory expectations that `check` would evaluate
    # against the same live records, so one goes green and one goes red on the
    # same domain and ordering decides which the operator reads. A profile that
    # cannot be self-consistent is worse than one that fails to parse.
    other="$(printf '%s' "$seen" | awk -v f="$fqdn" -F'\t' '$2==f {print $1; exit}')"
    if [ -n "$other" ]; then
      printf 'infra: `%s` is named by two handles, `%s` and `%s`. One entry per domain.\n' \
        "$fqdn" "$other" "$handle" >&2
      rc=1
    fi
    seen="$seen$handle	$fqdn
"
    infra_handle_matches_name "$handle" "$fqdn" || \
      warn_out="$warn_out  handle \`$handle\` does not look derived from \`$fqdn\`
"
    # sp= IS COMPARED ONLY WHERE A _dmarc RECORD IS READ, AND ONLY THE POLICY
    # ASSERTS ONE (issue 0143). An sp with no policy in force would be compared
    # when a record happened to exist and pass in silence when none did. A
    # domain spelled `dmarc: none` has opted out of all of it.
    if [ "$(cfg_get "domains.$handle.dmarc" 2>/dev/null || true)" != none ] &&
      infra_effective "$handle" dmarc.sp >/dev/null &&
      ! infra_effective "$handle" dmarc.policy >/dev/null; then
      printf 'infra: domain `%s` declares dmarc.sp with no dmarc.policy in force -- check asserts the _dmarc record through its policy alone, so with no record this domain would pass in silence.\n' "$handle" >&2
      rc=1
    fi
    # A NAMED SENDER IS A PROMISE THE PROFILE HAS TO KEEP.
    for sender in $(infra_domain_senders "$handle"); do
      if ! infra_sender_defined "$sender"; then
        {
          printf 'infra: domain `%s` declares sender `%s`, which this profile never defines.\n' "$handle" "$sender"
          printf '       The profile is the TARGET STATE, so a sender named and not\n'
          printf '       described is an incomplete target -- not an estate that could\n'
          printf '       not be measured. Add a `senders.%s` block carrying its\n' "$sender"
          printf '       `spf_include` and its DKIM record: `dkim.name`, or for several,\n'
          printf '       `dkim.<label>.name` under a label each. The values are\n'
          printf '       ACCOUNT-SPECIFIC, which is why devbin ships the shape and never\n'
          printf '       the contents.\n'
        } >&2
        rc=1
        continue
      fi
      infra_sender_pair_complete "$sender" || rc=1
    done
  done
  [ -n "$warn_out" ] && printf 'infra: handles worth a second look (not an error):\n%s' "$warn_out" >&2
  return $rc
}

# infra_unreviewed_keys -- the deviations `init` could not confidently propose.
# `check` REFUSES while any remain; see lib/cmd/infra for why it is refuse and
# never warn.
infra_unreviewed_keys() { cfg_list unreviewed 2>/dev/null || true; }

# --- inheritance, and it did not exist until 2026-09-07 ----------------------
#
# THE SCHEMA PROMISED THIS FROM THE FIRST DRAFT AND NOTHING IMPLEMENTED IT.
# `lib/infra.reference.yaml` says a handle carrying nothing but its `name:`
# inherits all of `defaults:`, and all three real profiles depend on it totally
# -- every domain in them inherits `mail`, `ttl` and `dmarc` and spells almost
# nothing. Measured on a two-line fixture: `defaults.ttl` read 300 and
# `domains.alpha.ttl` read empty.
#
# It cost nothing until now because NO CONSUMER READ THOSE FIELDS. `show` prints
# `name:` alone and `check` was a stub, so the gap sat behind a command that
# never asked. WP-02 is the first reader, and it reads all of them -- which is
# the general shape worth keeping: a documented behaviour with no implementation
# and no test is free exactly until something depends on it.
#
# ONE function rather than a fallback spelled at each call site, because the
# rule is a property of the schema and not of any caller. Two copies drift the
# first time inheritance gains a level.

# infra_effective <handle> <key> -- the value in force for a domain: its own if
# it has one, else the profile default. rc 1 when neither declares it.
#
# rc rather than an empty string, matching `install_prefix_configured`: a caller
# that forgets to check an rc dies at the assignment, one that forgets an empty
# check silently checks against "". Only one of those is loud.
infra_effective() {
  local handle="$1" key="$2" v
  v="$(cfg_get "domains.$handle.$key" 2>/dev/null || true)"
  [ -n "$v" ] || v="$(cfg_get "defaults.$key" 2>/dev/null || true)"
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}

# infra_domain_senders <handle> -- the sender handles a domain declares.
#
# Sequences flatten to `.0`, `.1`, so the list is the child keys of the
# sequence. Silence is the normal case: `senders: []` is never written, only
# the non-empty case.
infra_domain_senders() {
  local handle="$1" i
  for i in $(cfg_list "domains.$handle.senders" 2>/dev/null || true); do
    cfg_get "domains.$handle.senders.$i" 2>/dev/null || true
  done
}

# infra_manual_keys <handle> -- every `manual:` entry in force for a domain,
# as `<key><TAB><text>`, defaults first and the domain's own overriding by name.
#
# THESE ARE NEVER CHECKED AND ALWAYS NAMED. A `manual:` entry records what
# SHOULD be true and can never detect that it stopped being true, so it lives in
# its own namespace precisely so that nothing in the file blurs "check validates
# this" with "check merely mentions it". Naming every one of them on every run
# is what stops an operator reading the block as a record of verification.
infra_manual_keys() {
  local handle="$1" k seen="" v
  for k in $(cfg_list "domains.$handle.manual" 2>/dev/null || true); do
    v="$(cfg_get "domains.$handle.manual.$k" 2>/dev/null || true)"
    printf '%s\t%s\n' "$k" "$v"
    seen="$seen $k "
  done
  for k in $(cfg_list defaults.manual 2>/dev/null || true); do
    case "$seen" in *" $k "*) continue ;; esac
    v="$(cfg_get "defaults.manual.$k" 2>/dev/null || true)"
    printf '%s\t%s\n' "$k" "$v"
  done
}

# infra_sender_defined <name> -- does the profile define this sender?
#
# A domain naming a sender nothing defines is a profile the PAIR INVARIANT
# cannot be evaluated against: without the selector there is no DKIM name to
# look up, so the half-pair check -- the one that finds a domain whose own
# legitimate mail is indistinguishable from a forgery of it -- silently covers
# nothing. Reported by `check` as an unmeasurable rather than passed over.
infra_sender_defined() {
  local name="$1"
  cfg_list senders 2>/dev/null | grep -qxF "$name"
}

# --- the profile's keys (issue 0143) -------------------------------------------
#
# THE ONE STATEMENT OF THE KEYS A PROFILE MAY CARRY, and of the words a key read
# for a word will take. infra_profile_keys_known refuses a cache row matching no
# row here, before anything is checked, and the shipped reference carries a live
# example of every row but `unreviewed.<key>` (tests/unit/infra-profile.bats
# holds it to that). A key added to the schema is added HERE, or it is refused.
#
#   <scope>     `defaults` and `domains.<handle>` both, which is what
#               inheritance means: infra_effective reads the one, then the other
#   <n>         an index, as lib/config flattens a sequence item
#   <anything>  one key the author chose: a handle, a sender, a label
#
# The second column, where there is one, lists the only values the key takes,
# `|`-separated. A key read only against one word was otherwise the same trap
# one level down: `dmarc: quarantine` under a domain parsed, validated, and was
# ignored, because only `none` was ever compared.
#
# TWO ROWS ARE DOCUMENTED AND READ BY NOTHING, and they are legal on purpose:
# `version`, which nothing reads yet, and the Fly `runtime` block, which every
# check run names as not examined. Refusing them would refuse the reference.
_INFRA_PROFILE_KEYS="
version
name
<scope>.mail
<scope>.ttl
<scope>.dmarc.policy                  none|quarantine|reject
<scope>.dmarc.rua
<scope>.dmarc.sp                      none|quarantine|reject
<scope>.manual.<key>
<scope>.wildcard.a
<scope>.wildcard.aaaa
<scope>.wildcard.txt
domains.<handle>.name
domains.<handle>.dmarc                none
domains.<handle>.senders.<n>
senders.<sender>.spf_include
senders.<sender>.dkim.name
senders.<sender>.dkim.type
senders.<sender>.dkim.value
senders.<sender>.dkim.<label>.name
senders.<sender>.dkim.<label>.type
senders.<sender>.dkim.<label>.value
runtime.fly.<app>.org
runtime.fly.<app>.hostnames.<n>
unreviewed.<key>
"

# infra_profile_key_patterns -- the table's key patterns, one per line.
infra_profile_key_patterns() {
  local pat _
  while read -r pat _; do
    [ -n "$pat" ] && printf '%s\n' "$pat"
  done <<<"$_INFRA_PROFILE_KEYS"
  return 0
}

# infra_key_matches <pattern> <path> -- rc 0 when the dotted <path> is an
# instance of the table's <pattern>. Pure.
#
# SEGMENT BY SEGMENT, and deliberately not one case glob per row: a `*` in a
# case pattern spans dots, so `domains.*.name` would also match a key nested
# any depth below a domain (lib/config's schema learned that at
# _cfg_path_known).
infra_key_matches() {
  local pat="$1" path="$2" i
  local -a a b
  case "$pat" in
    '<scope>.'*)
      infra_key_matches "defaults.${pat#<scope>.}" "$path" && return 0
      infra_key_matches "domains.<handle>.${pat#<scope>.}" "$path"
      return
      ;;
  esac
  case "$path" in '' | *..* | .* | *.) return 1 ;; esac
  IFS=. read -ra a <<<"$pat"
  IFS=. read -ra b <<<"$path"
  [ "${#a[@]}" -eq "${#b[@]}" ] || return 1
  for ((i = 0; i < ${#a[@]}; i++)); do
    case "${a[i]}" in
      '<n>') [[ "${b[i]}" =~ ^[0-9]+$ ]] || return 1 ;;
      '<'*'>') ;;
      *) [ "${a[i]}" = "${b[i]}" ] || return 1 ;;
    esac
  done
}

# _infra_unknown_key <path> -- the refusal for a key the table has no row for.
#
# TWO REASONS, AND THE ONE PRINTED IS THE TRUE ONE. A name the profile uses
# nowhere is a key it has no field for. A name it DOES use, written in the wrong
# place or shape -- `dmarc: none` under `defaults:`, `senders:` as one word --
# is a field nothing reads THERE, and saying "no such field" would send the
# reader looking for a typo that is not there.
# shellcheck disable=SC2016
_infra_unknown_key() {
  local k="$1" f="$1" pat _
  # The field's name is the last segment that is not an index.
  while [[ "${f##*.}" =~ ^[0-9]+$ ]] && [ "$f" != "${f%.*}" ]; do f="${f%.*}"; done
  f="${f##*.}"
  while read -r pat _; do
    case ".$pat." in
      *".$f."*)
        printf 'infra: %s: unknown key: %s -- the profile has a `%s` field, but nothing reads it here\n' \
          "${_DEVBIN_INFRA_FILE:-profile}" "$k" "$f" >&2
        return 0
        ;;
    esac
  done <<<"$_INFRA_PROFILE_KEYS"
  printf 'infra: %s: unknown key: %s -- the profile has no such field, so nothing would read it\n' \
    "${_DEVBIN_INFRA_FILE:-profile}" "$k" >&2
}

# infra_profile_keys_known -- every cache row is a key the table has a row for,
# holding a value that row takes. Each one that is not is named, with the file;
# rc 1 when any was.
#
# ONE PASS OVER THE CACHE, no fork per row. A row is tried only against table
# rows starting with its own first segment, which keeps the pass to a few tens
# of milliseconds on the largest profile in the fleet (90 rows).
infra_profile_keys_known() {
  local k v pat vals first found w ok rc=0
  local -a allowed
  while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    first="${k%%.*}"
    found=""
    while read -r pat vals; do
      [ -n "$pat" ] || continue
      case "$pat" in
        '<scope>.'*) case "$first" in defaults | domains) ;; *) continue ;; esac ;;
        *) [ "${pat%%.*}" = "$first" ] || continue ;;
      esac
      if infra_key_matches "$pat" "$k"; then
        found=1
        break
      fi
    done <<<"$_INFRA_PROFILE_KEYS"
    if [ -z "$found" ]; then
      _infra_unknown_key "$k"
      rc=1
      continue
    fi
    # ONE ADDRESS, not a list in a string (issue 0143, vc's ruling). A wildcard
    # A or AAAA is compared as the whole set, so `a: "192.0.2.7 192.0.2.8"`
    # could never hold, and its drift line would print the two sides alike.
    case "$pat:$v" in
      *.wildcard.a:*[[:space:]]* | *.wildcard.aaaa:*[[:space:]]*)
        # shellcheck disable=SC2016
        printf 'infra: %s: %s: "%s" is more than one value -- a wildcard %s is ONE address or `none`\n' \
          "${_DEVBIN_INFRA_FILE:-profile}" "$k" "$v" "${pat##*.}" >&2
        rc=1
        continue
        ;;
    esac
    [ -n "$vals" ] || continue
    ok=""
    IFS='|' read -ra allowed <<<"$vals"
    for w in "${allowed[@]}"; do
      [ "$w" = "$v" ] && ok=1
    done
    if [ -z "$ok" ]; then
      printf 'infra: %s: %s: "%s" is not a value it takes (%s)\n' \
        "${_DEVBIN_INFRA_FILE:-profile}" "$k" "$v" "${vals//|/, }" >&2
      rc=1
    fi
  done <<<"$_DEVBIN_CFG"
  return $rc
}

# --- a sender's DKIM records (issue 0143) ------------------------------------
#
# A sender declares ONE record, its fields directly under `dkim:` exactly as
# before 0143, or SEVERAL, each under a label the author chooses:
#
#   dkim:                          dkim:
#     name: mlsend2._domainkey       ms1:
#     type: CNAME                      name: ms1._domainkey
#                                    ms2:
#                                      name: ms2._domainkey
#
# lib/config refuses a sequence of maps, and it did not need to learn one: a
# label names its record in every message, and a reader of labels would read
# the `dkim.0`, `dkim.1` a sequence flattens to, should the grammar ever grow it.

# infra_sender_dkim_records <sender> -- one PREFIX per DKIM record the sender
# declares, under `senders.<sender>.`, in document order: `dkim` for the
# one-record form, `dkim.<label>` for each labelled record. Nothing when the
# sender declares none. THE one reader of the two spellings.
#
# THE FORMS ARE TOLD APART BY WHETHER `dkim` CARRIES A VALUE DIRECTLY, a test
# _infra_dkim_children makes once for both this and infra_sender_dkim_shape.
# Any key under it with a value of its own makes it the one-record form;
# otherwise each key under it is a label. infra_sender_dkim_shape refuses a
# sender writing both.
#
# PREFIXES, NOT TAB ROWS. A TAB is IFS whitespace and `read` collapses an empty
# field -- the trap lib/infra.init's _ii_get records -- so a record missing its
# name would shift every field after it. A key holds no space, so a list of
# prefixes word-splits safely, and each field is read with cfg_get.
infra_sender_dkim_records() {
  local kind c labels=""
  while read -r kind c; do
    case "$kind" in
      field)
        printf 'dkim\n'
        return 0
        ;;
      label) labels="$labels dkim.$c" ;;
    esac
  done <<<"$(_infra_dkim_children "$1")"
  for c in $labels; do printf '%s\n' "$c"; done
  return 0
}

# _infra_dkim_children <sender> -- each key under `senders.<sender>.dkim`, one
# per line as `field <key>` when it carries a value of its own and `label
# <key>` when it does not. THE test that tells the two spellings apart, read by
# infra_sender_dkim_records and infra_sender_dkim_shape alike, so the reader and
# the rules cannot classify one layout two ways.
_infra_dkim_children() {
  local base="senders.$1.dkim" c
  for c in $(cfg_list "$base" 2>/dev/null || true); do
    if cfg_has "$base.$c"; then printf 'field %s\n' "$c"; else printf 'label %s\n' "$c"; fi
  done
  return 0
}

# infra_sender_dkim_shape <sender> -- the rules the two spellings need, for any
# sender, whether or not a domain names it:
#
#   - never both forms at once, which would leave the reader to choose
#   - a label is never a field's name, which a reader would take for the field
#   - one record per selector, since two would be two expectations of one name
#   - every record has a name, since a record with none cannot be asked for
# shellcheck disable=SC2016
infra_sender_dkim_shape() {
  local s="$1" kind c fields="" labels="" p n names=" " unnamed="" rc=0
  while read -r kind c; do
    case "$kind" in
      field) fields="$fields dkim.$c" ;;
      label) labels="$labels dkim.$c" ;;
    esac
  done <<<"$(_infra_dkim_children "$s")"
  if [ -n "$fields" ] && [ -n "$labels" ]; then
    printf 'infra: sender `%s` mixes the one-record form (%s) with labelled records (%s) -- write every record under a label.\n' \
      "$s" "$(printf '%s' "${fields# }" | sed 's/ /, /g')" "$(printf '%s' "${labels# }" | sed 's/ /, /g')" >&2
    return 1
  fi
  for p in $labels; do
    case "${p#dkim.}" in
      name | type | value)
        printf 'infra: sender `%s` has a DKIM record labelled `%s`, which is the name of a field -- choose another label.\n' \
          "$s" "${p#dkim.}" >&2
        rc=1
        ;;
    esac
  done
  for p in $(infra_sender_dkim_records "$s"); do
    n="$(cfg_get "senders.$s.$p.name" 2>/dev/null || true)"
    if [ -z "$n" ]; then
      unnamed="$unnamed $p.name"
      continue
    fi
    case "$names" in
      *" $n "*)
        printf 'infra: sender `%s` declares the selector `%s` twice. One record per selector.\n' "$s" "$n" >&2
        rc=1
        ;;
    esac
    names="$names$n "
  done
  if [ -n "$unnamed" ]; then
    printf 'infra: sender `%s` declares a DKIM record with no name, so nothing can ask for it:%s\n' "$s" "$unnamed" >&2
    rc=1
  fi
  return $rc
}
