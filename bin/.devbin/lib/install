#!/usr/bin/env bash
#
# lib/install -- vendoring, the checksum manifest, and what devbin owns.
#
# Sourced, not executed. Depends on lib/helpers ALONE, which is deliberate: the
# three commands built on it (`install`, `upgrade`, `doctor`) each operate on a
# project that is not necessarily the one whose config is loaded, so a function
# here reads no config for the tree it is handed. Everything it needs about a
# tree is passed in or read off that tree. The one `cfg_get` here,
# `install_prefix_configured`, reads devbin's OWN config, which its caller has
# loaded, for the publish prefix -- never a target's.
#
# THE SEAM, which is the whole of design D5 in one sentence: everything under
# `bin/.devbin/lib/` plus `bin/devbin` is DEVBIN's and is replaced wholesale;
# everything else under `bin/.devbin/` -- `config.yaml`, `cmd/`, `help/` -- is
# the PROJECT's and is never written by any function in this file. One rule,
# stated once, and `vendored_paths` is the only thing that enumerates the first
# half. An upgrade that overwrote an authored help topic would be a data loss
# bug in a tool whose entire job is to be safe to re-run.
#
[ -n "${_DEVBIN_INSTALL_LOADED:-}" ] && return 0
_DEVBIN_INSTALL_LOADED=1

# The manifest, relative to a project root. Devbin's file, but NOT under lib/:
# it has to survive the wholesale replacement of the directory it describes.
# DEVBIN_MANIFEST_REL moved to lib/helpers beside the readers that use it.

# devbin_lib_dir <root> -- where <root> keeps a devbin runtime, or return 1.
#
# The same two-place test the dispatcher makes on itself: the vendored copy
# first, the checkout's own lib/ as the fallback that lets Devbin run itself
# (D12). The dispatcher has its own inline copy because it runs BEFORE any
# library is sourced -- it is the code that finds this file -- which is a real
# bootstrap exception rather than a licence to have two of these. Everything
# else asks here.
devbin_lib_dir() {
  local root="$1"
  if [ -d "$root/bin/.devbin/lib" ]; then
    printf '%s\n' "$root/bin/.devbin/lib"
    return 0
  fi
  if [ -d "$root/lib" ]; then
    printf '%s\n' "$root/lib"
    return 0
  fi
  return 1
}

# is_devbin_source <root> -- true when <root> can be vendored FROM.
#
# The dispatcher and lib/helpers, because those are the two files whose absence
# makes every other check meaningless. Checked before upgrade writes anything
# (AC-09.9): a half-replaced runtime leaves a project that cannot run at all,
# which is strictly worse than the stale one it was replacing.
is_devbin_source() {
  local root="$1" lib
  [ -f "$root/bin/devbin" ] || return 1
  lib="$(devbin_lib_dir "$root")" || return 1
  [ -f "$lib/helpers" ] || return 1
  return 0
}

# is_devbin_installed <root> -- true when <root> carries a VENDORED runtime.
#
# Deliberately not `devbin_lib_dir` succeeding: a devbin CHECKOUT answers that
# too, via the D12 fallback, and calling the source tree "installed" would have
# `upgrade` try to re-vendor Devbin into itself.
is_devbin_installed() {
  [ -d "$1/bin/.devbin/lib" ]
}


# --- the local install (ST0005) ----------------------------------------------
#
# devbin publishes itself to a local install tree, and consumers vendor FROM
# that rather than from the development checkout it is edited in. The reason is
# measured rather than theoretical: on 2026-09-06 five of thirteen estates were
# running bytes stamped `+dirty -- THESE BYTES MATCH NO COMMIT`, and two vendors
# taken ten minutes apart from the same dirty tree carried BYTE-IDENTICAL
# `source_commit` lines over three differing files. The stamp cannot tell two
# dirty vendors apart. See intent/st/ST0005/design.md.
#
# THE INSTALL TREE IS CONSUMER-SHAPED, WHICH IS WHY THIS SECTION IS SHORT (D33).
# `<prefix>/bin/devbin` + `<prefix>/bin/.devbin/lib/` + the ordinary manifest, so
# `is_devbin_source`, `vendored_paths`, `copy_vendored`, `manifest_write` and
# `upgrade --from` all apply UNCHANGED. What makes it an install rather than a
# project is the ABSENCE of the project half -- no config.yaml, no cmd/, no
# help/ -- and `bin/devbin` refuses to run without a config.yaml, so D27's "never
# a cwd" is delivered by construction rather than by a check anyone can disable.

# is_devbin_dev_tree <root> -- true when <root> is devbin's own SOURCE checkout.
#
# Derived from the two predicates that already exist rather than from a name or
# a path: a tree that can be vendored FROM but carries no VENDORED runtime of
# its own is a source checkout, because a consumer always has `bin/.devbin/lib`.
# The install tree has one too, so it reads as a consumer here -- which is
# correct and is the point of D33.
is_devbin_dev_tree() {
  is_devbin_source "$1" || return 1
  ! is_devbin_installed "$1"
}

# install_prefix_configured -- the prefix from config, tilde expanded, or rc 1
# having printed nothing.
#
# THERE IS NO DEFAULT, AND THE ONE THAT USED TO BE HERE IS WHY THIS NOTE IS LONG.
# This function ended `[ -n "$v" ] || v="$HOME/Devel/opt/devbin"` -- one
# operator's directory layout, written into the runtime that fourteen estates
# vendor. Every consumer carried it; a publish from any of them would have gone
# to a path named after somebody else's home directory, and it would have
# SUCCEEDED, because a publish to the wrong place is indistinguishable from a
# publish to the right one.
#
# D32 already said the location is CONFIGURATION. A default does not soften that
# rule, it relocates the decision: from a key somebody wrote to the absence of
# one, which is the reading nobody makes deliberately. So unset returns 1 and
# every caller that needs a prefix refuses by name -- see
# `die_install_prefix_unset`, which is the one message all three of them print.
#
# rc 1 RATHER THAN AN EMPTY STRING. A caller that forgets to check an empty
# return proceeds with `""` and writes to `/bin`; a caller that forgets to check
# rc 1 is killed by errexit at the assignment. Neither is correct, but only one
# of them is silent. `shell-init` is the one caller for which unset is a legal
# answer, and it says so at the call site.
#
# THE TILDE IS EXPANDED HERE AND THAT IS NOT A NICETY. A config value is a
# literal string, so an unexpanded `~/opt/devbin` creates a directory actually
# named `~` under the cwd, and every subsequent command finds an install exactly
# where it looked. The failure is silent and self-consistent, which is the worst
# combination this project has a name for.
#
# Through `home_expand` in lib/helpers, the one definition of the `~` form
# (issue 0069). The copy that used to sit here turned `~/opt/devbin` into
# `/opt/devbin` under an empty HOME -- a real directory a publish would write to.
install_prefix_configured() {
  local v
  v="$(cfg_get install.prefix "")"
  [ -n "$v" ] || return 1
  home_expand "$v"
  return 0
}

# die_install_prefix_unset [flag] -- the ONE refusal for a prefix that is not
# configured. Never returns.
#
# ONE MESSAGE FOR THREE CALLERS. `install` publishes to the prefix, `upgrade`
# replaces what is there, and the fleet sweep distributes FROM it -- three verbs
# reading the same key out of the same file and failing for the same reason.
# Three spellings of the fix-it instruction is three things to keep in step, and
# the one that drifts is the one nobody was reading (IN-AG-HIGHLANDER-001).
#
# CALLED AT STATEMENT LEVEL, NEVER INSIDE A COMMAND SUBSTITUTION at a caller
# that has not set `inherit_errexit`. `die` exits, so the message is printed
# either way -- but `local x="$(...)"` takes its rc from `local` and swallows
# the failure while still showing the text, which is issue 0060 and is how a
# refusal comes to read as a refusal and behave as a default.
#
# The flag is a PARAMETER because `--prefix` belongs to install and upgrade and
# the fleet sweep has no such option. Naming a flag that does not exist is worse
# than naming none.
die_install_prefix_unset() {
  local flag="${1:-}" extra=""
  # An `if`, not `[ -n "$flag" ] && extra=...`: that AND-list is the final
  # command of its own statement, so an empty flag would return 1 and take the
  # whole handler down under `set -e` before the message was ever composed.
  if [ -n "$flag" ]; then
    extra="
       or pass $flag for a single run"
  fi
  die "no install prefix is configured, and there is no default
       set install.prefix in devbin's own bin/.devbin/config.yaml:

         install:
           prefix: ~/where/devbin/should/live$extra"
}

# tree_dirty_paths <root> -- porcelain lines for an unclean tree, empty when clean.
#
# WHOLE TREE, not just the vendored set (D28). The manifest's claim is "these
# bytes are commit X", and that claim is only true when NOTHING in the tree is
# uncommitted -- a dirty `.md` beside a clean `lib/` still means the recorded
# commit does not describe the checkout the bytes came out of.
#
# A tree that is not a git repository at all returns non-zero rather than empty:
# "no changes" and "cannot tell" must not render as the same answer. So does a
# status git could not produce.
#
# AND DEVBIN'S HALF IS ASKED THE HARDENED QUESTION TOO (issue 0056). A plain
# status lists no ignored file and reads no assume-unchanged mark, and those
# are bytes that ship: an ignored `lib/.DS_Store` passed this gate and the
# stamp, which asks seam_state_of, recorded `+dirty` on the install it let
# through. The plain status still covers the rest of the tree; one extra line
# names the seam's state whenever it is anything but committed, and the gate
# refuses on it like any other.
tree_dirty_paths() {
  local root="$1" out state
  git_readonly -C "$root" rev-parse --git-dir >/dev/null 2>&1 || return 2
  out="$(git_readonly -C "$root" status --porcelain 2>/dev/null)" || return 2
  state="$(seam_state_of "$root")"
  if [ "$state" != committed ]; then
    out="${out:+$out
}seam: $state -- devbin's half is not exactly the committed bytes (an ignored file, a symlink, or a file git was told not to watch)"
  fi
  printf '%s' "$out"
  return 0
}

# fleet_preview_hint -- the one fleet command publish and publish-upgrade both
# print, to preview a sweep of the estate they have just put behind.
#
# Both printed `bin/devbin fleet upgrade --dry-run` until issue 0073, and fleet has
# no such flag: its dry run is the DEFAULT, and the strict parser refuses the
# line as written. One home keeps the two sites from differing; what catches a
# WRONG command is the test, which runs the printed line through the real parser.
fleet_preview_hint() {
  printf 'bin/devbin fleet upgrade'
}

# publish_install <srcroot> <dstroot> <version> -- write an install tree.
#
# ONE COPY, called by BOTH `install` (publishing a new one) and `upgrade`
# (replacing an existing one). Those two differ only in their PRECONDITION --
# must not exist / must exist -- and never in what they write, so a second copy
# of the write would be two answers to one question waiting to disagree
# (IN-AG-HIGHLANDER-001).
#
# Deliberately NOT `upgrade`'s per-file state machine. That machinery exists to
# protect local edits in a project, and an install has no project half and no
# author -- so preserving an edit here would preserve damage. The caller reports
# any modified file BEFORE calling this; what happens after is a full replace.
#
# Echoes the file count on stdout so the caller renders its own line: a function
# that both writes files and formats a report is two jobs (IN-AG-THIN-COORD-001).
publish_install() {
  local srcroot="$1" dstroot="$2" version="$3" rel src count=0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    src="$(vendor_source_path "$srcroot" "$rel")" || return 1
    copy_vendored "$src" "$dstroot/$rel" || return 1
    count=$((count + 1))
  done <<EOF
$(vendored_paths "$srcroot")
EOF
  manifest_write "$dstroot" "$srcroot" "$version" "" install || return 1
  printf '%s\n' "$count"
  return 0
}

# vendored_paths <srcroot> -- every file devbin owns, as paths RELATIVE to a
# project root, sorted. This is the file list, and the only one.
#
# `bin/devbin` plus one line per file under the source's lib/. Sorted so the
# manifest is stable across machines -- `find` returns directory order, which
# differs between filesystems, and an unstable manifest makes every upgrade
# report look like a change.
vendored_paths() {
  local srcroot="$1" lib f
  lib="$(devbin_lib_dir "$srcroot")" || return 1
  printf 'bin/devbin\n'
  find "$lib" -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
    printf 'bin/.devbin/lib/%s\n' "${f#"$lib"/}"
  done
  return 0
}

# vendored_dir_files <root> -- every file actually sitting under <root>'s
# VENDORED lib, as project-relative paths, sorted.
#
# The target-side twin of vendored_paths, and deliberately a separate function
# rather than a parameter on that one: vendored_paths asks a SOURCE what it
# ships, where the runtime is at `lib/` or `bin/.devbin/lib/` depending on D12;
# this asks an INSTALL what is on disk, where the answer is always
# `bin/.devbin/lib/`. One is a statement of intent and the other an inventory --
# comparing them is the entire point, so collapsing them would erase the
# difference being measured.
vendored_dir_files() {
  local lib="$1/bin/.devbin/lib" f
  [ -d "$lib" ] || return 0
  find "$lib" -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
    printf 'bin/.devbin/lib/%s\n' "${f#"$lib"/}"
  done
  return 0
}

# vendor_source_path <srcroot> <relpath> -- where <relpath> lives in the SOURCE.
#
# The inverse of the mapping vendored_paths applies. It is not the identity: a
# source checkout keeps its runtime at `lib/`, an installed project at
# `bin/.devbin/lib/`, and both are legal sources.
vendor_source_path() {
  local srcroot="$1" rel="$2" lib
  case "$rel" in
    bin/devbin)
      printf '%s\n' "$srcroot/bin/devbin"
      return 0
      ;;
    bin/.devbin/lib/*)
      lib="$(devbin_lib_dir "$srcroot")" || return 1
      printf '%s\n' "$lib/${rel#bin/.devbin/lib/}"
      return 0
      ;;
  esac
  return 1
}

# vendored_scope <srcroot> -- devbin's half as git PATHSPECS into the source,
# one per line. The scope, not the roll-call.
#
# The third member of the vendored_paths / vendored_dir_files family, and a
# separate function for the same reason those two are separate: it answers a
# different question. `vendored_paths` asks WHICH FILES ship, `vendored_dir_files`
# asks what is ON DISK, and this asks WHERE devbin's half lives -- which is the
# only shape a git pathspec can take.
#
# IT IS DELIBERATELY NOT BUILT ON vendored_paths, and that is the whole point.
# That function enumerates with `find`, so a vendored file DELETED but not yet
# committed simply stops being listed, and a `git status` limited to the names
# that survive reports nothing at all. Measured on a fixture with `lib/beta`
# removed: the file-list pathspec answers CLEAN while a vendored file is
# missing; the directory pathspec answers ` D lib/beta`. Under-reporting clean
# is the one direction this subsystem must never go, and a directory is read
# against HEAD where a name list is read against disk.
vendored_scope() {
  local srcroot="$1" lib
  lib="$(devbin_lib_dir "$srcroot")" || return 1
  printf '%s\n' "$srcroot/bin/devbin"
  printf '%s\n' "$lib"
  return 0
}

# copy_vendored <src> <dst> -- copy one file, creating its directory, and carry
# the executable bit across.
#
# The bit is copied per file rather than by re-deriving which paths ought to be
# executable. `cp` gives a new file the source's mode on both platforms, but
# relying on that leaves a silent failure -- a `lib/cmd/test` that arrives
# non-executable resolves and then does not run -- resting on a detail of cp.
# Three forks per file became one. `$(dirname)` is an external command and
# `mkdir -p` runs whether or not the directory is there, so a 26-file vendor
# spent 78 processes to make three directories and set two exec bits -- and the
# test suite installs a fixture per test. `${dst%/*}` and `[ -d ]` are builtins;
# the chmods now fire only when the mode is actually wrong, which on both
# platforms means almost never, since cp gives a new file the source's mode.
# REPLACING an existing file goes through a temporary and a rename, so a reader
# sees the old file or the new one and never a half-written one. `sed_inplace`
# in lib/helpers does this already and for the same reason; upgrade rewriting
# the dispatcher and every library under a project someone may be running is the
# case that matters most.
#
# Only the replace path pays for it. A file that does not exist yet cannot be
# read mid-write, so a fresh install keeps the single-fork copy the vendoring
# loop was tuned for -- and a fresh install is what the test suite does per
# fixture.
copy_vendored() {
  local src="$1" dst="$2" dir="${2%/*}" tmp
  [ -d "$dir" ] || mkdir -p "$dir" || return 1

  if [ ! -e "$dst" ]; then
    cp "$src" "$dst" || return 1
    if [ -x "$src" ]; then
      [ -x "$dst" ] || chmod +x "$dst"
    elif [ -x "$dst" ]; then
      chmod -x "$dst"
    fi
    return 0
  fi

  # `$$` is the shell's PID and a subshell inherits it (lib/runlog says why that
  # makes it useless for uniqueness ACROSS processes). Here it only has to be
  # unique within one install, beside a destination no other path writes.
  tmp="$dst.devbin-new.$$"
  cp "$src" "$tmp" || {
    rm -f "$tmp"
    return 1
  }
  if [ -x "$src" ]; then
    [ -x "$tmp" ] || chmod +x "$tmp"
  elif [ -x "$tmp" ]; then
    chmod -x "$tmp"
  fi
  mv -f "$tmp" "$dst" || {
    rm -f "$tmp"
    return 1
  }
  return 0
}

# --- the manifest ------------------------------------------------------------
#
# `<sha256>  <path>` lines in the conventional shasum spelling, under a `#`
# header carrying the facts the file itself cannot supply: which devbin wrote
# it, where that devbin was, and WHICH COMMIT OF IT. The first two are read back
# -- the version by doctor, the source by upgrade, which is what lets `devbin
# upgrade` be typed with no arguments from inside the installed project.

# The manifest readers live in lib/helpers -- see the note there. lib/install
# remains their only heavy caller; the dispatcher needs two header lines.

# seam_git_verdict <status-porcelain> <ls-files-v> -- the state those two outputs
# describe: committed, DIRTY, not watched or not tracked. Pure, so every line
# shape is tested on strings rather than on a repository built to produce it.
#
# THE ORDER IS THE STRONGEST THING GIT CAN SAY FIRST. A changed, added, deleted
# or untracked path is a fact about the bytes: DIRTY. A path marked
# assume-unchanged (a lowercase tag) or skip-worktree (`S`) is one git was told
# not to read, so its silence certifies nothing: not watched. An ignored path
# (`!!`) is runtime bytes a clone does not get: not tracked. Only when none of
# the three appears is it committed. DIRTY was once checked LAST, so one ignored
# `.DS_Store` beside a real edit hid the edit (critic-shell, 2026-09-16).
#
# EVERY LINE IS READ, NOT ONLY THE FIRST. A test built with one offending file
# puts it first by construction; the arms carry it on a later line as well.
seam_git_verdict() {
  local status="$1" tags="$2" line dirty="" ignored="" blind=""
  while IFS= read -r line; do
    case "$line" in
      '') ;;
      '!! '*) ignored=yes ;;
      *) dirty=yes ;;
    esac
  done <<LINES
$status
LINES
  while IFS= read -r line; do
    case "$line" in
      [a-z]' '* | 'S '*) blind=yes ;;
    esac
  done <<LINES
$tags
LINES
  if [ -n "$dirty" ]; then
    printf 'DIRTY\n'
  elif [ -n "$blind" ]; then
    printf 'not watched\n'
  elif [ -n "$ignored" ]; then
    printf 'not tracked\n'
  else
    printf 'committed\n'
  fi
}

# seam_git_state <repo> <path>... -- is devbin's half, at these paths (absolute,
# or relative to <repo>), committed in <repo>? One of committed, DIRTY, not watched, not tracked, UNREADABLE.
#
# THE ONE ANSWER TO THAT QUESTION (issue 0056). `install` stamps a vendor's
# provenance with it (source_commit_of) and `fleet` reports each estate with it.
# They were two implementations, and they already disagreed: the census had been
# hardened and the stamp had not, so `install` could record a clean sha over
# bytes the census called DIRTY.
#
# AN EMPTY `git status` MEANS COMMITTED ONLY WHEN GIT WAS LOOKING, so:
#   - untracked files are listed whatever the repository says
#     (`--untracked-files=all`), and ignored ones too (`--ignored=matching`);
#   - a submodule's own `ignore` setting is overridden (`--ignore-submodules=none`);
#   - assume-unchanged and skip-worktree marks are read (`ls-files -v`);
#   - a SYMLINK anywhere in the paths is not tracked, because git records the
#     link's text and never the bytes behind it, which are what a digest reads
#     and what runs;
#   - a path that does not exist is UNREADABLE: the caller named the half, and a
#     half that is not there cannot be committed.
#
# The paths are DIRECTORY pathspecs where they are directories, so a vendored
# file deleted and not committed still shows (see vendored_scope).
seam_git_state() {
  local repo="$1" p links out tags
  shift
  [ "$#" -gt 0 ] || { printf 'UNREADABLE\n'; return 0; }
  for p in "$@"; do
    # A relative path is a pathspec from <repo>, which is where git reads it.
    case "$p" in /*) ;; *) p="$repo/$p" ;; esac
    if [ -L "$p" ]; then
      printf 'not tracked\n'
      return 0
    fi
    [ -e "$p" ] || { printf 'UNREADABLE\n'; return 0; }
    if [ -d "$p" ]; then
      links="$(find "$p" -type l -print 2>/dev/null)" || { printf 'UNREADABLE\n'; return 0; }
      [ -z "$links" ] || { printf 'not tracked\n'; return 0; }
    fi
  done
  out="$(git_readonly -C "$repo" status --porcelain --untracked-files=all \
    --ignored=matching --ignore-submodules=none -- "$@" 2>/dev/null)" ||
    { printf 'UNREADABLE\n'; return 0; }
  tags="$(git_readonly -C "$repo" ls-files -v -- "$@" 2>/dev/null)" ||
    { printf 'UNREADABLE\n'; return 0; }
  seam_git_verdict "$out" "$tags"
}

# seam_state_of <srcroot> -- seam_git_state over devbin's half of a SOURCE, as
# vendored_scope locates it: the whole tree when the half cannot be located.
#
# THE ONE QUESTION BEHIND BOTH THE PUBLISH GATE AND THE STAMP (issue 0056). The
# stamp was hardened and the gate was not, so a checkout holding an ignored
# `lib/.DS_Store` passed the gate and was stamped `+dirty` -- an install D28
# exists to refuse, published at exit 0 (vc, 2026-09-16). Asked through one
# function, the gate and the stamp cannot disagree.
seam_state_of() {
  local root="$1" scope_lines p
  local -a scope=()
  # vendored_scope is read into a variable and checked, not through a process
  # substitution, whose failure nothing would see.
  if scope_lines="$(vendored_scope "$root")"; then
    while IFS= read -r p; do
      [ -n "$p" ] && scope+=("$p")
    done <<SCOPE
$scope_lines
SCOPE
  fi
  [ "${#scope[@]}" -gt 0 ] || scope=("$root")
  seam_git_state "$root" "${scope[@]}"
}

# source_commit_of <srcroot> -- WHICH devbin these bytes came from, as a line.
#
# PUBLIC, and named that way because a second file depends on it. `manifest_write`
# stamps it and `lib/cmd/vendor` prints it, and an underscore on a function
# reaching across a file boundary is a false signal about its contract -- the
# same reason the three tab-lookups above became one named pair.
#
# `devbin_version` is a semver that moves once a release, so it cannot separate
# two installs from the same release, and a consumer comparing its vendored tree
# to this manifest is otherwise doing a purely internal check: a re-vendor
# rewrites the files AND this header together, so it is indistinguishable from a
# local patch with the manifest regenerated. Measured, not imagined -- a consumer
# reported its tree "stock, 27 of 27" over an uncommitted re-vendor eleven
# minutes old, and every check involved was correct. Nothing was asking what the
# tree corresponds to OUTSIDE itself.
#
# DIRTY IS RECORDED RATHER THAN HIDDEN, because a sha read from a dirty source
# describes bytes no commit has, and the bare sha would be a confident false
# statement. Not a checkout at all says so in words: an ABSENT field is what an
# older devbin wrote, and absent must never be readable as clean.
#
# DIRTY IS ASKED OF DEVBIN'S HALF, NOT OF THE TREE (issue 0033). The question
# this field answers is what the VENDORED bytes correspond to, and a file
# outside the seam cannot change that answer. A tree-wide `git status` made the
# stamp true about the tree and false about the bytes: one open whiteboard board
# in the source stamped eleven consuming estates THESE BYTES MATCH NO COMMIT
# over a surface that matched HEAD exactly. It erred safe, which is why it
# survived -- but in a project with a live whiteboard some node is always
# mid-edit, so the accurate stamp was close to unreachable and a warning that
# never clears stops being read. Narrowed, it still errs safe: `vendored_scope`
# is a DIRECTORY pathspec precisely so a deleted vendored file is still seen.
#
# WHEN THE HALF CANNOT BE LOCATED the tree-wide question is asked instead,
# rather than a narrower one being invented. A root with no `lib/` and no
# `bin/.devbin/lib/` is not a devbin source this can clear, and absent must
# never be readable as clean.
# PROVENANCE IS TRANSITIVE, AND WITHOUT THIS IT IS LOST IN TRANSIT (ST0005).
#
# An INSTALL tree is not a git checkout, so vendoring from one used to stamp the
# consumer `not a git checkout -- these bytes name no commit` -- while the
# install's OWN manifest recorded the exact sha it was cut from, one file away.
# Every estate would have recorded LESS provenance than before the install tree
# existed, which is the precise opposite of what this thread is for.
#
# MEASURED, not anticipated: the first consumer upgraded from the first install
# recorded `names no commit` against an install stamped `1e13a9cc...`.
#
# The install's stamp is FORWARDED VERBATIM rather than re-derived. It was
# written by this same function under the dirty gate, so it is already either a
# clean sha or an explicit refusal-shaped string; re-deriving it here is
# impossible anyway, since the commit is not reachable from a tree with no .git.
source_commit_of() {
  local root="$1" sha state forwarded
  if [ "$(manifest_field "$root" kind 2>/dev/null || true)" = install ]; then
    forwarded="$(manifest_field "$root" source_commit 2>/dev/null || true)"
    if [ -n "$forwarded" ]; then
      printf '%s\n' "$forwarded"
      return 0
    fi
    printf 'an install with no recorded commit -- these bytes name no commit\n'
    return 0
  fi
  # git_readonly for the sha as well as the state, so an inherited GIT_DIR cannot
  # pair one repository's HEAD with another's status.
  git_readonly -C "$root" rev-parse --git-dir >/dev/null 2>&1 ||
    { printf 'not a git checkout -- these bytes name no commit\n'; return 0; }
  sha="$(git_readonly -C "$root" rev-parse HEAD 2>/dev/null)" || sha=""
  [ -n "$sha" ] ||
    { printf 'a checkout with no HEAD -- these bytes name no commit\n'; return 0; }
  # Through seam_state_of, the one hardened answer to "is devbin's half
  # committed" (issue 0056). ANYTHING BUT committed IS DIRTY HERE: not watched,
  # not tracked and UNREADABLE are git declining to vouch for the bytes, and the
  # stamp's one job is never to name a commit those bytes might not be.
  state="$(seam_state_of "$root")"
  if [ "$state" != committed ]; then
    printf '%s +dirty -- THESE BYTES MATCH NO COMMIT\n' "$sha"
  else
    printf '%s\n' "$sha"
  fi
  return 0
}

# manifest_entries <root> -- the `<sha><TAB><relpath>` body, comments stripped.
#
# Retabbed from the file's two-space separator so callers split on a character
# that cannot appear in a path. TAB is an IFS whitespace character and would
# eat an empty leading field, but neither field here is ever empty, so the
# `${line%%<TAB>*}` dance is not needed -- see lib/help for the case where it is.
manifest_entries() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 1
  _two_space_to_tab <"$path"
  return 0
}

# _two_space_to_tab -- filter: `<sum>  <path>` lines to `<sum><TAB><path>`,
# comments dropped.
#
# One implementation, because both the manifest FILE and the raw output of
# sha256_files carry the same shape and both get read the same way. A path
# containing spaces is rejoined rather than truncated at the first one.
_two_space_to_tab() {
  awk '/^#/ { next } NF >= 2 { p = $2; for (i = 3; i <= NF; i++) p = p " " $i; printf "%s\t%s\n", $1, p }'
}

# manifest_write <dstroot> <srcroot> <version> [preserve] [kind] -- checksum every
# vendored file present in the target and write the manifest.
#
# Checksums the TARGET, not the source, so the manifest always describes what
# devbin actually put there. Checksumming the source would record what should
# have been copied, and a copy that silently failed would verify clean forever.
#
# `preserve` is a newline-separated list of paths whose EXISTING recorded
# checksum is carried forward instead of being recomputed. Upgrade passes the
# files it refused to overwrite, and without it the tool launders the very edits
# it just declined to touch: refuse to replace a modified file, then re-checksum
# it, and the modification is now the recorded truth. `doctor` said "26 files
# intact" one line after `upgrade` said "edited in place", which is a false
# green produced by two correct-looking steps in sequence.
manifest_write() {
  local dstroot="$1" srcroot="$2" version="$3" preserve="${4:-}" kind="${5:-}" path rel sum old old_sum line ancestry
  path="$(manifest_path "$dstroot")"
  # Read the old entries BEFORE the redirect below truncates the file.
  old="$(manifest_entries "$dstroot" 2>/dev/null || true)"
  # And the old ancestry, for the same reason: it is computed FROM the header
  # that redirect is about to destroy (issue 0059).
  ancestry=""
  if [ "$kind" = install ]; then ancestry="$(install_ancestry "$dstroot" "$srcroot")"; fi
  mkdir -p "$(dirname "$path")" || return 1
  {
    printf '# devbin manifest -- written by: devbin install. Read by: devbin upgrade, devbin doctor.\n'
    printf '# Every line below is a file devbin owns. An edit to one is DETECTED, not overwritten.\n'
    printf '# Files not listed here -- config.yaml, cmd/, help/ -- belong to the project.\n'
    printf '# devbin_version: %s\n' "$version"
    # `kind` is written ONLY for an install tree, and its absence is what marks a
    # project (D33). An install is otherwise distinguished from a project by which
    # files are MISSING -- no config.yaml, no cmd/ -- and a reader who has to infer
    # a kind from an absence is a reader who will eventually infer it wrongly.
    #
    # An `if` rather than `[ -n "$kind" ] && printf`, for the reason 0052 gave:
    # SC2015 on that form is what CI flags. It is NOT because the `&&` breaks
    # under `set -e` -- that was asserted here first and the experiment refuted
    # it, since a non-final command in an AND-list is exempt. The note stays
    # because a comment claiming a break that does not happen is the defect this
    # project catalogues.
    if [ -n "$kind" ]; then printf '# kind: %s\n' "$kind"; fi
    # Relative to HOME when it lies under it -- see manifest_source (issue 0069).
    printf '# source: %s\n' "$(home_relative "$srcroot")"
    printf '# source_commit: %s\n' "$(source_commit_of "$srcroot")"
    # An install only: see install_ancestry. A consumer never writes one, because
    # a consumer has no history to vouch for -- it received a commit, it did not
    # publish one.
    while IFS= read -r line; do
      [ -n "$line" ] && printf '# ancestry: %s\n' "$line"
    done <<EOF
$ancestry
EOF
    # Retabbed through the same filter manifest_check uses, so this file has ONE
    # parser for its own line format rather than a second one written inline --
    # and a path containing a space survives both.
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      sum="${line%%	*}"
      rel="${line#*	}"
      # A preserved path keeps its RECORDED checksum, not the one just computed
      # off disk -- see the note above about laundering.
      if list_contains "$preserve" "$rel"; then
        old_sum="$(_manifest_sum_in "$old" "$rel")"
        [ -n "$old_sum" ] && sum="$old_sum"
      fi
      printf '%s  %s\n' "$sum" "$rel"
    done <<EOF
$(_sha256_of_set "$dstroot" "$(vendored_paths "$srcroot")" | _two_space_to_tab)
EOF
  } >"$path"
  return 0
}

# _sha256_of_set <root> <rels> -- `<sum>  <rel>` for each path that EXISTS under
# <root>, in one process, with the paths still relative.
#
# Run from inside <root> so the tool prints the relative path back verbatim and
# nothing has to be stripped off the front -- which is also what keeps a
# manifest identical on two machines with different checkout locations.
_sha256_of_set() {
  local root="$1" rels="$2" rel
  local -a args
  args=()
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    [ -f "$root/$rel" ] || continue
    args[${#args[@]}]="$rel"
  done <<EOF
$rels
EOF
  # Guarded expansion: bash 3.2 aborted on an empty array under `set -u` (D9,
  # since reversed by issue 0022 -- idiom kept as harmless).
  [ "${#args[@]}" -gt 0 ] || return 0
  (cd "$root" && sha256_files "${args[@]+"${args[@]}"}")
  return 0
}

# list_contains <newline-list> <item> -- membership in a newline-separated list.
#
# Public rather than file-private because upgrade needs the same test for a
# different list, and two spellings of "is this path in that set" is how the two
# ends of the same decision come to disagree.
list_contains() {
  local line
  while IFS= read -r line; do
    [ "$line" = "$2" ] && return 0
  done <<EOF
$1
EOF
  return 1
}

# _tab_lookup <lines> <key> -- field one of the `<field1><TAB><key>` line, or
# return 1 having printed nothing.
#
# ONE loop for what was three. A recorded checksum, a manifest state and
# upgrade's per-path verdict are the same question asked of the same line shape,
# and they were three spellings of it in two files -- the exact drift the header
# of this file warns about, in miniature. The two named questions below are
# wrappers, because `_tab_lookup "$states" "$rel"` at a call site reads as a
# mistake even when it is right.
_tab_lookup() {
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "${line#*	}" = "$2" ]; then
      printf '%s\n' "${line%%	*}"
      return 0
    fi
  done <<EOF
$1
EOF
  return 1
}

# _manifest_sum_in <entries> <rel> -- the recorded checksum, or empty.
_manifest_sum_in() { _tab_lookup "$1" "$2" || true; }

# manifest_state_of <states> <rel> -- the manifest verdict for one path, or `new`.
#
# `new` rather than an error: a file the source ships and the manifest has never
# heard of is what a devbin that GREW a file looks like from the target's side.
manifest_state_of() { _tab_lookup "$1" "$2" || printf 'new\n'; }

# manifest_check <root> -- one `<state><TAB><relpath>` line per manifest entry.
#
#   ok        on disk and matching the recorded checksum
#   modified  on disk and DIFFERENT -- edited in place since install
#   missing   recorded and gone
#
# The three states upgrade and doctor both need, computed once here rather than
# twice with two spellings of "different". Returns 0 whatever it finds: it is a
# reporter, and its callers decide what a `modified` means to them.
manifest_check() {
  local root="$1" entries sums line sum rel now
  entries="$(manifest_entries "$root" 2>/dev/null || true)"
  # One checksum pass over everything present, then a pure-bash comparison. The
  # per-file form cost a fork each and made the manifest half the wall clock of
  # a test suite that installs a fixture per test.
  sums="$(_sha256_of_set "$root" "$(printf '%s\n' "$entries" | cut -f2)" | _two_space_to_tab)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    sum="${line%%	*}"
    rel="${line#*	}"
    if [ ! -f "$root/$rel" ]; then
      printf 'missing\t%s\n' "$rel"
      continue
    fi
    now="$(_manifest_sum_in "$sums" "$rel")"
    if [ "$now" = "$sum" ]; then
      printf 'ok\t%s\n' "$rel"
    else
      printf 'modified\t%s\n' "$rel"
    fi
  done <<EOF
$entries
EOF
  return 0
}

# install_ancestry <install> <checkout> -- the `<sha> <direction>` table a publish
# from <checkout> writes into <install>'s manifest, one line per commit.
#
# EVERY COMMIT THE INSTALL HAS HELD, placed against the commit it is about to
# hold. The commits are the ones already in its table plus the one it holds now;
# the directions are RECOMPUTED from git on every publish, never carried, because
# a direction is relative to a head and the head is what a publish moves. Only
# the list of commits is carried. So a rewind is seen however many publishes
# later it happens, and a direction is never older than the install.
#
# The new head itself is left out: it is `same`, and source_commit already says
# so. A commit this checkout does not have -- a publish from a different clone --
# is kept as `unknown`, so a later publish from a checkout that has it can still
# place it.
#
# TWO LIMITS, DECLARED BECAUSE THE PARAGRAPH ABOVE WOULD OTHERWISE OVERCLAIM
# (critic-shell, 2026-09-16). The table begins at the first publish made by a
# devbin carrying it: that publish learns only the one commit the install held
# before it, so commits held earlier still are not in it. And a publish runs the
# CHECKOUT's own lib, so rewinding the checkout to a commit from before 0059
# rewinds the publisher too, and that publish writes no table at all -- the
# history carried until then is gone, and every consumer reads `unknown`.
# upgrade says so out loud when the bytes would change (lib/cmd/upgrade).
install_ancestry() {
  local install="$1" checkout="$2" head sha seen=""
  head="$(git -C "$checkout" rev-parse HEAD 2>/dev/null)" || head=""
  while IFS= read -r sha; do
    is_commit_sha "$sha" || continue
    [ "$sha" = "$head" ] && continue
    list_contains "$seen" "$sha" && continue
    seen="$seen$sha
"
    printf '%s %s\n' "$sha" "$(commit_direction "$checkout" "$sha")"
  done <<EOF
$(manifest_ancestry "$install" | cut -f1)
$({ manifest_source_commit "$install" 2>/dev/null || true; } | awk '{ print $1 }')
EOF
  return 0
}

# vendor_states <dstroot> <srcroot> -- one `<state><TAB><relpath>` line per file
# on either side of the comparison.
#
# THE CROSS PRODUCT OF THE TWO COMPARISONS DEVBIN ALREADY MADE SEPARATELY, and
# that is the whole contribution. `manifest_check` asks tree-vs-INSTALL-TIME; a
# checksum against the source asks tree-vs-SOURCE. Neither alone can tell a file
# somebody edited here from one the source has simply moved past, because each
# is blind to the axis the other measures:
#
#                 source equal    source differs    source absent
#   ok            level           behind            orphaned
#   modified      CONVERGED       patched           released
#   missing       absent          absent            --
#
# The cell in capitals is why this is worth a function rather than two greps. A
# file edited here whose edit has since been UPSTREAMED matches the canonical
# bytes exactly while the manifest still records the pre-patch checksum -- so
# doctor calls it edited forever and upgrade has nothing left to replace. That
# is the carry doctrine working as designed, and it looked like damage.
#
# Reports and never writes. The manifest is the evidence for half of what is
# being reported, so restamping it here would destroy the finding in the act of
# printing it -- the same defect the refusing upgrade once had.
vendor_states() {
  local dstroot="$1" srcroot="$2" paths states dst_sums src_sums
  local rel abs src_rel state sum_src sum_dst line
  paths="$(vendored_paths "$srcroot")" || return 1
  states="$(manifest_check "$dstroot")"

  # ONE checksum process per side, then pure-bash lookups -- the shape
  # manifest_check uses, and for its reason: the per-file form cost a fork each
  # and made the manifest half the wall clock of a suite that installs a fixture
  # per test.
  dst_sums="$(_sha256_of_set "$dstroot" "$paths" | _two_space_to_tab)"
  src_sums="$(_sha256_of_set "$srcroot" "$(_source_rels "$srcroot" "$paths")" | _two_space_to_tab)"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    abs="$(vendor_source_path "$srcroot" "$rel")" || continue
    if [ ! -f "$dstroot/$rel" ]; then
      printf 'absent\t%s\n' "$rel"
      continue
    fi
    src_rel="${abs#"$srcroot"/}"
    sum_src="$(_manifest_sum_in "$src_sums" "$src_rel")"
    sum_dst="$(_manifest_sum_in "$dst_sums" "$rel")"
    state="$(manifest_state_of "$states" "$rel")"
    if [ "$sum_src" = "$sum_dst" ]; then
      case "$state" in
        modified) printf 'converged\t%s\n' "$rel" ;;
        *) printf 'level\t%s\n' "$rel" ;;
      esac
    else
      case "$state" in
        modified) printf 'patched\t%s\n' "$rel" ;;
        *) printf 'behind\t%s\n' "$rel" ;;
      esac
    fi
  done <<EOF
$paths
EOF

  # A path the manifest records that the source no longer ships. Upgrade's own
  # two answers, named the same way it names them: it REMOVES an intact orphan
  # and RELEASES an edited one, and a reader deciding whether to run it needs to
  # know which of those is waiting.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    state="${line%%	*}"
    rel="${line#*	}"
    list_contains "$paths" "$rel" && continue
    case "$state" in
      missing) continue ;;
      modified) printf 'released\t%s\n' "$rel" ;;
      *) printf 'orphaned\t%s\n' "$rel" ;;
    esac
  done <<EOF
$states
EOF

  # On devbin's side of the seam and owned by nobody: not shipped by the source,
  # not recorded by the manifest. Upgrade never removes it -- it is not in the
  # source list -- so without a line here the report's file list would not add
  # up to what is actually on disk.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    list_contains "$paths" "$rel" && continue
    [ "$(manifest_state_of "$states" "$rel")" = new ] || continue
    printf 'unlisted\t%s\n' "$rel"
  done <<EOF
$(vendored_dir_files "$dstroot")
EOF
  return 0
}

# seam_is_level <dstroot> <srcroot> -- rc 0 when NO vendored byte would change.
#
# THE QUESTION `source_direction` CANNOT ANSWER, and issue 0053 is what happens
# when the two are confused. `source_direction` compares COMMITS; this compares
# BYTES. A source can be behind in commit order and byte-identical under the
# seam -- two commits that touched only documentation put every consumer in
# exactly that state -- and `upgrade` was warning `will REVERT the runtime`
# about it, four lines before its own summary said `No vendored file differs`.
#
# FAILS CLOSED, DELIBERATELY. An unreadable comparison returns "not level", so
# the caller keeps its warning. The opposite default would silence a real
# revert warning whenever the check itself broke, which is the one direction
# that costs something.
#
# `converged` counts as level: the bytes match the source exactly, and it is
# only the manifest that still records the pre-patch checksum. `unlisted` too --
# it is on devbin's side of the seam, owned by nobody, and upgrade never
# touches it. Every other state means a file moves.
#
# Costs two checksum passes over the vendored set. Called only where the answer
# changes what is printed, which is the backward and unrelated arms of
# upgrade's notice -- not on the ordinary forward path.
seam_is_level() {
  local dstroot="$1" srcroot="$2" states line state
  states="$(vendor_states "$dstroot" "$srcroot")" || return 1
  [ -n "$states" ] || return 1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    state="${line%%	*}"
    case "$state" in
      level | converged | unlisted) ;;
      *) return 1 ;;
    esac
  done <<EOF
$states
EOF
  return 0
}

# _source_rels <srcroot> <paths> -- the same file list, spelled the way it is
# spelled INSIDE the source, so one batch checksum can be taken from that root.
#
# Not the identity: a source checkout keeps its runtime at `lib/` and an
# installed project at `bin/.devbin/lib/`, and both are legal sources.
_source_rels() {
  local srcroot="$1" paths="$2" rel abs
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    abs="$(vendor_source_path "$srcroot" "$rel")" || continue
    printf '%s\n' "${abs#"$srcroot"/}"
  done <<EOF
$paths
EOF
  return 0
}

# devbin_version_of <root> -- which devbin a tree carries.
#
# Two cases, told apart by whether the runtime is vendored. INSTALLED: the
# manifest header, stamped by the devbin that did the installing -- the tree's
# own VERSION is that PROJECT's version and says nothing about the framework. A
# source CHECKOUT: its VERSION, which is devbin's, because devbin is the
# project there.
#
# The alternative -- a `lib/VERSION` stamped into the vendored copy -- would put
# devbin's version in two files in the source repo, which is the drift D23 was
# written about. This costs one branch and no new file.
devbin_version_of() {
  local root="$1" v=""
  if is_devbin_installed "$root"; then
    v="$(manifest_version "$root" 2>/dev/null)" || v=""
  fi
  [ -n "$v" ] || v="$(read_version "$root/VERSION" version-file)"
  printf '%s\n' "$v"
}

# devbin_runtime_version -- which devbin is RUNNING right now.
#
# One call, not a second implementation: `is_devbin_installed $PROJECT_ROOT` and
# the dispatcher's `DEVBIN_LIB = $DEVBIN_DIR/lib` are the same question, because
# the dispatcher picks the vendored lib exactly when it exists.
devbin_runtime_version() { devbin_version_of "${PROJECT_ROOT:-.}"; }

# version_satisfies <version> <constraint> -- does <version> meet the config's
# `devbin_version:` declaration?
#
# Three forms, which is all the config subset needs:
#
#   ^X.Y.Z   same major, and at least X.Y.Z          (the usual)
#   >=X.Y.Z  at least X.Y.Z, any major
#   X.Y.Z    exactly
#
# A caret on 0.x is treated the way semver's own text does NOT -- ^0.4.0 admits
# 0.5.0 here. (The example deliberately names a version devbin is not: an
# example that happens to equal the current VERSION reads as a claim about it.)
# Pre-1.0 devbin has no stability promise to encode either way, and the
# alternative pins every project to a patch series and makes `upgrade` a lie.
version_satisfies() {
  local v="$1" c="${2:-}" vmaj vmin vpat cmaj cmin cpat op="^" n
  # No constraint declared is satisfied by anything. Written the other way round
  # first, which made every declared constraint return 0 before it was read --
  # a check that passes without checking, three days after AC-04.13 said so.
  [ -z "$c" ] && return 0
  case "$c" in
    "^"*) op="^" c="${c#^}" ;;
    ">="*) op=">=" c="${c#>=}" ;;
    *) op="=" ;;
  esac
  IFS='.' read -r vmaj vmin vpat <<EOF
$v
EOF
  IFS='.' read -r cmaj cmin cpat <<EOF
$c
EOF
  # Each part checked SEPARATELY, not as one concatenation: `0.1` splits to an
  # empty patch, and an empty field vanishes into the joined string while still
  # blowing up `[ "" -ge 0 ]` further down. An unparseable version -- `unknown`,
  # what read_version returns when it finds nothing -- fails here, which is the
  # answer doctor wants.
  for n in "$vmaj" "$vmin" "$vpat" "$cmaj" "$cmin" "$cpat"; do
    case "$n" in '' | *[!0-9]*) return 1 ;; esac
  done
  case "$op" in
    "=") [ "$v" = "$c" ] && return 0 ;;
    "^")
      [ "$vmaj" -eq "$cmaj" ] || return 1
      [ "$vmin" -gt "$cmin" ] && return 0
      [ "$vmin" -eq "$cmin" ] && [ "$vpat" -ge "$cpat" ] && return 0
      ;;
    ">=")
      [ "$vmaj" -gt "$cmaj" ] && return 0
      [ "$vmaj" -lt "$cmaj" ] && return 1
      [ "$vmin" -gt "$cmin" ] && return 0
      [ "$vmin" -lt "$cmin" ] && return 1
      [ "$vpat" -ge "$cpat" ] && return 0
      ;;
  esac
  return 1
}
