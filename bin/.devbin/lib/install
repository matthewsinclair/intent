#!/usr/bin/env bash
#
# lib/install -- vendoring, the checksum manifest, and what devbin owns.
#
# Sourced, not executed. Depends on lib/helpers ALONE, which is deliberate: the
# three commands built on it (`install`, `upgrade`, `doctor`) each operate on a
# project that is not necessarily the one whose config is loaded, so a function
# here must never reach for `cfg_get`. Everything it needs about a tree is
# passed in or read off that tree.
#
# THE SEAM, which is the whole of design D5 in one sentence: everything under
# `bin/.devbin/lib/` plus `bin/devbin` is DEVBIN's and is replaced wholesale;
# everything else under `bin/.devbin/` -- `config.yaml`, `cmd/`, `help/` -- is
# the PROJECT's and is never written by any function in this file. One rule,
# stated once, and `vendored_paths` is the only thing that enumerates the first
# half. An upgrade that overwrote an authored help topic would be a data loss
# bug in a tool whose entire job is to be safe to re-run.
#
[ -n "${_DEVBIN_INSTALL_LOADED:-}" ] && return 0
_DEVBIN_INSTALL_LOADED=1

# The manifest, relative to a project root. Devbin's file, but NOT under lib/:
# it has to survive the wholesale replacement of the directory it describes.
DEVBIN_MANIFEST_REL="bin/.devbin/manifest.sha256"

# devbin_lib_dir <root> -- where <root> keeps a devbin runtime, or return 1.
#
# The same two-place test the dispatcher makes on itself: the vendored copy
# first, the checkout's own lib/ as the fallback that lets Devbin run itself
# (D12). The dispatcher has its own inline copy because it runs BEFORE any
# library is sourced -- it is the code that finds this file -- which is a real
# bootstrap exception rather than a licence to have two of these. Everything
# else asks here.
devbin_lib_dir() {
  local root="$1"
  if [ -d "$root/bin/.devbin/lib" ]; then
    printf '%s\n' "$root/bin/.devbin/lib"
    return 0
  fi
  if [ -d "$root/lib" ]; then
    printf '%s\n' "$root/lib"
    return 0
  fi
  return 1
}

# is_devbin_source <root> -- true when <root> can be vendored FROM.
#
# The dispatcher and lib/helpers, because those are the two files whose absence
# makes every other check meaningless. Checked before upgrade writes anything
# (AC-09.9): a half-replaced runtime leaves a project that cannot run at all,
# which is strictly worse than the stale one it was replacing.
is_devbin_source() {
  local root="$1" lib
  [ -f "$root/bin/devbin" ] || return 1
  lib="$(devbin_lib_dir "$root")" || return 1
  [ -f "$lib/helpers" ] || return 1
  return 0
}

# is_devbin_installed <root> -- true when <root> carries a VENDORED runtime.
#
# Deliberately not `devbin_lib_dir` succeeding: a devbin CHECKOUT answers that
# too, via the D12 fallback, and calling the source tree "installed" would have
# `upgrade` try to re-vendor Devbin into itself.
is_devbin_installed() {
  [ -d "$1/bin/.devbin/lib" ]
}

# vendored_paths <srcroot> -- every file devbin owns, as paths RELATIVE to a
# project root, sorted. This is the file list, and the only one.
#
# `bin/devbin` plus one line per file under the source's lib/. Sorted so the
# manifest is stable across machines -- `find` returns directory order, which
# differs between filesystems, and an unstable manifest makes every upgrade
# report look like a change.
vendored_paths() {
  local srcroot="$1" lib f
  lib="$(devbin_lib_dir "$srcroot")" || return 1
  printf 'bin/devbin\n'
  find "$lib" -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
    printf 'bin/.devbin/lib/%s\n' "${f#"$lib"/}"
  done
  return 0
}

# vendored_dir_files <root> -- every file actually sitting under <root>'s
# VENDORED lib, as project-relative paths, sorted.
#
# The target-side twin of vendored_paths, and deliberately a separate function
# rather than a parameter on that one: vendored_paths asks a SOURCE what it
# ships, where the runtime is at `lib/` or `bin/.devbin/lib/` depending on D12;
# this asks an INSTALL what is on disk, where the answer is always
# `bin/.devbin/lib/`. One is a statement of intent and the other an inventory --
# comparing them is the entire point, so collapsing them would erase the
# difference being measured.
vendored_dir_files() {
  local lib="$1/bin/.devbin/lib" f
  [ -d "$lib" ] || return 0
  find "$lib" -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do
    printf 'bin/.devbin/lib/%s\n' "${f#"$lib"/}"
  done
  return 0
}

# vendor_source_path <srcroot> <relpath> -- where <relpath> lives in the SOURCE.
#
# The inverse of the mapping vendored_paths applies. It is not the identity: a
# source checkout keeps its runtime at `lib/`, an installed project at
# `bin/.devbin/lib/`, and both are legal sources.
vendor_source_path() {
  local srcroot="$1" rel="$2" lib
  case "$rel" in
    bin/devbin)
      printf '%s\n' "$srcroot/bin/devbin"
      return 0
      ;;
    bin/.devbin/lib/*)
      lib="$(devbin_lib_dir "$srcroot")" || return 1
      printf '%s\n' "$lib/${rel#bin/.devbin/lib/}"
      return 0
      ;;
  esac
  return 1
}

# vendored_scope <srcroot> -- devbin's half as git PATHSPECS into the source,
# one per line. The scope, not the roll-call.
#
# The third member of the vendored_paths / vendored_dir_files family, and a
# separate function for the same reason those two are separate: it answers a
# different question. `vendored_paths` asks WHICH FILES ship, `vendored_dir_files`
# asks what is ON DISK, and this asks WHERE devbin's half lives -- which is the
# only shape a git pathspec can take.
#
# IT IS DELIBERATELY NOT BUILT ON vendored_paths, and that is the whole point.
# That function enumerates with `find`, so a vendored file DELETED but not yet
# committed simply stops being listed, and a `git status` limited to the names
# that survive reports nothing at all. Measured on a fixture with `lib/beta`
# removed: the file-list pathspec answers CLEAN while a vendored file is
# missing; the directory pathspec answers ` D lib/beta`. Under-reporting clean
# is the one direction this subsystem must never go, and a directory is read
# against HEAD where a name list is read against disk.
vendored_scope() {
  local srcroot="$1" lib
  lib="$(devbin_lib_dir "$srcroot")" || return 1
  printf '%s\n' "$srcroot/bin/devbin"
  printf '%s\n' "$lib"
  return 0
}

# copy_vendored <src> <dst> -- copy one file, creating its directory, and carry
# the executable bit across.
#
# The bit is copied per file rather than by re-deriving which paths ought to be
# executable. `cp` gives a new file the source's mode on both platforms, but
# relying on that leaves a silent failure -- a `lib/cmd/test` that arrives
# non-executable resolves and then does not run -- resting on a detail of cp.
# Three forks per file became one. `$(dirname)` is an external command and
# `mkdir -p` runs whether or not the directory is there, so a 26-file vendor
# spent 78 processes to make three directories and set two exec bits -- and the
# test suite installs a fixture per test. `${dst%/*}` and `[ -d ]` are builtins;
# the chmods now fire only when the mode is actually wrong, which on both
# platforms means almost never, since cp gives a new file the source's mode.
# REPLACING an existing file goes through a temporary and a rename, so a reader
# sees the old file or the new one and never a half-written one. `sed_inplace`
# in lib/helpers does this already and for the same reason; upgrade rewriting
# the dispatcher and every library under a project someone may be running is the
# case that matters most.
#
# Only the replace path pays for it. A file that does not exist yet cannot be
# read mid-write, so a fresh install keeps the single-fork copy the vendoring
# loop was tuned for -- and a fresh install is what the test suite does per
# fixture.
copy_vendored() {
  local src="$1" dst="$2" dir="${2%/*}" tmp
  [ -d "$dir" ] || mkdir -p "$dir" || return 1

  if [ ! -e "$dst" ]; then
    cp "$src" "$dst" || return 1
    if [ -x "$src" ]; then
      [ -x "$dst" ] || chmod +x "$dst"
    elif [ -x "$dst" ]; then
      chmod -x "$dst"
    fi
    return 0
  fi

  # `$$` is the shell's PID and a subshell inherits it (lib/runlog says why that
  # makes it useless for uniqueness ACROSS processes). Here it only has to be
  # unique within one install, beside a destination no other path writes.
  tmp="$dst.devbin-new.$$"
  cp "$src" "$tmp" || {
    rm -f "$tmp"
    return 1
  }
  if [ -x "$src" ]; then
    [ -x "$tmp" ] || chmod +x "$tmp"
  elif [ -x "$tmp" ]; then
    chmod -x "$tmp"
  fi
  mv -f "$tmp" "$dst" || {
    rm -f "$tmp"
    return 1
  }
  return 0
}

# --- the manifest ------------------------------------------------------------
#
# `<sha256>  <path>` lines in the conventional shasum spelling, under a `#`
# header carrying the facts the file itself cannot supply: which devbin wrote
# it, where that devbin was, and WHICH COMMIT OF IT. The first two are read back
# -- the version by doctor, the source by upgrade, which is what lets `devbin
# upgrade` be typed with no arguments from inside the installed project.

manifest_path() { printf '%s\n' "$1/$DEVBIN_MANIFEST_REL"; }

# manifest_field <root> <field> -- read one `# <field>: <value>` header line.
manifest_field() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 1
  awk -v f="$2" '
    $0 !~ /^#/ { exit }
    {
      line = $0
      sub(/^#[[:space:]]*/, "", line)
      if (line ~ ("^" f ":")) {
        sub("^" f ":[[:space:]]*", "", line)
        sub(/[[:space:]]+$/, "", line)
        print line
        exit
      }
    }
  ' "$path"
}

manifest_version() { manifest_field "$1" devbin_version; }
manifest_source() { manifest_field "$1" source; }
manifest_source_commit() { manifest_field "$1" source_commit; }

# source_commit_of <srcroot> -- WHICH devbin these bytes came from, as a line.
#
# PUBLIC, and named that way because a second file depends on it. `manifest_write`
# stamps it and `lib/cmd/vendor` prints it, and an underscore on a function
# reaching across a file boundary is a false signal about its contract -- the
# same reason the three tab-lookups above became one named pair.
#
# `devbin_version` is a semver that moves once a release, so it cannot separate
# two installs from the same release, and a consumer comparing its vendored tree
# to this manifest is otherwise doing a purely internal check: a re-vendor
# rewrites the files AND this header together, so it is indistinguishable from a
# local patch with the manifest regenerated. Measured, not imagined -- a consumer
# reported its tree "stock, 27 of 27" over an uncommitted re-vendor eleven
# minutes old, and every check involved was correct. Nothing was asking what the
# tree corresponds to OUTSIDE itself.
#
# DIRTY IS RECORDED RATHER THAN HIDDEN, because a sha read from a dirty source
# describes bytes no commit has, and the bare sha would be a confident false
# statement. Not a checkout at all says so in words: an ABSENT field is what an
# older devbin wrote, and absent must never be readable as clean.
#
# DIRTY IS ASKED OF DEVBIN'S HALF, NOT OF THE TREE (issue 0033). The question
# this field answers is what the VENDORED bytes correspond to, and a file
# outside the seam cannot change that answer. A tree-wide `git status` made the
# stamp true about the tree and false about the bytes: one open whiteboard board
# in the source stamped eleven consuming estates THESE BYTES MATCH NO COMMIT
# over a surface that matched HEAD exactly. It erred safe, which is why it
# survived -- but in a project with a live whiteboard some node is always
# mid-edit, so the accurate stamp was close to unreachable and a warning that
# never clears stops being read. Narrowed, it still errs safe: `vendored_scope`
# is a DIRECTORY pathspec precisely so a deleted vendored file is still seen.
#
# WHEN THE HALF CANNOT BE LOCATED the tree-wide question is asked instead,
# rather than a narrower one being invented. A root with no `lib/` and no
# `bin/.devbin/lib/` is not a devbin source this can clear, and absent must
# never be readable as clean.
source_commit_of() {
  local root="$1" sha p dirty
  local -a scope=()
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 ||
    { printf 'not a git checkout -- these bytes name no commit\n'; return 0; }
  sha="$(git -C "$root" rev-parse HEAD 2>/dev/null)" || sha=""
  [ -n "$sha" ] ||
    { printf 'a checkout with no HEAD -- these bytes name no commit\n'; return 0; }
  while IFS= read -r p; do
    [ -n "$p" ] && scope+=("$p")
  done < <(vendored_scope "$root")
  if [ "${#scope[@]}" -gt 0 ]; then
    dirty="$(git -C "$root" status --porcelain -- "${scope[@]}" 2>/dev/null)"
  else
    dirty="$(git -C "$root" status --porcelain 2>/dev/null)"
  fi
  if [ -n "$dirty" ]; then
    printf '%s +dirty -- THESE BYTES MATCH NO COMMIT\n' "$sha"
  else
    printf '%s\n' "$sha"
  fi
  return 0
}

# manifest_entries <root> -- the `<sha><TAB><relpath>` body, comments stripped.
#
# Retabbed from the file's two-space separator so callers split on a character
# that cannot appear in a path. TAB is an IFS whitespace character and would
# eat an empty leading field, but neither field here is ever empty, so the
# `${line%%<TAB>*}` dance is not needed -- see lib/help for the case where it is.
manifest_entries() {
  local path
  path="$(manifest_path "$1")"
  [ -f "$path" ] || return 1
  _two_space_to_tab <"$path"
  return 0
}

# _two_space_to_tab -- filter: `<sum>  <path>` lines to `<sum><TAB><path>`,
# comments dropped.
#
# One implementation, because both the manifest FILE and the raw output of
# sha256_files carry the same shape and both get read the same way. A path
# containing spaces is rejoined rather than truncated at the first one.
_two_space_to_tab() {
  awk '/^#/ { next } NF >= 2 { p = $2; for (i = 3; i <= NF; i++) p = p " " $i; printf "%s\t%s\n", $1, p }'
}

# manifest_write <dstroot> <srcroot> <version> [preserve] -- checksum every
# vendored file present in the target and write the manifest.
#
# Checksums the TARGET, not the source, so the manifest always describes what
# devbin actually put there. Checksumming the source would record what should
# have been copied, and a copy that silently failed would verify clean forever.
#
# `preserve` is a newline-separated list of paths whose EXISTING recorded
# checksum is carried forward instead of being recomputed. Upgrade passes the
# files it refused to overwrite, and without it the tool launders the very edits
# it just declined to touch: refuse to replace a modified file, then re-checksum
# it, and the modification is now the recorded truth. `doctor` said "26 files
# intact" one line after `upgrade` said "edited in place", which is a false
# green produced by two correct-looking steps in sequence.
manifest_write() {
  local dstroot="$1" srcroot="$2" version="$3" preserve="${4:-}" path rel sum old old_sum line
  path="$(manifest_path "$dstroot")"
  # Read the old entries BEFORE the redirect below truncates the file.
  old="$(manifest_entries "$dstroot" 2>/dev/null || true)"
  mkdir -p "$(dirname "$path")" || return 1
  {
    printf '# devbin manifest -- written by: devbin install. Read by: devbin upgrade, devbin doctor.\n'
    printf '# Every line below is a file devbin owns. An edit to one is DETECTED, not overwritten.\n'
    printf '# Files not listed here -- config.yaml, cmd/, help/ -- belong to the project.\n'
    printf '# devbin_version: %s\n' "$version"
    printf '# source: %s\n' "$srcroot"
    printf '# source_commit: %s\n' "$(source_commit_of "$srcroot")"
    # Retabbed through the same filter manifest_check uses, so this file has ONE
    # parser for its own line format rather than a second one written inline --
    # and a path containing a space survives both.
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      sum="${line%%	*}"
      rel="${line#*	}"
      # A preserved path keeps its RECORDED checksum, not the one just computed
      # off disk -- see the note above about laundering.
      if list_contains "$preserve" "$rel"; then
        old_sum="$(_manifest_sum_in "$old" "$rel")"
        [ -n "$old_sum" ] && sum="$old_sum"
      fi
      printf '%s  %s\n' "$sum" "$rel"
    done <<EOF
$(_sha256_of_set "$dstroot" "$(vendored_paths "$srcroot")" | _two_space_to_tab)
EOF
  } >"$path"
  return 0
}

# _sha256_of_set <root> <rels> -- `<sum>  <rel>` for each path that EXISTS under
# <root>, in one process, with the paths still relative.
#
# Run from inside <root> so the tool prints the relative path back verbatim and
# nothing has to be stripped off the front -- which is also what keeps a
# manifest identical on two machines with different checkout locations.
_sha256_of_set() {
  local root="$1" rels="$2" rel
  local -a args
  args=()
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    [ -f "$root/$rel" ] || continue
    args[${#args[@]}]="$rel"
  done <<EOF
$rels
EOF
  # Guarded expansion: bash 3.2 aborted on an empty array under `set -u` (D9,
  # since reversed by issue 0022 -- idiom kept as harmless).
  [ "${#args[@]}" -gt 0 ] || return 0
  (cd "$root" && sha256_files "${args[@]+"${args[@]}"}")
  return 0
}

# list_contains <newline-list> <item> -- membership in a newline-separated list.
#
# Public rather than file-private because upgrade needs the same test for a
# different list, and two spellings of "is this path in that set" is how the two
# ends of the same decision come to disagree.
list_contains() {
  local line
  while IFS= read -r line; do
    [ "$line" = "$2" ] && return 0
  done <<EOF
$1
EOF
  return 1
}

# _tab_lookup <lines> <key> -- field one of the `<field1><TAB><key>` line, or
# return 1 having printed nothing.
#
# ONE loop for what was three. A recorded checksum, a manifest state and
# upgrade's per-path verdict are the same question asked of the same line shape,
# and they were three spellings of it in two files -- the exact drift the header
# of this file warns about, in miniature. The two named questions below are
# wrappers, because `_tab_lookup "$states" "$rel"` at a call site reads as a
# mistake even when it is right.
_tab_lookup() {
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "${line#*	}" = "$2" ]; then
      printf '%s\n' "${line%%	*}"
      return 0
    fi
  done <<EOF
$1
EOF
  return 1
}

# _manifest_sum_in <entries> <rel> -- the recorded checksum, or empty.
_manifest_sum_in() { _tab_lookup "$1" "$2" || true; }

# manifest_state_of <states> <rel> -- the manifest verdict for one path, or `new`.
#
# `new` rather than an error: a file the source ships and the manifest has never
# heard of is what a devbin that GREW a file looks like from the target's side.
manifest_state_of() { _tab_lookup "$1" "$2" || printf 'new\n'; }

# manifest_check <root> -- one `<state><TAB><relpath>` line per manifest entry.
#
#   ok        on disk and matching the recorded checksum
#   modified  on disk and DIFFERENT -- edited in place since install
#   missing   recorded and gone
#
# The three states upgrade and doctor both need, computed once here rather than
# twice with two spellings of "different". Returns 0 whatever it finds: it is a
# reporter, and its callers decide what a `modified` means to them.
manifest_check() {
  local root="$1" entries sums line sum rel now
  entries="$(manifest_entries "$root" 2>/dev/null || true)"
  # One checksum pass over everything present, then a pure-bash comparison. The
  # per-file form cost a fork each and made the manifest half the wall clock of
  # a test suite that installs a fixture per test.
  sums="$(_sha256_of_set "$root" "$(printf '%s\n' "$entries" | cut -f2)" | _two_space_to_tab)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    sum="${line%%	*}"
    rel="${line#*	}"
    if [ ! -f "$root/$rel" ]; then
      printf 'missing\t%s\n' "$rel"
      continue
    fi
    now="$(_manifest_sum_in "$sums" "$rel")"
    if [ "$now" = "$sum" ]; then
      printf 'ok\t%s\n' "$rel"
    else
      printf 'modified\t%s\n' "$rel"
    fi
  done <<EOF
$entries
EOF
  return 0
}

# source_direction <dstroot> <srcroot> -- which way the source has moved since
# these bytes were vendored:
#
#   same       the source is exactly the commit that was vendored
#   forward    the recorded commit is an ancestor of the source's HEAD
#   backward   the source's HEAD is an ancestor of the recorded commit
#   unrelated  neither contains the other -- a different history
#   unknown    the question cannot be answered from what is on disk
#
# UNKNOWN IS A REAL ANSWER AND MUST NEVER BE READ AS `forward`. There are four
# ways to reach it and none of them is exotic: the field is ABSENT on a manifest
# written before b433988, it is PROSE when the source was not a checkout, it
# carries `+dirty` when the bytes matched no commit, and a fresh clone may
# simply not HAVE the recorded commit. Collapsing any of those into "fine" is
# the direction that costs something -- upgrade syncs from source
# unconditionally, so a downgrade prints `updated` per file and leaves doctor
# green (issue 0021, measured at 11 files).
#
# Reads git in the SOURCE only. The target may not be a checkout at all, and
# whether it is has no bearing on which devbin it received.
source_direction() {
  local dstroot="$1" srcroot="$2" rec head
  rec="$(manifest_source_commit "$dstroot" 2>/dev/null || true)"
  # The recorded value is a LINE, not a field: `<sha>`, `<sha> +dirty -- ...`,
  # or a whole sentence. Taking the first word reduces all three to something
  # that either is a sha or visibly is not -- `a checkout with no HEAD` reduces
  # to `a`, which is valid hex and exactly why the length test below is not
  # redundant with the charset one.
  rec="${rec%% *}"
  case "$rec" in '' | *[!0-9a-f]*) printf 'unknown\n'; return 0 ;; esac
  [ "${#rec}" -ge 7 ] || { printf 'unknown\n'; return 0; }

  git -C "$srcroot" rev-parse --git-dir >/dev/null 2>&1 ||
    { printf 'unknown\n'; return 0; }
  head="$(git -C "$srcroot" rev-parse HEAD 2>/dev/null)" || head=""
  [ -n "$head" ] || { printf 'unknown\n'; return 0; }
  # ASKED BEFORE THE ANCESTRY TESTS, because `merge-base --is-ancestor` returns
  # 1 both for "not an ancestor" and for a commit this repository has never
  # heard of, and those are `unrelated` and `unknown` respectively.
  git -C "$srcroot" cat-file -e "$rec^{commit}" 2>/dev/null ||
    { printf 'unknown\n'; return 0; }

  case "$head" in "$rec"*) printf 'same\n'; return 0 ;; esac
  if git -C "$srcroot" merge-base --is-ancestor "$rec" "$head" 2>/dev/null; then
    printf 'forward\n'
  elif git -C "$srcroot" merge-base --is-ancestor "$head" "$rec" 2>/dev/null; then
    printf 'backward\n'
  else
    printf 'unrelated\n'
  fi
  return 0
}

# vendor_states <dstroot> <srcroot> -- one `<state><TAB><relpath>` line per file
# on either side of the comparison.
#
# THE CROSS PRODUCT OF THE TWO COMPARISONS DEVBIN ALREADY MADE SEPARATELY, and
# that is the whole contribution. `manifest_check` asks tree-vs-INSTALL-TIME; a
# checksum against the source asks tree-vs-SOURCE. Neither alone can tell a file
# somebody edited here from one the source has simply moved past, because each
# is blind to the axis the other measures:
#
#                 source equal    source differs    source absent
#   ok            level           behind            orphaned
#   modified      CONVERGED       patched           released
#   missing       absent          absent            --
#
# The cell in capitals is why this is worth a function rather than two greps. A
# file edited here whose edit has since been UPSTREAMED matches the canonical
# bytes exactly while the manifest still records the pre-patch checksum -- so
# doctor calls it edited forever and upgrade has nothing left to replace. That
# is the carry doctrine working as designed, and it looked like damage.
#
# Reports and never writes. The manifest is the evidence for half of what is
# being reported, so restamping it here would destroy the finding in the act of
# printing it -- the same defect the refusing upgrade once had.
vendor_states() {
  local dstroot="$1" srcroot="$2" paths states dst_sums src_sums
  local rel abs src_rel state sum_src sum_dst line
  paths="$(vendored_paths "$srcroot")" || return 1
  states="$(manifest_check "$dstroot")"

  # ONE checksum process per side, then pure-bash lookups -- the shape
  # manifest_check uses, and for its reason: the per-file form cost a fork each
  # and made the manifest half the wall clock of a suite that installs a fixture
  # per test.
  dst_sums="$(_sha256_of_set "$dstroot" "$paths" | _two_space_to_tab)"
  src_sums="$(_sha256_of_set "$srcroot" "$(_source_rels "$srcroot" "$paths")" | _two_space_to_tab)"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    abs="$(vendor_source_path "$srcroot" "$rel")" || continue
    if [ ! -f "$dstroot/$rel" ]; then
      printf 'absent\t%s\n' "$rel"
      continue
    fi
    src_rel="${abs#"$srcroot"/}"
    sum_src="$(_manifest_sum_in "$src_sums" "$src_rel")"
    sum_dst="$(_manifest_sum_in "$dst_sums" "$rel")"
    state="$(manifest_state_of "$states" "$rel")"
    if [ "$sum_src" = "$sum_dst" ]; then
      case "$state" in
        modified) printf 'converged\t%s\n' "$rel" ;;
        *) printf 'level\t%s\n' "$rel" ;;
      esac
    else
      case "$state" in
        modified) printf 'patched\t%s\n' "$rel" ;;
        *) printf 'behind\t%s\n' "$rel" ;;
      esac
    fi
  done <<EOF
$paths
EOF

  # A path the manifest records that the source no longer ships. Upgrade's own
  # two answers, named the same way it names them: it REMOVES an intact orphan
  # and RELEASES an edited one, and a reader deciding whether to run it needs to
  # know which of those is waiting.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    state="${line%%	*}"
    rel="${line#*	}"
    list_contains "$paths" "$rel" && continue
    case "$state" in
      missing) continue ;;
      modified) printf 'released\t%s\n' "$rel" ;;
      *) printf 'orphaned\t%s\n' "$rel" ;;
    esac
  done <<EOF
$states
EOF

  # On devbin's side of the seam and owned by nobody: not shipped by the source,
  # not recorded by the manifest. Upgrade never removes it -- it is not in the
  # source list -- so without a line here the report's file list would not add
  # up to what is actually on disk.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    list_contains "$paths" "$rel" && continue
    [ "$(manifest_state_of "$states" "$rel")" = new ] || continue
    printf 'unlisted\t%s\n' "$rel"
  done <<EOF
$(vendored_dir_files "$dstroot")
EOF
  return 0
}

# _source_rels <srcroot> <paths> -- the same file list, spelled the way it is
# spelled INSIDE the source, so one batch checksum can be taken from that root.
#
# Not the identity: a source checkout keeps its runtime at `lib/` and an
# installed project at `bin/.devbin/lib/`, and both are legal sources.
_source_rels() {
  local srcroot="$1" paths="$2" rel abs
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    abs="$(vendor_source_path "$srcroot" "$rel")" || continue
    printf '%s\n' "${abs#"$srcroot"/}"
  done <<EOF
$paths
EOF
  return 0
}

# devbin_version_of <root> -- which devbin a tree carries.
#
# Two cases, told apart by whether the runtime is vendored. INSTALLED: the
# manifest header, stamped by the devbin that did the installing -- the tree's
# own VERSION is that PROJECT's version and says nothing about the framework. A
# source CHECKOUT: its VERSION, which is devbin's, because devbin is the
# project there.
#
# The alternative -- a `lib/VERSION` stamped into the vendored copy -- would put
# devbin's version in two files in the source repo, which is the drift D23 was
# written about. This costs one branch and no new file.
devbin_version_of() {
  local root="$1" v=""
  if is_devbin_installed "$root"; then
    v="$(manifest_version "$root" 2>/dev/null)" || v=""
  fi
  [ -n "$v" ] || v="$(read_version "$root/VERSION" version-file)"
  printf '%s\n' "$v"
}

# devbin_runtime_version -- which devbin is RUNNING right now.
#
# One call, not a second implementation: `is_devbin_installed $PROJECT_ROOT` and
# the dispatcher's `DEVBIN_LIB = $DEVBIN_DIR/lib` are the same question, because
# the dispatcher picks the vendored lib exactly when it exists.
devbin_runtime_version() { devbin_version_of "${PROJECT_ROOT:-.}"; }

# version_satisfies <version> <constraint> -- does <version> meet the config's
# `devbin_version:` declaration?
#
# Three forms, which is all the config subset needs:
#
#   ^X.Y.Z   same major, and at least X.Y.Z          (the usual)
#   >=X.Y.Z  at least X.Y.Z, any major
#   X.Y.Z    exactly
#
# A caret on 0.x is treated the way semver's own text does NOT -- ^0.1.0 admits
# 0.2.0 here. Pre-1.0 devbin has no stability promise to encode either way, and
# the alternative pins every project to a patch series and makes `upgrade` a lie.
version_satisfies() {
  local v="$1" c="${2:-}" vmaj vmin vpat cmaj cmin cpat op="^" n
  # No constraint declared is satisfied by anything. Written the other way round
  # first, which made every declared constraint return 0 before it was read --
  # a check that passes without checking, three days after AC-04.13 said so.
  [ -z "$c" ] && return 0
  case "$c" in
    "^"*) op="^" c="${c#^}" ;;
    ">="*) op=">=" c="${c#>=}" ;;
    *) op="=" ;;
  esac
  IFS='.' read -r vmaj vmin vpat <<EOF
$v
EOF
  IFS='.' read -r cmaj cmin cpat <<EOF
$c
EOF
  # Each part checked SEPARATELY, not as one concatenation: `0.1` splits to an
  # empty patch, and an empty field vanishes into the joined string while still
  # blowing up `[ "" -ge 0 ]` further down. An unparseable version -- `unknown`,
  # what read_version returns when it finds nothing -- fails here, which is the
  # answer doctor wants.
  for n in "$vmaj" "$vmin" "$vpat" "$cmaj" "$cmin" "$cpat"; do
    case "$n" in '' | *[!0-9]*) return 1 ;; esac
  done
  case "$op" in
    "=") [ "$v" = "$c" ] && return 0 ;;
    "^")
      [ "$vmaj" -eq "$cmaj" ] || return 1
      [ "$vmin" -gt "$cmin" ] && return 0
      [ "$vmin" -eq "$cmin" ] && [ "$vpat" -ge "$cpat" ] && return 0
      ;;
    ">=")
      [ "$vmaj" -gt "$cmaj" ] && return 0
      [ "$vmaj" -lt "$cmaj" ] && return 1
      [ "$vmin" -gt "$cmin" ] && return 0
      [ "$vmin" -lt "$cmin" ] && return 1
      [ "$vpat" -ge "$cpat" ] && return 0
      ;;
  esac
  return 1
}
