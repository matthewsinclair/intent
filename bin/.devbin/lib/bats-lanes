#!/usr/bin/env bash
#
# lib/bats-lanes <test directory> -- a bats suite, run in two lanes (issue 0190).
#
# EXECUTED, NEVER SOURCED: it prints, and exits with the run's one verdict.
# `test shell` runs it over the project's tests/ when it is handed nothing for
# bats, which is what `test all` hands it (lib/cmd/test), and through run_gate,
# so the run is sealed like any gate. A project whose suite has a runner of its
# own calls it in place of bats, the same way, from any command devbin runs,
# since the dispatcher exports DEVBIN_LIB to every one (issue 0339):
#
#   "$DEVBIN_LIB/bats-lanes" <test directory>
#
# IT READS THE DIRECTORY WHERE IT IS CALLED, and never changes to the project
# root: a runner may drop PROJECT_ROOT before it starts its suite. So a caller
# hands it a directory it can read from where it stands, and devbin's own
# callers hand it an absolute one. Every variable the caller exports reaches
# bats in both lanes, which is how a runner gives its suite what it needs, such
# as a BATS_LIB_PATH.
#
# A SUITE RUN ONE TEST AT A TIME leaves every core but one idle. Where each test
# runs in its own temp directory, writes nothing into the checkout and depends
# on no other, bats can run them side by side, through GNU parallel.
#
# THE PARALLEL LANE runs every test NOT tagged `serial`, N at a time:
# `bats --jobs N --filter-tags '!serial'`. THE SERIAL LANE runs the tests that
# ARE tagged serial afterwards, one at a time, with nothing else of this run
# beside them: a test that cannot share a host, or whose wall-clock margins
# contention can eat, goes there, and its tag line gives the reason. A test is
# tagged on the line before it, and every test of a file by a file tag:
#
#   # bats test_tags=serial
#   # bats file_tags=serial
#
# ONE VERDICT. The exit is non-zero when either lane fails, and when the two
# lanes did not run every test exactly once between them. The second is counted
# here, not assumed: what ran is counted with the counter the seal uses, and
# held against an untagged `bats --count` taken while the parallel lane runs. So
# a lane that lost a test fails the run whatever lost it -- a tag bats read
# differently, a filter mistyped here, a file the serial lane was not given.
#
# ONE LANE, AS BEFORE 0190, when GNU parallel is not installed or
# DEVBIN_TEST_JOBS is 1: `bats <dir>` runs everything one test at a time, and the
# first line of the run says why.
#
# N IS PRINTED ON THE FIRST LINE and DEVBIN_TEST_JOBS sets it, else DEVBIN_JOBS,
# a shared desk's one cap for every tool a run starts (issue 0303): a whole
# number, or `all` for one test per CPU the machine has. The default is half
# the CPUs and never fewer than _LANES_JOBS_FLOOR (issue 0340), more tests at
# once than most machines have CPUs: a lane's tests spend most of their time
# waiting, for their own processes and for bats, which looks for a free slot
# once a second. A four-CPU host ran the lane about four times as fast at
# sixteen to twenty-four at once as at two, and a sixteen-CPU macOS host ran it
# fastest at twenty-four; past that, more at once only added contention. Half
# the CPUs counts only on a machine with more than twice the floor's. `all`
# counts with cpu_probe, refusing rather than guessing when nothing can count
# (ST0011 WP-04).
#
# BATS 1.12 AND 1.14 BOTH RUN THIS, and they differ where it matters: on a
# selection of no tests, 1.12 prints `1..0` and exits 0 while 1.14 exits 1 and
# offers --allow-empty-suite, which 1.12 does not know. So an empty serial lane
# is never run at all.
#
# EACH FILE'S WALL TIME IS RECORDED, AND THE LOAD AT EACH END OF THE RUN, so
# a run's log names the files that cost it its time and what the machine was
# doing. bats records neither: it runs the parallel lane's files under GNU
# parallel with --keep-order, which holds each file's results until every
# earlier file has printed, and keeps no time of its own. So this runner takes
# the place of the parallel program bats runs, through bats's own
# BATS_PARALLEL_BINARY_NAME, and hands GNU parallel each file's command behind
# a recorder that writes the moment the file starts and the moment it ends.
# The run's results pass through untouched. Every bats this runner supports
# (1.12 and 1.14) starts each file as `bats-exec-file ... <file> <test list>`
# after parallel's `--`; a command of any other shape is run as it is, and the
# run says it has no times. The serial lane is timed whole.
#
# A FILE THAT FAILED ONLY BECAUSE BATS LOST A PASSED TEST'S STATUS IS COUNTED
# GREEN, and the run says so. Its tests all printed ok, and its one failure is
# bash's `wait: pid N is not a child of this shell` (lanes_lost_status), which
# reached a red macOS run with every test ok. The recorder holds each file's
# output to read it, passes it on whole, and lets that file alone exit 0; any
# other failure, and any `not ok`, keeps its exit.
#
set -euo pipefail

# lanes_progress <record> <test list> <progress file> -- the parallel lane's
# progress as one line, written whole in place of the file's last: its files
# done of the files bats's test list names, the tests in them of the list's,
# and how many of its files are running. A file bats starts with no test of
# this lane in the list is no file of it. Written to a file beside the
# progress file and moved over it, so a reader never sees half a line.
lanes_progress() {
  LC_ALL=C awk -F '\t' '
    NR == FNR { tests[$1]++; all++; next }
    $1 == "start" { started[$3] = 1 }
    $1 == "end" { ended[$3] = 1 }
    END {
      for (f in tests) files++
      for (f in ended) if (f in tests) { done++; passed += tests[f] }
      for (f in started) if ((f in tests) && !(f in ended)) running++
      printf "the parallel lane: %d of %d files done (%d of %d tests), %d running\n", done, files, passed, all, running
    }
  ' "$2" "$1" >"$3.$$" 2>/dev/null && mv -f "$3.$$" "$3" 2>/dev/null
  rm -f "$3.$$"
  return 0
}

# lanes_lost_status <stdout> <stderr> <test list> <file> -- whether a file that
# exited non-zero failed only because bats lost a passed test's status: its
# stderr holds bash's `wait: pid N is not a child of this shell`, its stdout
# holds no `not ok`, and its `ok` lines are as many as the tests the list gives
# the file. Returns 1 for anything else, so every other failure stays one.
#
# BATS LOSES IT AT RANDOM, AND ON MACOS MOSTLY. Run N at a time within a file,
# a test that ends before an earlier one is reaped by bash, which keeps its
# status until bats waits for it in start order. Bash discards that status when
# a later fork is given the same pid, so the wait then fails and the file exits
# 1 though every test printed ok. A long suite wraps macOS's pids within a run;
# Linux's range is wide enough that it rarely does.
lanes_lost_status() {
  local want got
  grep -qE 'wait: pid [0-9]+ is not a child of this shell' "$2" || return 1
  ! grep -q '^not ok ' "$1" || return 1
  want="$(LC_ALL=C awk -F '\t' -v f="$4" '$1 == f { n++ } END { print n + 0 }' "$3")" || return 1
  got="$(grep -c '^ok ' "$1")" || return 1
  [ "$want" -gt 0 ] && [ "$got" -eq "$want" ]
}

# THE RECORDER'S TWO ROLES, taken before anything is sourced, since one runs
# once per file of the run. _LANES_AS_PARALLEL names the parallel program bats
# was going to run; it and the caller's own BATS_PARALLEL_BINARY_NAME are put
# back as they were for everything parallel starts, so a bats that a test runs
# never reaches the recorder.
if [ -n "${_LANES_AS_PARALLEL:-}" ]; then
  real="$_LANES_AS_PARALLEL"
  unset _LANES_AS_PARALLEL
  if [ -n "${_LANES_CALLER_PARALLEL+x}" ]; then
    export BATS_PARALLEL_BINARY_NAME="$_LANES_CALLER_PARALLEL"
  else
    unset BATS_PARALLEL_BINARY_NAME
  fi
  unset _LANES_CALLER_PARALLEL
  # A call with no -- is not a run (bats asks for --version first), and one
  # whose command is not bats-exec-file is run as it is, its run untimed.
  args=() shape="none"
  while [ $# -gt 0 ]; do
    if [ "$1" = -- ] && [ "$shape" = none ]; then
      shape="other"
      if [ "${2:-}" = bats-exec-file ]; then
        # parallel reads what follows -- as shell words, unquoted, so the
        # recorder's path is quoted here.
        args+=(-- "$(printf '%q' "$0")" --lanes-record-file)
        shape="file"
        shift
        continue
      fi
    fi
    args+=("$1")
    shift
  done
  [ "$shape" != other ] || [ -z "${_LANES_RECORD:-}" ] || printf 'shape\n' >>"$_LANES_RECORD"
  exec "$real" "${args[@]}"
fi
if [ "${1:-}" = --lanes-record-file ]; then
  shift
  rec="${_LANES_RECORD:-}" prog="${_LANES_PROGRESS:-}"
  unset _LANES_RECORD _LANES_PROGRESS
  [ $# -ge 2 ] || exec "$@"
  file="${*: -2:1}"
  list="${*: -1}"
  [ -z "$rec" ] || printf 'start\t%s\t%s\t%s\n' "${EPOCHREALTIME//[!0-9]/}" "$file" "$list" >>"$rec"
  [ -z "$rec" ] || [ -z "$prog" ] || lanes_progress "$rec" "$list" "$prog"
  # THE FILE'S OUTPUT IS HELD AND THEN PASSED ON WHOLE, its stdout and then its
  # stderr, as GNU parallel's grouping passes on every job's: so the recorder
  # can read a failed file's results before it says what the file exited, and
  # a file whose only failure is a status bats lost (lanes_lost_status) is
  # recorded as lost and exits 0. With no record, or nowhere to hold it, the
  # file runs as it is.
  rc=0 kept=""
  if [ -n "$rec" ] && kept="$(mktemp -d "${rec%/*}/file.XXXXXX")"; then
    "$@" >"$kept/out" 2>"$kept/err" || rc=$?
    cat "$kept/out"
    cat "$kept/err" >&2
  else
    kept=""
    "$@" || rc=$?
  fi
  [ -z "$rec" ] || printf 'end\t%s\t%s\t%s\n' "${EPOCHREALTIME//[!0-9]/}" "$file" "$rc" >>"$rec"
  if [ "$rc" -ne 0 ] && [ -n "$kept" ] && lanes_lost_status "$kept/out" "$kept/err" "$list" "$file"; then
    printf 'lost\t%s\t%s\n' "$file" "$rc" >>"$rec"
    rc=0
  fi
  [ -z "$kept" ] || rm -rf "$kept"
  [ -z "$rec" ] || [ -z "$prog" ] || lanes_progress "$rec" "$list" "$prog"
  exit "$rc"
fi

# shellcheck source=lib/helpers
. "${DEVBIN_LIB:?run me through bin/devbin}/helpers"
# shellcheck source=lib/runlog
. "${DEVBIN_LIB}/runlog"

# The line bats reads as a test's tags (bats-preprocess), naming `serial` as
# one of them. Matching more than bats would tag costs nothing, since bats
# itself decides which tests run; matching less is caught by the count.
_LANES_SERIAL_TAG='^[[:blank:]]*#[[:blank:]]*bats[[:blank:]]+(test|file)_tags=(.*,)?[[:blank:]]*serial[[:blank:]]*(,.*)?$'

# The fewest tests the parallel lane runs at once by default, however few the
# CPUs (issue 0340). It is written here and nowhere else, and the lanes' arms
# read it from this line.
_LANES_JOBS_FLOOR=24

# lanes_jobs <cpus> <setting> -- how many tests the parallel lane runs at once:
# <setting> when it is given, which must be a whole number of at least 1, else
# half of <cpus> and never fewer than _LANES_JOBS_FLOOR. Returns 1 for a
# setting it cannot use. `all` never reaches it: the caller reads it once, as
# the probe's count.
lanes_jobs() {
  local cpus="$1" set="$2" n
  if [ -n "$set" ]; then
    [[ "$set" =~ ^[1-9][0-9]*$ ]] || return 1
    printf '%s\n' "$set"
    return 0
  fi
  n=$((cpus / 2))
  [ "$n" -ge "$_LANES_JOBS_FLOOR" ] || n="$_LANES_JOBS_FLOOR"
  printf '%s\n' "$n"
}

# gnu_parallel_version <program> -- the first line of `<program> --version` when
# <program> is GNU parallel, as bats --jobs needs; returns 1 otherwise. A
# moreutils `parallel` is a different program under the same name.
gnu_parallel_version() {
  local v
  v="$("$1" --version 2>/dev/null </dev/null)" || return 1
  v="${v%%$'\n'*}"
  case "$v" in
    "GNU parallel "*) printf '%s\n' "$v" ;;
    *) return 1 ;;
  esac
}

# serial_files <dir> -- the suite's files that carry a serial tag, one per
# line, in the order bats runs a directory's files. The serial lane is handed
# these rather than the whole directory because bats preprocesses every file it
# is given before it runs one, which costs about 9 s for the whole suite here.
# Returns 1 when a file could not be read.
serial_files() {
  local f rc
  for f in "$1"/*.bats; do
    [ -e "$f" ] || continue
    rc=0
    grep -qE "$_LANES_SERIAL_TAG" "$f" || rc=$?
    case "$rc" in
      0) printf '%s\n' "$f" ;;
      1) ;;
      *) return 1 ;;
    esac
  done
}

# tap_plan <tap> -- the count in the first plan line (`1..N`) of a TAP stream,
# or nothing when it has none.
tap_plan() {
  log_awk '/^1\.\.[0-9]+$/ { sub(/^1\.\./, ""); print; exit }' "$1"
}

# tap_ran <tap> -- how many tests a TAP stream reports, by the seal's own
# counter (count_for, lib/runlog), so this cannot disagree with the seal about
# what ran. A stream with no plan line counts 0.
tap_ran() {
  local n
  n="$(log_awk "$(count_for shell)" "$1")"
  printf '%s\n' "${n:-0}"
}

# lane <tap> <command> [args...] -- run one lane, its output to this run's
# stdout and a copy to <tap> for counting; returns the command's own status.
lane() {
  local tap="$1"
  local -a rcs
  shift
  "$@" | tee "$tap"
  rcs=("${PIPESTATUS[@]}")
  [ "${rcs[1]}" -eq 0 ] ||
    warn "lanes: could not keep a copy of this lane's output in $tap, so its tests will not be counted"
  return "${rcs[0]}"
}

# lanes_load -- the machine's load average over the last minute, as the
# kernel reports it (/proc/loadavg on Linux, vm.loadavg on macOS), or
# `unknown` where neither answers.
lanes_load() {
  local l=""
  if [ -r /proc/loadavg ]; then
    read -r l _ </proc/loadavg || l=""
  elif l="$(sysctl -n vm.loadavg 2>/dev/null)"; then
    l="${l#"{ "}"
    l="${l%% *}"
  fi
  printf '%s\n' "${l:-unknown}"
}

# lanes_times <record> <dir> -- the recorder's lines as one line per file, the
# slowest first: its wall time in seconds to a tenth, its path under <dir>
# (bats names each file by an absolute path, read here as the shell and the
# filesystem each spell <dir>),
# and its exit when that was not 0, or that it never ended. A file the recorder
# found had only lost a passed test's status says so beside its exit. Prints
# nothing for a record that holds no file.
lanes_times() {
  local logical physical
  logical_dir "$2" logical 2>/dev/null || logical="$2"
  physical_dir "$2" physical || physical="$2"
  LC_ALL=C awk -F '\t' -v d1="$2/" -v d2="$logical/" -v d3="$physical/" '
    $1 == "start" { start[$3] = $2 }
    $1 == "end" { end[$3] = $2; rc[$3] = $4 }
    $1 == "lost" { lost[$2] = 1 }
    END {
      for (f in start) {
        name = f
        if (index(name, d2) == 1) name = substr(name, length(d2) + 1)
        else if (index(name, d3) == 1) name = substr(name, length(d3) + 1)
        else if (index(name, d1) == 1) name = substr(name, length(d1) + 1)
        if (f in end) {
          note = ""
          if (f in lost) note = " (exit " rc[f] ", bats lost the status of a test that passed: counted green)"
          else if (rc[f] != 0) note = " (exit " rc[f] ")"
          printf "%d\t%.1fs\t%s%s\n", end[f] - start[f], (end[f] - start[f]) / 1000000, name, note
        } else {
          printf "%d\tno end\t%s (it never ended)\n", -1, name
        }
      }
    }
  ' "$1" | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr | LC_ALL=C cut -f 2-
}

dir="${1:?usage: bats-lanes <test directory>}"
# THE GATE'S PROGRESS FILE, when run_gate gave one, is this run's to write and
# never a run's that a test starts: it is read here and taken out of
# everything this run starts, then handed to the recorder by a name of its own.
progress="${DEVBIN_GATE_PROGRESS:-}"
unset DEVBIN_GATE_PROGRESS
# `all` IS EVERY CPU THE PROBE COUNTS, never cpu_count's guess of 4: a runner
# whose CPUs cannot be counted is refused, naming the setting, rather than run
# at a number nobody measured. It is read here once, and is the probe's count
# from here on; `every` remembers it was asked for.
#
# DEVBIN_TEST_JOBS, ELSE DEVBIN_JOBS (issue 0303): a desk that caps every tool
# a run starts sets DEVBIN_JOBS once, and the suite takes it where its own
# setting is unset, which still wins. `var` is the one read, named by every
# line below that names the setting.
var=DEVBIN_TEST_JOBS
setting="${DEVBIN_TEST_JOBS:-}"
if [ -z "$setting" ] && [ -n "${DEVBIN_JOBS:-}" ]; then
  var=DEVBIN_JOBS
  setting="$DEVBIN_JOBS"
fi
every=no
if [ "$setting" = all ]; then
  cpus="$(cpu_probe)" ||
    die "$var is 'all', and neither nproc nor getconf could count this machine's CPUs, so every CPU is no number -- set a whole number of jobs instead"
  setting="$cpus"
  every=yes
else
  cpus="$(cpu_count)"
fi
jobs="$(lanes_jobs "$cpus" "$setting")" ||
  die "$var is '$setting', and it must be a whole number of jobs, 1 or more, or all"

# The program bats --jobs will run, by bats's own setting, so what is probed
# here is what bats runs.
parallel_program="${BATS_PARALLEL_BINARY_NAME:-parallel}"
why="" version=""
if [ "$jobs" -eq 1 ] && [ "$every" = yes ]; then
  why="$var is all, and this machine has one CPU"
elif [ "$jobs" -eq 1 ]; then
  why="$var is 1"
elif ! command -v "$parallel_program" >/dev/null 2>&1; then
  why="GNU parallel is not installed: there is no $parallel_program on PATH (brew install parallel, or apt-get install parallel)"
elif ! version="$(gnu_parallel_version "$parallel_program")"; then
  why="the $parallel_program on PATH, $(command -v "$parallel_program"), is not GNU parallel"
fi

if [ -n "$why" ]; then
  printf 'lanes: one, serial, because %s: every test runs one at a time\n' "$why"
  exec bats "$dir"
fi

printf 'lanes: two. First %s tests at a time under %s (%s CPUs here; %s sets the number), then the tests tagged serial, one at a time\n' \
  "$jobs" "$version" "$cpus" "$var"
load_start="$(lanes_load)"

scratch="$(mktemp -d "${TMPDIR:-/tmp}/devbin-lanes.XXXXXX")" || die "lanes: cannot make a scratch directory"
# shellcheck disable=SC2064 # the path is fixed now, on purpose
trap "rm -rf '$scratch'" EXIT

# THE DENOMINATOR, untagged, counted beside the parallel lane rather than
# before it: the count preprocesses the whole suite too, which is seconds.
bats --count "$dir" >"$scratch/count" 2>"$scratch/count.err" &
count_pid=$!

# EACH LANE'S OWN STATUS IS KEPT AND NAMED when it is not 0: a lane can fail
# with no `not ok` line to show for it, and the last line here is what the
# seal's log tail shows of such a run.
rc_one=0 rc_two=0
# THE PARALLEL LANE RUNS BEHIND THE RECORDER (the header): bats runs this
# file as its parallel program, which hands GNU parallel each file's command
# behind the recorder, and the record is read once the lane ends.
self_dir=""
physical_dir "$(dirname "${BASH_SOURCE[0]}")" self_dir || die "lanes: cannot read the directory this runner is in, $(dirname "${BASH_SOURCE[0]}")"
self="$self_dir/$(basename "${BASH_SOURCE[0]}")"
: >"$scratch/record"
(
  [ -z "${BATS_PARALLEL_BINARY_NAME+x}" ] || export _LANES_CALLER_PARALLEL="$BATS_PARALLEL_BINARY_NAME"
  export _LANES_AS_PARALLEL="$parallel_program" _LANES_RECORD="$scratch/record" BATS_PARALLEL_BINARY_NAME="$self"
  [ -z "$progress" ] || export _LANES_PROGRESS="$progress"
  lane "$scratch/one" bats --jobs "$jobs" --filter-tags '!serial' "$dir"
) || rc_one=$?

total=""
if wait "$count_pid"; then
  total="$(<"$scratch/count")"
fi
if ! [[ "$total" =~ ^[0-9]+$ ]]; then
  printf '\nlanes: bats --count %s gave no count, so this run cannot show that every test ran: %s\n' \
    "$dir" "$(<"$scratch/count.err")"
  exit 1
fi

planned="$(tap_plan "$scratch/one")"
if [ -z "$planned" ]; then
  printf '\nlanes: the parallel lane printed no plan and exited %s, so it never ran, and the serial lane is not run either\n' "$rc_one"
  exit 1
fi

: >"$scratch/two"
serial=$((total - planned))
if [ "$serial" -le 0 ]; then
  printf '\nlanes: no test is tagged serial, so there is no serial lane\n'
else
  if ! serial_files "$dir" >"$scratch/serial"; then
    printf '\nlanes: a file in %s could not be read for its serial tags\n' "$dir"
    exit 1
  fi
  files=()
  mapfile -t files <"$scratch/serial"
  if [ "${#files[@]}" -eq 0 ]; then
    printf '\nlanes: bats counts %s test(s) outside the parallel lane, but no file in %s carries a serial tag\n' "$serial" "$dir"
    exit 1
  fi
  printf '\nlanes: the serial lane, %s test(s), one at a time\n' "$serial"
  [ -z "$progress" ] || printf 'the serial lane: %s test(s), one at a time\n' "$serial" >"$progress" 2>/dev/null || true
  two_start="${EPOCHREALTIME//[!0-9]/}"
  lane "$scratch/two" bats --jobs 1 --filter-tags serial "${files[@]}" || rc_two=$?
  two_took=$(((${EPOCHREALTIME//[!0-9]/} - two_start) / 100000))
fi

# THE TIMES, before the verdict, which stays the run's last line. The lanes
# have ended, so the progress they wrote says nothing more.
[ -z "$progress" ] || : >"$progress" 2>/dev/null || true
times="$(lanes_times "$scratch/record" "$dir")"
if grep -qx shape "$scratch/record"; then
  printf '\nlanes: no time per file: this bats starts its files in a way the recorder does not know\n'
elif [ -z "$times" ]; then
  printf '\nlanes: no time per file: the recorder saw no file start\n'
else
  printf '\nlanes: the %s file(s) of the parallel lane by wall time, the slowest first:\n' "$(grep -c . <<<"$times")"
  while IFS=$'\t' read -r took name; do
    printf 'lanes:   %8s  %s\n' "$took" "$name"
  done <<<"$times"
fi
[ -z "${two_took:-}" ] || printf 'lanes: the serial lane took %s.%ss\n' "$((two_took / 10))" "$((two_took % 10))"
printf 'lanes: load %s at the start and %s at the end, the one-minute average, on %s CPUs\n' "$load_start" "$(lanes_load)" "$cpus"
# A FILE COUNTED GREEN DESPITE ITS EXIT IS SAID, before the verdict: the times
# above name it, and this line says why its exit did not fail the run.
lost="$(grep -c '^lost	' "$scratch/record")" || lost=0
[ "$lost" -eq 0 ] ||
  printf 'lanes: %s file(s) exited non-zero only because bats lost the status of a test that passed, when bash gave its process id to a later one; every test of each printed ok, so each is counted green (marked above)\n' "$lost"

failed=""
[ "$rc_one" -eq 0 ] || failed+="; the parallel lane exited $rc_one"
[ "$rc_two" -eq 0 ] || failed+="; the serial lane exited $rc_two"
one="$(tap_ran "$scratch/one")"
two="$(tap_ran "$scratch/two")"
if [ "$((one + two))" -ne "$total" ]; then
  printf '\nlanes: %s test(s) ran in parallel and %s serially, %s in all, but bats counts %s in %s: the lanes did not run every test exactly once%s\n' \
    "$one" "$two" "$((one + two))" "$total" "$dir" "$failed"
  # bats reports a failed setup_file or teardown_file as a record of its own,
  # which the count above includes, so on a red lane it can stand for one.
  [ -z "$failed" ] ||
    printf 'lanes: a lane that fails in setup_file or teardown_file adds a record for it, which this count includes\n'
  exit 1
fi
printf '\nlanes: %s test(s) ran in parallel and %s serially, all %s that bats counts in %s, each once%s\n' \
  "$one" "$two" "$total" "$dir" "$failed"
[ -z "$failed" ] || exit 1
exit 0
