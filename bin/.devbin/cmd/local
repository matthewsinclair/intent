#!/usr/bin/env bash
#
# devbin: summary = The v3 install on THIS machine -- bindings and the guarded build
# devbin: args = <status|build>
# bin/devbin local <status|build>
#   status             every `intent` binding, PATH order, plus pair currency and store health
#   build              the guarded release build, the same path as `build all`
#
# `install`, `use` and `uninstall` retired with ST0087 WP-04: the links in
# ~/.local/bin are `intent use`'s alone (the contract's T5), and `intent use
# dev|opt|brew` moves them.
#
#
# WHY `status` EXISTS, AND IT IS THE REASON FOR THE WHOLE COMMAND. On 2026-08-21
# this estate's own record undercounted the `intent` bindings:
# `~/.local/bin/intent` and `~/bin/intent` were both symlinks to the same v2
# tree, made in the same minute, and only one of them was written down anywhere.
# A design that repoints "the symlink" moves one of two, and deleting the
# recorded one hands resolution to the unrecorded one, which still answers v2 --
# silently, at exit 0. NOTHING ON THIS MACHINE COULD LIST THEM, so the list was
# maintained by memory and memory was wrong. This is that instrument, and it is
# read-only so there is never a reason not to run it.
#
# AND THE FACT IT EXISTS TO PRINT: `INTENT_HOME` HAS NO AUTHORITY OVER v3.
# Driven three ways -- exported, unset, and forced to a junk path -- the v3
# binary answers the same every time. The var is the strongest of v2's bindings
# and it is INERT for v3, so anyone reading it as the rail that keeps v3 away
# from the other projects on this machine is reading a rail that is not there.
# v3's actual gate is the version declared in the project's own config, which
# refuses every 2.x string measured. Two locks, and this prints the one people
# wrongly believe in so the belief cannot survive looking.
#
# WHY `build` IS NOT `cargo build --release`. That command once returned 0 over
# a pair built from TWO DIFFERENT TREES. Measured here: `cargo build --release`
# and the then-unguarded `int build all` both reported `Finished` while `intent`
# named the current HEAD and `intentd` named a `dirty-` sha from two days
# earlier, because each binary's source-commit build script re-ran only on
# changes inside its own package.
#
# `native/rust/build-support/source_commit.rs` now re-runs on any tracked path
# under its DIRT_SCOPE (issue 0285), so both halves move together, and it
# records the residual: a tree built dirty and then committed with no further
# in-scope edit keeps its `dirty-<old>` marker. Cargo still reasons per
# package, and coherence is a property of the SET, so the force (`cargo clean`
# of both packages) and the pair verification belong HERE, outside cargo, at
# the moment someone wants artefacts to install.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"
# The marker reader, project-owned. See the file for why it is not in lib/helpers.
. "$(dirname "${BASH_SOURCE[0]}")/shared/artefact.lib"
. "$(dirname "${BASH_SOURCE[0]}")/shared/sharedtarget.lib"
# The pair-agreement reader `verify_pair` delegates to.
. "$(dirname "${BASH_SOURCE[0]}")/shared/currency.lib"
# THE one guarded release build, and `verify_pair`. Both used to live in this
# file, which is how the other entrances came to write the shared artefact
# without them.
. "$(dirname "${BASH_SOURCE[0]}")/shared/releasebuild.lib"
. "$(dirname "${BASH_SOURCE[0]}")/shared/runtime.lib"

# RELEASE_DIR and PRIVATE_RELEASE_DIR live in releasebuild.lib, sourced above.
# path_hits <name> -- every executable of <name> on PATH, as "<position>\t<path>".
#
# Walks PATH itself rather than asking `which -a`, because the POSITION is the
# whole answer: which binding wins is decided by order, and a bare list of paths
# cannot say. Ties are impossible; earlier always wins.
path_hits() {
  local name="$1" i=0 d
  local OLDIFS="$IFS"
  IFS=:
  for d in $PATH; do
    i=$((i + 1))
    [ -n "$d" ] || continue
    if [ -x "$d/$name" ] && [ ! -d "$d/$name" ]; then
      printf '%s\t%s\n' "$i" "$d/$name"
    fi
  done
  IFS="$OLDIFS"
}

# describe_binding <path> -- one line: where it really goes, and which line it is.
describe_binding() {
  # TWO `local`s, NOT ONE. Under `set -u` a same-statement `target="$f"` reads
  # `f` before the assignment has taken effect and dies `unbound variable` --
  # SC2318, latent here since this function was written and reached for the
  # first time by `use_flavour` calling it inside a command substitution.
  local f="$1"
  local target="$f" kind="file"
  if [ -L "$f" ]; then
    kind="symlink"
    target="$(readlink "$f")"
    case "$target" in
      /*) ;;
      *) target="$(cd "$(dirname "$f")" && cd "$(dirname "$target")" && pwd)/$(basename "$target")" ;;
    esac
  fi
  # THE COLUMN ASKS WHICH INTENT YOU GET, NOT WHAT THE FILE IS. Those differ for
  # a wrapper: `bin/intent3` WAS a bash script that got you v3 (retired
  # 2026-08-27, but a stale symlink to it may still exist), so classifying by
  # `file` alone prints a true fact under a label that means something else --
  # the same shape this command exists to expose one level up.
  local line="v2 (bash)"
  case "$(file -b "$target" 2>/dev/null)" in
    *Mach-O*) line="v3 (native)" ;;
    *)
      if grep -q 'native/rust/target/release' "$target" 2>/dev/null; then
        line="v3 (wrapper)"
      fi
      ;;
  esac
  printf '%s\t%s\t%s' "$kind" "$target" "$line"
}

cmd_status() {
  local name n=0 pos f kind target line first_shown

  step "intent bindings on this machine, in PATH order (first one wins)"
  # THE RETIRED NAMES STAY IN THIS SCAN DELIBERATELY. `intent3`/`intentd3` are
  # no longer minted by anything, but a machine that ran the long-retired
  # `int local install` still HAS them, pointing straight at the release dir
  # with no coherence guard. Dropping them from the scan would make this
  # command stop reporting the exact leftover it exists to surface.
  for name in intent intent3 intentd intentd3; do
    first_shown=""
    while IFS="$(printf '\t')" read -r pos f; do
      [ -n "$pos" ] || continue
      n=$((n + 1))
      IFS="$(printf '\t')" read -r kind target line <<EOF
$(describe_binding "$f")
EOF
      if [ -z "$first_shown" ]; then
        first_shown=yes
        printf '    %-10s PATH %-3s %-42s WINS   -> %s  [%s]\n' "$name" "$pos" "$f" "$target" "$line"
      else
        printf '    %-10s PATH %-3s %-42s shadow -> %s  [%s]\n' "$name" "$pos" "$f" "$target" "$line"
      fi
    done <<EOF
$(path_hits "$name")
EOF
    [ -n "$first_shown" ] || printf '    %-10s not on PATH\n' "$name"
  done
  [ "$n" -gt 0 ] || warn "no intent binding of any name is on PATH"

  step "INTENT_HOME"
  printf '    exported: %s\n' "${INTENT_HOME:-<unset>}"
  printf '    INERT FOR v3. Driven exported, unset and forced to a junk path: the v3\n'
  printf '    binary answers the same every time. It binds v2 only. v3 is gated by the\n'
  printf "    version declared in each project's own config, which refuses every 2.x.\n"

  step "the tool tree -- a fact about this machine, not about where you are standing"
  # WHAT THIS REPLACES, AND WHY THE OBVIOUS VERSION WAS UNSHIPPABLE. I first wrote
  # this as "is THIS tree the tool?", comparing PROJECT_ROOT to INTENT_HOME. **It
  # could never fire.** `PROJECT_ROOT` in a devbin command is derived from the
  # COMMAND's own location, not from cwd -- the same trap already recorded here
  # about `int hooks` answering about the wrong repo -- so it compared a constant
  # to a constant and printed `consumer` from inside the tool tree itself. Driven
  # from both checkouts, which is the only reason it was caught.
  #
  # THE HAZARD IS REAL EVEN THOUGH THAT CHECK WAS NOT. `Intentv2` carries
  # `intent/.config/config.json`, so every census keyed on config presence finds
  # it -- and it sits at the migration floor, clean and small, which makes it look
  # like the ideal canary and makes it the worst possible target: it was the CLI
  # the v2 projects RAN (vc's census, 2026-08-21, which could not tell a consumer
  # from the tool -- no config-presence census can).
  #
  # `lib/templates/` is NOT the discriminator: this v3 checkout has it and is a
  # legitimate consumer, self-hosted. The discriminator is whether a tree is the
  # one INTENT_HOME NAMES, because INTENT_HOME is what binds v2, and that is
  # exactly what makes migrating it break every v2 project still using it.
  # Stated here as a machine fact so a census-writer meets it; the per-project
  # test belongs in the census.
  local home_real
  home_real="$(cd "${INTENT_HOME:-/nonexistent}" 2>/dev/null && pwd -P || echo '<unresolved>')"
  printf '    INTENT_HOME names %s\n' "$home_real"
  printf '    THAT TREE IS THE TOOL OTHER PROJECTS RUN. NEVER MIGRATE IT.\n'
  printf '    It carries a project config, so every census finds it as a project.\n'
  printf '    It is not one. Migrating it takes the CLI away from everything else.\n'

  step "this checkout's release pair"
  local b named mrc
  for b in intent intentd; do
    if [ -f "$RELEASE_DIR/$b" ]; then
      mrc=0
      named="$(artefact_source_commit "$RELEASE_DIR/$b")" || mrc=$?
      case "$mrc" in
        0) ;;
        1) named='<no marker>' ;;
        *) exit 2 ;;
      esac
      printf '    %-8s %s\n' "$b" "$named"
    else
      printf '    %-8s not built\n' "$b"
    fi
  done
  printf '    HEAD     %s\n' "$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || echo '<no git>')"

  # THE VERDICT, NOT THE TWO HASHES. This block printed the marker and HEAD and
  # stopped, leaving the reader to diff two 40-character strings by eye and
  # decide for themselves what a difference meant -- and a difference alone
  # means nothing: the marker is an ANCESTOR of the commit actually compiled in,
  # so an unequal pair is the NORMAL state of a working tree and only the
  # verdict separates that from a pair that is genuinely behind.
  #
  # `currency.lib` is ALREADY SOURCED at the top of this file and
  # `sharedtarget.lib` already declares the scopes the verdict needs, so this
  # was one call away the whole time. A capability with no consumer distinguishes
  # nothing (AT-11.5's finding, arriving here): the tool could answer a question
  # nothing on the typed route was asking it.
  #
  # WHY HERE AND NOWHERE ELSE ON THE TYPED ROUTE. Its other consumers are not
  # routes a person types to ask this: `bin/devbin cli` refuses on it, and
  # `self_provenance_check.sh` reports it at pre-commit. `~/.local/bin/intent`
  # is a symlink straight into the release directory and passes through nothing
  # at all. `local status` is the verb people type to ask WHAT AM I RUNNING,
  # which is this exact question, so the answer belongs in its output.
  #
  # IT REPORTS AND DOES NOT REFUSE, DELIBERATELY. `status` is read-only and
  # every caller reads its exit code as "did the status run", not as a verdict.
  # Enforcement stays where it already is. This is NOT the warn-and-continue
  # form `build.d/release` rules against in its own words -- *a fallback that
  # warns is a fallback that gets ignored* -- because nothing here is falling
  # back to a second-choice binary; the verdict is the whole product of the verb.
  local verdict
  verdict="$(artefact_currency_verdict "$RELEASE_DIR" "$PROJECT_ROOT" 2>/dev/null || echo 'refuse:the currency verdict could not be taken')"
  case "$verdict" in
    ok)
      printf '    currency ok -- the PATH pair under target/release describes the tree you are standing in\n' ;;
    warn:*)
      printf '    currency WARN (target/release) -- %s\n' "${verdict#warn:}" ;;
    refuse:*)
      printf '    currency REFUSING (target/release) -- %s\n' "${verdict#refuse:}"
      case "$verdict" in
        "refuse:${ARTEFACT_CURRENCY_UNREAD}"*) printf '    an actor on the exec path would refuse to run this pair.\n' ;;
        *) printf '    an actor on the exec path would refuse to run this pair. `bin/devbin build all` rebuilds it.\n' ;;
      esac
      ;;
    *)
      printf '    currency UNREADABLE -- the verdict was %s, which is not a form this renders\n' "$verdict" ;;
  esac

  # THE VERDICT ABOVE IS ABOUT ONE ARTEFACT AND THE UNQUALIFIED FORM MISLED
  # NODES WITHIN MINUTES OF LANDING (cc, 2026-09-09). It read `currency ok --
  # this pair describes the tree you are standing in`, which is true of the PATH
  # pair and says NOTHING about `target/debug/`. vc rebuilt the release pair
  # correctly, read the green, and told the other nodes that cc's
  # sibling-staleness failures would clear on a re-run. They could not: the
  # harness spawns `target/debug/intentd`, which was still an hour behind the
  # source, and the failures did not move. **Every statement in that chain was
  # true.**
  #
  # SO THE SCOPE IS PRINTED RATHER THAN IMPLIED, and the debug artefact is named
  # with the command that refreshes it. This is the same defect as `intent
  # --version` answering for the compiled half while being confidently wrong about
  # the scripted half: a currency claim is about ONE artefact, and naming the
  # artefact is the load-bearing part. A green here is the most authoritative-
  # looking thing the reader holds, so an unnamed scope is read as the whole tree.
  #
  # It prints unconditionally, under every verdict including `ok`, because the
  # green is the branch that gets over-read -- a limit attached only to the
  # refusal would be absent exactly when it is needed.
  local dbg="$PROJECT_ROOT/native/rust/target/debug/intentd"
  if [ -f "$dbg" ]; then
    printf '    scope: this verdict examined target/release ONLY. `target/debug/` is a SECOND artefact\n'
    printf '           and it is the one the test harness spawns -- `cargo build -p intentd` refreshes it.\n'
    mrc=0
    named="$(artefact_source_commit "$dbg")" || mrc=$?
    case "$mrc" in
      0) ;;
      1) named='<no marker>' ;;
      *) exit 2 ;;
    esac
    printf '           debug intentd names %s\n' "$named"
  fi

  # **THE SCOPE BLOCK ABOVE NAMED `target/debug/` AND MEASURED NOTHING ABOUT IT
  # UNTIL 2026-09-10.** On 2026-09-09 this machine carried a crowd of leaked
  # `intentd` processes burning CPU for hours, a WAL many times the size of its
  # database and a runaway load average; nodes lost writes. Nothing in the
  # estate reported any of it (shared/runtime.lib has the detail). A door that
  # names an artefact and does not measure it is the gate-figure defect in a
  # different costume, so it measures it now.
  printf '\n==> what is running against this project, and what its store weighs\n'

  local daemons holders dbf walf verdict
  daemons="$(runtime_daemons)"
  printf '    intentd processes  %s  (matched on the EXECUTABLE, never the command line)\n' \
    "$(printf '%s' "$daemons" | runtime_count)"
  if [ -n "$daemons" ]; then
    printf '%s\n' "$daemons" | while IFS="$(printf '\t')" read -r pid exe; do
      printf '      pid %-8s %s\n' "$pid" "$exe"
    done
  fi

  dbf="$PROJECT_ROOT/intent/.cache/intent.db"
  holders="$(runtime_store_holders "$dbf")"
  printf '    store holders      %s  (a SEPARATE number: these are the ones that cost writes)\n' \
    "$(printf '%s' "$holders" | runtime_count)"

  walf="$dbf-wal"
  printf '    store              db %s bytes, WAL %s bytes\n' \
    "$(runtime_bytes "$dbf")" "$(runtime_bytes "$walf")"
  verdict="$(runtime_footprint_verdict "$(runtime_bytes "$dbf")" "$(runtime_bytes "$walf")")"
  case "$verdict" in
    ok) printf '    footprint ok -- the WAL is a fraction of the database, so checkpoints are landing\n' ;;
    warn:*) printf '    footprint WARN -- %s\n' "${verdict#warn:}" ;;
    refuse:*) printf '    footprint REFUSING -- %s\n' "${verdict#refuse:}" ;;
    *) printf '    footprint UNREADABLE -- the verdict was %s\n' "$verdict" ;;
  esac

  # **AND THE DISCRIMINATOR, BECAUSE `intent daemon status` FAILS IN THE
  # REASSURING DIRECTION AND THAT IS HOW THE LEAK SURVIVED A DAY.** It asks THIS
  # project's socket address. A harness-spawned daemon binds under its own
  # isolated HOME, so it is a correct singleton for a DIFFERENT address and
  # answers nothing here. Measured 2026-09-10: live `target/debug/intentd`
  # processes on this machine while `daemon status` said `no intentd is
  # answering`. BOTH ANSWERS WERE TRUE AND THEY ANSWER DIFFERENT QUESTIONS -- a
  # node reading only the socket concludes the machine is clean.
  printf '    NOTE: `intent daemon status` asks THIS project'"'"'s socket. A leaked or harness-spawned\n'
  printf '          daemon binds its OWN address, so it answers `none` while the count above is\n'
  printf '          non-zero. Both are true. The count above is the one about the MACHINE.\n'
  printf '          A non-zero holder count with zero daemons is NORMAL -- with no daemon\n'
  printf '          answering, every peer `intent` invocation opens the store in-process for its\n'
  printf '          own lifetime. What is diagnostic is holders that PERSIST.\n'
}

cmd_build() {
  # THE WHOLE BODY MOVED TO `shared/releasebuild.lib`, and moving it IS the fix.
  # It sat here as one command's private sequence while `int build all`,
  # `int build cli`, `int build daemon` and `cmd/cli`'s fallback each wrote the
  # same shared artefact with a bare `cargo build`. The guard was not weak, it
  # was unreachable from most of the doors people actually use.
  guarded_release_build
}

case "${1:-}" in
  ""|-h|--help)
    sed -n '5,11p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
    exit 0
    ;;
  status) cmd_status ;;
  build) cmd_build ;;
  *) die "unknown local target: $1 (try: status, build)" ;;
esac
