#!/usr/bin/env bash
#
# devbin: summary = The v3 install on THIS machine -- bindings, build, install, reversal
#
# int local <status|build|install|use|uninstall>
#
#   status      every `intent` binding on this machine, ranked by PATH precedence
#   build       force a COHERENT release pair, then VERIFY it
#   install     put v3 on PATH as `intent3` -- explicitly, and never as `intent`
#   use         switch which BUILD answers `intent`: dev|prod [--yes]; bare reports
#   uninstall   remove it again; the way back
#
# WHY `status` EXISTS, AND IT IS THE REASON FOR THE WHOLE COMMAND. On 2026-08-21
# this estate's own record said there were THREE `intent` bindings. There were
# FOUR: `~/.local/bin/intent` at PATH 17 and `~/bin/intent` at PATH 19, both
# symlinks to the same v2 tree, made in the same minute, and only one of them
# written down anywhere. A design that repoints "the symlink" moves one of two,
# and deleting the recorded one hands resolution to the unrecorded one, which
# still answers v2 -- silently, at exit 0. NOTHING ON THIS MACHINE COULD LIST
# THEM, so the list was maintained by memory and memory was wrong. This is that
# instrument, and it is read-only so there is never a reason not to run it.
#
# AND THE FACT IT EXISTS TO PRINT: `INTENT_HOME` HAS NO AUTHORITY OVER v3.
# Driven three ways -- exported, unset, and forced to a junk path -- the v3
# binary answers the same every time. The var is the strongest of v2's bindings
# and it is INERT for v3, so anyone reading it as the rail that keeps v3 away
# from the other projects on this machine is reading a rail that is not there.
# v3's actual gate is the version declared in the project's own config, which
# refuses every 2.x string measured. Two locks, and this prints the one people
# wrongly believe in so the belief cannot survive looking.
#
# WHY `build` IS NOT `cargo build --release`. That command returns 0 over a pair
# built from TWO DIFFERENT TREES. Measured here: `cargo build --release` and
# then `int build all` both reported `Finished` while `intent` named the current
# HEAD and `intentd` named a `dirty-` sha from two days earlier. The cause is
# exact -- `intentd` declares NO dependencies, so nothing ever invalidates its
# fingerprint and its `build.rs` never re-runs, permanently. `intent-cli` escapes
# only incidentally, by depending on `intentsvcs`, which changes.
#
# THE ABSENT `cargo:rerun-if-changed` IS DELIBERATE AND MUST NOT BE "FIXED" --
# see `native/rust/build-support/source_commit.rs`, which measured it: emitting
# ANY `rerun-if-changed` REPLACES cargo's default of re-running on package
# change, so naming `.git/HEAD` would swap a trigger that follows the code for
# one that does not follow it at all, and the embed would go stale on CODE
# changes instead -- worse, and in the direction nothing reports. The remedy
# belongs HERE, outside cargo, at the moment someone wants artefacts to install.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"
# The marker reader, project-owned. See the file for why it is not in lib/helpers.
. "$(dirname "${BASH_SOURCE[0]}")/shared/artefact.lib"
. "$(dirname "${BASH_SOURCE[0]}")/shared/sharedtarget.lib"

BINDIR="${INTENT_LOCAL_BINDIR:-$HOME/.local/bin}"
RELEASE_DIR="$PROJECT_ROOT/native/rust/target/release"
# The redirect target for a dirty build (AC-11.6). UNDER the already-ignored
# `target/`, deliberately: a sibling like `target-private/` would need a NEW
# .gitignore rule, and an artefact directory that is only ignored while somebody
# remembers to keep a rule in step is the shape this whole guard exists to stop.
PRIVATE_RELEASE_DIR="$PROJECT_ROOT/native/rust/target/private/release"
# The names v3 takes locally. NEVER `intent` -- see cmd_install.
PAIR="intent:intent3 intentd:intentd3"

# path_hits <name> -- every executable of <name> on PATH, as "<position>\t<path>".
#
# Walks PATH itself rather than asking `which -a`, because the POSITION is the
# whole answer: which binding wins is decided by order, and a bare list of paths
# cannot say. Ties are impossible; earlier always wins.
path_hits() {
  local name="$1" i=0 d
  local OLDIFS="$IFS"
  IFS=:
  for d in $PATH; do
    i=$((i + 1))
    [ -n "$d" ] || continue
    if [ -x "$d/$name" ] && [ ! -d "$d/$name" ]; then
      printf '%s\t%s\n' "$i" "$d/$name"
    fi
  done
  IFS="$OLDIFS"
}

# describe_binding <path> -- one line: where it really goes, and which line it is.
describe_binding() {
  # TWO `local`s, NOT ONE. Under `set -u` a same-statement `target="$f"` reads
  # `f` before the assignment has taken effect and dies `unbound variable` --
  # SC2318, latent here since this function was written and reached for the
  # first time by `use_flavour` calling it inside a command substitution.
  local f="$1"
  local target="$f" kind="file"
  if [ -L "$f" ]; then
    kind="symlink"
    target="$(readlink "$f")"
    case "$target" in
      /*) ;;
      *) target="$(cd "$(dirname "$f")" && cd "$(dirname "$target")" && pwd)/$(basename "$target")" ;;
    esac
  fi
  # THE COLUMN ASKS WHICH INTENT YOU GET, NOT WHAT THE FILE IS. Those differ for
  # a wrapper: `bin/intent3` IS a bash script and gets you v3, so classifying by
  # `file` alone prints a true fact under a label that means something else --
  # the same shape this command exists to expose one level up.
  local line="v2 (bash)"
  case "$(file -b "$target" 2>/dev/null)" in
    *Mach-O*) line="v3 (native)" ;;
    *)
      if grep -q 'native/rust/target/release' "$target" 2>/dev/null; then
        line="v3 (wrapper)"
      fi
      ;;
  esac
  printf '%s\t%s\t%s' "$kind" "$target" "$line"
}

cmd_status() {
  local name n=0 pos f kind target line first_shown

  step "intent bindings on this machine, in PATH order (first one wins)"
  for name in intent intent3 intentd intentd3; do
    first_shown=""
    while IFS="$(printf '\t')" read -r pos f; do
      [ -n "$pos" ] || continue
      n=$((n + 1))
      IFS="$(printf '\t')" read -r kind target line <<EOF
$(describe_binding "$f")
EOF
      if [ -z "$first_shown" ]; then
        first_shown=yes
        printf '    %-10s PATH %-3s %-42s WINS   -> %s  [%s]\n' "$name" "$pos" "$f" "$target" "$line"
      else
        printf '    %-10s PATH %-3s %-42s shadow -> %s  [%s]\n' "$name" "$pos" "$f" "$target" "$line"
      fi
    done <<EOF
$(path_hits "$name")
EOF
    [ -n "$first_shown" ] || printf '    %-10s not on PATH\n' "$name"
  done
  [ "$n" -gt 0 ] || warn "no intent binding of any name is on PATH"

  step "INTENT_HOME"
  printf '    exported: %s\n' "${INTENT_HOME:-<unset>}"
  printf '    INERT FOR v3. Driven exported, unset and forced to a junk path: the v3\n'
  printf '    binary answers the same every time. It binds v2 only. v3 is gated by the\n'
  printf "    version declared in each project's own config, which refuses every 2.x.\n"

  step "the tool tree -- a fact about this machine, not about where you are standing"
  # WHAT THIS REPLACES, AND WHY THE OBVIOUS VERSION WAS UNSHIPPABLE. I first wrote
  # this as "is THIS tree the tool?", comparing PROJECT_ROOT to INTENT_HOME. **It
  # could never fire.** `PROJECT_ROOT` in a devbin command is derived from the
  # COMMAND's own location, not from cwd -- the same trap already recorded here
  # about `int hooks` answering about the wrong repo -- so it compared a constant
  # to a constant and printed `consumer` from inside the tool tree itself. Driven
  # from both checkouts, which is the only reason it was caught.
  #
  # THE HAZARD IS REAL EVEN THOUGH THAT CHECK WAS NOT. `Intentv2` carries
  # `intent/.config/config.json`, so every census keyed on config presence finds
  # it -- and it sits at the migration floor, clean, with 3 threads, which makes
  # it look like the ideal canary and makes it the worst possible target: it is
  # the CLI fifteen other projects RUN (vc's census, 2026-08-21, which could not
  # tell a consumer from the tool -- no config-presence census can).
  #
  # `bin/intent` + `lib/templates/` is NOT the discriminator: this v3 checkout has
  # both and is a legitimate consumer, self-hosted. The discriminator is whether a
  # tree is the one INTENT_HOME NAMES, because that is exactly what makes
  # migrating it break everyone else. Stated here as a machine fact so a
  # census-writer meets it; the per-project test belongs in the census.
  local home_real
  home_real="$(cd "${INTENT_HOME:-/nonexistent}" 2>/dev/null && pwd -P || echo '<unresolved>')"
  printf '    INTENT_HOME names %s\n' "$home_real"
  printf '    THAT TREE IS THE TOOL OTHER PROJECTS RUN. NEVER MIGRATE IT.\n'
  printf '    It carries a project config, so every census finds it as a project.\n'
  printf '    It is not one. Migrating it takes the CLI away from everything else.\n'

  step "this checkout's release pair"
  local b
  for b in intent intentd; do
    if [ -f "$RELEASE_DIR/$b" ]; then
      printf '    %-8s %s\n' "$b" "$(artefact_source_commit "$RELEASE_DIR/$b" || echo '<no marker>')"
    else
      printf '    %-8s not built\n' "$b"
    fi
  done
  printf '    HEAD     %s\n' "$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || echo '<no git>')"
}

# verify_pair -- refuse a set that describes no single state of this repo.
#
# This is the check `cargo` cannot make and `int build all` does not: cargo
# reasons per package, and coherence is a property of the SET.
# verify_pair [<dir>] [<mode>]
#
# <dir> defaults to the shared release dir; <mode> is `shared` (default) or
# `private`. THE MODE EXISTS BECAUSE `dirty-` MEANS OPPOSITE THINGS ON THE TWO
# PATHS: in the shared slot it is the defect AC-11.6 exists to prevent, and in a
# private redirect it is the EXPECTED and correct outcome of having redirected.
# A single strict check would have made the redirect fail every time it worked.
verify_pair() {
  local dir="${1:-$RELEASE_DIR}" mode="${2:-shared}"
  local head b sc first="" bad=0
  head="$(git -C "$PROJECT_ROOT" rev-parse HEAD)" || die "cannot read HEAD"
  for b in intent intentd; do
    [ -f "$dir/$b" ] || { warn "$b was not built"; bad=1; continue; }
    if ! sc="$(artefact_source_commit "$dir/$b")"; then
      warn "$b carries NO source-commit marker -- it cannot say what it is"
      bad=1
      continue
    fi
    printf '    %-8s %s\n' "$b" "$sc"
    case "$mode:$sc" in
      shared:dirty-*)
        warn "$b was built from an uncommitted native/rust tree"
        bad=1
        ;;
      private:dirty-*)
        : # expected: this is what the redirect was for
        ;;
      private:*)
        # A private build that is NOT dirty means the tree went clean between the
        # verdict and the build. Reported rather than failed: the artefact is
        # sound, it is merely in the wrong place, and the operator wants to know
        # they can now take the shared path.
        warn "$b is clean but was built privately -- the tree went clean mid-build; re-run to take the shared path"
        ;;
    esac
    # HEAD equality is a SHARED-path claim only. A private dirty build names HEAD
    # in its `dirty-<sha>` suffix and is not pretending to describe a commit.
    if [ "$mode" = shared ]; then
      [ "$sc" = "$head" ] || { warn "$b does not name HEAD ($head)"; bad=1; }
    fi
    if [ -z "$first" ]; then first="$sc"
    elif [ "$sc" != "$first" ]; then
      warn "the pair disagrees: $first vs $sc -- built from DIFFERENT trees"
      bad=1
    fi
  done
  [ "$bad" -eq 0 ] || die "the release pair does not describe one state of this repo -- refusing to call this installable"
  ok
}

cmd_build() {
  # AC-11.6: THE SHARED ARTEFACT PATH IS PROTECTED, AND THE CHECK RUNS BEFORE THE
  # BUILD RATHER THAN AFTER IT. `verify_pair` below already refused a `dirty-`
  # marker, but only once `cargo build` had overwritten the binaries four nodes
  # invoke -- so it reported the damage instead of preventing it. The criterion
  # ruled on exactly this ordering and chose the earlier refusal, in its own
  # words: BEFORE the artefact exists, rather than producing a working-looking
  # binary four nodes then invoke.
  #
  # A DIRTY TREE IS REDIRECTED, NEVER BLOCKED. Five nodes share this clone and
  # somebody is always mid-edit; a guard that stops the build outright is a freeze
  # that gets bypassed, and a bypassed guard is not a guard. The dirty build goes
  # to a private target dir under the already-ignored `target/`, carries its
  # `dirty-<sha>` marker, and leaves the shared slot exactly as it found it.
  local verdict dir mode
  verdict="$(shared_target_verdict "$PROJECT_ROOT")"
  case "$verdict" in
    ok)
      dir="$RELEASE_DIR"
      mode=shared
      ;;
    refuse:*)
      warn "${verdict#refuse:}"
      shared_target_dirt_report "$PROJECT_ROOT"
      dir="$PRIVATE_RELEASE_DIR"
      mode=private
      step "redirecting to a PRIVATE target dir -- the shared artefact is untouched"
      printf '    %s\n' "$dir"
      printf '    Commit or stash the paths above and re-run to build the shared pair.\n'
      ;;
    *)
      die "sharedtarget.lib returned an unrecognised verdict: $verdict -- refusing rather than guessing, because an unknown verdict is not a pass"
      ;;
  esac

  cd "$PROJECT_ROOT/native/rust" || die "no Rust workspace at native/rust"
  step "forcing the provenance embeds (cargo will not do this for you -- see the header)"
  CARGO_TARGET_DIR="$(dirname "$dir")" cargo clean -p intent-cli -p intentd --release
  step "building every binary in the workspace"
  CARGO_TARGET_DIR="$(dirname "$dir")" cargo build --workspace --bins --release || die "the release build failed"
  step "verifying the SET, which is the check cargo cannot make"
  verify_pair "$dir" "$mode"
}

cmd_install() {
  local yes="" pair src dst
  [ "${1:-}" = "--yes" ] && yes=1

  step "what this will do"
  printf '    %s\n' "$BINDIR/intent3   -> $RELEASE_DIR/intent"
  printf '    %s\n' "$BINDIR/intentd3  -> $RELEASE_DIR/intentd"
  printf '\n'
  printf '    NEVER AS `intent`. Installing v3 under that name shadows v2 for every\n'
  printf '    other project on this machine in one move, and INTENT_HOME cannot stop it.\n'
  printf '    A distinct name makes the way back "do nothing" rather than "one command".\n'
  printf '\n'
  printf '    SYMLINKS, NOT COPIES, and that is CORRECTNESS rather than convenience.\n'
  printf '    `claude hook` finds its scripts by walking current_exe() ancestors for\n'
  printf '    lib/templates/. A symlink is canonicalised first, so the walk still lands\n'
  printf '    inside the checkout; a COPY has no marker above it and every hook refuses\n'
  printf '    at EXIT 1 -- which Claude Code does not block on, so the strict in-session\n'
  printf '    gate would silently stop enforcing in every project at once. Driven both\n'
  printf '    ways 2026-08-21 (ic found it; dc measured the link and copy arms).\n'
  printf '    They also track this checkout, so `cargo clean` breaks them loudly.\n'

  verify_pair

  if [ -z "$yes" ]; then
    die "machine-wide change outside this checkout -- re-run with --yes if that is what you want"
  fi

  mkdir -p "$BINDIR" || die "cannot create $BINDIR"
  for pair in $PAIR; do
    src="$RELEASE_DIR/${pair%%:*}"
    dst="$BINDIR/${pair##*:}"
    [ -f "$src" ] || die "missing $src -- run 'int local build' first"
    [ ! -e "$dst" ] || [ -L "$dst" ] ||
      die "$dst exists and is not a symlink -- refusing to replace a real file"
    ln -sfn "$src" "$dst" || die "could not link $dst"
    printf '    linked %s\n' "$dst"
  done
  step "done -- the way back is 'int local uninstall'"
  cmd_status
}

# ---------------------------------------------------------------------------
# cmd_use -- switch which BUILD answers `intent` on this machine.
#
#   int local use          report what actually resolves (delegates to status)
#   int local use prod     the brew-installed release
#   int local use dev      this checkout's build
#
# MECHANISM: `brew link` / `brew unlink`. `/opt/homebrew/bin` is PATH position 1
# and the dev symlinks sit at 17 and 19, so while the formula is linked brew wins
# and nothing built here is ever reached. Unlinking removes brew's symlinks and
# PATH falls through. That is Homebrew's own sanctioned, reversible mechanism;
# hand-editing `/opt/homebrew/bin` or reordering PATH is neither.
#
# WHY THIS IS NOT A PORT OF CONFLAB'S `use`, AND THE DIFFERENCE IS THE WHOLE RISK.
# Conflab unlinks brew and falls through TO NOTHING. WE FALL THROUGH TO v2:
# `~/.local/bin/intent` (17) and `~/bin/intent` (19) are both symlinks into the
# FROZEN v2 tree. So a bare unlink here does not select the dev build, IT SELECTS
# v2 -- right binary name, wrong major version, EXIT 0, no message. This file's
# own header states the general form: a design that repoints "the symlink" moves
# one of two, and deleting the recorded one hands resolution to the unrecorded
# one, which still answers v2 silently.
#
# SO THE VERIFY IS THE LOAD-BEARING PART, NOT THE REPOINT. This command repoints
# what it owns and then MEASURES WHAT ACTUALLY RESOLVES, dying if it is not the
# flavour asked for. That catches PATH 19, and any position nobody has found yet,
# WITHOUT NEEDING TO KNOW IT EXISTS. An enumeration of positions goes stale the
# day someone adds one; a measurement of resolution cannot.

# use_flavour -- which flavour actually answers `intent` on PATH: prod|dev|v2|none
#
# Reads the FIRST PATH hit, because position is what decides. Classifies by where
# the link really lands, never by the file's name.
use_flavour() {
  local first target brew_prefix
  first="$(path_hits intent | head -1 | cut -f2)"
  [ -n "$first" ] || { printf 'none'; return 0; }
  target="$(describe_binding "$first" | cut -f2)"
  brew_prefix="$(brew --prefix 2>/dev/null)"
  case "$target" in
    "$PROJECT_ROOT"/*) printf 'dev' ;;
    *)
      if [ -n "$brew_prefix" ] && [ "${target#"$brew_prefix"/}" != "$target" ]; then
        printf 'prod'
      else
        printf 'v2'
      fi
      ;;
  esac
}

# brew_has_intent -- is the formula installed at all? Today it is not: the tap is
# empty on purpose until the first v3 release lands a formula in it.
brew_has_intent() {
  brew list --formula intent >/dev/null 2>&1
}

# verify_hook_door -- does `intent claude hook` actually OPEN after the switch?
#
# A DIFFERENT PROPOSITION FROM "WHICH BINARY RESOLVES", AND THEY COME APART ON
# THE PROD ARM (cc, 2026-08-26). The door finds its scripts by walking
# `current_exe()` ancestors for `lib/templates/`. A symlink canonicalises first
# and the walk lands inside the checkout; A BREW INSTALL IS A COPY, and a copy
# with no marker above it refuses EVERY hook at exit 1 -- which Claude Code does
# NOT block on, so the strict in-session gate stops enforcing SILENTLY, in every
# project, at once. `verify_pair` and a resolution check BOTH PASS while that is
# true: both ask which bytes are there, neither asks whether the door opens.
# (copy-vs-link arms: ic's find, dc's measurement, 2026-08-21.)
#
# STDIN MUST BE CLOSED. `claude hook require-in-session` reads its payload from
# stdin and BLOCKS FOREVER on an inherited one -- two minutes on cc's probe
# today. `session-context` is the safe one to drive.
verify_hook_door() {
  local out rc
  out="$(intent claude hook session-context </dev/null 2>&1)"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '    %s\n' "$out" | head -2
    die "the binary resolves but its HOOK DOOR does not open (rc=$rc) -- lib/templates/ is not above the resolved executable, so every consumer hook would refuse at exit 1 and Claude Code would not block on it"
  fi
  printf '    hook door opens (rc=0)\n'
}

cmd_use() {
  local want="${1:-}" got yes=""
  [ "${2:-}" = "--yes" ] && yes=1

  case "$want" in
    "")
      # HIGHLANDER: `status` already walks PATH, already refuses a set that
      # describes no single state, and already names the tool tree. A second
      # PATH reporter is the exact defect `status` was built to end.
      cmd_status
      return 0
      ;;
    dev | prod) ;;
    *) die "unknown flavour: $want (try 'dev', 'prod', or bare 'use' to report)" ;;
  esac

  step "switching to $want"

  if [ "$want" = prod ]; then
    brew_has_intent ||
      die "the intent formula is not installed -- there is no prod to switch to. The tap is empty until the first v3 release publishes a formula into it."
    brew unpin intent >/dev/null 2>&1 || true
    brew link --overwrite intent >/dev/null 2>&1 ||
      die "brew link intent failed -- run it by hand to see why; this command will not force it"
    printf '    brew linked\n'
  else
    if brew_has_intent; then
      brew unlink intent >/dev/null 2>&1 ||
        die "brew unlink intent failed -- refusing to repoint anything while brew still wins at PATH 1"
      # PIN so `brew upgrade` cannot silently re-link and put you back on prod
      # without saying so. A switch that a later unrelated command can undo is
      # not a switch.
      brew pin intent >/dev/null 2>&1 || warn "could not pin intent -- a later 'brew upgrade' may re-link prod under you"
      printf '    brew unlinked and pinned\n'
    else
      # NO PROD TO GO BACK TO, SO THIS IS NOT A TOGGLE -- IT IS THE CUTOVER.
      # Nothing shadows PATH 17 while the formula is absent, so repointing it
      # changes which Intent EVERY project on this machine runs, and `use prod`
      # cannot undo it because there is no formula to link. Machine-wide and
      # one-way, so it asks, exactly as `install` does for the same reason.
      [ -n "$yes" ] ||
        die "no intent formula is installed, so nothing shadows PATH 17 -- repointing it switches EVERY project on this machine to this checkout's build, and 'use prod' cannot undo it until a formula exists. Re-run with --yes if that is what you want."
      printf '    brew formula not installed -- nothing to unlink\n'
    fi

    # REPOINT WHAT WE OWN. Not an enumeration of every binding -- the verify
    # below is what covers the ones we do not own.
    local pair src dst
    for pair in $PAIR; do
      src="$RELEASE_DIR/${pair%%:*}"
      dst="$BINDIR/${pair%%:*}"
      [ -f "$src" ] || die "missing $src -- run 'int local build' first"
      [ ! -e "$dst" ] || [ -L "$dst" ] ||
        die "$dst exists and is not a symlink -- refusing to replace a real file"
      ln -sfn "$src" "$dst" || die "could not link $dst"
      printf '    linked %s -> %s\n' "$dst" "$src"
    done
  fi

  # VERIFY, NEVER ASSUME. The failure this catches is silent and plausible: PATH
  # falling through to a v2 symlink answers at exit 0 under the right name.
  step "what actually resolves now"
  got="$(use_flavour)"
  printf '    %s\n' "$got"
  [ "$got" = "$want" ] ||
    die "asked for $want and PATH resolves to $got -- the switch did NOT take. Run 'int local status' to see every binding in precedence order."
  verify_hook_door

  # A dev switch is only as good as the artefacts it switched to, and the pair is
  # routinely at a different commit from HEAD in a four-writer tree.
  if [ "$want" = dev ]; then
    step "do the dev artefacts describe this tree?"
    verify_pair
  fi

  step "done -- the way back is 'int local use ${want/dev/prod}'"
}

cmd_uninstall() {
  local pair dst removed=0
  step "removing the v3 bindings this command made"
  for pair in $PAIR; do
    dst="$BINDIR/${pair##*:}"
    if [ -L "$dst" ]; then
      rm -f "$dst" || die "could not remove $dst"
      printf '    removed %s\n' "$dst"
      removed=$((removed + 1))
    elif [ -e "$dst" ]; then
      warn "$dst is not a symlink -- left alone, this command did not make it"
    fi
  done
  [ "$removed" -gt 0 ] || printf '    nothing to remove\n'
  printf '\n'
  printf '    THIS REVERSES THE INSTALL AND NOT A PROJECT. A project switched with\n'
  printf '    `intent upgrade` is reversed separately, and the way back is git:\n'
  printf '        git checkout . && git clean -fd && rm -rf intent/.cache\n'
  printf '    A PROJECT WITH UNCOMMITTED WORK HAS NO WAY BACK. Commit before switching.\n'
  cmd_status
}

case "${1:-}" in
  ""|-h|--help)
    sed -n '5,10p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
    exit 0
    ;;
  status) cmd_status ;;
  build) cmd_build ;;
  install) shift; cmd_install "${1:-}" ;;
  use) shift; cmd_use "$@" ;;
  uninstall) cmd_uninstall ;;
  *) die "unknown local target: $1 (try: status, build, install, use, uninstall)" ;;
esac
