#!/usr/bin/env bash
#
# devbin: summary = Run this repo's local commit gates (ST0056 apparatus guards)
#
# intent precommit [--all] -- run the guards that protect THIS repository's
# apparatus. Invoked by .git/hooks/pre-commit; safe to run by hand.
#
# WHY THIS IS NOT IN lib/templates/hooks/pre-commit.sh, which is where the
# critic gate and the whiteboard clock guard live. That file is SHIPPED: every
# consumer project receives it via `intent claude upgrade --apply`. The two
# guards run here check `intent/st/ST0056/parity/**`, which exists in this
# repository and nowhere else. Putting an ST-specific check into the shipped
# canon would hand every consumer a gate for a steel thread they do not have,
# and it would outlive ST0056 in the canon forever. Repo-local guards get a
# repo-local runner.
#
# WHY ONE COMMAND FOR TWO GUARDS IS NOT THE EXIT-CODE OVERLOAD ic WARNED ABOUT.
# The defect in `intent critic` is that four unrelated conditions share exit 2
# with no way for the caller to tell them apart. Here each guard keeps its own
# script, its own invariant and its own message; this runner aggregates and
# NAMES the one that refused. The guards were also deliberately kept separate
# by vc's ruling -- provenance checks that STAMPS AGREE (metadata), skew checks
# that CONTENT MATCHES CANON -- and nothing here merges them.
#
# COVERAGE IS REPORTED AS MEASURED, NEVER AS DESIGNED. Measured 2026-08-15:
# view_skew covers ONE of thirty apparatus views (`dispatch-table.md` is the
# only one re-derivable from committed state); provenance groups the other 29,
# for which the stamp is the only guard that exists. Do not write those numbers
# into this file as constants -- the guards print what they actually checked,
# and a hard-coded figure rots the moment somebody adds artefact 31.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

# THE GUARD ROSTER -- declared ONCE here and consumed TWICE: the run labels its
# steps from these names, and `--list-guards` prints them for `int hooks`.
#
# WHY THIS EXISTS AT ALL, and it is a defect I shipped. `int hooks` derived its
# roster by grepping `$TOOLS/[a-z]*.sh` out of this runner, and I wrote in its
# source that reading the names from the runner meant "the roster cannot rot".
# It rotted the same day: guard 0 below is implemented INLINE rather than as a
# script under `$TOOLS/`, so the grep could not see it and `int hooks` reported
# a gate enforcing two things when it enforces three. Under-reporting what a
# gate enforces is worse than most defects, because the tool people consult to
# find out is the thing that is wrong.
#
# The error was anchoring on a PATH SHAPE rather than on the structural fact --
# my own watch-out about needles that stop matching when the prefix changes,
# self-inflicted one file over. The fix is the other Decision on my board: ASK
# THE TOOL, DO NOT REIMPLEMENT ITS RULE. The runner is the authority on what the
# runner checks, so it declares, and `int hooks` asks.
#
# Format is `name<TAB>repo-relative-script-or-dash`. A dash means the guard has
# no script to stat, which is a legitimate state and not a missing file -- the
# distinction `int hooks` needs in order to keep flagging a guard whose script
# has actually gone missing.
#
# THE PATH IS REPO-RELATIVE AND WHOLE, not a basename `int hooks` re-roots.
# It used to emit bare filenames and the reader prefixed the ST0056 tools
# directory, which quietly redefined the second field as "a script UNDER
# $TOOLS". The moment a guard's script lived anywhere else -- guard 0b then
# delegated to shipped canon under lib/ -- that reader had exactly two wrong
# answers available and no right one: report a real script as MISSING, or emit
# a dash claiming there is none. Same anchoring error as the defect recorded
# above, one field along: the roster is the authority on what it checks AND on
# where those checks live.
#
# Guard 0b has since gone entirely (see below) and every remaining path is back
# under $TOOLS, so the case that motivated the whole-path field is not currently
# live. The field stays whole. A format narrowed to the population that happens
# to occupy it today is how the basename version got written in the first place.
G_NODB="no database enters history (D34: the DB is per-machine truth, never committed)"
G_PROV="provenance: artefacts from one measurement name one revision"
G_SKEW="skew: committed generated views still match their canon"
G_GENIN="generator inputs: git holds everything a committed artefact is made from"
G_ROSTER="roster: every parity instrument declares whether this gate runs it"
G_CORRECTED="corrected class: the ratified units and the claimed units are one set"
G_VOCAB="class vocabulary: a claimed parity class is one parity.md names"
G_RATIFIED="ratification provenance: a ratified row names authority, date and record"
G_RESIDUE="residue classes: migration.md matches what Phase A can actually emit"
G_STALEAT="stale AT rows: a to-write row whose cited test already exists"
G_SELFPROV="self-provenance: a vendored tree agrees with its COMMITTED record (gates), and each binary names its own source commit (REPORTS -- enforcement is at \`int macos publish\`)"
G_CANONCOMMIT="canon currency: a commit carrying canon does not name bytes absent from that commit (ST0057 AC-03.6)"
G_GUARDHOME='guard home: a self-hosted tree runs ITS OWN guards, not the ones $INTENT_HOME points at'

# THE WHITEBOARD HEADER GUARD IS NO LONGER LISTED HERE, and the precondition
# this file wrote for its own removal has been met. It read: "WHEN THIS BLOCK
# GOES AWAY: when `.git/hooks/pre-commit.intent` here is reinstalled from the
# updated canon, the shipped hook runs this guard itself and this call becomes
# the second of two." Reinstalled 2026-08-20; the shipped gate now dispatches it
# from the delegated roster in `lib/templates/hooks/pre-commit-guards.sh`.
#
# It was never merely redundant, which is why it is gone rather than left as a
# cheap double-check. It was COMPENSATION for a defect one layer down: the
# installed hook carried a frozen Aug 14 roster running one guard of four, and
# this call papered over exactly one of the three that were missing. A local
# workaround for a shipped hole is the worst possible place for it -- it makes
# the hole invisible HERE, which is the one repository where somebody would
# have noticed. Two guards it did not compensate for (`canon-ignore-guard.sh`,
# `append-only-guard.sh`) ran nowhere at all, and nothing said so.

if [ "${1:-}" = "--list-guards" ]; then
  printf '%s\t-\n' "$G_NODB"
  printf '%s\t%s\n' "$G_PROV" "intent/st/ST0056/parity/tools/provenance_check.sh"
  printf '%s\t%s\n' "$G_SKEW" "intent/st/ST0056/parity/tools/view_skew_check.sh"
  printf '%s\t%s\n' "$G_GENIN" "intent/st/ST0056/parity/tools/generator_inputs_check.sh"
  printf '%s\t%s\n' "$G_ROSTER" "intent/st/ST0056/parity/tools/runner_roster_check.sh"
  printf '%s\t%s\n' "$G_CORRECTED" "intent/st/ST0056/parity/tools/corrected_check.sh"
  printf '%s\t%s\n' "$G_VOCAB" "intent/st/ST0056/parity/tools/class_vocab_check.sh"
  printf '%s\t%s\n' "$G_RATIFIED" "intent/st/ST0056/parity/tools/rulings_check.sh"
  printf '%s\t%s\n' "$G_RESIDUE" "intent/st/ST0056/parity/tools/residue_class_check.sh"
  printf '%s\t%s\n' "$G_STALEAT" "intent/st/ST0056/parity/tools/stale_at_check.sh"
  printf '%s\t%s\n' "$G_SELFPROV" "intent/st/ST0056/parity/tools/self_provenance_check.sh"
  printf '%s\t%s\n' "$G_CANONCOMMIT" "intent/st/ST0056/parity/tools/canon_commit_check.sh"
  printf '%s\t%s\n' "$G_GUARDHOME" "intent/st/ST0056/parity/tools/guard_home_check.sh"
  exit 0
fi

TOOLS="${PROJECT_ROOT:?}/intent/st/ST0056/parity/tools"

# The staged set, which is what a pre-commit gate is entitled to have an opinion
# about. --diff-filter=ACM excludes deletions: a deleted path cannot be skewed
# against its canon, and feeding one to the skew check would ask it to compare a
# file that is not there.
#
# `|| true` is load-bearing rather than defensive noise: git exits non-zero when
# nothing is staged, and under `set -e` that would abort the gate instead of
# letting it correctly find nothing to do. (This is the same shape that killed
# ic's generator -- a legitimately-empty pipeline aborting the whole script.)
#
# Computed BEFORE the apparatus check below, because guard 0 is not an ST0056
# guard and must outlive that directory.
STAGED="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)"

# --all forces the full sweep regardless of what is staged, for running by hand.
FULL=0
[ "${1:-}" = "--all" ] && FULL=1

rc=0
failed=""

# 0. NO SQLITE DATABASE ENTERS HISTORY.
#
# D34 (hv, 2026-08-15): the SQLite db is per-machine durable truth and is NEVER
# committed -- truth travels as the lossless .json/.md extract and a clone
# reconstitutes through the ingest gate. So a DB in a commit is always wrong.
#
# WHY THIS IS A GUARD AND NOT A WIDER .gitignore GLOB, which was the obvious
# move and is the wrong one. vc ruled the ignore file stays a PATH rule: now
# that the DB is durable truth, a blanket `*.db` there asserts a durability
# policy about a whole class for every consumer of that file. It also cannot
# work -- `Store::open()` takes a path PARAMETER, so no list of paths is
# exhaustive by construction. The two mechanisms are not interchangeable:
# **an ignore silently hides the paths it already knows; a guard refuses the
# ones nobody thought of.** Only the second is load-bearing, and this repository
# is PUBLIC, so the cost of the miss is permanent and world-readable.
#
# TWO DETECTORS, because each closes a hole the other cannot see. By NAME
# catches the `-wal`/`-shm` companions, which are not SQLite-format files at all
# and carry their own headers. By CONTENT catches a database committed under any
# name at all, which is the case a name rule can never reach.
#
# It reads the STAGED BLOB (`git show :path`), never the worktree file. Those
# differ exactly when it matters, and the index is what would land -- the same
# reason a green suite is evidence about the tree you have and not the tree you
# pushed.
step "$G_NODB"
staged_db=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    *.db | *.db-wal | *.db-shm | *.sqlite | *.sqlite3)
      staged_db="${staged_db}    $p   (by name)
"
      ;;
  esac
done <<<"$STAGED"

# Content-probe only the paths git already calls binary -- numstat prints `-`
# for both counts on a binary blob. A SQLite file is always binary, so this
# loses nothing and keeps `git show` off every text file in a large commit.
# --no-renames because the rename form prints a path pair this would misread.
BINARIES="$(git diff --cached --numstat --no-renames --diff-filter=ACM 2>/dev/null | awk '$1 == "-" && $2 == "-" { print $3 }' || true)"
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    *.db | *.db-wal | *.db-shm | *.sqlite | *.sqlite3) continue ;; # already named above
  esac
  # `|| true` on the pipeline: `head -c` closes the pipe early, git dies of
  # SIGPIPE, and pipefail would abort the whole gate over a file that is merely
  # shorter than the probe.
  magic="$( (git show ":$p" 2>/dev/null | head -c 15) 2>/dev/null || true)"
  if [ "$magic" = "SQLite format 3" ]; then
    staged_db="${staged_db}    $p   (by CONTENT -- SQLite magic under a name that does not say so)
"
  fi
done <<<"$BINARIES"

if [ -n "$staged_db" ]; then
  rc=1
  failed="${failed}  a SQLite database is staged -- D34 says the DB is never committed
${staged_db}"
fi

# Named, not silent -- the clock guard's precedent. Apparatus present with no
# guard behind it is the invisible non-enforcement this mechanism exists to end,
# and after ST0056 closes this directory will legitimately go away. Either way
# the operator is told which it is rather than getting a green.
#
# Guard 0 above has already run and its verdict is carried to the report at the
# bottom: a missing apparatus skips the ST0056 guards, it does not turn a staged
# database into a pass.
HAVE_TOOLS=1
if [ ! -d "$TOOLS" ]; then
  # NO COUNT IN THIS MESSAGE, DELIBERATELY, AND THE ABSENCE IS THE FIX. It read
  # "those two gates" from the day dc wrote it (b186a0f3), when there were two.
  # There are now NINE behind this branch, and the literal rotted silently
  # through every addition -- so at the one moment coverage is degraded, the
  # message a human reads understated the gap by seven.
  #
  # A count here can only ever be a second copy of the list below, and the copy
  # is the half nobody updates. Naming the CLASS cannot rot; naming what still
  # ran is what the reader actually needs, because the danger is reading "gates
  # skipped" as "no gate ran".
  warn "no ST0056 parity apparatus at $TOOLS -- every ST0056 parity gate SKIPPED this commit (the database and whiteboard guards still ran)."
  HAVE_TOOLS=0
fi

# 1. Provenance. Always runs the full sweep: it is three greps over 29 files,
#    and its invariant is CROSS-artefact -- staging one file of a measurement
#    group is exactly when the group can be split, so narrowing it to the staged
#    set would blind it to the failure it exists to catch.
if [ "$HAVE_TOOLS" -eq 1 ]; then
  step "$G_PROV"
  if ! bash "$TOOLS/provenance_check.sh"; then
    rc=1
    failed="${failed}  provenance_check.sh -- a measurement group names more than one revision
"
  fi

  # 2. View skew. Path-triggered by design: a slow gate gets --no-verify'd, which
  #    is cry-wolf arriving through a different door. It is sound rather than a
  #    fudge -- a generator reads only its canon, so a view cannot go stale unless
  #    canon, generator or view changes, and all three are paths.
  step "$G_SKEW"
  if [ "$FULL" -eq 1 ] || [ -z "$STAGED" ]; then
    skew_run=(bash "$TOOLS/view_skew_check.sh")
  else
    # Unquoted expansion is wrong here and this shell is zsh for interactive use,
    # so build the argv explicitly rather than relying on word splitting.
    skew_run=(bash "$TOOLS/view_skew_check.sh" --changed)
    while IFS= read -r p; do
      [ -n "$p" ] && skew_run+=("$p")
    done <<<"$STAGED"
  fi
  if ! "${skew_run[@]}"; then
    rc=1
    failed="${failed}  view_skew_check.sh -- a committed view no longer matches its canon
"
  fi

  # 3. Generator inputs. NOT path-triggered, unlike the skew check above, and the
  #    difference is the invariant rather than an inconsistency. Skew asks "does
  #    this view still match its canon", which only changes when a path changes.
  #    This asks "does git hold what this generator reads", and that can go false
  #    with NO path in this repository changing at all -- someone deletes a
  #    scratchpad, or reboots. It is a whole-set check over four files and reads
  #    only the index, so it costs nothing to run every time.
  step "$G_GENIN"
  if ! bash "$TOOLS/generator_inputs_check.sh"; then
    rc=1
    failed="${failed}  generator_inputs_check.sh -- a committed artefact names an input git cannot hold
"
  fi

  # 4. Instrument disposition -- the roster that says whether the list ABOVE is
  #    the whole of what runs. Issue 0059: eleven instruments lived in the tools
  #    directory, three had an execution site, and eight had none -- three of
  #    those eight CITED BY A GREEN ACCEPTANCE ROW. Every individual record was
  #    correct; nothing joined "this tool exists" to "something runs it".
  #
  #    IT GATES ON ITS FINDINGS, unlike the five below, and the asymmetry is
  #    principled rather than a mood. Those are report-only because most of
  #    their hits are a legitimate mid-ladder state -- a command not wired yet,
  #    a row not ratified yet. There is no legitimate state in which a tool
  #    exists and its disposition is undeclared: the fix is one line in the
  #    roster, and forcing it on the day the tool ARRIVES is the entire point.
  #    The roster is the only artefact here that cannot rot by omission.
  step "$G_ROSTER"
  if ! bash "$TOOLS/runner_roster_check.sh"; then
    rc=1
    failed="${failed}  runner_roster_check.sh -- an instrument's declared disposition disagrees with what this runner does
"
  fi

  # 5-9. THE REGISTER CHECKS. All five are REPORT-ONLY BY CONSTRUCTION: each
  #      exits 0 whether it is clean or has findings, and non-zero ONLY when it
  #      cannot measure at all.
  #
  #      So a refusal from any of the five is never "the register is wrong" --
  #      it is "this instrument could not answer", which is a broken instrument.
  #      That distinction is not academic: corrected_check.sh spent a day dying
  #      at exit 2 for all twenty corrected rows, because a ratification had
  #      been written into a field it does not read. The refusal was correct,
  #      loud, and by design, and it sat through a fold and a compact under a
  #      board reading "nothing blocked" -- because nothing ran it. A refusal
  #      and a silence look the same to anyone not looking.
  #
  #      Their FINDINGS print above and do not block. Read them; that is the
  #      whole reason they are here rather than in somebody's shell history.
  step "$G_CORRECTED"
  if ! bash "$TOOLS/corrected_check.sh"; then
    rc=1
    failed="${failed}  corrected_check.sh -- could not measure the corrected class (exit 2; its findings never gate)
"
  fi

  step "$G_VOCAB"
  if ! bash "$TOOLS/class_vocab_check.sh"; then
    rc=1
    failed="${failed}  class_vocab_check.sh -- could not measure the class vocabulary (exit 2; its findings never gate)
"
  fi

  step "$G_RATIFIED"
  if ! bash "$TOOLS/rulings_check.sh"; then
    rc=1
    failed="${failed}  rulings_check.sh -- could not measure ratification provenance (exit 2; its findings never gate)
"
  fi

  step "$G_RESIDUE"
  if ! bash "$TOOLS/residue_class_check.sh"; then
    rc=1
    failed="${failed}  residue_class_check.sh -- could not measure the residue classes, or the two sets disagree
"
  fi

  step "$G_STALEAT"
  if ! bash "$TOOLS/stale_at_check.sh"; then
    rc=1
    failed="${failed}  stale_at_check.sh -- an AT row's status will not parse (exit 2; a stale-row report never gates)
"
  fi

  # 10. Self-provenance (AC-11.5). Reads the INDEX and never the worktree, which
  #     is the whole reason it catches anything: on 2026-08-17 HEAD carried a
  #     manifest disagreeing with the file beside it for two hours while every
  #     local check was green, because an uncommitted regeneration had made the
  #     WORKTREE agree with itself. A tree agreeing with itself is not the tree
  #     agreeing with the record, and only the index answers the second.
  #
  #     NOT path-triggered. A re-vendor is TWO FACTS -- the files and the record
  #     -- and the failure is staging one of them, so the trigger would have to
  #     fire on the path that ISN'T there. Whole-set at 504ms over 27 blobs.
  step "$G_SELFPROV"
  if ! bash "$TOOLS/self_provenance_check.sh"; then
    rc=1
    failed="${failed}  self_provenance_check.sh -- the commit's vendored tree disagrees with the manifest committed beside it
"
  fi

  # 12. Canon currency (ST0057 AC-03.6). A commit that carries canon must not name
  #     bytes no commit contains -- canon is committed and never sparse, so a canon
  #     edit referencing an attachment that is not in the same commit publishes a
  #     record pointing at nothing.
  #
  #     ADMITTED 2026-08-21 (dc) ON hv's RELEASE, and the roster's own reason for
  #     holding it had TWO parts, both re-derived here rather than taken on report:
  #       - "there is no narrow attachment-sync verb": DEAD. `sync --to-store [ID]...`
  #         takes positional ids, landed at `212b0075`, so the order a gate permits
  #         (sync the one thread, then commit file and canon together) is open.
  #       - "--staged is not supported": DEAD. `:254` parses the flag and `:364`
  #         reads `git diff-index --cached HEAD`, so it judges the INDEX.
  #
  #     ALWAYS `--staged`, NEVER PATH-TRIGGERED, and that is a ruling rather than an
  #     oversight. The tool already narrows internally; a path trigger here would be
  #     a SECOND copy of that narrowing, which is the drift the roster exists to stop.
  #     It is the whole point that this differs from the skew check above -- skew asks
  #     a question only a path change can alter, this asks whether the index is
  #     internally consistent, which staging one half of a pair makes false.
  #
  #     COST, RE-MEASURED AT `ecea0eeb` ON THIS MACHINE BECAUSE THE ROSTER SAYS TO:
  #     2710-2760ms narrowed, against 2.49-2.55s recorded -- ~8% slower, so the
  #     affordability case is REFRESHED rather than overturned. It is now the most
  #     expensive guard here, and the gate total moves ~4.6s -> ~7.3s on every commit.
  #     `runner_roster_check.sh:102` warned in its own words that the original
  #     affordability argument was conducted against stale numbers; this is that
  #     re-measurement, and the figure carries its revision because a bare one
  #     cannot be compared against anything.
  step "$G_CANONCOMMIT"
  if ! bash "$TOOLS/canon_commit_check.sh" --staged; then
    rc=1
    failed="${failed}  canon_commit_check.sh -- this commit's canon names bytes the commit does not carry
"
  fi
fi

# GUARD HOME. UNCONDITIONAL AND NOT PATH-TRIGGERED, because the failure it
# catches is a DELETION and a path trigger keyed to the template would not fire
# on a commit that removes the branch from somewhere else -- or, worse, would
# fire only on the commit that breaks it and never again. 17-22ms of two greps
# over one committed file is not worth a trigger to avoid.
step "$G_GUARDHOME"
# THE ABSENT CASE IS NAMED SEPARATELY, AND cc FOUND THIS ON REAL BYTES BEFORE IT
# COULD SHIP. The summary line used to assert ONE cause -- "the template lost the
# override" -- for EVERY non-zero exit, including exit 127 when the tool itself is
# missing. cc's commit hit exactly that while the file was momentarily off the
# tree, and the gate told them their template was broken. It was not.
#
# A summary that names a cause it did not establish is worse than one that names
# none: it sends the reader at a file that is fine, with the gate's authority
# behind it. Same class as `unwired`s leaf remedy pointing at an empty help block.
if [ ! -f "$TOOLS/guard_home_check.sh" ]; then
  rc=1
  failed="${failed}  guard_home_check.sh -- THE INSTRUMENT IS MISSING, so nothing was checked. This says
    NOTHING about the hook template; the tool that reads it is not on disk.
"
elif ! bash "$TOOLS/guard_home_check.sh"; then
  rc=1
  failed="${failed}  guard_home_check.sh -- the shipped hook template lost the self-hosted GUARD_HOME override
"
fi

if [ "$rc" -ne 0 ]; then
  printf '\n' >&2
  printf 'intent repo-local gate: commit blocked.\n' >&2
  printf '%s' "$failed" >&2
  printf '  each guard printed the specific artefact above; regenerate it and re-stage.\n' >&2
  printf '  to bypass (use sparingly): git commit --no-verify\n' >&2
  exit 1
fi

exit 0
