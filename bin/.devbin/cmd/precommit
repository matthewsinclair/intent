#!/usr/bin/env bash
#
# devbin: summary = Run this repo's local commit gates (ST0056 apparatus guards)
# devbin: args = [--all | --list-guards]
# bin/devbin precommit [--all | --list-guards] -- run the guards that protect
# THIS repository's apparatus. Invoked by .githooks/pre-commit (the tracked
# hooks directory core.hooksPath points at) as `bin/int precommit "$@"`, after
# the shipped gate; safe to run by hand.
#
#   --all          force the path-triggered skew checks to sweep every view
#                  rather than the staged set
#   --list-guards  print the roster (`name<TAB>script-or-dash`) and exit 0;
#                  `int hooks` reads it
#
# Exits 1 when any guard blocks (each blocking guard is named in the summary),
# 0 otherwise. Only the first argument is read.
#
# WHY THIS IS NOT IN the shipped gate under lib/templates/hooks/ --
# `pre-commit.sh` (the critic gate) and the guard roster in
# `pre-commit-guards.sh` (the whiteboard clock and header guards among them).
# Those files are SHIPPED: every consumer project receives them via `intent
# claude upgrade --apply`. Most guards run here check
# `intent/st/ST0056/parity/**`, which exists in this repository and nowhere
# else. Putting an ST-specific check into the shipped canon would hand every
# consumer a gate for a steel thread they do not have, and it would outlive
# ST0056 in the canon forever. Repo-local guards get a repo-local runner.
#
# WHY ONE COMMAND FOR MANY GUARDS IS NOT THE EXIT-CODE OVERLOAD ic WARNED ABOUT.
# The defect in `intent critic` is that unrelated conditions share exit 2 with
# no way for the caller to tell them apart. Here each guard keeps its own
# invariant and its own message; this runner aggregates and NAMES the one that
# refused. The guards were also deliberately kept separate by vc's ruling --
# provenance checks that STAMPS AGREE (metadata), skew checks that CONTENT
# MATCHES CANON -- and nothing here merges them.
#
# COVERAGE IS REPORTED AS MEASURED, NEVER AS DESIGNED. view_skew covers only
# the apparatus views re-derivable from committed state (its CHECKABLE list:
# `surface/dispatch-table.md`); provenance groups the rest, for which the stamp
# is the only guard that exists. Do not write coverage figures into this file
# as constants -- the guards print what they actually checked, and a hard-coded
# figure rots the moment somebody adds an artefact.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"
# guard_verdict: the one reading of a guard's exit status.
# shellcheck source-path=SCRIPTDIR source=shared/guard.lib
. "$(dirname "${BASH_SOURCE[0]}")/shared/guard.lib"

# `--help` prints the usage block above and runs nothing; it ran the gate, every guard.
case "${1:-}" in
  -h | --help)
    awk 'NR < 5 { next } /^#$/ || !/^#/ { exit } { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
    ;;
esac

# THE GUARD ROSTER -- declared ONCE here and consumed TWICE: the run labels its
# steps from these names, and `--list-guards` prints them for `int hooks`.
#
# WHY THIS EXISTS AT ALL, and it is a defect I shipped. `int hooks` derived its
# roster by grepping `$TOOLS/[a-z]*.sh` out of this runner, and I wrote in its
# source that reading the names from the runner meant "the roster cannot rot".
# It rotted the same day: guard 0 below is implemented INLINE rather than as a
# script under `$TOOLS/`, so the grep could not see it and `int hooks` reported
# a gate enforcing fewer things than it does. Under-reporting what a
# gate enforces is worse than most defects, because the tool people consult to
# find out is the thing that is wrong.
#
# The error was anchoring on a PATH SHAPE rather than on the structural fact --
# my own watch-out about needles that stop matching when the prefix changes,
# self-inflicted one file over. The fix is the other Decision on my board: ASK
# THE TOOL, DO NOT REIMPLEMENT ITS RULE. The runner is the authority on what the
# runner checks, so it declares, and `int hooks` asks.
#
# Format is `name<TAB>repo-relative-script-or-dash`. A dash means the guard has
# no script to stat, which is a legitimate state and not a missing file -- the
# distinction `int hooks` needs in order to keep flagging a guard whose script
# has actually gone missing.
#
# THE PATH IS REPO-RELATIVE AND WHOLE, not a basename `int hooks` re-roots.
# It used to emit bare filenames and the reader prefixed the ST0056 tools
# directory, which quietly redefined the second field as "a script UNDER
# $TOOLS". The moment a guard's script lived anywhere else -- guard 0b then
# delegated to shipped canon under lib/ -- that reader had only wrong answers
# available and no right one: report a real script as MISSING, or emit
# a dash claiming there is none. Same anchoring error as the defect recorded
# above, one field along: the roster is the authority on what it checks AND on
# where those checks live.
#
# Guard 0b has since gone entirely (see below) and every remaining path is back
# under $TOOLS, so the case that motivated the whole-path field is not currently
# live. The field stays whole. A format narrowed to the population that happens
# to occupy it today is how the basename version got written in the first place.
G_NODB="no database enters history (D34: the DB is per-machine truth, never committed)"
G_PROV="provenance: artefacts from one measurement name one revision"
G_SKEW="skew: committed apparatus views still match their canon"
G_GENIN="generator inputs: git holds everything a committed artefact is made from"
G_ROSTER="roster: every parity instrument declares whether this gate runs it"
G_CORRECTED="corrected class: the ratified units and the claimed units are one set"
G_VOCAB="class vocabulary: a claimed parity class is one parity.md names"
G_RATIFIED="ratification provenance: a ratified row names authority, date and record"
G_RESIDUE="residue classes: migration.md matches what Phase A can actually emit"
G_STALEAT="stale AT rows: a to-write row whose cited test already exists"
G_SELFPROV="self-provenance: a vendored tree agrees with its COMMITTED record (gates), and each binary names its own source commit (REPORTS -- enforcement is at \`bin/devbin macos publish\`)"
G_CANONCOMMIT="canon currency: a commit carrying canon does not name bytes absent from that commit (ST0057 AC-03.6)"
G_GUARDHOME='guard home: a self-hosted tree runs ITS OWN guards, not the ones $INTENT_HOME points at'
G_SHAREDBUILD='shared build: a rebuild into the SHARED artefact path is refused when native/rust is dirty'
G_SKEWTHREAD="thread views: a generated thread view this commit touches still matches the model"
G_MACHINE="ratified machines: transitions.rs implements data-model.md exactly (entry states and every expanded from-to-verb edge)"
G_DECLKIND="declared kind: every AT row whose cited artefact EXISTS cites the kind of thing the row declared"
G_ABSENTAT="absent citation: every AT row claiming a VERDICT (green or red) cites an artefact that is actually there"
G_PIPEFAIL="pipefail/SIGPIPE: no instrument ends a pipeline in an early-exiting reader (it reads FALSE on a TRUE input)"
G_SUITEPATH="suite paths: every #[path] a staged suite.rs registers is in the commit (issue 0348)"
G_IDPATTERN="id patterns: no staged line adds a pattern for an id the census does not name (ST0095 AC-12.1)"

# THE WHITEBOARD HEADER GUARD IS NO LONGER LISTED HERE, and the precondition
# this file wrote for its own removal has been met. It read: "WHEN THIS BLOCK
# GOES AWAY: when `.git/hooks/pre-commit.intent` here is reinstalled from the
# updated canon, the shipped hook runs this guard itself and this call becomes
# the second of two." Reinstalled 2026-08-20; the shipped gate now dispatches it
# from the delegated roster in `lib/templates/hooks/pre-commit-guards.sh`.
#
# It was never merely redundant, which is why it is gone rather than left as a
# cheap double-check. It was COMPENSATION for a defect one layer down: the
# installed hook carried a frozen Aug 14 roster running only part of its
# guards, and this call papered over one of the missing ones. A local
# workaround for a shipped hole is the worst possible place for it -- it makes
# the hole invisible HERE, which is the one repository where somebody would
# have noticed. The guards it did not compensate for (`canon-ignore-guard.sh`,
# `append-only-guard.sh`) ran nowhere at all, and nothing said so.

if [ "${1:-}" = "--list-guards" ]; then
  printf '%s\t-\n' "$G_NODB"
  printf '%s\t%s\n' "$G_PROV" "intent/st/ST0056/parity/tools/provenance_check.sh"
  printf '%s\t%s\n' "$G_SKEW" "intent/st/ST0056/parity/tools/view_skew_check.sh"
  printf '%s\t%s\n' "$G_GENIN" "intent/st/ST0056/parity/tools/generator_inputs_check.sh"
  printf '%s\t%s\n' "$G_ROSTER" "intent/st/ST0056/parity/tools/runner_roster_check.sh"
  printf '%s\t%s\n' "$G_CORRECTED" "intent/st/ST0056/parity/tools/corrected_check.sh"
  printf '%s\t%s\n' "$G_VOCAB" "intent/st/ST0056/parity/tools/class_vocab_check.sh"
  printf '%s\t%s\n' "$G_RATIFIED" "intent/st/ST0056/parity/tools/rulings_check.sh"
  printf '%s\t%s\n' "$G_RESIDUE" "intent/st/ST0056/parity/tools/residue_class_check.sh"
  printf '%s\t%s\n' "$G_STALEAT" "intent/st/ST0056/parity/tools/stale_at_check.sh"
  printf '%s\t%s\n' "$G_SELFPROV" "intent/st/ST0056/parity/tools/self_provenance_check.sh"
  printf '%s\t%s\n' "$G_CANONCOMMIT" "intent/st/ST0056/parity/tools/canon_commit_check.sh"
  printf '%s\t%s\n' "$G_GUARDHOME" "intent/st/ST0056/parity/tools/guard_home_check.sh"
  printf '%s\t%s\n' "$G_SHAREDBUILD" "intent/st/ST0056/parity/tools/shared_artefact_build_guard.sh"
  printf '%s\t%s\n' "$G_SKEWTHREAD" "intent/st/ST0056/parity/tools/thread_view_skew_check.sh"
  printf '%s\t%s\n' "$G_MACHINE" "intent/st/ST0056/parity/tools/machine_table_check.sh"
  printf '%s\t%s\n' "$G_DECLKIND" "intent/st/ST0056/parity/tools/declared_kind_check.sh"
  printf '%s\t%s\n' "$G_ABSENTAT" "intent/st/ST0056/parity/tools/absent_at_check.sh"
  printf '%s\t%s\n' "$G_PIPEFAIL" "intent/st/ST0056/parity/tools/pipefail_sigpipe_check.sh"
  printf '%s\t%s\n' "$G_SUITEPATH" "intent/st/ST0056/parity/tools/suite_path_check.sh"
  printf '%s\t%s\n' "$G_IDPATTERN" "intent/st/ST0056/parity/tools/id_pattern_check.sh"
  exit 0
fi

TOOLS="${PROJECT_ROOT:?}/intent/st/ST0056/parity/tools"

# The staged set, which is what a pre-commit gate is entitled to have an opinion
# about. --diff-filter=ACM excludes deletions: a deleted path cannot be skewed
# against its canon, and feeding one to the skew check would ask it to compare a
# file that is not there.
#
# GIT'S STATUS IS READ, AND A FAILED READ REFUSES (issue 0731). An empty index
# is not a failure -- git exits 0 and prints nothing, so the gate finds nothing
# to do -- but a git that cannot read the index exits non-zero. The `|| true`
# and `2>/dev/null` that stood here took that failure for an empty set, so
# guard 0 could pass a database it never saw.
#
# index_read_failed <command> <what> <status> -- refuses the commit, naming the
# read and the command that failed. What guard 0 had already found by name is
# printed with it, so a refusal never loses a finding.
index_read_failed() {
  printf 'intent repo-local gate: commit blocked -- "%s" could not read %s (exit %s), so the gate stops here; git'"'"'s message is above\n' "$1" "$2" "$3" >&2
  [ -z "${staged_db:-}" ] || printf '  guard 0 had already found, before it stopped:\n%s' "$staged_db" >&2
  exit 1
}

# Computed BEFORE the apparatus check below, because guard 0 is not an ST0056
# guard and must outlive that directory.
STAGED="$(git diff --cached --name-only --diff-filter=ACM)" ||
  index_read_failed "git diff --cached --name-only" "the staged set" "$?"

# --all forces the full sweep regardless of what is staged, for running by hand.
FULL=0
[ "${1:-}" = "--all" ] && FULL=1

rc=0
failed=""

# THE ONE READING OF A GUARD'S EXIT STATUS IS guard_verdict, in shared/guard.lib
# (issues 0714, 0720 and 0724), and the cut's gates read their guards through it
# too. Every guard tool this gate runs is read through run_guard (issue 0725);
# guard 0 below is inline and has no exit status to read.
# run_guard "$TOOLS/<tool>" gating <finding> [-- <arg>...]
# run_guard "$TOOLS/<tool>" report-only [-- <arg>...]
#   runs <tool>, with each <arg> after `--`, as `x=0; bash <tool> || x=$?`,
#   never as a bare call, for the reason guard.lib gives, and adds its line to
#   the report through tool_verdict under its file name. A step names its tool
#   once, by the `$TOOLS/<tool>` that runner_roster_check.sh reads as its
#   execution site, and its guard's kind by name.
run_guard() {
  local tool="$1" x=0
  local -a verdict=()
  shift
  while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
    verdict+=("$1")
    shift
  done
  [ "$#" -eq 0 ] || shift
  bash "$tool" "$@" || x=$?
  tool_verdict "${tool##*/}" "$x" "${verdict[@]}"
}

# tool_verdict <tool> <status> <kind> [<finding>] -- adds <tool>'s line to the
# report, as guard_verdict reads <status> for a guard of <kind>: nothing for a
# pass, <finding> for a finding, and for no verdict its wording, then where to
# look. Only a gating guard has a <finding>, and one named without it is
# refused here, on every run, rather than at its first finding.
tool_verdict() {
  local verdict
  if [ "${3:-}" = gating ] && [ "$#" -ne 4 ]; then
    printf 'tool_verdict: %s is gating and is given %s word(s) after its kind, where it takes one finding; its tool'"'"'s own arguments go after --\n' "$1" "$(($# - 3))" >&2
    exit 2
  fi
  verdict="$(guard_verdict "$2" "${3:-}")"
  case "$verdict" in
    pass) ;;
    finding)
      rc=1
      failed="${failed}  $1 -- $4
"
      ;;
    *)
      rc=1
      failed="${failed}  $1 -- $verdict; its own message above, if any, says why
"
      ;;
  esac
}

# THE ONE PRESENCE CHECK FOR A GUARD'S TOOL (issue 0714). A summary that names a
# cause it did not establish is worse than one that names none, which the
# guard-home step below records cc meeting on real bytes, so a tool that is not
# on disk is named as missing and as saying nothing about its subject. When the
# whole apparatus is missing, its own refusal has already said so, with the
# remedy, and this adds nothing.
# tool_present <tool> <subject> -- true when $TOOLS/<tool> is on disk.
tool_present() {
  [ -f "$TOOLS/$1" ] && return 0
  [ "$HAVE_TOOLS" -eq 1 ] || return 1
  rc=1
  failed="${failed}  $1 -- THE INSTRUMENT IS MISSING, so nothing was checked. This says
    NOTHING about $2; the tool is not on disk.
"
  return 1
}

# 0. NO SQLITE DATABASE ENTERS HISTORY.
#
# D34 (hv, 2026-08-15): the SQLite db is per-machine durable truth and is NEVER
# committed -- truth travels as the lossless .json/.md extract and a clone
# reconstitutes through the ingest gate. So a DB in a commit is always wrong.
#
# WHY THIS IS A GUARD AND NOT A WIDER .gitignore GLOB, which was the obvious
# move and is the wrong one. vc ruled the ignore file stays a PATH rule: now
# that the DB is durable truth, a blanket `*.db` there asserts a durability
# policy about a whole class for every consumer of that file. It also cannot
# work -- `Store::open()` takes a path PARAMETER, so no list of paths is
# exhaustive by construction. The two mechanisms are not interchangeable:
# **an ignore silently hides the paths it already knows; a guard refuses the
# ones nobody thought of.** Only the second is load-bearing, and this repository
# is PUBLIC, so the cost of the miss is permanent and world-readable.
#
# TWO DETECTORS, because each closes a hole the other cannot see. By NAME
# catches the `-wal`/`-shm` companions, which are not SQLite-format files at all
# and carry their own headers. By CONTENT catches a database committed under any
# name at all, which is the case a name rule can never reach.
#
# It reads the STAGED BLOB (`git show :path`), never the worktree file. Those
# differ exactly when it matters, and the index is what would land -- the same
# reason a green suite is evidence about the tree you have and not the tree you
# pushed.
step "$G_NODB"
staged_db=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    *.db | *.db-wal | *.db-shm | *.sqlite | *.sqlite3)
      staged_db="${staged_db}    $p   (by name)
"
      ;;
  esac
done <<<"$STAGED"

# Content-probe only the paths git already calls binary -- numstat prints `-`
# for both counts on a binary blob. A SQLite file is always binary, so this
# loses nothing and keeps `git show` off every text file in a large commit.
# --no-renames because the rename form prints a path pair this would misread.
BINARIES="$(git diff --cached --numstat --no-renames --diff-filter=ACM | awk '$1 == "-" && $2 == "-" { print $3 }')" ||
  index_read_failed "git diff --cached --numstat | awk" "the staged binaries" "$?"
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    *.db | *.db-wal | *.db-shm | *.sqlite | *.sqlite3) continue ;; # already named above
  esac
  # GIT'S OWN STATUS IS READ HERE TOO (issue 0731). `head -c` closes the pipe
  # early and git dies of SIGPIPE, 141, which is no failure; so pipefail is off
  # inside, and git's status is the substitution's, its 141 read as 0. Any other
  # status is a blob git could not read: the `|| true` that stood here took it
  # for "not SQLite" and passed a database it never read.
  magic="$(
    set +o pipefail
    git show ":$p" | head -c 15
    s="${PIPESTATUS[0]}"
    [ "$s" -ne 141 ] || s=0
    exit "$s"
  )" || index_read_failed "git show :$p" "the staged blob $p" "$?"
  if [ "$magic" = "SQLite format 3" ]; then
    staged_db="${staged_db}    $p   (by CONTENT -- SQLite magic under a name that does not say so)
"
  fi
done <<<"$BINARIES"

if [ -n "$staged_db" ]; then
  rc=1
  failed="${failed}  a SQLite database is staged -- D34 says the DB is never committed
${staged_db}"
fi

# A MISSING APPARATUS IS A REFUSAL, NAMED WHERE IT IS FOUND (issue 0714). This
# directory is a thread's realised tree, so dehydrating, renumbering or
# re-keying ST0056 takes every guard below with it. It was a warning that the
# gates were SKIPPED, written for the day ST0056's close would take the
# directory away legitimately; ST0056 closed and the gate still depends on it.
# Behind that warning, the two guards that look for their own tools refused the
# commit, but the suite-path step ran its missing tool as a bare call and `set
# -e` ended the gate at 127 before the summary naming them printed, so the one
# line the reader got said the other guards had run.
#
# Guard 0 above has already run and its verdict is carried to the report at the
# bottom: a missing apparatus does not turn a staged database into a pass.
HAVE_TOOLS=1
if [ ! -d "$TOOLS" ]; then
  # NO COUNT IN THIS MESSAGE, DELIBERATELY, AND THE ABSENCE IS THE FIX. It
  # carried a literal count from the day dc wrote it (b186a0f3), and the literal
  # rotted silently through every addition behind this branch -- so at the one
  # moment coverage is degraded, the message a human reads understated the gap.
  # A count here, or a list of the guards that did run, can only ever be a second
  # copy of the roster above, and the copy is the half nobody updates.
  rc=1
  failed="${failed}  no ST0056 parity apparatus at $TOOLS -- none of the guards that live there ran, so
    this commit is unchecked rather than clean. Remedy: \`intent st hydrate ST0056\`.
"
  HAVE_TOOLS=0
fi

# A TOOL NAMES ITS OWN REFUSAL, AND A FINDING LABEL BELOW SAYS ONLY WHAT ITS
# TOOL'S 1 MEANS (vc's ruling, 2026-09-15, read through guard_verdict since issue
# 0725). A label naming one finding read any refusal as that finding:
# `provenance_check.sh` was labelled "a measurement group names more than one
# revision" while it refused a stamp that belonged to no group, and the label
# sent the committer after a split group that did not exist. A tool whose 1 is
# any refusal is labelled REFUSED, defined here once.
REFUSED="refused; its message above names why"

# 1. Provenance. Always runs the full sweep: it is cheap (its span is recorded
#    in runner_roster_check.sh's ROSTER), and its invariant is CROSS-artefact -- staging one file of a measurement
#    group is exactly when the group can be split, so narrowing it to the staged
#    set would blind it to the failure it exists to catch.
if [ "$HAVE_TOOLS" -eq 1 ]; then
  step "$G_PROV"
  run_guard "$TOOLS/provenance_check.sh" gating "$REFUSED"

  # The staged paths as the two skew checks below take them, `--changed` and one
  # argument per path, or nothing for a full sweep (--all) or an empty index.
  # Unquoted expansion is wrong here and this shell is zsh for interactive use,
  # so the argv is built explicitly rather than by word splitting.
  changed_args=()
  if [ "$FULL" -eq 0 ] && [ -n "$STAGED" ]; then
    changed_args=(--changed)
    while IFS= read -r p; do
      [ -n "$p" ] && changed_args+=("$p")
    done <<<"$STAGED"
  fi

  # 2. View skew. Path-triggered by design: a slow gate gets --no-verify'd, which
  #    is cry-wolf arriving through a different door. It is sound rather than a
  #    fudge -- a generator reads only its canon, so a view cannot go stale unless
  #    canon, generator or view changes, and all three are paths.
  step "$G_SKEW"
  run_guard "$TOOLS/view_skew_check.sh" gating "$REFUSED" -- "${changed_args[@]}"

  # 2b. Thread views. The SIBLING of the check above and a different population:
  #     the CHECKABLE in view_skew_check.sh covers only surface/, so thread
  #     covers, acceptance contracts and WP covers had no gated skew coverage.
  #     This asks views::skew (through `intent doctor`) for one answer rather than
  #     computing a second, so there is still exactly one home for the question.
  #
  #     `--changed` HERE NARROWS WHAT BLOCKS, NOT WHAT IS CHECKED, and dispatching
  #     without it would be the blast-radius error this repo has already paid for.
  #     Every view is examined either way and the cost is identical; the flag
  #     decides whether skew in a path this commit never touched BLOCKS or is
  #     REPORTED. Peer nodes share this checkout, so the unnarrowed form would
  #     stop every node on a stale view none of them wrote, and a guard that must
  #     be bypassed is a guard nobody keeps.
  #
  #     WITH NO v3 BINARY at native/rust/target/release/intent THE TOOL REFUSES
  #     (exit 2), IT DOES NOT SKIP (hv ruling 4 as scoped by vc 2026-08-27), so
  #     this commit blocks. Its message separates the TRANSIENT case -- a release
  #     directory exists, so a rebuild is removing and rewriting the artefact:
  #     wait and retry -- from a tree that was never built, where the remedy is
  #     `bin/devbin build all`.
  step "$G_SKEWTHREAD"
  run_guard "$TOOLS/thread_view_skew_check.sh" gating "this commit touches a generated thread view that no longer matches the model; the finding above names it" -- "${changed_args[@]}"

  # 3. Generator inputs. NOT path-triggered, unlike the skew check above, and the
  #    difference is the invariant rather than an inconsistency. Skew asks "does
  #    this view still match its canon", which only changes when a path changes.
  #    This asks "does git hold what this generator reads", and that can go false
  #    with NO path in this repository changing at all -- someone deletes a
  #    scratchpad, or reboots. It is a whole-set check over the `gen_*.sh`
  #    generators the index holds, so it is cheap to run every time.
  step "$G_GENIN"
  run_guard "$TOOLS/generator_inputs_check.sh" gating "$REFUSED"

  # 4. Instrument disposition -- the roster that says whether the list ABOVE is
  #    the whole of what runs. Issue 0059: most instruments in the tools
  #    directory had no execution site, some of them CITED BY A GREEN
  #    ACCEPTANCE ROW. Every individual record was correct; nothing joined "this
  #    tool exists" to "something runs it".
  #
  #    IT GATES ON ITS FINDINGS, unlike the report-only register checks below,
  #    and the asymmetry is principled rather than a mood. Those are report-only
  #    because most of
  #    their hits are a legitimate mid-ladder state -- a command not wired yet,
  #    a row not ratified yet. There is no legitimate state in which a tool
  #    exists and its disposition is undeclared: the fix is one line in the
  #    roster, and forcing it on the day the tool ARRIVES is the entire point.
  #    The roster is the only artefact here that cannot rot by omission.
  step "$G_ROSTER"
  run_guard "$TOOLS/runner_roster_check.sh" gating "the roster in runner_roster_check.sh and this runner disagree; the finding above names each tool"

  # THE REGISTER CHECKS. corrected_check.sh, class_vocab_check.sh and
  # stale_at_check.sh are REPORT-ONLY BY CONSTRUCTION: each exits 0 whether it
  # is clean or has findings, and non-zero ONLY when it cannot measure at all.
  # rulings_check.sh and residue_class_check.sh are NOT: each exits 1 on a
  # finding (a malformed or dangling ruling; declared and emitted residue
  # classes that disagree), and that blocks, as their summary lines below say.
  #
  # So a refusal from a report-only check is never "the register is wrong" --
  # it is "this instrument could not answer", which is a broken instrument.
  # That distinction is not academic: corrected_check.sh spent a day dying at
  # exit 2 for every corrected row, because a ratification had been written
  # into a field it does not read. The refusal was correct, loud, and by
  # design, and it sat through a fold and a compact under a board reading
  # "nothing blocked" -- because nothing ran it. A refusal and a silence look
  # the same to anyone not looking.
  #
  # The report-only checks' FINDINGS print above and do not block. Read them;
  # that is the whole reason they are here rather than in somebody's shell
  # history. All three are read as `report-only` (issue 0724).
  step "$G_CORRECTED"
  run_guard "$TOOLS/corrected_check.sh" report-only

  step "$G_VOCAB"
  run_guard "$TOOLS/class_vocab_check.sh" report-only

  # The pipefail/SIGPIPE class in our own instruments. IT GATES, unlike the
  # report-only checks above: a finding here is a live defect in a checker, and the reason it needs
  # a gate rather than a sweep is that it is invisible to every other instrument
  # -- a lost race has the same exit code, the same silence and the same green
  # as a clean run. Exit 2 is the tool refusing to report, for the cause its own
  # message names, and no refusal is a finding or may read as one.
  step "$G_PIPEFAIL"
  run_guard "$TOOLS/pipefail_sigpipe_check.sh" gating "an instrument ends a pipeline in grep with -q, which reads FALSE on a TRUE input under pipefail; the finding above names the file and line"

  # The ratified state machines against their transcription. It is here rather
  # than beside the view-skew guards because what it compares is two HAND-KEPT
  # documents, not a generated artefact against its source: `transitions.rs`
  # says "transcribed" in its comments and nothing was checking the claim, so
  # hv`s `Fiat` ruling reached the code and left the ratified table stale with
  # no instrument able to see it (2026-08-29, found by eye).
  step "$G_MACHINE"
  run_guard "$TOOLS/machine_table_check.sh" gating "the ratified machines in intent/st/ST0056/data-model.md and their transcription in native/rust/crates/intentsvcs/src/transitions.rs disagree. Fix the side that moved: a CODE-ONLY edge means a ruling never reached the table it was ratified in."

  # A row declares its artefact KIND by the path it cites, and nothing else in
  # this gate reads that declaration. `stale_at_check.sh` catches a `to-write`
  # row citing a file that EXISTS; it cannot catch a row whose file exists and
  # is a library, a data producer, or a Rust file with no test in it. WHOLE-SET
  # AND NEVER PATH-TRIGGERED, for machine_table_check.sh`s reason: the failure
  # is a disagreement between a row and an artefact, so a path trigger would
  # have to fire on whichever of the two the commit does not carry.
  step "$G_DECLKIND"
  run_guard "$TOOLS/declared_kind_check.sh" gating "a row cites an artefact that is not the KIND the row declared. Repoint the row at what actually satisfies it, or build the kind the row declared. A green here is about agreement AT THE DECLARED PATH and says nothing about an orphaned artefact at a path no row cites."

  # The mirror of stale_at_check.sh, and the direction nothing watched. That one
  # catches a to-write row whose cited test EXISTS; this catches a green or red
  # row whose cited file is ABSENT. A green row is what `ac status` and the close
  # gate COUNT, so a green citing nothing is a claim with no referent being
  # tallied as a claim with one -- and it is invisible to inspection, because a
  # green row looks like every other green row. WHOLE-SET for the same reason as
  # its neighbours above.
  step "$G_ABSENTAT"
  run_guard "$TOOLS/absent_at_check.sh" gating "a green or red AT row cites a file that is not there. A row whose subject is gone is RETIRED, not left green: withdraw the AC it covers and move the row to a non-test n/a with the reason in its prose. This gate says the file is THERE and never that its assertions can still fail -- present-and-hollow is outside its reach, and is the case that produced it."

  step "$G_RATIFIED"
  run_guard "$TOOLS/rulings_check.sh" gating "a declared ruling is malformed or its record leads nowhere. Re-anchor a dangling record on an artefact whose content carries the ruling -- grep the target first; an anchor that resolves to the record's own rendering is circular and worse than the dangle."

  step "$G_RESIDUE"
  run_guard "$TOOLS/residue_class_check.sh" gating "migration.md's residue table and the classes the scanner emits disagree; the finding above names each class"

  step "$G_STALEAT"
  run_guard "$TOOLS/stale_at_check.sh" report-only

  # 10. Self-provenance (AC-11.5). Reads the INDEX and never the worktree, which
  #     is the whole reason it catches anything: on 2026-08-17 HEAD carried a
  #     manifest disagreeing with the file beside it for two hours while every
  #     local check was green, because an uncommitted regeneration had made the
  #     WORKTREE agree with itself. A tree agreeing with itself is not the tree
  #     agreeing with the record, and only the index answers the second.
  #
  #     NOT path-triggered. A re-vendor is TWO FACTS -- the files and the record
  #     -- and the failure is staging one of them, so the trigger would have to
  #     fire on the path that ISN'T there. Whole-set; its span is recorded in
  #     runner_roster_check.sh's ROSTER.
  step "$G_SELFPROV"
  # Exit 2 is the tool's own hard stop -- a lib it cannot read, and the like -- and
  # it still stops the commit; only the REASON differs, because "the vendored tree
  # disagrees" is a finding the tool never reached (vc's ruling, 2026-09-15).
  run_guard "$TOOLS/self_provenance_check.sh" gating "the commit's vendored tree disagrees with the manifest committed beside it"

  # 12. Canon currency (ST0057 AC-03.6). A commit that carries canon must not name
  #     bytes no commit contains -- canon is committed and never sparse, so a canon
  #     edit referencing an attachment that is not in the same commit publishes a
  #     record pointing at nothing.
  #
  #     ADMITTED 2026-08-21 (dc) ON hv's RELEASE, and the roster's own reason for
  #     holding it had TWO parts, both re-derived here rather than taken on report:
  #       - "there is no narrow attachment-sync verb": DEAD. `sync --to-store [ID]...`
  #         takes positional ids, landed at `212b0075`, so the order a gate permits
  #         (sync the one thread, then commit file and canon together) is open.
  #       - "--staged is not supported": DEAD. canon_commit_check.sh parses the
  #         flag and reads `git diff-index --cached HEAD`, so it judges the INDEX.
  #
  #     ALWAYS `--staged`, NEVER PATH-TRIGGERED, and that is a ruling rather than an
  #     oversight. The tool already narrows internally; a path trigger here would be
  #     a SECOND copy of that narrowing, which is the drift the roster exists to stop.
  #     It is the whole point that this differs from the skew check above -- skew asks
  #     a question only a path change can alter, this asks whether the index is
  #     internally consistent, which staging one half of a pair makes false.
  #
  #     COST: the most expensive guard in this runner. Its measured span lives in
  #     runner_roster_check.sh's ROSTER, whose header says to RE-TIME BEFORE
  #     MOVING A ROW ON COST GROUNDS and to record the span with its method; read
  #     the figure there rather than from a copy here.
  step "$G_CANONCOMMIT"
  run_guard "$TOOLS/canon_commit_check.sh" gating "the index names attachment bytes it does not hold; the finding above names each and the order that fixes it" -- --staged
fi

# GUARD HOME. UNCONDITIONAL AND NOT PATH-TRIGGERED, because the failure it
# catches is a DELETION and a path trigger keyed to the template would not fire
# on a commit that removes the branch from somewhere else -- or, worse, would
# fire only on the commit that breaks it and never again. Grepping the committed
# hook template is too cheap to be worth a trigger to avoid.
step "$G_GUARDHOME"
# THE ABSENT CASE IS NAMED SEPARATELY, AND cc FOUND THIS ON REAL BYTES BEFORE IT
# COULD SHIP. The summary line used to assert ONE cause -- "the template lost the
# override" -- for EVERY non-zero exit, including exit 127 when the tool itself is
# missing. cc's commit hit exactly that while the file was momentarily off the
# tree, and the gate told them their template was broken. It was not.
#
# A summary that names a cause it did not establish is worse than one that names
# none: it sends the reader at a file that is fine, with the gate's authority
# behind it. Same class as `unwired`s leaf remedy pointing at an empty help block.
if tool_present guard_home_check.sh "the hook template"; then
  run_guard "$TOOLS/guard_home_check.sh" gating "$REFUSED"
fi

# AC-11.6. `native/rust/target/release/` is shared by every node here with no
# per-node isolation underneath it, and until 2026-08-25 the only control over
# what entered it was the convention *do not rebuild while I am measuring*. A
# control that looks like a courtesy is the one that gets dropped the first time
# somebody is in a hurry, which is roughly what happened at 19:33Z on 2026-08-18:
# a build from a tree carrying uncommitted WP-01 source produced a
# working-looking binary that emptied the store for every node until rebuilt.
#
# THE TWO CASES ARE NAMED SEPARATELY FOR THE REASON THE GUARD ABOVE RECORDS. An
# absent instrument and a real finding are different sentences, and a summary
# that names a cause it did not establish sends the reader at a file that is
# fine, with the gate's authority behind it.
step "$G_SHAREDBUILD"
if tool_present shared_artefact_build_guard.sh "the build path"; then
  run_guard "$TOOLS/shared_artefact_build_guard.sh" gating "$REFUSED"
fi

# Issue 0348: a suite.rs registration whose file the commit does not carry
# builds on the machine that has the file and nowhere else. The guard reads the
# INDEX, and runs its own red and green controls before its verdict.
step "$G_SUITEPATH"
if tool_present suite_path_check.sh "the suite registrations"; then
  run_guard "$TOOLS/suite_path_check.sh" gating "a suite.rs registers a test module this commit does not carry; the finding above names it"
fi

# ST0095 AC-12.1: no script, hook, template or workflow gains a pattern for an
# id. The guard judges the whole INDEX against HEAD: the sites that carry one
# are its census, which only shrinks. It runs its own control, in a scratch
# repository, before its verdict; its header says the rest.
step "$G_IDPATTERN"
if tool_present id_pattern_check.sh "the id patterns"; then
  run_guard "$TOOLS/id_pattern_check.sh" gating "a line spells an id's shape the census does not name, a census row names a site that is gone, or the census grew; the finding above names each"
fi

if [ "$rc" -ne 0 ]; then
  printf '\n' >&2
  printf 'intent repo-local gate: commit blocked.\n' >&2
  printf '%s' "$failed" >&2
  # Where the apparatus is missing, its remedy is the only one, and no guard
  # printed an artefact to regenerate.
  if [ "$HAVE_TOOLS" -eq 1 ]; then
    printf '  each guard printed the specific artefact above; regenerate it and re-stage.\n' >&2
  fi
  printf '  to bypass (use sparingly): git commit --no-verify\n' >&2
  exit 1
fi

exit 0
