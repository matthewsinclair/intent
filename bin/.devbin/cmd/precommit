#!/usr/bin/env bash
#
# devbin: summary = Run this repo's local commit gates (ST0056 apparatus guards)
#
# intent precommit [--all] -- run the guards that protect THIS repository's
# apparatus. Invoked by .git/hooks/pre-commit; safe to run by hand.
#
# WHY THIS IS NOT IN lib/templates/hooks/pre-commit.sh, which is where the
# critic gate and the whiteboard clock guard live. That file is SHIPPED: every
# consumer project receives it via `intent claude upgrade --apply`. The two
# guards run here check `intent/st/ST0056/parity/**`, which exists in this
# repository and nowhere else. Putting an ST-specific check into the shipped
# canon would hand every consumer a gate for a steel thread they do not have,
# and it would outlive ST0056 in the canon forever. Repo-local guards get a
# repo-local runner.
#
# WHY ONE COMMAND FOR TWO GUARDS IS NOT THE EXIT-CODE OVERLOAD ic WARNED ABOUT.
# The defect in `intent critic` is that four unrelated conditions share exit 2
# with no way for the caller to tell them apart. Here each guard keeps its own
# script, its own invariant and its own message; this runner aggregates and
# NAMES the one that refused. The guards were also deliberately kept separate
# by vc's ruling -- provenance checks that STAMPS AGREE (metadata), skew checks
# that CONTENT MATCHES CANON -- and nothing here merges them.
#
# COVERAGE IS REPORTED AS MEASURED, NEVER AS DESIGNED. Measured 2026-08-15:
# view_skew covers ONE of thirty apparatus views (`dispatch-table.md` is the
# only one re-derivable from committed state); provenance groups the other 29,
# for which the stamp is the only guard that exists. Do not write those numbers
# into this file as constants -- the guards print what they actually checked,
# and a hard-coded figure rots the moment somebody adds artefact 31.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

# THE GUARD ROSTER -- declared ONCE here and consumed TWICE: the run labels its
# steps from these names, and `--list-guards` prints them for `int hooks`.
#
# WHY THIS EXISTS AT ALL, and it is a defect I shipped. `int hooks` derived its
# roster by grepping `$TOOLS/[a-z]*.sh` out of this runner, and I wrote in its
# source that reading the names from the runner meant "the roster cannot rot".
# It rotted the same day: guard 0 below is implemented INLINE rather than as a
# script under `$TOOLS/`, so the grep could not see it and `int hooks` reported
# a gate enforcing two things when it enforces three. Under-reporting what a
# gate enforces is worse than most defects, because the tool people consult to
# find out is the thing that is wrong.
#
# The error was anchoring on a PATH SHAPE rather than on the structural fact --
# my own watch-out about needles that stop matching when the prefix changes,
# self-inflicted one file over. The fix is the other Decision on my board: ASK
# THE TOOL, DO NOT REIMPLEMENT ITS RULE. The runner is the authority on what the
# runner checks, so it declares, and `int hooks` asks.
#
# Format is `name<TAB>script-or-dash`. A dash means the guard has no script to
# stat, which is a legitimate state and not a missing file -- the distinction
# `int hooks` needs in order to keep flagging a guard whose script has actually
# gone missing.
G_NODB="no database enters history (D34: the DB is per-machine truth, never committed)"
G_PROV="provenance: artefacts from one measurement name one revision"
G_SKEW="skew: committed generated views still match their canon"
G_GENIN="generator inputs: git holds everything a committed artefact is made from"

if [ "${1:-}" = "--list-guards" ]; then
  printf '%s\t-\n' "$G_NODB"
  printf '%s\t%s\n' "$G_PROV" "provenance_check.sh"
  printf '%s\t%s\n' "$G_SKEW" "view_skew_check.sh"
  printf '%s\t%s\n' "$G_GENIN" "generator_inputs_check.sh"
  exit 0
fi

TOOLS="${PROJECT_ROOT:?}/intent/st/ST0056/parity/tools"

# The staged set, which is what a pre-commit gate is entitled to have an opinion
# about. --diff-filter=ACM excludes deletions: a deleted path cannot be skewed
# against its canon, and feeding one to the skew check would ask it to compare a
# file that is not there.
#
# `|| true` is load-bearing rather than defensive noise: git exits non-zero when
# nothing is staged, and under `set -e` that would abort the gate instead of
# letting it correctly find nothing to do. (This is the same shape that killed
# ic's generator -- a legitimately-empty pipeline aborting the whole script.)
#
# Computed BEFORE the apparatus check below, because guard 0 is not an ST0056
# guard and must outlive that directory.
STAGED="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)"

# --all forces the full sweep regardless of what is staged, for running by hand.
FULL=0
[ "${1:-}" = "--all" ] && FULL=1

rc=0
failed=""

# 0. NO SQLITE DATABASE ENTERS HISTORY.
#
# D34 (hv, 2026-08-15): the intentdb is per-machine durable truth and is NEVER
# committed -- truth travels as the lossless .json/.md extract and a clone
# reconstitutes through the ingest gate. So a DB in a commit is always wrong.
#
# WHY THIS IS A GUARD AND NOT A WIDER .gitignore GLOB, which was the obvious
# move and is the wrong one. vc ruled the ignore file stays a PATH rule: now
# that the DB is durable truth, a blanket `*.db` there asserts a durability
# policy about a whole class for every consumer of that file. It also cannot
# work -- `Store::open()` takes a path PARAMETER, so no list of paths is
# exhaustive by construction. The two mechanisms are not interchangeable:
# **an ignore silently hides the paths it already knows; a guard refuses the
# ones nobody thought of.** Only the second is load-bearing, and this repository
# is PUBLIC, so the cost of the miss is permanent and world-readable.
#
# TWO DETECTORS, because each closes a hole the other cannot see. By NAME
# catches the `-wal`/`-shm` companions, which are not SQLite-format files at all
# and carry their own headers. By CONTENT catches a database committed under any
# name at all, which is the case a name rule can never reach.
#
# It reads the STAGED BLOB (`git show :path`), never the worktree file. Those
# differ exactly when it matters, and the index is what would land -- the same
# reason a green suite is evidence about the tree you have and not the tree you
# pushed.
step "$G_NODB"
staged_db=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    *.db | *.db-wal | *.db-shm | *.sqlite | *.sqlite3)
      staged_db="${staged_db}    $p   (by name)
"
      ;;
  esac
done <<<"$STAGED"

# Content-probe only the paths git already calls binary -- numstat prints `-`
# for both counts on a binary blob. A SQLite file is always binary, so this
# loses nothing and keeps `git show` off every text file in a large commit.
# --no-renames because the rename form prints a path pair this would misread.
BINARIES="$(git diff --cached --numstat --no-renames --diff-filter=ACM 2>/dev/null | awk '$1 == "-" && $2 == "-" { print $3 }' || true)"
while IFS= read -r p; do
  [ -n "$p" ] || continue
  case "$p" in
    *.db | *.db-wal | *.db-shm | *.sqlite | *.sqlite3) continue ;; # already named above
  esac
  # `|| true` on the pipeline: `head -c` closes the pipe early, git dies of
  # SIGPIPE, and pipefail would abort the whole gate over a file that is merely
  # shorter than the probe.
  magic="$( (git show ":$p" 2>/dev/null | head -c 15) 2>/dev/null || true)"
  if [ "$magic" = "SQLite format 3" ]; then
    staged_db="${staged_db}    $p   (by CONTENT -- SQLite magic under a name that does not say so)
"
  fi
done <<<"$BINARIES"

if [ -n "$staged_db" ]; then
  rc=1
  failed="${failed}  a SQLite database is staged -- D34 says the DB is never committed
${staged_db}"
fi

# Named, not silent -- the clock guard's precedent. Apparatus present with no
# guard behind it is the invisible non-enforcement this mechanism exists to end,
# and after ST0056 closes this directory will legitimately go away. Either way
# the operator is told which it is rather than getting a green.
#
# Guard 0 above has already run and its verdict is carried to the report at the
# bottom: a missing apparatus skips the ST0056 guards, it does not turn a staged
# database into a pass.
HAVE_TOOLS=1
if [ ! -d "$TOOLS" ]; then
  warn "no ST0056 parity apparatus at $TOOLS -- those two gates SKIPPED this commit."
  HAVE_TOOLS=0
fi

# 1. Provenance. Always runs the full sweep: it is three greps over 29 files,
#    and its invariant is CROSS-artefact -- staging one file of a measurement
#    group is exactly when the group can be split, so narrowing it to the staged
#    set would blind it to the failure it exists to catch.
if [ "$HAVE_TOOLS" -eq 1 ]; then
  step "$G_PROV"
  if ! bash "$TOOLS/provenance_check.sh"; then
    rc=1
    failed="${failed}  provenance_check.sh -- a measurement group names more than one revision
"
  fi

  # 2. View skew. Path-triggered by design: a slow gate gets --no-verify'd, which
  #    is cry-wolf arriving through a different door. It is sound rather than a
  #    fudge -- a generator reads only its canon, so a view cannot go stale unless
  #    canon, generator or view changes, and all three are paths.
  step "$G_SKEW"
  if [ "$FULL" -eq 1 ] || [ -z "$STAGED" ]; then
    skew_run=(bash "$TOOLS/view_skew_check.sh")
  else
    # Unquoted expansion is wrong here and this shell is zsh for interactive use,
    # so build the argv explicitly rather than relying on word splitting.
    skew_run=(bash "$TOOLS/view_skew_check.sh" --changed)
    while IFS= read -r p; do
      [ -n "$p" ] && skew_run+=("$p")
    done <<<"$STAGED"
  fi
  if ! "${skew_run[@]}"; then
    rc=1
    failed="${failed}  view_skew_check.sh -- a committed view no longer matches its canon
"
  fi

  # 3. Generator inputs. NOT path-triggered, unlike the skew check above, and the
  #    difference is the invariant rather than an inconsistency. Skew asks "does
  #    this view still match its canon", which only changes when a path changes.
  #    This asks "does git hold what this generator reads", and that can go false
  #    with NO path in this repository changing at all -- someone deletes a
  #    scratchpad, or reboots. It is a whole-set check over four files and reads
  #    only the index, so it costs nothing to run every time.
  step "$G_GENIN"
  if ! bash "$TOOLS/generator_inputs_check.sh"; then
    rc=1
    failed="${failed}  generator_inputs_check.sh -- a committed artefact names an input git cannot hold
"
  fi
fi

if [ "$rc" -ne 0 ]; then
  printf '\n' >&2
  printf 'intent repo-local gate: commit blocked.\n' >&2
  printf '%s' "$failed" >&2
  printf '  each guard printed the specific artefact above; regenerate it and re-stage.\n' >&2
  printf '  to bypass (use sparingly): git commit --no-verify\n' >&2
  exit 1
fi

exit 0
