#!/usr/bin/env bash
#
# devbin: summary = Build this project's artefacts, and cut its releases
#
# intent build <cli|release> ...
#
#   cli      [cargo opts]   the Rust CLI binary        -> cmd/build.d/cli
#   release  <bump|vX.Y.Z>  cut, tag and publish       -> cmd/build.d/release
#
# Both subs are routed straight to their handler by the descent; what arrives
# here is bare, -h, and mistakes. There is deliberately no `all`: one arm
# compiles a binary and the other publishes a release, and no one wants those
# in a single pass.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

case "${1:-}" in
  ""|-h|--help)
    sed -n '5,14p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
    exit 0
    ;;
  *)
    die "unknown build target: $1 (try: cli, release)"
    ;;
esac
