#!/usr/bin/env bash
#
# devbin: summary = Build this project's artefacts, and cut its releases
#
# bin/devbin build <all|cli|daemon|release> ...
#
#   all      [--debug] [cargo opts]  intent + intentd, release profile by default
#   cli      [--debug] [cargo opts]  the intent CLI binary (cargo -p intent-cli)
#   daemon   [--debug] [cargo opts]  the intentd daemon binary (cargo -p intentd)
#   release  <--patch|--minor|--major|vX.Y.Z> [flags]  cut, tag and publish
#
# `all` without --debug is the guarded release build: a dirty tree builds into
# native/rust/target/private/release; a clean one is verified and then promoted
# into native/rust/target/release. `cli` and `daemon` refuse a release build of
# one binary unless CARGO_TARGET_DIR is set. Extra arguments, --help included,
# go to cargo; `release` answers its own --help. Each arm is a handler under
# cmd/build.d/, and this file answers only bare, -h/--help and unknown targets.
#
# `all` means all BINARIES and pointedly not `release`: one arm compiles a
# binary and the other publishes a release, and no one wants both in one pass.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

case "${1:-}" in
  ""|-h|--help)
    sed -n '5,20p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
    exit 0
    ;;
  *)
    die "unknown build target: $1 (try: cli, daemon, all, release)"
    ;;
esac
