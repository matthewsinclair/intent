#!/usr/bin/env bash
#
# devbin: summary = Build this project's artefacts
# devbin: args = <all|cli|daemon> ...
# bin/devbin build <all|cli|daemon> ...
#
#   all      [--debug] [cargo opts]  intent + intentd, release profile by default
#   cli      [--debug] [cargo opts]  the intent CLI binary (cargo -p intent-cli)
#   daemon   [--debug] [cargo opts]  the intentd daemon binary (cargo -p intentd)
#
# `all` without --debug is the guarded release build: a tree with uncommitted
# changes under its build inputs (native/rust, surface, docs/design,
# lib/templates) builds into native/rust/target/private/release; a clean one is
# verified and then promoted into native/rust/target/release. `cli` and `daemon`
# refuse a release build of one binary unless CARGO_TARGET_DIR is set. Extra
# arguments reach cargo as given only with --debug: without it `all` cleans and
# verifies the pair around them, so --help is no way to reach cargo's help.
# Each arm is a handler under cmd/build.d/, and this file answers only bare,
# -h/--help and unknown targets.
#
# A release is cut by devbin's release core, `bin/devbin release vX.Y.Z`, and
# not here: `all` compiles the binaries and nothing in this command publishes.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

case "${1:-}" in
  ""|-h|--help)
    sed -n '5,22p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
    exit 0
    ;;
  *)
    die "unknown build target: $1 (try: cli, daemon, all; a release is \`bin/devbin release vX.Y.Z\`)"
    ;;
esac
