#!/usr/bin/env bash
#
# devbin: summary = Sign and notarise the macOS release binaries with the Geodica Developer ID
#
# intent macos <subcommand>  -- run `int macos` with no arguments for the list.
#
# THE SUBCOMMAND LIST LIVES IN usage() AT THE FOOT OF THIS FILE, not here, and it
# moved for a reason worth keeping. The help used to be `sed -n '5,15p'` of this
# header -- a hard-coded line range over a block that grows every time a
# subcommand is added. Adding one pushes the last entry past line 15 and the help
# silently stops listing it: no error, no truncation marker, just a command that
# has stopped being discoverable. **A help text that can go quietly out of date is
# the one place that must not.** One definition, printed and read from the same
# string.
#
# hv, 2026-08-15: "Having Intent properly signed using my Geodica Apple Developer
# Connection keys is the right way to go regardless of whether or not brew needs
# it." So this is not conditional on the Gatekeeper analysis -- ad-hoc happens to
# survive the brew path, and signing properly is the decision anyway.
#
# PORTED FROM LAMPLIGHT (`bin/.devbin/cmd/macos.d/`), which signs the lamplight
# CLI and Wrighter.app with the same Geodica ADC, team 76BQL8L47U. Ported rather
# than reinvented: the credential model, the codesign flags and the notarytool
# flow are all theirs. **This is a fraction of theirs and deliberately one file**
# -- Intent ships two bare Mach-O CLI binaries with no .app bundle, no nested
# executables, no entitlements and no installer pkg, so the inside-out bundle
# walk and the productsign half have no counterpart here. Splitting five short
# subcommands into a `.d/` would only strand the shared credential lookup.
#
# CREDENTIALS LIVE IN THE LOGIN KEYCHAIN AND NOWHERE ELSE. No key material in
# this repository, in CI config, or in any file this writes. `store-creds` is
# interactive and runs once per machine. Nothing here ever prints a secret --
# `env` and `doctor` report PRESENT/MISSING, never a value.
#
# THE THING THAT WILL LOOK LIKE A BUG AND IS NOT: **a bare Mach-O binary cannot
# have a notarisation ticket stapled to it.** `stapler` writes tickets into
# .app/.pkg/.dmg containers; there is nowhere to put one in a bare executable.
# Measured on the closest possible precedent -- conflab, a Developer ID signed
# bare binary shipped through the geodica tap: `stapler validate` says "does not
# have a ticket stapled to it", and that is the correct steady state. The ticket
# lives on Apple's servers and Gatekeeper checks online. Do not "fix" this.
#
# AND `spctl -a -t exec` WILL SAY "rejected" ON A CORRECTLY SIGNED CLI. Measured
# on conflab: `rejected (the code is valid but does not seem to be an app)`, with
# a valid `origin=Developer ID Application: Geodica Pty Ltd`. That is spctl
# refusing to assess a bare executable under a policy meant for app BUNDLES --
# a category error, not a verdict.
#
# **CORRECTION TO THE ABOVE, and it matters because I nearly wrote spctl off.**
# `-t exec` is the wrong policy type, not proof that spctl cannot answer. The
# right invocation for a bare binary is:
#
#   spctl -a -t open --context context:primary-signature -vv <binary>
#
# which on a notarised Intent binary reports `accepted` and, decisively,
# `source=Notarized Developer ID`. **A tool giving a useless answer usually means
# it was asked the wrong question** -- the same shape as probing acceptance with
# `doctor` when the question was acceptance, not health.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

ROOT="${PROJECT_ROOT:?}"
RELEASE_DIR="$ROOT/native/rust/target/release"
BINARIES="intent intentd"
KC_PREFIX="intent.apple"

# EVERYTHING AFTER THE COPY HAPPENS HERE, AND THAT IS THE WHOLE POINT.
#
# `target/release/` is SHARED MUTABLE STATE. Four sessions build in this tree and
# `cargo build --release` is the most ordinary thing any of them does -- so a
# signature living there is not a property of a file, it is a property of a file
# that nobody has rebuilt yet.
#
# MEASURED LIVE, 2026-08-15: a peer's release build replaced a Developer ID
# signature with the linker's ad-hoc one, and one of two shipped binaries stopped
# being notarised inside the hour, with NO signal and every artefact of the
# earlier proof still reading as valid. Nobody did anything wrong; a shared target
# directory is what it is for.
#
# The first response was to make `stage` REFUSE to checksum anything it could not
# prove. That was right and it stays -- but a refusal DETECTS the race, it does
# not remove it, and it detects it only at the end, after a notarisation round
# trip has already been spent on bytes that no longer exist.
#
# So the target moved instead. `target/dist/` is written by this command and by
# nothing else, which means the window in which a peer can disturb an artefact
# shrinks from "the whole sign -> notarise -> stage sequence", minutes long and
# spanning a network round trip to Apple, to "the ditto on the line below". **A
# structure that cannot fail beats a control that catches the failure**, and the
# control is still there underneath because catching it is free.
STAGE_DIR="$ROOT/native/rust/target/dist"

# The triple comes from `rustc -vV`, never from `uname`: the artefact name is a
# claim about what the compiler targeted, and only the compiler can answer that.
host_triple() {
  local t
  t="$(rustc -vV | sed -n 's/^host: //p')"
  [ -n "$t" ] || die "could not read the host target triple from 'rustc -vV'"
  printf '%s' "$t"
}

# --- credentials -------------------------------------------------------------
# Read from the login Keychain, never from the environment or a file. Silent on
# a miss; the callers report presence.
kc_get() { security find-generic-password -a "$USER" -s "$KC_PREFIX.$1" -w 2>/dev/null || true; }

APPLE_ID="$(kc_get APPLE_ID)"
APPLE_APP_PASSWORD="$(kc_get APPLE_APP_PASSWORD)"
APPLE_TEAM_ID="$(kc_get APPLE_TEAM_ID)"

# The identity is DERIVED from the team id rather than stored, so there is one
# place a team id can be wrong. Falls back to discovering it from the keychain
# when no team id is stored yet -- which is the normal state before store-creds,
# and is what lets `sign` work today while notarisation waits on hv.
if [ -n "$APPLE_TEAM_ID" ]; then
  IDENTITY="Developer ID Application: Geodica Pty Ltd ($APPLE_TEAM_ID)"
else
  IDENTITY="$(security find-identity -v -p codesigning 2>/dev/null |
    sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' | head -1)"
fi

present() { [ -n "$1" ] && printf 'PRESENT' || printf 'MISSING'; }

require_identity() {
  [ -n "$IDENTITY" ] || die "no Developer ID Application identity in the keychain -- run: int macos doctor"
}

require_binaries() {
  local missing=""
  for b in $BINARIES; do
    [ -f "$RELEASE_DIR/$b" ] || missing="$missing $b"
  done
  [ -z "$missing" ] || die "missing release binaries:$missing -- run 'int build all --release' first"
}

# require_staged -- every subcommand after `stage` acts on the staged copies, so
# each one has to be able to say WHICH step has not been run rather than failing
# on a missing path. Names the fix, not the symptom.
require_staged() {
  local triple missing=""
  triple="$(host_triple)"
  for b in $BINARIES; do
    [ -f "$STAGE_DIR/$b-$triple" ] || missing="$missing $b-$triple"
  done
  [ -z "$missing" ] || die "nothing staged:$missing -- run 'int macos stage' first (it copies the build output into $STAGE_DIR, where a peer's cargo build cannot reach it)"
}

# --- subcommands -------------------------------------------------------------

cmd_env() {
  printf 'identity:   %s\n' "${IDENTITY:-<none found>}"
  printf 'team id:    %s\n' "${APPLE_TEAM_ID:-<not stored>}"
  printf '\nnotary credentials (values are never printed):\n'
  printf '  APPLE_ID            %s\n' "$(present "$APPLE_ID")"
  printf '  APPLE_APP_PASSWORD  %s\n' "$(present "$APPLE_APP_PASSWORD")"
  printf '  APPLE_TEAM_ID       %s\n' "$(present "$APPLE_TEAM_ID")"
}

cmd_doctor() {
  local rc=0

  step "Developer ID identity"
  if [ -n "$IDENTITY" ]; then
    printf '    %s\n' "$IDENTITY"
  else
    printf '    MISSING -- no "Developer ID Application" in the login keychain\n'
    rc=1
  fi

  # A REAL test-sign, not a presence check. An identity can be listed and still
  # fail to sign -- expired, revoked, or missing its private key -- and finding
  # that out during a release is finding it out too late.
  step "test-sign against a throwaway binary"
  if [ -n "$IDENTITY" ]; then
    local tmp
    tmp="$(mktemp -d)"
    cp /bin/echo "$tmp/probe" 2>/dev/null || true
    if [ -f "$tmp/probe" ] &&
      codesign --force --options runtime --timestamp --sign "$IDENTITY" "$tmp/probe" >/dev/null 2>&1 &&
      codesign --verify --strict "$tmp/probe" >/dev/null 2>&1; then
      printf '    signs and verifies\n'
    else
      printf '    FAILED -- the identity is listed but cannot produce a valid signature\n'
      rc=1
    fi
    rm -rf "$tmp"
  else
    printf '    skipped (no identity)\n'
  fi

  step "notary credentials in the login keychain"
  printf '    APPLE_ID %s   APPLE_APP_PASSWORD %s   APPLE_TEAM_ID %s\n' \
    "$(present "$APPLE_ID")" "$(present "$APPLE_APP_PASSWORD")" "$(present "$APPLE_TEAM_ID")"
  if [ -z "$APPLE_ID" ] || [ -z "$APPLE_APP_PASSWORD" ] || [ -z "$APPLE_TEAM_ID" ]; then
    printf '    notarisation is UNAVAILABLE until these exist -- run: int macos store-creds\n'
    printf '    (signing does NOT need them and works now)\n'
  fi

  # REPORT THE TEAM, NOT THE `Signature=` LINE, and the first version of this got
  # it backwards in the worst available direction. `codesign -dv` prints
  # `Signature=adhoc` for an ad-hoc binary but `Signature size=NNNN` for a real
  # one -- a SPACE, not an `=`. So `sed -n 's/^Signature=//p'` matched an ad-hoc
  # binary and printed NOTHING for a correctly Developer ID signed one: **the
  # display went blank exactly when the news was good.** hv ran `doctor` after
  # signing and saw two empty fields.
  #
  # Nothing-means-bad is the same false-report shape as an unwired guard, and it
  # is worse in a doctor, whose entire job is to be believed about state. The
  # team identifier is the honest discriminator: absent on ad-hoc, present and
  # named on Developer ID.
  step "release binaries"
  for b in $BINARIES; do
    if [ ! -f "$RELEASE_DIR/$b" ]; then
      printf '    %-8s not built\n' "$b"
      continue
    fi
    local desc team
    team="$(codesign -dv "$RELEASE_DIR/$b" 2>&1 | sed -n 's/^TeamIdentifier=//p')"
    case "$team" in
      "" ) desc="UNSIGNED" ;;
      "not set" ) desc="ad-hoc (linker) -- not Developer ID; run: int macos sign" ;;
      * ) desc="Developer ID ($team)" ;;
    esac
    printf '    %-8s %s\n' "$b" "$desc"
  done

  return $rc
}

cmd_sign() {
  require_identity
  require_staged
  local triple
  triple="$(host_triple)"
  printf 'identity: %s\n\n' "$IDENTITY"
  for b in $BINARIES; do
    step "signing $b-$triple"
    # --options runtime  hardened runtime; notarisation REFUSES without it
    # --timestamp        secure timestamp; notarisation REFUSES without it
    # --force            replace the ad-hoc signature the linker already applied
    #                    (arm64 binaries are always signed; this is a re-sign)
    codesign --force --options runtime --timestamp --sign "$IDENTITY" "$STAGE_DIR/$b-$triple"
    # --strict, and READ WHAT THIS PROVES: that the signature present is internally
    # valid. It is NOT evidence the binary is ours -- `codesign --verify --strict`
    # returns 0 on the linker's ad-hoc signature too, because an ad-hoc signature
    # is a valid signature. This board carried it as "the check that means
    # something" for hours and it took a live incident to refute. The check that
    # means something is `verify_notarised`, on a quarantined copy.
    codesign --verify --strict --verbose=2 "$STAGE_DIR/$b-$triple" 2>&1 | sed 's/^/    /'
  done
  printf '\n'
  ok
  printf '  Both STAGED artefacts carry a Developer ID signature with the hardened\n'
  printf '  runtime. Signing rewrote their bytes, so any earlier checksum is stale.\n'
  printf '  NEXT: int macos notarize   (needs the notary credentials)\n'
}

cmd_notarize() {
  require_identity
  require_staged
  local triple
  triple="$(host_triple)"
  [ -n "$APPLE_ID" ] && [ -n "$APPLE_APP_PASSWORD" ] && [ -n "$APPLE_TEAM_ID" ] ||
    die "notary credentials missing -- run: int macos store-creds (see: int macos doctor)"

  # Refuse to submit an unsigned or ad-hoc binary. notarytool would reject it
  # anyway, minutes later, with a less useful message -- and a gate that fails
  # early beats one that fails after a round trip to Apple.
  for b in $BINARIES; do
    codesign -dv "$STAGE_DIR/$b-$triple" 2>&1 | grep -q 'TeamIdentifier=not set' &&
      die "$b-$triple is not Developer ID signed -- run 'int macos sign' first"
  done

  local staging payload zip
  staging="$(mktemp -d)"
  payload="$staging/intent-macos"
  zip="$staging/intent-macos.zip"
  mkdir -p "$payload"

  # ditto throughout, never cp or zip(1): ditto preserves the code signature and
  # the extended attributes notarisation reads, and a plain zip can strip them.
  #
  # STAGE INTO A DIRECTORY FIRST. `ditto -c -k` takes exactly ONE source, so
  # passing both binaries fails with "Can't archive multiple sources" -- which is
  # what the first version of this did. Notarytool is happy with a zip of a
  # directory; it walks it and assesses every Mach-O inside.
  for b in $BINARIES; do
    /usr/bin/ditto "$STAGE_DIR/$b-$triple" "$payload/$b-$triple" || die "could not stage $b-$triple"
  done
  /usr/bin/ditto -c -k --keepParent --sequesterRsrc "$payload" "$zip" ||
    die "could not build the submission archive"

  step "submitting to Apple (typically 1-5 minutes; notarytool waits)"
  # `|| true` deliberately: notarytool exits non-zero on an Invalid verdict, and
  # the verdict is what we want to read and report rather than abort over.
  local out status
  out="$(xcrun notarytool submit "$zip" \
    --apple-id "$APPLE_ID" --password "$APPLE_APP_PASSWORD" --team-id "$APPLE_TEAM_ID" \
    --wait 2>&1)" || true
  printf '%s\n' "$out"
  status="$(printf '%s' "$out" | awk '/^  status: / { print $2 }' | tail -1)"

  if [ "$status" != "Accepted" ]; then
    local id
    id="$(printf '%s' "$out" | awk '/id: [0-9a-f-]{36}/ { print $2; exit }')"
    [ -n "$id" ] && xcrun notarytool log "$id" \
      --apple-id "$APPLE_ID" --password "$APPLE_APP_PASSWORD" --team-id "$APPLE_TEAM_ID" 2>&1 | head -40
    rm -rf "$staging"
    die "notarisation was not Accepted (status: ${status:-unknown})"
  fi

  rm -rf "$staging"
  printf '\n'
  ok
  printf '  Accepted. NOTHING IS STAPLED, and that is correct: a bare Mach-O\n'
  printf '  binary has nowhere to hold a ticket. The ticket lives on Apple'"'"'s\n'
  printf '  servers and Gatekeeper checks online. conflab ships exactly this way.\n'
}

# verify_notarised <dir> <file> -- THE ONLY CHECK THAT PROVES THE WHOLE CHAIN,
# and the reason it exists is that every other check passes on a binary that is
# signed but NOT notarised. codesign verifies the signature; spctl -t exec
# answers the wrong question; `stapler` correctly reports no ticket on a bare
# binary either way. **A release that quietly stopped being notarised would sail
# through all of them.**
#
# So this reproduces the only scenario notarisation exists for: a file that
# arrived with the quarantine xattr, as a browser download does. Gatekeeper
# engages ONLY on quarantined files -- which is why an unquarantined check is not
# evidence, and why brew-installed ad-hoc binaries run happily.
#
# IT ASKS ONLY ABOUT STAGED ARTEFACTS, and it used to take a directory so that
# `verify` could ask about the build output while `stage` asked about the shipping
# copies. That parameter is gone with the reason for it: the build output is no
# longer a thing that ever ships, so a verdict about it would be a confident
# answer to a question nobody is asking. **Verify the artefact you are going to
# publish, never its ancestor.**
#
# One implementation, one target, three callers -- which is the arrangement where
# a release-time check cannot drift away from the development-time one everybody
# actually runs.
verify_notarised() {
  local file="$1" t verdict rc=0
  t="$(mktemp -d)"
  /usr/bin/ditto "$STAGE_DIR/$file" "$t/$file"
  # Set quarantine, then ASSERT IT IS SET before reading any verdict: a fixture
  # that never entered the branch proves nothing and looks like a pass.
  xattr -w com.apple.quarantine "0083;0;dc-verify;" "$t/$file"
  if ! xattr -p com.apple.quarantine "$t/$file" >/dev/null 2>&1; then
    printf '    %-34s SKIPPED -- could not set the quarantine xattr; verdict withheld\n' "$file"
    rm -rf "$t"
    return 1
  fi
  verdict="$(spctl -a -t open --context context:primary-signature -vv "$t/$file" 2>&1 |
    sed -n 's/^source=//p')"
  if [ "$verdict" = "Notarized Developer ID" ] && (cd "$t" && "./$file" --version >/dev/null 2>&1); then
    printf '    %-34s quarantined, accepted, runs -- source=%s\n' "$file" "$verdict"
  else
    printf '    %-34s FAILED -- source=%s (expected: Notarized Developer ID)\n' "$file" "${verdict:-<none>}"
    rc=1
  fi
  rm -rf "$t"
  return $rc
}

cmd_verify() {
  require_staged
  local triple rc=0
  triple="$(host_triple)"
  for b in $BINARIES; do
    verify_notarised "$b-$triple" || rc=1
  done
  [ "$rc" -eq 0 ] && { ok; printf '  Signed, notarised, and Gatekeeper-clean from a quarantined download.\n'; }
  return $rc
}

# cmd_stage -- copy the build output out of shared space, under its shipping name.
#
# THIS IS NOW THE FIRST STEP, NOT THE LAST, and that inversion is the fix for the
# race described at STAGE_DIR above. It used to run after sign and notarise, which
# meant the artefacts were exposed to every peer's `cargo build --release` for the
# whole minutes-long notarisation round trip. Copying FIRST and signing the copies
# means the exposure is this ditto and nothing else.
#
# It deliberately does NOT checksum any more. Checksums belong after signing --
# see cmd_checksum -- and a `stage` that both copied and hashed could only ever
# have hashed unsigned bytes once the order was corrected.
#
# `rm -rf` first, and that is not housekeeping: staging means "start again from
# the build output". Anything already in here is a signature over bytes we are
# about to replace, and keeping it would let a stale artefact survive a rebuild.
cmd_stage() {
  require_binaries
  local triple
  triple="$(host_triple)"

  step "staging $BINARIES for $triple"
  rm -rf "$STAGE_DIR"
  mkdir -p "$STAGE_DIR"
  for b in $BINARIES; do
    /usr/bin/ditto "$RELEASE_DIR/$b" "$STAGE_DIR/$b-$triple" ||
      die "could not stage $b"
    printf '    %-34s <- target/release/%s\n' "$b-$triple" "$b"
  done

  printf '\n'
  ok
  printf '  Staged into %s, which only this command writes.\n' "$STAGE_DIR"
  printf '  These copies are UNSIGNED -- they carry whatever the linker applied.\n'
  printf '  NEXT: int macos sign\n'
}

# cmd_checksum -- prove every staged artefact, and only then hash it.
#
# WHY THIS IS A COMMAND AND NOT A NOTE IN A RELEASE DOC. The two operations in a
# release pipeline have OPPOSITE effects on the bytes, and the asymmetry is easy
# to get backwards:
#
#   codesign --force   REWRITES THE BINARY IN PLACE      -> checksum after
#   notarytool submit  uploads a ZIP OF A COPY, no staple -> checksum before or
#                      (a bare Mach-O has nowhere to put   after, both correct
#                      a ticket, so the file is unchanged)
#
# So a sha256 taken before signing is wrong, and it is wrong in the worst
# available way: **it does not fail for us, it fails for every `brew install`**,
# against a formula we published, at the point where we have the least
# visibility. Homebrew's error will say the download is corrupt, which is a
# perfectly misleading description of a checksum computed one step too early.
#
# THE ORDER IS THEREFORE ENFORCED, NOT DOCUMENTED: nothing here computes a
# checksum until `verify_notarised` has passed on the artefact being hashed.
#
# WHAT IT DELETES ON REFUSAL IS THE PROOF, NOT THE WORK. The earlier version wiped
# the whole staging directory, which was harmless when staging was a copy of the
# build output and is actively wrong now that the staged files carry a signature
# and a notarisation. Throwing them away would spend another round trip to Apple
# to rebuild something that was already correct.
#
# But a STALE `SHA256SUMS.txt` cannot be allowed to survive a failure, because
# `formula` treats that file's existence as the proof -- so leaving one behind
# would hand a refused run's output to the next command as if it had passed. The
# artefacts stay; the claim about them goes.
cmd_checksum() {
  require_staged
  local triple rc=0
  triple="$(host_triple)"
  local sums="$STAGE_DIR/SHA256SUMS.txt"

  step "proving every staged artefact before anything is hashed"
  for b in $BINARIES; do
    verify_notarised "$b-$triple" || rc=1
  done
  if [ "$rc" -ne 0 ]; then
    rm -f "$sums"
    die "refusing to checksum -- a staged artefact is not signed AND notarised. Run: int macos sign && int macos notarize (the staged binaries are left alone; only the checksum claim is withdrawn)"
  fi

  step "checksums"
  (cd "$STAGE_DIR" && shasum -a 256 ./*-"$triple" | sed 's|\./||' >SHA256SUMS.txt) ||
    die "could not write SHA256SUMS.txt"

  printf '\n'
  ok
  printf '  staged: %s\n\n' "$STAGE_DIR"
  sed 's/^/    /' "$sums"
  printf '\n  Every line above is a hash of a binary this command has just proven\n'
  printf '  signed and notarised from a quarantined copy. Safe to paste into a\n'
  printf '  formula. NOT REGENERATED ON RE-SIGN -- re-run `checksum` after any\n'
  printf '  `sign`, because signing rewrites the bytes these hashes describe.\n'
}

# cmd_prepare -- the whole sequence, as one command, because it has to be one.
#
# THE OPERATOR'S MEMORY IS NOT A CONTROL. Every individual subcommand here is
# correct in isolation and the failure this exists to prevent is not a bug in any
# of them -- it is the GAP BETWEEN them. Four commands run by hand, with a
# multi-minute wait in the middle, is four chances to stop halfway and come back
# to a tree a peer has rebuilt underneath you. That is not hypothetical; it is
# what happened, and the note I wrote afterwards said "must run as one
# uninterrupted sequence", which is a reminder, and reminders are not load-bearing.
#
# The subcommands stay individually callable, for diagnosis and for re-running one
# step. This is the path anyone cutting a release actually takes.
cmd_prepare() {
  cmd_stage
  printf '\n'
  cmd_sign
  printf '\n'
  cmd_notarize
  printf '\n'
  cmd_checksum
  printf '\n'
  printf 'prepare: staged, signed, notarised, proven and hashed in one pass.\n'
  printf '  NEXT: int macos formula\n'
}

# cmd_formula -- emit the Homebrew formula from the staged artefacts.
#
# GENERATED, NEVER HAND-EDITED, and that is the whole point. A tap formula
# carries a version and one sha256 per artefact, and every one of them is a
# restatement of a fact that already exists somewhere else. Conflab hand-maintains
# exactly these lines and has a `release sync` command partly to heal the drift
# that follows. **A number copied by hand is a number that will eventually be
# copied wrong**, and this particular wrong number does not fail for us -- it
# fails for every `brew install`, against a formula we already published.
#
# IT INHERITS `stage`'s REFUSAL STRUCTURALLY RATHER THAN RE-CHECKING IT. The only
# input is `SHA256SUMS.txt`, which `stage` writes ONLY for artefacts it has proven
# signed and notarised from a quarantined copy. So there is no path from an
# unproven binary to a formula: not because this command checks again, but because
# the file it needs does not exist. One check, one place, no second opinion to
# drift out of step.
#
# THE DEV-VERSION REFUSAL IS DELIBERATELY NOT HERE. Emitting a formula that reads
# `version "3.0.0-dev"` is harmless -- it is text on a terminal, and it is
# self-evidently not a release. The harm is in PUBLISHING one, so the refusal
# belongs in the publish step. **Put the control where the harm is, not where it
# is convenient to write.**
#
# EXPIRY, stated rather than left to be noticed: this lives under `macos` because
# hv ruled 2026-08-15 that v3.0.0 ships macOS arm64 ONLY, which makes the formula
# a single-platform document. If Linux artefacts are ever added the formula grows
# a second platform block and stops being a macOS concern -- move it then.
cmd_formula() {
  local stage_dir="$STAGE_DIR" triple version sums
  triple="$(host_triple)"
  sums="$stage_dir/SHA256SUMS.txt"
  [ -f "$sums" ] ||
    die "no proven artefacts to describe -- run 'int macos prepare' first (SHA256SUMS.txt is written only by 'checksum', and only for artefacts it has proven signed AND notarised)"

  # The version comes from the STAGED BINARY, not from a config file or a tag.
  # It is the only source that cannot disagree with what a user will actually
  # run, which is also what makes the formula's own `test do` block pass by
  # construction rather than by coincidence.
  version="$("$stage_dir/intent-$triple" --version 2>/dev/null | sed -n 's/^intent //p')"
  [ -n "$version" ] || die "could not read a version from $stage_dir/intent-$triple"

  local sha_cli sha_daemon
  sha_cli="$(awk -v f="intent-$triple" '$2 == f { print $1 }' "$sums")"
  sha_daemon="$(awk -v f="intentd-$triple" '$2 == f { print $1 }' "$sums")"
  [ -n "$sha_cli" ] && [ -n "$sha_daemon" ] ||
    die "$sums does not carry a hash for both binaries -- re-run 'int macos stage'"

  cat <<FORMULA
class Intent < Formula
  desc "Steel thread process for helping LLMs help you work with your code"
  homepage "https://github.com/matthewsinclair/intent"
  version "$version"
  license "MIT"

  RELEASE_VERSION = "$version"

  # macOS arm64 only, by ruling (hv, 2026-08-15) rather than by omission. Both
  # binaries are Developer ID signed and notarised; nothing is stapled, because a
  # bare Mach-O has nowhere to hold a ticket and Gatekeeper checks online.
  on_macos do
    on_arm do
      url "https://github.com/matthewsinclair/intent/releases/download/v#{RELEASE_VERSION}/intent-$triple"
      sha256 "$sha_cli"

      resource "intentd" do
        url "https://github.com/matthewsinclair/intent/releases/download/v#{RELEASE_VERSION}/intentd-$triple"
        sha256 "$sha_daemon"
      end
    end
  end

  def install
    bin.install Dir["intent-*"].first => "intent"
    resource("intentd").stage do
      bin.install Dir["intentd-*"].first => "intentd"
    end
  end

  # NO \`service do\` BLOCK YET, and its absence is deliberate. intentd currently
  # reports "not yet implemented": there is no start verb and no log path, so any
  # block here would be a guess at an interface that does not exist. It arrives
  # with the daemon lifecycle.

  test do
    assert_match version.to_s, shell_output("#{bin}/intent --version")
  end
end
FORMULA

  printf '\n' >&2
  printf 'generated from %s\n' "$sums" >&2
  printf 'The URLs above assume a release tagged v%s exists on matthewsinclair/intent\n' "$version" >&2
  printf 'carrying these exact artefacts. Publish the release BEFORE the formula.\n' >&2
}

cmd_store_creds() {
  printf 'Storing Apple notary credentials in the login Keychain under "%s.*".\n' "$KC_PREFIX"
  printf 'Nothing is written to this repository. Values are not echoed.\n\n'
  printf 'APPLE_ID (Apple account email): '
  read -r a_id
  printf 'APPLE_APP_PASSWORD (app-specific password, not the account password): '
  read -rs a_pw
  printf '\nAPPLE_TEAM_ID (eg 76BQL8L47U): '
  read -r a_team
  printf '\n'
  for pair in "APPLE_ID:$a_id" "APPLE_APP_PASSWORD:$a_pw" "APPLE_TEAM_ID:$a_team"; do
    local k="${pair%%:*}" v="${pair#*:}"
    [ -n "$v" ] || die "$k was empty -- nothing stored"
    security add-generic-password -U -a "$USER" -s "$KC_PREFIX.$k" -w "$v" ||
      die "could not write $k to the keychain"
  done
  ok
  printf '  Stored. Verify with: int macos doctor\n'
}

SUBCOMMANDS="doctor stage sign notarize verify checksum prepare formula env store-creds"

usage() {
  cat <<'USAGE'
intent macos <subcommand>

  THE PIPELINE, in order. Every step after `stage` acts on the staged copies in
  native/rust/target/dist -- never on target/release, which four sessions share
  and any `cargo build --release` will overwrite underneath you.

  prepare      RUN THE WHOLE SEQUENCE AS ONE PASS: stage, sign, notarize,
               checksum. This is the path for cutting a release; the individual
               steps below exist for diagnosis and for re-running one of them.

  stage        Copy the build output into target/dist under its shipping name
               (<binary>-<target-triple>), out of shared space. Wipes first.
  sign         Developer ID sign the STAGED artefacts, hardened runtime
  notarize     Submit the staged artefacts to Apple, wait, report
  checksum     Prove every staged artefact from a quarantined copy, and only
               then hash it -- REFUSES to hash anything unproven

  verify       Prove the staged artefacts without hashing them (read-only)
  formula      Emit the Homebrew formula. Generated, never hand-edited; refuses
               unless `checksum` has proven the artefacts it describes
  doctor       Preflight: identity present, a real test-sign, notary creds
  env          Print the resolved identity + which creds are present
  store-creds  Store APPLE_ID / APPLE_APP_PASSWORD / APPLE_TEAM_ID in the
               login Keychain (interactive; once per machine)
USAGE
}

case "${1:-}" in
  "" | -h | --help) usage; exit 0 ;;
  env) cmd_env ;;
  doctor) cmd_doctor ;;
  stage) cmd_stage ;;
  sign) cmd_sign ;;
  notarize | notarise) cmd_notarize ;;
  verify) cmd_verify ;;
  checksum) cmd_checksum ;;
  prepare) cmd_prepare ;;
  formula) cmd_formula ;;
  store-creds) cmd_store_creds ;;
  *) die "unknown macos subcommand: $1 (try: $SUBCOMMANDS)" ;;
esac
