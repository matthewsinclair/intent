#!/usr/bin/env bash
#
# int cli -- THE path from a shell to the native v3 CLI. There is exactly one,
# and it refuses an incoherent binary pair rather than running it.
#
# THIS VERB USED TO PICK BY MTIME AND CHECK NOTHING. It ran whichever of
# target/debug and target/release had been touched last, which turns "which
# binary am I running" into a question about file timestamps -- and it applied
# no coherence check at all, so it would happily run a pair built from two
# different trees. The guard existed, in `bin/intent3`, on the path nobody had
# standardised on. That was the defect: not a missing check, a check parked
# where the traffic was not.
#
# WHY A COHERENCE CHECK AT ALL, since `cargo build --release` returns green.
# `intentd` declares no dependencies, so its build script never re-runs and the
# previous build's commit stays baked in. dc drove this in August with a
# 48-hour-old marker; it recurred on 2026-08-27 mid-port with `intent` at
# f438d0d5 and `intentd` still at cd032508. AC-00.1 on ST0058 names it.
#
# AND THE OBVIOUS VERIFICATION CANNOT SEE IT: `intentd --version` prints
# `intentd 3.0.0 -- not yet implemented` and no commit at all, so reading
# --version off both halves of a pair looks clean while the pair disagrees.
# The provenance is embedded, not printed, which is why this reads it through
# artefact.lib rather than by running the binary and believing it.
#
# RELEASE BY STATED CHOICE. `--debug` is the only way to the debug build, and
# it is deliberately a flag you type rather than a timestamp you lose a race
# to. A debug binary is unguarded by construction -- it has no pair -- so
# asking for one is asking to be unguarded, and that should be legible in the
# command you ran.
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

workspace="${PROJECT_ROOT:?}/native/rust"
[ -d "$workspace" ] || die "no Rust workspace at native/rust -- has the tree moved?"

want=release
if [ "${1:-}" = "--debug" ]; then
  want=debug
  shift
fi

if [ "$want" = debug ]; then
  dbg="$workspace/target/debug/intent"
  # BACKTICKS, NOT QUOTES, AND THAT IS LOAD-BEARING RATHER THAN STYLE. Arm 10 of
  # `shared_artefact_build_guard.sh` strips backticked spans before matching and
  # strips nothing else, so a cargo command named inside quotes is counted as a
  # cargo command RUN. cc hit it on this file at 2026-08-27 and it blocked every
  # node's commit. The guard's own header calls this the estate's oldest
  # instrument defect and records meeting it twice; this was the third.
  [ -x "$dbg" ] || die "no debug binary at $dbg -- run \`cargo build -p intent-cli --manifest-path native/rust/Cargo.toml\`"
  printf 'int cli: --debug, so NO coherence guard (a debug build has no pair to check)\n' >&2
  exec "$dbg" "$@"
fi

release_dir="$workspace/target/release"
rel="$release_dir/intent"
if [ ! -x "$rel" ]; then
  # NOT a silent `cargo build`. The old verb built debug here and then ran it,
  # which is how you end up holding a debug binary you never asked for. The
  # remedy is one command and it is the one that produces a COHERENT set.
  die "no release binary at $rel -- run \`int local build\` (it forces a coherent pair and verifies it; a bare \`cargo build --release\` does not)"
fi

# HARD DEPENDENCY, ON PURPOSE. A wrapper that drops its own guard when a file
# goes missing is worse than one with no guard, because it still looks guarded.
for lib in artefact sharedtarget currency; do
  libpath="$(dirname "${BASH_SOURCE[0]}")/shared/$lib.lib"
  [ -r "$libpath" ] ||
    die "cannot read $libpath -- refusing to exec without the currency check"
  # shellcheck disable=SC1090
  . "$libpath"
done

# THE PRECONDITION IS ASSERTED HERE RATHER THAN INFERRED FROM THE VERDICT.
# `currency.lib` deliberately does not source `sharedtarget.lib` (its own header
# says so), so the scope array is THIS CALLER's responsibility to bring. When it
# was missing, `_build_inputs_changed` returned `noscope` in its first statement
# -- before `base` was read and before git was called -- and the refusal below
# printed prose about a binary nothing had examined. `int cli` refused every
# invocation for four days on that path and the one surface that would have
# reported it is the surface that broke (issue 0294).
#
# A MISSING PRECONDITION IS THIS FILE'S DEFECT AND MUST NOT WEAR THE ARTEFACT'S
# WORDS. Adding `sharedtarget` to the loop above fixes today; this assertion is
# what stops the next edit of that list from regressing in silence.
if [ -z "${SHARED_TARGET_DIRT_SCOPES+x}" ] || [ "${#SHARED_TARGET_DIRT_SCOPES[@]}" -eq 0 ]; then
  die "SHARED_TARGET_DIRT_SCOPES is undeclared after sourcing -- this wrapper failed to bring its own precondition, and that is a defect HERE and not a fact about the binary. remedy: check the source list above includes every lib the verdict needs; \`int local build\` cannot clear this."
fi

verdict="$(artefact_currency_verdict "$release_dir" "$PROJECT_ROOT")"
case "$verdict" in
  ok) ;;
  warn:*)
    printf 'warning: %s\n' "${verdict#warn:}" >&2
    ;;
  refuse:*)
    printf 'error: %s\n' "${verdict#refuse:}" >&2
    # THE REASON SPEAKS AND THIS CALLER DOES NOT SPEAK OVER IT. These two lines
    # used to assert "the binary really does not describe this tree" on EVERY
    # refusal. Two of the five reasons say exactly that already and say it more
    # precisely; the other three say currency CANNOT BE DECIDED, and the prose
    # contradicted them in the confident direction. A caller must not conclude
    # what its library declined to conclude (issue 0294).
    printf "  remedy: run 'int local build' -- it rebuilds and verifies the SET.\n" >&2
    exit 1
    ;;
  *)
    # An unrecognised verdict is not a pass. The three cases above are the
    # whole contract; a fourth means the lib moved under this caller.
    die "unrecognised currency verdict '$verdict' -- refusing rather than guessing"
    ;;
esac

exec "$rel" "$@"
