#!/usr/bin/env bash
#
# devbin: summary = Run the Intent v3 native CLI
#
# intent cli [args...] -- run the ST0056 Rust binary against this project.
#
# Overrides devbin's built-in `cli`, which is `exec mix <task>` and assumes an
# Elixir project. Intent is not one, so the builtin's language gate refused
# with "this project does not declare the 'elixir' language" -- a true
# statement about a question nobody asked.
#
# Prefers an already-built binary and only builds when there is none, because
# `int cli` is the command you reach for to RUN the thing: making it rebuild
# first would put a compile in front of every invocation. Use `int build cli`
# when you want the build.
#
# Debug before release, deliberately: during the v3 build the debug binary is
# the one that has just been compiled by `cargo test`, so it is the one whose
# behaviour matches the tree you are looking at. A stale release binary
# answering questions about code you changed an hour ago is the failure this
# ordering prevents.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

workspace="${PROJECT_ROOT:?}/native/rust"
[ -d "$workspace" ] || die "no Rust workspace at native/rust -- has the tree moved?"

# FRESHEST WINS, NEVER EXISTENCE.
#
# This loop used to be `debug` then `release`, execing the first that was `-x`.
# No mtime, no freshness -- so a debug binary built ONCE, from any tree state,
# PERMANENTLY SHADOWED every later release build for this verb, while
# `int local build` faithfully refreshed a release pair nobody reached through
# it. The thing you built was not the thing that ran, and nothing said so.
#
# Freshest rather than release-always, because a debug build exists to run
# uncommitted code and someone who just ran `int build cli --debug` means it.
# The choice is PRINTED when the two differ by more than a minute: silently
# picking is how the old behaviour stayed invisible.
dbg="$workspace/target/debug/intent"
rel="$workspace/target/release/intent"
chosen=""
if [ -x "$dbg" ] && [ -x "$rel" ]; then
  if [ "$dbg" -nt "$rel" ]; then chosen="$dbg"; other="$rel"; else chosen="$rel"; other="$dbg"; fi
  # `find -newermt` is refused by this platform's bfs find, so the age gap is a
  # plain stat comparison rather than a predicate.
  a="$(stat -f %m "$chosen")"; b="$(stat -f %m "$other")"
  if [ "$((a - b))" -gt 60 ]; then
    printf 'int cli: running the newer %s build (the other is %ss older)\n' \
      "$(basename "$(dirname "$chosen")")" "$((a - b))" >&2
  fi
elif [ -x "$dbg" ]; then chosen="$dbg"
elif [ -x "$rel" ]; then chosen="$rel"
fi
[ -z "$chosen" ] || exec "$chosen" "$@"

# Nothing built yet. Build once, quietly, then run -- rather than failing with
# "no binary", which tells the operator to go and run a different command.
warn "no intent binary yet -- building (debug)"
cd "$workspace" || die "cannot enter $workspace"
cargo build -p intent-cli >&2 || die "cargo build failed"
exec "$workspace/target/debug/intent" "$@"
