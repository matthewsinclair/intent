#!/usr/bin/env bash
#
# devbin: summary = Render Intent's Homebrew formula for macOS and Linux and the app's cask, publish both to the tap at a terminal, and smoke an installed keg
# devbin: args = <subcommand>
# bin/int brew <subcommand> -- Intent's Homebrew formula, and the check of an
# installed keg (ST0081 WP-06).
#
# ONE HOME FOR BOTH PLATFORMS. The formula lived in `cmd/macos` while the release
# was macOS arm64 alone, and its own header said to move it once Linux artefacts
# arrived. They have, so the renderer is `shared/brew.lib`, which `int macos
# publish` sources too: the formula a release pushes is the one this prints.
# smoke moved with it, because a Linuxbrew keg on hv's Ubuntu VM needs the same
# arms as a keg on a Mac.
#
# THE VERBS ARE THE CONTRACT'S (ST0087 T8): `render <tag> <out>` and `publish`.
# `render` reads the version from the tag and the manifest's commit from git, so
# nobody types either.
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

ROOT="${PROJECT_ROOT:?}"
SUBCOMMANDS="render publish smoke"

# SUPPORT_PATHS, and smoke's population: resolved_install_paths and
# INSTALL_BINARY_PATHS.
. "$(dirname "${BASH_SOURCE[0]}")/shared/support.lib"
# rust_host, with which staged_version names the staged binary (issue 0595).
. "$(dirname "${BASH_SOURCE[0]}")/shared/rusthost.lib"
# The formula's names, its renderer, and the one push to the tap.
. "$(dirname "${BASH_SOURCE[0]}")/shared/brew.lib"

# brew_confirm_push -- ask the person at the terminal before --push, through
# helpers' ask_person, the release core's own question. DEVBIN_GATE_TTY is set
# from this process's stdin because no gate set it, so "is a person here" is
# issue 0058's two-arm test: stdin is a terminal and /dev/tty can be read. There
# is no --yes, by vc's ruling of 2026-10-14: a push to the tap changes what every
# `brew install` gets, so no tool session pushes it and no node runs this.
brew_confirm_push() {
  local asked=0
  DEVBIN_GATE_TTY="$(stdin_tty_flag)" ask_person "brew publish: render Formula/intent.rb and Casks/$CASK_TOKEN.rb from the published release and push them to $TAP?" || asked=$?
  case "$asked" in
    0) ;;
    1) die "declined at the prompt: nothing was fetched and nothing was pushed" ;;
    *) die "nobody to ask: --push confirms at the terminal, because a push to $TAP changes what every 'brew install' gets, and this process has no terminal. Nothing was fetched and nothing was pushed: run it at a terminal" ;;
  esac
}

# brew_write <out> <text> -- the rendered file at <out>, or on stdout when <out>
# is `-`. A relative <out> is read from the project root, where the dispatcher
# runs every command.
brew_write() {
  if [ "$1" = - ]; then
    printf '%s\n' "$2"
  else
    printf '%s\n' "$2" >"$1" || die "could not write $1"
    printf 'wrote: %s\n' "$1" >&2
  fi
}

# cmd_render -- `bin/int brew render <tag> <out>`: Formula/intent.rb, or with
# --cask Casks/intent-app.rb, for the release <tag> names, every hash read from
# the bytes at --from. The version is the tag's, so nobody types one (T8). See
# usage() for the flags.
cmd_render() {
  local revision=0 from="" version="" dev=0 tap="" cask=0 formula frc=0 dir rendered crc=0 tag="" out="" positional=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --revision)
        [ $# -ge 2 ] || die "brew render --revision needs a number"
        revision="$2"
        shift 2
        case "$revision" in
          '' | *[!0-9]*) die "brew render --revision takes a non-negative integer, got '${revision:-<empty>}'" ;;
        esac
        ;;
      --from)
        [ $# -ge 2 ] || die "brew render --from needs a base URL, eg file:///path/to/packages"
        from="${2%/}"
        shift 2
        ;;
      --dev-tap)
        dev=1
        shift
        ;;
      --tap)
        [ $# -ge 2 ] || die "brew render --tap needs a tap name, eg intent-dev/intent"
        tap="$2"
        shift 2
        ;;
      --cask)
        cask=1
        shift
        ;;
      -)
        positional+=("$1")
        shift
        ;;
      -*) die "brew render takes <tag> <out> and --revision N, --from URL, --dev-tap, --tap NAME and --cask, got: $1 (try: bin/devbin brew --help)" ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done
  [ "${#positional[@]}" -eq 2 ] || die "usage: bin/devbin brew render <tag> <out> [--revision N] [--from URL] [--dev-tap [--tap NAME]] [--cask]; <out> is a path, or - for stdout"
  tag="${positional[0]}"
  out="${positional[1]}"
  case "$tag" in
    v*) version="${tag#v}" ;;
    *) die "brew render takes a release tag, v<version>, got '$tag'" ;;
  esac
  case "$version" in
    '' | *[!A-Za-z0-9.+_-]*) die "brew render takes a tag whose version can sit in a URL, got '$tag'" ;;
  esac
  if [ "$cask" -eq 1 ]; then
    [ "$dev" -eq 0 ] && [ "$revision" -eq 0 ] ||
      die "brew render --cask renders the cask alone: it takes --from, and no --dev-tap, --tap or --revision"
  fi
  [ -z "$tap" ] || [ "$dev" -eq 1 ] || die "brew render --tap writes a dev tap, so it needs --dev-tap"
  [ "$dev" -eq 0 ] || [ -n "$from" ] ||
    die "brew render --dev-tap renders from local packages, so it needs --from, eg file:///path/to/packages"

  if [ "$cask" -eq 1 ]; then
    rendered="$(brew_cask "$version" "$from")" || crc=$?
    case "$crc" in
      0) ;;
      3) die "no cask: $APP_ASSET has to be there (named above)" ;;
      *) exit "$crc" ;;
    esac
    brew_write "$out" "$rendered"
    printf 'rendered from %s, its sha256 the hash of the bytes fetched from there\n' "${from:-the release $tag}" >&2
    return 0
  fi

  formula="$(brew_formula "$version" "$revision" "$from" "$dev")" || frc=$?
  case "$frc" in
    0) ;;
    3) die "no formula: every asset named above has to be there, and --dev-tap renders only the platforms that are" ;;
    *) exit "$frc" ;;
  esac
  brew_write "$out" "$formula"
  printf 'rendered from %s, every sha256 the hash of the bytes fetched from there\n' "${from:-the release $tag}" >&2

  if [ -n "$tap" ]; then
    require_tool brew
    dir="$(brew --repository "$tap")" || die "brew --repository $tap failed, so there is nowhere to write the dev tap"
    if [ ! -d "$dir" ]; then
      brew tap-new "$tap" >/dev/null || die "brew tap-new $tap failed, so the dev tap does not exist"
    fi
    mkdir -p "$dir/Formula" || die "could not make $dir/Formula"
    printf '%s\n' "$formula" >"$dir/Formula/intent.rb" || die "could not write $dir/Formula/intent.rb"
    printf 'dev tap: wrote %s/Formula/intent.rb\n  Homebrew 7 loads formulae only from taps it trusts, so trust this one and install:\n    brew trust --tap %s\n    brew install %s/intent\n' "$dir" "$tap" "$tap" >&2
  fi
}

# cmd_publish -- `bin/int brew publish`: render the newest release's formula,
# and its cask beside it, and push both to the tap in one commit, after asking
# at the terminal. The newest release is the one the staged binary reports, the
# release this checkout just cut, so it is handed no tag (T8).
cmd_publish() {
  local version formula frc=0 rendered crc=0
  [ $# -eq 0 ] || die "brew publish takes no arguments: it publishes the release the staged binary reports, got: $*"
  brew_confirm_push
  require_sums
  version="$(staged_version)"
  formula="$(brew_formula "$version" 0 "" 0)" || frc=$?
  case "$frc" in
    0) ;;
    3) die "nothing was pushed: publish needs a complete formula, and the release v$version does not carry every asset yet (named above)" ;;
    *) exit "$frc" ;;
  esac
  rendered="$(brew_cask "$version" "")" || crc=$?
  case "$crc" in
    0) ;;
    3) die "nothing was pushed: publish pushes the cask beside the formula, and the release v$version does not carry $APP_ASSET (named above)" ;;
    *) exit "$crc" ;;
  esac
  step "pushing Formula/intent.rb and Casks/$CASK_TOKEN.rb for v$version to $TAP"
  brew_push_tap "$formula" "$rendered" "$version" "Generated by 'bin/devbin brew publish' at a terminal, every hash read
from the bytes the published release serves."
  ok
}

# smoke -- the only check whose subject is the INSTALLED KEG.
#
# WHY IT IS NOT `brew test`. The formula carries a `test do` asserting exactly
# the thing that shipped broken, and `brew install` never runs it. `brew test`
# on an UNLINKED keg returns `not linked` and cannot gate a flip (vc's ruling),
# so this drives `$KEG/bin/intent` directly.
#
# WHY IT IS NOT DESTRUCTIVE BY DEFAULT, WHICH IS A CHANGE FROM ITS REGISTRATION.
# The row says "installs cold from the tap"; on this machine that would
# `brew uninstall` the binary EVERY CONCURRENT SESSION IS USING, mid-run, to
# test it. A check that breaks the estate to prove the estate works is not a
# check. So the cold install is `--reinstall`, opt-in and announced, and the
# default asserts against whatever keg is installed. What that costs is stated
# rather than hidden: without `--reinstall` this cannot tell a cold network
# install from a cache-preseeded one, and the preseed is precisely what hid the
# 644 defect -- so the default proves the keg on disk is good and says nothing
# about how it got there.
# COUNT THE FAILURES, NEVER THE LINES. The first version reported
# `grep -c '^'` over the accumulated text and reported more failed checks than
# it listed -- one message carried the multi-line output of the command it was
# reporting on. A miscount reads exactly as authoritative as a correct one.
smoke_fail() {
  SMOKE_FAIL_COUNT=$((SMOKE_FAIL_COUNT + 1))
  SMOKE_FAILURES="$SMOKE_FAILURES       - $1
"
  printf '    %-46s FAIL\n' "$2"
}

smoke_ok() { printf '    %-46s ok\n' "$1"; }

# smoke_views_fixture <binary> <dir> -- build ARM 7's subject, or leave no sentinel.
#
# IT NEVER FAILS THE RUN AND NEVER REPORTS SUCCESS IT DID NOT HAVE. The file is
# `set -euo pipefail`, so a fixture step that exits non-zero would kill the whole
# command between arms and read exactly like a pass. So the body runs in a
# subshell swallowed by `|| true`, and the ONLY evidence of success is the
# sentinel written by its last line. The caller tests the sentinel, never an
# exit code.
#
# THE GIT IDENTITY IS PASSED PER-COMMAND rather than assumed: on a machine with
# no global user.email the commit would fail and take the fixture with it, and
# the arm would report a build failure that is really a configuration one.
#
# BOTH IGNORES ARE LOAD-BEARING. `intent/.cache/` keeps the store and its WAL out
# of the assertion -- they are not views and their churn would swamp it. The
# sentinel is ignored because it is written INTO the fixture and would otherwise
# be untracked dirt in the very tree the next arm asserts is clean.
smoke_views_fixture() {
  local bin="$1" dir="$2"
  (
    set -e
    cd "$dir"
    "$bin" init smokefix
    "$bin" st new "A thread the read verb must name"
    printf 'intent/.cache/\n.fixture-ok\n' > .gitignore
    git init -q .
    git add -A
    git -c user.name=smoke -c user.email=smoke@fixture.invalid commit -qm base
    # The divergence: bytes in a TRACKED view that the store did not render.
    # A convergent fixture cannot exhibit a re-render, so it would pass under a
    # binary that rewrites every view on every read.
    printf '\n<!-- foreign line the store never rendered -->\n' >> intent/st/steel_threads.md
    git add intent/st/steel_threads.md
    git -c user.name=smoke -c user.email=smoke@fixture.invalid commit -qm diverge
    : > .fixture-ok
  ) >/dev/null 2>&1 || true
}

cmd_smoke() {
  local reinstall=0 keg_override=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reinstall) reinstall=1 ;;
      # `--keg <dir>` EXISTS SO THE GREEN PATH CAN BE DRIVEN WITHOUT A RELEASE,
      # following this file's own precedent for `unclassified_artefacts`: a
      # check whose first exercise is a release is one nobody has tested. It is
      # also the only way to prove the green path on a shared machine -- the
      # alternative is copying trees into the LIVE keg, which would fix the
      # fleet's critic gates by hand and leave the keg silently disagreeing with
      # what its formula installs. That is the drift class, not a repair.
      --keg) shift; keg_override="${1:-}"
        [ -n "$keg_override" ] || die "--keg needs a directory" ;;
      *) die "unknown smoke option: $1 (only --reinstall, --keg <dir>)" ;;
    esac
    shift
  done

  SMOKE_FAILURES=""
  SMOKE_FAIL_COUNT=0
  local keg libexec bin_intent bin_daemon out rc tmp mode f h

  if [ "$reinstall" -eq 1 ]; then
    step "reinstalling cold from the tap -- THIS UNLINKS THE BINARY OTHER SESSIONS ARE USING"
    brew uninstall --force intent >/dev/null 2>&1 || true
    brew untap "$BREW_TAP" >/dev/null 2>&1 || true
    rm -rf "$(brew --cache)"/downloads/*intent* 2>/dev/null || true
    brew tap "$BREW_TAP" >/dev/null 2>&1 || die "could not tap $BREW_TAP"
    brew install "$BREW_TAP/intent" >/dev/null 2>&1 ||
      die "brew install failed -- and note it EXITS 0 on the defect this exists to catch, so a failure here is something else"
  fi

  step "the installed keg"
  # Every capture below is `|| true`-guarded or tested. THE FILE IS
  # `set -euo pipefail`, so a bare assignment from a failing command
  # ABORTS THE RUN -- and this function's arms are SUPPOSED to fail. Driven
  # before it was noticed: the unknown-hook arm returned 1, set -e killed the
  # run between the last passing arm and the verdict, and `int macos smoke`
  # exited 1 having printed no failure list at all. A check that dies on its own
  # failing arm reports exactly like one that passed everything before it.
  keg=""
  if [ -n "$keg_override" ]; then
    keg="$keg_override"
    printf '    %-46s %s\n' "SUBJECT OVERRIDDEN" "not the installed keg"
  else
    keg="$(brew --cellar intent 2>/dev/null || true)/$(brew list --versions intent 2>/dev/null | awk '{print $2}' || true)"
  fi
  [ -d "$keg" ] || die "no installed keg for intent -- 'brew install $BREW_TAP/intent' first, or pass --reinstall"
  libexec="$keg/libexec"
  bin_intent="$keg/bin/intent"
  bin_daemon="$keg/bin/intentd"
  printf '    %-46s %s\n' "keg" "$keg"

  # ARM 1 -- THE DEFECT THIS COMMAND EXISTS FOR. Read `-x` back off the files
  # rather than trusting the formula's chmod: the formula is regenerated every
  # cut and the mode is lost in the network hop, so the only honest subject is
  # the installed file.
  step "the executable bit, read back off the installed files"
  for f in "$bin_intent" "$bin_daemon"; do
    if [ -x "$f" ]; then
      smoke_ok "$(basename "$f") is executable"
    else
      # GNU stat first, because GNU reads -f as a filesystem query and would print
      # the wrong thing on Linux; BSD stat has no -c, so it falls through to -f.
      mode="$(stat -c '%a' "$f" 2>/dev/null || stat -f '%OLp' "$f" 2>/dev/null || true)"
      smoke_fail "$f is mode ${mode:-unreadable} -- brew install succeeded and nothing in it runs" \
        "$(basename "$f") is executable"
    fi
  done

  # ARM 2 -- it runs at all, driven at the keg path, never through the symlink.
  step "the binaries answer"
  if out="$("$bin_intent" --version 2>&1)"; then
    smoke_ok "intent --version -> $out"
  else
    smoke_fail "\$KEG/bin/intent --version failed: $out" "intent --version"
  fi

  # ARM 3 -- THE CLASS, NOT THE INSTANCE (vc's ruling). Every path v3 resolves
  # against its install root must be present in the keg. Asserting only the
  # tree we happen to have just fixed is how the SECOND missing tree ships.
  #
  # AND UNTIL 2026-08-29 IT DID NOT DO THAT. It iterated `$SUPPORT_PATHS` -- THE
  # COPY LIST -- so its population was the very thing its claim was supposed to
  # audit. A path the copy list omits is absent from the keg AND absent from the
  # loop, so the arm reports every entry green and passes: measured against the
  # list as it stood that morning it would have reported every entry green while the keg was
  # missing `intent_claude_cwi` and `intent claude ws` was dark. The comment
  # above was already correct; the code under it was asserting something
  # narrower and nothing said so. Population now comes from the resolvers via
  # `resolved_install_paths`, which makes the arm's stated claim true.
  #
  # DELIBERATE, AND NOT A BUG TO FIX LATER: the resolver list is read from the
  # SOURCE TREE at smoke time, not from the keg's own binary. Smoking an OLD keg
  # against current source therefore reports the paths that keg lacks, which is
  # the correct verdict about that keg rather than a false alarm about it.
  step "every install-root path v3 resolves is present in the keg"
  for p in $(resolved_install_paths) $INSTALL_BINARY_PATHS; do
    if [ -e "$libexec/$p" ]; then
      smoke_ok "$p"
    else
      smoke_fail "$libexec/$p is absent -- the keg cannot serve what the binary resolves" "$p"
    fi
  done

  # ARM 4 -- the rule library is not merely PRESENT but READABLE BY THE BINARY.
  # Presence and arming are different claims and 3.0.0 could have failed either
  # way; a directory that exists and yields zero rules gates nothing.
  step "the rule library arms"
  out="$("$bin_intent" claude rules list --lang shell 2>&1 || true)"
  case "$out" in
    *"total: 0 rule(s)"* | "")
      smoke_fail "'claude rules list --lang shell' on the keg reports: $(printf '%s' "${out:-<nothing>}" | grep 'total:' || printf '%s' "${out:-<nothing>}" | tail -1)" "shell rules arm" ;;
    *) smoke_ok "shell rules arm -- $(printf '%s' "$out" | tail -1)" ;;
  esac

  # ARM 5 -- INTENT_HOME lands on libexec, with a guard body under it. Driven
  # from a directory that is not a checkout, because resolving correctly while
  # standing inside the source tree proves nothing about a stranger's machine.
  step "INTENT_HOME resolves onto libexec, from outside any checkout"
  tmp="$(mktemp -d)"
  # Keyed on the field, not the word: `intent info`'s `Gate root:` line can name
  # INTENT_HOME too, and a pattern match printed both values on 3.2.1's keg.
  out="$( (cd "$tmp" && "$bin_intent" info 2>&1 || true) | awk '$1 == "INTENT_HOME:" { print $2; exit }' || true)"
  if [ "$out" = "$libexec" ]; then
    smoke_ok "INTENT_HOME -> libexec"
  else
    smoke_fail "INTENT_HOME resolved to '${out:-<empty>}', not $libexec" "INTENT_HOME -> libexec"
  fi
  if [ -f "$libexec/lib/templates/hooks/pre-commit-guards.sh" ]; then
    smoke_ok "pre-commit-guards.sh under INTENT_HOME"
  else
    smoke_fail "$libexec/lib/templates/hooks/pre-commit-guards.sh absent -- vendored estates fail open" \
      "pre-commit-guards.sh under INTENT_HOME"
  fi

  # ARM 6 -- three session hooks answer 0, the gate refuses an unreleased prompt
  # with 2, and an unknown hook answers 1, NEVER 2.
  # The names are the binary's, not Claude Code's lifecycle names: driving
  # SessionStart/UserPromptSubmit/Stop returns rc=1 and reads as a failing arm
  # when it is a wrong instrument (dc, measured 2026-08-26).
  step "the session hooks"
  for h in session-context session-finish post-tool-advisory; do
    rc=0
    (cd "$tmp" && "$bin_intent" claude hook "$h" </dev/null >/dev/null 2>&1) || rc=$?
    # `rc` captured on its own line rather than read inside the else branch:
    # `$?` there is the condition's status and survives only until the next
    # command, so a message that interpolates it is one edit from lying.
    if [ "$rc" -eq 0 ]; then
      smoke_ok "hook $h -> 0"
    else
      smoke_fail "hook $h returned $rc -- expected 0" "hook $h -> 0"
    fi
  done
  # require-in-session IS THE GATE, AND FED NOTHING IT ANSWERED FOR THE MACHINE.
  # It exits 0 only where /tmp/intent holds a sentinel for the session id it
  # resolves, so this arm passed at every cut on a Mac where /in-session had left
  # one, and went red on a fresh machine where the keg refused, as it should
  # (issue 0600). So it is driven as cmd/linux's smoke_checks drives it: a
  # prompt, under a session id no sentinel exists for. The ids carry this run's
  # pid, so no sentinel an earlier run or session left in /tmp/intent can answer.
  #
  # AND IT HAS TWO BRANCHES, EACH DRIVEN UNDER ITS OWN HOME (issue 0601). Where
  # $HOME holds the in-session skill's releaser, the refusal is the pass: 2,
  # carrying the gate script's own `Expected sentinel:` line, which proves the
  # script under libexec ran. Where it does not, nothing in the session could
  # release the gate, so it fails open: 0, with the notice naming the install
  # verb. HOME is set for the hook alone, so the rest of the smoke keeps the
  # real one.
  # CLAUDE_CONFIG_DIR is unset for it too: the hook reads the releaser from
  # there before HOME, and a maintainer's shell that exports it (Molt-matts
  # does, from 2026-10-22) would hand the hook the real installed releaser.
  mkdir -p "$tmp/home-releaser/.claude/skills/in-session/scripts" "$tmp/home-bare"
  : >"$tmp/home-releaser/.claude/skills/in-session/scripts/release-gate.sh"
  rc=0
  out="$(cd "$tmp" && printf '%s' '{"prompt":"brew smoke"}' |
    env -u CLAUDE_CONFIG_DIR HOME="$tmp/home-releaser" CLAUDE_CODE_SESSION_ID="brew-smoke-$$" \
      "$bin_intent" claude hook require-in-session 2>&1)" || rc=$?
  case "$rc:$out" in
    2:*"Expected sentinel:"*) smoke_ok "hook require-in-session refuses -> 2" ;;
    *) smoke_fail "hook require-in-session returned $rc, expected 2 with the gate's 'Expected sentinel:' line: $(printf '%s' "${out:-<nothing>}" | tail -1)" \
      "hook require-in-session refuses -> 2" ;;
  esac
  rc=0
  out="$(cd "$tmp" && printf '%s' '{"prompt":"brew smoke"}' |
    env -u CLAUDE_CONFIG_DIR HOME="$tmp/home-bare" CLAUDE_CODE_SESSION_ID="brew-smoke-open-$$" \
      "$bin_intent" claude hook require-in-session 2>&1)" || rc=$?
  rm -f "/tmp/intent/in-session-brew-smoke-open-$$.sentinel"
  case "$rc:$out" in
    0:*"intent claude skills install in-session"*) smoke_ok "hook require-in-session without its releaser fails open -> 0" ;;
    *) smoke_fail "hook require-in-session without its releaser returned $rc, expected 0 with the notice naming the install verb: $(printf '%s' "${out:-<nothing>}" | tail -1)" \
      "hook require-in-session without its releaser fails open -> 0" ;;
  esac
  rc=0
  (cd "$tmp" && "$bin_intent" claude hook not-a-hook </dev/null >/dev/null 2>&1) || rc=$?
  case "$rc" in
    1) smoke_ok "unknown hook -> 1" ;;
    2) smoke_fail "unknown hook returned 2, which the gate reads as 'fail open'" "unknown hook -> 1" ;;
    *) smoke_fail "unknown hook returned $rc, expected 1" "unknown hook -> 1" ;;
  esac
  rm -rf "$tmp"

  # ARM 7 -- A READ VERB LEAVES THE TREE ALONE. A REGRESSION GUARD, NOT A FIX.
  #
  # WHAT IT IS NOT. The claim that the shipped keg silently re-rendered tracked
  # views on a read was RETRACTED on 2026-08-26 after independent
  # measurements refuted it -- the keg on different clones, and the pair on
  # convergent and divergent fixtures. Nothing here is chasing a live defect.
  # It exists because a tree that quietly gains modified files after a read
  # is invisible until someone runs `git status`, and the way that class returns
  # is a change nobody connects to views.
  #
  # THE ARM THAT MUST FALL SILENT NEEDS THE ARM THAT FIRES BESIDE IT. An
  # assertion that `git status` is EMPTY passes just as well when the verb never
  # ran, when the fixture has no tracked views, and when git is looking at the
  # wrong directory. So a WRITE verb runs immediately after against the SAME
  # fixture and must dirty it. Without that control this is a check that cannot
  # fail, which is the shape it is written to catch.
  #
  # AND THE READ VERB IS PROVEN TO HAVE RUN, NEVER TRUSTED ON rc. An
  # unparsed argument answers `unrecognized subcommand` at a perfectly plausible
  # exit code (dc, measured 2026-08-26: read as a product behaviour the product
  # never had). The arm asserts the thread id appears in the OUTPUT.
  #
  # THE STORE IS GITIGNORED BY HAND AND THAT IS ITSELF A FINDING. `init` writes
  # no .gitignore, so `git add -A` on a fresh project tracks intent/.cache/
  # intent.db -- and an untracked WAL beside a tracked db turns a routine
  # `git clean -fd` into silent data loss. Without the ignore, the db and its
  # WAL swamp this assertion and it reports dirt that says nothing about views.
  # `converge_gitignore` exists and only the migration path calls it; the fix is
  # to call it from `init`, and it is ic's file.
  #
  # HONEST LIMIT, STATED RATHER THAN DISCOVERED. The divergence planted below is
  # an INSERTED LINE, not an older RENDER FORMAT, and the fixture is built by
  # the same keg that reads it. So this proves the keg does not blindly rewrite
  # a view whose bytes it did not author. It does NOT prove that no divergence
  # shape can provoke a rewrite, and it is not the cross-version fixture, which
  # needs two kegs and does not fit inside a check whose subject is one.
  step "a read verb leaves tracked views alone, with a write verb as the control"
  tmp2="$(mktemp -d)"
  smoke_views_fixture "$bin_intent" "$tmp2"
  if [ -f "$tmp2/.fixture-ok" ]; then
    out="$( (cd "$tmp2" && "$bin_intent" st list --status all 2>&1) || true)"
    case "$out" in
      *ST0001*) smoke_ok "the read verb RAN (its output names ST0001)" ;;
      *) smoke_fail "'st list --status all' output does not name ST0001, so its exit code says nothing: ${out:-<empty>}" \
           "the read verb RAN" ;;
    esac

    dirt="$( (cd "$tmp2" && git status --porcelain) || true)"
    if [ -z "$dirt" ]; then
      smoke_ok "read verb left the tree clean"
    else
      smoke_fail "a read verb dirtied $(printf '%s\n' "$dirt" | grep -c .) path(s): $(printf '%s' "$dirt" | tr '\n' ' ')" \
        "read verb left the tree clean"
    fi

    if grep -q 'foreign line the store never rendered' "$tmp2/intent/st/steel_threads.md" 2>/dev/null; then
      smoke_ok "the planted divergence survived the read"
    else
      smoke_fail "the planted line is gone from steel_threads.md -- the view was re-rendered" \
        "the planted divergence survived the read"
    fi

    # THE CONTROL. It must FIRE. A green here is what entitles the greens
    # above to mean anything at all.
    (cd "$tmp2" && "$bin_intent" st triage ST0001 >/dev/null 2>&1) || true
    dirt="$( (cd "$tmp2" && git status --porcelain) || true)"
    if [ -n "$dirt" ]; then
      smoke_ok "CONTROL: a write verb dirtied $(printf '%s\n' "$dirt" | grep -c .) path(s)"
    else
      smoke_fail "CONTROL FAILED: a write verb left the tree clean, so the fixture cannot show a write and the clean reads above prove nothing" \
        "CONTROL: a write verb dirties the tree"
    fi
  else
    smoke_fail "the views fixture could not be built, so nothing above it was measured -- an arm that cannot run is not an arm that passed" \
      "views fixture built"
  fi
  rm -rf "$tmp2"

  # THE MANIFEST (ST0087 T3) -- the formula's install writes it, and it is
  # what makes doctor and `intent use` read this keg as the brew tree. Its body
  # is `shasum -a 256 -c` input, so the check is the tool's own, run from the
  # root the paths are relative to.
  step "the keg's manifest"
  if [ ! -f "$libexec/.intent-install" ]; then
    smoke_fail "$libexec/.intent-install is missing -- the formula that installed this keg did not write one, as none from 3.2.6 or earlier does" \
      "the manifest is there"
  elif ! grep -qx '# managed_by: brew' "$libexec/.intent-install"; then
    smoke_fail "$libexec/.intent-install does not say managed_by: brew" "the manifest says managed_by: brew"
  else
    smoke_ok "the manifest says managed_by: brew"
    # The tool is chosen before the pipe: a fallback after a failed first try would
    # read a stdin the first had already consumed.
    if command -v shasum >/dev/null 2>&1; then h="shasum -a 256 -c --quiet"; else h="sha256sum -c --quiet"; fi
    # shellcheck disable=SC2086 # h is a command and its flags, split on purpose
    if out="$(cd "$libexec" && grep -v '^#' .intent-install | $h 2>&1)"; then
      smoke_ok "every file matches the manifest"
    else
      smoke_fail "files differ from the manifest: $out" "every file matches the manifest"
    fi
  fi

  # THE KEG STAYS LINKED (decision 80): brew is the resting state, so after a
  # cut the tap's keg answers through Homebrew's bin and no step unlinks it. A
  # dev or opt tree a maintainer wants goes in front with `intent use`. Read
  # only for the installed keg: an overridden subject has no link to read.
  if [ -z "$keg_override" ]; then
    step "the keg is linked"
    f="$(brew --prefix 2>/dev/null || true)/bin/intent"
    h="$(realpath "$f" 2>/dev/null || readlink -f "$f" 2>/dev/null || true)"
    if [ -n "$h" ] && [ "$h" = "$(realpath "$libexec/bin/intent" 2>/dev/null || readlink -f "$libexec/bin/intent" 2>/dev/null)" ]; then
      smoke_ok "$f resolves into the keg"
    else
      smoke_fail "$f resolves to ${h:-nothing}, not this keg -- 'brew link intent' (and 'brew unpin intent' if it is pinned)" \
        "the keg is linked"
    fi
  fi

  printf '\n'
  if [ -n "$SMOKE_FAILURES" ]; then
    die "the installed keg fails $SMOKE_FAIL_COUNT check(s):
$SMOKE_FAILURES"
  fi
  printf 'smoke: the installed keg at %s answers every arm.\n' "$keg"
  if [ "$reinstall" -eq 0 ]; then
    printf '  SCOPE: this asserted the keg ON DISK. It did not install it, so it cannot\n'
    printf '  distinguish a cold network install from a cache-preseeded one -- and the\n'
    printf '  preseed is what hid the mode-644 defect. Use --reinstall for that claim,\n'
    printf '  and expect it to unlink the binary other sessions are using while it runs.\n'
  fi
}

usage() {
  cat <<'USAGE'
bin/devbin brew <subcommand>

  Intent's Homebrew formula, and the check of an installed keg (ST0081 WP-06).
  One formula serves macOS arm64 and Linux x86_64 and aarch64, and it is the
  one `bin/devbin macos publish` renders and pushes.

  render <tag> <out>
               Write Formula/intent.rb for the release <tag> names, v<version>,
               to <out>, or to stdout when <out> is -. Every sha256 is the hash
               of the bytes fetched from --from, the release's own download URL
               unless given, and the keg's manifest names the tag's commit, read
               from git. A release formula needs all five assets -- macOS
               arm64's intent, intentd and support tree, and the Linux x86_64
               and aarch64 packages -- and refuses, naming each missing one with
               its URL, rather than write a partial formula. From the release's
               own URL, the macOS hashes must equal those SHA256SUMS.txt records
               when it is staged.
    --revision N  a revision line, for a formula fix at an unchanged version
    --from URL    another base, eg file:///path/to/linux-dist; the formula then
                  states its version on a line of its own
    --dev-tap     render only the platforms whose assets are all at --from,
                  naming the rest, and depend on those platforms so it refuses
                  the others; needs --from. With no tag <tag> here, the
                  manifest names HEAD, and stderr says so
    --tap NAME    with --dev-tap, write it into the local tap NAME as well, made
                  with `brew tap-new` if it does not exist, so `brew install
                  NAME/intent` proves it before anything is pushed
    --cask        write Casks/intent-app.rb instead, its sha256 the hash of
                  Intent.app.zip fetched from --from; its url is always the
                  release's. Takes --from only
  publish      Render the formula of the release the staged binary reports, and
               the cask beside it, and push both to the tap in one commit, after
               asking at the terminal: for when the Linux packages reached the
               release after `macos publish` ran. Refuses with no terminal, and
               takes no arguments
  smoke        Assert the INSTALLED KEG, which is the only subject that has been
               through the network hop. Reads -x back off both binaries, checks
               every install-root path v3 resolves is present, that the rule
               library ARMS rather than merely existing, and drives INTENT_HOME
               and the session hooks from outside any checkout. It also builds
               a throwaway project whose tracked view carries bytes the store
               did not render, and asserts a READ verb leaves it alone -- with a
               WRITE verb beside it that must dirty the tree, because an
               assertion that nothing happened passes on a broken fixture too.
               `--reinstall` does the cold tap install first -- it unlinks the
               binary other sessions are using, so it is opt-in.
               `--keg <dir>` asserts a keg directory other than the installed one
USAGE
}

case "${1:-}" in
  "" | -h | --help)
    usage
    exit 0
    ;;
  render)
    shift
    cmd_render "$@"
    ;;
  publish)
    shift
    cmd_publish "$@"
    ;;
  smoke)
    shift
    cmd_smoke "$@"
    ;;
  *) die "unknown brew subcommand: $1 (try: $SUBCOMMANDS)" ;;
esac
