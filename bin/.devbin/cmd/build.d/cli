#!/usr/bin/env bash
#
# devbin: summary = The Rust CLI binary (cargo build -p intent-cli)
#
# intent build cli [cargo opts] -- build the ST0056 native CLI.
#
# Defaults to a release profile because the reason to build this binary at all
# is to run or ship it; pass --debug for a debug build. Extra arguments ride
# through to cargo untouched.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

profile=--release
args=()
for a in "$@"; do
  case "$a" in
    --debug) profile="" ;;
    *) args+=("$a") ;;
  esac
done

cd "$PROJECT_ROOT"
# shellcheck disable=SC2086  # $profile is one optional flag or empty, by design
exec cargo build -p intent-cli $profile "${args[@]}"
