#!/usr/bin/env bash
#
# devbin: summary = Every native binary in the workspace (cli + daemon)
#
# bin/devbin build all [--debug] [cargo opts] -- build every binary the
# workspace produces (intent and intentd).
#
# ALL MEANS ALL BINARIES, AND DELIBERATELY NOT `release`. `all` builds;
# `release` publishes; a target that did both would put a compile and a
# publication in one pass.
#
# Without --debug this is the guarded release build in shared/releasebuild.lib:
# a dirty build-input tree redirects to native/rust/target/private/release, and
# a clean one builds in native/rust/target/staging/release, is verified, and is
# then promoted into native/rust/target/release.
#
# One `cargo build` over the workspace rather than a loop over the other
# handlers: cargo already builds members in parallel and shares the dependency
# graph, so looping would serialise work cargo does better and would compile
# the shared intentsvcs twice over.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

profile=--release
args=()
for a in "$@"; do
  case "$a" in
    --debug) profile="" ;;
    *) args+=("$a") ;;
  esac
done

# THE GUARDED ENTRANCE. This file used to be `exec cargo build --workspace
# --bins` and nothing else, which is how a batch rebuild split the release pair
# and blocked a whole lane: cargo rebuilt the crates whose source had changed
# and left the other binary at an older commit, because at the time the source
# stamp's build script re-ran only on changes inside its own package. The set
# verification did not pass that pair -- IT NEVER RAN, because it lived in
# `int local build`, and the verb whose own help says ALL BINARIES was the bare
# one. The name stated the action; the guard lived somewhere else.
if [ -n "$profile" ]; then
  # Release: the one guarded path, shared with `int local build`. Dirt verdict,
  # then the provenance force, then the build, then the pair verification.
  . "$PROJECT_ROOT/bin/.devbin/cmd/shared/artefact.lib"
  . "$PROJECT_ROOT/bin/.devbin/cmd/shared/sharedtarget.lib"
  . "$PROJECT_ROOT/bin/.devbin/cmd/shared/currency.lib"
  . "$PROJECT_ROOT/bin/.devbin/cmd/shared/releasebuild.lib"
  guarded_release_build "${args[@]}"
  exit 0
fi

# `--debug` IS THE STATED EXCEPTION AND BYPASSES EVERY GUARD ABOVE.
#
# Not an oversight and not a shortcut: a debug build exists precisely TO run
# uncommitted code, so a dirt verdict here would refuse the one workflow it
# serves. Nothing downstream reads a debug binary's STAMP either -- and that
# narrow wording is load-bearing, because the wider claim that nothing reads a
# debug BINARY is false: `cmd/cli --debug` and `cmd/dogfood` both exec one.
cd "$PROJECT_ROOT/native/rust" || die "no Rust workspace at native/rust"
exec cargo build --workspace --bins "${args[@]}"
