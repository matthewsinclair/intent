#!/usr/bin/env bash
#
# devbin: summary = Cut, tag and publish an Intent release
#
# intent build release -- Intent release orchestrator
#
# Cuts an Intent release in one invocation: pre-flight checks, version bump,
# CHANGELOG date finalisation, sidecar sync (VERSION, config.json intent_version,
# AGENTS.md, CLAUDE.md), commit, tag, push to both remotes, and GitHub release
# publication. Every sidecar is stamped BEFORE the commit, so the tag describes a
# self-consistent tree -- there is no post-tag wrap to remember.
#
# Modelled on ../Conflab/scripts/release. Pared back to Intent's surface:
# single repo, two remotes (local Dropbox + upstream GitHub), no native
# binary build, no Homebrew tap.
#
# WRITING THE CHANGELOG SECTION
#
# Author the heading as `## [X.Y.Z] - in progress`, NOT with a hand-typed date.
# This script stamps the real date at cut time. A hand-dated heading is correct
# only on the day it was typed: it goes stale at midnight and aborts the
# pre-flight date gate, which is exactly what happened to v2.17.4. `in progress`
# makes the date correct by construction.
#
# Usage:
#   intent build release --patch | --minor | --major | vX.Y.Z [flags]
#
# Flags:
#   --dry-run            Compute and print every step; exit without side effects.
#   --no-confirm         Skip interactive confirmation before pushes / releases.
#   --skip-tests         Skip the pre-flight test/doctor gates (re-run mode).
#   --allow-stale-date   Accept a CHANGELOG date that is not today.
#   --help               Print this help and exit.
#
# Examples:
#   intent build release --dry-run --patch
#   intent build release --minor
#   intent build release v2.10.1
#
# Exit codes:
#   0  success (or dry-run completed)
#   1  pre-flight or validation failure
#   2  user aborted at confirmation prompt

set -u

# --------------------------------------------------------------------
# Locate project root + source helpers
# --------------------------------------------------------------------
# PROJECT_ROOT comes from the devbin dispatcher, which resolves it
# symlink-safe from the launcher's real location. It is NOT derived from this
# file's own path any more: as bin/release that was `$SCRIPT_DIR/..`, and this
# handler now sits four levels down at bin/.devbin/cmd/build.d/, where the same
# expression would resolve to bin/.devbin/cmd. Taking it from the dispatcher is
# both correct here and immune to the handler moving again.
: "${DEVBIN_LIB:?run me through the devbin dispatcher -- 'intent build release'}"
: "${PROJECT_ROOT:?the devbin dispatcher did not export PROJECT_ROOT}"
HELPERS="$PROJECT_ROOT/bin/intent_helpers"

# Pin INTENT_HOME to the checkout being released. bin/intent only derives it when
# it is unset, so an INTENT_HOME exported in the maintainer's shell -- pointing at
# whichever Intent they normally work in -- silently wins, and every sub-command
# reads THAT tree's VERSION. Releasing any checkout other than the habitual one
# would then stamp the wrong version into AGENTS.md and CLAUDE.md while VERSION
# and config.json carried the right one. Caught by cutting a test release from a
# clone; the release must describe the tree it is cutting, not the ambient one.
export INTENT_HOME="$PROJECT_ROOT"

if [ -f "$HELPERS" ]; then
  # shellcheck disable=SC1090
  source "$HELPERS"
else
  echo "error: cannot locate $HELPERS" >&2
  exit 1
fi

# --------------------------------------------------------------------
# Logging helpers (consistent with Intent CLI tone: lowercase prefixes)
# --------------------------------------------------------------------
log_info() { printf 'info: %s\n' "$*"; }
log_step() { printf '\n==> %s\n' "$*"; }
log_dry()  { printf 'dry-run: %s\n' "$*"; }
log_warn() { printf 'warning: %s\n' "$*" >&2; }

abort() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

confirm() {
  local prompt="$1"
  if [ "${NO_CONFIRM:-false}" = "true" ]; then
    log_info "$prompt -- (auto-confirmed via --no-confirm)"
    return 0
  fi
  # Read the confirmation from the controlling terminal, not stdin, so the
  # prompt still works when stdin/stdout are piped or redirected (eg a tee'd
  # release run, or a wrapper feeding the script on stdin). No terminal and no
  # --no-confirm -> abort; never proceed on an unread/EOF reply.
  if [ ! -r /dev/tty ]; then
    log_warn "$prompt -- no terminal to read confirmation; re-run with --no-confirm to proceed non-interactively"
    return 1
  fi
  printf '%s [y/N] ' "$prompt" > /dev/tty
  local reply=""
  IFS= read -r reply < /dev/tty
  # Tolerate stray input: a trailing CR (CRLF terminals) or surrounding
  # whitespace must not turn a clear "y" into a false abort of the push.
  reply="${reply//[$'\t\r\n ']/}"
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

# --------------------------------------------------------------------
# Argument parsing
# --------------------------------------------------------------------
TARGET=""
BUMP=""
DRY_RUN=false
NO_CONFIRM=false
SKIP_TESTS=false
ALLOW_STALE_DATE=false

usage() {
  # Window anchored on the header above: line 5 ('intent build release --')
  # through the flag list. It moved by two when the devbin summary line landed,
  # and it will move again if the header does -- the previous number was stale
  # the moment the file was converted.
  sed -n '5,34p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
  exit "${1:-0}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --patch|--minor|--major)
      [ -n "$BUMP" ] && abort "duplicate bump flag: $1"
      [ -n "$TARGET" ] && abort "cannot mix bump flag with explicit version"
      BUMP="${1#--}"
      ;;
    v[0-9]*.[0-9]*.[0-9]*)
      [ -n "$TARGET" ] && abort "duplicate target: $1"
      [ -n "$BUMP" ] && abort "cannot mix bump flag with explicit version"
      TARGET="${1#v}"
      ;;
    --dry-run)         DRY_RUN=true ;;
    --no-confirm)      NO_CONFIRM=true ;;
    --skip-tests)      SKIP_TESTS=true ;;
    --allow-stale-date) ALLOW_STALE_DATE=true ;;
    --help|-h)         usage 0 ;;
    *) abort "unknown argument: $1 (use --help for usage)" ;;
  esac
  shift
done

[ -z "$BUMP" ] && [ -z "$TARGET" ] && {
  printf 'error: must specify --patch, --minor, --major, or vX.Y.Z\n\n' >&2
  usage 1
}

# --------------------------------------------------------------------
# Helpers: semver compare, CHANGELOG slicing
# --------------------------------------------------------------------

semver_parts() {
  # Echo "MAJOR MINOR PATCH" or fail if input is not semver.
  local v="$1"
  if ! [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    abort "not a valid semver: $v"
  fi
  printf '%s %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

semver_bump() {
  # semver_bump CURRENT BUMP_KIND -> echoes target version
  local current="$1" kind="$2"
  read -r maj min pat <<<"$(semver_parts "$current")"
  case "$kind" in
    major) maj=$((maj+1)); min=0; pat=0 ;;
    minor) min=$((min+1)); pat=0 ;;
    patch) pat=$((pat+1)) ;;
    *) abort "internal: unknown bump kind: $kind" ;;
  esac
  printf '%d.%d.%d\n' "$maj" "$min" "$pat"
}

semver_gt() {
  # Return 0 if A > B, 1 otherwise.
  local a="$1" b="$2"
  read -r am an ap <<<"$(semver_parts "$a")"
  read -r bm bn bp <<<"$(semver_parts "$b")"
  if [ "$am" -ne "$bm" ]; then [ "$am" -gt "$bm" ]; return $?; fi
  if [ "$an" -ne "$bn" ]; then [ "$an" -gt "$bn" ]; return $?; fi
  [ "$ap" -gt "$bp" ]
}

extract_changelog_section() {
  # extract_changelog_section VERSION -> writes the section to stdout.
  # Section runs from "## [VERSION]" up to (but not including) the next "## [".
  local version="$1"
  awk -v ver="$version" '
    BEGIN { in_section = 0 }
    /^## \[/ {
      if (in_section) { exit }
      if ($0 ~ "^## \\["ver"\\]") { in_section = 1; print; next }
    }
    in_section { print }
  ' "$PROJECT_ROOT/CHANGELOG.md"
}

# --------------------------------------------------------------------
# Pre-flight gates
# --------------------------------------------------------------------

preflight() {
  log_step "pre-flight"

  # Working tree clean.
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain)" ]; then
    abort "working tree is not clean -- commit or stash first"
  fi
  log_info "working tree clean"

  # On main branch.
  local branch
  branch="$(cd "$PROJECT_ROOT" && git rev-parse --abbrev-ref HEAD)"
  if [ "$branch" != "main" ]; then
    abort "must be on main branch (currently: $branch)"
  fi
  log_info "on main branch"

  # Both remotes resolve.
  if ! (cd "$PROJECT_ROOT" && git remote get-url local >/dev/null 2>&1); then
    abort "git remote 'local' is not configured"
  fi
  if ! (cd "$PROJECT_ROOT" && git remote get-url upstream >/dev/null 2>&1); then
    abort "git remote 'upstream' is not configured"
  fi
  log_info "both remotes (local, upstream) configured"

  if [ "$SKIP_TESTS" = "true" ]; then
    log_warn "--skip-tests: skipping doctor + test suite"
    return 0
  fi

  # intent doctor.
  log_info "running intent doctor"
  if ! (cd "$PROJECT_ROOT" && "$PROJECT_ROOT/bin/intent" doctor >/dev/null 2>&1); then
    abort "intent doctor reported issues -- fix before releasing"
  fi
  log_info "intent doctor clean"

  # Test suite.
  log_info "running test suite (this may take a minute)"
  if ! (cd "$PROJECT_ROOT" && tests/run_tests.sh >/dev/null 2>&1); then
    abort "test suite failed -- fix before releasing"
  fi
  log_info "test suite green"

  # gh auth (we'll need it later).
  if ! command -v gh >/dev/null 2>&1; then
    abort "gh CLI not found in PATH"
  fi
  if ! gh auth status >/dev/null 2>&1; then
    abort "gh CLI is not authenticated (run: gh auth login)"
  fi
  log_info "gh CLI authenticated"
}

# --------------------------------------------------------------------
# Main flow
# --------------------------------------------------------------------

CURRENT="$(cat "$PROJECT_ROOT/VERSION" 2>/dev/null || echo "0.0.0")"
log_info "current version: $CURRENT"

if [ -n "$BUMP" ]; then
  TARGET="$(semver_bump "$CURRENT" "$BUMP")"
fi

# Validate target shape and ordering.
semver_parts "$TARGET" >/dev/null
if ! semver_gt "$TARGET" "$CURRENT"; then
  abort "target $TARGET is not greater than current $CURRENT"
fi
log_info "target version: $TARGET"

# CHANGELOG must have a section for the target.
CHANGELOG_SECTION="$(extract_changelog_section "$TARGET")"
if [ -z "$CHANGELOG_SECTION" ]; then
  abort "no '## [$TARGET]' section in CHANGELOG.md -- write release notes first"
fi
log_info "CHANGELOG section present for $TARGET"

# Validate CHANGELOG date.
TODAY="$(date +%Y-%m-%d)"
HEADER_LINE="$(printf '%s\n' "$CHANGELOG_SECTION" | head -1)"
case "$HEADER_LINE" in
  "## [$TARGET] - in progress"*)
    NEEDS_DATE_REWRITE=true
    log_info "CHANGELOG header still 'in progress' -- will rewrite to $TODAY"
    ;;
  "## [$TARGET] - $TODAY"*)
    NEEDS_DATE_REWRITE=false
    log_info "CHANGELOG date is today ($TODAY)"
    ;;
  "## [$TARGET] - "*)
    if [ "$ALLOW_STALE_DATE" = "true" ]; then
      NEEDS_DATE_REWRITE=false
      log_warn "CHANGELOG date is not today, but --allow-stale-date is set"
    else
      abort "CHANGELOG header is '$HEADER_LINE' but today is $TODAY (re-run with --allow-stale-date to accept)"
    fi
    ;;
  *)
    abort "unrecognised CHANGELOG header for $TARGET: '$HEADER_LINE'"
    ;;
esac

# --------------------------------------------------------------------
# Pre-flight (after we know the target so error messages can reference it)
# --------------------------------------------------------------------
preflight

# --------------------------------------------------------------------
# Sidecar sync
# --------------------------------------------------------------------
log_step "sidecar sync"

# The sidecars this script owns end to end: it writes them, stages them, and
# refuses to tag if anything else is left dirty. ONE list, read by the detect
# step and the commit step alike, so the two cannot disagree about what a
# release commit contains.
CONFIG_REL="intent/.config/config.json"
SIDECAR_FILES="VERSION CHANGELOG.md AGENTS.md CLAUDE.md $CONFIG_REL"

NEEDS_COMMIT=false

# /VERSION
if [ "$CURRENT" != "$TARGET" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would write '$TARGET' to $PROJECT_ROOT/VERSION"
  else
    printf '%s\n' "$TARGET" > "$PROJECT_ROOT/VERSION"
    log_info "wrote $TARGET to VERSION"
  fi
  NEEDS_COMMIT=true
else
  log_info "VERSION already at $TARGET"
fi

# CHANGELOG date finalisation
if [ "$NEEDS_DATE_REWRITE" = "true" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would rewrite '## [$TARGET] - in progress' to '## [$TARGET] - $TODAY' in CHANGELOG.md"
  else
    # Keep any trailing parenthesised note that follows " - in progress"
    # (e.g. " - in progress (ST0035 + ST0036)" -> " - $TODAY (ST0035 + ST0036)").
    sed -i.bak -E "s|^(## \[$TARGET\]) - in progress(.*)$|\1 - $TODAY\2|" "$PROJECT_ROOT/CHANGELOG.md"
    rm -f "$PROJECT_ROOT/CHANGELOG.md.bak"
    log_info "CHANGELOG date finalised to $TODAY"
  fi
  NEEDS_COMMIT=true
fi

# intent/.config/config.json -- Intent's own dogfooding stamp.
# Must happen HERE, before the commit, so the tag contains it. It used to be a
# manual wrap commit landing after the tag, which meant every published tag had
# VERSION and intent_version disagreeing.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would stamp intent_version = $TARGET in $CONFIG_REL"
else
  (cd "$PROJECT_ROOT" && stamp_project_version "$TARGET" "$CONFIG_REL")
  case $? in
    0) log_info "stamped intent_version = $TARGET in $CONFIG_REL"; NEEDS_COMMIT=true ;;
    1) log_info "$CONFIG_REL already at $TARGET" ;;
    *) abort "cannot stamp intent_version in $CONFIG_REL" ;;
  esac
fi

# AGENTS.md regeneration
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent agents sync' to refresh AGENTS.md footer"
else
  (cd "$PROJECT_ROOT" && "$PROJECT_ROOT/bin/intent" agents sync >/dev/null)
  log_info "AGENTS.md synced"
fi

# CLAUDE.md regeneration -- delegated to the canon engine that owns it, exactly
# as AGENTS.md is delegated to `intent agents sync`. The engine renders
# lib/templates/llm/_CLAUDE.md, preserves the user section and diffs, so the
# version + date restamp falls out of it. this handler renders no template itself:
# the substitution logic already has three homes and does not need a fourth.
#
# --skip-settings keeps the blast radius to the documents. Without it the engine
# also rewrites .claude/settings.json and the three hook scripts -- unrelated to
# the release, outside the sidecar list, and enough to trip the dirty-tree check
# below and abort the cut. A release refreshes the version stamp; it is not the
# place to re-provision the .claude/ stack.
#
# Those files no longer differ between checkouts (issue 0016 removed the last
# install-time path substitution), so this is now about scope rather than
# inevitability: skipping them keeps the release diff to what a release means.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent claude upgrade --apply --skip-settings' to refresh CLAUDE.md"
else
  (cd "$PROJECT_ROOT" && "$PROJECT_ROOT/bin/intent" claude upgrade --apply --skip-settings >/dev/null)
  log_info "CLAUDE.md refreshed"
fi

# Detect any change to a sidecar this script owns. Scoped to SIDECAR_FILES --
# the SAME list the commit stages. A bare `git status --porcelain` here used to
# set NEEDS_COMMIT from any dirty file at all, including ones the commit would
# never stage, so the script could announce a commit it had not made.
if [ "$DRY_RUN" != "true" ]; then
  # shellcheck disable=SC2086
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain -- $SIDECAR_FILES)" ]; then
    NEEDS_COMMIT=true
  fi
fi

# --------------------------------------------------------------------
# Commit (if any sidecar changed)
# --------------------------------------------------------------------
if [ "$NEEDS_COMMIT" = "true" ]; then
  log_step "commit"
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would stage $SIDECAR_FILES and commit as 'release: v$TARGET'"
  else
    # shellcheck disable=SC2086
    (cd "$PROJECT_ROOT" && git add -- $SIDECAR_FILES 2>/dev/null || true)
    # Only commit if there's something staged
    if [ -n "$(cd "$PROJECT_ROOT" && git diff --cached --name-only)" ]; then
      (cd "$PROJECT_ROOT" && git commit -m "release: v$TARGET" -m "(C) hello@matthewsinclair.com")
      log_info "committed release: v$TARGET"
    else
      log_info "nothing to commit (sidecars already at target)"
    fi
  fi
else
  log_info "no sidecar changes to commit"
fi

# Nothing outside the sidecar list may be left dirty. `intent claude upgrade
# --apply` can touch more than CLAUDE.md if the repo has drifted from canon, and
# a release must never tag a tree that still has uncommitted work in it -- the
# tag would not describe what was published. Fail loudly instead.
if [ "$DRY_RUN" != "true" ]; then
  LEFTOVER="$(cd "$PROJECT_ROOT" && git status --porcelain)"
  if [ -n "$LEFTOVER" ]; then
    log_warn "working tree is not clean after the sidecar sync:"
    printf '%s\n' "$LEFTOVER" | sed 's/^/  /' >&2
    abort "refusing to tag a dirty tree -- commit or revert the above, then re-run with --skip-tests"
  fi
fi

# --------------------------------------------------------------------
# Tag
# --------------------------------------------------------------------
log_step "tag"
TAG="v$TARGET"
TAG_EXISTS=false

if (cd "$PROJECT_ROOT" && git rev-parse "$TAG" >/dev/null 2>&1); then
  TAG_EXISTS=true
  TAG_SHA="$(cd "$PROJECT_ROOT" && git rev-parse "$TAG")"
  HEAD_SHA="$(cd "$PROJECT_ROOT" && git rev-parse HEAD)"
  if [ "$TAG_SHA" = "$HEAD_SHA" ]; then
    log_info "tag $TAG already at HEAD ($HEAD_SHA) -- reusing"
  else
    abort "tag $TAG exists at $TAG_SHA but HEAD is $HEAD_SHA -- refusing to force-move"
  fi
fi

if [ "$TAG_EXISTS" = "false" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would create tag $TAG at HEAD"
  else
    (cd "$PROJECT_ROOT" && git tag "$TAG")
    log_info "created tag $TAG"
  fi
fi

# --------------------------------------------------------------------
# Push
# --------------------------------------------------------------------
log_step "push"

PUSH_PROMPT="push $TAG to local (Dropbox) and upstream (GitHub)?"
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would push main + $TAG to 'local' (Dropbox)"
  log_dry "would push main + $TAG to 'upstream' (GitHub)"
else
  if ! confirm "$PUSH_PROMPT"; then
    log_warn "user aborted before push -- tag $TAG exists locally; re-run when ready"
    exit 2
  fi
  (cd "$PROJECT_ROOT" && git push local main "$TAG")
  log_info "pushed to local"
  (cd "$PROJECT_ROOT" && git push upstream main "$TAG")
  log_info "pushed to upstream"
fi

# --------------------------------------------------------------------
# GitHub release
# --------------------------------------------------------------------
log_step "github release"

NOTES_FILE="$(mktemp -t intent-release-notes.XXXXXX)"
# Re-extract after sidecar rewrite so the notes match what's on disk now.
extract_changelog_section "$TARGET" > "$NOTES_FILE"

GH_TITLE="Intent v$TARGET"

RELEASE_EXISTS=false
if gh release view "$TAG" >/dev/null 2>&1; then
  RELEASE_EXISTS=true
fi

if [ "$DRY_RUN" = "true" ]; then
  log_dry "would publish GitHub release $TAG with title '$GH_TITLE'"
  log_dry "release notes preview:"
  sed 's/^/  | /' "$NOTES_FILE" | head -30
  rm -f "$NOTES_FILE"
else
  if [ "$RELEASE_EXISTS" = "true" ]; then
    log_info "release $TAG already exists -- updating notes"
    gh release edit "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE"
  else
    gh release create "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE"
  fi
  log_info "release published"
  rm -f "$NOTES_FILE"
fi

# --------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------
log_step "summary"
if [ "$DRY_RUN" = "true" ]; then
  log_info "dry-run complete -- no side effects"
  log_info "to execute: re-run without --dry-run"
else
  log_info "Intent $TAG cut and published"
  log_info "  local:    pushed main + $TAG to ~/Dropbox/Repositories/Devel/Intent"
  log_info "  upstream: $(gh release view "$TAG" --json url -q .url 2>/dev/null || echo "(check gh release view $TAG)")"
fi
exit 0
