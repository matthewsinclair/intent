#!/usr/bin/env bash
#
# devbin: summary = Cut, tag and publish an Intent release
#
# bin/devbin build release -- Intent release orchestrator
#
# Cuts an Intent release in one invocation: pre-flight checks (clean tree, the
# published schema faces carry VERSION, on main, both remotes configured and not
# frozen, contract_check.sh reported but not gating, docs/reference describes
# HEAD, `intent doctor`, the bats suite, `cargo test --workspace` in a private
# worktree, gh authenticated), a canon-spill check before anything is stamped,
# version bump, CHANGELOG date finalisation, sidecar sync (VERSION and
# native/rust/Cargo.toml through `bin/devbin version set`, config.json
# intent_version, the schema faces regenerated, native/rust/Cargo.lock through
# cargo, AGENTS.md and CLAUDE.md rendered by a CLI built at the target version,
# and the generated views re-rendered with footer-only changes folded in),
# commit, tag, push to both remotes, and GitHub release publication. Every sidecar is stamped BEFORE the
# commit, so the tag describes a self-consistent tree -- there is no post-tag
# wrap to remember.
#
# Single repo, two remotes (local Dropbox + upstream GitHub).
#
# THIS COMMAND OWNS THE TAG AND THE RELEASE OBJECT, AND NOTHING ELSE (D43). It
# does not build, sign, notarise or upload a native binary, and it does not
# touch the Homebrew tap: `int macos prepare` owns the artefacts and
# `int macos publish` owns the assets on the object this creates. No command
# owns two of the three. What it DOES own for v3 is the version those artefacts
# will report -- `native/rust/Cargo.toml` carries `[workspace.package] version`
# and the binary compiles its own version string from it, so a tag cut without
# stamping it publishes a binary that disagrees with its own tag.
#
# WRITING THE CHANGELOG SECTION
#
# Author the heading as `## [X.Y.Z] - in progress` (or `- unreleased`),
# NOT with a hand-typed date. This script stamps the real date at cut time. A
# hand-dated heading is correct only on the day it was typed: it goes stale at
# midnight and aborts the pre-flight date gate, which is exactly what happened
# to v2.17.4. `in progress` makes the date correct by construction.
#
# Usage:
#   bin/devbin build release --patch | --minor | --major | vX.Y.Z [flags]
#
# Flags:
#   --dry-run            Run the pre-flight gates, then print every write step
#                        (version set, CHANGELOG date, config stamp, schema
#                        faces, lock, stamp CLI, canon, views, commit, tag,
#                        push, release) instead of performing it.
#   --no-confirm         Skip the interactive confirmation before the push.
#   --skip-tests         Skip the pre-flight doctor, bats and cargo test gates
#                        (re-run mode).
#   --allow-stale-date   Accept a CHANGELOG date that is not today.
#   --allow-stale-reference
#                        Cut even though docs/reference does not describe HEAD;
#                        the diff is kept and named in the output.
#   --help, -h           Print this help and exit.
#
# The binary it drives is native/rust/target/release/intent, resolved by path:
# build the release pair first with `bin/devbin build all`.
#
# Examples:
#   bin/devbin build release --dry-run --patch
#   bin/devbin build release --minor
#   bin/devbin build release vX.Y.Z   (explicit target; must exceed VERSION)
#
# Exit codes:
#   0  success (or dry-run completed)
#   1  pre-flight, validation or sidecar-step refusal
#   2  confirmation declined at the push, or no terminal to ask on (the tag
#      already exists locally)

set -u

# --------------------------------------------------------------------
# Locate project root + source helpers
# --------------------------------------------------------------------
# PROJECT_ROOT comes from the devbin dispatcher, which resolves it
# symlink-safe from the launcher's real location. It is NOT derived from this
# file's own path any more: as bin/release that was `$SCRIPT_DIR/..`, and this
# handler now sits four levels down at bin/.devbin/cmd/build.d/, where the same
# expression would resolve to bin/.devbin/cmd. Taking it from the dispatcher is
# both correct here and immune to the handler moving again.
: "${DEVBIN_LIB:?run me through the devbin dispatcher -- 'bin/devbin build release'}"
: "${PROJECT_ROOT:?the devbin dispatcher did not export PROJECT_ROOT}"

# Pin INTENT_HOME to the checkout being released, so any child process that
# reads it sees the tree being cut rather than whichever Intent the maintainer's
# shell points at. Nothing this script drives depends on it today: the v3
# `intent` binary reads no INTENT_HOME at all
# (native/rust/crates/intent-cli/tests/no_intent_home.rs holds it to that), and
# tests/run_tests.sh exports its own. The pin is a guard for a child that does
# read it -- the release must describe the tree it is cutting, not the ambient
# one.
export INTENT_HOME="$PROJECT_ROOT"

# **THE `intent` THIS SCRIPT DRIVES IS THE ONE BUILT FROM THE TREE BEING
# RELEASED, RESOLVED BY PATH AND NEVER BY `PATH` LOOKUP.**
#
# The v2 sites this replaced named `$PROJECT_ROOT/bin/intent` -- a file IN the
# checkout -- so this script has always been deterministic about which tool it
# ran, and that property is the thing most easily lost in the port. Swapping a
# path for a bare `intent` is not a port; it is a loss of determinism smuggled
# in as one, and it would be invisible because both spellings work on any
# machine that is set up correctly.
#
# **IT MATTERS BECAUSE CALLS BELOW WRITE CANON INTO THE RELEASE.**
# `agents sync` regenerates AGENTS.md and `claude upgrade --apply`
# regenerates CLAUDE.md, both committed as sidecars of the cut. Under a `PATH`
# lookup the released BYTES would be a function of the operator's shell.
#
# **AND THE FAILURE IS LIVE RATHER THAN THEORETICAL.** Measured 2026-08-30:
# `intent --version` reported `dirty-a402625f...` while `intentd --version`
# named no commit at all, `self_provenance_check.sh` had the pair built from
# DIFFERENT trees, and `~/.local/bin/intent` is a symlink straight into a
# release directory that passes through nothing. The ambient binary is
# precisely the one with no provenance guarantee.
#
# **REFUSES RATHER THAN FALLING BACK.** A fallback that warns is a fallback
# that gets ignored, and it reintroduces the nondeterminism in exactly the case
# where it matters. This script does not build the binary -- `bin/devbin build
# all` (or `bin/devbin local build`) builds the release pair into
# native/rust/target/release -- so an absent one is a sequencing error the
# operator must see.
INTENT_BIN="$PROJECT_ROOT/native/rust/target/release/intent"

# --------------------------------------------------------------------
# Logging helpers (consistent with Intent CLI tone: lowercase prefixes)
# --------------------------------------------------------------------
log_info() { printf 'info: %s\n' "$*"; }
log_step() { printf '\n==> %s\n' "$*"; }
log_dry()  { printf 'dry-run: %s\n' "$*"; }
log_warn() { printf 'warning: %s\n' "$*" >&2; }

# --------------------------------------------------------------------
# Ported from bin/intent_helpers, 2026-09-05 (cc), for AC-00.6.
#
# **THIS WAS THE WHOLE OF THE v2 COUPLING, AND IT IS ONE FUNCTION.** The row
# named blocking call sites in this file; the others were ported earlier and
# only the `source` of `bin/intent_helpers` survived. Sourcing that whole file
# says nothing about what is USED, so the coupling read as large: of everything
# that file defined, this script called exactly this. `require_intent_bin` is
# defined below in this file and always was; the `error` matches a grep finds
# here are prose and printf strings, not calls.
#
# **VERBATIM, AND THE RETURN CODES ARE THE CONTRACT.** The caller reads `$?` as
# a three-way -- 0 stamped, 1 already at target, anything else a hard abort --
# so this is a move rather than a rewrite. It reaches nothing else: jq, mktemp
# and mv, no other helper, and none of the variables that file exported.
stamp_project_version() {
  local version="$1"
  local config="${2:-intent/.config/config.json}"
  [ -n "$version" ] || return 2
  [ -f "$config" ] || return 2
  command -v jq >/dev/null 2>&1 || return 2
  local current
  current="$(jq -r '.intent_version // ""' "$config" 2>/dev/null)"
  [ "$current" = "$version" ] && return 1
  local tmp
  tmp="$(mktemp)" || return 2
  if ! jq --arg v "$version" '.intent_version = $v | del(.version)' "$config" > "$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  mv "$tmp" "$config" || { rm -f "$tmp"; return 2; }
  return 0
}

# **ONE HOME FOR THE REFUSAL, CALLED AT EACH USE RATHER THAN ASSERTED ONCE AT
# THE TOP.** The calls sit behind different flags -- `--skip-tests` skips the
# doctor entirely, and the canon regenerations have their own `--dry-run`
# branches -- so a single top-level assertion would refuse a run that was never
# going to touch the binary, and an assertion placed at only the first use
# would let the later ones through when that one is skipped.
require_intent_bin() {
  [ -x "$INTENT_BIN" ] && return 0
  abort "no built CLI at $INTENT_BIN -- this script drives the binary built FROM the tree it is releasing, and does not build it. Run \`bin/devbin build all\` (or \`bin/devbin local build\`) first. It is resolved by path rather than through PATH deliberately: two of the calls below regenerate canon that ships in this cut, so an ambient binary would make the released bytes a function of your shell."
}

abort() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

# **A GATE THAT REFUSES WITHOUT NAMING WHAT REFUSED COSTS A REBUILD TO
# DIAGNOSE, AND THAT IS A DEFECT IN THE RELEASE PATH RATHER THAN A NICETY.**
# Both test gates below used to run their suite as `>/dev/null 2>&1` and abort
# on the exit code alone, so the only thing the release could say was that
# something failed. Driven in a rehearsal clone on 2026-09-12: the bats gate
# refused, and naming the test took a second full clone and release build,
# because the output the first run had already produced was thrown away.
#
# **THE LOG IS KEPT OUTSIDE THE PROJECT, DELIBERATELY.** A log written under
# `$PROJECT_ROOT` would dirty the tree that the `working tree clean` gate above
# has already passed, so a gate meant to explain a refusal would start causing
# one. It is removed on success and left behind on failure, which is the only
# moment anybody wants it.
#
# **CREATED ONCE, IN THE RUN'S OWN SHELL, BY preflight.** Every reader takes the
# path through `$(release_log_dir)`, a subshell, so the lazy create this used to
# do there never persisted and its abort stopped only that subshell: the caller
# carried on with an empty path and redirected to `/contract_check.log`. On
# Linux that is how every dry run died, because the template was `-t` with no
# X's, which BSD mktemp takes as a prefix and GNU mktemp refuses.
open_release_log_dir() {
  RELEASE_LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/intent-release-gates.XXXXXX")" || abort "cannot create a directory for the gate logs"
}

release_log_dir() {
  printf '%s' "$RELEASE_LOG_DIR"
}

# Refuse, naming what failed and where the whole output is.
#
# `$3` is the shape a failure takes in THIS suite's output -- bats writes
# `not ok <n> <name>`, cargo writes `test <name> ... FAILED`. When it matches
# nothing the log is still named rather than a silent empty block printed: a
# gate that fails in an unanticipated shape is precisely when the operator
# needs the whole file.
abort_with_log() {
  local message="$1" log="$2" pattern="$3" lines
  lines="$(grep -E "$pattern" "$log" 2>/dev/null | head -20)"
  printf 'error: %s\n' "$message" >&2
  if [ -n "$lines" ]; then
    printf '  what failed:\n' >&2
    printf '%s\n' "$lines" | sed 's/^/    /' >&2
  else
    printf '  no line in the output matches this gate failure shape, so read it whole.\n' >&2
  fi
  printf '  full output: %s\n' "$log" >&2
  exit 1
}

confirm() {
  local prompt="$1"
  if [ "${NO_CONFIRM:-false}" = "true" ]; then
    log_info "$prompt -- (auto-confirmed via --no-confirm)"
    return 0
  fi
  # Read the confirmation from the controlling terminal, not stdin, so the
  # prompt still works when stdin/stdout are piped or redirected (eg a tee'd
  # release run, or a wrapper feeding the script on stdin). No terminal and no
  # --no-confirm -> abort; never proceed on an unread/EOF reply.
  if [ ! -r /dev/tty ]; then
    log_warn "$prompt -- no terminal to read confirmation; re-run with --no-confirm to proceed non-interactively"
    return 1
  fi
  printf '%s [y/N] ' "$prompt" > /dev/tty
  local reply=""
  IFS= read -r reply < /dev/tty
  # Tolerate stray input: a trailing CR (CRLF terminals) or surrounding
  # whitespace must not turn a clear "y" into a false abort of the push.
  reply="${reply//[$'\t\r\n ']/}"
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

# --------------------------------------------------------------------
# Argument parsing
# --------------------------------------------------------------------
TARGET=""
BUMP=""
DRY_RUN=false
NO_CONFIRM=false
SKIP_TESTS=false
ALLOW_STALE_DATE=false
ALLOW_STALE_REFERENCE=false

usage() {
  # ANCHORED ON STRUCTURE, NOT ON LINE NUMBERS. This was a hardcoded `5,34p`
  # window over the header above, and the header grew past it: --help printed
  # the title, the prose, and the word "Usage:", then stopped -- exit 0, not one
  # flag, not one example, not one exit code. A help text that confidently lists
  # no options is worse than none, and it fails on the one morning it is read.
  #
  # Its own comment had predicted the drift ("it will move again if the header
  # does") and wrote the prediction down instead of removing the coupling. A
  # note cannot notice; a rule that reads the block's real boundaries cannot
  # forget. The block is every comment line from the top to the first line that
  # is not one, less the shebang and the dispatcher directive, which are
  # machinery rather than help.
  awk '
    NR == 1 && /^#!/ { next }
    /^# devbin:/     { next }
    !/^#/            { exit }
                     { print }
  ' "${BASH_SOURCE[0]}" |
    sed -e 's/^# //' -e 's/^#$//' -e '/./,$!d'
  exit "${1:-0}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --patch|--minor|--major)
      [ -n "$BUMP" ] && abort "duplicate bump flag: $1"
      [ -n "$TARGET" ] && abort "cannot mix bump flag with explicit version"
      BUMP="${1#--}"
      ;;
    v[0-9]*.[0-9]*.[0-9]*)
      [ -n "$TARGET" ] && abort "duplicate target: $1"
      [ -n "$BUMP" ] && abort "cannot mix bump flag with explicit version"
      TARGET="${1#v}"
      ;;
    --dry-run)         DRY_RUN=true ;;
    --no-confirm)      NO_CONFIRM=true ;;
    --skip-tests)      SKIP_TESTS=true ;;
    --allow-stale-date) ALLOW_STALE_DATE=true ;;
    --allow-stale-reference) ALLOW_STALE_REFERENCE=true ;;
    --help|-h)         usage 0 ;;
    *) abort "unknown argument: $1 (use --help for usage)" ;;
  esac
  shift
done

[ -z "$BUMP" ] && [ -z "$TARGET" ] && {
  printf 'error: must specify --patch, --minor, --major, or vX.Y.Z\n\n' >&2
  usage 1
}

# --------------------------------------------------------------------
# Helpers: semver compare, CHANGELOG slicing
# --------------------------------------------------------------------

semver_parts() {
  # Echo "MAJOR MINOR PATCH" or fail if input is not semver.
  local v="$1"
  if ! [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    abort "not a valid semver: $v"
  fi
  printf '%s %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

semver_bump() {
  # semver_bump CURRENT BUMP_KIND -> echoes target version
  local current="$1" kind="$2"
  read -r maj min pat <<<"$(semver_parts "$current")"
  case "$kind" in
    major) maj=$((maj+1)); min=0; pat=0 ;;
    minor) min=$((min+1)); pat=0 ;;
    patch) pat=$((pat+1)) ;;
    *) abort "internal: unknown bump kind: $kind" ;;
  esac
  printf '%d.%d.%d\n' "$maj" "$min" "$pat"
}

semver_gt() {
  # Return 0 if A > B, 1 otherwise.
  local a="$1" b="$2"
  read -r am an ap <<<"$(semver_parts "$a")"
  read -r bm bn bp <<<"$(semver_parts "$b")"
  if [ "$am" -ne "$bm" ]; then [ "$am" -gt "$bm" ]; return $?; fi
  if [ "$an" -ne "$bn" ]; then [ "$an" -gt "$bn" ]; return $?; fi
  [ "$ap" -gt "$bp" ]
}

# --------------------------------------------------------------------
# The view classifier, for the re-render fold further down (issue 0464).
# --------------------------------------------------------------------
#
# `footer_only` reads one file's `git diff -U0` on stdin and exits 0 when every
# changed line is the generated footer, `_Generated by Intent vX.Y.Z ...`, and
# 1 otherwise, including when nothing changed at all.
#
# It counts only lines INSIDE a hunk. It used to select changed lines with
# `^[-+][^-+]`, which also skipped every changed line whose own text starts with
# `-` or `+`: a markdown bullet reads `-- item` or `+- item` in a diff, and a
# removed or added blank line reads `-` or `+` alone. A view whose only real
# change was a bullet was classed footer-only and folded into the release
# commit under the release message. Tracking the hunk is what tells a
# `--- a/<path>` file header from a removed line reading `-- ...`.
footer_only() {
  awk '
    /^diff --git / { in_hunk = 0; next }
    /^@@ / { in_hunk = 1; next }
    !in_hunk { next }
    /^[-+]/ {
      changed++
      if ($0 !~ /^[-+]_Generated by Intent v[0-9]+\.[0-9]+\.[0-9]+ /) other = 1
    }
    END { exit (changed > 0 && !other) ? 0 : 1 }
  '
}

# --------------------------------------------------------------------
# Cargo.lock introspection, for the native lock check further down.
# --------------------------------------------------------------------
#
# `lock_packages` emits one `name<TAB>version` per `[[package]]`. `lock_members`
# emits the workspace members, which are exactly the packages carrying no
# `source` line -- a path package has none, a registry one always does.
#
# The member list is DERIVED from the lockfile being checked rather than from
# `cargo metadata`, for two reasons. It needs no `jq` and no second cargo
# invocation, and -- the one that matters -- there is no separate list to keep
# in step: a crate newly added to the workspace counts as a member here the
# moment it is one there. A hardcoded roster would have silently reclassified
# the next crate as a dependency, which is the direction that fails quietly.

lock_packages() {
  awk '
    /^\[\[package\]\]/ { name=""; version=""; next }
    /^name = "/        { name=$0;    sub(/^name = "/,"",name);       sub(/"$/,"",name);       next }
    /^version = "/     { version=$0; sub(/^version = "/,"",version); sub(/"$/,"",version);
                         if (name != "") print name "\t" version; next }
  ' "$1" | sort
}

lock_members() {
  awk '
    /^\[\[package\]\]/ { if (name != "" && !src) print name; name=""; src=0; next }
    /^name = "/        { name=$0; sub(/^name = "/,"",name); sub(/"$/,"",name); next }
    /^source = /       { src=1; next }
    END                { if (name != "" && !src) print name }
  ' "$1" | sort
}

lock_nonmember_changes() {
  # lock_nonmember_changes BEFORE AFTER -> names of changed non-member packages.
  #
  # Empty output means every package whose name/version pair changed is a
  # workspace member of AFTER, which is the only condition under which a release
  # may fold a refreshed lockfile into its commit.
  #
  # Returns non-zero WITHOUT emitting names when either extraction comes back
  # empty. An empty parse yields an empty difference, so it would otherwise
  # report "nothing changed" and accept anything -- the caller must be able to
  # tell "no offenders" from "could not look".
  #
  # This lives in a function rather than inline at the call site because the
  # comparison is pure over two files, so it can be tested for what it actually
  # decides. Inline it could only be grepped, and a grep cannot tell whether the
  # thing it matched is correct -- which is how the defect below survived.
  local before="$1" after="$2"
  local pkgs_before pkgs_after members
  pkgs_before="$(mktemp)"; pkgs_after="$(mktemp)"; members="$(mktemp)"

  lock_packages "$before" > "$pkgs_before"
  lock_packages "$after"  > "$pkgs_after"
  lock_members  "$after"  > "$members"

  if [ ! -s "$pkgs_after" ] || [ ! -s "$members" ]; then
    rm -f "$pkgs_before" "$pkgs_after" "$members"
    return 1
  fi

  comm -3 "$pkgs_before" "$pkgs_after" | sed 's/^\t//' | cut -f1 | sort -u |
    comm -23 - "$members"
  rm -f "$pkgs_before" "$pkgs_after" "$members"
  return 0
}

extract_changelog_section() {
  # extract_changelog_section VERSION -> writes the section to stdout.
  # Section runs from "## [VERSION]" up to (but not including) the next "## [".
  local version="$1"
  awk -v ver="$version" '
    BEGIN { in_section = 0 }
    /^## \[/ {
      if (in_section) { exit }
      if ($0 ~ "^## \\["ver"\\]") { in_section = 1; print; next }
    }
    in_section { print }
  ' "$PROJECT_ROOT/CHANGELOG.md"
}

# schema_faces_version_blockers <version> -- published faces under `schema/` that
# do not carry <version>, one indented line each, naming what they carry instead.
# Empty output means every face names it.
#
# WHY THIS EXISTS AT ALL: the v3.0.1 TAG SHIPPED A RED SUITE. `schema/*` carried
# `INTENT_VER: 3.0.0` beside a VERSION of 3.0.1, because the faces are generated
# from `env!("CARGO_PKG_VERSION")` at COMPILE time and the stamp step moved the
# manifest without regenerating them. Five tests fail at that tag. Nothing in the
# release asked the question, so nothing answered it.
#
# THE FACES ARE READ, NOT THE GENERATOR. Asking each published file what it says
# is what a consumer of the release does; deriving the answer from the types
# again would agree with itself by construction.
#
# TWO SPELLINGS, ONE MARKER. `faces.rs` stamps `INTENT_VER: <v>` into the SQL and
# SDL faces as a comment and `"x-intent-ver": "<v>"` into each JSON Schema, so the
# reader matches both rather than assuming a format per extension.
schema_faces_version_blockers() {
  local version="$1" f rel v out=""
  for f in "$PROJECT_ROOT"/schema/*; do
    [ -f "$f" ] || continue
    rel="${f#"$PROJECT_ROOT"/}"
    case "$f" in
      *.json)
        v="$(sed -n 's/.*"x-intent-ver"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)" ;;
      *)
        v="$(sed -n 's/^[^A-Za-z]*INTENT_VER:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$f" | head -1)" ;;
    esac
    [ "$v" = "$version" ] || out="$out  $rel carries ${v:-<no version marker>}
"
  done
  printf '%s' "$out"
}

# --------------------------------------------------------------------
# Pre-flight gates
# --------------------------------------------------------------------

preflight() {
  log_step "pre-flight"
  open_release_log_dir

  # Working tree clean.
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain)" ]; then
    abort "working tree is not clean -- commit or stash first"
  fi
  log_info "working tree clean"

  # THE PUBLISHED FACES AGREE WITH THE TREE'S OWN VERSION, BEFORE ANYTHING MOVES.
  # A tree whose faces name another version is already the v3.0.1 defect, and
  # blessing them later would bury it: the release would look clean while the
  # faces were repaired under it. Refused here, where the fix is one command and
  # its own commit. Not gated by --skip-tests: this is a state of the tree, not a
  # suite, and it costs a read of a handful of files.
  faces_stale="$(schema_faces_version_blockers "$CURRENT")"
  if [ -n "$faces_stale" ]; then
    abort "the published schema faces do not carry this tree's VERSION ($CURRENT):
$faces_stale
       regenerate them and commit that on its own first:
         (cd native/rust && INTENT_BLESS=1 cargo test -p intentsvcs schema_faces_drift)"
  fi
  log_info "schema faces carry $CURRENT"

  # On main branch.
  local branch
  branch="$(cd "$PROJECT_ROOT" && git rev-parse --abbrev-ref HEAD)"
  if [ "$branch" != "main" ]; then
    abort "must be on main branch (currently: $branch)"
  fi
  log_info "on main branch"

  # Both remotes resolve.
  if ! (cd "$PROJECT_ROOT" && git remote get-url local >/dev/null 2>&1); then
    abort "git remote 'local' is not configured"
  fi
  if ! (cd "$PROJECT_ROOT" && git remote get-url upstream >/dev/null 2>&1); then
    abort "git remote 'upstream' is not configured"
  fi
  log_info "both remotes (local, upstream) configured"

  # A FROZEN REMOTE IS A PRE-FLIGHT FAILURE, NOT A PUSH FAILURE.
  #
  # This script pushes `local` AND `upstream`, and the pre-push gate refuses a
  # remote the hypervisor has closed. Discovering that at the push step means the
  # commit is made, the sidecars are stamped and THE TAG IS ALREADY CUT -- a
  # release that is half-published, with a tag on one remote, no GitHub release,
  # and a confusing refusal from a gate the operator was not thinking about.
  #
  # Each step is correct and the composition is not, which is this thread's
  # recurring shape. The fix is to ask the question at the only moment the answer
  # is still cheap.
  #
  # The list comes from `int prepush --list-frozen` rather than being restated
  # here: the runner that enforces the rule is the authority on what the rule is.
  frozen_hit=""
  if [ -x "$PROJECT_ROOT/bin/int" ]; then
    # A LISTING THAT FAILS IS NOT AN EMPTY LIST (issue 0465). It was read as
    # `2>/dev/null || true`, so a failed listing let the gate pass unchecked and
    # the release then pushed to both remotes.
    frozen_list="$("$PROJECT_ROOT/bin/int" prepush --list-frozen 2>&1)" ||
      abort "the frozen-remote check could not run: 'bin/int prepush --list-frozen' failed, so nothing says whether a remote this release pushes to is closed. Its output:
$frozen_list"
    for frozen in $frozen_list; do
      case "$frozen" in
        local | upstream) frozen_hit="$frozen" ;;
      esac
    done
  fi
  if [ -n "$frozen_hit" ]; then
    abort "remote '$frozen_hit' is FROZEN, and this release would push to it.

  A release cannot complete while a remote it publishes to is closed, and
  finding that out at the push step leaves the tag already cut.

  If the hypervisor has lifted the freeze, remove '$frozen_hit' from
  FROZEN_REMOTES in bin/.devbin/cmd/prepush and commit that first."
  fi
  log_info "no frozen remote in the push set"

  # THE CONTRACT CHECK IS PRINTED AND GATES NOTHING (vc, 2026-09-15). It asks whether
  # data-model.md and the published schema faces describe the same fields, both ways
  # (ST0069 WP-16). runner_roster_check.sh rosters it manual, and a release gate on it
  # would be hv's call, which nobody has asked for. Its three exits mean three
  # different things, so each prints its own line: 0 the two agree, 1 a finding that
  # wants an author, anything else no verdict at all. It runs before --skip-tests
  # returns because it is a read of the tree, not a suite.
  local contract_log contract_rc=0
  contract_log="$(release_log_dir)/contract_check.log"
  bash "$PROJECT_ROOT/intent/st/ST0056/parity/tools/contract_check.sh" > "$contract_log" 2>&1 || contract_rc=$?
  case "$contract_rc" in
    0)
      rm -f "$contract_log"
      log_info "contract_check: clean -- data-model.md and the published schema faces describe the same fields"
      ;;
    1) log_warn "contract_check: FINDINGS -- data-model.md and the published schema faces disagree; the release does not wait on it (rostered manual). full output: $contract_log" ;;
    *) log_warn "contract_check: NO VERDICT (rc=$contract_rc) -- it could not run here; the release does not wait on it. full output: $contract_log" ;;
  esac

  # THE CUT REFUSES A STALE docs/reference (hv, 2026-09-18, vc decision 38 Q5).
  # v3.0.3's tag shipped the previous cut's pages because the regeneration landed
  # after it and nothing said so; intent/docs/releasing.md put the step on a page,
  # and this is what stops the page having to be remembered. It regenerates into
  # scratch and diffs, writing nothing, so the fix stays a human's commit made
  # BEFORE this run. Here and not at the tag: by the tag, the commit that should
  # have held the pages is the one being tagged. Not gated by --skip-tests, for
  # the contract check's reason -- a read of the tree, not a suite. The override
  # keeps the diff and names it, so a lagging cut leaves a trace.
  local ref_log ref_rc=0
  ref_log="$(release_log_dir)/reference_current_check.log"
  bash "$PROJECT_ROOT/intent/st/ST0056/parity/tools/reference_current_check.sh" > "$ref_log" 2>&1 || ref_rc=$?
  case "$ref_rc" in
    0)
      rm -f "$ref_log"
      log_info "docs/reference describes HEAD against the previous release tag"
      ;;
    1)
      if [ "$ALLOW_STALE_REFERENCE" = "true" ]; then
        log_warn "docs/reference is STALE and --allow-stale-reference is set -- this cut ships pages that do not describe it. diff kept: $ref_log"
      else
        abort "docs/reference does not describe HEAD -- regenerate both halves and commit them before releasing (intent/docs/releasing.md).
  the diff and the commands: $ref_log
  to cut anyway, re-run with --allow-stale-reference"
      fi
      ;;
    *) abort "reference_current_check gave NO VERDICT (rc=$ref_rc), so the cut cannot say its reference pages are current. full output: $ref_log" ;;
  esac

  # gh auth, ABOVE the --skip-tests return (issue 0462). It is a read, not a
  # suite, so the flag has no reason to skip it -- the rule the contract and
  # reference checks above already follow -- and skipping it let a re-run on an
  # unauthenticated gh commit, tag and push before gh release create refused.
  if ! command -v gh >/dev/null 2>&1; then
    abort "gh CLI not found in PATH"
  fi
  if ! gh auth status >/dev/null 2>&1; then
    abort "gh CLI is not authenticated (run: gh auth login)"
  fi
  log_info "gh CLI authenticated"

  if [ "$SKIP_TESTS" = "true" ]; then
    log_warn "--skip-tests: skipping doctor + test suite"
    return 0
  fi

  # intent doctor.
  require_intent_bin
  log_info "running intent doctor"
  if ! (cd "$PROJECT_ROOT" && "$INTENT_BIN" doctor >/dev/null 2>&1); then
    abort "intent doctor reported issues -- fix before releasing"
  fi
  log_info "intent doctor clean"

  # Test suite.
  log_info "running test suite (this may take a minute)"
  local bats_log
  bats_log="$(release_log_dir)/bats.log"
  if ! (cd "$PROJECT_ROOT" && tests/run_tests.sh) > "$bats_log" 2>&1; then
    abort_with_log "test suite failed -- fix before releasing" "$bats_log" '^not ok'
  fi
  rm -f "$bats_log"
  log_info "test suite green"

  # Rust workspace. THE BATS SUITE ABOVE NEVER COMPILES THE NATIVE TREE -- the
  # only other `cargo` in this whole file is `cargo metadata` for the lock
  # refresh -- so until this landed, a Rust product was gated on a shell test
  # suite. CI runs `cargo test --workspace` (.github/workflows/rust.yml) and the
  # release did not, which is the wrong way round: CI reports, the release
  # DECIDES.
  #
  # GUARDED ON THE MANIFEST EXISTING, AND THE ALTERNATIVE THAT WAS REJECTED IS
  # WORTH KEEPING. This used to be tempted by a `STAMP_NATIVE` flag set in the
  # sidecar-sync section, which runs AFTER this function -- so reading it here
  # would have tested an empty string and skipped in silence on every release.
  # That is the exact shape of gate this function exists to remove, and it would
  # have shipped inside the fix for it. The flag itself is gone now (its 2.x arm
  # became unreachable once VERSION passed 3.0.0), but a state read before its
  # writer runs is the class, not the variable.
  if [ -f "$PROJECT_ROOT/$NATIVE_MANIFEST_REL" ]; then
    if ! command -v cargo >/dev/null 2>&1; then
      abort "cargo not found in PATH and $NATIVE_MANIFEST_REL is present -- refusing to release a native tree this machine cannot test"
    fi
    # Issue 0389 (ruled): the gate runs in a PRIVATE worktree at HEAD under an
    # isolated HOME with that worktree's own target dir, never in the shared
    # checkout beside the live daemon, and a red confined to the load-sensitive
    # family re-runs ONCE, never twice.
    #
    # THE FAMILY IS A MECHANISM, NOT A LIST OF NAMES: arms that wait on an
    # FSEvents-driven event under a poll budget, so a host whose fseventsd is
    # saturated fails them with the code unchanged. Today that is the
    # daemon_subscriptions target, daemon_watch, and
    # a_source_edit_reaches_the_index_and_costs_canon_nothing. An arm joins the
    # pattern below because it waits on such an event, never because its name
    # looks like one of these.
    log_info "running cargo test --workspace in a private worktree at HEAD (this may take several minutes)"
    local cargo_log gate_dir gate_native gate_rc reds
    local real_cargo_home="${CARGO_HOME:-$HOME/.cargo}" real_rustup_home="${RUSTUP_HOME:-$HOME/.rustup}"
    cargo_log="$(release_log_dir)/cargo-test.log"
    gate_dir="$(mktemp -d "${TMPDIR:-/tmp}/intent-release-gate.XXXXXX")"
    if ! git -C "$PROJECT_ROOT" worktree add --quiet --detach "$gate_dir/tree" HEAD >/dev/null 2>&1; then
      rm -rf "$gate_dir"
      abort "could not create a private worktree at HEAD for the test gate under $gate_dir"
    fi
    gate_native="$gate_dir/tree/$(dirname "$NATIVE_MANIFEST_REL")"
    mkdir -p "$gate_dir/home"
    gate_cargo() {
      (cd "$gate_native" && HOME="$gate_dir/home" CARGO_HOME="$real_cargo_home" \
        RUSTUP_HOME="$real_rustup_home" CARGO_TARGET_DIR="$gate_native/target" cargo "$@")
    }
    gate_rc=0
    if ! { gate_cargo build -p intentd && gate_cargo test --workspace --no-fail-fast; } > "$cargo_log" 2>&1; then
      gate_rc=1
      reds="$(awk '/^ +Running /{target=$0} /^test .* \.\.\. FAILED$/{print target " :: " $2}' "$cargo_log")"
      if [ -n "$reds" ] && ! printf '%s\n' "$reds" | grep -v -E 'daemon_subscriptions|daemon_watch::|a_source_edit_reaches_the_index_and_costs_canon_nothing|the_daemon_lists_the_project_registry|a_daemon_outlives_nobody' | grep -q .; then
        log_warn "cargo test --workspace red only in the load-sensitive daemon family -- re-running intentd's tests once:"
        printf '%s\n' "$reds" | sed 's/^/  /' >&2
        if gate_cargo test -p intentd --no-fail-fast >> "$cargo_log" 2>&1; then
          gate_rc=0
        fi
      fi
    fi
    git -C "$PROJECT_ROOT" worktree remove --force "$gate_dir/tree" >/dev/null 2>&1
    rm -rf "$gate_dir"
    if [ "$gate_rc" != 0 ]; then
      abort_with_log "cargo test --workspace failed -- fix before releasing" "$cargo_log" '^test .* FAILED|^test result: FAILED'
    fi
    rm -f "$cargo_log"
    log_info "cargo test green"
  fi

}

# --------------------------------------------------------------------
# Main flow
# --------------------------------------------------------------------

CURRENT="$(cat "$PROJECT_ROOT/VERSION" 2>/dev/null || echo "0.0.0")"
log_info "current version: $CURRENT"

if [ -n "$BUMP" ]; then
  TARGET="$(semver_bump "$CURRENT" "$BUMP")"
fi

# Validate target shape and ordering.
semver_parts "$TARGET" >/dev/null
if ! semver_gt "$TARGET" "$CURRENT"; then
  abort "target $TARGET is not greater than current $CURRENT"
fi
log_info "target version: $TARGET"

# CHANGELOG must have a section for the target.
CHANGELOG_SECTION="$(extract_changelog_section "$TARGET")"
if [ -z "$CHANGELOG_SECTION" ]; then
  abort "no '## [$TARGET]' section in CHANGELOG.md -- write release notes first"
fi
log_info "CHANGELOG section present for $TARGET"

# Validate CHANGELOG date.
TODAY="$(date +%Y-%m-%d)"
HEADER_LINE="$(printf '%s\n' "$CHANGELOG_SECTION" | head -1)"
# UNDATED_PLACEHOLDER is the single home for "which not-yet-dated word this
# header used", and the rewrite below derives its sed from it rather than
# re-listing the legal forms. Two homes for that set is how `unreleased`
# reached a rewrite that could only match `in progress`: the case arm would
# have set the flag, the sed would have matched nothing, and the run would have
# logged "CHANGELOG date finalised" over an unchanged file.
case "$HEADER_LINE" in
  "## [$TARGET] - in progress"*)
    NEEDS_DATE_REWRITE=true
    UNDATED_PLACEHOLDER="in progress"
    log_info "CHANGELOG header still 'in progress' -- will rewrite to $TODAY"
    ;;
  "## [$TARGET] - unreleased"*)
    # Keep-a-Changelog's own word for the same state, and the word CHANGELOG.md
    # cites in its header. It is not a stale DATE, so the stale-date branch
    # below reported the wrong cause and offered a flag that could not fix it.
    NEEDS_DATE_REWRITE=true
    UNDATED_PLACEHOLDER="unreleased"
    log_info "CHANGELOG header still 'unreleased' -- will rewrite to $TODAY"
    ;;
  "## [$TARGET] - $TODAY"*)
    NEEDS_DATE_REWRITE=false
    log_info "CHANGELOG date is today ($TODAY)"
    ;;
  "## [$TARGET] - "*)
    if [ "$ALLOW_STALE_DATE" = "true" ]; then
      NEEDS_DATE_REWRITE=false
      log_warn "CHANGELOG date is not today, but --allow-stale-date is set"
    else
      abort "CHANGELOG header is '$HEADER_LINE' but today is $TODAY (re-run with --allow-stale-date to accept)"
    fi
    ;;
  *)
    abort "unrecognised CHANGELOG header for $TARGET: '$HEADER_LINE'"
    ;;
esac

# --------------------------------------------------------------------
# Native workspace location
# --------------------------------------------------------------------
# Defined HERE, above preflight's CALL, and not beside the sidecar list below --
# because preflight needs them and the sidecar section runs after it. A second
# copy inside preflight() would be two homes for one pair of paths; this is one
# definition hoisted above its first reader.
NATIVE_MANIFEST_REL="native/rust/Cargo.toml"
NATIVE_LOCK_REL="native/rust/Cargo.lock"

# --------------------------------------------------------------------
# Pre-flight (after we know the target so error messages can reference it)
# --------------------------------------------------------------------
preflight

# --------------------------------------------------------------------
# Sidecar sync
# --------------------------------------------------------------------
log_step "sidecar sync"

# The sidecars this script owns end to end: it writes them, stages them, and
# refuses to tag if anything else is left dirty. ONE list, read by the detect
# step and the commit step alike, so the two cannot disagree about what a
# release commit contains.
CONFIG_REL="intent/.config/config.json"

# `native/rust/Cargo.toml` carries `[workspace.package] version`, every crate
# inherits it with `version.workspace = true`, and both binaries compile their
# own version string from `env!("CARGO_PKG_VERSION")`. So the workspace version
# IS the v3 product's version -- the number on `intent --version` and on the
# page intentd serves -- and the lockfile records it per member, so the two must
# move together.
#
# THIS WAS CONDITIONAL ON A 3.x TARGET AND THE CONDITION IS NOW UNREACHABLE, so
# it is deleted rather than left as a guard that reads as live. Its own comment
# predicted the retirement -- "once 2.x stops being cut there is no other arm" --
# and what retired it is not a judgement call: `semver_gt "$TARGET" "$CURRENT"`
# above aborts anything not GREATER than the current version, and the current
# version is a 3.x. A 2.x target cannot reach this line to be excluded by it.
#
# The hazard the condition guarded is real and has simply moved upstream:
# stamping `2.19.1` into the Rust workspace would make the next v3 build
# announce itself as a v2. If 2.x is ever cut again it will be from a branch
# whose VERSION is a 2.x, where `semver_gt` admits it -- and this handler will
# need the arm back. That is a deliberate condition to restore at that point,
# not a silent behaviour to rediscover.
#
# THE NATIVE PAIR WAS AN APPEND TO THIS LIST UNTIL 2026-09-11, which made the
# append a second home for the list the comment above says there is one of
# (vc, AC-00.6). Folded into the one declaration; the set is unchanged.
# `schema` is a DIRECTORY entry on purpose: the faces are generated, so a face
# added to a future release joins the commit without this list being edited.
SIDECAR_FILES="VERSION CHANGELOG.md AGENTS.md CLAUDE.md $CONFIG_REL $NATIVE_MANIFEST_REL $NATIVE_LOCK_REL schema"

NEEDS_COMMIT=false

# Read BEFORE anything writes it: the lock half below reports what the manifest
# moved from, and after `version set` that number is gone.
NATIVE_BEFORE="$(sed -n 's/^version = "\(.*\)"$/\1/p' "$PROJECT_ROOT/$NATIVE_MANIFEST_REL" | head -1)"

# THE VERSION SYNC IS TWO HALVES, AND THIS HANDLER OWNS ONLY THE SECOND.
#
# `bin/devbin version set` writes VERSION and every file named in
# `project.version_sidecars` -- here, `native/rust/Cargo.toml`. devbin refuses a
# lockfile BY NAME (no generic recipe can know which `[[package]]` entries are
# this project's own), so the workspace lock is ours and is synced below.
#
# THIS WAS HAND-ROLLED HERE UNTIL NOW, AND THAT WAS THE VERSION DEFECT IN
# MINIATURE: two mechanisms for one fact. `int version check` sat unconfigured
# and answered green over an empty list, while the only code that actually knew
# where the version lives ran once per release and nowhere else. One writer now,
# and `check` interrogates the same declaration the writer uses, so the two
# cannot disagree about which files are homes.
#
# WHY THE CONDITION WENT WITH IT. The old form wrote VERSION only when
# `$CURRENT != $TARGET`. devbin's invariant 2 is that the sync is
# UNCONDITIONAL, and it is written from a shipped defect: an only-if-different
# gate skipped sidecar healing whenever the version file already held the
# target, so a tree with VERSION bumped in one commit and a sidecar lagging
# published the wrong number. Always write; let git decide what changed.
#
# ORDERING IS devbin's INVARIANT 1 AND IS WHY THIS IS ONE CALL RATHER THAN TWO:
# every sidecar first, the version file LAST, so a partial failure leaves the
# version un-advanced and a re-run recomputes the same target instead of
# bumping twice onto a half-synced tree.
# Issue 0386: the canon spill is checked BEFORE anything is stamped, from
# `claude upgrade`'s own dry run, so a refusal leaves the tree as it found it
# and the re-run the refusal asks for is not blocked by the clean-tree gate.
# IN BOTH MODES (issue 0463): it is a read, and a dry run that skipped it
# passed a tree the real run then refused.
require_intent_bin
# THE DRY RUN'S OWN FAILURE IS KEPT (issue 0466). It was read through
# `2>/dev/null | sed`, so a claude upgrade that failed printed nothing, read as
# "no spill", and the check passed on no evidence.
spill_report="$(cd "$PROJECT_ROOT" && "$INTENT_BIN" claude upgrade 2>&1)" ||
  abort "the canon-spill check could not run: 'intent claude upgrade' (its dry run) failed, so nothing says what --apply would rewrite. Nothing has been stamped. Its output:
$spill_report"
EARLY_SPILL=""
while IFS= read -r _path; do
  [ -n "$_path" ] || continue
  case " $SIDECAR_FILES " in *" $_path "*) continue ;; esac
  (cd "$PROJECT_ROOT" && git ls-files --error-unmatch -- "$_path" >/dev/null 2>&1) || continue
  EARLY_SPILL="$EARLY_SPILL  $_path
"
done < <(printf '%s\n' "$spill_report" | sed -n 's/^would write: //p')
if [ -n "$EARLY_SPILL" ]; then
  abort "refusing to cut: 'claude upgrade --apply' would rewrite tracked files outside the sidecar list:
$EARLY_SPILL       Nothing has been stamped or committed. Bring these into line with canon in their own commit
       (\`intent claude upgrade --apply\` writes them), then re-run."
fi

if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'bin/devbin version set $TARGET' -- VERSION + declared sidecars ($NATIVE_MANIFEST_REL)"
  [ "$CURRENT" != "$TARGET" ] && NEEDS_COMMIT=true
else
  if ! (cd "$PROJECT_ROOT" && ./bin/devbin version set "$TARGET" >/dev/null); then
    abort "bin/devbin version set $TARGET failed -- VERSION and the declared sidecars are the release's version, and a tag over a half-synced pair is the defect this replaced"
  fi
  log_info "version set $TARGET: VERSION + declared sidecars"
  [ "$CURRENT" != "$TARGET" ] && NEEDS_COMMIT=true
fi

# CHANGELOG date finalisation
if [ "$NEEDS_DATE_REWRITE" = "true" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would rewrite '## [$TARGET] - $UNDATED_PLACEHOLDER' to '## [$TARGET] - $TODAY' in CHANGELOG.md"
  else
    # Keep any trailing parenthesised note that follows the placeholder
    # (e.g. " - in progress (ST0035 + ST0036)" -> " - $TODAY (ST0035 + ST0036)").
    sed -i.bak -E "s|^(## \[$TARGET\]) - $UNDATED_PLACEHOLDER(.*)$|\1 - $TODAY\2|" "$PROJECT_ROOT/CHANGELOG.md"
    rm -f "$PROJECT_ROOT/CHANGELOG.md.bak"
    # No silent success: the sed above is derived from UNDATED_PLACEHOLDER, but
    # a header that changed between the check and the rewrite would leave the
    # file untouched and this log would still claim the date was finalised.
    if grep -q "^## \[$TARGET\] - $TODAY" "$PROJECT_ROOT/CHANGELOG.md"; then
      log_info "CHANGELOG date finalised to $TODAY"
    else
      abort "CHANGELOG date rewrite did not take: no '## [$TARGET] - $TODAY' after rewriting '$UNDATED_PLACEHOLDER'"
    fi
  fi
  NEEDS_COMMIT=true
fi

# intent/.config/config.json -- Intent's own dogfooding stamp.
# Must happen HERE, before the commit, so the tag contains it. It used to be a
# manual wrap commit landing after the tag, which meant every published tag had
# VERSION and intent_version disagreeing.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would stamp intent_version = $TARGET in $CONFIG_REL"
else
  (cd "$PROJECT_ROOT" && stamp_project_version "$TARGET" "$CONFIG_REL")
  case $? in
    0) log_info "stamped intent_version = $TARGET in $CONFIG_REL"; NEEDS_COMMIT=true ;;
    1) log_info "$CONFIG_REL already at $TARGET" ;;
    *) abort "cannot stamp intent_version in $CONFIG_REL" ;;
  esac
fi

# THE PUBLISHED SCHEMA FACES CARRY THE VERSION BEING CUT, AND THEY ARE
# REGENERATED BY THEIR OWN GENERATOR RATHER THAN EDITED. `faces.rs` stamps
# `env!("CARGO_PKG_VERSION")`, so the manifest bump above makes every committed
# face stale by construction: that is what the v3.0.1 tag shipped. The bless test
# is the faces' one regeneration path, and it writes the tree it was compiled
# from -- so it runs here, after the manifest moved, in the release's own tree.
#
# AND THE WRITE IS VERIFIED BY READING THE FILES, because a generator that ran is
# not a face that says the right thing: a bless against a manifest that did not
# move would exit 0 and leave the old version in place.
log_step "schema faces"
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would re-bless the published faces for $TARGET: (cd native/rust && INTENT_BLESS=1 cargo test -p intentsvcs schema_faces_drift), then refuse unless every face carries $TARGET"
else
  if ! (cd "$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")" &&
    INTENT_BLESS=1 cargo test -p intentsvcs schema_faces_drift >/dev/null 2>&1); then
    abort "could not regenerate the schema faces for $TARGET -- run it directly to see why:
         (cd native/rust && INTENT_BLESS=1 cargo test -p intentsvcs schema_faces_drift)"
  fi
  faces_stale="$(schema_faces_version_blockers "$TARGET")"
  if [ -n "$faces_stale" ]; then
    abort "the published schema faces still do not carry $TARGET after regenerating them:
$faces_stale
       the generator ran and the files disagree, so the two are out of step -- do not tag this"
  fi
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain -- schema)" ]; then
    # Staged here so a face that is NEW to this release joins the commit; the
    # commit step names `schema` among the sidecars and commits what is there.
    (cd "$PROJECT_ROOT" && git add -- schema) ||
      abort "could not stage the regenerated schema faces"
    log_info "schema faces regenerated for $TARGET"
    NEEDS_COMMIT=true
  else
    log_info "schema faces already carry $TARGET"
  fi
fi

# native/rust -- THE LOCK HALF. The manifest was written above, by `version set`
# through the declared sidecar; devbin refuses a lockfile by name, so the lock is
# this handler's to sync and the two halves meet here.
#
# THE LOCK IS NOT OPTIONAL. `Cargo.lock` records each workspace member's version,
# so stamping the manifest alone leaves the two disagreeing and **every
# `--locked` build fails** -- which is the build a release should be using.
# Measured on a clean HEAD checkout: manifest-only is REFUSED with `cannot update
# the lock file ... because --locked was passed`.
#
# CARGO WRITES THE LOCK; THIS SCRIPT DOES NOT REIMPLEMENT IT. The obvious version
# rewrote the member entries by hand, and it was wrong the first time it ran: it
# stamped the members it listed and MISSED `intentd`, a shipped binary.
# A hand-kept list of crates is the needle that skips the names nobody has
# invented yet, and this workspace will gain crates. Cargo knows the members;
# asking it cannot go stale.
#
# BUT CARGO IS ALLOWED TO DO MORE THAN WE ASKED, so the diff is BOUNDED and a
# surprise is a refusal rather than a silent dependency bump inside a release
# commit. Measured on the same checkout: the update touches exactly the
# workspace member version lines and no dependency at all. If it ever touches
# anything else, the release stops -- **the one moment a resolver change must not
# ride along unnoticed is the commit the tag points at.**
#
# UNCONDITIONAL, and the `already at $TARGET` short-circuit that stood here is
# gone with the manifest write it guarded. It was devbin's invariant 2 in local
# form: skipping the refresh whenever the MANIFEST already held the target is
# exactly the case where the LOCK is the thing that drifted, so the one tree
# needing the heal was the one that never got it. A refresh on an already-
# consistent lock is a no-op diff, which is the cheap half of the trade.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would refresh $NATIVE_LOCK_REL via cargo, refusing any change beyond workspace member versions"
else
  lock_before="$(mktemp)"
  cp "$PROJECT_ROOT/$NATIVE_LOCK_REL" "$lock_before"

  # No --locked: the point is to let cargo rewrite the lock. Not --offline
  # either: the lock legitimately names targets this machine never builds
  # (windows, wasm), and --offline fails on those with an error that reads
  # exactly like an inconsistent lockfile. Measured, and it cost a wrong
  # diagnosis before it was.
  if ! (cd "$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")" && cargo metadata --format-version 1 >/dev/null 2>&1); then
    cp "$lock_before" "$PROJECT_ROOT/$NATIVE_LOCK_REL"
    rm -f "$lock_before"
    abort "cargo could not refresh $NATIVE_LOCK_REL after the version stamp"
  fi

  # WHAT MUST BE TRUE: only WORKSPACE MEMBER versions changed.
  #
  # That is not the same claim as "every changed line is a version line",
  # which is what this check tested until 2026-08-16 -- and the two differ
  # exactly where it matters. A dependency bump is a lone `version = "..."`
  # line, identical in shape to a member's, so the old form ACCEPTED the
  # single most likely resolver change while its own comment said it refused
  # one. Canaried and measured: a lone `serde` bump sailed straight through.
  # The comment and the code agreed with each other and both were wrong about
  # the invariant, which is why reading them together proved nothing.
  #
  # Correlating each changed version with the package NAME it sits under is
  # the whole fix, and it lets the refusal name the offending crate instead of
  # printing diff lines a reader has to interpret.
  # A non-zero return is "could not look", never "nothing changed": an
  # extractor that silently returns nothing makes the comparison report no
  # changes, so the check would ACCEPT ANYTHING and say so confidently. An
  # empty parse is a broken parse, never a clean lockfile.
  if ! unexpected="$(lock_nonmember_changes "$lock_before" "$PROJECT_ROOT/$NATIVE_LOCK_REL")"; then
    cp "$lock_before" "$PROJECT_ROOT/$NATIVE_LOCK_REL"
    rm -f "$lock_before"
    abort "could not read packages or workspace members out of $NATIVE_LOCK_REL -- refusing to check nothing and call it clean"
  fi

  rm -f "$lock_before"
  if [ -n "$unexpected" ]; then
    abort "refreshing $NATIVE_LOCK_REL changed packages that are NOT workspace members -- refusing to fold a dependency change into a release commit:
$(printf '%s\n' "$unexpected" | sed 's/^/  /')"
  fi

  if [ "$NATIVE_BEFORE" = "$TARGET" ]; then
    log_info "$NATIVE_LOCK_REL refreshed; $NATIVE_MANIFEST_REL was already at $TARGET"
  else
    log_info "synced $NATIVE_MANIFEST_REL + $NATIVE_LOCK_REL to $TARGET (was $NATIVE_BEFORE)"
    NEEDS_COMMIT=true
  fi
fi

# Issue 0387: a rendered file's footer names the version of the BINARY that
# rendered it, so the stamp step renders with a CLI built at $TARGET rather than
# with the pre-release INTENT_BIN. It builds into the debug target the schema
# faces step above already compiled at $TARGET, so the build is incremental.
STAMP_BIN="$INTENT_BIN"
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would build the CLI at $TARGET (cargo build -p intent-cli) and render the stamp step with it"
else
  if ! (cd "$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")" && cargo build -p intent-cli --bin intent >/dev/null 2>&1); then
    abort "could not build the CLI at $TARGET for the stamp step -- run (cd native/rust && cargo build -p intent-cli) to see why"
  fi
  STAMP_BIN="$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")/target/debug/intent"
  case "$("$STAMP_BIN" --version 2>/dev/null)" in
    "intent $TARGET "*) log_info "stamp CLI built at $TARGET" ;;
    *) abort "the stamp CLI at $STAMP_BIN does not report $TARGET -- refusing to render a release's files with a different version" ;;
  esac
fi

# AGENTS.md regeneration
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent agents sync' to refresh AGENTS.md footer"
else
  # THE DIRTY-TREE CHECK BELOW CANNOT CATCH A FAILURE HERE, WHICH IS WHY THIS IS
  # CHECKED RATHER THAN TRUSTED. A failed regeneration leaves AGENTS.md
  # UNCHANGED, so the tree stays clean for it and the cut proceeds -- tagging a
  # release whose AGENTS.md still carries the previous version. That is the exact
  # internally-inconsistent tag this script's sidecar contract exists to prevent,
  # arriving through the one door the check does not face: the guard watches for
  # unexpected CHANGE and this failure produces unexpected SAMENESS.
  #
  # The status was discarded and the next line logged "AGENTS.md synced"
  # unconditionally, so the release log stated a success that had not happened.
  require_intent_bin
  if ! (cd "$PROJECT_ROOT" && "$STAMP_BIN" agents sync >/dev/null); then
    abort "intent agents sync failed -- refusing to tag a release whose AGENTS.md was not regenerated"
  fi
  log_info "AGENTS.md synced"
fi

# CLAUDE.md regeneration -- delegated to the canon engine that owns it, exactly
# as AGENTS.md is delegated to `intent agents sync`. The engine renders
# lib/templates/llm/_CLAUDE.md, preserves the user section and diffs, so the
# version + date restamp falls out of it. this handler renders no template itself:
# the substitution logic already has its homes and does not need another.
#
# THE CALL CARRIES `--apply` AND NOTHING ELSE. v3's `intent claude upgrade`
# takes `--apply`, `--daemon`, `--force` and `--skip-settings` (`intent claude
# upgrade --help`); this handler passes only `--apply`, so `.claude/settings.json`
# is re-provisioned along with everything else the engine owns.
#
# THE HAZARD IS MEASURED RATHER THAN REPEATED. `intent claude upgrade` without
# `--apply` reports what `--apply` writes here: `.claude/settings.json`,
# `.mcp.json` (seeded only when absent), `CLAUDE.md`, `AGENTS.md`, `usage-rules.md`, `.intent_critic.yml`, and the
# `pre-commit` and `pre-commit.intent` files in the hooks directory
# (`.githooks/`). All but `pre-commit.intent` are TRACKED, and only CLAUDE.md and
# AGENTS.md are in `SIDECAR_FILES`. If any other tracked one differs from canon
# when a release runs, the engine rewrites it, the tree is left dirty outside
# the sidecar list, and the cut aborts. `--skip-settings` would spare only
# `.claude/settings.json` and `.mcp.json`; the rest would still be rewritten.
#
# It aborted LATE, and that was the damaging part: the leftover check sits AFTER
# the commit block, so the version commit landed and then the release stopped --
# a half-cut tree with a release commit in it and no tag. The check below now
# runs HERE, before anything is committed, and names the cause instead of
# leaving a reader to work out why a tree they never touched is dirty.
#
# THE REAL FIX IS A NARROWER VERB and it is not this file's to make: the release
# needs CLAUDE.md's banner restamped and nothing else re-provisioned, and no
# `claude upgrade` flag scopes the write to that.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent claude upgrade --apply' to refresh CLAUDE.md"
  log_dry "would then refuse the cut if that rewrote anything outside the sidecar list"
else
  # Same reasoning as the AGENTS.md sync above: a failure here leaves CLAUDE.md
  # carrying the previous version, the tree stays clean, and the tag ships
  # inconsistent with itself.
  require_intent_bin
  if ! (cd "$PROJECT_ROOT" && "$STAMP_BIN" claude upgrade --apply >/dev/null); then
    abort "intent claude upgrade --apply failed -- refusing to tag a release whose CLAUDE.md was not refreshed"
  fi
  log_info "CLAUDE.md refreshed"

  # Anything the canon regeneration touched OUTSIDE the sidecar list. Computed by
  # EXCLUDING the sidecars from the status pathspec rather than by listing what
  # to look for: a hand-kept list of "files the engine might write" is a second
  # home for a fact the engine owns, and it would go stale the first time canon
  # gained a file.
  CANON_EXCLUDES=()
  for _sidecar in $SIDECAR_FILES; do CANON_EXCLUDES+=(":(exclude)$_sidecar"); done
  CANON_SPILL="$(cd "$PROJECT_ROOT" && git status --porcelain -- . "${CANON_EXCLUDES[@]}")"
  if [ -n "$CANON_SPILL" ]; then
    log_warn "the canon regeneration rewrote files outside the sidecar list:"
    printf '%s\n' "$CANON_SPILL" | sed 's/^/  /' >&2
    abort "refusing to cut: 'claude upgrade --apply' rewrote tracked files outside the sidecar list.
       \`--skip-settings\` would spare only .claude/settings.json and .mcp.json; the other files above would still be rewritten.
       Nothing has been committed, but the version IS stamped in the tree. Restore it and the files above with
         git -C '$PROJECT_ROOT' restore --source=HEAD --staged --worktree -- $SIDECAR_FILES
       then bring the files above into line with canon in their own commit and re-run --
       a release restamps a version, it does not re-provision a project."
  fi
fi

# Issue 0387: re-render every realised view with the stamp CLI and fold the
# footer-only changes into the release commit, as the schema faces are folded,
# so the tag does not ship views a version behind. A change that is NOT a footer
# is a tree out of step with its store, and the cut refuses rather than commit it
# under the release message.
VIEW_FILES=""
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent sync --to-disk' with the stamp CLI and fold footer-only view changes into the release commit"
else
  # ITS OUTPUT IS KEPT AND SHOWN ON FAILURE (issue 0469). It went to /dev/null,
  # so the abort named nothing, and in the 3.1.0 cut the real reason -- a
  # watching intentd, which sync refuses beside -- took a hand re-run to find.
  if ! stamp_sync_out="$(cd "$PROJECT_ROOT" && "$STAMP_BIN" sync --to-disk 2>&1)"; then
    abort "intent sync --to-disk failed -- refusing to tag a release whose views still name the previous version. Its output:
$stamp_sync_out"
  fi
  NOT_FOOTER=""
  while IFS= read -r _path; do
    [ -n "$_path" ] || continue
    case " $SIDECAR_FILES " in *" $_path "*) continue ;; esac
    _diff="$(cd "$PROJECT_ROOT" && git diff -U0 -- "$_path")" ||
      abort "git diff failed for $_path -- refusing to classify a view whose change could not be read"
    if printf '%s\n' "$_diff" | footer_only; then
      VIEW_FILES="$VIEW_FILES $_path"
    else
      NOT_FOOTER="$NOT_FOOTER  $_path
"
    fi
  done < <(cd "$PROJECT_ROOT" && git diff --name-only)
  if [ -n "$NOT_FOOTER" ]; then
    abort "refusing to cut: re-rendering the views at $TARGET changed more than their footers:
$NOT_FOOTER       Nothing has been committed, but the version IS stamped in the tree. Restore it with
         git -C '$PROJECT_ROOT' restore --source=HEAD --staged --worktree -- $SIDECAR_FILES
       bring the tree into line with its store (\`intent doctor\` names the skew), then re-run."
  fi
  if [ -n "$VIEW_FILES" ]; then
    log_info "views re-rendered at $TARGET fold into the release commit"
    NEEDS_COMMIT=true
  fi
fi

# Detect any change to a sidecar this script owns. Scoped to SIDECAR_FILES --
# the SAME list the commit stages. A bare `git status --porcelain` here used to
# set NEEDS_COMMIT from any dirty file at all, including ones the commit would
# never stage, so the script could announce a commit it had not made.
if [ "$DRY_RUN" != "true" ]; then
  # shellcheck disable=SC2086
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain -- $SIDECAR_FILES)" ]; then
    NEEDS_COMMIT=true
  fi
fi

# --------------------------------------------------------------------
# Commit (if any sidecar changed)
# --------------------------------------------------------------------
if [ "$NEEDS_COMMIT" = "true" ]; then
  log_step "commit"
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would commit ONLY $SIDECAR_FILES as 'release: v$TARGET' (--only: the ambient index is not swept)"
  else
    # `--only`, AND IT IS THE WHOLE POINT: this commits the named paths and
    # NOTHING ELSE, whatever the ambient index happens to hold.
    #
    # The previous form was `git add -- $SIDECAR_FILES` followed by a bare `git
    # commit`, and a bare commit commits THE INDEX AS IT STANDS. `preflight()`
    # demands a clean tree, so the index is empty when a run starts -- but
    # everything between that check and this line is minutes of wall clock:
    # doctor, the bats suite, the cargo gate, `agents sync` and the canon
    # regeneration. PEER NODES COMMIT INTO THIS CLONE. A peer staging work
    # inside that window would land it in the commit the TAG POINTS AT, under
    # the message `release: v<target>`, and nothing downstream would report it:
    # the leftover check below passes precisely because the peer's work was
    # committed rather than left dirty.
    #
    # The old "is there anything staged" test read `git diff --cached
    # --name-only`, which asks about the WHOLE index -- so under a peer's staged
    # work it answered yes even when no sidecar had changed. It is gone rather
    # than scoped: `NEEDS_COMMIT` above already computed that answer from
    # `git status --porcelain -- $SIDECAR_FILES`, and two tests for one question
    # is how they come to disagree.
    # THE FLAGS COME BEFORE THE `--`, AND THAT ORDER IS NOT COSMETIC: after the
    # separator every argument is a PATHSPEC, so `-- $SIDECAR_FILES -m "..."`
    # makes git look for files named `-m` and `release: v3.0.1` and fail. Caught
    # by driving the fix rather than by reading it -- the first form written here
    # was exactly that, and it would have broken the release it was fixing.
    # shellcheck disable=SC2086
    (cd "$PROJECT_ROOT" && git commit --only \
      -m "release: v$TARGET" -m "(C) hello@matthewsinclair.com" \
      -- $SIDECAR_FILES $VIEW_FILES) || abort "the release commit for v$TARGET was refused -- nothing is committed or tagged, the version is stamped in the tree and the schema faces are staged. First put the tree back with \`git -C '$PROJECT_ROOT' restore --source=HEAD --staged --worktree -- $SIDECAR_FILES $VIEW_FILES\`; then read the pre-commit gate's output above, fix what it refused and commit that fix on its own; then re-run"
    log_info "committed release: v$TARGET"
  fi
else
  log_info "no sidecar changes to commit"
fi

# Nothing outside the sidecar list may be left dirty. `intent claude upgrade
# --apply` can touch more than CLAUDE.md if the repo has drifted from canon, and
# a release must never tag a tree that still has uncommitted work in it -- the
# tag would not describe what was published. Fail loudly instead.
if [ "$DRY_RUN" != "true" ]; then
  LEFTOVER="$(cd "$PROJECT_ROOT" && git status --porcelain)"
  if [ -n "$LEFTOVER" ]; then
    log_warn "working tree is not clean after the sidecar sync:"
    printf '%s\n' "$LEFTOVER" | sed 's/^/  /' >&2
    # DELIBERATELY NO LONGER RECOMMENDS `--skip-tests` (dc, 2026-08-18). That
    # flag returns from preflight() before doctor, before the bats suite and
    # before the cargo gate above -- so the tool's own documented recovery path
    # from a dirty tree was "re-run with every correctness gate off", on exactly
    # the run that tags. The releaser following the instruction was the failure,
    # not the releaser being lazy.
    abort "refusing to tag a dirty tree -- commit or revert the above, then re-run"
  fi
fi

# --------------------------------------------------------------------
# Tag
# --------------------------------------------------------------------
log_step "tag"
TAG="v$TARGET"
TAG_EXISTS=false

if (cd "$PROJECT_ROOT" && git rev-parse "$TAG" >/dev/null 2>&1); then
  TAG_EXISTS=true
  TAG_SHA="$(cd "$PROJECT_ROOT" && git rev-parse "$TAG")"
  HEAD_SHA="$(cd "$PROJECT_ROOT" && git rev-parse HEAD)"
  if [ "$TAG_SHA" = "$HEAD_SHA" ]; then
    log_info "tag $TAG already at HEAD ($HEAD_SHA) -- reusing"
  else
    abort "tag $TAG exists at $TAG_SHA but HEAD is $HEAD_SHA -- refusing to force-move"
  fi
fi

if [ "$TAG_EXISTS" = "false" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would create tag $TAG at HEAD"
  else
    (cd "$PROJECT_ROOT" && git tag "$TAG") || abort "git tag $TAG failed -- the release commit is on local main, untagged and unpushed. Do not re-run this release: it cannot resume past its own commit, and a re-run would try to cut a further version on top of it. Finish by hand, in order: \`git -C '$PROJECT_ROOT' tag $TAG\`; \`git -C '$PROJECT_ROOT' push local main $TAG\`; \`git -C '$PROJECT_ROOT' push upstream main $TAG\`; write the notes with \`sed -n '/^## \[$TARGET\]/,/^## \[/p' '$PROJECT_ROOT/CHANGELOG.md' | sed '\$d' > /tmp/notes-$TAG.md\`; \`gh release create $TAG --title 'Intent v$TARGET' --notes-file /tmp/notes-$TAG.md\` (\`gh release edit\` with the same flags if $TAG already has a release)"
    log_info "created tag $TAG"
  fi
fi

# --------------------------------------------------------------------
# Push
# --------------------------------------------------------------------
log_step "push"

PUSH_PROMPT="push $TAG to local (Dropbox) and upstream (GitHub)?"
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would push main + $TAG to 'local' (Dropbox)"
  log_dry "would push main + $TAG to 'upstream' (GitHub)"
else
  if ! confirm "$PUSH_PROMPT"; then
    # NOT "re-run when ready" (issue 0467): the release commit and the tag exist,
    # VERSION already equals the target, and a re-run refuses -- or, with a bump
    # flag, cuts the next version on top. What is left is listed by hand, as the
    # post-commit failures above list it.
    log_warn "user aborted before push -- the release commit and tag $TAG exist locally and nothing is pushed. Do not re-run this release: it cannot resume past its own commit. Finish by hand, in order: \`git -C '$PROJECT_ROOT' push local main $TAG\`; \`git -C '$PROJECT_ROOT' push upstream main $TAG\`; write the notes with \`sed -n '/^## \[$TARGET\]/,/^## \[/p' '$PROJECT_ROOT/CHANGELOG.md' | sed '\$d' > /tmp/notes-$TAG.md\`; \`gh release create $TAG --title 'Intent v$TARGET' --notes-file /tmp/notes-$TAG.md\`"
    exit 2
  fi
  (cd "$PROJECT_ROOT" && git push local main "$TAG") || abort "push to local failed -- $TAG is at HEAD, and local may hold part of the push or none of it. Do not re-run this release: it cannot resume past its own commit, and a re-run would try to cut a further version on top of it. Finish by hand, in order: \`git -C '$PROJECT_ROOT' push local main $TAG\`; \`git -C '$PROJECT_ROOT' push upstream main $TAG\`; write the notes with \`sed -n '/^## \[$TARGET\]/,/^## \[/p' '$PROJECT_ROOT/CHANGELOG.md' | sed '\$d' > /tmp/notes-$TAG.md\`; \`gh release create $TAG --title 'Intent v$TARGET' --notes-file /tmp/notes-$TAG.md\` (\`gh release edit\` with the same flags if $TAG already has a release)"
  log_info "pushed to local"
  (cd "$PROJECT_ROOT" && git push upstream main "$TAG") || abort "push to upstream failed -- main and $TAG are on local, and upstream may hold part of the push or none of it. Do not re-run this release: it cannot resume past its own commit, and a re-run would try to cut a further version on top of it. Finish by hand, in order: \`git -C '$PROJECT_ROOT' push upstream main $TAG\`; write the notes with \`sed -n '/^## \[$TARGET\]/,/^## \[/p' '$PROJECT_ROOT/CHANGELOG.md' | sed '\$d' > /tmp/notes-$TAG.md\`; \`gh release create $TAG --title 'Intent v$TARGET' --notes-file /tmp/notes-$TAG.md\` (\`gh release edit\` with the same flags if $TAG already has a release). Do not create the GitHub release before upstream has $TAG: gh would create $TAG on GitHub at the wrong commit"
  log_info "pushed to upstream"
fi

# --------------------------------------------------------------------
# GitHub release
# --------------------------------------------------------------------
log_step "github release"

NOTES_FILE="$(mktemp -t intent-release-notes.XXXXXX)"
# Re-extract after sidecar rewrite so the notes match what's on disk now.
extract_changelog_section "$TARGET" > "$NOTES_FILE"

GH_TITLE="Intent v$TARGET"

RELEASE_EXISTS=false
if gh release view "$TAG" >/dev/null 2>&1; then
  RELEASE_EXISTS=true
fi

if [ "$DRY_RUN" = "true" ]; then
  log_dry "would publish GitHub release $TAG with title '$GH_TITLE'"
  log_dry "release notes preview:"
  # **THE WHOLE SECTION, AND THE BOUND THAT WAS HERE IS THE REASON** (vc,
  # 2026-09-12, on dc's rehearsal finding). This was `| head -30` over a section
  # that had grown to 59 lines, so `### Fixed` and `### Removed` never reached
  # the screen and NOTHING SAID THEY HAD BEEN CUT. What publishes was always
  # whole -- `gh` is handed `$NOTES_FILE`, not this rendering -- but the preview's
  # only job is to let the operator read what the cut will publish before it
  # does, and it was showing them half of it while looking complete.
  #
  # **A TRUNCATION THAT DOES NOT ANNOUNCE ITSELF IS A SILENT NARROWING, AND THE
  # READER CONCLUDES ABSENCE RATHER THAN OMISSION.** Same shape as the two test
  # gates above, which refused on an exit code and named nothing until the
  # rehearsal that found this one; a bound that announces itself would be second
  # best, and for a screen of release notes there is no reason to bound it at
  # all.
  sed 's/^/  | /' "$NOTES_FILE"
  rm -f "$NOTES_FILE"
else
  if [ "$RELEASE_EXISTS" = "true" ]; then
    log_info "release $TAG already exists -- updating notes"
    gh release edit "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE" || abort "gh release edit $TAG failed -- $TAG is pushed to local and upstream, and the GitHub release was not updated (gh's error is above). Do not re-run this release: it cannot resume past its own commit, and a re-run would try to cut a further version on top of it. Finish by hand: \`gh release edit $TAG --title '$GH_TITLE' --notes-file $NOTES_FILE\`"
  else
    gh release create "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE" || abort "gh release create $TAG failed -- $TAG is pushed to local and upstream, and the GitHub release was not created (gh's error is above). Do not re-run this release: it cannot resume past its own commit, and a re-run would try to cut a further version on top of it. Finish by hand: \`gh release create $TAG --title '$GH_TITLE' --notes-file $NOTES_FILE\` (\`gh release edit\` with the same flags if $TAG turns out to have a release already)"
  fi
  log_info "release published"
  rm -f "$NOTES_FILE"
fi

# --------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------
log_step "summary"
if [ "$DRY_RUN" = "true" ]; then
  log_info "dry-run complete -- no side effects"
  log_info "to execute: re-run without --dry-run"
else
  log_info "Intent $TAG cut and published"
  log_info "  local:    pushed main + $TAG to ~/Dropbox/Repositories/Devel/Intent"
  log_info "  upstream: $(gh release view "$TAG" --json url -q .url 2>/dev/null || echo "(check gh release view $TAG)")"
fi
exit 0
