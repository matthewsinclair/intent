#!/usr/bin/env bash
#
# devbin: summary = Cut, tag and publish an Intent release
#
# intent build release -- Intent release orchestrator
#
# Cuts an Intent release in one invocation: pre-flight checks, version bump,
# CHANGELOG date finalisation, sidecar sync (VERSION, config.json intent_version,
# AGENTS.md, CLAUDE.md, and for a 3.x target the native workspace version),
# commit, tag, push to both remotes, and GitHub release publication. Every
# sidecar is stamped BEFORE the commit, so the tag describes a self-consistent
# tree -- there is no post-tag wrap to remember.
#
# Modelled on ../Conflab/scripts/release. Pared back to Intent's surface:
# single repo, two remotes (local Dropbox + upstream GitHub).
#
# THIS COMMAND OWNS THE TAG AND THE RELEASE OBJECT, AND NOTHING ELSE (D43). It
# does not build, sign, notarise or upload a native binary, and it does not
# touch the Homebrew tap: `int macos prepare` owns the artefacts and
# `int macos publish` owns the assets on the object this creates. No command
# owns two of the three. What it DOES own for v3 is the version those artefacts
# will report -- `native/rust/Cargo.toml` carries `[workspace.package] version`
# and the binary compiles its own version string from it, so a tag cut without
# stamping it publishes a binary that disagrees with its own tag.
#
# WRITING THE CHANGELOG SECTION
#
# Author the heading as `## [X.Y.Z] - in progress`, NOT with a hand-typed date.
# This script stamps the real date at cut time. A hand-dated heading is correct
# only on the day it was typed: it goes stale at midnight and aborts the
# pre-flight date gate, which is exactly what happened to v2.17.4. `in progress`
# makes the date correct by construction.
#
# Usage:
#   intent build release --patch | --minor | --major | vX.Y.Z [flags]
#
# Flags:
#   --dry-run            Compute and print every step; exit without side effects.
#   --no-confirm         Skip interactive confirmation before pushes / releases.
#   --skip-tests         Skip the pre-flight test/doctor gates (re-run mode).
#   --allow-stale-date   Accept a CHANGELOG date that is not today.
#   --help               Print this help and exit.
#
# Examples:
#   intent build release --dry-run --patch
#   intent build release --minor
#   intent build release v2.10.1
#
# Exit codes:
#   0  success (or dry-run completed)
#   1  pre-flight or validation failure
#   2  user aborted at confirmation prompt

set -u

# --------------------------------------------------------------------
# Locate project root + source helpers
# --------------------------------------------------------------------
# PROJECT_ROOT comes from the devbin dispatcher, which resolves it
# symlink-safe from the launcher's real location. It is NOT derived from this
# file's own path any more: as bin/release that was `$SCRIPT_DIR/..`, and this
# handler now sits four levels down at bin/.devbin/cmd/build.d/, where the same
# expression would resolve to bin/.devbin/cmd. Taking it from the dispatcher is
# both correct here and immune to the handler moving again.
: "${DEVBIN_LIB:?run me through the devbin dispatcher -- 'intent build release'}"
: "${PROJECT_ROOT:?the devbin dispatcher did not export PROJECT_ROOT}"
HELPERS="$PROJECT_ROOT/bin/intent_helpers"

# Pin INTENT_HOME to the checkout being released. bin/intent only derives it when
# it is unset, so an INTENT_HOME exported in the maintainer's shell -- pointing at
# whichever Intent they normally work in -- silently wins, and every sub-command
# reads THAT tree's VERSION. Releasing any checkout other than the habitual one
# would then stamp the wrong version into AGENTS.md and CLAUDE.md while VERSION
# and config.json carried the right one. Caught by cutting a test release from a
# clone; the release must describe the tree it is cutting, not the ambient one.
export INTENT_HOME="$PROJECT_ROOT"

if [ -f "$HELPERS" ]; then
  # shellcheck disable=SC1090
  source "$HELPERS"
else
  echo "error: cannot locate $HELPERS" >&2
  exit 1
fi

# --------------------------------------------------------------------
# Logging helpers (consistent with Intent CLI tone: lowercase prefixes)
# --------------------------------------------------------------------
log_info() { printf 'info: %s\n' "$*"; }
log_step() { printf '\n==> %s\n' "$*"; }
log_dry()  { printf 'dry-run: %s\n' "$*"; }
log_warn() { printf 'warning: %s\n' "$*" >&2; }

abort() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

confirm() {
  local prompt="$1"
  if [ "${NO_CONFIRM:-false}" = "true" ]; then
    log_info "$prompt -- (auto-confirmed via --no-confirm)"
    return 0
  fi
  # Read the confirmation from the controlling terminal, not stdin, so the
  # prompt still works when stdin/stdout are piped or redirected (eg a tee'd
  # release run, or a wrapper feeding the script on stdin). No terminal and no
  # --no-confirm -> abort; never proceed on an unread/EOF reply.
  if [ ! -r /dev/tty ]; then
    log_warn "$prompt -- no terminal to read confirmation; re-run with --no-confirm to proceed non-interactively"
    return 1
  fi
  printf '%s [y/N] ' "$prompt" > /dev/tty
  local reply=""
  IFS= read -r reply < /dev/tty
  # Tolerate stray input: a trailing CR (CRLF terminals) or surrounding
  # whitespace must not turn a clear "y" into a false abort of the push.
  reply="${reply//[$'\t\r\n ']/}"
  case "$reply" in
    [yY]|[yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

# --------------------------------------------------------------------
# Argument parsing
# --------------------------------------------------------------------
TARGET=""
BUMP=""
DRY_RUN=false
NO_CONFIRM=false
SKIP_TESTS=false
ALLOW_STALE_DATE=false

usage() {
  # ANCHORED ON STRUCTURE, NOT ON LINE NUMBERS. This was a hardcoded `5,34p`
  # window over the header above, and the header grew past it: --help printed
  # the title, the prose, and the word "Usage:", then stopped -- exit 0, not one
  # flag, not one example, not one exit code. A help text that confidently lists
  # no options is worse than none, and it fails on the one morning it is read.
  #
  # Its own comment had predicted the drift ("it will move again if the header
  # does") and wrote the prediction down instead of removing the coupling. A
  # note cannot notice; a rule that reads the block's real boundaries cannot
  # forget. The block is every comment line from the top to the first line that
  # is not one, less the shebang and the dispatcher directive, which are
  # machinery rather than help.
  awk '
    NR == 1 && /^#!/ { next }
    /^# devbin:/     { next }
    !/^#/            { exit }
                     { print }
  ' "${BASH_SOURCE[0]}" |
    sed -e 's/^# //' -e 's/^#$//' -e '/./,$!d'
  exit "${1:-0}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --patch|--minor|--major)
      [ -n "$BUMP" ] && abort "duplicate bump flag: $1"
      [ -n "$TARGET" ] && abort "cannot mix bump flag with explicit version"
      BUMP="${1#--}"
      ;;
    v[0-9]*.[0-9]*.[0-9]*)
      [ -n "$TARGET" ] && abort "duplicate target: $1"
      [ -n "$BUMP" ] && abort "cannot mix bump flag with explicit version"
      TARGET="${1#v}"
      ;;
    --dry-run)         DRY_RUN=true ;;
    --no-confirm)      NO_CONFIRM=true ;;
    --skip-tests)      SKIP_TESTS=true ;;
    --allow-stale-date) ALLOW_STALE_DATE=true ;;
    --help|-h)         usage 0 ;;
    *) abort "unknown argument: $1 (use --help for usage)" ;;
  esac
  shift
done

[ -z "$BUMP" ] && [ -z "$TARGET" ] && {
  printf 'error: must specify --patch, --minor, --major, or vX.Y.Z\n\n' >&2
  usage 1
}

# --------------------------------------------------------------------
# Helpers: semver compare, CHANGELOG slicing
# --------------------------------------------------------------------

semver_parts() {
  # Echo "MAJOR MINOR PATCH" or fail if input is not semver.
  local v="$1"
  if ! [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    abort "not a valid semver: $v"
  fi
  printf '%s %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

semver_bump() {
  # semver_bump CURRENT BUMP_KIND -> echoes target version
  local current="$1" kind="$2"
  read -r maj min pat <<<"$(semver_parts "$current")"
  case "$kind" in
    major) maj=$((maj+1)); min=0; pat=0 ;;
    minor) min=$((min+1)); pat=0 ;;
    patch) pat=$((pat+1)) ;;
    *) abort "internal: unknown bump kind: $kind" ;;
  esac
  printf '%d.%d.%d\n' "$maj" "$min" "$pat"
}

semver_gt() {
  # Return 0 if A > B, 1 otherwise.
  local a="$1" b="$2"
  read -r am an ap <<<"$(semver_parts "$a")"
  read -r bm bn bp <<<"$(semver_parts "$b")"
  if [ "$am" -ne "$bm" ]; then [ "$am" -gt "$bm" ]; return $?; fi
  if [ "$an" -ne "$bn" ]; then [ "$an" -gt "$bn" ]; return $?; fi
  [ "$ap" -gt "$bp" ]
}

# --------------------------------------------------------------------
# Cargo.lock introspection, for the native lock check further down.
# --------------------------------------------------------------------
#
# `lock_packages` emits one `name<TAB>version` per `[[package]]`. `lock_members`
# emits the workspace members, which are exactly the packages carrying no
# `source` line -- a path package has none, a registry one always does.
#
# The member list is DERIVED from the lockfile being checked rather than from
# `cargo metadata`, for two reasons. It needs no `jq` and no second cargo
# invocation, and -- the one that matters -- there is no separate list to keep
# in step: a crate newly added to the workspace counts as a member here the
# moment it is one there. A hardcoded roster would have silently reclassified
# the next crate as a dependency, which is the direction that fails quietly.

lock_packages() {
  awk '
    /^\[\[package\]\]/ { name=""; version=""; next }
    /^name = "/        { name=$0;    sub(/^name = "/,"",name);       sub(/"$/,"",name);       next }
    /^version = "/     { version=$0; sub(/^version = "/,"",version); sub(/"$/,"",version);
                         if (name != "") print name "\t" version; next }
  ' "$1" | sort
}

lock_members() {
  awk '
    /^\[\[package\]\]/ { if (name != "" && !src) print name; name=""; src=0; next }
    /^name = "/        { name=$0; sub(/^name = "/,"",name); sub(/"$/,"",name); next }
    /^source = /       { src=1; next }
    END                { if (name != "" && !src) print name }
  ' "$1" | sort
}

lock_nonmember_changes() {
  # lock_nonmember_changes BEFORE AFTER -> names of changed non-member packages.
  #
  # Empty output means every package whose name/version pair changed is a
  # workspace member of AFTER, which is the only condition under which a release
  # may fold a refreshed lockfile into its commit.
  #
  # Returns non-zero WITHOUT emitting names when either extraction comes back
  # empty. An empty parse yields an empty difference, so it would otherwise
  # report "nothing changed" and accept anything -- the caller must be able to
  # tell "no offenders" from "could not look".
  #
  # This lives in a function rather than inline at the call site because the
  # comparison is pure over two files, so it can be tested for what it actually
  # decides. Inline it could only be grepped, and a grep cannot tell whether the
  # thing it matched is correct -- which is how the defect below survived.
  local before="$1" after="$2"
  local pkgs_before pkgs_after members
  pkgs_before="$(mktemp)"; pkgs_after="$(mktemp)"; members="$(mktemp)"

  lock_packages "$before" > "$pkgs_before"
  lock_packages "$after"  > "$pkgs_after"
  lock_members  "$after"  > "$members"

  if [ ! -s "$pkgs_after" ] || [ ! -s "$members" ]; then
    rm -f "$pkgs_before" "$pkgs_after" "$members"
    return 1
  fi

  comm -3 "$pkgs_before" "$pkgs_after" | sed 's/^\t//' | cut -f1 | sort -u |
    comm -23 - "$members"
  rm -f "$pkgs_before" "$pkgs_after" "$members"
  return 0
}

extract_changelog_section() {
  # extract_changelog_section VERSION -> writes the section to stdout.
  # Section runs from "## [VERSION]" up to (but not including) the next "## [".
  local version="$1"
  awk -v ver="$version" '
    BEGIN { in_section = 0 }
    /^## \[/ {
      if (in_section) { exit }
      if ($0 ~ "^## \\["ver"\\]") { in_section = 1; print; next }
    }
    in_section { print }
  ' "$PROJECT_ROOT/CHANGELOG.md"
}

# --------------------------------------------------------------------
# Pre-flight gates
# --------------------------------------------------------------------

preflight() {
  log_step "pre-flight"

  # Working tree clean.
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain)" ]; then
    abort "working tree is not clean -- commit or stash first"
  fi
  log_info "working tree clean"

  # On main branch.
  local branch
  branch="$(cd "$PROJECT_ROOT" && git rev-parse --abbrev-ref HEAD)"
  if [ "$branch" != "main" ]; then
    abort "must be on main branch (currently: $branch)"
  fi
  log_info "on main branch"

  # Both remotes resolve.
  if ! (cd "$PROJECT_ROOT" && git remote get-url local >/dev/null 2>&1); then
    abort "git remote 'local' is not configured"
  fi
  if ! (cd "$PROJECT_ROOT" && git remote get-url upstream >/dev/null 2>&1); then
    abort "git remote 'upstream' is not configured"
  fi
  log_info "both remotes (local, upstream) configured"

  # A FROZEN REMOTE IS A PRE-FLIGHT FAILURE, NOT A PUSH FAILURE.
  #
  # This script pushes `local` AND `upstream`, and the pre-push gate refuses a
  # remote the hypervisor has closed. Discovering that at the push step means the
  # commit is made, the sidecars are stamped and THE TAG IS ALREADY CUT -- a
  # release that is half-published, with a tag on one remote, no GitHub release,
  # and a confusing refusal from a gate the operator was not thinking about.
  #
  # Each step is correct and the composition is not, which is this thread's
  # recurring shape. The fix is to ask the question at the only moment the answer
  # is still cheap.
  #
  # The list comes from `int prepush --list-frozen` rather than being restated
  # here: the runner that enforces the rule is the authority on what the rule is.
  frozen_hit=""
  if [ -x "$PROJECT_ROOT/bin/int" ]; then
    for frozen in $("$PROJECT_ROOT/bin/int" prepush --list-frozen 2>/dev/null || true); do
      case "$frozen" in
        local | upstream) frozen_hit="$frozen" ;;
      esac
    done
  fi
  if [ -n "$frozen_hit" ]; then
    abort "remote '$frozen_hit' is FROZEN, and this release would push to it.

  A release cannot complete while a remote it publishes to is closed, and
  finding that out at the push step leaves the tag already cut.

  If the hypervisor has lifted the freeze, remove '$frozen_hit' from
  FROZEN_REMOTES in bin/.devbin/cmd/prepush and commit that first."
  fi
  log_info "no frozen remote in the push set"

  if [ "$SKIP_TESTS" = "true" ]; then
    log_warn "--skip-tests: skipping doctor + test suite"
    return 0
  fi

  # intent doctor.
  log_info "running intent doctor"
  if ! (cd "$PROJECT_ROOT" && "$PROJECT_ROOT/bin/intent" doctor >/dev/null 2>&1); then
    abort "intent doctor reported issues -- fix before releasing"
  fi
  log_info "intent doctor clean"

  # Test suite.
  log_info "running test suite (this may take a minute)"
  if ! (cd "$PROJECT_ROOT" && tests/run_tests.sh >/dev/null 2>&1); then
    abort "test suite failed -- fix before releasing"
  fi
  log_info "test suite green"

  # Rust workspace. THE BATS SUITE ABOVE NEVER COMPILES THE NATIVE TREE -- the
  # only other `cargo` in this whole file is `cargo metadata` for the lock
  # refresh -- so until this landed, a Rust product was gated on a shell test
  # suite. CI runs `cargo test --workspace` (.github/workflows/rust.yml) and the
  # release did not, which is the wrong way round: CI reports, the release
  # DECIDES.
  #
  # GUARDED ON THE MANIFEST EXISTING, NOT ON STAMP_NATIVE, and the difference is
  # not stylistic. STAMP_NATIVE is not assigned until the sidecar-sync section,
  # which runs AFTER this function -- so reading it here would test an empty
  # string and skip in silence on every release. That is the exact shape of gate
  # this change exists to remove, and it would have shipped inside the fix for
  # it.
  if [ -f "$PROJECT_ROOT/$NATIVE_MANIFEST_REL" ]; then
    if ! command -v cargo >/dev/null 2>&1; then
      abort "cargo not found in PATH and $NATIVE_MANIFEST_REL is present -- refusing to release a native tree this machine cannot test"
    fi
    log_info "running cargo test --workspace (this may take several minutes)"
    if ! (cd "$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")" && cargo test --workspace >/dev/null 2>&1); then
      abort "cargo test --workspace failed -- fix before releasing (re-run it directly to see which test)"
    fi
    log_info "cargo test green"
  fi

  # gh auth (we'll need it later).
  if ! command -v gh >/dev/null 2>&1; then
    abort "gh CLI not found in PATH"
  fi
  if ! gh auth status >/dev/null 2>&1; then
    abort "gh CLI is not authenticated (run: gh auth login)"
  fi
  log_info "gh CLI authenticated"
}

# --------------------------------------------------------------------
# Main flow
# --------------------------------------------------------------------

CURRENT="$(cat "$PROJECT_ROOT/VERSION" 2>/dev/null || echo "0.0.0")"
log_info "current version: $CURRENT"

if [ -n "$BUMP" ]; then
  TARGET="$(semver_bump "$CURRENT" "$BUMP")"
fi

# Validate target shape and ordering.
semver_parts "$TARGET" >/dev/null
if ! semver_gt "$TARGET" "$CURRENT"; then
  abort "target $TARGET is not greater than current $CURRENT"
fi
log_info "target version: $TARGET"

# CHANGELOG must have a section for the target.
CHANGELOG_SECTION="$(extract_changelog_section "$TARGET")"
if [ -z "$CHANGELOG_SECTION" ]; then
  abort "no '## [$TARGET]' section in CHANGELOG.md -- write release notes first"
fi
log_info "CHANGELOG section present for $TARGET"

# Validate CHANGELOG date.
TODAY="$(date +%Y-%m-%d)"
HEADER_LINE="$(printf '%s\n' "$CHANGELOG_SECTION" | head -1)"
case "$HEADER_LINE" in
  "## [$TARGET] - in progress"*)
    NEEDS_DATE_REWRITE=true
    log_info "CHANGELOG header still 'in progress' -- will rewrite to $TODAY"
    ;;
  "## [$TARGET] - $TODAY"*)
    NEEDS_DATE_REWRITE=false
    log_info "CHANGELOG date is today ($TODAY)"
    ;;
  "## [$TARGET] - "*)
    if [ "$ALLOW_STALE_DATE" = "true" ]; then
      NEEDS_DATE_REWRITE=false
      log_warn "CHANGELOG date is not today, but --allow-stale-date is set"
    else
      abort "CHANGELOG header is '$HEADER_LINE' but today is $TODAY (re-run with --allow-stale-date to accept)"
    fi
    ;;
  *)
    abort "unrecognised CHANGELOG header for $TARGET: '$HEADER_LINE'"
    ;;
esac

# --------------------------------------------------------------------
# Native workspace location
# --------------------------------------------------------------------
# Defined HERE, above preflight's CALL, and not beside STAMP_NATIVE in the
# sidecar section below -- because preflight needs them and the sidecar section
# runs after it. A second copy inside preflight() would be two homes for one
# pair of paths; this is one definition hoisted above its first reader.
NATIVE_MANIFEST_REL="native/rust/Cargo.toml"
NATIVE_LOCK_REL="native/rust/Cargo.lock"

# --------------------------------------------------------------------
# Pre-flight (after we know the target so error messages can reference it)
# --------------------------------------------------------------------
preflight

# --------------------------------------------------------------------
# Sidecar sync
# --------------------------------------------------------------------
log_step "sidecar sync"

# The sidecars this script owns end to end: it writes them, stages them, and
# refuses to tag if anything else is left dirty. ONE list, read by the detect
# step and the commit step alike, so the two cannot disagree about what a
# release commit contains.
CONFIG_REL="intent/.config/config.json"
SIDECAR_FILES="VERSION CHANGELOG.md AGENTS.md CLAUDE.md $CONFIG_REL"

# THE NATIVE WORKSPACE IS A SIDECAR ONLY FOR A 3.x RELEASE, and the condition is
# the whole design rather than a special case.
#
# `native/rust/Cargo.toml` carries `[workspace.package] version`, every crate
# inherits it with `version.workspace = true`, and the binary compiles its own
# version string from `env!("CARGO_PKG_VERSION")`. So the workspace version IS
# the v3 product's version. A 2.x release must never touch it -- v2 is the shell
# CLI and stamping `2.19.1` into the Rust workspace would make the next v3 build
# announce itself as a v2 -- and a 3.x release must always touch it, or the tag
# says `v3.0.0` while `intent --version` says whatever the tree happened to hold.
# Measured: the workspace sits at `3.0.0-dev`, so without this the first v3 tag
# would publish a binary calling itself a dev build.
#
# The condition retires itself. Once 2.x stops being cut there is no other arm,
# and this collapses to an unconditional sidecar.
STAMP_NATIVE=false
case "$TARGET" in
  [3-9].* | [1-9][0-9]*.*) [ -f "$PROJECT_ROOT/$NATIVE_MANIFEST_REL" ] && STAMP_NATIVE=true ;;
esac
if [ "$STAMP_NATIVE" = "true" ]; then
  SIDECAR_FILES="$SIDECAR_FILES $NATIVE_MANIFEST_REL $NATIVE_LOCK_REL"
fi

NEEDS_COMMIT=false

# /VERSION
if [ "$CURRENT" != "$TARGET" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would write '$TARGET' to $PROJECT_ROOT/VERSION"
  else
    printf '%s\n' "$TARGET" > "$PROJECT_ROOT/VERSION"
    log_info "wrote $TARGET to VERSION"
  fi
  NEEDS_COMMIT=true
else
  log_info "VERSION already at $TARGET"
fi

# CHANGELOG date finalisation
if [ "$NEEDS_DATE_REWRITE" = "true" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would rewrite '## [$TARGET] - in progress' to '## [$TARGET] - $TODAY' in CHANGELOG.md"
  else
    # Keep any trailing parenthesised note that follows " - in progress"
    # (e.g. " - in progress (ST0035 + ST0036)" -> " - $TODAY (ST0035 + ST0036)").
    sed -i.bak -E "s|^(## \[$TARGET\]) - in progress(.*)$|\1 - $TODAY\2|" "$PROJECT_ROOT/CHANGELOG.md"
    rm -f "$PROJECT_ROOT/CHANGELOG.md.bak"
    log_info "CHANGELOG date finalised to $TODAY"
  fi
  NEEDS_COMMIT=true
fi

# intent/.config/config.json -- Intent's own dogfooding stamp.
# Must happen HERE, before the commit, so the tag contains it. It used to be a
# manual wrap commit landing after the tag, which meant every published tag had
# VERSION and intent_version disagreeing.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would stamp intent_version = $TARGET in $CONFIG_REL"
else
  (cd "$PROJECT_ROOT" && stamp_project_version "$TARGET" "$CONFIG_REL")
  case $? in
    0) log_info "stamped intent_version = $TARGET in $CONFIG_REL"; NEEDS_COMMIT=true ;;
    1) log_info "$CONFIG_REL already at $TARGET" ;;
    *) abort "cannot stamp intent_version in $CONFIG_REL" ;;
  esac
fi

# native/rust -- the workspace version, and the lockfile that must move with it.
#
# THE LOCK IS NOT OPTIONAL. `Cargo.lock` records each workspace member's version,
# so stamping the manifest alone leaves the two disagreeing and **every
# `--locked` build fails** -- which is the build a release should be using.
# Measured on a clean HEAD checkout: manifest-only is REFUSED with `cannot update
# the lock file ... because --locked was passed`.
#
# CARGO WRITES THE LOCK; THIS SCRIPT DOES NOT REIMPLEMENT IT. The obvious version
# rewrote the member entries by hand, and it was wrong the first time it ran: it
# stamped three members and MISSED `intentd`, which is the second shipped binary.
# A hand-kept list of crates is the needle that skips the names nobody has
# invented yet, and this workspace will gain crates. Cargo knows the members;
# asking it cannot go stale.
#
# BUT CARGO IS ALLOWED TO DO MORE THAN WE ASKED, so the diff is BOUNDED and a
# surprise is a refusal rather than a silent dependency bump inside a release
# commit. Measured on the same checkout: the update touches exactly the four
# workspace member version lines and no dependency at all. If it ever touches
# anything else, the release stops -- **the one moment a resolver change must not
# ride along unnoticed is the commit the tag points at.**
if [ "$STAMP_NATIVE" = "true" ]; then
  native_current="$(sed -n 's/^version = "\(.*\)"$/\1/p' "$PROJECT_ROOT/$NATIVE_MANIFEST_REL" | head -1)"
  if [ "$native_current" = "$TARGET" ]; then
    log_info "$NATIVE_MANIFEST_REL already at $TARGET"
  elif [ "$DRY_RUN" = "true" ]; then
    log_dry "would stamp [workspace.package] version = $TARGET in $NATIVE_MANIFEST_REL (from $native_current)"
    log_dry "would refresh $NATIVE_LOCK_REL via cargo, refusing any change beyond workspace member versions"
  else
    lock_before="$(mktemp)"
    cp "$PROJECT_ROOT/$NATIVE_LOCK_REL" "$lock_before"
    sed -i.bak "s|^version = \"$native_current\"$|version = \"$TARGET\"|" "$PROJECT_ROOT/$NATIVE_MANIFEST_REL"
    rm -f "$PROJECT_ROOT/$NATIVE_MANIFEST_REL.bak"

    # No --locked: the point is to let cargo rewrite the lock. Not --offline
    # either: the lock legitimately names targets this machine never builds
    # (windows, wasm), and --offline fails on those with an error that reads
    # exactly like an inconsistent lockfile. Measured, and it cost a wrong
    # diagnosis before it was.
    if ! (cd "$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")" && cargo metadata --format-version 1 >/dev/null 2>&1); then
      cp "$lock_before" "$PROJECT_ROOT/$NATIVE_LOCK_REL"
      rm -f "$lock_before"
      abort "cargo could not refresh $NATIVE_LOCK_REL after the version stamp"
    fi

    # WHAT MUST BE TRUE: only WORKSPACE MEMBER versions changed.
    #
    # That is not the same claim as "every changed line is a version line",
    # which is what this check tested until 2026-08-16 -- and the two differ
    # exactly where it matters. A dependency bump is a lone `version = "..."`
    # line, identical in shape to a member's, so the old form ACCEPTED the
    # single most likely resolver change while its own comment said it refused
    # one. Canaried and measured: a lone `serde` bump sailed straight through.
    # The comment and the code agreed with each other and both were wrong about
    # the invariant, which is why reading them together proved nothing.
    #
    # Correlating each changed version with the package NAME it sits under is
    # the whole fix, and it lets the refusal name the offending crate instead of
    # printing diff lines a reader has to interpret.
    # A non-zero return is "could not look", never "nothing changed": an
    # extractor that silently returns nothing makes the comparison report no
    # changes, so the check would ACCEPT ANYTHING and say so confidently. An
    # empty parse is a broken parse, never a clean lockfile.
    if ! unexpected="$(lock_nonmember_changes "$lock_before" "$PROJECT_ROOT/$NATIVE_LOCK_REL")"; then
      cp "$lock_before" "$PROJECT_ROOT/$NATIVE_LOCK_REL"
      rm -f "$lock_before"
      abort "could not read packages or workspace members out of $NATIVE_LOCK_REL -- refusing to check nothing and call it clean"
    fi

    rm -f "$lock_before"
    if [ -n "$unexpected" ]; then
      abort "refreshing $NATIVE_LOCK_REL changed packages that are NOT workspace members -- refusing to fold a dependency change into a release commit:
$(printf '%s\n' "$unexpected" | sed 's/^/  /')"
    fi

    log_info "stamped $NATIVE_MANIFEST_REL + $NATIVE_LOCK_REL to $TARGET (was $native_current)"
    NEEDS_COMMIT=true
  fi
else
  # Named, not silent. A 2.x cut leaving the native workspace alone is correct
  # and is worth one line, because the alternative reading -- that the script
  # forgot -- is the one a reader reaches for when v3 exists in the tree.
  [ -f "$PROJECT_ROOT/$NATIVE_MANIFEST_REL" ] &&
    log_info "$NATIVE_MANIFEST_REL untouched: $TARGET is not a 3.x release"
fi

# AGENTS.md regeneration
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent agents sync' to refresh AGENTS.md footer"
else
  # THE DIRTY-TREE CHECK BELOW CANNOT CATCH A FAILURE HERE, WHICH IS WHY THIS IS
  # CHECKED RATHER THAN TRUSTED. A failed regeneration leaves AGENTS.md
  # UNCHANGED, so the tree stays clean for it and the cut proceeds -- tagging a
  # release whose AGENTS.md still carries the previous version. That is the exact
  # internally-inconsistent tag this script's sidecar contract exists to prevent,
  # arriving through the one door the check does not face: the guard watches for
  # unexpected CHANGE and this failure produces unexpected SAMENESS.
  #
  # The status was discarded and the next line logged "AGENTS.md synced"
  # unconditionally, so the release log stated a success that had not happened.
  if ! (cd "$PROJECT_ROOT" && "$PROJECT_ROOT/bin/intent" agents sync >/dev/null); then
    abort "intent agents sync failed -- refusing to tag a release whose AGENTS.md was not regenerated"
  fi
  log_info "AGENTS.md synced"
fi

# CLAUDE.md regeneration -- delegated to the canon engine that owns it, exactly
# as AGENTS.md is delegated to `intent agents sync`. The engine renders
# lib/templates/llm/_CLAUDE.md, preserves the user section and diffs, so the
# version + date restamp falls out of it. this handler renders no template itself:
# the substitution logic already has three homes and does not need a fourth.
#
# --skip-settings keeps the blast radius to the documents. Without it the engine
# also rewrites .claude/settings.json and the three hook scripts -- unrelated to
# the release, outside the sidecar list, and enough to trip the dirty-tree check
# below and abort the cut. A release refreshes the version stamp; it is not the
# place to re-provision the .claude/ stack.
#
# Those files no longer differ between checkouts (issue 0016 removed the last
# install-time path substitution), so this is now about scope rather than
# inevitability: skipping them keeps the release diff to what a release means.
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would run 'intent claude upgrade --apply --skip-settings' to refresh CLAUDE.md"
else
  # Same reasoning as the AGENTS.md sync above: a failure here leaves CLAUDE.md
  # carrying the previous version, the tree stays clean, and the tag ships
  # inconsistent with itself.
  if ! (cd "$PROJECT_ROOT" && "$PROJECT_ROOT/bin/intent" claude upgrade --apply --skip-settings >/dev/null); then
    abort "intent claude upgrade --apply failed -- refusing to tag a release whose CLAUDE.md was not refreshed"
  fi
  log_info "CLAUDE.md refreshed"
fi

# Detect any change to a sidecar this script owns. Scoped to SIDECAR_FILES --
# the SAME list the commit stages. A bare `git status --porcelain` here used to
# set NEEDS_COMMIT from any dirty file at all, including ones the commit would
# never stage, so the script could announce a commit it had not made.
if [ "$DRY_RUN" != "true" ]; then
  # shellcheck disable=SC2086
  if [ -n "$(cd "$PROJECT_ROOT" && git status --porcelain -- $SIDECAR_FILES)" ]; then
    NEEDS_COMMIT=true
  fi
fi

# --------------------------------------------------------------------
# Commit (if any sidecar changed)
# --------------------------------------------------------------------
if [ "$NEEDS_COMMIT" = "true" ]; then
  log_step "commit"
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would stage $SIDECAR_FILES and commit as 'release: v$TARGET'"
  else
    # shellcheck disable=SC2086
    (cd "$PROJECT_ROOT" && git add -- $SIDECAR_FILES 2>/dev/null || true)
    # Only commit if there's something staged
    if [ -n "$(cd "$PROJECT_ROOT" && git diff --cached --name-only)" ]; then
      (cd "$PROJECT_ROOT" && git commit -m "release: v$TARGET" -m "(C) hello@matthewsinclair.com")
      log_info "committed release: v$TARGET"
    else
      log_info "nothing to commit (sidecars already at target)"
    fi
  fi
else
  log_info "no sidecar changes to commit"
fi

# Nothing outside the sidecar list may be left dirty. `intent claude upgrade
# --apply` can touch more than CLAUDE.md if the repo has drifted from canon, and
# a release must never tag a tree that still has uncommitted work in it -- the
# tag would not describe what was published. Fail loudly instead.
if [ "$DRY_RUN" != "true" ]; then
  LEFTOVER="$(cd "$PROJECT_ROOT" && git status --porcelain)"
  if [ -n "$LEFTOVER" ]; then
    log_warn "working tree is not clean after the sidecar sync:"
    printf '%s\n' "$LEFTOVER" | sed 's/^/  /' >&2
    # DELIBERATELY NO LONGER RECOMMENDS `--skip-tests` (dc, 2026-08-18). That
    # flag returns from preflight() before doctor, before the bats suite and
    # before the cargo gate above -- so the tool's own documented recovery path
    # from a dirty tree was "re-run with every correctness gate off", on exactly
    # the run that tags. The releaser following the instruction was the failure,
    # not the releaser being lazy.
    abort "refusing to tag a dirty tree -- commit or revert the above, then re-run"
  fi
fi

# --------------------------------------------------------------------
# Tag
# --------------------------------------------------------------------
log_step "tag"
TAG="v$TARGET"
TAG_EXISTS=false

if (cd "$PROJECT_ROOT" && git rev-parse "$TAG" >/dev/null 2>&1); then
  TAG_EXISTS=true
  TAG_SHA="$(cd "$PROJECT_ROOT" && git rev-parse "$TAG")"
  HEAD_SHA="$(cd "$PROJECT_ROOT" && git rev-parse HEAD)"
  if [ "$TAG_SHA" = "$HEAD_SHA" ]; then
    log_info "tag $TAG already at HEAD ($HEAD_SHA) -- reusing"
  else
    abort "tag $TAG exists at $TAG_SHA but HEAD is $HEAD_SHA -- refusing to force-move"
  fi
fi

if [ "$TAG_EXISTS" = "false" ]; then
  if [ "$DRY_RUN" = "true" ]; then
    log_dry "would create tag $TAG at HEAD"
  else
    (cd "$PROJECT_ROOT" && git tag "$TAG")
    log_info "created tag $TAG"
  fi
fi

# --------------------------------------------------------------------
# Push
# --------------------------------------------------------------------
log_step "push"

PUSH_PROMPT="push $TAG to local (Dropbox) and upstream (GitHub)?"
if [ "$DRY_RUN" = "true" ]; then
  log_dry "would push main + $TAG to 'local' (Dropbox)"
  log_dry "would push main + $TAG to 'upstream' (GitHub)"
else
  if ! confirm "$PUSH_PROMPT"; then
    log_warn "user aborted before push -- tag $TAG exists locally; re-run when ready"
    exit 2
  fi
  (cd "$PROJECT_ROOT" && git push local main "$TAG")
  log_info "pushed to local"
  (cd "$PROJECT_ROOT" && git push upstream main "$TAG")
  log_info "pushed to upstream"
fi

# --------------------------------------------------------------------
# GitHub release
# --------------------------------------------------------------------
log_step "github release"

NOTES_FILE="$(mktemp -t intent-release-notes.XXXXXX)"
# Re-extract after sidecar rewrite so the notes match what's on disk now.
extract_changelog_section "$TARGET" > "$NOTES_FILE"

GH_TITLE="Intent v$TARGET"

RELEASE_EXISTS=false
if gh release view "$TAG" >/dev/null 2>&1; then
  RELEASE_EXISTS=true
fi

if [ "$DRY_RUN" = "true" ]; then
  log_dry "would publish GitHub release $TAG with title '$GH_TITLE'"
  log_dry "release notes preview:"
  sed 's/^/  | /' "$NOTES_FILE" | head -30
  rm -f "$NOTES_FILE"
else
  if [ "$RELEASE_EXISTS" = "true" ]; then
    log_info "release $TAG already exists -- updating notes"
    gh release edit "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE"
  else
    gh release create "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE"
  fi
  log_info "release published"
  rm -f "$NOTES_FILE"
fi

# --------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------
log_step "summary"
if [ "$DRY_RUN" = "true" ]; then
  log_info "dry-run complete -- no side effects"
  log_info "to execute: re-run without --dry-run"
else
  log_info "Intent $TAG cut and published"
  log_info "  local:    pushed main + $TAG to ~/Dropbox/Repositories/Devel/Intent"
  log_info "  upstream: $(gh release view "$TAG" --json url -q .url 2>/dev/null || echo "(check gh release view $TAG)")"
fi
exit 0
