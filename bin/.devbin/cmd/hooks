#!/usr/bin/env bash
#
# devbin: summary = Report which git hooks are wired to which guards (bare form reports)
#
# intent hooks            -- REPORT the wiring state of this clone's git hooks.
# intent hooks --install  -- wire the repo-local runners into the hooks.
#
# THE HOLE THIS EXISTS FOR, and it sits underneath every other guard here.
# `bin/int precommit` and `bin/int prepush` are tracked, reviewed and tested.
# The lines in `.git/hooks/` that CALL them are not, because git never tracks
# `.git/hooks/`. So every guard landed this morning is a property of ONE MACHINE
# rather than of the repository: a fresh clone receives every guard and nothing
# invoking them.
#
# vc's framing, and it is exact: the guards are in the same state the
# half-committed move was in -- correct in the working copy, absent from what
# anyone else receives. Worse in one respect. A duplicated tree announces itself
# to anyone who looks; an unwired guard does not fail, it reports NOTHING, and
# **reporting nothing is indistinguishable from passing.**
#
# THE BARE FORM REPORTS, deliberately (the `int use` convention). An installer
# someone forgets to run leaves you exactly where you started; a check turns
# "did you run it?" into a measured fact. The check is the load-bearing half.
#
# THREE STATES, NOT A BOOLEAN, because the middle one is the dangerous one:
#
#   WIRED     the hook exists AND invokes the runner
#   UNWIRED   the hook EXISTS and does NOT invoke it  <- looks installed, isn't
#   ABSENT    no hook file at all
#
# A present-but-unwired hook is what a legacy v2 pre-commit, or a chain that
# lost its link, actually looks like from outside: installed, executable, and
# invoking nothing you rely on.
#
# GUARD NAMES ARE READ FROM THE RUNNER, never listed here. Today's ruling
# applied to itself: report what is measured, not what was intended. A hard-coded
# roster in this file would go stale the moment a guard is added and would then
# report a guard that does not run, which is worse than reporting none.
#
# NOT A CI GATE, and the reason is structural rather than a preference: CI clones
# fresh, so it has no hooks by construction and would report ABSENT on every run
# forever. This answers "is THIS clone protected", which is a question only a
# working clone can be asked.
#
# WHAT THIS CANNOT DO. It cannot make the repository carry the wiring. Git will
# not adopt tracked hooks on its own -- that is a deliberate security property,
# not an oversight -- so some per-clone action is irreducible. `core.hooksPath`
# pointed at a tracked directory would shrink that action from "copy files" to
# "run one config command" AND make the hook bodies reviewable, which is the
# better architecture. It is not taken here because it collides with
# `intent claude upgrade`, which installs the critic gate by writing
# `.git/hooks/pre-commit` directly -- that installer is canon and another node's
# lane. Flagged for a ruling rather than decided unilaterally.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

ROOT="${PROJECT_ROOT:?}"
DO_INSTALL=0
[ "${1:-}" = "--install" ] && DO_INSTALL=1

# ASK GIT WHERE THE HOOKS ARE. Never compute it.
#
# The first version of this file read `core.hooksPath` and fell back to
# `$ROOT/.git/hooks`. That handled the redirect correctly and was still WRONG,
# because it is a second implementation of a rule git already owns -- and it
# missed a case the real rule covers. **In a git worktree `.git` is a FILE, not
# a directory**, so `$ROOT/.git/hooks` does not resolve and the check reported
# both hooks ABSENT on a worktree whose hooks are wired (git uses the main
# repository's hooks directory). A false ABSENT.
#
# That is precisely the failure the previous comment here claimed this command
# existed to prevent -- reading the wrong directory and reporting ABSENT for a
# wired clone -- committed by the command itself, via a route the comment did
# not consider. It matters practically rather than theoretically: sacrificial
# worktrees are the mandated pattern on this project for anything that writes,
# so the false ABSENT lands exactly where people are told to work.
#
# `rev-parse --git-path hooks` is git's own answer and covers all three cases at
# once: the default, a core.hooksPath redirect, and a linked worktree. It
# returns an absolute path or one relative to this directory.
HOOKS_DIR="$(git -C "$ROOT" rev-parse --git-path hooks 2>/dev/null || true)"
[ -n "$HOOKS_DIR" ] || HOOKS_DIR=".git/hooks"
case "$HOOKS_DIR" in /*) ;; *) HOOKS_DIR="$ROOT/$HOOKS_DIR" ;; esac

# Reported only, never used for resolution -- naming WHY the directory is where
# it is helps a reader; deciding it here is what went wrong the first time.
REDIRECTED=""
_hp="$(git -C "$ROOT" config --get core.hooksPath 2>/dev/null || true)"
[ -n "$_hp" ] && REDIRECTED="  (core.hooksPath = $_hp)"
[ -f "$ROOT/.git" ] && REDIRECTED="${REDIRECTED}  (linked worktree -- hooks live in the main repository)"

# guards_of <runner-name> -- ASK THE RUNNER what it enforces, then report whether
# each guard that names a script has one that is present and executable.
#
# THIS REPLACES A GREP THAT UNDER-REPORTED, and the correction is worth keeping
# because the original was wrong in the way that is hardest to notice. It read
# `$TOOLS/[a-z]*.sh` out of the runner's source, and this file claimed that
# deriving the names from the runner meant the roster could not rot. It rotted
# within the day: `int precommit` grew a guard implemented INLINE, the grep could
# not see it, and this command reported a gate enforcing two things while it
# enforced three.
#
# **A check that under-reports what a gate enforces is worse than no check**,
# because it is consulted precisely by someone trying to find out, and it answers
# confidently. It is the same failure this command exists to expose -- a hook that
# looks installed and protects less than it claims -- reproduced by the tool doing
# the exposing.
#
# The root error was anchoring on a PATH SHAPE (`$TOOLS/...`) rather than on the
# structural fact (what the runner checks). A needle built from a path stops
# matching the moment the path stops being the shape, and then passes in silence.
# `--list-guards` makes the runner the authority, which is the only arrangement
# where the roster genuinely cannot rot.
guards_of() {
  local runner="$ROOT/bin/.devbin/cmd/$1" name script
  [ -f "$runner" ] || {
    printf '                 runner MISSING: bin/.devbin/cmd/%s\n' "$1"
    return
  }
  # CAPABILITY-DETECT BEFORE INVOKING, and this is not defensive noise -- the
  # obvious version of this function ran `<runner> --list-guards` and read the
  # exit code to decide whether the runner supported it. Measured before
  # shipping: `prepush` tests only for `--force` and otherwise FALLS THROUGH AND
  # RUNS, so that probe would have cloned the repository and cold-built it, ~16s,
  # every single time anyone asked what the hooks were wired to. **A probe with a
  # side effect is not a probe.** Never ask a question by running the thing.
  #
  # So support is detected from the source (a yes/no capability question whose
  # answer is genuinely in the text) and the ROSTER still comes from the runner
  # (the authority on what it checks). Grepping for a capability marker is not
  # the same mistake as grepping for the roster: this cannot go stale in a way
  # that under-reports, because a runner that declares the flag must contain it.
  # ANCHORED ON THE HANDLER ARM, NEVER ON THE MENTION -- and the loose form was
  # live until 2026-08-17, doing exactly what the comment above forbids.
  #
  # `cmd/prepush` carries the words `--list-guards` in a COMMENT and implements
  # no handler for it. The old probe grepped for the bare string, matched that
  # comment, and concluded prepush supported the flag. `int hooks` -- a
  # read-only "what is wired?" report -- then ran `int prepush --list-guards`;
  # prepush ignored the unrecognised flag and DID THE WHOLE THING, cloning HEAD
  # and building both binaries, and its progress lines were parsed as a guard
  # roster and printed as guards. Asking what was wired performed a clone and a
  # build, which is the side-effect-as-probe failure named four lines up, caused
  # by the mitigation written to prevent it.
  #
  # PROSE AND MECHANISM SHARE A SPELLING. A grep for a capability counts the
  # sentences describing it, and documentation is exactly what accumulates
  # around a mechanism other files consume. The invocation contract is the
  # dispatch arm -- `"${1:-}" = "--list-guards"` -- which no comment contains
  # and which a runner cannot honour without.
  #
  # It still cannot go stale in the under-reporting direction: a runner that
  # answers the flag must contain the arm that answers it.
  if ! grep -q '"\${1:-}" = "--list-guards"' "$runner" 2>/dev/null; then
    # Silence and "none" are different answers and only one of them is true;
    # printing nothing here would be the same false green this command exists
    # to expose.
    printf '                 (runner declares no guard roster -- checks are inline)\n'
    return
  fi
  while IFS="$(printf '\t')" read -r name script; do
    [ -n "$name" ] || continue
    if [ "$script" = "-" ] || [ -z "$script" ]; then
      # No script to stat. A legitimate state, not a missing file -- saying so
      # keeps the MISSING report below meaningful.
      printf '                 guard: %s\n' "$name"
    elif [ ! -e "$ROOT/$script" ]; then
      # GENUINELY BROKEN: the runner invokes `bash <path>`, and that fails on a
      # file that is not there. The runner names it and cannot run it.
      printf '                 guard: %s  [%s]  <- MISSING: the runner names a file that is not there\n' "$name" "$script"
    elif [ ! -x "$ROOT/$script" ]; then
      # NOT THE SAME STATE, AND NOT A FAULT IN THIS RUNNER. Measured 2026-08-17:
      # every guard in cmd/precommit is invoked as `bash "$TOOLS/x.sh"`, which
      # does not consult the execute bit -- so a guard with no +x runs, passes,
      # and gates exactly as intended. Only DIRECT invocation is affected.
      #
      # These two were one message (`NOT EXECUTABLE OR MISSING`) until ic hit it,
      # and the overload cost real work in the wrong direction: it reported two
      # correctly-functioning guards as broken, and they were `chmod +x`ed to
      # silence a tool rather than to fix anything. **A missing guard and an
      # unexecutable one need opposite responses, and one message cannot carry
      # both** -- the exit-code-overload shape this thread keeps finding, in
      # prose rather than in a code.
      printf '                 guard: %s  [%s]  <- no +x (the gate still runs it via bash; only direct invocation is affected)\n' "$name" "$script"
    else
      printf '                 guard: %s  [%s]\n' "$name" "$script"
    fi
  done < <("$ROOT/bin/int" "$1" --list-guards 2>/dev/null || true)
}

# report_hook <hook-name> <runner-name>
rc=0
report_hook() {
  local hook="$1" runner="$2" path="$HOOKS_DIR/$1"
  if [ ! -f "$path" ]; then
    printf '  %-12s ABSENT    no hook file -- `int %s` is never invoked\n' "$hook" "$runner"
    rc=1
    return
  fi
  if [ ! -x "$path" ]; then
    printf '  %-12s UNWIRED   present but NOT EXECUTABLE -- git will not run it\n' "$hook"
    rc=1
    return
  fi
  if grep -qE "int[[:space:]]+$runner\b" "$path" 2>/dev/null; then
    printf '  %-12s WIRED     -> int %s\n' "$hook" "$runner"
    guards_of "$runner"
  else
    printf '  %-12s UNWIRED   the file exists and does NOT invoke `int %s`\n' "$hook" "$runner"
    printf '                 present, executable, and running something else -- this is\n'
    printf '                 the state that looks installed and protects nothing.\n'
    rc=1
  fi
}

if [ "$DO_INSTALL" -eq 0 ]; then
  printf 'hooks in %s%s\n\n' "$HOOKS_DIR" "$REDIRECTED"
  report_hook pre-commit precommit
  report_hook pre-push prepush
  report_hook post-commit postcommit
  printf '\n'
  if [ "$rc" -eq 0 ]; then
    printf 'hooks: this clone is wired. NOTE this is a fact about THIS CLONE only --\n'
    printf '  .git/hooks is never tracked, so it says nothing about anyone else.\n'
  else
    printf 'hooks: this clone is NOT fully wired. Run `int hooks --install`.\n'
    printf '  An unwired guard does not fail; it reports nothing, and reporting\n'
    printf '  nothing is indistinguishable from passing.\n'
  fi
  exit "$rc"
fi

# ---- install ----
#
# APPEND, never overwrite. `.git/hooks/pre-commit` here already carries the
# intent-chain-block (installed by `intent claude upgrade`), prettier, and mix
# format. Replacing it would silently drop the critic gate and the whiteboard
# clock guard -- removing guards while claiming to install them.
mkdir -p "$HOOKS_DIR"
install_chain() {
  local hook="$1" runner="$2" path="$HOOKS_DIR/$1"
  if [ ! -f "$path" ]; then
    printf '#!/usr/bin/env bash\nset -euo pipefail\n\n' > "$path"
    printf 'created %s\n' "$path"
  fi
  # THREE STATES, NOT TWO, AND THE MISSING ONE MADE THIS INSTALLER UNABLE TO
  # UPGRADE ANYTHING. It asked only "does this file invoke the runner", so once
  # a hook was wired the answer was yes forever and a CHANGED generator could
  # never reach an existing clone -- it reported `unchanged` and meant it.
  # .git/hooks is never tracked, so there is no other mechanism that would have
  # caught up either: every clone would have kept whatever line it was born
  # with. The estate's own upgrade philosophy is a state PROBE rather than a
  # version ladder; this is that, one directory over.
  #
  # `"$@"` is the payload that forced the issue: git passes a pre-push hook its
  # destination as `<remote-name> <remote-url>`, and the frozen-remote refusal
  # in cmd/prepush cannot see a destination the hook never forwarded.
  # EVERY TEST BELOW IS ANCHORED TO THE START OF A LINE, so a COMMENT mentioning
  # the runner can neither satisfy a check nor be rewritten by one. The first
  # version was not, and it did both: the generated hooks carry a prose line
  # `# The runner is bin/int precommit ...`, which the rewrite happily edited
  # into `bin/int precommit "$@"` mid-sentence -- and which, on a hook whose only
  # mention was that comment, would have reported the line updated with no
  # invocation anywhere in the file. A check a comment can satisfy is not a
  # check; it is the same defect as a guard roster that names what it does not
  # run.
  local call_re="^[[:space:]]*bin/int $runner([[:space:]]|\$)"
  local fwd_re="^[[:space:]]*bin/int $runner[[:space:]]+\"\\\$@\""
  if grep -qE "$fwd_re" "$path" 2>/dev/null; then
    printf 'ok: %s already invokes `int %s "$@"` -- unchanged\n' "$hook" "$runner"
  elif grep -qE "$call_re" "$path" 2>/dev/null; then
    # Wired, but by an older generator. Converge the line in place rather than
    # appending a second invocation.
    #
    # awk and not sed: the target line contains `||`, which collides with sed's
    # usual `|` delimiter, and the replacement text contains `"$@"`, which a
    # double-quoted sed program would expand before sed ever saw it. Both are
    # the sort of quoting accident that produces a file that still parses.
    local tmp
    tmp="$(mktemp)"
    if awk -v r="$runner" '
      $0 ~ ("^[ \t]*bin/int " r "([ \t]|$)") && index($0, "\"$@\"") == 0 {
        sub("bin/int " r, "bin/int " r " \"$@\"")
      }
      { print }
    ' "$path" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
      cat "$tmp" > "$path"
    fi
    rm -f "$tmp"
    if grep -qE "$fwd_re" "$path" 2>/dev/null; then
      printf 'updated: %s -> int %s "$@"  (was not forwarding argv)\n' "$hook" "$runner"
    else
      # Hand-edited into a shape the rewrite does not recognise. Say so rather
      # than claim success or silently append a duplicate gate.
      printf 'WARN: %s invokes `int %s` in a form this installer cannot update.\n' "$hook" "$runner"
      printf '      add `"$@"` to that line by hand so argv reaches the runner.\n'
    fi
  else
    cat >> "$path" <<EOF

# Repo-local gate, wired by \`int hooks --install\`. The runner is tracked at
# bin/.devbin/cmd/$runner; this line is not, because .git/hooks never is.
#
# \`"\$@"\` forwards git's own arguments -- for pre-push that is
# \`<remote-name> <remote-url>\`, which is the only way the runner can know
# where the push is going.
if [ -x bin/int ]; then
  bin/int $runner "\$@" || exit \$?
fi
EOF
    printf 'wired: %s -> int %s "$@"\n' "$hook" "$runner"
  fi
  chmod +x "$path"
}
install_chain pre-commit precommit
install_chain pre-push prepush
install_chain post-commit postcommit
printf '\n'
exec "$0"
