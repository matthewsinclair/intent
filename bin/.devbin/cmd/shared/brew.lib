# shellcheck shell=bash
#
# shared/brew.lib -- the names Intent's release assets and its tap go by, and
# what reads the stage they are made in. SOURCED, never run: 0644 so the
# dispatcher's `is_handler` (-f AND -x) cannot mistake it for a command.
#
# WHAT LEFT (ST0091 WP-03). The formula and the cask are rendered by devbin's
# built-in `formula` from packaging/homebrew/, and it pushes the tap, so the
# renderer and the push that lived here are gone. What stays is read by
# `cmd/macos` (the stage and its publish), `cmd/brew`'s smoke (the tap's brew
# name) and `cut/publish` (the macOS asset names).
#
# FROM THE SOURCING HANDLER IT NEEDS: helpers (die, require_tool), rust_host from
# shared/rusthost.lib (staged_version names the staged binary with it), and ROOT.

# THE SUPPORT TREE, AND WHY A RELEASE OF BINARIES ALSO SHIPS A TARBALL.
#
# **A Rust binary cannot carry shell inside itself.** Intent ships its Claude Code
# hooks and its whiteboard guards as FILES under `lib/templates/`, and shipped
# consumers exec them out of the install tree: `intent claude hook <name>` runs
# `lib/templates/.claude/scripts/<name>.sh`, and the pre-commit gate runs
# `lib/templates/hooks/<guard>.sh` at a path it parses back out of `intent info`.
# The binary finds that tree by walking up from its own symlink-resolved location
# to the directory containing `lib/templates/` (`intentsvcs::install::MARKER`),
# with no environment fallback -- deliberately, because a stale v2 `$INTENT_HOME`
# would otherwise make a v3 binary exec v2's hook scripts.
#
# A formula that installs only the binaries therefore produces an install that
# cannot find itself. Measured against a reproduction of exactly what the formula
# builds -- binary under `Cellar/intent/3.0.0/bin/`, brew-style symlink, neutral
# cwd (probe at 501f5083): `intent info` and `intent claude hook` both fail, and
# the gate's guard path comes back unresolvable. **Every consumer project would
# silently lose its session hooks and both whiteboard guards.**
#
# THE TARBALL'S ROOT IS THE INSTALL ROOT, one level under a wrapper directory,
# and that is the one design decision here worth defending. **The wrapper is not
# decoration -- see SUPPORT_PREFIX in cmd/macos. Without it this archive installs to the wrong
# depth and the install cannot find itself, which is the exact failure the
# paragraph above says the archive exists to prevent. Measured on the first real
# brew install, 2026-08-26.** It contains `lib/templates/...`
# rather than `templates/...`, so the formula's install line is "put everything in
# this archive into libexec" rather than "put templates in libexec/lib". The rule
# library and the skills tree that `intent critic` and `intent claude rules` read
# live OUTSIDE the marker directory (`intent/plugins/claude/`), and rooting the
# archive at the install root is what lets a tree like that join the shipped set
# as a CONTENT change, not a formula change and not a second asset.
#
# IT IS NOT SIGNED AND NOT NOTARISED, AND THAT IS NOT AN OMISSION. Notarisation
# assesses Mach-O binaries; a gzipped tar of shell and markdown has nothing to
# sign and nowhere to hold a ticket. The control that protects it is the same one
# that protects the binaries: `publish` re-downloads what it uploaded and hashes
# THAT. What this DOES require is that `checksum` stop treating "staged artefact"
# and "must be proven notarised" as the same set -- see cmd_checksum in cmd/macos, where an
# unclassified artefact is now a refusal rather than a default.
SUPPORT_ASSET="intent-support.tar.gz"

# THE APP SHIPS AS A RELEASE ASSET BESIDE THE CLI (decision 7; hv: "Of course
# the app ships"). A zip of the STAPLED bundle, made by `macos stage` with `ditto
# -c -k --keepParent` so the signature, the ticket and the extended attributes
# survive. NO TRIPLE: the bundle is universal (x86_64 arm64), so a host triple
# would be false. NO VERSION, as for SUPPORT_ASSET: the tag carries it. Unlike
# the support tarball it IS notarised, so `macos checksum` proves it before
# hashing it. The formula stays CLI-only; the cask names this asset (issue 0634).
# shellcheck disable=SC2034 # read by the handlers that source this file
APP_ASSET="Intent.app.zip"

# WHERE THE ARTEFACTS GO AND WHERE THE CLAIM ABOUT THEM GOES. Separate repositories,
# by hv's ruling of 2026-08-15 (D40): artefacts live on the source repo's own
# releases, and the tap carries only the formula that names them.
#
# The spellings are all real and none is derivable from the others without
# a rule someone has to remember: GitHub calls the tap `homebrew-intent`, brew
# calls the same thing `matthewsinclair/intent`, and the source repo is a third
# name again. Written out once rather than reconstructed at each use.
# shellcheck disable=SC2034 # read by the handlers that source this file
REPO="matthewsinclair/intent"
# shellcheck disable=SC2034 # read by the handlers that source this file
BREW_TAP="matthewsinclair/intent"

# MEASURED 2026-08-15: neither `intent` nor `intentd` exists in homebrew-core, so
# the names are free and `brew install intent` would resolve to our tap once it
# is tapped. **We still print the fully-qualified `matthewsinclair/intent/intent`
# everywhere, deliberately.** The short form works only while core stays empty of
# that name, and the day core gains one, every published instruction becomes
# ambiguous at best and installs somebody else's software at worst -- in an
# instruction users have already copied into their own docs. The long form cannot
# be shadowed and costs one line of typing.

# EVERYTHING AFTER THE COPY HAPPENS HERE, AND THAT IS THE WHOLE POINT.
#
# `target/release/` is SHARED MUTABLE STATE. Several sessions build in this tree and
# `cargo build --release` is the most ordinary thing any of them does -- so a
# signature living there is not a property of a file, it is a property of a file
# that nobody has rebuilt yet.
#
# MEASURED LIVE, 2026-08-15: a peer's release build replaced a Developer ID
# signature with the linker's ad-hoc one, and one of the shipped binaries stopped
# being notarised inside the hour, with NO signal and every artefact of the
# earlier proof still reading as valid. Nobody did anything wrong; a shared target
# directory is what it is for.
#
# The first response was to make `stage` REFUSE to checksum anything it could not
# prove. That was right and it stays -- but a refusal DETECTS the race, it does
# not remove it, and it detects it only at the end, after a notarisation round
# trip has already been spent on bytes that no longer exist.
#
# So the target moved instead. `target/dist/` is written by `int macos stage` and by
# nothing else, which means the window in which a peer can disturb an artefact
# shrinks from "the whole sign -> notarise -> stage sequence", minutes long and
# spanning a network round trip to Apple, to "the ditto on the line below". **A
# structure that cannot fail beats a control that catches the failure**, and the
# control is still there underneath because catching it is free.
STAGE_DIR="$ROOT/native/rust/target/dist"

# THE PARTS THE macOS ARCHIVE IS PACKED FROM, NEVER PUBLISHED (ST0091, devbin
# 0329): the two binaries `stage` copies and `sign` and `notarize` prove, and the
# support tarball. A sibling of STAGE_DIR, so everything in STAGE_DIR is an
# asset the release carries and nothing here can be uploaded by mistake. `pack`
# lays them into MACOS_ASSET, rooted at the install root as the Linux package is.
PARTS_DIR="$ROOT/native/rust/target/dist-parts"

# require_sums -- the proof file, or the reason there isn't one.
#
# ONE MESSAGE FOR ONE MISSING FILE. `formula` and `publish` both need it and both
# need to say the same thing about why it is absent, because the answer is never
# "create it" -- it is "prove the artefacts and it will be written for you".
require_sums() {
  [ -f "$STAGE_DIR/SHA256SUMS.txt" ] ||
    die "no proven artefacts to describe -- run 'bin/devbin macos prepare' first (SHA256SUMS.txt is written only by 'checksum', and only for artefacts it has proven signed AND notarised)"
}

# staged_version -- the version the SHIPPING binary reports.
#
# From the BINARY, never from Cargo.toml or a git tag. It is the only source that
# cannot disagree with what a user will actually run: a version read from a
# manifest describes what was meant to be built, and the gap between those two is
# exactly what a release must not ship. It also makes the formula's `test do`
# block pass by construction rather than by coincidence.
staged_version() {
  local bin out v
  # THE VERSION TOKEN ONLY. `--version` prints `intent <version> (<commit>)`, and
  # the provenance suffix is NOT part of the version. Taking everything after
  # `intent ` put `3.0.0-dev (4c5babdf...)` into `version`, into RELEASE_VERSION,
  # and therefore into every download URL -- a URL carrying a space and
  # parentheses, inside a formula that was otherwise perfectly well-formed and
  # linted clean. Nothing about the output looked wrong.
  #
  # FOUND ON THE FIRST END-TO-END RUN, which is precisely what the cmd_formula
  # header then predicted would happen to this path: "this path has no end-to-end
  # test, and refactoring an unexercised artefact for elegance is how the first
  # real run finds something new". It found something new.
  #
  # AND EVERY WAY THE READ FAILS SPEAKS (issue 0595's census). This was one pipe,
  # `"$bin" --version 2>/dev/null | sed`, under `set -euo pipefail` and helpers'
  # inherit_errexit, so a staged binary that was missing or would not run ended
  # the script at the pipe, in silence, before the die below could say why: an
  # empty refusal at a release cut. Its stderr is kept, because a binary that will
  # not run says why there.
  bin="$PARTS_DIR/intent-$(rust_host)"
  [ -e "$bin" ] || die "there is no staged intent binary at $bin -- run 'bin/devbin macos stage' (or 'prepare') first"
  out="$("$bin" --version 2>&1)" || die "the staged intent binary does not run, so its version cannot be read. $bin --version said:
$out"
  v="$(printf '%s\n' "$out" | sed -n 's/^intent \([^ ]*\).*/\1/p')"
  [ -n "$v" ] || die "could not read a version from the staged intent binary. $bin --version said:
$out"
  # A VERSION THAT CANNOT SIT IN A URL IS A BROKEN FORMULA, and it does not break
  # for us -- it breaks for every `brew install`, against a formula already
  # published. Refuse where the harm is, the same rule that keeps the dev-version
  # refusal in `publish`.
  case "$v" in
    *[!A-Za-z0-9.+_-]*)
      die "the staged binary reports a version that is not URL-safe: '$v' -- the formula's download URLs are built from it"
      ;;
  esac
  printf '%s' "$v"
}

# --- the asset set -----------------------------------------------------------
# The macOS assets' triple. The formula's macOS branch is arm64 only, by hv's
# ruling of 2026-08-15, so this is a constant and not this host's triple: the
# formula is rendered on Linux too (a dev tap on hv's Ubuntu VM, or a CI step),
# where the host's own triple names nothing on the release.
MACOS_TRIPLE="aarch64-apple-darwin"

# THE ONE macOS ARCHIVE (devbin 0329, hv's "Agree", 2026-11-11): bin/intent,
# bin/intentd and the support tree under one top-level directory, its stem, as
# the Linux packages are, so the formula's generated install lays out both
# platforms alike and the template stages nothing by hand (T8). The top
# directory is never `bin`, and nothing in it is bin/devbin, which the generated
# install would run.
MACOS_TOP="intent-$MACOS_TRIPLE"
MACOS_ASSET="$MACOS_TOP.tar.gz"

# brew_macos_assets -- the macOS assets the formula names, one per line: the
# archive.
brew_macos_assets() {
  printf '%s\n' "$MACOS_ASSET"
}
