# shellcheck shell=bash
#
# WHAT A RELEASE COMMIT HOLDS: the files the cut's stamp stage writes, and the
# classifier for the views it folds in beside them. Sourced by the cut's stages
# (bin/.devbin/cut/), whose stamp devbin's release core commits.

# The config and the native pair, named once for the stamp steps' reads and
# for the list below.
CONFIG_REL="intent/.config/config.json"
NATIVE_MANIFEST_REL="native/rust/Cargo.toml"
NATIVE_LOCK_REL="native/rust/Cargo.lock"

# The sidecars the cut owns end to end: its stamp steps write these and the
# footer-only views and nothing else, and refuse anything else. ONE list, read
# by every stamp step and pre-flight check that asks what a release commit
# contains.
#
# `native/rust/Cargo.toml` carries `[workspace.package] version`, every crate
# inherits it with `version.workspace = true`, and both binaries compile their
# own version string from `env!("CARGO_PKG_VERSION")`. So the workspace version
# IS the v3 product's version -- the number on `intent --version` and on the
# page intentd serves -- and the lockfile records it per member, so the two must
# move together.
#
# THIS WAS CONDITIONAL ON A 3.x TARGET AND THE CONDITION IS NOW UNREACHABLE, so
# it is deleted rather than left as a guard that reads as live. Its own comment
# predicted the retirement -- "once 2.x stops being cut there is no other arm" --
# and what retired it is not a judgement call: the core's resolve step refuses
# anything not GREATER than the newest release tag (release.steps L242-245), and
# that is a 3.x. A 2.x target cannot reach this line to be excluded
# by it.
#
# The hazard the condition guarded is real and has simply moved upstream:
# stamping `2.19.1` into the Rust workspace would make the next v3 build
# announce itself as a v2. If 2.x is ever cut again it will be from a branch
# whose newest tag is a 2.x, where resolve admits it -- and the cut will need
# the arm back. That is a deliberate condition to restore at that point,
# not a silent behaviour to rediscover.
#
# THE NATIVE PAIR WAS AN APPEND TO THIS LIST UNTIL 2026-09-11, which made the
# append a second home for the list the comment above says there is one of
# (vc, AC-00.6). Folded into the one declaration; the set is unchanged.
# `schema` is a DIRECTORY entry on purpose: the faces are generated, so a face
# added to a future release joins the commit without this list being edited.
SIDECAR_FILES="VERSION CHANGELOG.md AGENTS.md CLAUDE.md $CONFIG_REL $NATIVE_MANIFEST_REL $NATIVE_LOCK_REL schema"

# `footer_only` reads one file's `git diff -U0` on stdin and exits 0 when every
# changed line is the generated footer, `_Generated by Intent vX ...` (the major
# alone since 2026-09-25) or the older `vX.Y.Z ...`, and 1 otherwise, including
# when nothing changed at all. The stamp stage's view fold trusts it (issue
# 0464).
#
# It counts only lines INSIDE a hunk. It used to select changed lines with
# `^[-+][^-+]`, which also skipped every changed line whose own text starts with
# `-` or `+`: a markdown bullet reads `-- item` or `+- item` in a diff, and a
# removed or added blank line reads `-` or `+` alone. A view whose only real
# change was a bullet was classed footer-only and folded into the release
# commit under the release message. Tracking the hunk is what tells a
# `--- a/<path>` file header from a removed line reading `-- ...`.
footer_only() {
  awk '
    /^diff --git / { in_hunk = 0; next }
    /^@@ / { in_hunk = 1; next }
    !in_hunk { next }
    /^[-+]/ {
      changed++
      if ($0 !~ /^[-+]_Generated by Intent v[0-9]+(\.[0-9]+\.[0-9]+)? /) other = 1
    }
    END { exit (changed > 0 && !other) ? 0 : 1 }
  '
}

# release_is_sidecar <path> -- 0 when <path> is one of SIDECAR_FILES, or lies
# under one of its directory entries (`schema`), and 1 otherwise. The one test
# of membership, read by the cut's stages.
release_is_sidecar() {
  local entry
  for entry in $SIDECAR_FILES; do
    case "$1" in "$entry" | "$entry"/*) return 0 ;; esac
  done
  return 1
}

# ---------------------------------------------------------------------------
# THE CUT'S STAMP HELPERS (ST0091 WP-01). Moved here from the retired driver,
# cmd/build.d/release, so the cut's preflight and stamp stages and their tests
# read one definition (bin/.devbin/cut/preflight, bin/.devbin/cut/stamp).
# ---------------------------------------------------------------------------

# stamp_project_version <version> [<config>] -- `.intent_version` in the
# project config set to <version>, and the legacy `.version` deleted. The
# return codes are the contract: 0 stamped, 1 already at <version>, anything
# else could not stamp. It reaches jq, mktemp and mv, and nothing else.
stamp_project_version() {
  local version="$1"
  local config="${2:-intent/.config/config.json}"
  [ -n "$version" ] || return 2
  [ -f "$config" ] || return 2
  command -v jq >/dev/null 2>&1 || return 2
  local current
  current="$(jq -r '.intent_version // ""' "$config" 2>/dev/null)"
  [ "$current" = "$version" ] && return 1
  local tmp
  tmp="$(mktemp)" || return 2
  if ! jq --arg v "$version" '.intent_version = $v | del(.version)' "$config" >"$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  mv "$tmp" "$config" || {
    rm -f "$tmp"
    return 2
  }
  return 0
}

# THE LOCK'S NON-MEMBER CHECK. The member list is DERIVED from the lockfile
# being checked rather than from `cargo metadata`: it needs no jq and no second
# cargo run, and a crate newly added to the workspace counts as a member the
# moment it is one, where a hardcoded roster would reclassify it as a
# dependency, the direction that fails quietly.
lock_packages() {
  awk '
    /^\[\[package\]\]/ { name=""; version=""; next }
    /^name = "/        { name=$0;    sub(/^name = "/,"",name);       sub(/"$/,"",name);       next }
    /^version = "/     { version=$0; sub(/^version = "/,"",version); sub(/"$/,"",version);
                         if (name != "") print name "\t" version; next }
  ' "$1" | LC_ALL=C sort
}

lock_members() {
  awk '
    /^\[\[package\]\]/ { if (name != "" && !src) print name; name=""; src=0; next }
    /^name = "/        { name=$0; sub(/^name = "/,"",name); sub(/"$/,"",name); next }
    /^source = /       { src=1; next }
    END                { if (name != "" && !src) print name }
  ' "$1" | LC_ALL=C sort
}

# lock_nonmember_changes <before> <after> -- the names of changed packages that
# are not workspace members of <after>, one a line. Empty output is the only
# condition under which a release may fold a refreshed lockfile into its
# commit. Returns non-zero WITHOUT names when either extraction comes back
# empty: an empty parse yields an empty difference, which would otherwise read
# as "nothing changed" and accept anything, so the caller must be able to tell
# "no offenders" from "could not look".
lock_nonmember_changes() {
  local before="$1" after="$2"
  local pkgs_before pkgs_after members
  pkgs_before="$(mktemp)"
  pkgs_after="$(mktemp)"
  members="$(mktemp)"

  lock_packages "$before" >"$pkgs_before"
  lock_packages "$after" >"$pkgs_after"
  lock_members "$after" >"$members"

  if [ ! -s "$pkgs_after" ] || [ ! -s "$members" ]; then
    rm -f "$pkgs_before" "$pkgs_after" "$members"
    return 1
  fi

  LC_ALL=C comm -3 "$pkgs_before" "$pkgs_after" | sed 's/^\t//' | cut -f1 | LC_ALL=C sort -u |
    LC_ALL=C comm -23 - "$members"
  rm -f "$pkgs_before" "$pkgs_after" "$members"
  return 0
}

# schema_faces_version_blockers <root> <version> -- one line for each published
# face under <root>/schema that does not carry <version>, and nothing when every
# one does. The faces are READ, not the generator: asking each published file
# what it says is what a consumer of the release does. `faces.rs` stamps
# `INTENT_VER: <v>` into the SQL and SDL faces as a comment and
# `"x-intent-ver": "<v>"` into each JSON Schema, so both spellings are read.
schema_faces_version_blockers() {
  local root="$1" version="$2" f rel v out=""
  for f in "$root"/schema/*; do
    [ -f "$f" ] || continue
    rel="${f#"$root"/}"
    case "$f" in
      *.json)
        v="$(sed -n 's/.*"x-intent-ver"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)" ;;
      *)
        v="$(sed -n 's/^[^A-Za-z]*INTENT_VER:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$f" | head -1)" ;;
    esac
    [ "$v" = "$version" ] || out="$out  $rel carries ${v:-<no version marker>}
"
  done
  printf '%s' "$out"
}

# release_scope_dirt <root> <pathspec>... -- every path under <pathspec> that
# differs from HEAD, tracked or untracked and not ignored, one a line, relative
# to <root>. What a stamp step prints: the paths in its scope the release
# commit will carry, whichever run of the step wrote them, so a cut resumed
# after a stopped stamp prints them again rather than leaving them as dirt.
# `--no-renames`, so a moved file is named at both ends, as the core's own
# list of dirt names it. Non-zero, printing nothing, when git cannot answer:
# no answer is not "no dirt".
release_scope_dirt() {
  local root="$1" changed untracked
  shift
  changed="$(git -C "$root" --no-optional-locks diff --no-renames --name-only HEAD -- "$@")" || return 1
  untracked="$(git -C "$root" --no-optional-locks ls-files --others --exclude-standard -- "$@")" || return 1
  printf '%s\n%s\n' "$changed" "$untracked" | sed '/^$/d' | LC_ALL=C sort -u
}

# release_dirty_marks <root> -- `<hash><TAB><path>` for every path that differs
# from HEAD or is untracked, the hash of its bytes now, or `gone` for a path no
# longer there. Two of them, read either side of a writer, name every path the
# writer touched (release_marks_changed), a path already dirty that it rewrote
# included, which two lists of dirty paths alone read as the same.
release_dirty_marks() {
  local root="$1" paths p h
  paths="$(release_scope_dirt "$root" .)" || return 1
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ -e "$root/$p" ] || [ -L "$root/$p" ]; then
      h="$(git -C "$root" hash-object --no-filters -- "$p")" || return 1
    else
      h=gone
    fi
    printf '%s\t%s\n' "$h" "$p"
  done <<<"$paths"
}

# release_marks_changed <before> <after> -- the paths whose mark in <after> is
# not in <before>, one a line: written or rewritten between the two reads. A
# path a writer returned to HEAD's bytes is in neither the dirt nor this list,
# and it is in no release commit either.
release_marks_changed() {
  LC_ALL=C comm -13 <(printf '%s\n' "$1" | LC_ALL=C sort) <(printf '%s\n' "$2" | LC_ALL=C sort) |
    cut -f2 | sed '/^$/d'
}

# release_version_file <root> -- the version being cut, read from the
# project's version file: devbin's project.version_from, which the dispatcher
# exports as DEVBIN_VERSION_FILE (VERSION where nothing exports it). The core's
# `version set` writes it before any stamp step runs. Refuses, naming the file,
# when it reads empty.
release_version_file() {
  local file="${DEVBIN_VERSION_FILE:-VERSION}" v
  v="$(tr -d '[:space:]' <"$1/$file" 2>/dev/null)" || v=""
  [ -n "$v" ] || {
    printf 'error: cannot read a version from %s/%s\n' "$1" "$file" >&2
    return 1
  }
  printf '%s\n' "$v"
}

# release_head_version <root> -- the version file as HEAD has it. Beside
# release_version_file it says whether a stamp has begun: the core's `version
# set` is the stamp's first write, so a version file that reads as HEAD's is a
# tree no stamp has touched (vc decision 115).
release_head_version() {
  local file="${DEVBIN_VERSION_FILE:-VERSION}" raw v
  raw="$(git -C "$1" --no-optional-locks show "HEAD:$file" 2>/dev/null)" || {
    printf 'error: cannot read %s at HEAD in %s\n' "$file" "$1" >&2
    return 1
  }
  v="$(printf '%s' "$raw" | tr -d '[:space:]')"
  [ -n "$v" ] || {
    printf 'error: %s reads empty at HEAD in %s\n' "$file" "$1" >&2
    return 1
  }
  printf '%s\n' "$v"
}

# release_built_cli <root> -- the release pair's intent, built FROM the tree
# being released by `bin/devbin build all`, refusing with that remedy when
# there is none. Never the one on PATH: the cut's checks ask the tree's own
# build, so their answers are not a function of the shell they run in. It
# REFUSES RATHER THAN FALLING BACK to the one on PATH: a fallback that warns is
# a fallback that gets ignored.
release_built_cli() {
  local bin="$1/native/rust/target/release/intent"
  if [ -x "$bin" ]; then
    printf '%s\n' "$bin"
    return 0
  fi
  printf "error: no built CLI at %s\n  remedy: run \`bin/devbin build all\` first\n" "$bin" >&2
  return 1
}

# release_stamp_cli <root> <version> -- the CLI `bin/devbin stamp cli` built at
# <version>, in the debug target. A rendered file names the version of the
# binary that rendered it (issue 0387), so each step that renders with it reads
# its version first and refuses one that does not report <version>.
release_stamp_cli() {
  local bin="$1/native/rust/target/debug/intent" said
  [ -x "$bin" ] || {
    printf "error: no stamp CLI at %s\n  remedy: run \`bin/devbin stamp cli\`, which builds it at the version being cut\n" "$bin" >&2
    return 1
  }
  said="$("$bin" --version 2>&1)" || {
    printf 'error: %s --version failed: %s\n' "$bin" "$said" >&2
    return 1
  }
  case "$said" in
    "intent $2 "*) printf '%s\n' "$bin" ;;
    *)
      printf "error: the stamp CLI at %s reports '%s', not %s\n  remedy: run \`bin/devbin stamp cli\`, which builds it at the version being cut\n" "$bin" "$said" "$2" >&2
      return 1
      ;;
  esac
}
