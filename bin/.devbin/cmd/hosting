#!/usr/bin/env bash
#
# devbin: summary = Which commands are actually HOSTED, at a named revision
#
# int hosting [--include-mutating] [verb...] -- drive each command against a
# binary BUILT IN THE SAME ACT, inside a single-writer clone of HEAD.
#
# THE DEFECT THIS ANSWERS, AND IT IS THE AUTHOR'S OWN (dc, 2026-08-22).
# `surface/dispatch-table.md` carries a `Target:` per command, and READING IT
# ANSWERS A DIFFERENT QUESTION THAN THE ONE A SWEEP ASKS. Driven that day, both
# diagonals occupied: `fileindex` carries a RATIFIED AND APPLIED `corrected`
# disposition and exits 2 unbuilt; `agents` carries `pending-hv`, undecided, and
# is hosted and working. Disposition records what v3 SHOULD do. Only the binary
# knows what it DOES.
#
# AND *DRIVE THE BINARY* IS NECESSARY AND NOT SUFFICIENT, WHICH IS WHY THIS IS A
# COMMAND RATHER THAN A SHELL LOOP. The first sweep drove a binary built fifteen
# commits behind HEAD and reported `claude skills` UNBUILT; the fix had landed
# WHILE THE SWEEP RAN, so the result was false before it was published, and it
# had already been sent to the node who wrote the fix. **`rc=2` is byte-identical
# whether a command was never built or was built ten minutes ago into a binary
# you are not running.** Nothing in the drive says which.
#
# SO THE BUILD AND THE MEASUREMENT ARE ONE ACT -- `shared/measure.lib` -- and the
# figure names the artefact's HASH. **Not its marker**: measured the same day,
# two behaviourally different binaries carried one clean `[intent-source-commit:]`
# because a DEPENDENCY changed and the binary crate's `build.rs` never re-ran.
#
# `--help` IS NOT A PROBE AND THIS IS THE TRAP THAT CATCHES EVERYONE INCLUDING
# THE PERSON WHO WROTE IT UP AN HOUR EARLIER. Under INV-07 `--help` exits 0 to
# stdout whether or not the command is built: all eight `claude` subcommands
# answered rc=0 and the family was nearly filed as fully hosted. Every verb here
# is a REAL invocation.
#
# WHY A CLONE MAKES THE UNDRIVABLE DRIVABLE. A sweep over the live tree can only
# touch read-only verbs, and *declared read-only* is not a substitute for driving
# -- `st edit` declares `read`, and WRITES the store and appends to a tracked file
# on its refusal path. In a throwaway clone a mutator harms nothing, so
# `--include-mutating` drives them too. `claude start` is still excluded: it
# SPAWNS, which a clone does not contain.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"
. "$(dirname "${BASH_SOURCE[0]}")/shared/clone.lib"
. "$(dirname "${BASH_SOURCE[0]}")/shared/measure.lib"

ROOT="${PROJECT_ROOT:?}"
BIN_REL="native/rust/target/release/intent"
INCLUDE_MUTATING=0
VERBS=()

# READ-ONLY BY DEFAULT, AND THE LIST IS EXPLICIT RATHER THAN DERIVED. A derived
# list would have to decide read-vs-write from a declaration, and the declaration
# is exactly what was measured wrong.
READONLY_VERBS=(
  "st list" "wp list" "ac list" "at list" "todo" "issues list" "info" "doctor"
  "claude skills list" "claude rules list" "claude subagents list" "claude ws list"
  "agents sync" "critic" "lang" "llm" "modules" "fileindex bin" "version" "search"
)
# SAFE ONLY IN A CLONE. Named here rather than in prose so the boundary is data.
MUTATING_VERBS=( "claude upgrade" "claude prime" "init" "bootstrap" "upgrade" )

for a in "$@"; do
  case "$a" in
    --include-mutating) INCLUDE_MUTATING=1 ;;
    -h | --help)
      sed -n '5,7p' "${BASH_SOURCE[0]}" | sed -e 's/^# //' -e 's/^#$//'
      exit 0
      ;;
    *) VERBS+=("$a") ;;
  esac
done

if [ "${#VERBS[@]}" -eq 0 ]; then
  VERBS=("${READONLY_VERBS[@]}")
  [ "$INCLUDE_MUTATING" -eq 1 ] && VERBS+=("${MUTATING_VERBS[@]}")
fi

TMP="$(mktemp -d)" || die "cannot create a temp dir"
# shellcheck disable=SC2064
trap "rm -rf '$TMP'" EXIT

step "hosting: cloning HEAD -- the tree under measurement has one writer"
clone_sha="$(measured_clone "$ROOT" "$TMP/clone")"
printf '    clone at %s\n' "$clone_sha"

step "hosting: building the measured revision -- the build and the sweep are ONE act"
art_hash="$(measured_build "$TMP/clone" "$BIN_REL")"
BIN="$TMP/clone/$BIN_REL"

step "hosting: driving ${#VERBS[@]} verb(s)"
printf '\n'
hosted=0; unbuilt=0; retired=0; other=0
for v in "${VERBS[@]}"; do
  # ARGV SPLIT DELIBERATELY AND NOT VIA AN UNQUOTED VAR. This shell family does
  # not word-split an unquoted expansion the way bash does, so `$v` holding
  # "claude skills list" arrives as ONE argument and EVERY verb answers
  # `unrecognized subcommand` -- a uniform, plausible, entirely wrong sweep.
  # Measured: a first pass reported rc=0 for six verbs including `st list`.
  read -r -a argv <<<"$v"
  # rc OFF THE BARE CALL. `cmd | head` reports head's status, which returned 0
  # for everything in that same first pass -- two faults, one command, one
  # clean-looking wrong answer.
  out="$( "$BIN" "${argv[@]}" 2>&1 )" && rc=0 || rc=$?
  case "$rc" in
    0) state="HOSTED"; hosted=$((hosted+1)) ;;
    2)
      if printf '%s' "$out" | grep -q 'not implemented yet'; then
        state="UNBUILT"; unbuilt=$((unbuilt+1))
      elif printf '%s' "$out" | grep -q 'retired'; then
        state="retired"; retired=$((retired+1))
      else
        state="rc2-other"; other=$((other+1))
      fi
      ;;
    *) state="rc$rc"; other=$((other+1)) ;;
  esac
  printf '  %-9s %-28s %s\n' "$state" "$v" "$(printf '%s' "$out" | head -1 | cut -c1-44)"
done

printf '\n'
measurement_banner "$clone_sha" "$art_hash"
printf 'hosting: %s hosted, %s unbuilt, %s retired, %s other, of %s driven\n' \
  "$hosted" "$unbuilt" "$retired" "$other" "${#VERBS[@]}"
if [ "$INCLUDE_MUTATING" -eq 0 ]; then
  printf 'hosting: READ-ONLY VERBS ONLY. The mutating ones are NOT in this count and this\n'
  printf '         sweep is INCOMPLETE BY CONSTRUCTION -- pass --include-mutating, which is\n'
  printf '         safe here ONLY because the subject is a throwaway clone.\n'
fi
printf 'hosting: `claude start` is excluded in BOTH modes -- it SPAWNS, and a clone does not contain that.\n'
