#!/usr/bin/env bash
#
# devbin: summary = The push gates: frozen remotes, and the delivered pair's currency
# devbin: args = [<remote-name> <remote-url>]
# bin/devbin prepush [<remote-name> <remote-url>] -- the gates a push meets.
# Invoked by .githooks/pre-push (the tracked hooks directory core.hooksPath
# points at) as `bin/int prepush "$@"`, which forwards git's destination
# arguments and the ref pairs on stdin; safe to run by hand.
#
#   --list-frozen  (first argument only) print FROZEN_REMOTES, one per line,
#                  and exit 0
#   INTENT_ALLOW_FROZEN_PUSH=1  let one push reach a frozen remote
#
# Exits 0 when the push may go, and 1 on a frozen remote, a delivered pair the
# currency verdict refuses, or any failure.
#
# TWO GATES, AND WHAT LEFT (ST0091 WP-02). This used to clone HEAD and build it
# cold on any push that changed a build input, and to refuse a push to upstream
# that no green Linux preflight on kovacs covered. devbin's release core now
# cuts Intent, and runs Intent's declared gates on kovacs as a leg of the cut
# (`release.legs`) on the release commit, which is the build and the Linux run
# those two existed for, at the one moment they decide anything. CI clones
# fresh on every push to main and every candidate. The failure the clone was
# for, a half-committed move of native code that builds in the working tree and
# not in the repository (2026-08-15), is a failure of the repository, and CI and
# the cut's legs both build the repository.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"
. "$DEVBIN_LIB/config"

# `--help` prints the usage block above and runs nothing.
case "${1:-}" in
  -h | --help)
    awk 'NR < 5 { next } /^#$/ || !/^#/ { exit } { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
    ;;
esac

# THE CURRENCY VERDICT'S OWN SOURCES, in the order `currency.lib` demands:
# `artefact.lib` then `sharedtarget.lib`, then the verdict. `releasebuild.lib`
# is here for `RELEASE_DIR` alone, so the delivered pair has one spelling. A
# HARD DEPENDENCY for the reason `cmd/cli` gives: a gate that drops its check
# when a file goes missing still looks like a gate.
for lib in artefact sharedtarget currency releasebuild; do
  libpath="$(dirname "${BASH_SOURCE[0]}")/shared/$lib.lib"
  [ -r "$libpath" ] || die "cannot read $libpath -- refusing to push without the checks it carries"
  # shellcheck disable=SC1090
  . "$libpath"
done

ROOT="${PROJECT_ROOT:?}"

# git calls a pre-push hook as `<hook> <remote-name> <remote-url>`, so the two
# positional arguments are the DESTINATION and everything else is a flag, which
# is ignored: the retired `--force` built the clone, and an older hook line or a
# hand may still pass it.
REMOTE=""
REMOTE_URL=""
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *)
      if [ -z "$REMOTE" ]; then
        REMOTE="$arg"
      elif [ -z "$REMOTE_URL" ]; then
        REMOTE_URL="$arg"
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# FROZEN REMOTES -- refuse a push to a remote the hypervisor has closed.
#
# LIFTED 2026-08-20 by hv, and the list is empty. The freeze existed from
# 2026-08-16 because every push to `upstream` triggers the GitHub workflows and
# the CI/CD budget had been hit. hv, lifting it: "All I wanted was to not push
# to upstream so as not to trigger a CI/CD run given the GitHub budget was
# exhausted. It doesn't matter now, as the runs just failed immediately."
#
# The mechanism stays because an empty list is the correct answer to "what is
# frozen". Add a remote name here to close one again; that is the whole
# interface.
#
# ONE NOTE FROM hv WORTH KEEPING, because it is about this file rather than
# about the freeze: "I don't know why we have this formal/technical freeze like
# that. All I wanted was to not push to upstream." The intent was one sentence
# and it acquired a gate, a URL matcher, an escape hatch, a second consumer and
# a long comment of reasoning. Matching by URL as well as by name was load-bearing;
# the rest was a simple instruction growing a mechanism around itself. Worth
# reading before the next control gets built here.
FROZEN_REMOTES=""

# DECLARED ONCE, ASKED BY ANY CALLER -- the same arrangement `precommit
# --list-guards` uses, and for the same reason: the runner that enforces the
# rule is the authority on what the rule is, and everyone else asks. The retired
# release driver asked it before it tagged. devbin's core, which cuts since
# ST0091, pushes to `release.remotes` alone and asks nothing here: its pushes
# meet this hook as any push does, so a frozen remote it declares refuses its
# candidate push, before the tag (ST0091 WP-02).
if [ "${1:-}" = "--list-frozen" ]; then
  for frozen in $FROZEN_REMOTES; do printf '%s\n' "$frozen"; done
  exit 0
fi

# push_reaches <remote> -- whether this push goes to <remote>, by its name or by
# its configured URL. By hand there is no destination, and a push with none
# reaches nothing.
push_reaches() {
  local name=$1 url
  [ -n "$REMOTE" ] || return 1
  [ "$REMOTE" = "$name" ] && return 0
  url="$(git -C "$ROOT" config --get "remote.$name.url" 2>/dev/null || true)"
  [ -n "$url" ] && { [ "$REMOTE" = "$url" ] || [ "$REMOTE_URL" = "$url" ]; }
}

if [ -n "$REMOTE" ] && [ -z "${INTENT_ALLOW_FROZEN_PUSH:-}" ]; then
  for frozen in $FROZEN_REMOTES; do
    push_reaches "$frozen" || continue
    cat >&2 <<EOF

BLOCKED: '$frozen' is a FROZEN remote and this push would reach it.

  '$frozen' is listed in FROZEN_REMOTES in bin/.devbin/cmd/prepush; the commit
  that added it says why.

  Push 'local' instead -- it is a Dropbox path, it costs nothing, and it is
  where this estate's work has been landing since the freeze:

      git push local main

  The two remotes are EXPECTED to diverge while this holds. That is not a
  fault to chase, and comparing them will report a difference every time.

  If hv has lifted the freeze, delete '$frozen' from FROZEN_REMOTES in
  bin/.devbin/cmd/prepush and commit it -- the lift belongs in the history
  beside the freeze.

  To push once without lifting it:

      INTENT_ALLOW_FROZEN_PUSH=1 git push $frozen main

EOF
    exit 1
  done
fi

# ---------------------------------------------------------------------------
# A CANDIDATE PUSH IS NOT THE RELEASE PUSH (vc's ruling on dc's finding F2,
# ST0091 WP-02). At its legs step devbin's core pushes the release commit to
# upstream as a `candidate/` ref, for CI, while the local gates are still
# running, so the pair gate may not have finished and the pair may not yet
# describe that commit. The legs judge the candidate; the currency verdict below
# is asked of the push of main and of the tag, the release push. So a push that
# moves only candidate refs is asked no currency verdict. The frozen check above
# still applies to it.
#
# THE PREFIX IS READ FROM CONFIG, never written here: release.publish.candidate,
# declared or the core's default, up to its first `{`. A template whose prefix
# is empty would make every ref a candidate, so it refuses instead.
candidate_prefix() {
  local tmpl prefix
  cfg_load "$ROOT/bin/.devbin/config.yaml" || return 1
  tmpl="$(cfg_release_get publish.candidate)" || return 1
  prefix="${tmpl%%\{*}"
  [ -n "$prefix" ] && [ "$prefix" != "$tmpl" ] || return 1
  printf 'refs/heads/%s\n' "$prefix"
}

# The ref pairs git hands a pre-push hook on stdin, one per ref:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# MOVED counts the refs this push creates or moves, CANDIDATES those of them
# under the candidate prefix, and DELETED the refs it deletes. A deletion moves
# no tree. By hand there are no pairs, and the push is taken to be the release
# push.
MOVED=0
CANDIDATES=0
DELETED=0
if [ ! -t 0 ]; then
  prefix=""
  while read -r _lref lsha rref _rsha; do
    [ -n "${lsha:-}" ] || continue
    # An all-zero sha is git's "this ref does not exist", matched by shape so
    # sha256 repositories read the same.
    case "$lsha" in
      *[!0]*) ;;
      *)
        DELETED=$((DELETED + 1))
        continue
        ;;
    esac
    MOVED=$((MOVED + 1))
    if [ -z "$prefix" ]; then
      prefix="$(candidate_prefix)" ||
        die "release.publish.candidate cannot be read as a ref prefix, so this push cannot be told from the release push -- refusing rather than guessing"
    fi
    case "$rref" in
      "$prefix"*) CANDIDATES=$((CANDIDATES + 1)) ;;
    esac
  done
fi

if [ "$MOVED" -gt 0 ] && [ "$CANDIDATES" -eq "$MOVED" ]; then
  printf 'prepush: this push moves only candidate refs, which the cut'"'"'s legs judge -- no currency verdict asked (F2)\n'
  exit 0
fi

# A PUSH THAT ONLY DELETES SENDS NO COMMIT (issue 0683). Every pair it hands the
# hook carries an all-zero local sha, so it publishes no tree, and the pair's
# currency says nothing about it. The frozen check above still applies to it,
# because deleting a ref on a frozen remote is still a write to that remote,
# and a push that moves any ref as well is judged whole below.
if [ "$DELETED" -gt 0 ] && [ "$MOVED" -eq 0 ]; then
  printf 'prepush: ok -- this push only deletes remote refs and sends no commit, so no currency verdict is asked\n'
  exit 0
fi

# ---------------------------------------------------------------------------
# A STALE DELIVERED PAIR IS REFUSED HERE (issue 0518, hv decision 30).
#
# `~/.local/bin/intent` is a symlink into `RELEASE_DIR`, so what every estate on
# this machine runs is whatever `bin/devbin build all` last wrote there, and a
# landing under `native/rust/` changes none of it. On 2026-09-22 two judged and
# landed fixes (0509, 0513) ran nowhere for hours while the pre-commit gate
# printed `currency REFUSING` on every commit and nobody acted on it. A REPORT
# ALREADY EXISTED AND FAILED; this moves the same verdict to where it refuses.
#
# WHY PUSH (hv's ruling, not a default). A push is hv's own hand and a batch
# boundary, so one `build all` covers every Rust change since the last push and
# the refusal reaches the person who can act on it. At COMMIT it would force a
# heavy rebuild with no dry run between every bank and its landing; a wrapper on
# the symlink would put a check in front of every invocation in every estate,
# the session hooks included.
#
# THE VERDICT IS `artefact_currency_verdict`, NOT A SECOND STALENESS TEST. Its
# range is the pair's commit to HEAD over the marker's build-input scope, so a
# whiteboard-only push over a source-clean range passes, and a whiteboard-only
# push over a pair that is provably behind REFUSES -- the push's own contents
# are not the question; whether the pair describes what is being published is.
#
# WARN PASSES, PRINTED. The one `warn:` a present git gives is a `dirty-` marker
# over a source-clean range, which `currency.lib` calls uncleartable at exec
# time. At push it would be clearable only by a rebuild from a tree clean under
# the whole dirt scope, and this checkout is shared by several nodes and is
# almost never that. A refusal nobody can discharge gets `--no-verify`d, which
# disarms the REFUSE rows with it. The other `warn:` is no git, which is a fact
# about the environment and not the pair.
#
# THE PUSH ITSELF IS NOT THE QUESTION: a push with no native/ change is asked
# too, because a stale pair is exactly as stale then.
currency="$(artefact_currency_verdict "$RELEASE_DIR" "$ROOT")"
case "$currency" in
  ok) ;;
  warn:*)
    printf 'prepush: currency WARN (target/release) -- %s\n' "${currency#warn:}" >&2
    ;;
  refuse:*)
    printf '\nBLOCKED: the delivered pair under native/rust/target/release does not describe this tree.\n\n  %s\n\n' "${currency#refuse:}" >&2
    # A rebuild fixes a stale marker and cannot fix a pair `strings` could not
    # read; that refusal names its own remedy, as it does in `cmd/cli`.
    case "$currency" in
      "refuse:${ARTEFACT_CURRENCY_UNREAD}"*) ;;
      *) printf '  remedy: bin/devbin build all   (rebuilds and verifies the pair; then push again)\n\n' >&2 ;;
    esac
    exit 1
    ;;
  *)
    die "unrecognised currency verdict '$currency' -- refusing rather than guessing"
    ;;
esac

printf 'prepush: the push gates pass\n'
exit 0
