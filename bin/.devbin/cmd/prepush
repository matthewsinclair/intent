#!/usr/bin/env bash
#
# devbin: summary = Clone what you are about to push and build it (post-move check)
#
# intent prepush [--force] -- clone THIS repository at HEAD into a temp dir and
# build it, to check that the artefact a stranger receives is coherent.
# Invoked by .git/hooks/pre-push; safe to run by hand.
#
# THE FAILURE THIS EXISTS FOR, and it is not hypothetical. On 2026-08-15 a
# commit titled "all native code moves to native/rust/" committed 58 additions
# and left 55 files plus three root build files at HEAD, then pushed to both
# remotes. Five of the duplicated files were DIVERGENT rather than
# stale-identical, and the root Cargo.toml still pointed a workspace at the
# stale copy -- so a fresh clone would have built a second implementation
# nobody knew existed.
#
# Every local instrument was green throughout: 234 tests, fmt, clippy, lint, six
# acceptance gates. None of them could have caught it, and that is the point
# rather than an oversight. `--only` commits the paths you NAME and a rename is
# TWO index entries; name the addition and the deletion stays staged. The
# working tree was correct. Only the repository was wrong.
#
# **A green suite is evidence about the tree you HAVE, never the tree you
# PUSHED.** The only instrument that can tell the difference is one that reads
# the repository rather than the working tree, which means cloning it.
#
# WHY PRE-PUSH AND NOT PRE-COMMIT OR CI. Measured 2026-08-15: a depth-1 local
# clone plus a cold `cargo build --workspace --bins` is ~16s. That is too slow
# to sit in front of every commit -- and a slow gate gets --no-verify'd, which
# is cry-wolf arriving through a different door. CI does clone fresh, but it is
# path-filtered and it reports AFTER the push has already landed on remotes;
# this failure's whole cost is that the bad state is public. Push is the moment
# the repository stops being private to one machine, so push is where the check
# belongs.
#
# PATH-TRIGGERED for the same reason. The failure class is a move or a
# restructure of native code and build files. A whiteboard-only push -- which is
# most pushes on this project -- cannot produce it, and charging those 16s would
# guarantee the gate gets bypassed. Sound rather than a fudge: the build cannot
# break unless something the build reads has changed.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
. "$DEVBIN_LIB/helpers"

ROOT="${PROJECT_ROOT:?}"

# git calls a pre-push hook as `<hook> <remote-name> <remote-url>`, so the two
# positional arguments are the DESTINATION and everything else is a flag. By
# hand there is no destination and `--force` may be the only argument, so the
# parse cannot be positional.
FORCE=0
REMOTE=""
REMOTE_URL=""
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    -*) ;; # unknown flags ignored, as before
    *)
      if [ -z "$REMOTE" ]; then
        REMOTE="$arg"
      elif [ -z "$REMOTE_URL" ]; then
        REMOTE_URL="$arg"
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# FROZEN REMOTES -- refuse a push to a remote the hypervisor has closed.
#
# LIFTED 2026-08-20 by hv, and the list is empty. The freeze existed from
# 2026-08-16 because every push to `upstream` triggers the GitHub workflows and
# the CI/CD budget had been hit. hv, lifting it: "All I wanted was to not push
# to upstream so as not to trigger a CI/CD run given the GitHub budget was
# exhausted. It doesn't matter now, as the runs just failed immediately."
#
# The mechanism stays because `int build release` consumes `--list-frozen` and
# an empty list is the correct answer to "what is frozen". Add a remote name
# here to close one again; that is the whole interface.
#
# ONE NOTE FROM hv WORTH KEEPING, because it is about this file rather than
# about the freeze: "I don't know why we have this formal/technical freeze like
# that. All I wanted was to not push to upstream." The intent was one sentence
# and it acquired a gate, a URL matcher, an escape hatch, a second consumer and
# forty lines of reasoning. Matching by URL as well as by name was load-bearing;
# the rest was a simple instruction growing a mechanism around itself. Worth
# reading before the next control gets built here.
FROZEN_REMOTES=""

# DECLARED ONCE, CONSUMED TWICE -- the same arrangement `precommit --list-guards`
# uses, and for the same reason. `int build release` pushes to every remote and
# must refuse BEFORE it tags rather than dying at the push with a tag already
# cut; it needs this list to do that, and a second copy of the list in the
# release orchestrator is two homes for one fact. The runner that enforces the
# rule is the authority on what the rule is; everyone else asks.
if [ "${1:-}" = "--list-frozen" ]; then
  for frozen in $FROZEN_REMOTES; do printf '%s\n' "$frozen"; done
  exit 0
fi

if [ -n "$REMOTE" ] && [ -z "${INTENT_ALLOW_FROZEN_PUSH:-}" ]; then
  for frozen in $FROZEN_REMOTES; do
    frozen_url="$(git -C "$ROOT" config --get "remote.$frozen.url" 2>/dev/null || true)"
    hit=0
    [ "$REMOTE" = "$frozen" ] && hit=1
    if [ -n "$frozen_url" ]; then
      [ "$REMOTE" = "$frozen_url" ] && hit=1
      [ "$REMOTE_URL" = "$frozen_url" ] && hit=1
    fi
    [ "$hit" -eq 1 ] || continue
    cat >&2 <<EOF

BLOCKED: '$frozen' is a FROZEN remote and this push would reach it.

  hv closed it on 2026-08-16: the CI/CD budget has been hit, and every push
  to '$frozen' triggers the workflows that spend it.

  Push 'local' instead -- it is a Dropbox path, it costs nothing, and it is
  where this estate's work has been landing since the freeze:

      git push local main

  The two remotes are EXPECTED to diverge while this holds. That is not a
  fault to chase, and comparing them will report a difference every time.

  If hv has lifted the freeze, delete '$frozen' from FROZEN_REMOTES in
  bin/.devbin/cmd/prepush and commit it -- the lift belongs in the history
  beside the freeze.

  To push once without lifting it:

      INTENT_ALLOW_FROZEN_PUSH=1 git push $frozen main

EOF
    exit 1
  done
fi

# What is about to be pushed -- and "about to be pushed" is a property of THIS
# PUSH, not of the tracked remote.
#
# THE DEFECT THIS REPLACES, measured by cc 2026-08-15: the gate printed
# `no native/ or build-manifest change in this push` on a push whose diff was 14
# files under `native/` and `schema/`. The grep was fine. The RANGE was wrong.
#
# The old computation was `git diff --name-only @{upstream}...HEAD`, and
# `@{upstream}` names exactly ONE remote -- `upstream/main` here. **This hook
# fires for a push to EITHER remote, and this project's standing instruction is
# to push both.** So the moment `git push upstream main` succeeds, `upstream/main`
# IS HEAD, and the `git push local main` that follows carries every one of those
# commits while computing an EMPTY range and opening the gate. **The second push
# of the standard two-push sequence has been ungated by construction**, and it
# failed in the direction nobody watches: quietly, with a confident message,
# saying the true thing about the wrong question.
#
# A pre-push hook is handed the ref pairs on stdin, one per ref:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# `<remote sha>` is what THAT remote currently holds for the ref, so it yields a
# range that is per-push and per-remote **without needing to know which remote it
# is** -- so the RANGE needs no argv even though the DESTINATION check above
# does. Two questions, two sources: stdin says what is moving, argv says where
# to. (The hook did not forward argv at all until the frozen-remote check needed
# it; `int hooks --install` now writes `bin/int prepush "$@"` and converges an
# older line that does not.)
#
# `|| true` and the FORCE fallbacks throughout: a new branch, a shallow history,
# a sha the remote has and we do not, no remotes at all -- every one is a
# legitimate state, and under `set -e` any of them would abort the gate rather
# than let it decide. **Where a range cannot be computed honestly, pay for the
# check.** An expensive right answer beats a cheap wrong one at the boundary this
# gate exists to protect.
CHANGED=""
pairs=0

# NOT a pipeline: `CHANGED` and `pairs` must survive the loop, and `cmd | while`
# would run the body in a subshell and discard both.
if [ ! -t 0 ]; then
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] || continue
    pairs=$((pairs + 1))
    # An all-zero sha is git's "this ref does not exist". Matched by shape
    # rather than against a 40-character literal, so sha256 repositories read
    # the same.
    case "$lsha" in
      *[!0]*) ;;
      *) continue ;; # deleting a ref pushes no tree, so nothing can fail to build
    esac
    case "$rsha" in
      *[!0]*)
        # The remote has this ref. If we cannot resolve its sha locally the
        # remote holds history we do not -- git will reject the push anyway, but
        # a gate that guesses at that moment is worse than one that checks.
        if git -C "$ROOT" cat-file -e "$rsha" 2>/dev/null; then
          CHANGED="$CHANGED
$(git -C "$ROOT" diff --name-only "$rsha"..."$lsha" 2>/dev/null || true)"
        else
          FORCE=1
        fi
        ;;
      *)
        # New ref on this remote: every commit is arriving, and there is no
        # bounded range to compute. Check.
        FORCE=1
        ;;
    esac
  done
fi

# NAMED, NOT SILENT. `pairs > 0` means git invoked this as a hook, so a missing
# REMOTE means the hook line did not forward argv -- an older `.git/hooks/pre-push`
# from before that generator changed. The frozen-remote check above then does
# NOTHING, and it does nothing in the shape that looks exactly like passing.
# .git/hooks is never tracked, so this is the normal state of every clone until
# someone re-runs the installer, and a guard that is quietly inactive in most
# clones is worse than one that was never written.
if [ "$pairs" -gt 0 ] && [ -z "$REMOTE" ]; then
  warn "this clone's pre-push hook does not forward argv, so the frozen-remote check is INACTIVE."
  warn "  fix: bin/int hooks --install   (rewrites the line to \`bin/int prepush \"\$@\"\`)"
fi

if [ "$pairs" -eq 0 ]; then
  # Run by hand rather than as a hook. "What would go if I pushed now" has a
  # DIFFERENT ANSWER PER REMOTE, so answer for the remote that is furthest
  # behind: the union across all of them. Under-reporting is the entire failure
  # this change is about, and a by-hand run that answers for one remote would
  # reintroduce it wearing a different name.
  branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  remotes="$(git -C "$ROOT" remote 2>/dev/null || true)"
  if [ -z "$remotes" ] || [ -z "$branch" ] || [ "$branch" = HEAD ]; then
    FORCE=1
  else
    for r in $remotes; do
      if git -C "$ROOT" rev-parse --verify --quiet "refs/remotes/$r/$branch" >/dev/null 2>&1; then
        CHANGED="$CHANGED
$(git -C "$ROOT" diff --name-only "refs/remotes/$r/$branch"...HEAD 2>/dev/null || true)"
      else
        # This remote has never seen the branch: pushing there sends everything.
        FORCE=1
      fi
    done
  fi
fi

if [ "$FORCE" -eq 0 ]; then
  # The build's inputs: the native tree and anything that tells cargo where the
  # workspace is. Anchored on `native/` and root manifests rather than a longer
  # prefix, because a prefix needle stops matching the moment the prefix moves
  # and then passes in SILENCE -- which is exactly how the tree moved twice in
  # one morning without the tooling noticing.
  if ! printf '%s\n' "$CHANGED" | grep -qE '^(native/|Cargo\.(toml|lock)$|rust-toolchain)'; then
    printf 'prepush: no native/ or build-manifest change in this push -- clone check not needed.\n'
    exit 0
  fi
fi

command -v cargo >/dev/null 2>&1 || die "cargo not on PATH -- cannot verify the clone builds"

TMP="$(mktemp -d)" || die "cannot create a temp dir"
# shellcheck disable=SC2064
trap "rm -rf '$TMP'" EXIT

step "prepush: cloning HEAD -- reading the repository, not the working tree"
git clone --quiet --depth 1 "file://$ROOT" "$TMP/clone" \
  || die "the repository does not clone -- that is the finding; do not push"

# Structural check first: it is instant, and it names the specific failure that
# actually happened rather than leaving it to be inferred from a build error.
manifests="$(find "$TMP/clone" -name Cargo.toml -not -path '*/crates/*' | sort)"
count="$(printf '%s\n' "$manifests" | grep -c . || true)"
if [ "$count" -ne 1 ]; then
  printf '\n' >&2
  printf 'prepush: expected exactly ONE cargo workspace manifest outside crates/, found %s:\n' "$count" >&2
  printf '%s\n' "$manifests" >&2
  die "a duplicated or stray workspace is the half-committed-move signature -- do not push"
fi

step "prepush: building the clone (cold, no shared target dir)"
workspace="$(dirname "$manifests")"
( cd "$workspace" && cargo build --workspace --bins ) \
  || die "the pushed repository does not build -- your working tree does, which is the whole point of this check"

# A build that produces nothing runnable is a green that means nothing, so the
# binaries are executed rather than merely tested for existence.
built=0
for b in "$workspace"/target/debug/*; do
  [ -x "$b" ] && [ ! -d "$b" ] || continue
  case "$(basename "$b")" in
    *.d | *.rlib) continue ;;
  esac
  if "$b" --version >/dev/null 2>&1; then
    printf '    ok: %s runs from a fresh clone\n' "$(basename "$b")"
    built=$((built + 1))
  fi
done
[ "$built" -gt 0 ] || die "the clone built but produced no runnable binary"

# THE TWO CHECKS THAT EXISTED WITH NOTHING DISPATCHING THEM, AND THEY COST TWO
# CI REDS IN ONE DAY (dc, 2026-08-20).
#
# `int check format` and `int check clippy` are both DECLARED in
# `bin/.devbin/config.yaml` and neither had a trigger. Nineteen `rustfmt`
# divergences accumulated across four days because nobody pushed, and a needless
# borrow reached HEAD because no local gate ran clippy. **A check nothing
# dispatches is indistinguishable from a check that passes** -- the same
# sentence this file's own `--list-guards` doctrine is built on.
#
# **THE OBSTACLE THAT KEPT THEM UNBUILT WAS REAL AND IT DOES NOT APPLY HERE.**
# Both are workspace-wide, so in the SHARED checkout they would refuse on a
# peer's half-finished file -- four nodes write to this tree, and a gate that
# fails on somebody else's work is one that gets bypassed the first afternoon.
# **This clone is the one workspace in the estate with a single writer.** It is
# a `git clone --local` of the pushed revision: nobody's uncommitted work is in
# it, and it is exactly the tree CI compiles.
#
# AND IT IS THE RIGHT MOMENT, NOT MERELY A SAFE ONE. Both failures were
# discovered on `upstream`, at push time, by CI. The gate that catches them is a
# push gate; running them per-commit would pay the cost on every commit to catch
# a fault that can only escape on a push.
#
# COST, MEASURED AT `c4aba380` ON ONE MACHINE AND STATED WITH ITS CONDITIONS
# BECAUSE IT IS LOAD-DEPENDENT: `fmt --check` is 0.42s and compiles nothing;
# `clippy --all-targets` is 15.4s ON TOP OF a build that had just completed --
# it re-checks the test targets `--bins` does not build. The same build measured
# 41s under concurrent load from other nodes and 18s idle, so these are not
# constants and a figure quoted without its conditions would be the third wrong
# number this estate has had from that habit.
#
# FORMAT BEFORE CLIPPY, DELIBERATELY: formatting cannot be affected by lints and
# is nearly free, so the cheap refusal comes first and an operator with both
# faults is not made to wait 15s to learn about the 0.4s one.
step "prepush: format and lints over the clone (workspace-wide is safe here -- one writer)"
if ! ( cd "$workspace" && cargo fmt --all --check ) ; then
  die "the pushed repository is not formatted -- run \`rustfmt --edition 2024 <your files>\` on the paths you touched (never \`cargo fmt --all\` in the shared tree: it would rewrite a peer's uncommitted work)"
fi
printf '    ok: rustfmt is clean over the pushed revision\n'
if ! ( cd "$workspace" && cargo clippy --workspace --all-targets -- -D warnings ) ; then
  die "clippy refuses the pushed repository -- fix the lints above, or justify them with a scoped #[allow] naming the reason"
fi
printf '    ok: clippy is clean under -D warnings over the pushed revision\n'

printf 'prepush: the repository you are about to push clones, builds, runs (%s binaries), and is format- and lint-clean.\n' "$built"
exit 0
