#!/usr/bin/env bash
#
# bin/.devbin/cut/stamp <step> -- one derived step of Intent's cut.
#
# Declared in bin/.devbin/config.yaml as `commands.stamp`, one option per step,
# and listed in `release.derived` in the order below, so devbin's release core
# runs each as `bin/devbin stamp <step>` inside its stamp step: after its own
# `version set` has written VERSION and the version sidecar
# (native/rust/Cargo.toml), and before it dates the note and commits.
#
# THE CONTRACT WITH THE CORE. Each step reads the version being cut from the
# version file, writes the release's files in its own scope, and prints on
# STDOUT the paths in that scope that differ from HEAD, one a line, relative to
# the project root. The core adds them to the paths the release owns, commits
# everything dirty as "release: <tag>", and refuses dirt outside that set. A
# step prints its scope's paths rather than this run's writes because the core
# runs every derived step again when a stopped cut is run again: a path the
# first run wrote must be named by the second. Everything else a step says goes
# to STDERR, and a refusal exits 1 naming what it found and the remedy.
#
# MOVED FROM THE RETIRED DRIVER, cmd/build.d/release, with ST0091 WP-01, in the
# driver's order but one: the lock comes before the schema. The driver blessed
# the schema first, and `cargo test` refreshes the lock itself, so the driver's
# snapshot of the lock was taken after cargo had refreshed it. The lock step
# here judges the refreshed lock against HEAD's, which the order cannot hide.
#
#   config    intent_version in intent/.config/config.json
#   lock      native/rust/Cargo.lock in step with the manifest's version
#   schema    the published faces under schema/, regenerated
#   cli       the CLI built at the version being cut; prints nothing, as
#             target/ is ignored
#   agents    AGENTS.md, regenerated by that CLI
#   upgrade   CLAUDE.md, refreshed by that CLI's canon engine
#   views     every realised view re-rendered by that CLI, where only its
#             footer changed
set -euo pipefail

: "${PROJECT_ROOT:?run this as bin/devbin stamp <step>, which exports the project root}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR source=../cmd/shared/releasestamp.lib
. "$here/../cmd/shared/releasestamp.lib"

STEP="${1:-}"
NATIVE_DIR="$PROJECT_ROOT/$(dirname "$NATIVE_MANIFEST_REL")"
AGAIN="then run the same cut again, and the stamp continues"

# A scratch directory for the step that needs one, removed on the way out
# unless a step has said its contents must be kept.
WORK=""
trap '[ -z "$WORK" ] || rm -rf "$WORK"' EXIT

say() { printf 'stamp %s: %s\n' "$STEP" "$1" >&2; }

# refuse <what> [<remedy>] -- the step's refusal, exit 1.
refuse() {
  printf 'error: stamp %s: %s\n' "$STEP" "$1" >&2
  [ -z "${2:-}" ] || printf '  remedy: %s\n' "$2" >&2
  exit 1
}

# scope_dirt <pathspec>... -- what the step prints: its scope's paths that
# differ from HEAD.
scope_dirt() {
  release_scope_dirt "$PROJECT_ROOT" "$@" ||
    refuse "git could not list the paths that differ from HEAD under $*"
}

target_version() {
  release_version_file "$PROJECT_ROOT" || exit 1
}

step_config() {
  local v rc=0
  v="$(target_version)"
  (cd "$PROJECT_ROOT" && stamp_project_version "$v" "$CONFIG_REL") || rc=$?
  case "$rc" in
    0) say "intent_version is now $v in $CONFIG_REL" ;;
    1) say "$CONFIG_REL already carries $v" ;;
    *) refuse "could not write intent_version $v into $CONFIG_REL" \
      "check that $CONFIG_REL is JSON and that jq is on PATH, $AGAIN" ;;
  esac
  scope_dirt "$CONFIG_REL"
}

# restore_lock <copy> -- puts back the lock this step found, so a refusal leaves
# the tree as the step met it. A copy that cannot be put back is kept, and said.
restore_lock() {
  if ! cp "$1" "$PROJECT_ROOT/$NATIVE_LOCK_REL"; then
    say "could not restore $NATIVE_LOCK_REL; the copy this step found is kept at $1"
    WORK=""
  fi
}

# THE LOCK IS THE STAMP'S TO BRING IN STEP. devbin's `version set` writes the
# manifest through project.version_sidecars and refuses a lockfile by name, and
# the core syncs a lock only where project.version_from is a Cargo.toml, which
# Intent's is not. Cargo rewrites the lock, never this script: a hand-kept list
# of members missed `intentd` the first time it ran. And the change is bounded:
# only workspace members' versions may move, judged against HEAD's lock, so a
# dependency change cannot ride the commit the tag points at.
step_lock() {
  local head_lock found out unexpected
  WORK="$(mktemp -d)" || refuse "could not make a scratch directory"
  head_lock="$WORK/head.lock"
  found="$WORK/found.lock"
  git -C "$PROJECT_ROOT" --no-optional-locks show "HEAD:$NATIVE_LOCK_REL" >"$head_lock" ||
    refuse "could not read $NATIVE_LOCK_REL at HEAD"
  cp "$PROJECT_ROOT/$NATIVE_LOCK_REL" "$found" ||
    refuse "could not keep a copy of $NATIVE_LOCK_REL to restore"

  # No --locked: the point is to let cargo rewrite the lock. Not --offline
  # either: the lock names targets this machine never builds, and --offline
  # fails on those with an error that reads like an inconsistent lockfile.
  if ! out="$(cd "$NATIVE_DIR" && cargo metadata --format-version 1 2>&1 >/dev/null)"; then
    restore_lock "$found"
    printf '%s\n' "$out" >&2
    refuse "cargo could not refresh $NATIVE_LOCK_REL (its output is above)" \
      "fix what it names, $AGAIN"
  fi
  # A non-zero return is "could not look", never "nothing changed".
  if ! unexpected="$(lock_nonmember_changes "$head_lock" "$PROJECT_ROOT/$NATIVE_LOCK_REL")"; then
    restore_lock "$found"
    refuse "could not read the packages or the workspace members out of $NATIVE_LOCK_REL, so nothing says what changed" \
      "read the lock by hand; a lock cargo wrote parses, so this is a defect in lock_packages or lock_members"
  fi
  if [ -n "$unexpected" ]; then
    restore_lock "$found"
    refuse "refreshing $NATIVE_LOCK_REL moves packages that are not workspace members:
$(printf '%s\n' "$unexpected" | sed 's/^/  /')" \
      "bring the dependency change in on a commit of its own, $AGAIN"
  fi
  say "$NATIVE_LOCK_REL is in step, and only workspace members moved"
  scope_dirt "$NATIVE_LOCK_REL"
}

# THE FACES ARE REGENERATED BY THEIR OWN GENERATOR AND THEN READ. `faces.rs`
# stamps the compiled version, so `version set` makes every committed face
# stale: the v3.0.1 tag shipped that. The bless test is the faces' one
# regeneration path, and a generator that ran is not a face that says the
# right thing, so the files are read after it.
step_schema() {
  local v out stale
  v="$(target_version)"
  if ! out="$(cd "$NATIVE_DIR" && INTENT_BLESS=1 cargo test -p intentsvcs schema_faces_drift 2>&1)"; then
    printf '%s\n' "$out" >&2
    refuse "could not regenerate the schema faces for $v (cargo's output is above)" \
      "fix what it names, $AGAIN"
  fi
  stale="$(schema_faces_version_blockers "$PROJECT_ROOT" "$v")"
  [ -z "$stale" ] ||
    refuse "the published schema faces do not carry $v after regenerating them:
${stale}  the generator ran and the files disagree with it" \
      "find why the bless test wrote another version; do not cut until it writes $v"
  say "the schema faces carry $v"
  scope_dirt schema
}

# The CLI the next three steps render with (issue 0387): a rendered file names
# the version of the binary that rendered it, so it is built at the version
# being cut. A debug build, into the target the schema step compiled.
step_cli() {
  local v out
  v="$(target_version)"
  if ! out="$(cd "$NATIVE_DIR" && cargo build -p intent-cli --bin intent 2>&1)"; then
    printf '%s\n' "$out" >&2
    refuse "could not build the CLI at $v (cargo's output is above)" \
      "fix what it names, $AGAIN"
  fi
  release_stamp_cli "$PROJECT_ROOT" "$v" >/dev/null || exit 1
  say "the stamp CLI reports $v"
}

# A FAILED REGENERATION LEAVES AGENTS.md UNCHANGED, and no check of dirt can see
# a file that did not change, so the exit status is read, never trusted to a
# later check: AGENTS.md naming the previous version in a tagged release is the
# inconsistency the sidecars exist to prevent.
step_agents() {
  local v cli out
  v="$(target_version)"
  cli="$(release_stamp_cli "$PROJECT_ROOT" "$v")" || exit 1
  out="$(cd "$PROJECT_ROOT" && "$cli" agents sync 2>&1)" || {
    printf '%s\n' "$out" >&2
    refuse "intent agents sync failed, so AGENTS.md was not regenerated (its output is above)" \
      "fix what it names, $AGAIN"
  }
  say "AGENTS.md regenerated at $v"
  scope_dirt AGENTS.md
}

# CLAUDE.md IS DELEGATED TO THE CANON ENGINE THAT OWNS IT, as AGENTS.md is to
# `agents sync`, and `--apply` re-provisions everything the engine owns, of
# which only CLAUDE.md and AGENTS.md are the release's. A write outside them is
# refused: a release restamps a version, it does not re-provision a project.
# The writes are read either side of the engine, so a path an earlier step or
# an earlier run left dirty is not taken for one of the engine's.
step_upgrade() {
  local v cli out before after p spill=""
  v="$(target_version)"
  cli="$(release_stamp_cli "$PROJECT_ROOT" "$v")" || exit 1
  before="$(release_dirty_marks "$PROJECT_ROOT")" ||
    refuse "git could not read the tree before the canon engine ran"
  out="$(cd "$PROJECT_ROOT" && "$cli" claude upgrade --apply 2>&1)" || {
    printf '%s\n' "$out" >&2
    refuse "intent claude upgrade --apply failed, so CLAUDE.md was not refreshed (its output is above)" \
      "fix what it names, $AGAIN"
  }
  after="$(release_dirty_marks "$PROJECT_ROOT")" ||
    refuse "git could not read the tree after the canon engine ran"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    release_is_sidecar "$p" || spill+="  $p"$'\n'
  done <<<"$(release_marks_changed "$before" "$after")"
  [ -z "$spill" ] ||
    refuse "intent claude upgrade --apply wrote files that are not the release's:
${spill}  \`bin/devbin preflight spill\` refuses this before anything is stamped" \
      "they now hold canon: commit them on their own (git commit --only -- <the files above>), $AGAIN"
  say "CLAUDE.md refreshed at $v"
  scope_dirt CLAUDE.md AGENTS.md
}

# THE VIEWS NAME THE VERSION OF THE BINARY THAT RENDERED THEM (issue 0387), so
# every realised view is re-rendered with the stamp CLI, and a view whose change
# is its footer alone folds into the release commit, as release_stamp_only
# recognises it at the push. Any other path that differs from HEAD and is not
# one of the release's files is refused: a view that changes beyond its footer
# is a tree out of step with its store, and anything else is dirt the release
# does not own. Intent's note is CHANGELOG.md (notes.kind changelog, which
# generates no views), so every path the core owns is a sidecar and is skipped.
step_views() {
  local v cli out paths p diff folded="" other=""
  v="$(target_version)"
  cli="$(release_stamp_cli "$PROJECT_ROOT" "$v")" || exit 1
  out="$(cd "$PROJECT_ROOT" && "$cli" sync --to-disk 2>&1)" || {
    printf '%s\n' "$out" >&2
    refuse "intent sync --to-disk failed, so the views were not re-rendered at $v (its output is above)" \
      "fix what it names, $AGAIN"
  }
  paths="$(release_scope_dirt "$PROJECT_ROOT" .)" ||
    refuse "git could not list the paths that differ from HEAD"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    release_is_sidecar "$p" && continue
    diff="$(git -C "$PROJECT_ROOT" --no-optional-locks diff -U0 HEAD -- "$p")" ||
      refuse "git could not read the change to $p"
    if printf '%s\n' "$diff" | footer_only; then
      folded+="$p"$'\n'
    else
      other+="  $p"$'\n'
    fi
  done <<<"$paths"
  [ -z "$other" ] ||
    refuse "these differ from HEAD by more than a view's footer, and are not the release's files:
${other}  a view that changes beyond its footer is a tree out of step with its store" \
      "a view now holds what the store says: commit it on its own (git commit --only -- <path>); anything else, commit it or set it aside; $AGAIN"
  say "the realised views are rendered at $v"
  printf '%s' "$folded"
}

case "$STEP" in
  config | lock | schema | cli | agents | upgrade | views) "step_$STEP" ;;
  *)
    printf 'error: stamp: no step %s -- one of config, lock, schema, cli, agents, upgrade, views\n' "${STEP:-(none)}" >&2
    exit 2
    ;;
esac
