#!/usr/bin/env bash
#
# devbin -- the unified dev launcher.
#
# Thin dispatcher: resolve the project root, load the config, route <command> to
# its handler (IN-AG-THIN-COORD-001). Everything it decides lives in lib/resolve;
# everything it reads lives in lib/config. No business logic here.
#
# This is the fold of four byte-identical launchers -- Conflab, Lamplight, Baize
# and Laksa each carried the same 53 lines differing only in the project name.
# That name now comes from bin/.devbin/config.yaml, which is the whole point.
#
# See `bin/devbin help` for the command surface.
#
set -euo pipefail

# THE FLOOR (issue 0022, reversing design D9). devbin requires bash >= 5 and
# REFUSES older: macOS ships /bin/bash 3.2.57 permanently (GPLv3), the fleet
# runs a Homebrew bash 5.x everywhere, and the guarantee now points at what
# actually runs. This block must stay parseable by bash 3.2 -- the refusal
# cannot be allowed to arrive as a syntax error that explains nothing.
if [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  printf 'devbin: bash >= 5 is required; this is bash %s (%s)\n' \
    "${BASH_VERSION:-unknown}" "${BASH:-unknown}" >&2
  printf '  macOS ships bash 3.2 permanently -- install a current one:  brew install bash\n' >&2
  printf '  (issue 0022, reversing design D9, 2026-08-24)\n' >&2
  exit 1
fi

# Resolve this script's real location (symlink-safe) into BIN_DIR and the
# project root, so the launcher works from any CWD and through a symlink on
# PATH. A surviving `bin/<alias> -> devbin` lands here too; `bin/<prj> -> devbin`
# is retired and any still on disk is a project's to remove.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" >/dev/null 2>&1 && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in
    /*) ;;
    *) _self="$_dir/$_self" ;;
  esac
done
BIN_DIR="$(cd -P "$(dirname "$_self")" >/dev/null 2>&1 && pwd)"
PROJECT_ROOT="$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"
DEVBIN_DIR="$BIN_DIR/.devbin"
unset _self _dir

# The runtime is normally vendored into the project at bin/.devbin/lib. The
# fallback to the checkout's own lib/ is what lets Devbin run ITSELF from its
# repo without installing into itself (design D12) -- the dogfooding case.
if [ -d "$DEVBIN_DIR/lib" ]; then
  DEVBIN_LIB="$DEVBIN_DIR/lib"
elif [ -d "$PROJECT_ROOT/lib" ]; then
  DEVBIN_LIB="$PROJECT_ROOT/lib"
else
  printf 'devbin: cannot find the devbin runtime (looked in %s and %s)\n' \
    "$DEVBIN_DIR/lib" "$PROJECT_ROOT/lib" >&2
  exit 1
fi
export BIN_DIR PROJECT_ROOT DEVBIN_DIR DEVBIN_LIB

# ---- THE TREE A RUN IS ABOUT IS THE TREE YOU ARE STANDING IN ---------------
#
# PROJECT_ROOT above is derived ENTIRELY from this script's own location and
# never from the caller's directory. That is right for finding the runtime and
# catastrophic as an answer to "which project is this run about": a devbin
# reached through PATH, or through any link outside its own tree, runs against
# ITS OWN project from wherever you happen to be standing -- and every command
# then cds to that root (lib/resolve, lib/gatecmd).
#
# MEASURED 2026-08-27, and the help listing was the harmless half. Standing in
# a project with no devbin installed, a bare `devbin` resolved through PATH to
# a DIFFERENT estate's launcher and printed that estate's catalogue at rc 0.
# The same resolution puts `clean --force` -- which walks PROJECT_ROOT with
# `find` -- on a tree the caller never named and cannot see in the output.
#
# `install` IS THE ONE EXEMPTION, and it is exempt by definition rather than by
# concession: its target is `--into <dir>`, defaulting to the CURRENT
# directory, so acting outside its own tree is the entire job. Every other
# command writes to or reports on PROJECT_ROOT -- `upgrade` and `vendor`
# included, whose `--from` names a SOURCE and not a target. Reading that `--from`
# as a target is what first sized this guard at four exemptions, so it is
# written down here rather than left to be re-derived.
#
# NO ENVIRONMENT VARIABLE TURNS THIS OFF. A flag that disables a safety check is
# a flag anything can set, and the suite is fixed by standing in the project
# (tests/lib/test_helper.bash: devbin_run) rather than by an escape hatch.
case "${1:-}" in
  # TWO EXEMPTIONS, BOTH BY DEFINITION RATHER THAN BY CONCESSION.
  #   install     -- its target is `--into <dir>`, defaulting to the CURRENT
  #                  directory, so acting outside its own tree IS the job.
  #   shell-init  -- emits a static shell function to stdout. It reads nothing
  #                  from PROJECT_ROOT and writes nothing, and it is run from a
  #                  shell rc where the cwd is $HOME by definition.
  # Everything else writes to or reports on PROJECT_ROOT, `upgrade` and `vendor`
  # included -- their `--from` names a SOURCE, not a target.
  install | shell-init) _devbin_wrong_tree_check=no ;;
  *) _devbin_wrong_tree_check=yes ;;
esac
if [ "$_devbin_wrong_tree_check" = yes ]; then
  _devbin_cwd="$(pwd -P 2>/dev/null || pwd)"
  case "$_devbin_cwd" in
    "$PROJECT_ROOT" | "$PROJECT_ROOT"/*) ;;
    *)
      {
        printf 'devbin: refusing to run -- this is not your current project.\n\n'
        # THE ARGUMENT IS NAMED FIRST, AND IT IS NOT DECORATION (issue 0039).
        # This guard runs BEFORE command resolution, so it cannot know whether
        # what it was given is a command at all -- and it was telling callers
        # their LOCATION was wrong when their VERB was. hv typed `init`, which
        # devbin does not have, and got a refusal about paths. Echoing the word
        # back lets the reader spot their own typo without this guard needing to
        # resolve it, which is the whole reason it can run this early.
        printf '  you asked for:          %s\n' "${1:-(no command)}"
        printf '  you are standing in:    %s\n' "$_devbin_cwd"
        printf '  this devbin belongs to: %s\n' "$PROJECT_ROOT"
        printf '  it was reached as:      %s\n\n' "$0"
        printf 'Every command would act on %s, not on where you are.\n' "$PROJECT_ROOT"
        printf 'Run that project'"'"'s own bin/devbin, or cd into it first.\n'
      } >&2
      # 4, NOT 2. This dispatcher already exits 2 for an unknown command and 3
      # elsewhere, and 18 assertions in the suite turn on that 2 -- so a guard
      # sharing it would let a test asserting a usage refusal be satisfied by a
      # WRONG-TREE refusal instead. Different refusals need different codes or
      # the green stops naming its own cause.
      exit 4
      ;;
  esac
  unset _devbin_cwd
fi
unset _devbin_wrong_tree_check

# shellcheck source=lib/helpers
. "$DEVBIN_LIB/helpers"
# shellcheck source=lib/config
. "$DEVBIN_LIB/config"
# shellcheck source=lib/builtins
. "$DEVBIN_LIB/builtins"
# shellcheck source=lib/runlog
. "$DEVBIN_LIB/runlog"
# shellcheck source=lib/resolve
. "$DEVBIN_LIB/resolve"
# shellcheck source=lib/help
. "$DEVBIN_LIB/help"

[ -f "$DEVBIN_DIR/config.yaml" ] || die "no config at $DEVBIN_DIR/config.yaml (try: devbin install)"
cfg_load "$DEVBIN_DIR/config.yaml" || exit 1

# THE REFERENT (issue 0049, consumer-filed). `project.referent` names a command
# the PROJECT owns; devbin runs it once, here, and exports its stdout for
# `print_run_referent` to echo beside every verdict. Declare nothing and nothing
# changes -- which is every consumer that has not asked for this.
#
# WHY A DECLARED COMMAND RATHER THAN A VARIABLE THE PROJECT SETS. There is no
# earlier project-owned place to set one: this file is DEVBIN'S, and a consumer
# that edits it to export a variable has forked the dispatcher in order to add a
# feature. That is not hypothetical -- it is what the consumer who raised this
# did, and their own manifest check caught it inside the hour, on a file they had
# checked the ownership of and then edited a different one. `config.yaml` and
# `cmd/` belong to the project, so a command named in config and living in `cmd/`
# is entirely theirs and the vendored tree stays stock.
#
# DEVBIN STILL NEVER PARSES THE STRING. It learns that the project HAS a command
# naming its referent; it does not learn what a referent is. `git rev-parse` is
# one project's answer, and devbin must remain unable to tell that answer from a
# build id or a hostname -- see print_run_referent for why that is the design and
# not a preference.
#
# COMPOSED AT PROCESS START, which is run start for every gate this invocation
# goes on to run. Read later it would describe the tree the verdict was PRINTED
# against rather than the one measured, and those diverge in exactly the
# situation this exists for.
#
# ABSENT IS NOT CLEAN, so a declared-but-failing composer is LOUD rather than
# empty: empty is indistinguishable from a project that never declared one, so a
# broken composer would silently restore the unreferenced verdict this closes.
# Fail-open on the run -- a referent must never be able to stop a gate.
#
# YES, THIS IS AN `eval`, AND IT IS A DECISION RATHER THAN AN OVERSIGHT. devbin
# executes a string the project wrote, which is the class the consumer who raised
# this had already eliminated from its own config reader. What makes it sound is
# the SOURCE and not the string: config.yaml is project-owned committed source,
# exactly as trusted as `cmd/`, and anyone who can write this key can already
# write `cmd/anything` and name it from a `run:` line. There is no privilege here
# to escalate to.
#
# `eval` rather than `run:`'s word-split because a referent is a VALUE COMPOSER
# and a pipeline is its natural spelling. `run:` refuses eval for a reason that
# does not reach this line: a gate command line needing real quoting needs a
# handler, so the gate stays legible. A one-shot substitution has no verdict to
# keep legible.
#
# THE LINE THIS MUST NEVER CROSS IS THE ONE ABOVE: eval-ing the COMMAND is not
# parsing the ANSWER. The moment devbin can tell a sha from a hostname, the layer
# ruling has been reversed by implementation rather than by decision, and nothing
# in a diff would say so.
_devbin_referent_cmd="$(cfg_get project.referent "")"
if [ -n "$_devbin_referent_cmd" ]; then
  DEVBIN_RUN_REFERENT="$(cd "$PROJECT_ROOT" && eval "$_devbin_referent_cmd" 2>/dev/null)" ||
    DEVBIN_RUN_REFERENT=""
  # SC2089/SC2090 fire on the single quotes inside the message below, on the
  # theory that a variable holding quotes is about to be run as a command. This
  # one is a DIAGNOSTIC STRING -- printed by print_run_referent and never
  # expanded, never eval'd -- so the quotes are exactly as literal as shellcheck
  # warns they are, which is the intent. Suppressed rather than reworded because
  # the quotes name a config key and `config.reference.yaml` documents this
  # message verbatim; dropping them to satisfy the linter would silence it by
  # making the docs wrong.
  # Two directives rather than one list: a directive covers the NEXT command
  # only, and the assignment and the export are two of them.
  # shellcheck disable=SC2089
  [ -n "$DEVBIN_RUN_REFERENT" ] ||
    DEVBIN_RUN_REFERENT="REFERENT UNAVAILABLE -- 'project.referent' is declared and did not answer"
  # shellcheck disable=SC2090
  export DEVBIN_RUN_REFERENT
fi
unset _devbin_referent_cmd

# Identity comes from config, never from $0. That is what lets a project keep a
# short alias -- bin/cf, a soft local convention pointing DIRECT at this file --
# while `conflab -v` still says conflab. The project-named form (bin/conflab) is
# retired: it shadowed the product binary these projects now build.
DEVBIN_NAME="$(cfg_get project.name devbin)"
# The mix task the `cli` and `repl` built-ins call, defaulting to the
# derivation that held for the whole first fleet. The Arca pair is why it is
# configurable at all: arca_config's task is `arca.config` and arca_cli's is
# `arca.cli`, so `<name>.cli` names a task neither project has.
#
# EXPORTED rather than looked up, because lib/helpers reads no config by rule
# (D15) and a handler is a separate process -- the same reason DEVBIN_NAME
# crosses this way. One derivation, here, read by both built-ins.
#
# `cli` alone could have used a `run:` override, which is what arca_config did.
# `repl` could not: its built-in carries the rlwrap wiring, and overriding the
# whole command line to change one word throws away history and completion. A
# difference of one NAME should not cost a project the handler.
DEVBIN_CLI_TASK="$(cfg_get project.cli_task "$DEVBIN_NAME.cli")"
export DEVBIN_CLI_TASK
PROJECT_ROOT_VAR="$(cfg_get project.root_var)"
if [ -z "$PROJECT_ROOT_VAR" ]; then
  PROJECT_ROOT_VAR="$(upper_snake "$DEVBIN_NAME")_ROOT"
  # Validated AFTER derivation, not before: it is the derived name that gets
  # exported, and `project.name` is legal in shapes `upper_snake` maps to an
  # illegal one -- `my proj` becomes `MY PROJ_ROOT`. Checking the input would
  # pass exactly the case that breaks.
  assert_identifier "$PROJECT_ROOT_VAR" \
    "project.name gives the root variable '$PROJECT_ROOT_VAR', which"
else
  assert_identifier "$PROJECT_ROOT_VAR" "project.root_var in $DEVBIN_DIR/config.yaml"
fi
export DEVBIN_NAME DEVBIN_INVOKE
# Exported under the project's own name so handlers ported from the corpus keep
# reading the variable they already expect (CONFLAB_ROOT, LAKSA_ROOT, ...).
# The assignment form of export, not eval: the config supplies the NAME here, so
# eval would let a config file that can name a variable also run code.
export "$PROJECT_ROOT_VAR=$PROJECT_ROOT"

# Where read_version looks. Exported because handlers get it from lib/helpers,
# which cannot read config (see the layering note in that file).
DEVBIN_VERSION_FILE="$(cfg_get project.version_from VERSION)"
export DEVBIN_VERSION_FILE

# The files that MIRROR the version, newline-separated. Exported for the same
# reason as the line above: lib/cmd/version is a separate process and cannot
# read config. Config names the files; lib/cmd/version holds the recipe for
# rewriting each kind, which is the D1 split `read_version` already follows.
DEVBIN_VERSION_SIDECARS="$(
  cfg_list project.version_sidecars | while IFS= read -r i; do
    [ -n "$i" ] && cfg_get "project.version_sidecars.$i"
  done
)"
export DEVBIN_VERSION_SIDECARS

# What the project IS, for handlers that must act per declared language. Same
# reason as the two blocks above: lib/cmd/check is a separate process sourcing
# gatecmd, which brings helpers, builtins and runlog and deliberately NOT
# config or resolve -- so `project_speaks` is not reachable from a gate handler.
#
# `check format` needs it: the formatter has one arm per language and the gate
# has to verify each arm the project actually declares (issue 0003). Derived by
# project_languages (lib/resolve), the same derivation project_speaks reads --
# one source, per Highlander (delta review, finding 11).
DEVBIN_LANGUAGES="$(project_languages)"
export DEVBIN_LANGUAGES

# How `check format` may treat each declared language's fmt arm, computed here
# because the gate handler cannot read config (same reason as every export
# above) and the catalogue is only HALF the answer: config can switch an arm
# off (`enabled: false`) or replace what it runs (`run:`), and a gate deriving
# its check from the catalogue alone then verifies a command line the
# formatter no longer runs -- same name, same green, different fact (delta
# review, findings 5 and 10). Languages with no fmt arm anywhere get no entry.
#
#   <lang>=builtin      the catalogue governs; the gate derives the check form
#   <lang>=overridden   config replaces `fmt <lang>`; the gate cannot derive
#   <lang>=disabled     the project switched the arm off; the gate skips it
DEVBIN_FMT_ARMS="$(
  for _dl in $DEVBIN_LANGUAGES; do
    builtin_has_default_run fmt "$_dl" || option_declared fmt "$_dl" || continue
    if ! option_active fmt "$_dl"; then
      printf '%s=disabled ' "$_dl"
    elif [ -n "$(cfg_get "commands.fmt.options.$_dl.run")" ]; then
      printf '%s=overridden ' "$_dl"
    else
      printf '%s=builtin ' "$_dl"
    fi
  done
)"
export DEVBIN_FMT_ARMS


# THE VENDORED RUNTIME MAY HAVE MOVED ON. Once a day, on a terminal only, to
# stderr, never fatal -- see devbin_update_notice in lib/helpers for why each of
# those four is load-bearing. Placed here so it precedes every command including
# help, and after config so DEVBIN_NAME is set for the remediation line.
devbin_update_notice "$PROJECT_ROOT"

[ $# -eq 0 ] && {
  help_main
  exit 0
}

command="$1"
shift

# Help is answered HERE, before parse_common_opts, and that is deliberate rather
# than an ordering accident: asking for help must not be able to fail on a bad
# shared-option value, because help is what a person reaches for when they got
# the value wrong. `devbin help --env nope` prints help.
#
# Its own flags and topics are help's to parse (lib/help), not the dispatcher's.
case "$command" in
  -h | --help | help)
    help_main "$@"
    exit $?
    ;;
  -v | --version)
    # The bare call IS the point: no argument selects the version-file role.
    # shellcheck disable=SC2119
    printf '%s %s\n' "$DEVBIN_NAME" "$(read_version)"
    exit 0
    ;;
esac

# Shared options are parsed ONCE, here, and exported. In the corpus every
# command script called parse_common_opts itself -- eleven call sites per
# project, forty-odd across the four. Handlers are separate processes, so the
# exports reach them anyway and none of them needs to parse again; what a
# handler receives on its command line is only what devbin did not recognise.
parse_common_opts "$command" "$@"
# Guarded expansion: a bash 3.2 idiom (an empty array under `set -u` aborted
# there; design D9, since reversed by issue 0022). Harmless under the >= 5
# floor and kept. See parse_common_opts in lib/resolve.
set -- "${DEVBIN_ARGS[@]+"${DEVBIN_ARGS[@]}"}"

# The ACTIVE option set for THE COMMAND BEING RUN, for its own usage line
# (issue 0007, option 1). The catalogue is the MENU; what resolves here is
# decided by activation (the D11 language axis, config enabled:, declared
# options), and command_options IS that derivation -- the same list `all` fans
# over and the global help renders. It needs config + resolve, which a gate
# handler deliberately cannot source, so the dispatcher exports the result.
#
# ONE DERIVATION, NOT SIX, AND COMPUTED AFTER THE COMMAND IS KNOWN. This block
# used to sit above, deriving all six gate commands' sets on every invocation --
# `check`, `clean`, `db`, `docs`, `fmt` and `test` -- before the dispatcher had
# even read which command was asked for. MEASURED at 80 to 180 ms EACH on an
# idle machine, so roughly 800 ms of every single `bin/<prj> <anything>`, in
# every consuming project, to compute five answers nothing would ever read:
# lib/gatecmd is the only reader and it reads exactly one, its own.
#
# Adding `clean` is what made it worth measuring rather than assuming -- a
# seventh row on a list that was already the most expensive thing in startup.
case "$command" in
  check | clean | db | docs | fmt | test)
    printf -v _devbin_active_var 'DEVBIN_ACTIVE_%s' "$(upper_snake "$command")"
    printf -v "$_devbin_active_var" '%s' "$(command_options "$command" | tr '\n' ' ')"
    export "${_devbin_active_var?}"
    unset _devbin_active_var
    ;;
esac

command_active "$command" || {
  # Distinguish "never heard of it" from "switched off here". A command that is
  # silently absent is indistinguishable from one that is broken, and the second
  # message saves the reader a trip through the config (D11).
  if reason="$(command_unavailable_reason "$command")"; then
    warn "'$DEVBIN_INVOKE $command' is not available here: $reason"
  elif cfg_has "commands.$command.enabled" || [ -n "$(cfg_list "commands.$command")" ]; then
    warn "command '$command' is not active in this project (see: $DEVBIN_INVOKE help)"
  else
    warn "unknown command: $command (try: $DEVBIN_INVOKE help)"
  fi
  exit 2
}

# `all` is synthesised (D8) over the options devbin can see -- config-declared
# ones compose with a project handler (each dispatches INTO it), so a handler
# command with declared options keeps the sweep, and `all` stays reserved
# there: a sub-handler named all cannot thin it out (AC-04.13). But a total
# shadow that declares NO options owns its whole argument list (D2, AC-04.4),
# `all` included -- `which all` and `docs all` are real corpus invocations
# whose meaning lives in the handler (WP-10). Only that shape falls through.
if [ "${1:-}" = all ]; then
  if ! has_project_handler "$command" || [ -n "$(command_options "$command")" ]; then
    shift
    run_all "$command" "$@"
    exit $?
  fi
fi

# A declared option routes through run_option so the declarative and handler
# shapes stay one path. Anything else goes straight to the handler.
if [ $# -gt 0 ] && option_declared "$command" "$1"; then
  opt="$1"
  shift
  if ! option_active "$command" "$opt"; then
    # The same explanation an UNdeclared inactive option gets, below. Splitting
    # these produced two different answers to one question: a declared-then-
    # disabled option said "is not active in this project" and exited 1, while
    # an identical built-in said "it is disabled in <file>" and exited 2. D11
    # asks for deactivation to be visible, and visible has to mean the same
    # thing wherever the option came from.
    if reason="$(option_unavailable_reason "$command" "$opt")"; then
      warn "'$DEVBIN_INVOKE $command $opt' is not available here: $reason"
    else
      warn "option '$command $opt' is not active in this project"
    fi
    exit 2
  fi
  run_option "$command" "$opt" "$@"
  exit $?
fi

# Before handing an unrecognised option to the handler, check whether devbin
# itself deactivated it. Falling through would report a shipped built-in as an
# unknown option, which reads as a typo rather than as configuration (D11).
if [ $# -gt 0 ]; then
  if reason="$(option_unavailable_reason "$command" "$1")"; then
    warn "'$DEVBIN_INVOKE $command $1' is not available here: $reason"
    exit 2
  fi
fi

# A PROJECT handler shadows totally (D2, AC-04.4), so it is the only thing
# resolved here. Everything else -- config's own `run:`, devbin's own lib/cmd
# handler, the catalogue default -- is run_command's, in that order.
#
# The split matters. Resolving lib/cmd/<command> here as well put devbin's OWN
# handler ahead of the project's `run:`, which is backwards and is exactly the
# bug that bit run_option: a built-in swallowed something config plainly
# declared. One order, expressed once, at both levels.
if has_project_handler "$command"; then
  handler="$(resolve_handler "$command")" || die "no runnable handler for '$command'"
  # The handler is a separate process and `$0` is its own path, which for a
  # config-mapped handler is not the command name -- bin/.devbin/cmd/myls serving
  # `ls` would otherwise have no way to know it was called as `ls`. Telling it
  # explicitly costs one export and keeps identity coming from the dispatcher
  # rather than from a filename, which is the same rule D2 applies to the
  # project name.
  export DEVBIN_COMMAND="$command"
  exec_handler "$handler" "$@"
fi

run_command "$command" "$@"
exit $?
