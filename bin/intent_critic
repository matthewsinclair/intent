#!/bin/bash
# intent_critic -- Headless critic runner for Intent rule library (ST0035/WP-05)
# Copyright (c) 2026 Matthew Sinclair
# Licensed under the MIT License (see LICENSE file)
#
# Usage:
#   intent critic <lang> [options]
#
# Options:
#   --files <path> ...     Explicit list of files to scan.
#   --staged               Scan files in git staging area (for pre-commit).
#   --severity-min <lvl>   critical | warning (default) | recommendation | style.
#   --format text|json     Output format. Default: text.
#   --rules <dir>          Alternative rules directory. Default: canon.
#   -h, --help             Show this help.
#
# Exit codes:
#   0  no findings at or above threshold
#   1  findings at or above threshold
#   2  invocation error

set -u

# ---- Bootstrap ----
_intent_critic_self="${BASH_SOURCE[0]}"
while [ -L "$_intent_critic_self" ]; do
  _intent_critic_self="$(readlink "$_intent_critic_self")"
done
BIN_DIR="$(cd "$(dirname "$_intent_critic_self")" && pwd)"
INTENT_ROOT="$(cd "$BIN_DIR/.." && pwd)"
: "${INTENT_HOME:=$INTENT_ROOT}"
export INTENT_HOME
unset _intent_critic_self

source "$INTENT_ROOT/intent/plugins/claude/lib/critic_runner.sh"

# ---- CLI ----

print_help() {
  cat <<'EOF'
intent critic <lang> [options]

Run Intent rule-library critics against source files without invoking an LLM.
Mechanical subset only: rules that publish a Greppable proxy are enforced.
Richer review is available via `Task(subagent_type="critic-<lang>")`.

Positional:
  <lang>                 elixir | rust | swift | lua | shell
                         author | content are accepted as a clean no-op: prose
                         critique is on-demand via the critic-prose subagent,
                         not this headless runner.

Options:
  --files <path> ...     Explicit file list. Default: scan nothing unless --staged.
  --staged               Scan files in git staging area (pre-commit mode).
  --severity-min <lvl>   Minimum severity to report. Default: warning.
                         Levels: critical, warning, recommendation, style.
  --format text|json     Output format. Default: text.
  --rules <dir>          Alternative rules root (overrides canon discovery).
  --languages            List the languages with a headless code critic (one
                         per line) and exit. Consumed by the pre-commit gate to
                         skip prose / on-demand languages so the two cannot drift.
  -h, --help             Show this help.

Exit codes:
  0  no findings at or above threshold
  1  findings at or above threshold
  2  invocation error

Examples:
  intent critic elixir --files lib/foo.ex test/foo_test.exs
  intent critic elixir --staged
  intent critic shell --files bin/intent --format json
  intent critic elixir --staged --severity-min critical
EOF
}

# ---- Arg parsing ----

LANG=""
FILES=()
STAGED=0
SEVERITY_MIN="warning"
FORMAT="text"
RULES_DIR=""

error_out() {
  printf 'error: %s\n' "$1" >&2
  exit 2
}

# Positional language first
if [ $# -eq 0 ]; then
  print_help
  exit 2
fi

case "$1" in
  -h|--help)
    print_help
    exit 0
    ;;
  --languages)
    # Emit the languages that have a headless CODE critic, one per line. The
    # pre-commit gate consults this so the accepted set lives in one place and
    # the gate cannot drift from this CLI's own validation (issue 0003).
    critic_code_languages
    exit 0
    ;;
  agnostic)
    LANG="$1"
    shift
    ;;
  *)
    if critic_is_code_language "$1"; then
      LANG="$1"
      shift
    elif critic_is_prose_language "$1"; then
      # author / content have no mechanical critic -- their rules are LLM
      # judgement applied by the critic-prose subagent (Task) over prose files.
      # A headless run is a clean no-op, not an argument error, so the
      # pre-commit gate never trips on a declared prose language (issue 0003).
      printf 'ok: %s is a prose discipline; critique is on-demand via the critic-prose subagent (Task), not the headless runner -- nothing to do.\n' "$1"
      exit 0
    else
      code_list="$(critic_code_languages | tr '\n' ' ')"; code_list="${code_list% }"
      prose_list="$(critic_prose_languages | tr '\n' ' ')"; prose_list="${prose_list% }"
      error_out "first argument must be a language ($code_list) or a prose discipline ($prose_list)"
    fi
    ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --files)
      shift
      while [ $# -gt 0 ] && [[ "$1" != --* ]]; do
        FILES+=("$1")
        shift
      done
      ;;
    --staged)
      STAGED=1
      shift
      ;;
    --severity-min)
      SEVERITY_MIN="$2"
      shift 2
      ;;
    --format)
      FORMAT="$2"
      shift 2
      ;;
    --rules)
      RULES_DIR="$2"
      shift 2
      ;;
    -h|--help)
      print_help
      exit 0
      ;;
    *)
      error_out "unknown flag '$1' (try --help)"
      ;;
  esac
done

case "$SEVERITY_MIN" in
  critical|warning|recommendation|style) ;;
  *) error_out "invalid --severity-min '$SEVERITY_MIN' (expected critical|warning|recommendation|style)" ;;
esac

case "$FORMAT" in
  text|json) ;;
  *) error_out "invalid --format '$FORMAT' (expected text|json)" ;;
esac

# Override CANON_RULES_ROOT if --rules was given
if [ -n "$RULES_DIR" ]; then
  [ -d "$RULES_DIR" ] || error_out "rules directory does not exist: $RULES_DIR"
  CANON_RULES_ROOT="$RULES_DIR"
fi

# Resolve staged files if --staged
if [ "$STAGED" -eq 1 ]; then
  if ! command -v git >/dev/null 2>&1; then
    error_out "--staged requires git"
  fi
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    error_out "--staged must be run inside a git repository"
  fi
  staged_list="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
  if [ -n "$staged_list" ]; then
    # Filter by language extension
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      [ -f "$f" ] || continue
      case "$LANG:$f" in
        elixir:*.ex|elixir:*.exs)                      FILES+=("$f") ;;
        rust:*.rs)                                     FILES+=("$f") ;;
        swift:*.swift)                                 FILES+=("$f") ;;
        lua:*.lua)                                     FILES+=("$f") ;;
        shell:*.sh|shell:*.bash|shell:*.zsh)           FILES+=("$f") ;;
        shell:*)
          # Include shell files without extension but with a shell shebang
          if head -n1 "$f" 2>/dev/null | grep -qE '^#![[:space:]]*(/[^[:space:]]+/)?(bash|zsh|sh)([[:space:]]|$)'; then
            FILES+=("$f")
          fi
          ;;
      esac
    done <<< "$staged_list"
  fi
fi

if [ "${#FILES[@]}" -eq 0 ]; then
  if [ "$STAGED" -eq 1 ]; then
    printf 'ok: no staged %s files to scan\n' "$LANG"
    exit 0
  fi
  error_out "no files specified (use --files <path> ... or --staged)"
fi

# ---- Locate project config ----

PROJECT_ROOT="$(find_project_root 2>/dev/null || true)"
CRITIC_CONFIG=""
if [ -n "$PROJECT_ROOT" ] && [ -f "$PROJECT_ROOT/.intent_critic.yml" ]; then
  CRITIC_CONFIG="$PROJECT_ROOT/.intent_critic.yml"
fi

# ---- Run ----

min_rank="$(critic_severity_rank "$SEVERITY_MIN")"

findings="$(
  critic_scan_files "$LANG" "$CRITIC_CONFIG" "${FILES[@]}" \
    | critic_filter_severity "$min_rank"
)"

# ---- Arming census: what could NOT be asked, said out loud, every run ----
# vc's ruling 2026-08-18: reporting is unconditional and costs zero fleet
# breakage, because reporting is not refusing. Without this, `critic shell`
# returns rc=0 having asked nothing of six rules and prints the same sentence
# as `critic elixir` after asking nine -- the gate cannot distinguish CHECKED
# AND CLEAN from CHECKED NOTHING, which is IN-AG-NO-SILENT-001 in the library.
#
# WHAT IS ENUMERATED IS THE GAP, NOT THE COVERAGE. `declared` is a decision on
# record, so it is counted; `undeclared` and `unrunnable` are rules nobody has
# ruled on, so they are NAMED. Naming all of them would bury the verdict.
census="$(critic_arming_census "$LANG")"
if [ -z "$census" ]; then
  # AN EMPTY CENSUS IS A COULD-NOT-CHECK AND SAYS SO. Skipping quietly here
  # would reintroduce, in the reporting path, the exact silence this reporting
  # exists to end -- and it did: the first version wrapped the call in
  # `2>/dev/null`, so a missing helper produced an empty census and no report,
  # in the code written that same day about suppressed channels.
  printf 'critic: %s -- ARMING CENSUS UNAVAILABLE. This run cannot say which rules it was able to ask, so a clean result below is not evidence that anything was checked.\n' "$LANG" >&2
else
  # TWO AXES, so each count is read off the field that owns it. `grep -c
  # ' armed$'` was correct while a row was `<id> <state>` and became wrong the
  # moment a row grew a disposition -- an anchored pattern that silently returns
  # zero when the shape changes under it, which is the class this whole census
  # is about. Field tests cannot rot that way.
  c_total="$(printf '%s\n' "$census" | awk 'NF { n++ } END { print n + 0 }')"
  c_armed="$(printf '%s\n' "$census" | awk '$2 == "armed" { n++ } END { print n + 0 }')"
  c_decl="$(printf '%s\n' "$census" | awk '$2 == "declared" { n++ } END { print n + 0 }')"
  c_undecl="$(printf '%s\n' "$census" | awk '$2 == "undeclared" { n++ } END { print n + 0 }')"
  c_unrun="$(printf '%s\n' "$census" | awk '$2 == "unrunnable" { n++ } END { print n + 0 }')"
  c_ran="$(printf '%s\n' "$census" | awk '$3 == "ran" { n++ } END { print n + 0 }')"
  c_absent="$(printf '%s\n' "$census" | awk '$3 == "not-run:tool-absent" { n++ } END { print n + 0 }')"
  c_ooc="$(printf '%s\n' "$census" | awk '$3 == "not-run:out-of-context" { n++ } END { print n + 0 }')"
  c_quiet=$((c_decl + c_undecl + c_unrun))
  # json keeps stdout a parseable document; the census goes to stderr there.
  if [ "$FORMAT" = json ]; then c_fd=2; else c_fd=1; fi
  {
    # THE HEADLINE IS THE DISPOSITION, NOT THE ARMING. `armed` says something
    # COULD answer the rule; only `ran` says this invocation ASKED. Leading with
    # the arming count would report questions that were never put -- which is
    # this census's founding defect, one level up.
    printf 'critic: %s -- %d of %d rule(s) ASKED of this run; %d armed in total. A clean result covers what was ASKED and says nothing about the rest.\n' \
      "$LANG" "$c_ran" "$c_total" "$c_armed"
    if [ "$c_quiet" -gt 0 ]; then
      printf 'critic: %s -- %d rule(s) could not be armed at all: %d declared unanswerable, %d undeclared, %d with a proxy this runner must refuse.\n' \
        "$LANG" "$c_quiet" "$c_decl" "$c_undecl" "$c_unrun"
    fi
    if [ "$c_undecl" -gt 0 ]; then
      printf 'critic: %s -- UNDECLARED, nobody has recorded whether these are mechanically checkable: %s\n' \
        "$LANG" "$(printf '%s\n' "$census" | awk '$2 == "undeclared" { printf "%s ", $1 }')"
    fi
    if [ "$c_unrun" -gt 0 ]; then
      printf 'critic: %s -- UNRUNNABLE proxy, present but outside the runner contract: %s\n' \
        "$LANG" "$(printf '%s\n' "$census" | awk '$2 == "unrunnable" { printf "%s ", $1 }')"
    fi
    # ARMED AND NOT ASKED -- the second axis, and the reason it exists. These
    # rules are enforceable; this run did not enforce them, and saying which is
    # the difference between an honest gate and a quiet one.
    if [ "$c_ooc" -gt 0 ]; then
      printf 'critic: %s -- ARMED but NOT RUN HERE, the tool does not belong in this context (a whole-workspace analyser is not a per-file gate): %s\n' \
        "$LANG" "$(printf '%s\n' "$census" | awk '$3 == "not-run:out-of-context" { printf "%s(%s) ", $1, $4 }')"
    fi
    if [ "$c_absent" -gt 0 ]; then
      printf 'critic: %s -- ARMED but NOT RUN HERE, THE TOOL IS ABSENT ON THIS MACHINE. These rules are UNENFORCED and a clean result below does not cover them: %s\n' \
        "$LANG" "$(printf '%s\n' "$census" | awk '$3 == "not-run:tool-absent" { printf "%s(%s) ", $1, $4 }')"
      # THIS IS THE REFUSAL, AND IT LANDED WITH THE HOOK'S BRANCH IN ONE COMMIT
      # (dc 2026-08-19, hv approved), which is the condition this block recorded
      # for itself and declined to act on until it was met. AC-07.4 rules that a
      # tool-armed rule REFUSES when its tool is absent on a project that armed
      # it. Until now the hook's `*)` fail-opened on every rc that was not 0 or 1,
      # so emitting a new code first would have put a THIRD condition in a bucket
      # already conflating two -- on purpose, which is worse than the accident.
      # `lib/templates/hooks/pre-commit.sh` now reads 3 as a refusal and BLOCKS.
      #
      # WHY 3 AND NOT 2. 2 is the invocation error and it fails OPEN, correctly:
      # a gate that blocks every commit because the gate itself is broken is
      # issue 0043 on the git side. A refusal is the other kind of fact -- the
      # project armed a rule and this machine cannot honour it -- and it has two
      # ordinary remedies the developer owns. **A gate fails open on its own
      # breakage and closed on yours**, and one exit code cannot say both.
      CRITIC_REFUSED=1
    fi
  } >&$c_fd
fi

if [ -z "$findings" ]; then
  case "$FORMAT" in
    json) echo "[]" ;;
    text) printf 'ok: no %s findings at severity >= %s across %d file(s)\n' \
           "$LANG" "$SEVERITY_MIN" "${#FILES[@]}" ;;
  esac
  # A CLEAN RUN THAT REFUSED IS NOT A CLEAN RUN. The findings list is empty and
  # the coverage is not what the project asked for, so exiting 0 here would be
  # the exact sentence the census above prints in order to deny: a clean result
  # that does not cover what was armed.
  [ "${CRITIC_REFUSED:-0}" -eq 0 ] || exit 3
  exit 0
fi

case "$FORMAT" in
  text) printf '%s\n' "$findings" | critic_format_text ;;
  json) printf '%s\n' "$findings" | critic_format_json ;;
esac

# REFUSAL OUTRANKS FINDINGS, and the findings are printed either way above. Both
# codes block, so precedence changes no gate decision -- it changes what the
# caller is TOLD. "There are findings" is a complete account of the run only if
# nothing went unenforced, and here something did.
[ "${CRITIC_REFUSED:-0}" -eq 0 ] || exit 3
exit 1
