#!/usr/bin/env bash
#
# intent3 / intentd3 -- Intent v3 (native), reachable from any project here.
#
# ONE FILE, TWO NAMES. `intentd3` is a SYMLINK to this file and the binary is
# chosen from `$0`. Two wrappers differing by one word and sharing thirty lines
# of comment is how a fix lands in one and not the other; `bin/int` next door is
# already a symlink to the devbin dispatcher, so the idiom is this repo's own.
#
# WHY IT IS NOT NAMED `intent`. v3 installed as `intent` shadows v2 for every
# other Intent project on this machine in one move, and `INTENT_HOME` CANNOT
# STOP IT -- driven three ways (exported, unset, forced to a junk path), the v3
# binary answers the same every time, because that variable binds v2 only. The
# name is one of two locks; the other is v3's refusal of any project whose
# config declares a 2.x version, driven across five 2.x strings with a 3.0.0-dev
# positive control (vc).
#
# WHY THIS REPO'S `bin/` AND NOT `~/.local/bin`. This directory is already on
# the login PATH at position 22 -- verified in a fresh `zsh -lc`, not inherited
# from a session -- so a file here is reachable everywhere with NO machine-wide
# change and NO new binding registered anywhere. This estate's own record listed
# THREE `intent` bindings when there were FOUR, so a mechanism adding a fifth
# repeats the defect it exists to avoid.
#
# AND IT REVERSES AND SELF-RETIRES. Living in the checkout means the way back is
# the operation that reverts everything else -- `git checkout`, a branch without
# it, deleting the clone -- and a file in `~/.local/bin` outlives all three.
# `bin/` is the v2 shell tree WP-12 prunes at the cut, so this disappears
# exactly when `intent` itself becomes v3 and a separate name stops being wanted.
#
# THIS MUST STAY A WRAPPER THAT `exec`s INTO THE CHECKOUT. NEVER SHIP A COPY OF
# THE BINARY ONTO PATH, AND THE REASON IS NOT STYLE (ic, driven). v3's `claude
# hook` resolves its scripts through `install::home()`, which canonicalises
# `current_exe()` and walks its ANCESTORS for a directory holding
# `lib/templates/` (`install.rs:51,102-118`). An `exec` leaves `current_exe()`
# inside the checkout so the walk finds the marker; a bare `cp` onto PATH has no
# marker at or above it and every hook refuses.
#
# AND THAT REFUSAL FAILS OPEN, WHICH IS WHY THIS PARAGRAPH EXISTS.
# `.claude/settings.json` fires `claude hook require-in-session` on EVERY prompt
# in EVERY project, and Claude Code blocks only on exit 2. **That refusal is
# exit 1, so it does not block: the prompt proceeds and the strict /in-session
# gate silently stops enforcing, everywhere, at once.** SessionStart goes the
# same way. Nothing reports it and everything looks fine.
#
# MEASURED, BOTH ARMS, FROM OUTSIDE THE CHECKOUT:
#   this wrapper                   session-context/require-in-session/advisory  rc=0
#   a symlink to the release bin   rc=0 -- `resolve()` canonicalises before walking
#   a bare `cp` of the binary      rc=1 -- "cannot locate the Intent install ..."
# So a LINK is safe and a COPY is not. Homebrew's Cellar layout is safe for the
# same reason and is named in `resolve()`'s own comment.
#
# THIS WRAPPER REFUSES AN ARTEFACT THAT CANNOT BE SHOWN TO DESCRIBE THIS TREE
# (hv ruled 2026-08-24; the branch not taken was "keep it a reporter, warn but
# exec"). A REPORTER FAILS OPEN AND AN ACTOR REFUSES, and this is an ACTOR: it
# is on PATH, so what it execs is what the estate runs.
#
# THE MATRIX, THE COST MEASUREMENT AND THE REASONING LIVE IN
# `shared/currency.lib`, ONE HOME -- including the correction of the asserted
# "multi-second" figure this file used to carry as the reason not to check. Do
# not restate them here; a second copy is how the two stop agreeing.
#
# THE LIBS ARE A HARD DEPENDENCY WITH NO FALLBACK, DELIBERATELY (vc). A
# `source || define-my-own` restores the duplicate at exactly the moment nobody
# is watching, and the marker parser has already been four-homes-to-one once.
#
set -euo pipefail

self="$(basename "$0")"
case "$self" in
  intentd3) want=intentd ;;
  intent3) want=intent ;;
  # A third name would silently get the CLI. Refuse instead: an unknown name
  # means someone linked this to something nobody designed it to answer for.
  *) printf 'error: %s is not a name this wrapper answers to (intent3, intentd3)\n' "$self" >&2; exit 2 ;;
esac

# `BASH_SOURCE` and not `$0`: through a symlink `$0` is the LINK, which is what
# we want for the name above and exactly wrong for locating the checkout.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$here/../native/rust/target/release/$want"

if [ ! -x "$bin" ]; then
  printf 'error: no v3 %s binary at %s\n' "$want" "$bin" >&2
  printf "  remedy: run 'int local build' -- it forces a COHERENT pair and verifies it.\n" >&2
  printf '  Do NOT use a bare `cargo build --release`: it returns 0 over a pair built\n' >&2
  printf '  from two different trees, because `intentd` declares no dependencies and\n' >&2
  printf '  its build script therefore never re-runs.\n' >&2
  exit 1
fi

# The verdict is read BEFORE the exec, because after it this process is gone.
for lib in artefact currency; do
  libpath="$here/.devbin/cmd/shared/$lib.lib"
  if [ ! -r "$libpath" ]; then
    printf 'error: cannot read %s -- refusing to exec without the currency check\n' "$libpath" >&2
    printf '  This is a HARD dependency on purpose. A wrapper that silently drops\n' >&2
    printf '  its own guard when a file goes missing is worse than one with no guard.\n' >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$libpath"
done

verdict="$(artefact_currency_verdict "$here/../native/rust/target/release" "$here/..")"
case "$verdict" in
  ok) ;;
  warn:*)
    printf 'warning: %s\n' "${verdict#warn:}" >&2
    ;;
  refuse:*)
    printf 'error: %s\n' "${verdict#refuse:}" >&2
    printf "  remedy: run 'int local build' -- it rebuilds and verifies the SET.\n" >&2
    printf '  This refusal is the guard working. The binary really does not describe\n' >&2
    printf '  this tree, and a v3 answer from it would be about a tree you are not on.\n' >&2
    exit 1
    ;;
  *)
    printf 'error: currency.lib returned an unrecognised verdict: %s\n' "$verdict" >&2
    printf '  Refusing rather than guessing: an unknown verdict is not a pass.\n' >&2
    exit 1
    ;;
esac

exec "$bin" "$@"
