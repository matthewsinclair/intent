#!/bin/bash
# intent - Main command for Intent
# Copyright (c) 2026 Matthew Sinclair
# Licensed under the MIT License (see LICENSE file)
# Usage: intent <command> [options] [arguments]

# Exit on error
set -e

# Issue 0025: an inherited PROJECT_ROOT is not evidence of anything.
#
# It is a generic name, and a Makefile, direnv, CI or devbin (which exports it
# on every invocation) can all set it. Intent treats it as an answer -- some
# readers branch project-vs-global on nothing but its presence -- so an ambient
# value silently redirects work into a tree the user is not standing in.
#
# Clearing it here means anything downstream that sees it is seeing a value
# Intent resolved (resolve_project_root / load_intent_config), never one it was
# handed. That closes the class for the whole CLI at one line, including for
# readers nobody has written yet. INTENT_HOME is the supported way to point at
# a different tool tree, and it is untouched.
unset PROJECT_ROOT

# Determine INTENT_HOME early for version loading
# Resolve symlinks so INTENT_HOME works when invoked via symlink (e.g. ~/bin/intent)
if [ -z "$INTENT_HOME" ]; then
  _intent_self="${BASH_SOURCE[0]}"
  while [ -L "$_intent_self" ]; do
    _intent_self="$(readlink "$_intent_self")"
  done
  INTENT_HOME="$(cd "$(dirname "$_intent_self")/.." && pwd)"
  unset _intent_self
fi

# Source helpers for version function
if [ -f "$INTENT_HOME/bin/intent_helpers" ]; then
  source "$INTENT_HOME/bin/intent_helpers"
fi

# Get version from centralized source
INTENT_VERSION="$(get_intent_version)"

# Export INTENT_HOME
export INTENT_HOME

# Check if bin directory exists
if [ ! -d "$INTENT_HOME/bin" ]; then
  error "Invalid INTENT_HOME: bin directory not found at $INTENT_HOME/bin"
fi

# Set bin directory
BIN_DIR="$INTENT_HOME/bin"

# Define global commands that don't require project context
GLOBAL_COMMANDS="help doctor bootstrap init version info fileindex upgrade plugin ext lang"

# Function to check if command is global
is_global_command() {
  local cmd="$1"
  for gc in $GLOBAL_COMMANDS; do
    [ "$cmd" = "$gc" ] && return 0
  done
  return 1
}

# Display info if no arguments provided
if [ $# -eq 0 ]; then
  # Info is a global command, execute directly
  exec "$BIN_DIR/intent_info"
fi

# Get the command
COMMAND="$1"
shift

# Handle version flag
if [ "$COMMAND" = "--version" ] || [ "$COMMAND" = "-v" ] || [ "$COMMAND" = "version" ]; then
  echo "Intent version $INTENT_VERSION"
  exit 0
fi

# Handle help command specially
if [ "$COMMAND" = "help" ] || [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "-h" ]; then
  exec "$BIN_DIR/intent_help" "$@"
fi

# Handle plugin commands
PLUGIN_COMMAND=""
PLUGIN_SUBCOMMAND=""

# Check for plugin commands (claude, agents)
case "$COMMAND" in
  claude)
    # Claude plugin - check for subcommand
    if [ $# -ge 1 ] && [ "$1" = "subagents" ]; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="subagents"
      shift  # Remove 'subagents' from arguments
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_subagents"
    elif [ $# -ge 1 ] && [ "$1" = "skills" ]; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="skills"
      shift  # Remove 'skills' from arguments
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_skills"
    elif [ $# -ge 1 ] && [ "$1" = "upgrade" ]; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="upgrade"
      shift  # Remove 'upgrade' from arguments
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_upgrade"
    elif [ $# -ge 1 ] && [ "$1" = "prime" ]; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="prime"
      shift  # Remove 'prime' from arguments
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_prime"
    elif [ $# -ge 1 ] && [ "$1" = "rules" ]; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="rules"
      shift  # Remove 'rules' from arguments
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_rules"
    elif [ $# -ge 1 ] && [ "$1" = "hook" ]; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="hook"
      shift  # Remove 'hook'; the runner takes the hook name as $1
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_hook"
    elif [ $# -ge 1 ] && { [ "$1" = "start" ] || [ "$1" = "ws" ]; }; then
      PLUGIN_COMMAND="claude"
      PLUGIN_SUBCOMMAND="$1"
      # Do NOT shift: intent_claude_cwi's own dispatch consumes `start`/`ws`.
      COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/claude/bin/intent_claude_cwi"
    else
      error "Unknown claude subcommand. Try: intent claude subagents, intent claude skills, intent claude upgrade, intent claude prime, intent claude rules, intent claude start, intent claude ws"
    fi
    ;;
  agents)
    # AGENTS.md plugin
    PLUGIN_COMMAND="agents"
    COMMAND_SCRIPT="$INTENT_HOME/intent/plugins/agents/bin/intent_agents"
    ;;
  st)
    COMMAND="st"
    COMMAND_SCRIPT="intent_st"
    ;;
  wp)
    COMMAND="wp"
    COMMAND_SCRIPT="intent_wp"
    ;;
  ac)
    COMMAND="ac"
    COMMAND_SCRIPT="intent_acceptance"
    # Re-inject the noun so the shared module sees `ac` as $1.
    set -- "$COMMAND" "$@"
    ;;
  at)
    COMMAND="at"
    COMMAND_SCRIPT="intent_acceptance"
    # Re-inject the noun so the shared module sees `at` as $1.
    set -- "$COMMAND" "$@"
    ;;
  learn)
    COMMAND="learn"
    COMMAND_SCRIPT="intent_learn"
    ;;
  modules)
    COMMAND="modules"
    COMMAND_SCRIPT="intent_modules"
    ;;
  *)
    # Default: prefix with intent_
    COMMAND_SCRIPT="intent_$COMMAND"
    ;;
esac

# Check if command script exists
if [ -n "$PLUGIN_COMMAND" ]; then
  # For plugin commands, check plugin path
  if [ ! -f "$COMMAND_SCRIPT" ]; then
    error "Plugin command not found: $COMMAND_SCRIPT"
  fi
else
  # For regular commands, check bin directory
  if [ ! -f "$BIN_DIR/$COMMAND_SCRIPT" ]; then
    error "Unknown command '$COMMAND'. Run 'intent help' for usage information."
  fi
fi

# Check if script is executable
if [ -n "$PLUGIN_COMMAND" ]; then
  # For plugin commands
  if [ ! -x "$COMMAND_SCRIPT" ]; then
    echo "warning: making plugin script executable: $COMMAND_SCRIPT" >&2
    chmod +x "$COMMAND_SCRIPT"
  fi
else
  # For regular commands
  if [ ! -x "$BIN_DIR/$COMMAND_SCRIPT" ]; then
    echo "warning: making script executable: $COMMAND_SCRIPT" >&2
    chmod +x "$BIN_DIR/$COMMAND_SCRIPT"
  fi
fi

# Check if this is a global command or plugin command
if [ -n "$PLUGIN_COMMAND" ]; then
  # Plugin commands may have their own context requirements
  # Let the plugin handle it
  exec "$COMMAND_SCRIPT" "$@"
elif is_global_command "$COMMAND"; then
  # Execute without requiring project context
  exec "$BIN_DIR/$COMMAND_SCRIPT" "$@"
fi

# For project commands, source config and check for project root
if [ -f "$BIN_DIR/intent_config" ]; then
  source "$BIN_DIR/intent_config"
  # Load configuration
  load_intent_config
  
  # Check if we found a project root (check for empty or unset)
  if [ -z "${PROJECT_ROOT:-}" ] || [ "$PROJECT_ROOT" = "" ]; then
    echo "error: not in an Intent project directory" >&2
    echo "  '$COMMAND' requires an Intent project" >&2
    echo "  hint: intent init | intent help" >&2
    exit 1
  fi
else
  error "Missing intent_config library. Intent installation may be corrupted."
fi

# ---------------------------------------------------------------------------
# REFUSE A PROJECT FROM THE FUTURE.
#
# v2 already knew how to ask this question and asked it in exactly one place.
# `intent upgrade` has refused a downgrade since ST0043 -- "refusing downgrade:
# project is at v3.0.0, target is v2.19.0" -- while every command that WRITES
# ran happily against the same project. The knowledge existed; it could not be
# reached from here, because the comparator lived in intent_upgrade alone.
#
# MEASURED 2026-08-17 against a project declaring 3.0.0: `st new` created SEVEN
# files, `todo` wrote, `doctor` reported its own version and noticed nothing,
# and the shipped pre-commit gate then landed the commit. Under v3 the markdown
# is a GENERATED VIEW, so those writes land where the database has no row and
# the next regeneration discards them without a word.
#
# The asymmetry that made it urgent: v3 in a v2 project REFUSES, and v2 in a v3
# project OPERATED. The refusal existed in the direction that costs a user
# nothing and was absent in the direction that destroys their work.
#
# WHY HERE, AND WHY NOTHING IS ALLOWLISTED. This point is past every early exit
# the dispatcher already had -- `--version`, `help`, and the GLOBAL_COMMANDS
# exec above -- so `upgrade` keeps its own more specific refusal, and `doctor`
# and `info` stay readable on a project they cannot manage. Every exemption a
# hand-written list would have argued for is structural. It is also past
# load_intent_config, so the version is read from the resolved PROJECT_ROOT
# rather than from whatever directory the user happened to be standing in.
#
# EXIT 2, NOT 1, AND THE CODE IS THE POINT. A refusal to operate is not a
# failure of the operation. The shipped pre-commit gate declares exactly this
# split -- 0 clean, 1 findings at or above threshold BLOCK, 2 invocation error
# FAIL-OPEN -- so a project command refusing here fails that gate OPEN rather
# than reporting a migration state to the user as a code-quality finding.
# `error()` exits 1 and is therefore the wrong voice for this one thing.
#
# AND IT ASKS get_intent_version RATHER THAN READING $INTENT_VERSION, WHICH IS
# NOT A STYLE CHOICE. bin/intent_config:50 OVERWRITES INTENT_VERSION with the
# project's declared `intent_version` inside load_intent_config, which has run
# by this line. So the variable names the TOOL at bin/intent:41 and names the
# PROJECT from here on -- one identifier, two referents, switched silently and
# stated nowhere. The first version of this guard read it and compared 3.0.0
# against 3.0.0, so it never fired, and it never fired in the direction that
# looks like a clean pass. get_intent_version is THE fallback site and always
# answers for the install.
_project_version="$(detect_project_version "$PROJECT_ROOT" 2>/dev/null || true)"
_tool_version="$(get_intent_version)"
if [ -n "$_project_version" ] && version_gt "$_project_version" "$_tool_version"; then
  echo "error: this project declares Intent v$_project_version, and this is Intent v$_tool_version" >&2
  echo "  '$COMMAND' would write to a project built by a newer Intent than this one understands" >&2
  echo "  hint: use the Intent that matches the project, or check which 'intent' is on PATH" >&2
  exit 2
fi

# Preserve the invoker's working directory so subcommands that accept a path
# argument (treeindex, fileindex) can resolve relative paths correctly, then
# enter the project root so subcommands can safely use project-relative paths.
export INTENT_ORIG_CWD="$(pwd)"
cd "$PROJECT_ROOT" || { echo "error: cannot enter project root: $PROJECT_ROOT" >&2; exit 1; }

# Execute command with remaining arguments
if [ -n "$PLUGIN_COMMAND" ]; then
  exec "$COMMAND_SCRIPT" "$@"
else
  exec "$BIN_DIR/$COMMAND_SCRIPT" "$@"
fi