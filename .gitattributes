# GitHub's language bar (Linguist) labels the repository by bytes per language.
# Until 2026-09-25 this file opened with `* linguist-vendored`, from the 2023
# first commit, which took every file out of that count except the one HTML
# page intentd serves -- so a Rust project read as 100% HTML.
#
# The Elixir files are the rule library's examples (intent/plugins/claude/rules/
# elixir/), not Intent's own code.
*.ex linguist-vendored=true
*.exs linguist-vendored=true

# >>> devbin: line endings >>>
# Written by devbin install and kept by devbin upgrade, which replace
# what is between these two lines: the vendored runtime checks out with
# LF line endings on every machine, Windows included.
bin/devbin text=auto eol=lf
bin/.devbin/** text=auto eol=lf
# <<< devbin: line endings <<<

# >>> intent: hooks export-ignore >>>
# Written by `intent claude upgrade --apply` and kept by it, which replaces
# what is between these two lines: the commit gate's tracked dispatchers
# stay out of every release archive. A project that wants them there says
# so in a line of its own after this block, eg `/.githooks -export-ignore`.
/.githooks export-ignore
# <<< intent: hooks export-ignore <<<
