#!/usr/bin/env bash
set -euo pipefail

# Repo-local pre-push gate: the push gates `bin/int prepush` carries, a frozen
# remote and the currency of the delivered pair (bin/.devbin/cmd/prepush says
# why each). It no longer clones and builds: devbin's release core runs the
# build and the Linux run as the cut's legs, and CI clones every push (ST0091
# WP-02).
#
# TRACKED, as of 2026-08-20. This file used to say `Not tracked -- .git/hooks/
# never is`, which was true of where it lived and is no longer: `core.hooksPath`
# points git at `.githooks/`, so the calling line travels with the runner it
# calls (`bin/.devbin/cmd/prepush`) instead of being a property of one machine.
if [ -x bin/int ]; then
  bin/int prepush "$@" || exit $?
fi
