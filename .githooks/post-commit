#!/usr/bin/env bash
set -euo pipefail


# Repo-local gate, wired by `int hooks --install`. The runner is tracked at
# bin/.devbin/cmd/postcommit, AND SO IS THIS LINE, as of 2026-08-20: this file
# lives in the tracked `.githooks/` that `core.hooksPath` points at, so the hook
# and its runner now travel together to every clone.
if [ -x bin/int ]; then
  bin/int postcommit "$@" || exit $?
fi
