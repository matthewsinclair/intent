#!/usr/bin/env bash
set -euo pipefail

# intent-chain-block:start (generated by intent claude upgrade)
_intent_chain="$(git rev-parse --git-path hooks 2>/dev/null)/pre-commit.intent"
if [ -x "$_intent_chain" ]; then
  "$_intent_chain" "$@" || exit $?
fi
# intent-chain-block:end

# Format staged Markdown files with prettier
MD_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' || true)
if [ -n "$MD_FILES" ]; then
  echo "$MD_FILES" | xargs prettier --write
  echo "$MD_FILES" | xargs git add
fi

# Format staged Elixir files with mix format
EX_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ex' '*.exs' || true)
if [ -n "$EX_FILES" ]; then
  mix format $EX_FILES
  echo "$EX_FILES" | xargs git add
fi

# Format staged Rust files with rustfmt (hv approved 2026-08-20, via vc).
#
# WHY THIS EXISTS: on 2026-08-20 hv's push produced the first GitHub run in four
# days and `rust` failed on BOTH legs in 26s -- not a compile break, `cargo fmt
# --check`. Nineteen divergences had accumulated with nothing able to report
# them, because this hook formatted the two languages CI does NOT check and left
# alone the one it does. Existing enforcement moved earlier, not new enforcement.
#
# STAGED PATHS ONLY, NEVER `cargo fmt --all`, AND THAT IS LOAD-BEARING RATHER
# THAN TIDY. `int fmt rust` is `cargo fmt --all` over the workspace: correct as a
# command, catastrophic here. Four sessions share this checkout, so a
# workspace-wide format from a commit hook is a second writer over three peers'
# uncommitted work. This is how the same 19 divergences were repaired by hand --
# `rustfmt` on named paths, each owner taking their own.
#
# READ INTO AN ARRAY, NOT `$(git diff -z)`, AND I WROTE THE BROKEN VERSION FIRST.
# The other two stanzas use `echo "$FILES" | xargs`, which silently splits a path
# containing a space, so the new one should not reproduce that -- but the obvious
# repair, capturing `-z` output in a variable, CANNOT WORK: **bash strips NUL
# bytes in command substitution** and says so (`warning: command substitution:
# ignored null byte in input`). Every path would have arrived as one concatenated
# argument.
#
# It measured CLEAN when I checked it, because I checked it in zsh, which
# preserves the NUL -- and this hook runs under bash. A tool that answers the
# question in a shell other than the one that will run the code is not measuring
# the code. The array form needs no separator to survive a variable at all.
#
# The length guard is required, not defensive: `set -u` is on and bash 3.2 (this
# is macOS) errors on `"${arr[@]}"` for an empty array. Same shape, same reason,
# as the LANGS loop in the shipped gate.
#
# `int check format` (`cargo fmt --all --check`, non-mutating) already existed
# and nothing dispatched it -- the third instrument today found to exist with no
# trigger, after `canon-ignore-guard.sh` and `prepush`. It stays unwired here on
# purpose: it is workspace-wide, so with peers live it would refuse on somebody
# else's unformatted file.
RS_FILES=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] && RS_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.rs' || true)
if [ "${#RS_FILES[@]}" -gt 0 ]; then
  rustfmt --edition 2024 "${RS_FILES[@]}"
  git add "${RS_FILES[@]}"
fi

# Repo-local gates: the ST0056 apparatus guards (hv approved 2026-08-15).
#
# DELIBERATELY LAST, after the formatters have re-staged. A gate that runs
# before the formatter checks content that is not what lands -- the skew check
# would compare the pre-prettier view and the post-prettier one would commit
# unchecked. Checking one thing and landing another is the class these guards
# exist to close, so the gate goes where it sees the final staged set.
#
# NOT in .git/hooks/pre-commit.intent: that file is installed from
# lib/templates/hooks/pre-commit.sh, which SHIPS to every consumer project via
# `intent claude upgrade`. These guards check intent/st/ST0056/parity/**, which
# exists here and nowhere else.
#
# The runner is `bin/int precommit` (tracked, reviewable, mutation-tested).
#
# THE GAP THIS PARAGRAPH USED TO DESCRIBE IS CLOSED, 2026-08-20 (hv approved via
# vc). It read: `This chaining line is not tracked -- .git/hooks/ never is -- so
# a fresh clone has the guards and no gate calling them. That gap is real and is
# filed.` It is filed no longer. `core.hooksPath` points git at `.githooks/`, so
# this file IS the hook and IS tracked, and a clone receives the calls as well as
# the guards. What remains irreducible is one config command per clone -- git
# will not adopt tracked hooks by itself, which is a security property and not an
# oversight -- so `int hooks --install` sets it and the `bin/int` dispatcher says
# so when it is missing.
if [ -x bin/int ]; then
  bin/int precommit "$@" || exit $?
fi
