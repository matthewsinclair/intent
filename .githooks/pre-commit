#!/usr/bin/env bash
set -euo pipefail

# intent-chain-block:start (generated by intent claude upgrade)
_intent_chain="$(git rev-parse --git-path hooks 2>/dev/null)/pre-commit.intent"
if [ -x "$_intent_chain" ]; then
  "$_intent_chain" "$@" || exit $?
elif [ -e "$_intent_chain" ]; then
  echo "pre-commit: GATE NOT EXECUTABLE -- the gate did NOT run." >&2
  echo "pre-commit:   present, but carries no execute bit:" >&2
  echo "pre-commit:     $_intent_chain" >&2
  echo "pre-commit:   fix:  chmod +x on that path, or: intent claude upgrade --apply" >&2
  exit 1
else
  echo "pre-commit: GATE ABSENT -- the critic and every shipped guard did NOT run." >&2
  echo "pre-commit:   this hook declares a gate it cannot find:" >&2
  echo "pre-commit:     $_intent_chain" >&2
  echo "pre-commit:   so the clock, whiteboard-header, canon-ignore and append-only" >&2
  echo "pre-commit:   guards were all a no-op. ANYTHING PRINTED BELOW THIS LINE COMES" >&2
  echo "pre-commit:   FROM A DIFFERENT ROSTER AND SAYS NOTHING ABOUT THEM." >&2
  echo "pre-commit:   fix:  intent claude upgrade --apply" >&2
  echo "pre-commit:   why:  pre-commit.intent is canon written by the installer, and it" >&2
  echo "pre-commit:         is gitignored on purpose, so no clone ever receives it." >&2
  exit 1
fi
# intent-chain-block:end

# THE FORMATTERS CHECK AND REFUSE. THEY DO NOT WRITE. (vc ruling, 2026-08-30.)
#
# **A GATE MAY REFUSE; IT MUST NOT AUTHOR.** Until today all three stanzas below
# ran their formatter in write mode and then `git add`-ed the result -- which
# means a hook rewrote bytes an operator had deliberately staged. That is not a
# theoretical hazard: it put `main` red for two commits on 2026-08-29, when a
# hunk-scoped `git update-index --cacheinfo` was silently replaced by the
# worktree version at commit time, and the author had verified the staged tree
# by building it. **Verifying the tree you staged is not verifying the tree you
# committed, once a hook can write** -- and once no hook writes, those are the
# same object again and the whole class closes by construction rather than by
# anyone remembering to `git show HEAD:<path>` afterwards.
#
# THE PRECEDENT IS THIS SAME HOOK. `whiteboard-clock-guard.sh` deliberately
# never auto-corrects, and says why: a guard that silently fixes the stamp hides
# the class from the node that needs to learn its clock was wrong, so it prints
# the right value and lets the fix be a copy-paste. We were running two opposite
# contracts for "what a pre-commit hook does when it finds something wrong" in
# one file.
#
# WHAT IT COSTS, STATED RATHER THAN DISCOVERED: a commit touching an unformatted
# file now takes two attempts. That is cheaper than one silent clobber of
# deliberately staged bytes, and `cargo fmt --check` already runs in CI, so the
# local rewrite was a convenience with a correctness hazard attached.
#
# **THE CHECK READS THE WORKTREE FILE, NOT THE STAGED BLOB, AND THAT IS FORCED
# RATHER THAN CHOSEN.** `rustfmt --check` reading from stdin RETURNS 0 ON
# UNFORMATTED INPUT -- measured, not assumed -- so a staged-blob check would
# have produced a rust arm that could never refuse anything. Consequence worth
# knowing: for a file that is staged and then modified again, these arms judge
# the worktree copy, which is the same thing the write-mode formatters did
# before them, so no behaviour here is newly imprecise.
formatter_refused() {
  echo "pre-commit: $1 is not formatted -- REFUSED, and NOTHING WAS REWRITTEN." >&2
  echo "pre-commit:   your staged bytes are exactly as you staged them." >&2
  echo "pre-commit:   files:" >&2
  printf 'pre-commit:     %s\n' $3 >&2
  echo "pre-commit:   fix:   $2" >&2
  echo "pre-commit:   then:  git add on those paths, and commit again" >&2
  exit 1
}

# Check staged Markdown with prettier
MD_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' || true)
if [ -n "$MD_FILES" ]; then
  MD_BAD=$(echo "$MD_FILES" | xargs prettier --list-different 2>/dev/null || true)
  if [ -n "$MD_BAD" ]; then
    formatter_refused "markdown" "prettier --write <the files listed above>" "$MD_BAD"
  fi
fi

# Check staged Elixir with mix format
EX_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ex' '*.exs' || true)
if [ -n "$EX_FILES" ]; then
  if ! mix format --check-formatted $EX_FILES >/dev/null 2>&1; then
    formatter_refused "elixir" "mix format <the files listed above>" "$EX_FILES"
  fi
fi

# Format staged Rust files with rustfmt (hv approved 2026-08-20, via vc).
#
# WHY THIS EXISTS: on 2026-08-20 hv's push produced the first GitHub run in four
# days and `rust` failed on BOTH legs in 26s -- not a compile break, `cargo fmt
# --check`. Nineteen divergences had accumulated with nothing able to report
# them, because this hook formatted the two languages CI does NOT check and left
# alone the one it does. Existing enforcement moved earlier, not new enforcement.
#
# STAGED PATHS ONLY, NEVER `cargo fmt --all`, AND THAT IS LOAD-BEARING RATHER
# THAN TIDY. `int fmt rust` is `cargo fmt --all` over the workspace: correct as a
# command, catastrophic here. Four sessions share this checkout, so a
# workspace-wide format from a commit hook is a second writer over three peers'
# uncommitted work. This is how the same 19 divergences were repaired by hand --
# `rustfmt` on named paths, each owner taking their own.
#
# READ INTO AN ARRAY, NOT `$(git diff -z)`, AND I WROTE THE BROKEN VERSION FIRST.
# The other two stanzas use `echo "$FILES" | xargs`, which silently splits a path
# containing a space, so the new one should not reproduce that -- but the obvious
# repair, capturing `-z` output in a variable, CANNOT WORK: **bash strips NUL
# bytes in command substitution** and says so (`warning: command substitution:
# ignored null byte in input`). Every path would have arrived as one concatenated
# argument.
#
# It measured CLEAN when I checked it, because I checked it in zsh, which
# preserves the NUL -- and this hook runs under bash. A tool that answers the
# question in a shell other than the one that will run the code is not measuring
# the code. The array form needs no separator to survive a variable at all.
#
# The length guard is required, not defensive: `set -u` is on and bash 3.2 (this
# is macOS) errors on `"${arr[@]}"` for an empty array. Same shape, same reason,
# as the LANGS loop in the shipped gate.
#
# `int check format` (`cargo fmt --all --check`, non-mutating) already existed
# and nothing dispatched it -- the third instrument today found to exist with no
# trigger, after `canon-ignore-guard.sh` and `prepush`. It stays unwired here on
# purpose: it is workspace-wide, so with peers live it would refuse on somebody
# else's unformatted file.
RS_FILES=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] && RS_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.rs' || true)
if [ "${#RS_FILES[@]}" -gt 0 ]; then
  RS_BAD=""
  for f in "${RS_FILES[@]}"; do
    rustfmt --check --edition 2024 "$f" >/dev/null 2>&1 || RS_BAD="$RS_BAD $f"
  done
  if [ -n "$RS_BAD" ]; then
    formatter_refused "rust" "rustfmt --edition 2024 <the files listed above>" "$RS_BAD"
  fi
fi

# Repo-local gates: the ST0056 apparatus guards (hv approved 2026-08-15).
#
# STILL LAST, AND THE REASON IT USED TO BE LAST IS NOW GONE. The old reason was
# that the formatters re-staged, so a gate running earlier would check the
# pre-prettier view while the post-prettier bytes landed -- checking one thing
# and landing another, which is the class these guards exist to close. **The
# formatters no longer write, so the staged set no longer moves and every
# position now sees the same bytes.** Kept last because a cheap syntactic
# refusal ahead of an expensive gate is a better failure order, which is a
# preference rather than the correctness requirement it was.
#
# NOT in .git/hooks/pre-commit.intent: that file is installed from
# lib/templates/hooks/pre-commit.sh, which SHIPS to every consumer project via
# `intent claude upgrade`. These guards check intent/st/ST0056/parity/**, which
# exists here and nowhere else.
#
# The runner is `bin/int precommit` (tracked, reviewable, mutation-tested).
#
# THE GAP THIS PARAGRAPH USED TO DESCRIBE IS CLOSED, 2026-08-20 (hv approved via
# vc). It read: `This chaining line is not tracked -- .git/hooks/ never is -- so
# a fresh clone has the guards and no gate calling them. That gap is real and is
# filed.` It is filed no longer. `core.hooksPath` points git at `.githooks/`, so
# this file IS the hook and IS tracked, and a clone receives the calls as well as
# the guards. What remains irreducible is one config command per clone -- git
# will not adopt tracked hooks by itself, which is a security property and not an
# oversight -- so `int hooks --install` sets it and the `bin/int` dispatcher says
# so when it is missing.
if [ -x bin/int ]; then
  bin/int precommit "$@" || exit $?
fi
