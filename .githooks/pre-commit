#!/usr/bin/env bash
set -euo pipefail

# intent-chain-block:start (generated by intent claude upgrade)
_intent_chain="$(git rev-parse --git-path hooks 2>/dev/null || :)/pre-commit.intent"
if [ -x "$_intent_chain" ]; then
  "$_intent_chain" "$@" || exit $?
elif [ -e "$_intent_chain" ]; then
  echo "pre-commit: GATE NOT EXECUTABLE -- the Intent gate did NOT run: no guard, no critic, no doctor." >&2
  echo "pre-commit:   the carrier has no execute bit: $_intent_chain" >&2
  echo "pre-commit:   remedy: intent claude upgrade --apply" >&2
  exit 1
else
  echo "pre-commit: GATE ABSENT -- the Intent gate did NOT run: no guard, no critic, no doctor." >&2
  echo "pre-commit:   this hook declares a gate it cannot find: $_intent_chain" >&2
  echo "pre-commit:   the carrier is gitignored, so no clone or worktree receives it." >&2
  echo "pre-commit:   remedy: intent claude upgrade --apply" >&2
  exit 1
fi
# intent-chain-block:end

# THE FORMATTER CHECK MOVED TO CANON, 2026-09-22 (issue 0505, and the first
# commit of the guards adoption pass). It is no longer implemented in this file:
# `intent/.config/config.json` declares `formatters`, and
# `lib/templates/hooks/staged-format-guard.sh` -- shipped from canon, dispatched
# by the roster in `pre-commit-guards.sh` -- does the work. It reads the staged
# blob, never writes, and reaches every estate instead of being copied into each
# one by hand. The ruling this block was built to satisfy is unchanged and now
# lives with the guard: A GATE MAY REFUSE; IT MUST NOT AUTHOR.
#
# WHAT THE MOVE COST AND WHAT IT GAINED, DRIVEN RATHER THAN ASSERTED. The retired
# block was extracted verbatim and run against the guard over one planted corpus
# of seventeen cases, three buckets. Fourteen agreed.
#
# THE GUARD PASSES THREE CASES THIS BLOCK REFUSED. (1) prettier absent: the block
# named every staged `.md` as "not formatted" having measured nothing -- a false
# claim; the guard reports UNENFORCED by name. (2) TWO `rustfmt.toml` FILES: the
# block selected its config with `git ls-files '*rustfmt.toml' | head -1`, the
# alphabetically first in the WHOLE repository, so it refused correct code under a
# config that governed nothing, with a remedy that runs clean and changes nothing.
# (3) rustfmt absent: the block refused HONESTLY, distinguishing could-not-measure
# from unformatted; the guard reports UNENFORCED and passes. That third is a ruled
# fail-open (0505's AC-5) and a genuine REDUCTION against this block rather than a
# repair, and it is recorded as one.
#
# AND THIS BLOCK PASSED ONE CASE THE GUARD REFUSES, WHICH IS THE ONE THAT WOULD
# HAVE BITTEN. It hardcoded `--edition 2024`; the guard resolves the edition from
# the file's own config. A crate declaring any other edition can hold a file
# formatted under 2024 and not under its own -- committed today, refused after the
# swap. Latent HERE only because `native/rust/rustfmt.toml` declares
# `edition = "2024"`, and live for the first estate carrying another. That and the
# `head -1` selection above are the two mechanisms to grep for when the other
# estates' copies of this block are retired.

# Repo-local gates: the ST0056 apparatus guards (hv approved 2026-08-15).
#
# STILL LAST, AND THE REASON IT USED TO BE LAST IS NOW GONE. The old reason was
# that the formatters re-staged, so a gate running earlier would check the
# pre-prettier view while the post-prettier bytes landed -- checking one thing
# and landing another, which is the class these guards exist to close. **The
# formatters no longer write, so the staged set no longer moves and every
# position now sees the same bytes.** Kept last because a cheap syntactic
# refusal ahead of an expensive gate is a better failure order, which is a
# preference rather than the correctness requirement it was.
#
# **AND SINCE 2026-09-22 THE FORMATTERS ARE NOT IN THIS FILE AT ALL**, so "last"
# is now relative to the chained gate above rather than to three stanzas here.
# The canon guard runs inside `pre-commit.intent`, before this line, and still
# never writes -- so the reasoning is unchanged and only its subject moved.
#
# NOT in .git/hooks/pre-commit.intent: that file is installed from
# lib/templates/hooks/pre-commit.sh, which SHIPS to every consumer project via
# `intent claude upgrade`. These guards check intent/st/ST0056/parity/**, which
# exists here and nowhere else.
#
# The runner is `bin/int precommit` (tracked, reviewable, mutation-tested).
#
# THE GAP THIS PARAGRAPH USED TO DESCRIBE IS CLOSED, 2026-08-20 (hv approved via
# vc). It read: `This chaining line is not tracked -- .git/hooks/ never is -- so
# a fresh clone has the guards and no gate calling them. That gap is real and is
# filed.` It is filed no longer. `core.hooksPath` points git at `.githooks/`, so
# this file IS the hook and IS tracked, and a clone receives the calls as well as
# the guards. What remains irreducible is one config command per clone -- git
# will not adopt tracked hooks by itself, which is a security property and not an
# oversight -- so `int hooks --install` sets it and the `bin/int` dispatcher says
# so when it is missing.
if [ -x bin/int ]; then
  bin/int precommit "$@" || exit $?
fi
