{
  "$defs": {
    "IssueStatus": {
      "enum": [
        "open",
        "closed"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An issue: `issues/<n>.json` (structure) + `issues/<n>.md` (authored body).",
  "properties": {
    "closed": {
      "description": "When it was closed, if it is closed.",
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "type": "string"
    },
    "number": {
      "description": "Rendered zero-padded, eg `0021`.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "reporter": {
      "description": "Who reported it, free text, exactly as recorded.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "description": "Always [`ISSUE_SCHEMA`].",
      "type": "string"
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IssueStatus"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "number",
    "slug",
    "title",
    "status",
    "created"
  ],
  "title": "Issue",
  "type": "object",
  "x-intent-ver": "3.0.0-dev",
  "x-schema-json-ver": 7
}
