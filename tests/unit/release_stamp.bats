#!/usr/bin/env bats
# The cut's derived steps, bin/.devbin/cut/stamp.
#
# ST0091 AT-01.1 cites this file for AC-01.1.
#
# devbin's release core runs each step as `bin/devbin stamp <step>` after its
# own `version set`, adds every line the step prints on stdout to the paths the
# release owns, and runs every step again when a stopped cut is run again. So
# each arm reads stdout alone, and each asks the second run what the first was
# asked. The steps run in a scratch repository laid out as this one is, with
# PROJECT_ROOT pointed at it as the dispatcher points it, and stubs stand in for
# the stamp CLI and for cargo where the subject is what the step does with
# their output: the paths it names, its refusals, and what a refusal leaves
# behind. The schema bless and the stamp CLI's build are cargo's own work, and
# the judge's run of the cut drives them.

load "../lib/test_helper.bash"

STAMP="${INTENT_PROJECT_ROOT}/bin/.devbin/cut/stamp"

# make_repo -- $REPO committed at 3.2.0, holding what a release commit touches:
# the sidecars, a schema face, a realised view with its footer, and a tracked
# file the canon engine owns that is not the release's. Then the tree as the
# core's `version set` leaves it, VERSION and the manifest at 3.3.0, which is
# where every derived step starts. And the stub cargo, first on PATH for `step`.
make_repo() {
  REPO="${TEST_TEMP_DIR}/repo"
  mkdir -p "$REPO/intent/.config" "$REPO/native/rust" "$REPO/schema" "$REPO/intent/st/ST0001"
  git -C "$REPO" init -q
  git -C "$REPO" config user.name t
  git -C "$REPO" config user.email t@t
  printf '3.2.0\n' >"$REPO/VERSION"
  printf '# Changelog\n' >"$REPO/CHANGELOG.md"
  printf 'agents 3.2.0\n' >"$REPO/AGENTS.md"
  printf 'claude 3.2.0\n' >"$REPO/CLAUDE.md"
  printf 'usage rules\n' >"$REPO/usage-rules.md"
  printf '{"intent_version":"3.2.0","version":"3.2.0"}\n' >"$REPO/intent/.config/config.json"
  printf '[workspace.package]\nversion = "3.2.0"\n' >"$REPO/native/rust/Cargo.toml"
  cat >"$REPO/native/rust/Cargo.lock" <<'EOF'
version = 4

[[package]]
name = "intent-cli"
version = "3.2.0"

[[package]]
name = "serde"
version = "1.0.229"
source = "registry+https://github.com/rust-lang/crates.io-index"
EOF
  printf '{"x-intent-ver": "3.2.0"}\n' >"$REPO/schema/thread.schema.json"
  printf '# ST0001\n\n- a\n\n_Generated by Intent v3 from x._\n' >"$REPO/intent/st/ST0001/info.md"
  printf 'native/rust/target/\n' >"$REPO/.gitignore"
  git -C "$REPO" add -A
  git -C "$REPO" commit -q -m base
  printf '3.3.0\n' >"$REPO/VERSION"
  printf '[workspace.package]\nversion = "3.3.0"\n' >"$REPO/native/rust/Cargo.toml"

  # cargo, run from native/rust as the steps run it. `metadata` refreshes the
  # lock as cargo does after `version set`, every member onto the manifest's
  # version, and STUB_DEP moves a dependency too. `test` writes the face the
  # bless would, at STUB_FACE_VERSION.
  STUBS="${TEST_TEMP_DIR}/stubs"
  mkdir -p "$STUBS"
  cat >"$STUBS/cargo" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  metadata)
    perl -pi -e 's/^version = "3\.2\.0"$/version = "3.3.0"/' Cargo.lock || exit 1
    [ -z "${STUB_DEP:-}" ] || perl -pi -e 's/^version = "1\.0\.229"$/version = "9.9.9"/' Cargo.lock ;;
  test) printf '{"x-intent-ver": "%s"}\n' "${STUB_FACE_VERSION:-3.3.0}" >../../schema/thread.schema.json ;;
  *) echo "stub cargo: unexpected arguments: $*" >&2; exit 2 ;;
esac
EOF
  chmod +x "$STUBS/cargo"
}

# write_stamp_cli -- the stamp CLI `stamp cli` builds, in the debug target,
# answering what the rendering steps ask of it, as STUB_CLI_VERSION. STUB_SPILL
# makes its canon engine re-provision a file that is not the release's, and
# STUB_SKEW makes its re-render change a view beyond the footer.
write_stamp_cli() {
  local bin="$REPO/native/rust/target/debug/intent"
  mkdir -p "$(dirname "$bin")"
  cat >"$bin" <<'EOF'
#!/usr/bin/env bash
v="${STUB_CLI_VERSION:-3.3.0}"
case "$1 ${2:-}" in
  "--version ") printf 'intent %s (dev, 0000000) debug\n' "$v" ;;
  "agents sync") printf 'agents %s\n' "$v" >AGENTS.md ;;
  "claude upgrade")
    printf 'claude %s\n' "$v" >CLAUDE.md
    [ -z "${STUB_SPILL:-}" ] || printf 'usage rules, re-provisioned\n' >usage-rules.md ;;
  "sync --to-disk")
    bullet=a
    [ -z "${STUB_SKEW:-}" ] || bullet=b
    printf '# ST0001\n\n- %s\n\n_Generated by Intent v4 from x._\n' "$bullet" >intent/st/ST0001/info.md ;;
  *) echo "stub intent: unexpected arguments: $*" >&2; exit 2 ;;
esac
EOF
  chmod +x "$bin"
}

# step <name> -- one step as the core runs it. $output is its stdout alone, the
# paths it names; its stderr is in $ERR.
step() {
  ERR="${TEST_TEMP_DIR}/step.err"
  run env PROJECT_ROOT="$REPO" PATH="$STUBS:$PATH" bash -c '"$1" "$2" 2>"$3"' _ "$STAMP" "$1" "$ERR"
}

err_has() {
  grep -qF -- "$1" "$ERR" || fail "expected the step's stderr to name '$1'; it was: $(cat "$ERR")"
}

@test "AT-01.1: config: intent_version is stamped and the legacy version dropped, and every run names the file" {
  make_repo
  step config
  assert_success
  assert_output "intent/.config/config.json"
  run jq -c . "$REPO/intent/.config/config.json"
  assert_output '{"intent_version":"3.3.0"}'
  step config
  assert_success
  assert_output "intent/.config/config.json"
  err_has "already carries 3.3.0"
}

@test "AT-01.1: lock: a refresh that moves members alone is named, and one that moves a dependency is refused by name and put back" {
  make_repo
  step lock
  assert_success
  assert_output "native/rust/Cargo.lock"
  git -C "$REPO" checkout -q -- native/rust/Cargo.lock
  before="$(cat "$REPO/native/rust/Cargo.lock")"
  export STUB_DEP=1
  step lock
  assert_failure
  err_has "serde"
  [ "$(cat "$REPO/native/rust/Cargo.lock")" = "$before" ] ||
    fail "the refused refresh was left in the lock: $(cat "$REPO/native/rust/Cargo.lock")"
}

@test "AT-01.1: schema: a face the bless leaves on another version is refused by name, and faces at the version are named" {
  make_repo
  export STUB_FACE_VERSION=3.2.9
  step schema
  assert_failure
  err_has "schema/thread.schema.json carries 3.2.9"
  export STUB_FACE_VERSION=3.3.0
  step schema
  assert_success
  assert_output "schema/thread.schema.json"
}

# Issue 0387: a rendered file names the version of the binary that rendered it.
@test "AT-01.1: agents: a stamp CLI at another version is refused with the remedy that builds it, and one at the version renders AGENTS.md" {
  make_repo
  write_stamp_cli
  export STUB_CLI_VERSION=3.2.0
  step agents
  assert_failure
  err_has "bin/devbin stamp cli"
  [ "$(cat "$REPO/AGENTS.md")" = "agents 3.2.0" ] || fail "AGENTS.md was rendered by a CLI at the wrong version"
  export STUB_CLI_VERSION=3.3.0
  step agents
  assert_success
  assert_output "AGENTS.md"
}

@test "AT-01.1: upgrade: the canon engine's write outside the release's files is refused by name, and a view an earlier run left dirty is not taken for one" {
  make_repo
  write_stamp_cli
  # What an earlier run's views step leaves, as a resumed cut finds it.
  printf '# ST0001\n\n- a\n\n_Generated by Intent v4 from x._\n' >"$REPO/intent/st/ST0001/info.md"
  export STUB_SPILL=1
  step upgrade
  assert_failure
  err_has "usage-rules.md"
  run grep -qF "intent/st/ST0001/info.md" "$ERR"
  assert_failure
  unset STUB_SPILL
  git -C "$REPO" checkout -q -- usage-rules.md
  step upgrade
  assert_success
  assert_output "CLAUDE.md"
}

@test "AT-01.1: views: a change to a view's footer alone folds in by name, and a change beyond it is refused by name" {
  make_repo
  write_stamp_cli
  step views
  assert_success
  assert_output "intent/st/ST0001/info.md"
  export STUB_SKEW=1
  step views
  assert_failure
  err_has "intent/st/ST0001/info.md"
}

# AC-01.1's own words: release check names every derived step and gate, and the
# driver is gone. The steps are read from config.yaml, never listed here.
@test "AT-01.1: release check names every derived step config.yaml declares, and the retired driver is gone" {
  local config="${INTENT_PROJECT_ROOT}/bin/.devbin/config.yaml" derived line row
  derived="$(awk '
    /^release:/ { r = 1; next }
    r && /^[^ #]/ { r = 0 }
    r && /^  derived:/ { d = 1; next }
    d && /^    - / { sub(/^    - /, ""); print; next }
    d { d = 0 }
  ' "$config")"
  [ -n "$derived" ] || fail "the release block in $config declares no derived step"
  row="$(cd "$INTENT_PROJECT_ROOT" && bin/devbin release check 2>/dev/null | awk '$1 == "derived"')"
  while IFS= read -r line; do
    [[ "$row" == *"$line"* ]] || fail "release check's derived row does not name '$line': $row"
  done <<<"$derived"
  [ ! -e "${INTENT_PROJECT_ROOT}/bin/.devbin/cmd/build.d/release" ] ||
    fail "bin/.devbin/cmd/build.d/release is back, and the cut has one driver"
}
